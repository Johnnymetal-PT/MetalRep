<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Template for Dynamic Snippet -->

        <template
            id="dynamic_filter_template_product_brand_brands_item"
            name="Brand Slider Design 1"
        >
            <t t-foreach="records" t-as="data">
                <t t-set="record" t-value="data['_record']"/>
                <div class="te_brand_img w-100 o_carousel_product_card s_dynamic_snippet_1">
                    <t t-set="page_url" t-value="'/shop/brands/%s' % record['id']"/>
                    <a t-att-href="page_url"  class="brand_link text-decoration-none">
                        <span class="brand_image text-center mx-auto border-bottom-0 d-flex align-item-center">
                            <img t-attf-src="/web/image/product.brand/#{record['id']}/image_256" t-att-alt="data['name']" class="py-3 px-2 mx-auto w-auto h-auto"/>
                        </span>
                        <div class="brand-content py-2 px-2 clearfix">
                        <div class="brand_name align-middle mt-0 text-center text-black" t-out="data['name']"/>
                        </div>
                    </a>
                </div>
            </t>
        </template>

        <!-- New Brand Slider Design Template -->
        <template
            id="dynamic_filter_template_product_brand_brands_slider2"
            name="Brand Slider Design 2">
            <t t-foreach="records" t-as="data">
                <t t-set="record" t-value="data['_record']"/>
                <div class="card-group o_carousel_product_card s_dynamic_snippet_2">
                    <t t-set="page_url" t-value="'/shop/brands/%s' % record['id']"/>
                    <div class="te_brand_img item card h-100 border d-flex flex-row align-items-center">
                        <a t-att-href="page_url"  class="brand_link"/>
                        <div class="category_3_img pe-3 col-6">
                            <img t-att-alt="data['name']" class="brand-img pe-3" t-attf-src="/web/image/product.brand/#{record['id']}/image_128"/>
                        </div>
                        <div class="brand_details_1 col-6">
                            <a t-att-href="page_url" class="brand_link  text-decoration-none d-block justify-content-between">
                                <div  class="brand_name card-title mb-2 text-black" t-out="data['name']"/>
                            </a>
                            <a t-att-href="page_url" class="brand_link btn btn-primary px-2 py-1 explore_btn">
                                Explore
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    <template id="dynamic_filter_template_product_brand_brands_slider3" name="Brand Slider Design 3">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']"/>
            <section class="brand_slider_3 te_brand_slider slider_body o_not_editable">
                <t t-set="page_url" t-value="'/shop/brands/%s' % record['id']"/>
                <div class="container overflow-hidden">
                    <section class="te_brand_slider_3">
                        <div class="item te_brand_img p-2 pb-0 mb-0">
                            <a t-att-href="page_url" class="brand_link text-decoration-none">
                                <span class="brand_image text-center mx-auto t_img_hover_1 te_img_effect2 overflow-hidden position-relative d-inline-block">
                                        <img t-attf-src="/web/image/product.brand/#{record['id']}/image_256"
                                             t-att-alt="data['name']" class="p-2 w-100"/>
                                </span>
                            </a>
                        </div>
                    </section>
                </div>
            </section>
        </t>
    </template>

    <template id="dynamic_filter_template_product_brand_brands_slider4" name="Brand Slider Design 4">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']"/>
            <div class="card-group brand_slider_4">
                <div class="te_category_item cate_4 card h-100 border-0 align-items-center pe-1">
                    <t t-set="page_url" t-value="'/shop/brands/%s' % record['id']"/>
                    <div class="category_4_img">
                        <a t-att-href="page_url" class="category_conntent position-relative d-block mx-auto">
                                <img t-attf-src="/web/image/product.brand/#{record['id']}/image_256" t-att-alt="data['name']" class=""/>
                        </a>
                    </div>
                    <div class="brand-content text-center py-2 px-2 clearfix">
                        <div  class="d-inline-flex brand_link text-decoration-none text-center d-inline-block position-relative">
                             <div class="brand_name align-middle mt-0 text-capitalize d-inline-block text-black" t-out="data['name']"/>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="dynamic_filter_template_product_brand_brands_slider5" name="Brand Slider Design 5">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']"/>
            <div class="item te_brand_img w-100 brand_slider_5">
                <a t-attf-href="'/shop/brands/%s' % record['id']" class="brand_link text-decoration-none">
                    <span class="brand_image text-center mx-auto border-bottom-0 d-flex align-item-center">
                            <img t-attf-src="/web/image/product.brand/#{record['id']}/image_256" t-att-alt="data['name']"
                                 class="d-block img img-fluid w-50 mx-auto" t-att-title="data['name']"/>
                    </span>
                </a>
            </div>
        </t>
    </template>

    <template id="dynamic_filter_template_product_brand_brands_slider6" name="Brand Slider Design 6">
        <t t-foreach="records" t-as="data">
            <t t-set="record" t-value="data['_record']"/>
            <t t-set="page_url" t-value="'/shop/brands/%s' % record['id']"/>
            <div class="card-group brand_slider_6">
                <div class="te_category_item cate_6 card border-0 rounded-0">
                    <a t-att-href="page_url" class="brand_link text-decoration-none d-block position-relative overflow-hidden">
                        <img t-attf-src="/web/image/product.brand/#{record['id']}/image_256"
                             t-att-alt="data['name']"
                             class="img img-fluid"/>
                        <div class="brand_content d-flex flex-column justify-content-center align-items-center">
                            <span class="d-block text-uppercase small fw-bold mb-2" t-out="data['name']"/>
                            <span class="text-uppercase smaller fw-bold border-bottom border-2 border-dark">
                                View
                                <i class="oi oi-arrow-right"/>
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        </t>
    </template>

        <!-- Assets -->
        <record id="theme_clarico_vega.s_dynamic_snippet_brands_000_scss" model="ir.asset">
            <field name="name">Dynamic snippet brands 000 SCSS</field>
            <field name="bundle">web.assets_frontend</field>
            <field name="path">theme_clarico_vega/static/src/snippets/s_dynamic_snippet_brands/000.scss</field>
        </record>

</odoo>
