        <i class="fa fa-shopping-cart" position="attributes">
            <attribute name="class" remove="fa fa-shopping-cart" add="emipro-icon ept-cart" separator=" "/>
        </i>
    </t>
    <t t-inherit="sale.Product" t-inherit-mode="extension">
        <i class="fa fa-shopping-cart" position="attributes">
            <attribute name="class" remove="fa fa-shopping-cart" add="emipro-icon ept-cart" separator=" "/>
        </i>
    </t>
</templates>
