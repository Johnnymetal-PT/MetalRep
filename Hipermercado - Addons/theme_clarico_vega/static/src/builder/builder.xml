<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Theme Editor tab | Added by: Priyanshi Vasoya -->
    <t t-inherit="html_builder.Builder" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-snippets-tabs')]//ul[@role='tablist']//li[2]" position="after">
            <li class="nav-item" role="presentation">
                <button id="themeext-tab" data-name="themeext"
                        class="o-hb-tab nav-link position-relative w-100"
                        t-att-class="{'active cursor-default': state.activeTab === 'themeext'}"
                        t-on-click="() => this.onTabClickExt('themeext')" role="tab"
                        t-att-aria-selected="state.activeTab === 'themeext' ? 'true' : 'false'">
                    <i class="fa fa-cog me-2" role="none"/>Clarico
                </button>
            </li>
        </xpath>
        <xpath expr="//div[@class='o-tab-content overflow-y-auto overflow-x-hidden flex-grow-1']" position="inside">
            <t t-if="state.activeTab === 'themeext'">
                <t t-component="ThemeTabExt" colorPresetToShow="colorPresetToShow" optionsContainers="state.optionsContainersExt"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o-snippets-tabs')]//div[hasclass('o-snippets-tabs-highlighter')]" position="replace">
            <div
                class="o-snippets-tabs-highlighter position-absolute start-50 h-100 pe-none"
                t-att-class="{
                    'o-highlight-blocks': state.activeTab === 'blocks',
                    'o-highlight-theme': state.activeTab === 'theme',
                    'o-highlight-themeext': state.activeTab === 'themeext',
                }"
            />
        </xpath>
    </t>

</templates>
