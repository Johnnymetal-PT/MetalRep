<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Added Theme clarico vega notebook after adding new field in website model |
     Added by: Shubham Kumar | Date: 6 Oct 2025 -->
    <record id="view_emipro_theme_base_website_form" model="ir.ui.view">
        <field name="name">emipro_theme_base.website.form</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Theme Clarico Vega">
                    <group>
                        <group string="Out of Stock">
                            <field name="display_out_of_stock" widget="boolean_toggle"/>
                            <field name="option_out_of_stock" widget="boolean_toggle"
                                   invisible="not display_out_of_stock"/>
                            <field name="text_out_of_stock"
                                   invisible="not (option_out_of_stock and display_out_of_stock)"/>
                            <field name="show_stock_filter" widget="boolean_toggle"
                                   invisible="not display_out_of_stock"/>
                        </group>
                        <group string="B2B Features">
                            <field name="b2b_hide_add_to_cart" widget="boolean_toggle"/>
                            <field name="b2b_hide_price" widget="boolean_toggle"/>
                            <field name="is_b2b_message" widget="boolean_toggle" invisible="not b2b_hide_price"/>
                            <field name="text_b2b_hide_details" invisible="not is_b2b_message or not b2b_hide_price"/>
                        </group>
                        <group string="Advanced Search" name="smart_search">
                            <field name="enable_smart_search" widget="boolean_toggle"/>
                            <field name="search_in_brands" invisible="not enable_smart_search" widget="boolean_toggle"/>
                            <field name="search_in_attributes_and_values" invisible="not enable_smart_search"
                                   widget="boolean_toggle"/>
                            <field name="enable_search_categ" widget="boolean_toggle"/>
                            <field name="search_categ_id" widget="many2many_tags" can_create="false"
                                   invisible="not enable_search_categ"/>
                            <field name="search_placeholder_items"
                                   placeholder="Watches&#10;Summer dresses&#10;Gaming laptops"
                                   widget="text"/>
                        </group>
                        <group string="Free Shipping">
                            <field name="is_free_shipping" widget="boolean_toggle" string="Is Free Shipping"/>
                            <field name="free_shipping_price" invisible="not is_free_shipping"/>
                        </group>
                        <group string="Shop Page Layout">
                            <field name="is_card_layout" string="Card Layout" widget="boolean_toggle"/>
                        </group>
                        <group string="Voice Search" name="voice_search">
                            <field name="enable_voice_search" widget="boolean_toggle"/>
                        </group>
                        <group string="Load More">
                            <field name="is_load_more" widget="boolean_toggle"/>
                            <field name="load_more_image" options="{'size': [50, 50]}" widget="image"
                                   invisible="not is_load_more"/>
                            <field name="button_or_scroll" widget="selection_badge" invisible="not is_load_more"/>
                        </group>
                        <group string="Lazy Load">
                            <field name="is_lazy_load" widget="boolean_toggle"/>
                            <field name="lazy_load_image" options="{'size': [90, 90]}" widget="image"
                                   invisible="not is_lazy_load"/>
                        </group>
                        <group string="See All" name="show_attr_value">
                            <field name="see_all" required="1" widget="boolean_toggle" string="Show See All ?"/>
                            <field name="show_attr_value" required="1" widget="selection_badge"
                                   invisible="not see_all == True"/>
                        </group>
                        <group string="Default Country for Billing &amp; Shipping"
                               name="country_configuration">
                            <field name="allow_countries" widget="many2many_tags"
                                   can_create="false"/>
                            <field name="default_country_id" widget="selection_badge"/>
                        </group>
                        <group string="Progressive Web App(PWA)" name="pwa">
                            <field name="is_pwa" widget="boolean_toggle"/>
                            <field name="pwa_name" required="is_pwa" invisible="not is_pwa"/>
                            <field name="pwa_short_name" required="is_pwa" invisible="not is_pwa"/>
                            <field name="pwa_theme_color" widget="color" required="is_pwa" invisible="not is_pwa"/>
                            <field name="pwa_bg_color" widget="color" required="is_pwa" invisible="not is_pwa"/>
                            <field name="pwa_start_url" required="is_pwa" invisible="not is_pwa"/>
                            <field name="app_image_512" options="{'size': [50, 50]}" class="w-25 mt-2" widget="image"
                                   required="is_pwa" invisible="not is_pwa"/>
                        </group>
                        <group string="Top Sold Products" name="top_sold_days_value">
                            <field name="top_sold_duration_days" widget="integer" class="oe_inline"
                                   string="Duration (in days)" required="1"
                                   help="Top Sold Products Duration (in days)"/>
                        </group>
                        <group string="Show Sales and Visitor Count" name="show_sales_visitor_count">
                            <field name="enable_sales_visitor_count" widget="boolean_toggle"/>
                            <field name="fake_real_sales_count" invisible="not enable_sales_visitor_count"
                                   widget="integer" class="oe_inline"/>
                            <field name="fake_real_visitor_count" invisible="not enable_sales_visitor_count"
                                   widget="integer" class="oe_inline"/>
                        </group>
                        <group string="Show Age Verification" name="age_verification">
                            <field name="enable_age_verification" widget="boolean_toggle"/>
                            <field name="age_verification_message" invisible="not enable_age_verification" widget="html"/>
                            <field name="age_verification_warning" invisible="not enable_age_verification" widget="html"/>
                            <field name="background_image_age_verification" invisible="not enable_age_verification" options="{'size': [90, 90]}" widget="image"/>
                            <field name="background_color_age_verification" invisible="not enable_age_verification" widget="color"/>
                            <field name="yes_button_color" invisible="not enable_age_verification" widget="color"/>
                            <field name="yes_button_text_color" invisible="not enable_age_verification" widget="color"/>
                            <field name="no_button_color" invisible="not enable_age_verification" widget="color"/>
                            <field name="no_button_text_color" invisible="not enable_age_verification" widget="color"/>
                        </group>
                        <group string="One Step Checkout" name="one_page_checkout">
                            <field name="enable_one_page_checkout" widget="boolean_toggle"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
