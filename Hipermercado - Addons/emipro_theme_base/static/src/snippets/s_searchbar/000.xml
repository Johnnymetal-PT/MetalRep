<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-inherit="website.s_searchbar.autocomplete" t-inherit-mode="extension">
        <xpath expr="//t[@t-elif='!results.length']" position="attributes">
            <attribute name="t-elif">!results.length and !categories.length</attribute>
        </xpath>

        <xpath expr="//a[@t-foreach='results']/div[hasclass('d-flex')]" position="attributes">
            <attribute name="t-attf-data-class">#{result['image_url'] ? '' : 'd-inline-block'}</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_search_result_item_detail')]//button[@t-if='extra_link']" position="replace"/>

        <xpath expr="//div[hasclass('o_search_result_item')]//div[hasclass('o_search_result_item_detail')]//div[@t-attf-class]"
               position="replace">
            <div t-attf-class="h6 fw-bold #{description ? '' : 'mb-1'}" t-out="result['name']"/>
        </xpath>

        <xpath expr="//div[hasclass('o_search_result_item_detail')]//p[@t-out='description']" position="replace"/>

        <xpath expr="//div[hasclass('o_search_result_item_detail')]//t[@t-out='extra_link_html']" position="replace"/>

        <xpath expr="//div[hasclass('o_search_result_item')]//img[hasclass('o_image_64_contain')]"
               position="attributes">
            <attribute name="class">flex-shrink-0 o_image_40_cover</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_search_result_item')]//div[hasclass('flex-shrink-0')]"
               position="replace"/>

        <xpath expr="//div[hasclass('o_search_result_item')]" position="attributes">
            <attribute name="class">media d-flex align-items-center flex-wrap o_search_result_item p-0</attribute>
        </xpath>

        <xpath expr="//div[hasclass('o_search_result_item_detail')]" position="attributes">
            <attribute name="t-attf-class" add="media-body" separator=" "/>
        </xpath>

        <xpath expr="//a[@t-foreach='results']" position="before">
            <div class="d-flex categ_search flex-wrap">
                <div t-if="categories and categories.length" class="mb-1 col-12 col-sm-6 mt-1">
                    <span class="d-block pb-0 ms-2 pt-2 te_ce text-muted">Suggested Categories</span>
                    <t t-foreach="categories" t-as="category" t-key="result_index">
                        <a t-att-href="category['website_url']" class="dropdown-item p-2 text-wrap d-inline-block">
                            <div class="media align-items-center o_search_result_item d-inline-block">
                                <div class="media-body px-1">
                                    <div t-attf-class="h6 font-weight-bold #{description ? '' : 'mb-0'}"
                                         t-out="category['name']"/>
                                </div>
                            </div>
                        </a>
                    </t>
                </div>
                <div class="brand_search mb-1 col-12 col-sm-6 mt-1" t-if="search_brands and search_brands.length">
                    <span class="d-block pb-0 ms-2 pt-2 te_ce text-muted">Suggested Brands</span>
                    <t t-foreach="search_brands" t-as="brand" t-key="brand_index">
                        <a t-att-href="brand['website_url']" class="dropdown-item p-2 text-wrap d-inline-block">
                            <div class="media align-items-center o_search_result_item d-inline-block">
                                <div class="media-body px-1">
                                    <div class="h6 font-weight-bold mb-0" t-out="brand['name']"/>
                                </div>
                            </div>
                        </a>
                    </t>
                </div>
            </div>
            <span t-if="results.length" class="d-block pb-0 ms-3 pt-2 te_ce text-muted">Suggested Products</span>
        </xpath>

        <xpath expr="//a[@t-foreach='results']" position="after">
            <span t-if="selected_categories and selected_categories.length" class="d-block pb-0 ps-3 pt-2 te_ce text-muted border-top">
                <i class="fa fa-line-chart d-inline-block me-1"/>
                Trending Categories
            </span>
            <t t-foreach="selected_categories" t-as="category" t-key="category_index">
                <a t-att-href="category['website_url']" class="dropdown-item p-2 text-wrap d-inline-block">
                    <div class="media align-items-center o_search_result_item d-inline-block">
                        <div class="media-body px-1">
                            <div class="h6 font-weight-bold mb-0" t-out="category['name']"/>
                        </div>
                    </div>
                </a>
            </t>
        </xpath>

        <xpath expr="//t[@t-if='hasMoreResults']" position="replace">
            <t t-if="quickLink and quickLink['status'] and quickLink['navigate_type'] == 'attr_value'">
                <a t-att-href="quickLink['url']" type="submit"
                   class="dropdown-item  text-primary search-all"><i class="fa fa-search ml-2 mr-2"/>View all
                    products
                    with
                    <b class="mx-1" t-out="quickLink['name']"/>
                    <span t-out="quickLink['attribute_name']"/></a>
            </t>
            <t t-elif="hasMoreResults">
                <button type="submit" class="dropdown-item text-primary search-all"><i class="fa fa-search ml-2 mr-2"/>
                    View all products</button>
            </t>
        </xpath>
    </t>
</templates>

