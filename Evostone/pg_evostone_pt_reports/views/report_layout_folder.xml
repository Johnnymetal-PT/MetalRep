<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Ajustes ao layout Folder (o que a Evostone usa nos documentos).

        Sao inline (atributos style) e nao CSS no bundle: ver a nota "Porque nao
        ha bundle" no manifesto.
    -->
    <template id="external_layout_folder_pt_stone"
              inherit_id="web.external_layout_folder"
              priority="99">

        <!--
            Logotipo maior. O standard limita-o a 16rem x 8rem; o logotipo da
            Evostone e' largo e baixo, por isso e' a largura que o prende.
            24rem = +50% e, com a proporcao dele, continua dentro da faixa
            cinzenta do cabecalho (174px).
        -->
        <xpath expr="//img[hasclass('o_company_logo_big')]" position="attributes">
            <attribute name="style">max-width: 24rem; max-height: 8rem;</attribute>
        </xpath>

    </template>

</odoo>
