<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_custom" model="ir.ui.view">
        <field name="name">account_MZ.res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Configurações MZ" id="mz_settings">
                    <setting id="progressive_accounts_sale" string="Contas progressivas dos clientes" help="Criar conta para o cliente ao confirmar a fatura">
                        <field name="enable_feature_progressive_accounts_sale"/>
                    </setting>
                    <setting id="progressive_accounts_purchase" string="Contas progressivas dos fornecedores" help="Criar conta para o fornecedor ao confirmar a fatura">
                        <field name="enable_feature_progressive_accounts_purchase"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
