<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_m20_form" model="ir.ui.view">
        <field name="name">report.m20</field>
        <field name="model">report.m20</field>
        <field name="arch" type="xml">
<form>
                    <sheet>
                        <group>
                            <group>     
                                <field name="ano"/>                            
                                <field name="company"/> 
                                <field name="nuit"/>
                                
                            </group>

                            <group>
                                <field name="totalirps"/>                                    
                            </group> 
                        </group>

                        <group>
                            <field name="line_ids" nolabel="1" colspan="2" editable="bottom" required="1"> 
                                <list editable="bottom">
                                    <!-- <field name="employee_id"/> -->
                                    <field name="nuit"/>
                                    <field name="irps" sum="Total IRPS"/>   
                                    <field name="categoria"/> 
                                    <field name="rendimento" sum="Total Rendimento"/>
                                    
                                </list>   
                            </field>
                        </group>
                    </sheet>
                </form>
        </field>
    </record>

</odoo>
