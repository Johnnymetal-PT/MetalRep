<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_vd_form" model="ir.ui.view">
        <field name="name">account.move.VD.form.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_reverse']" position="after">
                <button name="action_debit_note" type="object" string="Nota de débito" class="btn-secondary" invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted'"/>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="is_vd" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_avencas" model="ir.ui.view">
        <field name="name">account.move.form.avencas</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_avenca" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="context">{'dont_redirect_to_payments': True, 'display_account_trust': True, 'default_is_avenca': is_avenca}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
