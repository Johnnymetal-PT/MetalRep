<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ ACTIONS ============ -->

    <record id="action_alvara" model="ir.actions.act_window">
        <field name="name">Alvarás</field>
        <field name="res_model">alvara.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_modelo11" model="ir.actions.act_window">
        <field name="name">Modelo 11</field>
        <field name="res_model">modelo.onze</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_payment_register" model="ir.actions.act_window">
        <field name="name">Modelo 19</field>
        <field name="res_model">payment.register</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_report_account" model="ir.actions.act_window">
        <field name="name">Report Account</field>
        <field name="res_model">report.account.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>


    <record id="apuramentos_action" model="ir.actions.act_window">
        <field name="name">Apuramentos</field>
        <field name="res_model">apuramento.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="apuramentos_template_action" model="ir.actions.act_window">
        <field name="name">Template de Apuramentos</field>
        <field name="res_model">apuramento.template.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="avenca_action" model="ir.actions.act_window">
        <field name="name">folha de Avenças</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[(&#x27;move_type&#x27;, &#x27;in&#x27;, [&#x27;in_invoice&#x27;]),(&#x27;is_avenca&#x27;,&#x27;=&#x27;,True)]</field>
        <field name="context">{&quot;search_default_in_invoice&quot;: 1, &quot;default_move_type&quot;: &quot;in_invoice&quot;, &quot;display_account_trust&quot;: True,&quot;default_is_avenca&quot;:True}</field>
    </record>

    <record id="caixa_action" model="ir.actions.act_window">
        <field name="name">Caixas Registadoras</field>
        <field name="res_model">bank.statement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="m20_action" model="ir.actions.act_window">
        <field name="name">Relatorio M20H</field>
        <field name="res_model">report.m20</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
    </record>


    <!-- ============ MENUS ============ -->

    <menuitem id="Menu_Folha_Avenca"
        name="Folha de Avenças"
        sequence="205"
        parent="account.menu_finance_payables"
        action="account_MZ.avenca_action"
    />

    <menuitem id="Menu_apuramentos"
        name="Apuramentos"
        sequence="39"
        parent="account.menu_finance_entries"
        action="account_MZ.apuramentos_action"
    />

    <menuitem id="caixa_registadoras"
        name="Caixas Registadoras"
        sequence="300"
        parent="account.menu_finance_entries"
        action="account_MZ.caixa_action"
    />

    <menuitem id="report_m20"
        name="M20/H"
        sequence="300"
        parent="account.menu_finance_reports"
        action="account_MZ.m20_action"
    />

    <menuitem id="menu_modelo11"
        name="M11"
        sequence="310"
        parent="account.menu_finance_reports"
        action="account_MZ.action_modelo11"
    />

    <menuitem id="menu_payment_register"
        name="Modelo 19"
        sequence="50"
        parent="account.menu_finance_reports"
        action="account_MZ.action_payment_register"
    />

    <menuitem id="menu_my_custom_module_name_relations"
        name="Relação Nominal"
        sequence="320"
        parent="account.menu_finance_reports"
    />

    <menuitem id="Menu_template_apuramentoss"
        name="Template de Apuramentos"
        sequence="32"
        parent="account.account_account_menu"
        action="account_MZ.apuramentos_template_action"
    />

    <menuitem id="menu_report_account"
        name="Report"
        sequence="10"
        parent="account.account_account_menu"
        action="account_MZ.action_alvara"
    />

    <menuitem id="menu_alvara"
        name="Alvarás"
        sequence="10"
        parent="base.menu_users"
        action="account_MZ.action_alvara"
    />

    <!-- Ocultar menus fiscais sob Relatórios (a pedido). Reversível: active=True. -->
    <record id="menu_payment_register" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="report_m20" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_modelo11" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="menu_my_custom_module_name_relations" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
