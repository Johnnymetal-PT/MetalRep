<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_register_form" model="ir.ui.view">
        <field name="name">payment.register.form</field>
        <field name="model">payment.register</field>
        <field name="arch" type="xml">
<form string="Registo de Pagamentos">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="month_name" readonly="1"/>
                        <field name="totalirps"/>
                        <field name="company"/>
                        
                    </group>
                    <field name="line_ids" readonly="1">
                        <list editable="bottom">
                            <field name="irps" sum="Total IRPS"/>
                        </list>
                    </field>
                </sheet>
                <chatter reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="view_payment_register_tree" model="ir.ui.view">
        <field name="name">payment.register.tree</field>
        <field name="model">payment.register</field>
        <field name="arch" type="xml">
<list string="Registos de Pagamento">
                <field name="name" readonly="1"/>
                <field name="date" readonly="1"/>
                <field name="totalirps"/>
            </list>
        </field>
    </record>

</odoo>
