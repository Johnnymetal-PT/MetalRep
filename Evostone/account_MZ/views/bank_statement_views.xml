<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_bank_statement_form" model="ir.ui.view">
        <field name="name">bank.statement</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
<form>
                    <header>
                        <button name="post_statement" type="object" string="Lançar" invisible="state != 'open'" class="oe_highlight"/>
                        <!-- <button name="apurar_iva_segundo_passo" type="object" string="PRÓXIMO" invisible="steps != 'passo2' or not id" class="oe_highlight"  /> -->
                        <field name="state" widget="statusbar"/>
                    </header>

                    <sheet>

                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_bank_reconcile_widget" type="object" class="oe_stat_button" invisible="not line_ids">
                            <field name="line_ids" widget="statinfo"/>
                        </button>
                        </div>



                        <div class="oe_title"> 
                            <h1>
                                <field name="name" string="Referência" placeholder="e.g. BNK/2021/0001" required="1"/>
                            </h1> 
                        </div>
                            <group>
                                <group>                                
                                    
                                    <field name="journal_id" string="Diario" required="1"/> 
                                    <field name="date" string="Data"/>
                                    <field name="company_id" string="Empresa"/> 
                                </group>

                                <group>
                                    <field name="balance_start" string="Saldo Inicial"/>
                                    <field name="balance_end_real" string="Saldo Final"/>
                                    <field name="balance_end" string="Saldo Computado"/>
                                    
                                </group> 
                            </group>

                            <group>
                                <field name="bank_statement_lines" nolabel="1" colspan="2" editable="bottom" required="1">    
                                    <list editable="bottom">
                                        <field name="date"/> 
                                        <field name="payment_ref" required="1"/> 
                                        <field name="partner_id"/>        
                                        <field name="amount"/>
                                        <field name="journal_id"/> 
                                        <!-- <field name="account_bank_statement_line_id"/>                                           -->
                                    </list>
                                </field>


                                <field name="line_ids" nolabel="1" colspan="2" editable="bottom" invisible="1">    
                                    <list editable="bottom">
                                        <field name="date"/> 
                                        <field name="payment_ref"/> 
                                        <field name="partner_id"/>        
                                        <field name="amount"/>
                                          <field name="journal_id"/>                                      
                                    </list>
                                </field>
                            </group>


                    </sheet>



        
        
            
            </form>
        </field>
    </record>

    <record id="view_bank_statement_tree_custom" model="ir.ui.view">
        <field name="name">bank.statement.list</field>
        <field name="model">bank.statement</field>
        <field name="arch" type="xml">
<list>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="journal_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="balance_start"/>
                    <field name="balance_end_real"/>
                    
                    <field name="balance_end" column_invisible="True"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="state"/>
                    
                   
                </list>
        </field>
    </record>

</odoo>
