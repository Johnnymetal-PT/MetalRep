<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="res_config_settings_view_form_inherit_margin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.margin</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']/block[@name='product_setting_container']" position="after">
                <block title="Margens e Preços" name="margin_setting_container">
                    <setting id="margin_configuration" string="Configuração de Margens" help="Configure os limites para classificação de margens dos produtos">
                        <div class="content-group">
                            <div class="mt16">
                                <div class="d-flex align-items-center">
                                    <label for="margin_low_threshold" string="Margem Baixa"
                                           class="fw-bold" style="min-width: 150px;"/>
                                    <field name="margin_low_threshold" style="width: 60px; margin: 0 8px;"/>
                                    <span>% - produtos com margem abaixo serão destacados em vermelho</span>
                                </div>
                            </div>
                            <div class="mt8">
                                <div class="d-flex align-items-center">
                                    <label for="margin_high_threshold" string="Margem Alta"
                                           class="fw-bold" style="min-width: 150px;"/>
                                    <field name="margin_high_threshold" style="width: 60px; margin: 0 8px;"/>
                                    <span>% - produtos com margem acima serão destacados em verde</span>
                                </div>
                            </div>

                        </div>
                    </setting>
                    <setting id="stone_density_setting"
                             string="Densidade Padrão de Pedra"
                             help="Densidade default para cálculo de peso de produtos dimensionais quando o produto não tem densidade específica configurada.">
                        <div class="content-group">
                            <div class="mt16">
                                <div class="d-flex align-items-center">
                                    <label for="stone_density" string="Densidade"
                                           class="fw-bold" style="min-width: 150px;"/>
                                    <field name="stone_density" style="width: 90px; margin: 0 8px;"/>
                                    <span>kg/m³ - usado para cálculo automático de peso (padrão indústria: 2700)</span>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>