<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Inherit Product Attribute Form View to remove readonly from create_variant -->
    <record id="product_attribute_view_form_inherit" model="ir.ui.view">
        <field name="name">product.attribute.form.inherit.mh_inventory</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <!-- Remove readonly condition from create_variant field -->
            <xpath expr="//field[@name='create_variant']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>