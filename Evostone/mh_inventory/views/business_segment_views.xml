<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Business Segment List View -->
    <record id="view_business_segment_list" model="ir.ui.view">
        <field name="name">business.segment.list</field>
        <field name="model">business.segment</field>
        <field name="arch" type="xml">
            <list string="Segmentos de Negócio">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="product_count"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Business Segment Form View -->
    <record id="view_business_segment_form" model="ir.ui.view">
        <field name="name">business.segment.form</field>
        <field name="model">business.segment</field>
        <field name="arch" type="xml">
            <form string="Segmento de Negócio">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_products" icon="fa-cubes">
                            <field string="Produtos" name="product_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Arquivado" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nome do Segmento"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Descrição">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Business Segment Kanban View -->
    <record id="view_business_segment_kanban" model="ir.ui.view">
        <field name="name">business.segment.kanban</field>
        <field name="model">business.segment</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="color"/>
                <field name="name"/>
                <field name="product_count"/>
                <templates>
                    <t t-name="kanban-card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><t t-esc="record.product_count.value"/> Produtos</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Business Segment Search View -->
    <record id="view_business_segment_search" model="ir.ui.view">
        <field name="name">business.segment.search</field>
        <field name="model">business.segment</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Segmento">
                <field name="name"/>
                <field name="code"/>
                <filter string="Ativo" name="active" domain="[('active', '=', True)]"/>
                <filter string="Arquivado" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Status" name="status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_business_segment" model="ir.actions.act_window">
        <field name="name">Segmentos de Negócio</field>
        <field name="res_model">business.segment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar novo Segmento de Negócio
            </p>
            <p>
                Defina segmentos de negócio para categorizar seus produtos.
            </p>
        </field>
    </record>
</odoo>