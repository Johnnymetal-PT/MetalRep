<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_block_product_create" model="res.groups">
            <field name="name">Bloqueio Criação de Artigos</field>
            <field name="comment">Utilizadores neste grupo não podem criar artigos (produtos).</field>
        </record>

        <record id="rule_block_product_template_create" model="ir.rule">
            <field name="name">Bloquear criação de product.template</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_block_product_create'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_block_product_product_create" model="ir.rule">
            <field name="name">Bloquear criação de product.product</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_block_product_create'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
