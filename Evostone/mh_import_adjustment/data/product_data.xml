<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Produto "Acerto Compras Custo" — usado nas linhas de factura
             que representam custo de aquisição NÃO presente na PO original
             (ex.: combustível, ajustes do fornecedor, etc).
             landed_cost_ok=True → dispara criação de ADJ ao postar a factura. -->
        <record id="product_acerto_compras_custo" model="product.product">
            <field name="name">Acerto Compras Custo</field>
            <field name="default_code">ACERTO.COMPRAS.CUSTO</field>
            <field name="type">service</field>
            <field name="landed_cost_ok" eval="True"/>
            <field name="split_method_landed_cost">by_current_cost_price</field>
            <field name="purchase_ok" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
        </record>
    </data>
</odoo>
