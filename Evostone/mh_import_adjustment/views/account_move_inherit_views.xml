<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_adjustment" model="ir.ui.view">
        <field name="name">account.move.form.inherit.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_import_adjustments" type="object"
                        class="oe_stat_button" icon="fa-balance-scale"
                        invisible="import_adjustment_count == 0">
                    <field name="import_adjustment_count" widget="statinfo" string="Ajustes IMP"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
