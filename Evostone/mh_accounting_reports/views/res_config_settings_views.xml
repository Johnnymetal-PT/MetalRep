<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_map_cc" model="ir.ui.view">
        <field name="name">res.config.settings.form.map.cc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='accounting_reports']" position="inside">
                <setting string="Cc dos Mapas (Cobranças/Pagamentos)"
                         help="Utilizadores que entram em cópia ao enviar os Mapas por e-mail.">
                    <field name="mh_map_cc_user_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
