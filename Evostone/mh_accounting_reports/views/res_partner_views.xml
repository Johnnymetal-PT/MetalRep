<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_collection_map" model="ir.ui.view">
        <field name="name">res.partner.form.collection.map</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <!-- priority alta para garantir que corre depois das views que
             criam os botões (account: 16, account_followup: 5) -->
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <!-- 1. Inserir "Mapa de Cobranças" logo a seguir ao botão "Faturado" -->
            <xpath expr="//button[@name='action_view_partner_invoices']" position="after">
                <button name="action_partner_statement_choice"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        groups="account.group_account_readonly"
                        invisible="customer_rank &lt;= 0">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Mapa de Cobranças</span>
                        <span class="o_stat_value">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_due_invoices" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </span>
                    </div>
                </button>
                <!-- Mapa de Pagamentos (fornecedores) -->
                <button name="action_partner_payment_choice"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        groups="account.group_account_readonly"
                        invisible="supplier_rank &lt;= 0">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Mapa de Pagamentos</span>
                        <span class="o_stat_value">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_due_bills" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </span>
                    </div>
                </button>
            </xpath>

            <!-- 2. Mover "Customer Statement" para o fim do button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <xpath expr="//button[@name='open_customer_statement']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
