<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Renomear o relatório para o título oficial moçambicano -->
        <record id="account_asset.assets_report" model="account.report">
            <field name="name">Mapa das Reintegrações e Amortizações</field>
        </record>

        <!-- Renomear acção cliente (breadcrumb) -->
        <record id="account_asset.action_account_report_assets" model="ir.actions.client">
            <field name="name">Mapa das Reintegrações e Amortizações</field>
        </record>

        <!-- Renomear item de menu em Relatórios -->
        <record id="account_asset.menu_action_account_report_assets" model="ir.ui.menu">
            <field name="name">Mapa das Reintegrações e Amortizações</field>
        </record>

        <!-- Nova coluna: Taxa % (aparece no fim, com subheader próprio) -->
        <record id="assets_report_depreciation_rate_pct" model="account.report.column">
            <field name="report_id" ref="account_asset.assets_report"/>
            <field name="name">Taxa %</field>
            <field name="expression_label">depreciation_rate_pct</field>
            <field name="sequence">100</field>
            <field name="figure_type">string</field>
        </record>

    </data>
</odoo>
