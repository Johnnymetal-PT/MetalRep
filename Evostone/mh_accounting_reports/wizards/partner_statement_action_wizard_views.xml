<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_statement_action_wizard_form" model="ir.ui.view">
        <field name="name">mh.partner.statement.action.wizard.form</field>
        <field name="model">mh.partner.statement.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Mapa de Cobranças">
                <field name="partner_id" invisible="1"/>
                <div class="text-center p-3">
                    <h3 class="mb-3">
                        <i class="fa fa-money text-primary me-2"/>
                        Mapa de Cobranças
                    </h3>
                    <p class="text-muted mb-4">
                        Que acção pretende realizar para
                        <strong><field name="partner_id" readonly="1" nolabel="1" class="d-inline-block"/></strong>?
                    </p>
                </div>
                <footer class="justify-content-center gap-3">
                    <button name="action_view_map"
                            type="object"
                            class="btn btn-primary btn-lg">
                        <i class="fa fa-map me-2"/>Ver Mapa
                    </button>
                    <button name="action_send_email"
                            type="object"
                            class="btn btn-success btn-lg">
                        <i class="fa fa-envelope me-2"/>Enviar por E-mail
                    </button>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
