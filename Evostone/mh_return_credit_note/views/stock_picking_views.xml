<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Stock Picking Form View -->
    <record id="view_stock_picking_form_credit_note" model="ir.ui.view">
        <field name="name">stock.picking.form.credit.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <!-- Prioridade alta (>100) para a alteração do botão Devolução ser a
             ÚLTIMA a aplicar. A vista nativa 'readonly.from.sale' (prio 100)
             repõe o invisible do botão; se a nossa corresse antes, era apagada. -->
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <!-- Adicionar smart button para nota de crédito -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_credit_note"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="credit_note_count == 0">
                    <field name="credit_note_count" widget="statinfo" string="Nota de Crédito"/>
                </button>
            </xpath>

            <!-- Campo hidden para credit_note_id -->
            <xpath expr="//field[@name='scheduled_date']" position="after">
                <field name="credit_note_id" invisible="1"/>
                <field name="fully_returned" invisible="1"/>
                <field name="is_sale_return" invisible="1"/>
            </xpath>

            <!-- Esconder o botão Devolução quando:
                 - a SAÍDA já está totalmente devolvida (evita duplicar), ou
                 - o picking é ele próprio uma devolução de venda (não se
                   devolve uma devolução de venda). -->
            <xpath expr="//button[@data-hotkey='k' and @type='action']" position="attributes">
                <attribute name="invisible">state != 'done' or fully_returned or is_sale_return</attribute>
            </xpath>
        </field>
    </record>

    <!-- Extend Stock Picking List View -->
    <record id="view_stock_picking_list_credit_note" model="ir.ui.view">
        <field name="name">stock.picking.list.credit.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="credit_note_id" string="Nota de Crédito" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
