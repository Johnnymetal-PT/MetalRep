<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Quant Tree View Extension -->
    <record id="view_stock_quant_tree_simple_inherit_dimensions" model="ir.ui.view">
        <field name="name">stock.quant.tree.simple.inherit.dimensions</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="units_on_hand" optional="show"/>
                <field name="units_qty" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="length" optional="hide"/>
                <field name="width" optional="hide"/>
                <field name="thickness" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
