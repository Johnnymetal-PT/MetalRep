<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Esconder botão Create Landed Costs -->
    <record id="view_move_form_hide_landed_costs_button" model="ir.ui.view">
        <field name="name">account.move.form.hide.landed.costs.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="stock_landed_costs.account_view_move_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_create_landed_costs']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_dimensions" model="ir.ui.view">
        <field name="name">account.move.form.dimensions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Tree view - Add dimensions after product_id -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <!-- Campos de controlo invisíveis -->
                <field name="lot_required" column_invisible="1"/>
                <field name="units_qty_editable" column_invisible="1"/>
                <field name="thickness_editable" column_invisible="1"/>
                <!-- Campos visíveis com lógica readonly -->
                <field name="lot_name" readonly="not lot_name" force_save="1" optional="show"/>
                <field name="lot_id"
                       domain="[('product_id','=', product_id)]"
                       context="{'default_product_id': product_id}"
                       required="lot_required"
                       readonly="not lot_id"
                       force_save="1"
                       optional="show"
                       groups="stock.group_production_lot"/>
                <field name="units_qty" readonly="not units_qty_editable" force_save="1" optional="show"/>
                <field name="length" readonly="1" force_save="1" optional="show"/>
                <field name="width" readonly="1" force_save="1" optional="show"/>
                <field name="thickness" readonly="not thickness_editable" force_save="1" optional="show"/>
            </xpath>
            <!-- Form view - Add dimensions after product_id -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="after">
                <!-- Campos de controlo invisíveis -->
                <field name="lot_required" invisible="1"/>
                <field name="units_qty_editable" invisible="1"/>
                <field name="thickness_editable" invisible="1"/>
                <!-- Campos visíveis com lógica readonly -->
                <label for="lot_name" string="Lote"/>
                <field name="lot_name" readonly="not lot_name" force_save="1"/>
                <label for="lot_id" string="Lote/SN"/>
                <field name="lot_id"
                       domain="[('product_id','=', product_id)]"
                       context="{'default_product_id': product_id}"
                       required="lot_required"
                       readonly="not lot_id"
                       force_save="1"
                       groups="stock.group_production_lot"/>
                <label for="units_qty" string="Qtd. Unidades"/>
                <field name="units_qty" readonly="not units_qty_editable" force_save="1"/>
                <label for="length" string="Comprimento"/>
                <field name="length" readonly="1" force_save="1"/>
                <label for="width" string="Largura"/>
                <field name="width" readonly="1" force_save="1"/>
                <label for="thickness" string="Espessura"/>
                <field name="thickness" readonly="not thickness_editable" force_save="1"/>
            </xpath>
            <!-- Alterar string e readonly do campo quantity na list view -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="string">Volume/Área/Unidade</attribute>
                <attribute name="readonly">True</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <!-- Alterar string e readonly do campo quantity no form view -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='quantity']" position="attributes">
                <attribute name="string">Volume/Área/Unidade</attribute>
                <attribute name="readonly">True</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
