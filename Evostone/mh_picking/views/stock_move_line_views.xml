<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Move Line Operations Tree - Add dimensions fields with readonly -->
    <record id="view_stock_move_line_operation_tree_inherit_dimensions" model="ir.ui.view">
        <field name="name">stock.move.line.operations.inherit.dimensions</field>
        <field name="model">stock.move.line</field>
        <field name="priority">1001</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <!-- Adicionar units_qty antes de quantity -->
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="units_qty" optional="show"/>
            </xpath>

            <!-- Tornar quantity sempre readonly com label e placeholder renomeados -->
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="string">Volume/Área/Unidade</attribute>
                <attribute name="placeholder">Volume/Área/Unidade</attribute>
            </xpath>

            <!-- Adicionar dimensões após quantity com readonly -->
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="length" optional="show" readonly="is_dimensions_readonly"/>
                <field name="width" optional="show" readonly="is_dimensions_readonly"/>
                <field name="thickness" optional="show" readonly="is_dimensions_readonly or product_form in ['slab', 'strip', 'tiles']"/>
            </xpath>

            <!-- Tornar product_uom_id sempre readonly (seleciona o segundo campo visível) -->
            <xpath expr="//field[@name='product_uom_id'][@groups='uom.group_uom']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>

            <!-- lot_name é readonly SOMENTE se vem de compra (is_lot_name_readonly) -->
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="readonly">is_lot_name_readonly</attribute>
            </xpath>
        </field>
    </record>

    <!-- Tornar product_uom_id readonly na Detailed Operation Tree -->
    <record id="view_stock_move_line_detailed_operation_tree_inherit_readonly" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit.readonly</field>
        <field name="model">stock.move.line</field>
        <field name="priority">1001</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
        </field>
    </record>
</odoo>
