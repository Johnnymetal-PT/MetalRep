<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Picking Form - Tornar campos readonly quando vem de venda -->
    <record id="view_picking_form_inherit_readonly_from_sale" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.readonly.from.sale</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <!-- Prioridade alta para garantir que esta view é aplicada DEPOIS da
             stock_account.view_picking_form que sobrepõe invisible="0" no botão Return. -->
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Adicionar is_picking_readonly como campo invisível -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_picking_readonly" invisible="1"/>
            </xpath>

            <!-- Esconder o botão "Devolução" quando o picking não está concluído.
                 O `stock_account` standard sobrepõe `invisible="0"` (sempre visível),
                 e combinado com o bug do `sale_stock._can_return` permite criar
                 devoluções de pickings em estado `assigned`. Restauramos a regra
                 correcta de só mostrar o botão quando state == 'done'. -->
            <xpath expr="//button[@name='%(stock.act_stock_return_picking)d']" position="attributes">
                <attribute name="invisible">state != 'done'</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <!-- <attribute name="readonly">True</attribute> -->
                <attribute name="string">Volume/Área/Unidade</attribute>
                <attribute name="placeholder">Volume/Área/Unidade</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="after">
                <field name="lot_name" string="Lote" optional="show" required="product_form != 'none'" readonly="is_move_readonly or product_form == 'none' or state in ('assigned', 'done', 'cancel')" force_save="1"/>
            </xpath>
            <!-- Adicionar campos de dimensões na lista de moves -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="before">
                <field name="is_move_readonly" column_invisible="1"/>
                <field name="product_form" column_invisible="1"/>
                <field name="units_qty" readonly="state in ('assigned', 'done', 'cancel')" force_save="1"/>
                <field name="length" optional="show" readonly="is_move_readonly or product_form == 'none' or state in ('assigned', 'done', 'cancel')" force_save="1"/>
                <field name="width" optional="show" readonly="is_move_readonly or product_form == 'none' or state in ('assigned', 'done', 'cancel')" force_save="1"/>
                <field name="thickness" optional="show" readonly="is_move_readonly or product_form != 'block' or state in ('assigned', 'done', 'cancel')" force_save="1"/>
                <field name="peso" optional="show" readonly="state in ('assigned', 'done', 'cancel')" force_save="1"/>
            </xpath>

            <!-- Adicionar campos de cubicagem após informações gerais -->
            <xpath expr="//group[@name='other_infos']" position="after">
                <group string="Cubicagem" name="cubage_info">
                    <field name="total_area" string="Área Total (m²)"/>
                    <field name="total_volume" string="Volume Total (m³)"/>
                </group>
            </xpath>

            <!-- Tornar partner_id readonly -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'done'] or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar picking_type_id readonly -->
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="readonly">state in ('done', 'cancel') or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar location_id readonly (versão sem multi_locations) -->
            <xpath expr="//field[@name='location_id'][@groups='!stock.group_stock_multi_locations']" position="attributes">
                <attribute name="readonly">state == 'done' or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar location_id readonly (versão com multi_locations) -->
            <xpath expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="readonly">state == 'done' or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar location_dest_id readonly (versão sem multi_locations) -->
            <xpath expr="//field[@name='location_dest_id'][@groups='!stock.group_stock_multi_locations']" position="attributes">
                <attribute name="readonly">state == 'done' or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar location_dest_id readonly (versão com multi_locations) -->
            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
                <attribute name="readonly">state == 'done' or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar origin readonly -->
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'done'] or is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar sale_id readonly -->
            <xpath expr="//field[@name='sale_id']" position="attributes">
                <attribute name="readonly">is_picking_readonly</attribute>
            </xpath>

            <!-- Tornar move_ids_without_package readonly (linhas geridas pelo documento de venda/transformação) -->
            <xpath expr="//field[@name='move_ids_without_package']" position="attributes">
                <attribute name="readonly">(state == 'done' and is_locked) or is_picking_readonly</attribute>
            </xpath>
        </field>
    </record>
</odoo>
