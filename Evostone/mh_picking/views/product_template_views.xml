<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend product template form view -->
    <record id="product_template_picking_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.dimensions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
             <xpath expr="//group[@name='group_general']" position="inside">
                <field name="thickness"
                       placeholder="Espessura"
                       required="product_form in ['slab', 'strip', 'tiles']"
                       invisible="product_form in ['none', 'block']"/>
            </xpath>
        </field>
    </record>
</odoo>