<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequência para Serial Number dos Quants -->
    <record id="seq_stock_quant_serial" model="ir.sequence">
        <field name="name">Stock Quant Serial Number</field>
        <field name="code">stock.quant.serial</field>
        <field name="prefix">#</field>
        <field name="padding">6</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>
</odoo>
