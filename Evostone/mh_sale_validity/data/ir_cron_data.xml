<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Verificar Cotações Expiradas Diariamente -->
        <record id="ir_cron_check_expired_quotations" model="ir.cron">
            <field name="name">Check Expired Sale Quotations</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_quotations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>
    </data>
</odoo>
