<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Regras de registo multiempresa para os modelos exclusivos dos modulos
         a medida que declaram company_id e nao tinham qualquer regra.
         Regras globais, como as multiempresa do standard: sem <field name="groups"/>.
         Ordenadas por peso, medido em campos monetarios e decimais. -->

    <!-- account_MZ | 387 campos numericos -->
    <record id="rule_apuramento_model_company" model="ir.rule">
        <field name="name">apuramento.model: multiempresa</field>
        <field name="model_id" search="[('model', '=', 'apuramento.model')]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

