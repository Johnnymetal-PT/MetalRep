<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_internal_transfer_form" model="ir.ui.view">
        <field name="name">internal.transfer.form</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Transferência Interna" delete="false">
                <header>
                    <button name="action_post"
                            string="Publicar"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft"
                            string="Voltar a Rascunho"
                            type="object"
                            invisible="state not in ('posted', 'cancelled')"
                            confirm="Os lançamentos serão cancelados (não eliminados) e desvinculados. Deseja continuar?"/>
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'cancelled'"
                            confirm="Tem certeza que deseja cancelar esta transferência?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Lançamentos"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Rascunho" bg_color="text-bg-secondary"
                            invisible="state != 'draft'"/>
                    <widget name="web_ribbon" title="Publicada" bg_color="text-bg-success"
                            invisible="state != 'posted'"/>
                    <widget name="web_ribbon" title="Cancelada" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Detalhes da Transferência">
                            <field name="data" readonly="state != 'draft'"/>
                            <field name="valor" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="memorando" readonly="state != 'draft'" placeholder="Descrição opcional..."/>
                        </group>
                        <group string="Diários">
                            <field name="origem" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="destino" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="transfer_account_id" readonly="1"
                                   string="Conta Intermédia"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_internal_transfer_tree" model="ir.ui.view">
        <field name="name">internal.transfer.list</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <list string="Transferências Internas" delete="false" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="data"/>
                <field name="origem"/>
                <field name="destino"/>
                <field name="valor" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_internal_transfer_search" model="ir.ui.view">
        <field name="name">internal.transfer.search</field>
        <field name="model">internal.transfer</field>
        <field name="arch" type="xml">
            <search string="Transferências Internas">
                <field name="name"/>
                <field name="origem"/>
                <field name="destino"/>
                <field name="memorando"/>
                <separator/>
                <filter string="Rascunho" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Publicadas" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Canceladas" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Este Mês" name="this_month" domain="[('data', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Origem" name="group_origem" context="{'group_by': 'origem'}"/>
                    <filter string="Destino" name="group_destino" context="{'group_by': 'destino'}"/>
                    <filter string="Data" name="group_data" context="{'group_by': 'data:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Inherit res.config.settings -->
    <record id="view_account_config_settings_internal_transfer" model="ir.ui.view">
        <field name="name">account.config.settings.internal.transfer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Transferências Internas" id="internal_transfer_settings">
                    <setting string="Conta de Transferência Interna (12404)"
                             help="Conta intermédia usada para transferências entre diários">
                        <field name="transfer_account_id"/>
                    </setting>
                    <setting string="Conta de Recebimentos Pendentes (12402)"
                             help="Conta reconciliável usada para recebimentos pendentes no destino">
                        <field name="outstanding_receipts_account_id"/>
                    </setting>
                    <setting string="Conta de Pagamentos Pendentes (12403)"
                             help="Conta reconciliável usada para pagamentos pendentes na origem">
                        <field name="outstanding_payments_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_internal_transfer" model="ir.actions.act_window">
        <field name="name">Transferências Internas</field>
        <field name="res_model">internal.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_internal_transfer_search"/>
        <field name="context">{'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar nova Transferência Interna
            </p>
            <p>
                Transfira fundos entre diários bancários e de caixa.
                Os lançamentos são criados automaticamente e reconciliados.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_internal_transfer_root"
              name="Transferências Internas"
              parent="account.menu_finance_entries"
              action="action_internal_transfer"
              sequence="50"/>

</odoo>
