<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_credit_control" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.credit.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Adicionar bloco de Controlo de Crédito após bloco de Invoicing -->
            <xpath expr="//block[@name='invoicing_setting_container']" position="after">
                <block title="Controlo de Crédito" name="credit_control_block">
                    <setting id="credit_limit_minimum_setting"
                             string="Limite Mínimo para Bloqueio"
                             help="Define o limite de crédito mínimo para activar o bloqueio">
                        <div class="content-group">
                            <div class="row">
                                <label for="credit_limit_minimum" class="col-lg-4 o_light_label"/>
                                <field name="credit_limit_minimum"/>
                            </div>
                            <div class="text-muted mt8">
                                Apenas clientes com limite de crédito igual ou superior a este valor serão bloqueados
                                quando excederem o limite. Se 0, todos os clientes com limite definido são verificados.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
