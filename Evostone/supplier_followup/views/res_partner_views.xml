<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit partner form to add supplier follow-up fields -->
    <record id="view_partner_form_supplier_followup" model="ir.ui.view">
        <field name="name">res.partner.form.supplier.followup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add supplier follow-up page -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Follow-up de Fornecedor" 
                      invisible="supplier_rank == 0"
                      groups="account.group_account_invoice">
                    <group string="Bill Follow-ups" name="bill_followups" groups="account.group_account_invoice">
                        <group>
                            <div colspan="2" invisible="not supplier_followup_line_id">
                                <field name="supplier_followup_line_id" widget="statusbar" invisible="not unreconciled_supplier_aml_ids" options="{'clickable': '1'}" domain="[('company_id','=', current_company_id)]"/>
                            </div>
                            <label for="supplier_followup_status"/>
                            <div class="o_row">
                                <field name="supplier_followup_status"
                                    widget="badge"
                                    decoration-danger="supplier_followup_status == 'in_need_of_action'"
                                    decoration-warning="supplier_followup_status == 'with_overdue_bills'"
                                    style="width: 50% !important"
                                    class="fb-mincontent"
                                />
                                <a name="action_open_overdue_entries"
                                invisible="supplier_followup_status not in ('in_need_of_action', 'with_overdue_bills')"
                                style="width: 50% !important"
                                class="fw-bold"
                                type="object"
                                >
                                    Faturas em atraso
                                </a>
                            </div>
                            <label for="supplier_followup_reminder_type"/>
                            <div class="o_row">
                                <field name="supplier_followup_reminder_type" widget="radio" style="width: 50% !important" options="{'horizontal': true}" class="fb-mincontent"/>
                                <a class="fw-bold" name="%(supplier_followup.supplier_followup_manual_reminder_action)d" style="width: 50% !important" type="action">Enviar</a>
                            </div>
                            <field name="supplier_followup_next_action_date"/>
                        </group>
                        <group>
                            <field name="supplier_followup_responsible_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
            
            <!-- Add smart button for unpaid bills -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" 
                        type="object" 
                        name="action_view_unpaid_bills"
                        icon="fa-money"
                        invisible="supplier_rank == 0"
                        groups="account.group_account_invoice">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="unpaid_bills_count"/>
                        </span>
                        <span class="o_stat_text">Unpaid Bills</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Add filter to partner search view -->
    <record id="view_res_partner_filter_supplier_followup" model="ir.ui.view">
        <field name="name">res.partner.select.supplier.followup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <separator/>
                <filter string="Faturas em atraso"
                        name="filter_supplier_overdue"
                        domain="[('supplier_followup_status', 'in', ('in_need_of_action', 'with_overdue_bills'))]"
                        groups="account.group_account_invoice"/>
                <filter string="Pagamento a Fornecedor Necessário"
                        name="filter_supplier_action"
                        domain="[('supplier_followup_status', '=', 'in_need_of_action')]"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>