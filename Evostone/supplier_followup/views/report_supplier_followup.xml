<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_supplier_followup_print_all">
            <t t-call="web.html_container">
                <t t-set="company" t-value="docs.env.company"/>
                <div class="oe_structure"></div>
                <t t-foreach="docs" t-as="doc"> <!-- each doc is a 'res.partner' -->
                    <t t-call="web.external_layout">
                        <t t-set="fallback_address" t-value="doc.browse(doc.address_get(['invoice'])['invoice']) or doc"/>
                        <t t-call-assets="account_followup.assets_followup_report" />
                        <div class="page">
                            <!-- Use supplier followup report context -->
                            <span t-out="doc.get_supplier_followup_html(options)">Detalhes do Follow-up de Fornecedor</span>
                        </div>
                    </t>
                </t>
                <div class="oe_structure"></div>
            </t>
        </template>

        <record id="action_report_supplier_followup" model="ir.actions.report">
            <field name="name">Imprimir Carta de Follow-up Letter de Fornecedor</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">supplier_followup.report_supplier_followup_print_all</field>
            <field name="report_file">supplier_followup.report_supplier_followup_print_all</field>
            <field name="print_report_name">'Follow-up de Fornecedor ' + object.display_name</field>
        </record>
    </data>
</odoo>