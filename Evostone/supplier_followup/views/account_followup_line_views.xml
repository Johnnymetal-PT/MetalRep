<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit form view to add supplier template fields -->
    <record id="view_account_followup_followup_line_form_inherit_supplier" model="ir.ui.view">
        <field name="name">account_followup.followup.line.form.inherit.supplier</field>
        <field name="model">account_followup.followup.line</field>
        <field name="inherit_id" ref="account_followup.view_account_followup_followup_line_form"/>
        <field name="arch" type="xml">
            <!-- Add supplier_mail_template_id after mail_template_id -->
            <xpath expr="//field[@name='mail_template_id']" position="after">
                <field name="supplier_mail_template_id" 
                       string="Supplier Email Template" 
                       invisible="not send_email"
                       options="{'no_create': True}"/>
            </xpath>
            
            <!-- Add supplier_sms_template_id after sms_template_id -->
            <xpath expr="//field[@name='sms_template_id']" position="after">
                <field name="supplier_sms_template_id" 
                       string="Supplier SMS Template" 
                       invisible="not send_sms"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit tree view to add supplier template fields -->
    <record id="view_account_followup_followup_line_tree_inherit_supplier" model="ir.ui.view">
        <field name="name">account_followup.followup.line.tree.inherit.supplier</field>
        <field name="model">account_followup.followup.line</field>
        <field name="inherit_id" ref="account_followup.view_account_followup_followup_line_tree"/>
        <field name="arch" type="xml">
            <!-- Add supplier template columns (optional, only if you want them visible in list view) -->
            <xpath expr="//field[@name='send_email']" position="after">
                <field name="supplier_mail_template_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='send_sms']" position="after">
                <field name="supplier_sms_template_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>