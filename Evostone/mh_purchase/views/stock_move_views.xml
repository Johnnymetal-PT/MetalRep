<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Estender domínio e context do quant_id para filtrar por lot_base_name - Detailed Operation Tree -->
    <record id="view_stock_move_line_detailed_operation_tree_inherit_quant_domain" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit.quant.domain</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quant_id']" position="attributes">
                <attribute name="domain">[('product_id', '=', product_id), ('lot_base_name', '=', parent_lot_name), ('location_id', 'child_of', parent_location_id)]</attribute>
                <attribute name="context">{'default_location_id': location_id, 'default_product_id': product_id, 'lot_base_name': parent_lot_name, 'search_view_ref': 'stock.quant_search_view', 'list_view_ref': 'stock.view_stock_quant_tree_simple', 'form_view_ref': 'stock.view_stock_quant_form', 'readonly_form': False}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Estender domínio e context do quant_id para filtrar por lot_base_name - Operation Tree -->
    <record id="view_stock_move_line_operation_tree_inherit_quant_domain" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.inherit.quant.domain</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quant_id']" position="attributes">
                <attribute name="domain">[('product_id', '=', product_id), ('lot_base_name', '=', parent_lot_name), ('location_id', 'child_of', parent_location_id)]</attribute>
                <attribute name="context">{'default_location_id': location_id, 'default_product_id': product_id, 'lot_base_name': parent_lot_name, 'search_view_ref': 'stock.quant_search_view', 'list_view_ref': 'stock.view_stock_quant_tree_simple', 'form_view_ref': 'stock.view_stock_quant_form', 'readonly_form': False}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Adicionar campo quant_id ao Mobile Form para filtrar por lot_base_name -->
    <record id="view_move_line_mobile_form_inherit_quant" model="ir.ui.view">
        <field name="name">stock.move.line.mobile.form.inherit.quant</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_mobile_form"/>
        <field name="arch" type="xml">
            <!-- Adicionar quant_id após product_id -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="quant_id"
                       widget="pick_from"
                       domain="[('product_id', '=', product_id), ('lot_base_name', '=', parent_lot_name), ('location_id', 'child_of', parent_location_id)]"
                       context="{'default_location_id': location_id, 'default_product_id': product_id, 'search_view_ref': 'stock.quant_search_view', 'list_view_ref': 'stock.view_stock_quant_tree_simple', 'form_view_ref': 'stock.view_stock_quant_form', 'readonly_form': False}"
                       groups="stock.group_production_lot"
                       invisible="not show_quant_field"
                       options="{'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
