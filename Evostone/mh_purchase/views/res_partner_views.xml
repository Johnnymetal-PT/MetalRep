<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner/Supplier Form View Extension -->
    <record id="view_partner_form_inherit_container_weight" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.container.weight</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Adicionar campo após o NIF -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="container_max_weight"
                       string="Cap. Máxima por Contentor (KG)"
                       help="Capacidade máxima permitida de carregamento em KG por contentor para pedidos de compra"/>
            </xpath>
        </field>
    </record>
</odoo>
