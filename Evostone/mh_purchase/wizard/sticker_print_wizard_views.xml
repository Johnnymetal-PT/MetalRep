<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sticker_print_wizard_form" model="ir.ui.view">
        <field name="name">sticker.print.wizard.form</field>
        <field name="model">sticker.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir Stickers">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="print_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print" string="Imprimir" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sticker_print_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir Stickers</field>
        <field name="res_model">sticker.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
