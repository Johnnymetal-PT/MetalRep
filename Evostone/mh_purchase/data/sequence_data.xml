<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequência para Documento de Importação -->
        <record id="seq_import_document" model="ir.sequence">
            <field name="name">Import Document</field>
            <field name="code">import.document</field>
            <field name="prefix">IMP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequência para Stock Inicial -->
        <record id="seq_stock_initial" model="ir.sequence">
            <field name="name">Stock Initial</field>
            <field name="code">stock.initial</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>