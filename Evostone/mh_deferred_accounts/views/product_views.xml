<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_deferred" model="ir.ui.view">
        <field name="name">product.template.form.deferred</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="inside">
                <group string="Diferimentos" invisible="type == 'combo'">
                    <field name="deferred_expense_account_id"
                           options="{'no_create': True}"/>
                    <field name="deferred_revenue_account_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
