<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_base_lot_group_list" model="ir.ui.view">
        <field name="name">base.lot.group.list</field>
        <field name="model">base.lot.group</field>
        <field name="arch" type="xml">
            <list string="Grupos de Lotes" create="0" delete="0">
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="base_lot_name" optional="show"/>
                <field name="product_id"/>
                <field name="product_form" optional="hide"/>
                <field name="standard_price" string="Custo Médio (SVL)" optional="show" widget="monetary"/>
                <field name="pcmp" string="PCMP/m²" readonly="1" optional="show" widget="monetary"/>
                <field name="list_price" optional="show" widget="monetary"/>
                <field name="margin" optional="show"/>
                <field name="lot_price_group_count" optional="show"/>
                <field name="quantity_svl" optional="hide"/>
                <field name="value_svl" optional="hide" widget="monetary"/>
                <field name="total_quantity" optional="hide"/>
                <field name="total_value" optional="hide" widget="monetary"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_base_lot_group_form" model="ir.ui.view">
        <field name="name">base.lot.group.form</field>
        <field name="model">base.lot.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de Lotes" create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_price_groups"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes">
                            <field name="lot_price_group_count" widget="statinfo" string="Grupos de Dimensões"/>
                        </button>
                        <button name="action_view_stock_valuation_layers" type="object"
                                class="oe_stat_button" icon="fa-bars">
                            <field name="value_svl" widget="statinfo" string="Valor SVL"/>
                        </button>
                        <button name="action_view_pcmp_fiscal_years" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <span>Anos Fiscais</span>
                        </button>
                        <button name="action_recalculate_pcmp" type="object"
                                class="oe_stat_button" icon="fa-refresh"
                                string="Recalcular PCMP"
                                groups="mh_base.group_mhc_admin"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="product_info" string="Produto">
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="base_lot_name"/>
                            <field name="product_form" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="totals" string="Totais em Estoque">
                            <field name="total_quantity"/>
                            <field name="total_value" widget="monetary"/>
                        </group>
                    </group>

                    <group>
                        <field name="currency_id" invisible="1"/>
                        <group name="valuation" string="Valorização PCMP">
                            <field name="pcmp" string="PCMP" readonly="1" widget="monetary"/>
                            <field name="quantity_svl"/>
                            <field name="value_svl" widget="monetary"/>
                            <field name="standard_price" string="Custo Médio (SVL)" widget="monetary"/>
                        </group>
                        <group name="pricing" string="Preços de Venda">
                            <div class="o_row">
                                <field name="manual_sale_price" widget="boolean_toggle"/>
                                <label for="manual_sale_price" string="PCMP Manual"/>
                            </div>
                            <field name="manual_pcmp"
                                   string="PCMP Manual (por m²/m³)"
                                   widget="monetary"
                                   invisible="not manual_sale_price"/>
                            <field name="margin"/>
                            <field name="list_price" readonly="1" widget="monetary"
                                   string="Preço Venda (por m²/m³)"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Grupos de Dimensões" name="price_groups">
                            <field name="lot_price_group_ids">
                                <list>
                                    <button name="get_formview_action" type="object"
                                            icon="fa-external-link" title="Abrir formulário"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="length" optional="show"/>
                                    <field name="width" optional="show"/>
                                    <field name="thickness" optional="hide"/>
                                    <field name="area" optional="hide"/>
                                    <field name="volume" optional="hide"/>
                                    <field name="use_base_pricing" widget="boolean_toggle"/>
                                    <field name="pcmp" optional="show" widget="monetary"/>
                                    <field name="list_price" widget="monetary"/>
                                    <field name="margin"/>
                                    <field name="lot_count" optional="show"/>
                                    <field name="total_quantity" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Camadas de Valorização" name="svl">
                            <field name="stock_valuation_layer_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="value"/>
                                    <field name="remaining_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_base_lot_group_search" model="ir.ui.view">
        <field name="name">base.lot.group.search</field>
        <field name="model">base.lot.group</field>
        <field name="arch" type="xml">
            <search string="Buscar Grupos Base">
                <field name="name"/>
                <field name="base_lot_name"/>
                <field name="product_id"/>

                <filter string="Com Grupos de Dimensões"
                        name="with_price_groups"
                        domain="[('lot_price_group_count', '>', 0)]"/>
                <filter string="Sem Grupos de Dimensões"
                        name="without_price_groups"
                        domain="[('lot_price_group_count', '=', 0)]"/>


                <group expand="0" string="Agrupar Por">
                    <filter string="Produto"
                            name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Nome Base do Lote"
                            name="group_base_lot_name"
                            context="{'group_by': 'base_lot_name'}"/>
                    <filter string="Empresa"
                            name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_base_lot_group" model="ir.actions.act_window">
        <field name="name">Grupos de Lotes</field>
        <field name="res_model">base.lot.group</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar novo Grupo de Lotes
            </p>
            <p>
                Grupos base agregam lotes pelo nome base (ex: "LOTE_CARRARA"),
                definindo preços padrão que são aplicados a todos os grupos de dimensões associados.
            </p>
            <p>
                Esta é a hierarquia superior de gestão de preços. Alterações aqui
                afetam automaticamente todos os grupos de dimensões que usam preços base.
            </p>
            <p>
                O campo PCMP (Valorização) é usado para cálculo de custo médio ponderado
                com contexto de ano fiscal.
            </p>
        </field>
    </record>

    <!-- Menu - Sob Inventário / Produtos -->
    <menuitem id="menu_base_lot_group_inventory"
              name="Grupos de Lotes"
              parent="stock.menu_stock_inventory_control"
              action="action_base_lot_group"
              groups="stock.group_stock_manager"
              sequence="45"/>

    <!-- Menu - Sob Vendas / Produtos -->
    <menuitem id="menu_base_lot_group_sale"
              name="Grupos de Lotes"
              parent="sale.product_menu_catalog"
              action="action_base_lot_group"
              groups="stock.group_stock_manager"
              sequence="45"/>

</odoo>
