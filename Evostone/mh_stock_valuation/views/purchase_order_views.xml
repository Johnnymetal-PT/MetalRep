<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Purchase Order Line Form View -->
    <record id="purchase_order_form_inherit_lot_name" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.lot.name</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="lot_name" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
