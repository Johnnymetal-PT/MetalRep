<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista de snapshots -->
    <record id="view_stock_move_line_snapshot_list" model="ir.ui.view">
        <field name="name">stock.move.line.snapshot.list</field>
        <field name="model">stock.move.line.snapshot</field>
        <field name="arch" type="xml">
            <list string="Snapshots Pré-Split"
                  create="false" delete="false" edit="false"
                  decoration-muted="True">
                <field name="create_date" string="Capturado em"/>
                <field name="picking_id" string="Picking"/>
                <field name="product_id" string="Artigo"/>
                <field name="lot_name_base" string="Lote"/>
                <field name="units_qty" string="Quantidade"/>
                <field name="length" string="Comprimento"/>
                <field name="width" string="Largura"/>
                <field name="thickness" string="Espessura"/>
                <field name="quantity" string="Volume/Área/Unidade" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Form (somente leitura) -->
    <record id="view_stock_move_line_snapshot_form" model="ir.ui.view">
        <field name="name">stock.move.line.snapshot.form</field>
        <field name="model">stock.move.line.snapshot</field>
        <field name="arch" type="xml">
            <form string="Snapshot Pré-Split" create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="picking_id" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="lot_name_base" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="units_qty" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="length" readonly="1"/>
                            <field name="width" readonly="1"/>
                            <field name="thickness" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Botão no popup do stock.move (visível só com snapshots e para admin) -->
    <record id="view_stock_move_operations_snapshot_button" model="ir.ui.view">
        <field name="name">stock.move.operations.snapshot.button</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="snapshot_ids" invisible="1"/>
                <div class="oe_button_box" groups="base.group_system"
                     invisible="not snapshot_ids" style="margin: 10px;">
                    <button name="action_open_snapshots" type="object"
                            class="btn btn-secondary"
                            icon="fa-history"
                            string="Ver Snapshot Pré-Split"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
