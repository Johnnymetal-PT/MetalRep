<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Tipo de Operação: Stock Inicial -->
        <!-- Nota: default_location_src_id será configurado via função Python -->
        <!-- pois a localização "Inventory adjustment" é criada por empresa -->
        <record id="picking_type_initial_stock" model="stock.picking.type">
            <field name="name">Stock Inicial</field>
            <field name="code">incoming</field>
            <field name="sequence_code">STK-INI</field>
            <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="use_create_lots">True</field>
            <field name="use_existing_lots">False</field>
        </record>

        <!-- Função para configurar a localização de origem -->
        <function model="stock.picking.type" name="_set_initial_stock_location"/>

    </data>
</odoo>
