<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_stock_location_form_consumption" model="ir.ui.view">
            <field name="name">stock.location.form.consumption</field>
            <field name="model">stock.location</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <field name="usage" position="after">
                    <field name="is_consumption" invisible="usage not in ('internal', 'customer')"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
