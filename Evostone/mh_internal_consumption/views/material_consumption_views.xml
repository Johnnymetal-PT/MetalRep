<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- FORM VIEW -->
        <record id="view_material_consumption_form" model="ir.ui.view">
            <field name="name">material.consumption.form</field>
            <field name="model">material.consumption</field>
            <field name="arch" type="xml">
                <form copy="false" delete="false">
                    <header>
                        <button name="action_confirm"
                                string="Confirmar"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"
                                confirm="Ao confirmar, o stock será verificado e o movimento de stock será criado. Deseja continuar?"/>
                        <button name="action_done"
                                string="Concluir"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'confirmed'"
                                groups="mh_internal_consumption.group_consumption_manager"
                                confirm="Ao concluir, o stock será efectivamente transferido para a localização de consumo. Esta acção não pode ser revertida. Deseja continuar?"/>
                        <button name="action_cancel"
                                string="Cancelar"
                                type="object"
                                invisible="state in ('done', 'cancelled')"
                                confirm="Deseja cancelar este consumo de material?"/>
                        <button name="action_draft"
                                string="Voltar a Rascunho"
                                type="object"
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    name="action_view_pickings"
                                    class="oe_stat_button"
                                    icon="fa-truck"
                                    invisible="picking_count == 0">
                                <field name="picking_count" widget="statinfo" string="Movimentos"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Rascunho" bg_color="text-bg-info"
                                invisible="state != 'draft'"/>
                        <widget name="web_ribbon" title="Confirmado" bg_color="text-bg-warning"
                                invisible="state != 'confirmed'"/>
                        <widget name="web_ribbon" title="Concluído" bg_color="text-bg-success"
                                invisible="state != 'done'"/>
                        <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger"
                                invisible="state != 'cancelled'"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="user_id" readonly="state != 'draft'"/>
                                <field name="department" readonly="state in ('done', 'cancelled')"/>
                            </group>
                            <group>
                                <field name="warehouse_id" readonly="state != 'draft'"/>
                                <field name="consumption_location_id" readonly="1"/>
                                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Linhas de Consumo" name="lines">
                                <field name="line_ids"
                                       readonly="state in ('confirmed', 'done', 'cancelled')">
                                    <list editable="bottom">
                                        <field name="product_id" domain="[('product_classification', 'in', ['auxiliary_material', 'packaging_material'])]"/>
                                        <field name="quantity"/>
                                        <field name="free_qty" column_invisible="1"/>
                                        <widget name="consumption_availability_widget"/>
                                        <field name="uom_id" readonly="1" force_save="1"/>
                                        <field name="notes" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Observações" name="notes">
                                <field name="notes" placeholder="Observações adicionais..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- LIST VIEW -->
        <record id="view_material_consumption_tree" model="ir.ui.view">
            <field name="name">material.consumption.tree</field>
            <field name="model">material.consumption</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'"
                      decoration-warning="state == 'confirmed'"
                      decoration-success="state == 'done'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="department"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'confirmed'"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_material_consumption_search" model="ir.ui.view">
            <field name="name">material.consumption.search</field>
            <field name="model">material.consumption</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="department"/>
                    <separator/>
                    <filter name="filter_draft" string="Rascunho" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_confirmed" string="Confirmado" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_done" string="Concluído" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="filter_my" string="Meus Consumos" domain="[('user_id', '=', uid)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="groupby_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="groupby_user" string="Solicitado por" context="{'group_by': 'user_id'}"/>
                        <filter name="groupby_department" string="Departamento" context="{'group_by': 'department'}"/>
                        <filter name="groupby_date" string="Data" context="{'group_by': 'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_material_consumption" model="ir.actions.act_window">
            <field name="name">Consumo de Material</field>
            <field name="res_model">material.consumption</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_material_consumption_search"/>
            <field name="context">{'search_default_filter_my': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Criar novo consumo de material
                </p>
                <p>
                    Registe o consumo de materiais auxiliares e de embalagem.
                </p>
            </field>
        </record>

    </data>
</odoo>
