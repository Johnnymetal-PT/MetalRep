<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="email_template_invoice_send" model="mail.template">
        <field name="name">Fatura: Envio Personalizado</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">{{ object.company_id.name }} Fatura (Ref {{ object.name or 'n/a' }})</field>
        <field name="email_from">{{ (user.email_formatted or object.company_id.email_formatted or object.invoice_user_id.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="description">Envio personalizado de faturas ao cliente com anexo</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Caro(a),
        <t t-if="object.partner_id.parent_id">
            <t t-out="object.partner_id.name or ''">Brandon Freeman</t> (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>),
        </t>
        <t t-else="">
            <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        </t>
        <br /><br />
        Encontre a sua
        <t t-if="object.name">
            fatura <span style="font-weight:bold;" t-out="object.name or ''">INV/2021/05/0005</span>
        </t>
        <t t-else="">
            factura
        </t>
        no montante de <span style="font-weight:bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 143,750.00</span>
        da empresa <t t-out="object.company_id.name or ''">YourCompany</t>.
        <t t-if="object.payment_state in ('paid', 'in_payment')">
            Esta fatura já está paga.
        </t>
        <t t-else="">
            <br />
            Solicitamos o seu pagamento com a maior brevidade possível<t t-if="object.payment_reference">, utilizando a seguinte comunicação: <strong t-out="object.payment_reference or ''">INV/2021/05/0005</strong></t>.
        </t>
        <br />
        Em caso de dúvida, não hesite em nos contactar.
        <br /><br />
        <i><b>Nota:</b> Caso o pagamento já tenha sido efectuado por favor ignore a solicitação do mesmo.</i>
        <br /><br />
        Cumprimentos<br />
        Best regards
        <br /><br />
        <t t-if="not is_html_empty(user.signature)">
            <t t-out="user.signature or ''">--<br/>A Empresa</t>
        </t>
        <t t-else="">
            <t t-out="object.company_id.name or ''">A Empresa</t>
        </t>
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[]"/>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
