        <!-- Bloquear edição do `name` (número do lançamento) na UI -->
        <record id="view_move_form_name_readonly" model="ir.ui.view">
            <field name="name">account.move.form.name.readonly</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Targeta o campo `name` VISÍVEL (o que tem options placeholder) -->
                <xpath expr="//field[@name='name'][@options]" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
            </field>
        </record>
