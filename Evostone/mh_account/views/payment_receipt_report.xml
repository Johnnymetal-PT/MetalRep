<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Herdar o template do relatório de recibo de pagamento -->
        <template id="report_payment_receipt_document_inherit" inherit_id="account.report_payment_receipt_document">

            <!-- Modificar título para mostrar número de recibo quando disponível -->
            <xpath expr="//h3" position="replace">
                <h3>
                    <strong>
                        <t t-if="o.receipt_number">
                            <span>Recibo: </span>
                            <span t-field="o.receipt_number"/>
                        </t>
                        <t t-else="">
                            <span t-field="o.payment_receipt_title"/>:
                            <span t-field="o.name"/>
                        </t>
                    </strong>
                </h3>
            </xpath>

        </template>
    </data>
</odoo>