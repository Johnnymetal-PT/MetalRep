<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bank Statement Import Wizard Form View (Safe Version for Odoo 18) -->
    <record id="view_bank_statement_import_wizard_form" model="ir.ui.view">
        <field name="name">bank.statement.import.wizard.form</field>
        <field name="model">bank.statement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Bank Statement">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="upload,preview,mapping,processing,done"/>
                </header>
                <sheet>
                    <!-- Progress Indicator -->
                    <field name="progress_percentage" widget="progressbar" invisible="progress_percentage == 0"/>
                    <field name="progress_message" readonly="1" invisible="progress_percentage == 0"/>

                    <!-- Upload State -->
                    <group string="Import Bank Statement" invisible="state != 'upload'">
                        <group>
                            <field name="bank_type" widget="radio" required="1"/>
                        </group>
                        <group>
                            <field name="data_file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="Options">
                            <field name="check_duplicates"/>
                        </group>
                        <field name="message" readonly="1"/>
                    </group>

                    <!-- Preview State -->
                    <group string="Data Preview" invisible="state != 'preview'">
                        <group>
                            <field name="total_lines_count" readonly="1"/>
                            <field name="show_all_preview"/>
                        </group>
                        <group invisible="duplicate_count == 0">
                            <field name="duplicate_count" readonly="1"/>
                            <field name="duplicate_action"/>
                        </group>
                        <separator string="File Data"/>
                        <field name="preview_data" readonly="1"/>
                        <field name="duplicate_details" readonly="1" invisible="duplicate_count == 0"/>
                    </group>

                    <!-- Mapping State -->
                    <group string="Field Mapping" invisible="state != 'mapping'">
                        <group>
                            <field name="date_column"/>
                            <field name="description_column"/>
                            <field name="amount_column"/>
                        </group>
                        <separator string="Advanced Mapping" invisible="not enable_field_mapping"/>
                        <field name="field_mapping" invisible="not enable_field_mapping"/>
                    </group>

                    <!-- Processing State -->
                    <group string="Processing Import..." invisible="state != 'processing'">
                        <div style="text-align: center; padding: 20px;">
                            <h4>Please wait...</h4>
                            <field name="progress_percentage" widget="progressbar"/>
                            <field name="progress_message" readonly="1"/>
                        </div>
                    </group>

                    <!-- Done State -->
                    <group string="Import Complete" invisible="state != 'done'">
                        <field name="import_summary" readonly="1" invisible="not import_summary"/>
                        <group>
                            <field name="lines_processed" readonly="1"/>
                            <field name="lines_imported" readonly="1"/>
                            <field name="lines_skipped" readonly="1"/>
                            <field name="lines_error" readonly="1"/>
                        </group>
                        <separator string="Import Log"/>
                        <field name="import_log" readonly="1"/>
                    </group>

                    <!-- Hidden Fields -->
                    <field name="processed_data" invisible="1"/>
                    <field name="is_processing" invisible="1"/>
                    <field name="preview_lines_count" invisible="1"/>
                    <field name="enable_field_mapping" invisible="1"/>
                </sheet>
                <footer>
                    <!-- Upload State Buttons -->
                    <button string="Analyze File" 
                            name="action_analyze_file"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'upload' or not data_file or not bank_type"/>
                    <button string="Cancel" 
                            name="action_cancel"
                            type="object"
                            invisible="state != 'upload'"/>
                    
                    <!-- Preview State Buttons -->
                    <button string="Import Now" 
                            name="action_import"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button string="Configure Mapping" 
                            name="action_configure_mapping"
                            type="object"
                            invisible="state != 'preview' or bank_type in ['bim', 'bci', 'card']"/>
                    <button string="Back" 
                            name="action_back_to_upload"
                            type="object"
                            invisible="state != 'preview'"/>
                    
                    <!-- Mapping State Buttons -->
                    <button string="Import with Mapping" 
                            name="action_import"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'mapping'"/>
                    <button string="Back to Preview" 
                            name="action_back_to_preview"
                            type="object"
                            invisible="state != 'mapping'"/>
                    
                    <!-- Done State Buttons -->
                    <button string="Go to Accounting" 
                            name="action_go_to_accounting"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="New Import" 
                            name="action_back_to_upload"
                            type="object"
                            invisible="state != 'done'"/>
                    <button string="Close" 
                            name="action_cancel"
                            type="object"
                            invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_bank_statement_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Bank Statement</field>
        <field name="res_model">bank.statement.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_bank_statement_import_wizard_form"/>
    </record>
</odoo>