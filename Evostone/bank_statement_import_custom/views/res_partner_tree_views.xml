<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Create a new partner list view with accg_nr_order -->
    <record id="view_partner_tree_with_accg_order" model="ir.ui.view">
        <field name="name">res.partner.tree.with.accg.order</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Parceiros">
                <field name="accg_nr_order" string="Nº Ordem" optional="show"/>
                <field name="accg_nr_order_customer" string="Nº Cliente" optional="hide" invisible="1"/>
                <field name="accg_nr_order_supplier" string="Nº Fornecedor" optional="hide" invisible="1"/>
                <field name="display_name" string="Nome"/>
                <field name="function" optional="hide"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="city" optional="hide"/>
                <field name="state_id" optional="hide"/>
                <field name="country_id" optional="show"/>
                <field name="vat" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    
    <!-- Action to use our custom list view -->
    <record id="action_partner_with_accg_order" model="ir.actions.act_window">
        <field name="name">Parceiros (Com Nº Ordem)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="view_id" ref="view_partner_tree_with_accg_order"/>
    </record>
    
    <!-- Menu item for the custom view -->
    <menuitem id="menu_partner_with_accg_order"
              name="Parceiros com Ordem"
              parent="contacts.res_partner_menu_contacts"
              action="action_partner_with_accg_order"
              sequence="2"/>
</odoo>