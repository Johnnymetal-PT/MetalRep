<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================
             VISTA DE LISTA PARA CONFIGURAÇÃO DE CONTAS
             ================================================================ -->

        <record id="view_partner_account_config_list" model="ir.ui.view">
            <field name="name">res.company.partner.account.config.list</field>
            <field name="model">res.company.partner.account.config</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="partner_type"/>
                    <field name="prefix"/>
                    <field name="sequence_digits"/>
                    <field name="account_type"/>
                    <field name="distinguish_nationality"/>
                    <field name="national_prefix" invisible="not distinguish_nationality"/>
                    <field name="foreign_prefix" invisible="not distinguish_nationality"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_partner_account_config_form" model="ir.ui.view">
            <field name="name">res.company.partner.account.config.form</field>
            <field name="model">res.company.partner.account.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Configuração Base">
                                <field name="name"/>
                                <field name="partner_type"/>
                                <field name="prefix"/>
                                <field name="sequence_digits"/>
                                <field name="account_type"/>
                            </group>
                            <group string="Nacionalidade">
                                <field name="distinguish_nationality"/>
                                <field name="national_prefix" invisible="not distinguish_nationality"/>
                                <field name="foreign_prefix" invisible="not distinguish_nationality"/>
                            </group>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================================================================
             CONFIGURAÇÃO NA EMPRESA
             ================================================================ -->

        <record id="view_company_form_partner_account" model="ir.ui.view">
            <field name="name">res.company.form.partner.account</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Contas Parceiros" name="partner_accounts">
                        <group>
                            <field name="auto_create_partner_accounts"/>
                        </group>

                        <group string="Configurações de Contas" invisible="not auto_create_partner_accounts">
                            <field name="partner_account_config_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="partner_type"/>
                                    <field name="prefix"/>
                                    <field name="sequence_digits"/>
                                    <field name="account_type"/>
                                    <field name="distinguish_nationality"/>
                                    <field name="national_prefix" invisible="not distinguish_nationality"/>
                                    <field name="foreign_prefix" invisible="not distinguish_nationality"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </group>

                        <div class="alert alert-info" role="alert" invisible="not auto_create_partner_accounts">
                            <p><strong>Como funciona:</strong></p>
                            <p>O código da conta é: <strong>PREFIXO + SEQUÊNCIA</strong></p>
                            <p>Exemplo: Prefixo <strong>4111</strong> + Sequência 4 dígitos = <strong>41110001</strong></p>
                            <p class="mb-0">Se "Distinguir Nacional/Estrangeiro" estiver ativo, usa prefixos diferentes conforme o país do parceiro.</p>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
