<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_pgf" model="ir.ui.view">
        <field name="name">account.move.form.pgf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botão "Pago por Funcionário" no header (último botão) -->
            <xpath expr="//header/button[@name='button_set_checked']" position="after">
                <button name="action_open_pgf_wizard"
                        type="object"
                        string=" Pago por Funcionário"
                        icon="fa-user"
                        class="btn-info"
                        invisible="state != 'posted' or amount_residual &lt;= 0 or move_type != 'in_invoice'"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
