<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_by_employee_wizard_form" model="ir.ui.view">
        <field name="name">payment.by.employee.wizard.form</field>
        <field name="model">payment.by.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Pago por Funcionário">
                <group>
                    <field name="invoice_id" readonly="1"/>
                    <field name="invoice_residual" readonly="1"/>
                    <field name="date"/>
                    <field name="employee_id" domain="[('supplier_rank', '&gt;', 0), ('parent_id', '=', False)]"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_by_employee_wizard" model="ir.actions.act_window">
        <field name="name">Pago por Funcionário</field>
        <field name="res_model">payment.by.employee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
