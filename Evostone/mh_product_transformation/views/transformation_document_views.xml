<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transformation Document List View -->
    <record id="view_transformation_document_list" model="ir.ui.view">
        <field name="name">transformation.document.list</field>
        <field name="model">transformation.document</field>
        <field name="arch" type="xml">
            <list string="Documentos de Transformação">
                <field name="name"/>
                <field name="date_document"/>
                <field name="transformer_id"/>
                <field name="location_origin_id"/>
                <field name="location_dest_id"/>
                <field name="total_value" sum="Total" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'transit'"
                       decoration-danger="state == 'transforming'"
                       decoration-primary="state == 'reception'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Transformation Document Form View -->
    <record id="view_transformation_document_form" model="ir.ui.view">
        <field name="name">transformation.document.form</field>
        <field name="model">transformation.document</field>
        <field name="arch" type="xml">
            <form string="Documento de Transformação">
                <header>
                    <button name="action_approve_all_differences" string="Aprovar Todas Diferenças" type="object"
                            class="btn-warning"
                            invisible="state in ('done', 'cancel') or not has_unapproved_differences"
                            groups="base.group_system"
                            icon="fa-check-square-o"/>
                    <button name="action_start" string="Enviar" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Confirma o envio? A mercadoria sai do stock para transformação e o documento fica Em Trânsito. Esta acção valida a saída e não é reversível sem cancelar."/>
                    <button name="action_transforming" string="Transformar" type="object"
                            invisible="state != 'transit'"
                            confirm="Confirma que os produtos estão em transformação?"/>
                    <button name="action_reception" string="Receber" type="object"
                            invisible="state != 'transforming'"
                            confirm="Confirma a receção dos produtos transformados?"/>
                    <button name="action_done" string="Validar" type="object" class="btn-success"
                            invisible="state != 'reception'"
                            confirm="Confirma a validação da entrada no sistema?"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset_draft" string="Voltar a Rascunho" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,transit,transforming,reception,done"/>
                </header>
                <sheet>
                    <!-- Ribbons para diferentes estados -->
                    <widget name="web_ribbon"
                            title="Rascunho"
                            bg_color="text-bg-info"
                            invisible="state != 'draft'"/>
                    <widget name="web_ribbon"
                            title="Em Trânsito"
                            bg_color="text-bg-warning"
                            invisible="state != 'transit'"/>
                    <widget name="web_ribbon"
                            title="Em Transformação"
                            bg_color="text-bg-danger"
                            invisible="state != 'transforming'"/>
                    <widget name="web_ribbon"
                            title="Em Receção"
                            bg_color="text-bg-primary"
                            invisible="state != 'reception'"/>
                    <widget name="web_ribbon"
                            title="Concluído"
                            bg_color="text-bg-success"
                            invisible="state != 'done'"/>
                    <widget name="web_ribbon"
                            title="Cancelado"
                            bg_color="text-bg-secondary"
                            invisible="state != 'cancel'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="picking_count" widget="statinfo" string="Movimentos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informações Gerais">
                            <field name="date_document" readonly="state != 'draft'"/>
                            <field name="transformer_id" readonly="state != 'draft'"/>
                            <field name="carrier_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group string="Localizações">
                            <field name="location_origin_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="location_dest_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Datas Previstas">
                            <field name="date_expected_departure" readonly="state != 'draft'"/>
                            <field name="date_expected_arrival" readonly="state != 'draft'"/>
                        </group>
                        <group string="Tracking Logístico">
                            <field name="daily_cost" readonly="state != 'draft'" widget="monetary"/>
                            <field name="days_stopped" readonly="1"/>
                            <field name="total_waiting_cost" readonly="1" widget="monetary"/>
                            <field name="logistics_status" readonly="1" widget="badge"
                                   decoration-success="logistics_status == 'on_time'"
                                   decoration-danger="logistics_status == 'delayed'"
                                   decoration-warning="logistics_status == 'waiting'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <separator string="PRODUTOS PARA TRANSFORMAR"/>
                    <field name="input_line_ids" readonly="state != 'draft'">
                        <list editable="bottom"
                              decoration-success="is_gain"
                              decoration-warning="is_loss">
                            <control>
                                <button name="action_open_stock_wizard"
                                        string="Selecionar Estoque"
                                        type="object"
                                        class="px-4 btn-link"
                                        icon="fa-cubes"
                                        context="{'transformation_id': parent.id}"/>
                            </control>
                            <field name="product_id" readonly="1" domain="[('can_be_transformed', '=', True), ('product_form', 'in', ['block', 'slab'])]"/>
                            <field name="product_form" readonly="1"/>
                            <field name="product_tracking" readonly="1" column_invisible="True"/>
                            <field name="lot_id" readonly="1"
                                   optional="show"
                                   required="product_tracking == 'lot'"
                                   decoration-danger="product_tracking == 'lot' and not lot_id"/>
                            <field name="units_qty" readonly="1" optional="show"/>
                            <field name="length" readonly="1" optional="show"/>
                            <field name="width" readonly="1" optional="show"/>
                            <field name="thickness" readonly="1" optional="show"/>
                            <field name="quantity" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="preco_custo" readonly="1" optional="hide"/>
                            <field name="subtotal" readonly="1" sum="Total"/>
                            <!-- Campos de controle ganho/perda -->
                            <field name="has_difference" column_invisible="True"/>
                            <field name="is_gain" column_invisible="True"/>
                            <field name="is_loss" column_invisible="True"/>
                            <field name="volume_consumed" optional="hide" readonly="1"
                                   decoration-success="is_gain"
                                   decoration-warning="is_loss"/>
                            <field name="volume_difference" optional="hide" readonly="1"
                                   decoration-success="is_gain and volume_difference &gt; 0"
                                   decoration-warning="is_loss and volume_difference &lt; 0"/>
                            <field name="volume_difference_percent" optional="hide" readonly="1" widget="percentage"
                                   decoration-success="is_gain and volume_difference_percent &gt; 0"
                                   decoration-warning="is_loss and volume_difference_percent &lt; 0"/>
                            <field name="admin_approved"
                                   optional="hide"
                                   invisible="not has_difference"
                                   groups="base.group_system"
                                   widget="boolean_toggle"/>
                            <button name="action_approve_difference" type="object"
                                    string="Aprovar" icon="fa-check"
                                    class="btn-link text-success"
                                    invisible="not has_difference or admin_approved"
                                    groups="base.group_system"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_value" widget="monetary"/>
                    </group>
                    <separator string="PRODUTOS FINAIS"/>
                    <div class="alert alert-info" role="alert">
                        <strong>Nota:</strong> Para produtos com rastreamento por lote, o nome do lote é herdado automaticamente da linha de input selecionada.
                    </div>
                    <field name="output_line_ids" readonly="state in ('done', 'cancel')">
                        <list editable="bottom">
                            <field name="input_line_id" domain="[('transformation_id', '=', parent.id)]"/>
                            <field name="input_product_form"/>
                            <field name="expected_form"/>
                            <field name="product_id" domain="[('product_form', '=', expected_form)]"/>
                            <field name="product_tracking" column_invisible="True"/>
                            <field name="thickness_readonly" column_invisible="1"/>
                            <field name="lot_name"
                                   string="Nome do Lote"
                                   placeholder="NOME DO LOTE"
                                   optional="show"
                                   invisible="product_tracking != 'lot'" force_save="1"/>
                            <field name="units_qty" optional="show"/>
                            <field name="length" optional="show"/>
                            <field name="width" optional="show"/>
                            <field name="thickness" optional="show" readonly="thickness_readonly" force_save="1"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                            <field name="volume_consumed" readonly="1" optional="hide"/>
                            <field name="price_unit" readonly="1" optional="hide" widget="monetary"/>
                            <field name="landed_cost" optional="hide" widget="monetary"/>
                            <field name="final_unit_cost" readonly="1" optional="hide" widget="monetary"/>
                            <field name="pcmp_calculated" optional="hide" widget="monetary"/>
                            <field name="total_cost" readonly="1" sum="Total Custo" widget="monetary"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Custos Adicionais" name="services">
                            <separator string="PO's de Custos Adicionais"/>
                            <field name="available_po_ids" invisible="1"/>
                            <field name="service_purchase_order_ids" readonly="state == 'done'"
                                   domain="[('id', 'in', available_po_ids)]"
                                   options="{'no_create': True, 'no_create_edit': True}">
                                <list create="false" delete="true">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="service_type_color" column_invisible="1"/>
                                    <field name="service_type_id" widget="badge"
                                           decoration-primary="service_type_color == 'primary'"
                                           decoration-info="service_type_color == 'info'"
                                           decoration-success="service_type_color == 'success'"
                                           decoration-warning="service_type_color == 'warning'"
                                           decoration-danger="service_type_color == 'danger'"
                                           decoration-muted="service_type_color == 'muted'"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" sum="Total" widget="monetary"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'purchase'"
                                           decoration-info="state in ('draft', 'sent')"
                                           decoration-warning="state == 'to approve'"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                            <group>
                                <group string="Resumo de Custos Adicionais">
                                    <field name="total_service_cost" widget="monetary"/>
                                    <field name="service_cost_distributed" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Movimentos de Stock" name="pickings">
                            <field name="picking_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="origin"/>
                                    <field name="scheduled_date"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-info="state in ('draft', 'waiting', 'confirmed', 'assigned')"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observações" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Transformation Document Kanban View -->
    <record id="view_transformation_document_kanban" model="ir.ui.view">
        <field name="name">transformation.document.kanban</field>
        <field name="model">transformation.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="date_document"/>
                <field name="transformer_id"/>
                <field name="total_value"/>
                <field name="state"/>
                <progressbar field="state" colors='{"draft": "secondary", "transit": "warning", "transforming": "info", "reception": "primary", "done": "success", "cancel": "danger"}'/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-calendar" title="Data"/> <field name="date_document"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-industry" title="Transformador"/> <field name="transformer_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="total_value" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Transformation Document Search View -->
    <record id="view_transformation_document_search" model="ir.ui.view">
        <field name="name">transformation.document.search</field>
        <field name="model">transformation.document</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Transformações">
                <field name="name"/>
                <field name="transformer_id"/>
                <field name="location_origin_id"/>
                <field name="location_dest_id"/>
                <filter string="Pendente" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Em Processo" name="in_process"
                        domain="[('state', 'in', ['transit', 'transforming', 'reception'])]"/>
                <filter string="Concluído" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelado" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Este Mês" name="this_month"
                        domain="[('date_document', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <filter string="Últimos 30 Dias" name="last_30_days"
                        domain="[('date_document', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Transformador" name="transformer" context="{'group_by': 'transformer_id'}"/>
                    <filter string="Localização Origem" name="origin" context="{'group_by': 'location_origin_id'}"/>
                    <filter string="Localização Destino" name="dest" context="{'group_by': 'location_dest_id'}"/>
                    <filter string="Data" name="date" context="{'group_by': 'date_document'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_transformation_document" model="ir.actions.act_window">
        <field name="name">Documentos de Transformação</field>
        <field name="res_model">transformation.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar novo Documento de Transformação
            </p>
            <p>
                Gerencie o processo de transformação de produtos através de fornecedores externos.
            </p>
        </field>
    </record>
</odoo>