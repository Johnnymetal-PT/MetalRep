<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Sobrescrever o report action standard do Odoo para recibos de pagamento
            para usar o template QWeb Stone.
        -->
        <record id="account.action_report_payment_receipt" model="ir.actions.report">
            <field name="report_name">mh_stone_reports.report_payment_receipt</field>
            <field name="report_file">mh_stone_reports.report_payment_receipt</field>
            <field name="paperformat_id" ref="mh_stone_reports.paperformat_stone_cotacao"/>
            <field name="print_report_name">(object.payment_type == 'inbound' and "Recibo _ " or "Nota de Pagamento _ ") + (object.receipt_number or object.name or "").replace("/", "_") + " [" + str(object.partner_id.name) + "]"</field>
        </record>

    </data>

    <!--
        Forçar actualização do mail template de recibo de pagamento (noupdate=1).
        1. Desactivar noupdate no ir.model.data
        2. Alterar subject e body para usar receipt_number
        3. Reactivar noupdate
    -->
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'account'), ('name', '=', 'mail_template_data_payment_receipt')]"/>
        </function>
        <value eval="{'noupdate': False}"/>
    </function>

    <data noupdate="0">
        <record id="account.mail_template_data_payment_receipt" model="mail.template">
            <field name="subject">{{ object.company_id.name }} Recibo de Pagamento (Ref {{ object.receipt_number or object.name or 'n/a' }})</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Exmo(a). <t t-out="object.partner_id.name or ''">Cliente</t><br/><br/>
        Obrigado pelo seu pagamento.
        Segue em anexo o seu recibo <span style="font-weight:bold;" t-out="(object.receipt_number or object.name or '').replace('/','-') or ''">REC/2026/001</span>
        no valor de <span style="font-weight:bold;" t-out="format_amount(object.amount, object.currency_id) or ''">0.00 MZN</span> da <t t-out="object.company_id.name or ''">Empresa</t>.
        <br/><br/>
        Não hesite em contactar-nos caso tenha alguma dúvida.
        <br/><br/>
        Com os melhores cumprimentos,
        <t t-if="not is_html_empty(user.signature)">
            <br/><br/>
            <t t-out="user.signature or ''">--<br/>Assinatura</t>
        </t>
    </p>
</div>
            </field>
        </record>
    </data>

    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'account'), ('name', '=', 'mail_template_data_payment_receipt')]"/>
        </function>
        <value eval="{'noupdate': True}"/>
    </function>

</odoo>
