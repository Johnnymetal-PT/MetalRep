<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_stone_stock_report_wizard_form" model="ir.ui.view">
        <field name="name">stone.stock.report.wizard.form</field>
        <field name="model">stone.stock.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Listagem de Stock de Pedras">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p><strong><i class="fa fa-list-alt"/> Listagem de Stock de Pedras</strong></p>
                        <p>Configure os filtros e clique em <b>Gerar Relatório</b>.</p>
                    </div>

                    <group string="Filtros" col="2">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_form"/>
                        </group>
                        <group>
                            <field name="product_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Todos os produtos..."/>
                            <field name="location_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Todas as localizações..."/>
                        </group>
                    </group>

                    <group string="Opções">
                        <field name="show_detail"/>
                        <field name="output_format" widget="radio"/>
                    </group>

                    <!-- Campo oculto para download do Excel -->
                    <field name="excel_file" invisible="1"/>
                    <field name="excel_filename" invisible="1"/>
                </sheet>

                <footer>
                    <button string="Gerar Relatório"
                            name="action_generate_report"
                            type="object"
                            class="btn-primary"
                            icon="fa-print"
                            data-hotkey="q"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_stone_stock_report_wizard" model="ir.actions.act_window">
        <field name="name">Listagem de Stock</field>
        <field name="res_model">stone.stock.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="mh_stock_valuation.model_stone_stock"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
