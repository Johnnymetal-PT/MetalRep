                                <!--</tr>-->
                            </t>
                        </t>
                    </tbody>
                </table>
                
                      <div class="row" style="height: 30px"/>
            
            <div class="row">
                <div class="col-12" t-if="o.amount-sum(total_recibo)&gt;=1" style="font-size: 12px">
