<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Nota de Debito (account.move)

            Template em: debit_note_reports.xml
        -->

        <record id="action_report_debit_note_stone" model="ir.actions.report">
            <field name="name">Nota de Debito</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mh_stone_reports.report_debit_note</field>
            <field name="report_file">mh_stone_reports.report_debit_note</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="mh_stone_reports.paperformat_stone_cotacao"/>
            <field name="print_report_name">"Nota de Debito _ " + (object.name or "").replace("/", "_") + " [" + str(object.partner_id.name) + "]"</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'ND').replace('/','_')+'.pdf')</field>
            <field name="attachment_use" eval="False"/>
            <field name="is_invoice_report" eval="True"/>
        </record>

    </data>
</odoo>
