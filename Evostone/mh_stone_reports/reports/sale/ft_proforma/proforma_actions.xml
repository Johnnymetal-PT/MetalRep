<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Fatura PRÓ-FORMA (sale.order)
            Extraído do backup: ID 1944

            Template em: sale_reports.xml
        -->

        <record id="action_report_proforma" model="ir.actions.report">
            <field name="name">Factura PRÓ-FORMA</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mh_stone_reports.report_sale_proforma</field>
            <field name="report_file">mh_stone_reports.report_sale_proforma</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="mh_stone_reports.paperformat_stone_cotacao"/>
            <field name="print_report_name">"Factura PRÓ-FORMA _ " + object.name + " [" + str(object.partner_id.name) + "]"</field>
            <field name="attachment_use" eval="False"/>
            <field name="multi" eval="False"/>
        </record>

    </data>
</odoo>
