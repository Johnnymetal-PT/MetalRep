<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Stickers de Placas (stock.move.line)

            Template em: stickers_reports.xml

            TODO: Refatorar para usar stock.lot em vez de x_studio_placas
        -->
        <record id="action_report_stickers" model="ir.actions.report">
            <field name="name">Stickers de Placas</field>
            <field name="model">stock.move.line</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mh_stone_reports.report_stickers</field>
            <field name="report_file">mh_stone_reports.report_stickers</field>
            <field name="binding_model_id" ref="stock.model_stock_move_line"/>
            <field name="binding_type">report</field>
            <field name="attachment_use" eval="False"/>
            <field name="multi" eval="False"/>
            <field name="paperformat_id" ref="mh_stone_reports.paperformat_stone_stickers"/>
        </record>

    </data>
</odoo>
