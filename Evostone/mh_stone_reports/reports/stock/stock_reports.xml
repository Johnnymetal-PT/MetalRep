<record id="stock_report_reception_report_label_copy_1" model="ir.ui.view">
    <field name="name">report_reception_report_label copy(1)</field>
    <field name="type">qweb</field>
    <field name="key">stock.report_reception_report_label_copy_1</field>
    <field name="arch" type="xml">
<t t-name="stock.report_reception_report_label_copy_1">
        <t t-if="quantity" t-set="qtys" t-value="[int(q) for q in quantity.split(',')]"/>
        <t t-else="" t-set="qtys" t-value="[1 for q in range(len(docs))]"/>
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="range(len(docs))" t-as="index">
                    <t t-set="move" t-value="docs[index]"/>
                    <t t-set="qty" t-value="qtys[index]"/>
                    <t t-set="source" t-value="move._get_source_document()"/>
                    <t t-foreach="range(qty)" t-as="j">
                        <div class="o_label_page o_label_dymo">
                            <div t-out="move.product_id.display_name"/>
                            <div t-if="source" t-out="source.name"/>
                            <div class="address" t-if="move.picking_id and move.picking_id.partner_id" t-field="move.picking_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </t>
    </field>
</record>

