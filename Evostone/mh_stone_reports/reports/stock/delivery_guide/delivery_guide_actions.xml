<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Guia de Movimentação (stock.picking)

            Template em: delivery_guide_reports.xml

            Títulos dinâmicos:
            - Stock Inicial: "Guia de Stock Inicial"
            - Vendas (outgoing): "Guia de Entrega"
            - Compras (incoming): "Guia de Recebimento"
            - Transferências (internal): "Guia de Transferência"
        -->
        <record id="action_report_delivery_guide" model="ir.actions.report">
            <field name="name">Guia de Movimentação</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mh_stone_reports.report_delivery_guide</field>
            <field name="report_file">mh_stone_reports.report_delivery_guide</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="mh_stone_reports.paperformat_stone_cotacao"/>
            <field name="print_report_name">('Guia de Stock Inicial' if object.is_initial_stock else 'Guia de Entrega' if object.picking_type_id.code == 'outgoing' else 'Guia de Recebimento' if object.picking_type_id.code == 'incoming' else 'Guia de Transferência') + " _ " + object.name + " [" + str(object.partner_id.name or '') + "]"</field>
            <field name="attachment_use" eval="False"/>
        </record>

    </data>
</odoo>
