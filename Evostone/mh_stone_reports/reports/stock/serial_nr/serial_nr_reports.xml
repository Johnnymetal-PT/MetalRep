<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Main wrapper for Serial Nr. report -->
        <record id="view_report_serial_nr" model="ir.ui.view">
            <field name="name">Serial Nr. Report - Main Wrapper</field>
            <field name="type">qweb</field>
            <field name="key">mh_stone_reports.report_serial_nr</field>
            <field name="arch" type="xml">
                <t t-name="mh_stone_reports.report_serial_nr">
                    <t t-foreach="docs" t-as="doc">
                        <t t-call="web.basic_layout">
                            <t t-call="mh_stone_reports.report_serial_nr_document"/>
                            <p style="page-break-after: always;"/>

                            <style>
                                .container {
                                    text-align: center;
                                }
                            </style>

                            <!-- Itera sobre move_line_ids usando stock.lot -->
                            <t t-foreach="doc.move_line_ids" t-as="x">
                                <t t-if="x and x.lot_id and x.lot_id.price_group_id">
                                    <div>
                                        <br/><br/><br/><br/><br/><br/>
                                        <!-- Label dinâmico baseado em product_form -->
                                        <span style="color:#808080">
                                            <t t-if="x.lot_id.product_id.product_form == 'block'">Bloco:</t>
                                            <t t-elif="x.lot_id.product_id.product_form == 'slab'">Placa:</t>
                                            <t t-elif="x.lot_id.product_id.product_form == 'strip'">Banda:</t>
                                            <t t-elif="x.lot_id.product_id.product_form == 'tiles'">Ladrilho:</t>
                                            <t t-else="">Produto:</t>
                                        </span>
                                        <t t-esc="x.lot_id.price_group_id.description"/>
                                        <br/>
                                    </div>
                                    <div>
                                        <span t-field="x.lot_id.name"/>
                                    </div>
                                    <br/><br/><br/><br/>
                                </t>
                            </t>
                        </t>
                    </t>
                </t>
            </field>
        </record>

        <!-- Document template for Serial Nr. report -->
        <record id="view_report_serial_nr_document" model="ir.ui.view">
            <field name="name">Serial Nr. Report - Document Template</field>
            <field name="type">qweb</field>
            <field name="key">mh_stone_reports.report_serial_nr_document</field>
            <field name="arch" type="xml">
                <t t-name="mh_stone_reports.report_serial_nr_document">
                    <div class="page">
                        <!-- Cabeçalho vazio - conteúdo está no wrapper -->
                    </div>
                </t>
            </field>
        </record>

    </data>
</odoo>
