<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Guia de Recepção de Pedras (stock.picking)
            - Só aparece em pickings validados (state=done)
            - Só aparece em pickings que vêm de PO (purchase_id != False)

            Template em: picking_reports.xml
            Botão em: picking_views.xml
        -->

        <!-- Relatório PDF (chamado via botão - sem binding para não aparecer no menu) -->
        <record id="action_report_stone_picking" model="ir.actions.report">
            <field name="name">Listagem de Pedras</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mh_stone_reports.report_stone_picking</field>
            <field name="report_file">mh_stone_reports.report_stone_picking</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="mh_stone_reports.paperformat_stone_cotacao"/>
            <field name="print_report_name">"Listagem_Pedras_" + object.name.replace('/', '_')</field>
            <field name="attachment_use" eval="False"/>
        </record>

    </data>
</odoo>
