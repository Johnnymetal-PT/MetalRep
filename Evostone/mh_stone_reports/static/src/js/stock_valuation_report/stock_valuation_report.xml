<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mh_stone_reports.StockValuationReport">
        <div class="o_action o_stock_valuation_report">
            <style>
                .o_stock_valuation_report .o_group_block.collapsed .o_group_row,
                .o_stock_valuation_report .o_group_block.collapsed .o_group_pagination { display: none; }
                .o_stock_valuation_report .o_group_header:hover { background-color: rgba(0,0,0,0.04); }
                .o_stock_valuation_report .o_group_chevron { width: 1em; display: inline-block; text-align: center; }
                .o_stock_valuation_report .pagination-sm .page-link { padding: 0.15rem 0.5rem; }
                .o_stock_valuation_report .o_page_prev .page-link,
                .o_stock_valuation_report .o_page_next .page-link { cursor: pointer; }
                .o_stock_valuation_report .o_page_prev.disabled .page-link,
                .o_stock_valuation_report .o_page_next.disabled .page-link { cursor: not-allowed; opacity: 0.5; }
                .o_stock_valuation_report .o_valuation_date_picker .o_datetime_input { min-width: 130px; }
                .o_stock_valuation_report .o_valuation_date_picker input { padding: 0.25rem 0.5rem; border: 1px solid #ced4da; border-radius: 0.25rem; }
                /* Override do verde Enterprise no table-secondary — tom muito subtil */
                .o_stock_valuation_report tr.table-secondary {
                    --bs-table-bg: #fafbfc;
                    --bs-table-bg-state: transparent;
                    --bs-table-accent-bg: transparent;
                }
                .o_stock_valuation_report tr.table-secondary > td {
                    background-color: #fafbfc !important;
                }
                .o_stock_valuation_report a.o_action {
                    color: inherit !important;
                    text-decoration: none !important;
                }
                .o_stock_valuation_report a.o_action:hover {
                    text-decoration: underline !important;
                }
            </style>
            <Layout display="{ controlPanel: {} }">
                <t t-set-slot="control-panel-always-buttons">
                    <button t-on-click="onClickPrint" type="button" class="btn btn-primary" title="Print">Print</button>
                    <select id="stock_valuation_format" class="form-select border-1 w-auto">
                        <option value="pdf">pdf</option>
                        <option value="csv">csv</option>
                        <option value="xlsx">xlsx</option>
                    </select>
                </t>
                <t t-set-slot="layout-actions">
                    <form class="d-flex flex-row gap-1">
                        <div class="d-flex align-items-center gap-3 w-100">
                            <div class="d-flex align-items-center gap-2 o_valuation_date_picker">
                                <label class="fw-bold mb-0 text-nowrap">Valorização à Data:</label>
                                <DateTimeInput value="state.date"
                                               onChange.bind="onChangeDate"
                                               type="'date'"/>
                            </div>
                            <div class="input-group w-auto" style="min-width:380px;">
                                <div class="input-group-text fw-bold">Artigo</div>
                                <input type="text"
                                       class="form-control border-0"
                                       list="stock_valuation_products"
                                       placeholder="Todos"
                                       t-on-change="onSelectProduct"
                                       t-on-input="onTypeProduct"/>
                                <datalist id="stock_valuation_products">
                                    <t t-foreach="state.products" t-as="p" t-key="p.id">
                                        <option t-att-value="p.name" t-att-data-id="p.id"/>
                                    </t>
                                </datalist>
                            </div>
                            <div class="input-group w-auto">
                                <div class="input-group-text fw-bold">Classificação do Artigo</div>
                                <select class="form-select border-0" t-on-change="onSelectClassification">
                                    <option value="">— Todas —</option>
                                    <t t-foreach="state.classifications" t-as="c" t-key="c.value">
                                        <option t-att-value="c.value"
                                                t-att-selected="state.selectedClassification === c.value"
                                                t-out="c.label"/>
                                    </t>
                                </select>
                            </div>
                            <div class="input-group w-auto">
                                <div class="input-group-text fw-bold">Lançamento Contabilístico</div>
                                <select class="form-select border-0" t-on-change="onSelectAccountingFilter">
                                    <option value="all" t-att-selected="state.accountingFilter === 'all'">Todos</option>
                                    <option value="with" t-att-selected="state.accountingFilter === 'with'">Com lançamento</option>
                                    <option value="without" t-att-selected="state.accountingFilter === 'without'">Sem lançamento</option>
                                </select>
                            </div>
                            <span class="text-muted small ms-auto" t-if="state.totalSvls">
                                <t t-esc="state.totalGroups"/> produtos, <t t-esc="state.totalSvls"/> SVLs
                            </span>
                        </div>
                    </form>
                </t>
                <div t-on-click="onClickReport" t-ref="reportContainer">
                    <t t-out="state.html"/>
                </div>
            </Layout>
        </div>
    </t>
</templates>
