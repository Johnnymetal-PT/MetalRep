<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Adiciona campo watermark à ficha da empresa -->
        <record id="view_company_form_report_watermark" model="ir.ui.view">
            <field name="name">res.company.form.report.watermark</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Relatórios" name="page_reports">
                        <group>
                            <group string="Logos">
                                <field name="logo_report" widget="image" class="oe_avatar"/>
                                <field name="sticker_logo" widget="image" class="oe_avatar"/>
                            </group>
                            <group string="Outros">
                                <field name="report_watermark" widget="image" class="oe_avatar"/>
                            </group>
                        </group>
                        <separator string="Bancos para Relatórios"/>
                        <field name="mh_bank_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="nib"/>
                                <field name="account_number"/>
                                <field name="iban" optional="hide"/>
                                <field name="swift" optional="hide"/>
                                <field name="active" widget="boolean_toggle" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
