<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_category_return_account_form" model="ir.ui.view">
        <field name="name">product.category.form.return.account</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="property_stock_account_output_categ_id" position="after">
                <field name="property_stock_account_return_categ_id"
                       required="property_valuation == 'real_time'"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
