<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_cogs_price_diff" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cogs.price.diff</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="26"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[last()]" position="after">
                <block title="Ajuste CMV Diferença de Preço" name="cogs_price_diff_setting_container">
                    <setting id="cogs_price_diff_journal" string="Diário do Ajuste" help="Diário usado para encaminhar a diferença de preço da parte vendida das facturas de fornecedor para o CMV. Se vazio, usa o primeiro diário 'Diversos'.">
                        <div class="content-group">
                            <div class="mt16">
                                <div class="d-flex align-items-center">
                                    <label for="cogs_price_diff_journal_id" string="Diário do Ajuste"
                                           class="fw-bold" style="min-width: 150px;"/>
                                    <field name="cogs_price_diff_journal_id" style="width: 300px;"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
