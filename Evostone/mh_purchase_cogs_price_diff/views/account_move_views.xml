<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_cogs_price_diff" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cogs.price.diff</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Ajuste CMV Diferença de Preço"
                       invisible="not cogs_price_diff_move_id">
                    <field name="cogs_price_diff_move_id" readonly="1"
                           options="{'no_open': False}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
