<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dynamic_favicon_assets" inherit_id="web.layout" name="Dynamic Favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/x-icon" rel="shortcut icon" href="/web/favicon.ico"/>
        </xpath>
    </template>
</odoo>