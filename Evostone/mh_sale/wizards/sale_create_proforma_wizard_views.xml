<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_sale_create_proforma_wizard_form" model="ir.ui.view">
        <field name="name">sale.create.proforma.wizard.form</field>
        <field name="model">sale.create.proforma.wizard</field>
        <field name="arch" type="xml">
            <form string="Criar Recibo Pró-forma">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p><strong><i class="fa fa-credit-card"/> Criar Recibo Pró-forma</strong></p>
                        <p>Este assistente irá criar um <strong>Recibo Pró-forma</strong> para registar o pagamento do cliente.</p>
                        <p>O recibo será criado e confirmado automaticamente.</p>
                    </div>

                    <group string="Dados da Encomenda" col="4">
                        <field name="sale_order_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="order_amount_total" readonly="1" widget="monetary"/>
                        <field name="currency_id" readonly="1" invisible="1"/>
                    </group>

                    <group col="4">
                        <field name="order_amount_covered" readonly="1" widget="monetary"/>
                        <field name="order_amount_pending" readonly="1" widget="monetary"
                               decoration-danger="order_amount_pending > 0"
                               decoration-success="order_amount_pending == 0"/>
                    </group>

                    <separator string="Configuração do Pagamento"/>

                    <group col="2">
                        <group string="Valor e Data">
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="date"/>
                        </group>
                        <group string="Diário Contábil">
                            <field name="journal_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Selecione banco ou caixa..."/>
                            <field name="payment_method_line_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   placeholder="Selecione método..."/>
                        </group>
                    </group>

                    <group string="Memorando">
                        <field name="memo"
                               nolabel="1"
                               placeholder="Descrição do pagamento (opcional)..."/>
                    </group>
                </sheet>

                <footer>
                    <button string="Criar Recibo"
                            name="action_create_proforma"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"
                            data-hotkey="q"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sale_create_proforma_wizard" model="ir.actions.act_window">
        <field name="name">Criar Recibo Pró-forma</field>
        <field name="res_model">sale.create.proforma.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
