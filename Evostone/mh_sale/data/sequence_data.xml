<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequência única para Recibos Pró-forma -->
        <record id="sequence_proforma_payment" model="ir.sequence">
            <field name="name">Recibo Pró-forma</field>
            <field name="code">proforma.payment</field>
            <field name="prefix">PROF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>