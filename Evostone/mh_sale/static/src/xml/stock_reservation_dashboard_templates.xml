<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Template Principal do Dashboard -->
    <t t-name="mh_sale.StockReservationDashboard">
        <div class="o_stock_reservation_dashboard h-100 overflow-auto bg-light">

            <!-- Header com Filtros -->
            <div class="p-3 bg-white border-bottom shadow-sm">
                <div class="container-fluid">
                    <div class="row align-items-center mb-3">
                        <div class="col-12">
                            <h2 class="mb-0 fw-bold">
                                <i class="fa fa-cube me-2 text-primary"/>
                                Análise de Artigos Reservados
                            </h2>
                        </div>
                    </div>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-1">Data Inicial</label>
                            <input type="date"
                                   class="form-control"
                                   t-model="state.date_from"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-1">Data Final</label>
                            <input type="date"
                                   class="form-control"
                                   t-model="state.date_to"/>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-muted mb-1">Forma do Produto</label>
                            <select class="form-select"
                                    t-model="state.product_form">
                                <option value="">Todas</option>
                                <option value="block">Bloco</option>
                                <option value="slab">Placa</option>
                                <option value="strip">Banda</option>
                                <option value="tiles">Ladrilhos</option>
                                <option value="none">Sem Forma</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-1">Localização</label>
                            <select class="form-select"
                                    t-model="state.location_id">
                                <option value="">Todas as Localizações</option>
                                <t t-foreach="state.locations" t-as="location" t-key="location.id">
                                    <option t-att-value="location.id" t-esc="location.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button type="button"
                                    class="btn btn-primary w-100"
                                    t-on-click="onApplyFilters">
                                <i class="fa fa-filter me-2"/>
                                Filtrar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="text-center p-5">
                <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                <p class="mt-3 text-muted">Carregando dados...</p>
            </div>

            <!-- Tabela de Reservas -->
            <div t-else="!state.loading" class="container-fluid p-4">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Data/Hora</th>
                                        <th>Produto</th>
                                        <th>Cliente</th>
                                        <th>Encomenda</th>
                                        <th>LOTE/SN</th>
                                        <th class="text-end">Quantidade</th>
                                        <th class="text-end">Comprimento</th>
                                        <th class="text-end">Largura</th>
                                        <th class="text-end">Espessura</th>
                                        <th class="text-end">Volume/Área/Unidade</th>
                                        <th>Localização</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="state.reservations.length === 0">
                                        <tr>
                                            <td colspan="12" class="text-center text-muted p-5">
                                                <i class="fa fa-inbox fa-3x mb-3 d-block"/>
                                                Nenhum artigo reservado encontrado para os filtros selecionados
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr t-foreach="state.reservations" t-as="res" t-key="res.id"
                                            class="cursor-pointer"
                                            t-on-click="() => this.onRowClick(res.sale_order_id)"
                                            style="transition: background-color 0.2s;">
                                            <td><small t-esc="res.date"></small></td>
                                            <td><small><t t-esc="res.product_name"/></small></td>
                                            <td><small t-esc="res.partner_name"></small></td>
                                            <td><small t-esc="res.sale_order_name"></small></td>
                                            <td><small t-esc="res.lot_name"></small></td>
                                            <td class="text-end"><small t-esc="res.units_qty"></small></td>
                                            <td class="text-end"><small t-esc="res.length ? res.length.toFixed(2) : '-'"></small></td>
                                            <td class="text-end"><small t-esc="res.width ? res.width.toFixed(2) : '-'"></small></td>
                                            <td class="text-end"><small t-esc="res.thickness ? res.thickness.toFixed(2) : '-'"></small></td>
                                            <td class="text-end"><small class="text-success fw-bold" t-esc="res.reserved_availability.toFixed(2)"></small> <small class="text-muted" t-esc="res.product_uom"></small></td>
                                            <td><small t-esc="res.location_name"></small></td>
                                            <td>
                                                <span t-if="res.reservation_status === 'Totalmente Reservado'" class="badge bg-success text-white">
                                                    <t t-esc="res.reservation_status"/>
                                                </span>
                                                <span t-elif="res.reservation_status === 'Parcialmente Reservado'" class="badge bg-warning text-white">
                                                    <t t-esc="res.reservation_status"/>
                                                </span>
                                                <span t-else="" class="badge bg-secondary text-white">
                                                    <t t-esc="res.reservation_status"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
