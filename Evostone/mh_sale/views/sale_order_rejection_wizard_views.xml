<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View for Rejection Wizard -->
    <record id="view_sale_order_rejection_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.rejection.wizard.form</field>
        <field name="model">sale.order.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejeitar Cotação">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Atenção!</strong> Você está prestes a rejeitar esta cotação.
                        Por favor, forneça um motivo detalhado para a rejeição.
                    </div>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="rejection_reason"
                               placeholder="Informe o motivo da rejeição..."
                               widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirmar Rejeição"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>