<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Campo acerto_de_stock na ficha do produto -->
        <record id="view_product_template_form_stock_adjustment" model="ir.ui.view">
            <field name="name">product.template.form.stock.adjustment</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="acerto_de_stock"
                           invisible="type != 'service'"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
