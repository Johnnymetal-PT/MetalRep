<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Botão Stone Variantes no product.template (antes do botão Variantes) -->
    <record id="product_template_form_view_inherit_stone_variants" model="ir.ui.view">
        <field name="name">product.template.form.inherit.stone.variants</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(product.product_variant_action)d']" position="before">
                <button name="action_view_stone_variants" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="product_variant_count == 0">
                    <field name="product_variant_count" widget="statinfo" string="Stone Variantes"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
