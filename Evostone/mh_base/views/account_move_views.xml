<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Esconder botões Cancel e Reset to Draft para grupo de bloqueio -->
    <record id="view_move_form_block_cancel" model="ir.ui.view">
        <field name="name">account.move.form.block.cancel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="can_cancel" invisible="1"/>
            </field>
            <xpath expr="//button[@name='button_cancel'][1]" position="attributes">
                <attribute name="invisible">not id or state != 'draft' or move_type != 'entry' or not can_cancel</attribute>
            </xpath>
            <xpath expr="//button[@name='button_cancel'][2]" position="attributes">
                <attribute name="invisible">not id or state != 'draft' or move_type == 'entry' or not can_cancel</attribute>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button or not can_cancel</attribute>
            </xpath>
        </field>
    </record>
</odoo>
