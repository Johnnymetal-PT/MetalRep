<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Type Form View -->
    <record id="view_service_type_form" model="ir.ui.view">
        <field name="name">service.type.form</field>
        <field name="model">service.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Serviço">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Arquivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Nome"/>
                        <h1>
                            <field name="name" placeholder="Nome do tipo de serviço"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="area_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="color" widget="radio"/>
                            <field name="sequence" invisible="1"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Type Tree View -->
    <record id="view_service_type_list" model="ir.ui.view">
        <field name="name">service.type.list</field>
        <field name="model">service.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Serviço">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="area_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Service Type Search View -->
    <record id="view_service_type_search" model="ir.ui.view">
        <field name="name">service.type.search</field>
        <field name="model">service.type</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Tipos de Serviço">
                <field name="name"/>
                <field name="area_ids"/>
                <filter string="Arquivados" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Activo" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Service Type Action -->
    <record id="action_service_type" model="ir.actions.act_window">
        <field name="name">Tipos de Serviço</field>
        <field name="res_model">service.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar um novo tipo de serviço
            </p>
            <p>
                Os tipos de serviço permitem classificar as ordens de compra por áreas de actuação.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_service_type"
              name="Tipos de Serviço"
              parent="purchase.menu_purchase_config"
              action="action_service_type"
              sequence="10"/>
</odoo>
