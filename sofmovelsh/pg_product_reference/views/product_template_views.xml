<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_pg_reference" model="ir.ui.view">
        <field name="name">product.template.form.pg.reference</field>
        <field name="model">product.template</field>
        <!-- A vista comum (product_template_form_view) nao tem `default_code`:
             quem o acrescenta e a vista so-de-template, a seguir a `categ_id`,
             e com `invisible="product_variant_count > 1"`. O `pg_template_code`
             fica deliberadamente visivel tambem em multi-variante, que e
             precisamente o caso em que o standard nao tem onde mostrar a
             referencia do artigo. -->
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="pg_template_code" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="action_pg_generate_references" model="ir.actions.server">
        <field name="name">PG Gerar Referência e Código de Barras</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_pg_generate_references()</field>
    </record>

</odoo>
