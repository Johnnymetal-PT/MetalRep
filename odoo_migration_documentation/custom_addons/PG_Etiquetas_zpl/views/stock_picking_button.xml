<odoo>
    <record id="view_picking_form_inherit_print_button" model="ir.ui.view">
        <field name="name">stock.picking.form.print.zpl.label</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_zpl_tecido"
                        type="object"
                        string="Imprimir Tecidos"
                        class="oe_highlight"/>
                <button name="action_print_zpl_entrega"
                        type="object"
                        string="Imprimir Entregas"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>

