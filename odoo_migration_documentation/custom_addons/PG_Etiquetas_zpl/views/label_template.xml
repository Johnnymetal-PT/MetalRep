    <template id="private_label_zpl_entregas_template" name="Private Label ZPL Entregas">
        <t t-foreach="docs" t-as="doc">
            <t t-set="move" t-value="(doc.move_ids_without_package and doc.move_ids_without_package[0]) or (doc.move_ids and doc.move_ids[0]) or False"/>
            <t t-set="move_line" t-value="(doc.move_line_ids and doc.move_line_ids[0]) or False"/>
            <t t-set="unit_number" t-value="1"/>
            <t t-set="desc" t-value="(move.product_id.display_name or '---').split(']')[-1].strip().encode('ascii', 'ignore').decode()"/>
            <t t-set="words" t-value="desc.split()"/>
            <t t-set="lines" t-value="[]"/>
            <t t-set="current_line" t-value="''"/>

            <t t-foreach="words" t-as="word">
                <t t-set="tentative_line" t-value="(current_line + ' ' + word).strip()"/>
                <t t-set="fits" t-value="len(tentative_line) &lt; 50"/>
                <t t-if="fits">
                    <t t-set="current_line" t-value="tentative_line"/>
                </t>
                <t t-else="">
                    <t t-set="lines" t-value="lines + [current_line]"/>
                    <t t-set="current_line" t-value="word"/>
                </t>
            </t>

