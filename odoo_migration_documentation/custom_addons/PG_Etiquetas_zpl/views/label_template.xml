            </t>

            <t t-set="line1" t-value="lines[0] if len(lines) &gt; 0 else ''"/>
            <t t-set="line2" t-value="lines[1] if len(lines) &gt; 1 else ''"/>
            <t t-set="line3" t-value="lines[2] if len(lines) &gt; 2 else ''"/>
            <t t-set="line4" t-value="lines[3] if len(lines) &gt; 3 else ''"/>

