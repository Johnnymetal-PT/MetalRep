    <template id="private_label_zpl_tecidos_template" name="Private Label ZPL Tecidos">
        <t t-foreach="docs" t-as="doc">
            <t t-set="move" t-value="(doc.move_ids_without_package and doc.move_ids_without_package[0]) or (doc.move_ids and doc.move_ids[0]) or False"/>
            <t t-set="production_candidates" t-value="('production_ids' in doc._fields and doc.production_ids) or ('group_id' in doc._fields and doc.group_id and 'mrp_production_ids' in doc.group_id._fields and doc.group_id.mrp_production_ids) or (move and 'move_dest_ids' in move._fields and 'raw_material_production_id' in move.move_dest_ids._fields and move.move_dest_ids.mapped('raw_material_production_id')) or []"/>
            <t t-set="production" t-value="production_candidates and production_candidates[0] or False"/>
            <t t-set="supplier_name" t-value="(('x_studio_supplier' in doc._fields and doc.x_studio_supplier and doc.x_studio_supplier.name) or (doc.partner_id and doc.partner_id.name) or '---')"/>
            <t t-set="ecf_number" t-value="('x_studio_ecf_number_2' in doc._fields and doc.x_studio_ecf_number_2) or '---'"/>
            <t t-set="ecf_date" t-value="('x_studio_ecf_date' in doc._fields and doc.x_studio_ecf_date and doc.x_studio_ecf_date.strftime('%d/%m/%Y')) or '---'"/>
            <t t-set="fp_number" t-value="(('sale_id' in doc._fields and doc.sale_id and doc.sale_id.name) or doc.origin or '---')"/>
            <t t-set="client_relations" t-value="('x_studio_client_relations' in doc._fields and doc.x_studio_client_relations and doc.x_studio_client_relations.name) or '---'"/>
            <t t-set="product_name_source" t-value="(production and (production.product_id.display_name or production.product_id.name)) or (move and (move.product_id.display_name or move.product_id.name)) or ''"/>
            <t t-set="product_name_clean" t-value="doc._zpl_clean_text(product_name_source)"/>
            <t t-set="product_name" t-value="product_name_clean and product_name_clean.split(']')[-1].strip() or '---'"/>
            <t t-set="qty_text" t-value="(production and ('%g' % production.product_qty)) or (move and ('%g' % (move.product_uom_qty or 0))) or '0'"/>
            <t t-set="fabric_source" t-value="(production and 'product_description_variants' in production._fields and (production.product_description_variants or '')) or (move and 'sale_line_id' in move._fields and move.sale_line_id and move.sale_line_id.name) or ''"/>
            <t t-set="fabric_segments" t-value="[segment.strip() for segment in fabric_source.replace('\r', '\n').replace(', ', '\n').split('\n') if segment.strip()]"/>
            <t t-set="fabric_lines" t-value="[segment for segment in fabric_segments if 'FABRIC' in segment.upper() or 'TECIDO' in segment.upper()]"/>
            <t t-set="fabric_line" t-value="fabric_lines and fabric_lines[0] or (fabric_segments and fabric_segments[0] or '')"/>
            <t t-set="remaining_description_lines" t-value="[segment for segment in fabric_segments if segment != fabric_line]"/>
            <t t-set="extra_description_line" t-value="remaining_description_lines and remaining_description_lines[0] or ''"/>
            <t t-set="move_note" t-value="((move and 'x_studio_notas' in move._fields and move.x_studio_notas) or '').replace('\r', ' ').replace('\n', ' ').strip()"/>
            <t t-set="line1" t-value="('%s x %s' % (qty_text, product_name)).strip() if product_name != '---' else '---'"/>
            <t t-set="line2" t-value="fabric_line or '---'"/>
            <t t-set="line3" t-value="move_note or extra_description_line or '---'"/>
            <t t-set="description_lines" t-value="doc._zpl_wrap_text([line1, line2, line3], 62, 4)"/>
            <t t-set="fabric_arrival_date" t-value="(('date_done' in doc._fields and doc.date_done and doc.date_done.strftime('%d/%m/%Y')) or ('scheduled_date' in doc._fields and doc.scheduled_date and doc.scheduled_date.strftime('%d/%m/%Y')) or '---')"/>
            <t t-set="comments" t-value="((('x_studio_nota_1' in doc._fields and doc.x_studio_nota_1) or '').replace('\r', ' ').replace('\n', ' ').strip()) or '---'"/>
            <t t-set="com_fabric_mark" t-value="('x_studio_com_fabric' in doc._fields and doc.x_studio_com_fabric) and 'X' or ''"/>
