<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_bom_form_view_inherit_pg_fabric_consumption" model="ir.ui.view">
            <field name="name">mrp.bom.form.inherit.pg.fabric.consumption</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bom_line_ids']" position="attributes">
                    <attribute name="domain">[('bom_id.origin_bom_id', '!=', False)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

