<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Exposicao de menus aos grupos read-only e re-gate do CRM.
      Os xmlids e 'groups' abaixo foram confirmados em vendor/odoo_src 17.0.
      Ao escrever o campo 'groups' de um menu substituimos o conjunto, por isso
      mantemos SEMPRE os grupos standard originais e ACRESCENTAMOS o grupo pg_*.
    -->

    <!-- ============ MANUFATURA (so leitura) ============ -->
    <!-- mrp.menu_mrp_root original: group_mrp_user,group_mrp_manager -->
    <record id="mrp.menu_mrp_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('mrp.group_mrp_user'),
            ref('mrp.group_mrp_manager'),
            ref('pg_group_mrp_readonly'),
        ])]"/>
    </record>
    <!-- Ordens de Trabalho (original: group_mrp_routings) -->
    <record id="mrp.menu_mrp_workorder_todo" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('mrp.group_mrp_routings'),
            ref('pg_group_mrp_readonly'),
        ])]"/>
    </record>

    <!-- ============ REPARACOES (so leitura) ============ -->
    <!-- repair.menu_repair_order original: stock.group_stock_user -->
    <record id="repair.menu_repair_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('stock.group_stock_user'),
            ref('pg_group_repair_readonly'),
        ])]"/>
    </record>
    <record id="repair.repair_order_menu" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('stock.group_stock_user'),
            ref('pg_group_repair_readonly'),
        ])]"/>
    </record>

    <!-- ============ QUALIDADE (so leitura) ============ -->
    <!-- quality_control.menu_quality_root original: quality.group_quality_user -->
    <record id="quality_control.menu_quality_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('quality.group_quality_user'),
            ref('pg_group_quality_readonly'),
        ])]"/>
    </record>

    <!-- ============ INVENTARIO (so visualizacao) ============ -->
    <!-- stock.menu_stock_root original: stock.group_stock_user -->
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('stock.group_stock_user'),
            ref('pg_group_inventory_stock_readonly'),
        ])]"/>
    </record>
    <!--
      Submenu "Products" (stock.menu_stock_inventory_control) NAO tem grupo
      proprio (confirmado em stock/views/stock_menu_views.xml:44), pelo que fica
      visivel assim que o root esta exposto ao grupo read-only. A lista de
      Produtos mostra o stock on-hand por artigo -> cobre "ver artigos em stock".
      O "Reporting" (menu_warehouse_report) e manager-only e fica oculto de
      proposito. NOTA: confirmar em staging os groups_id das ACTIONS de produto
      (algumas act_window podem ter groups_id que limitem a abertura), e o menu
      real do Inventario caso o Studio o tenha alterado.
    -->

    <!-- ============ CONTACTOS (garantir visibilidade do menu) ============ -->
    <!-- contacts.menu_contacts original: base.group_user,base.group_partner_manager -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('base.group_user'),
            ref('base.group_partner_manager'),
            ref('pg_group_contacts_no_delete'),
        ])]"/>
    </record>

    <!-- ============ PROJETO (garantir visibilidade do menu) ============ -->
    <!-- project.menu_main_pm original: group_project_manager,group_project_user -->
    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('project.group_project_manager'),
            ref('project.group_project_user'),
            ref('pg_group_project_no_delete'),
        ])]"/>
    </record>

    <!-- ============ CRM (re-gate para ocultar mantendo Vendas) ============ -->
    <!-- crm.crm_menu_root original: sales_team.group_sale_salesman,sales_team.group_sale_manager -->
    <record id="crm.crm_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('pg_group_crm_visible'),
        ])]"/>
    </record>

    <!-- ============ DESPESAS (re-gate para ocultar) ============ -->
    <!-- hr_expense.menu_hr_expense_root original: SEM grupo (visivel a todos) -->
    <record id="hr_expense.menu_hr_expense_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [
            ref('pg_group_expenses_visible'),
        ])]"/>
    </record>

</odoo>
