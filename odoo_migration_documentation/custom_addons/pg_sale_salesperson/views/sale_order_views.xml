<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_salesperson_partner" model="ir.ui.view">
        <field name="name">sale.order.form.salesperson.partner</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="salesperson_partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
