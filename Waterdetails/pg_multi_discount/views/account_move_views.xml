<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pg_account_invoice_form_view" model="ir.ui.view">
        <field name="name">pg.account.invoice.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="sh_discount_price_unit" groups="pg_multi_discount.group_account_multi_discount_security" optional="show"/>
                <field name="sh_multi_discount" groups="pg_multi_discount.group_account_multi_discount_security" optional="show"/>
                <field name="sh_discount_amount" groups="pg_multi_discount.group_account_multi_discount_security" optional="show"/>
                <field name="sh_discounted_total_amount" groups="pg_multi_discount.group_account_multi_discount_security" optional="show"/>
                <field name="dis_bool" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="sh_show_multi_disc" groups="pg_multi_discount.group_account_multi_discount_security"/>
            </xpath>
        </field>
    </record>
</odoo>
