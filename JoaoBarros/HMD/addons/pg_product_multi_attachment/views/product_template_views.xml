<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <!-- Inherit the product_template form view to add field -->
        <field name='name'>
            product.template.view.form.inherit.product.multi.attachment
        </field>
        <field name='model'>product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Define the position to insert the new elements in the view -->
            <field name="barcode" position="after">
                <field name="attachment_ids" context="{'default_res_model': 'product.template'}">
                    <tree editable="bottom">
                        <field name="name"/>
                        <field name="type"/>
                        <field name="datas" widget="binary" filename="name"/>
                        <field name="url" attrs="{'readonly': [('type', '!=', 'url')]}"/>
                        <field name="mimetype" optional="hide"/>
                        <field name="description" optional="hide"/>
                    </tree>
                </field>
            </field>
        </field>
    </record>
</odoo>
