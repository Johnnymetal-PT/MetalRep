<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_partner_statement_wizard_form" model="ir.ui.view">
        <field name="name">pg.partner.statement.wizard.form</field>
        <field name="model">pg.partner.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Extrato Simplificado de Clientes">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Deixe vazio para incluir todos os clientes ativos…"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_view_lines" string="Ver no Ecrã"
                            type="object" class="btn-primary"/>
                    <button name="action_print_pdf" string="Imprimir PDF"
                            type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pg_partner_statement_wizard" model="ir.actions.act_window">
        <field name="name">Extrato Simplificado de Clientes</field>
        <field name="res_model">pg.partner.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
