<t name="Submenu" t-name="website.submenu">
    <t t-set="show_dropdown" t-value="(submenu.is_mega_menu and submenu.is_visible) or submenu.child_id.filtered(lambda menu: menu.is_visible)"/>
    <li t-if="submenu.is_visible and not (submenu.child_id or submenu.is_mega_menu)" t-attf-class="#{item_class or ''}" role="presentation">
        <a t-att-href="submenu._clean_url()" t-attf-class="#{link_class or ''} #{submenu._is_active() and 'active'}" role="menuitem" t-ignore="true" t-att-target="'_blank' if submenu.new_window else None">
            <span t-field="submenu.name"/>
        </a>
    </li>

    <li t-elif="show_dropdown and not is_mobile" t-attf-class="#{item_class or ''} dropdown #{submenu.is_mega_menu and 'position-static'}" role="presentation">
        <a t-attf-class="#{link_class or ''} dropdown-toggle #{submenu.is_mega_menu and 'o_mega_menu_toggle'} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}" data-bs-toggle="dropdown" href="#" t-att-data-bs-display="'static' if submenu.is_mega_menu else None" role="menuitem">
            <span t-field="submenu.name"/>
        </a>

        <div t-if="submenu.is_mega_menu" class="dropdown-menu o_mega_menu custom-mega-menu w-100 p-0" style="border-top: 1px solid #766F63;" role="menu">
            <div class="container-fluid px-0 py-4">
            <div class="row submenu" style="--gutter-x: 0px;">
                <t t-set="categories" t-value="request.env['product.public.category'].sudo().search([])"/>
<!-- Section parents you want to display -->
<t t-set="parent_labels" t-value="['LIVING ROOM', 'DINING ROOM', 'BEDROOM']"/>

<!-- Model helper + dynamic publish filter (v17 uses is_published) -->
<t t-set="Category" t-value="request.env['product.public.category'].sudo()"/>
<t t-set="has_is_published" t-value="'is_published' in Category._fields"/>
<t t-set="pub_domain" t-value="has_is_published and [('is_published','=',True)] or []"/>

<t t-foreach="parent_labels" t-as="label">
    <!-- Find top-level parent by name (case-insensitive), limit 1 -->
    <t t-set="parent" t-value="Category.search([('parent_id','=',False), ('name','ilike', label)] + pub_domain, limit=1)"/>

    <t t-if="parent">
        <!-- Fetch its children -->
        <t t-set="children" t-value="Category.search([('parent_id','=',parent.id)] + pub_domain, order='sequence, name')"/>

        <div class="col-2">
            <h5 class="section-title mb-3"><t t-esc="label"/></h5>
            <ul class="list-unstyled">
                <t t-foreach="children" t-as="cat">
                    <li>
                        <a t-att-href="'/shop/category/%s' % slug(cat)" class="category-link d-block py-1" t-att-data-img="'/web/image/product.public.category/%s/image_1920' % cat.id">
                            <t t-esc="cat.name"/>
                        </a>
                    </li>
                </t>
            </ul>
        </div>
    </t>
</t>


<!-- Replace this preview column -->
<div class="col-3">
    <div class="preview-wrapper position-absolute w-100 h-auto">
        <img id="hover-preview" src="/web/image/product.public.category/6/image_1920" class="img-fluid rounded shadow-sm" alt="preview" loading="lazy"/>
    </div>
</div>

            </div>
            <div class="mt-3 mb-4">
                <a href="/shop" class="all-products-link">ALL PRODUCTS</a>
            </div>
            </div>
        </div>

        <!-- Fallback for non-mega menu cases -->
        <div t-if="submenu.is_mega_menu" t-elif="False" class="dropdown-menu o_mega_menu" t-field="submenu.mega_menu_content" role="menuitem"/>
        <ul t-else="" class="dropdown-menu" role="menu">
            <t t-foreach="submenu.child_id" t-as="submenu">
                <t t-call="website.submenu">
                    <t t-set="item_class" t-value="None"/>
                    <t t-set="link_class" t-valuef="dropdown-item"/>
                </t>
            </t>
        </ul>
    </li>
    <li t-elif="show_dropdown and is_mobile" t-attf-class="#{item_class or ''} mobile-products-accordion" role="presentation">
        <div class="mobile-products-toggle">
            <span t-field="submenu.name"/>
        </div>
        <t t-set="parent_labels" t-value="['LIVING ROOM', 'DINING ROOM', 'BEDROOM']"/>
        <t t-set="Category" t-value="request.env['product.public.category'].sudo()"/>
        <t t-set="has_is_published" t-value="'is_published' in Category._fields"/>
        <t t-set="pub_domain" t-value="has_is_published and [('is_published','=',True)] or []"/>
        <t t-set="parent_data" t-value="[]"/>

        <t t-foreach="parent_labels" t-as="label">
            <t t-set="parent" t-value="Category.search([('parent_id','=',False), ('name','ilike', label)] + pub_domain, limit=1)"/>
            <t t-if="parent">
                <t t-set="children" t-value="Category.search([('parent_id','=',parent.id)] + pub_domain, order='sequence, name')"/>
                <t t-set="parent_data" t-value="parent_data + [{'parent': parent, 'children': children}]"/>
            </t>
        </t>

        <div t-if="parent_data" t-attf-id="mobileCategoryAccordion-#{submenu.id}" class="accordion mobile-category-accordion mt-2">
            <t t-foreach="parent_data" t-as="info" t-foreach-index="idx">
                <div class="accordion-item">
                    <h2 class="accordion-header" t-att-id="'heading-%s-%s' % (submenu.id, info['parent'].id)">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" t-att-data-bs-target="'#collapse-%s-%s' % (submenu.id, info['parent'].id)" aria-expanded="false" t-att-aria-controls="'collapse-%s-%s' % (submenu.id, info['parent'].id)">
                            <t t-esc="info['parent'].name"/>
                        </button>
                    </h2>
                    <div class="accordion-collapse collapse" t-att-id="'collapse-%s-%s' % (submenu.id, info['parent'].id)" t-att-aria-labelledby="'heading-%s-%s' % (submenu.id, info['parent'].id)" t-att-data-bs-parent="'#mobileCategoryAccordion-%s' % submenu.id">
                        <div class="accordion-body p-0">
                            <ul class="list-unstyled mb-0">
                                <t t-foreach="info['children']" t-as="cat">
                                    <li>
                                        <a t-att-href="'/shop/category/%s' % slug(cat)" class="mobile-subcategory-link d-block py-2">
                                            <t t-esc="cat.name"/>
                                        </a>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </li>
    <!-- Style -->
<style>
    .custom-mega-menu {
        background-color: #514c44 !important;
        width: 100%;
        max-height: none !important;
        overflow: visible !important;
        padding-left: 125px !important;
        padding-right: 125px !important;
    }
    .custom-mega-menu h5 {
        font-weight: 400;
        font-size: 14px;
        color: #c4bdb0;
        text-transform: uppercase;
