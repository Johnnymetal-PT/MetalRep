<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prestashop_instance_tree" model="ir.ui.view">
        <field name="name">prestashop.instance.tree</field>
        <field name="model">prestashop.instance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="shop_id"/>
                <field name="company_id"/>
                <field name="last_customer_sync_at"/>
                <field name="last_sync_status"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_prestashop_instance_form" model="ir.ui.view">
        <field name="name">prestashop.instance.form</field>
        <field name="model">prestashop.instance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_sync_customers" type="object" string="Sync Clients" class="btn-primary"/>
                    <button name="action_regenerate_webhook_key" type="object" string="Regenerate Webhook Key" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="shop_id"/>
                            <field name="customer_page_size"/>
                        </group>
                        <group string="OAuth">
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="oauth_url"/>
                            <field name="oauth_audience"/>
                            <field name="oauth_scope"/>
                        </group>
                    </group>
                    <group string="CloudSync">
                        <field name="raw_base_url"/>
                    </group>
                    <group string="Webhook">
                        <field name="webhook_enabled"/>
                        <field name="webhook_url" readonly="1"/>
                        <field name="webhook_key" readonly="1"/>
                        <field name="webhook_secret" password="True"/>
                    </group>
                    <group string="Last Sync">
                        <field name="last_customer_sync_at" readonly="1"/>
                        <field name="last_sync_status" readonly="1"/>
                        <field name="last_sync_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prestashop_instance" model="ir.actions.act_window">
        <field name="name">Prestashop Clients</field>
        <field name="res_model">prestashop.instance</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_partner_form_prestashop" model="ir.ui.view">
        <field name="name">res.partner.form.prestashop</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Prestashop" groups="base.group_system">
                    <group>
                        <field name="prestashop_shop_id"/>
                        <field name="prestashop_customer_id"/>
                        <field name="prestashop_content_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_prestashop_root" name="Prestashop" sequence="80" groups="base.group_system"/>
    <menuitem
        id="menu_prestashop_instances"
        name="Client Sync"
        parent="menu_prestashop_root"
        action="action_prestashop_instance"
        sequence="10"
        groups="base.group_system"
    />
</odoo>
