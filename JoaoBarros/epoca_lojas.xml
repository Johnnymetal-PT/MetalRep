                    <style>
/* --- Newsletter: collapsed -&gt; button, expanded -&gt; wizard card --- */
.newsletter_wizard_wrap{
  display:flex;
  justify-content:flex-end; /* keep aligned to the right column */
}

.newsletter_wizard_btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:12px 20px;
  border-radius:12px;
  background:#fff;
  color:#111;
  border:1px solid rgba(255,255,255,.25);
  font-weight:600;
  cursor:pointer;
}

.newsletter_wizard_panel{
  display:none;             /* hidden until button click */
  width: min(520px, 100%);
}

.newsletter_wizard_panel.is-open{
  display:block;
}

/* Card */
.newsletter_wizard_card{
  position:relative;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 18px;
  padding: 22px 22px 78px;
  backdrop-filter: blur(6px);
}

/* Close button */
.newsletter_wizard_close{
  position:absolute;
  top:12px;
  right:12px;
  width:34px;
  height:34px;
  border-radius:10px;
  border:1px solid rgba(255,255,255,.18);
  background: rgba(0,0,0,.35);
  color:#fff;
  cursor:pointer;
}

/* Reuse wizard look but adapted to dark bg */
.newsletter_wizard_card .o_form_wizard_q{
  display:none;
  opacity:0;
  transform: translateY(8px);
  transition: opacity .28s ease, transform .28s ease;
}
.newsletter_wizard_card .o_form_wizard_q.is-active{display:block}
.newsletter_wizard_card .o_form_wizard_q.is-active.is-visible{
  opacity:1;
  transform: translateY(0);
}

.newsletter_wizard_card .o_form_wizard_title{
  font-size: 18px;
  font-weight: 600;
  line-height: 1.2;
  margin-bottom: 14px;
  color:#fff;
}

/* Inputs */
.newsletter_wizard_card .form-control,
.newsletter_wizard_card textarea,
.newsletter_wizard_card select{
  border:none!important;
  border-bottom:1px solid rgba(255,255,255,.35)!important;
  border-radius:0!important;
  padding:10px 0!important;
  background:transparent!important;
  box-shadow:none!important;
  font-size:16px;
  color:#fff;
}
.newsletter_wizard_card .form-control::placeholder{color:rgba(255,255,255,.6)}
.newsletter_wizard_card .form-control:focus,
.newsletter_wizard_card textarea:focus,
.newsletter_wizard_card select:focus{
  outline:none!important;
  box-shadow:none!important;
  border-bottom-color:rgba(255,255,255,.8)!important;
}

/* Hide built-in labels */
.newsletter_wizard_card .s_website_form_label,
.newsletter_wizard_card .s_website_form_field &gt; label{display:none!important}

/* Hide default submit row until last step (NO !important) */
.newsletter_wizard_card .s_website_form_submit{display:none}

/* Nav inside card */
.newsletter_wizard_card .o_form_wizard_nav{
  position:absolute;
  right:16px;
  bottom:16px;
  z-index:10;
  display:flex;
  gap:10px;
}

.newsletter_wizard_card .o_form_wizard_btn{
  width:40px;height:40px;
  border-radius:10px;
  border:1px solid rgba(255,255,255,.18);
  background:#fff;color:#111;
  display:inline-flex;align-items:center;justify-content:center;
  cursor:pointer;user-select:none
}
.newsletter_wizard_card .o_form_wizard_btn.is-disabled{opacity:.35;cursor:not-allowed}
.newsletter_wizard_card .o_form_wizard_ok{
  padding:8px 14px;
  width:auto;
  min-width:96px;
  height:40px;
  font-size:14px;
}

.newsletter_wizard_close{
  z-index: 9999;
  pointer-events: auto;
}

</style>

<script>
document.addEventListener('DOMContentLoaded', () =&gt; {
  // Find newsletter forms in this page (mailing.contact)
  const forms = Array.from(document.querySelectorAll('form[data-model_name="mailing.contact"]'));
  if (!forms.length) return;

  const getLabelText = (fieldEl) =&gt; {
    const labelContent = fieldEl.querySelector('.s_website_form_label_content');
    if (labelContent &amp;&amp; labelContent.textContent.trim()) return labelContent.textContent.trim();
    const label = fieldEl.querySelector('label');
    if (label &amp;&amp; label.textContent.trim()) return label.textContent.replace(/\*/g, '').trim();
    return (fieldEl.getAttribute('data-translated-name') || fieldEl.getAttribute('data-name') || 'Pergunta').trim();
  };

  const focusFirstField = (stepEl) =&gt; {
    const field = stepEl.querySelector('input:not([type="hidden"]), textarea, select');
    if (field) field.focus({ preventScroll: true });
  };

  const safeSubmit = (form) =&gt; {
    // Prefer Odoo's handler (usually bound to this button)
    const odooSend = form.querySelector('a.s_website_form_send, button.s_website_form_send, input.s_website_form_send');
    if (odooSend) return odooSend.click();

    // Fallbacks
    if (typeof form.requestSubmit === 'function') return form.requestSubmit();
    const realSubmit = form.querySelector('button[type="submit"], input[type="submit"]');
    if (realSubmit) return realSubmit.click();

    form.submit();
  };

  forms.forEach((form) =&gt; {
    // prevent double init
    if (form.dataset.newsletterWizardInit === '1') return;
    form.dataset.newsletterWizardInit = '1';

    const rows = form.querySelector('.s_website_form_rows');
    if (!rows) return;

    // Create button + panel wrapper near the form
    const host = form.closest('.s_website_form') || form.parentElement;
    if (!host) return;

    // ✅ IMPORTANT: capture the success message BEFORE moving the form
    const endMsg = form.closest('.s_website_form')?.querySelector('.s_website_form_end_message');

    // Hide the form initially (we'll put it in a panel)
    form.style.display = 'none';

    const wrap = document.createElement('div');
    wrap.className = 'newsletter_wizard_wrap';

    const openBtn = document.createElement('button');
    openBtn.type = 'button';
    openBtn.className = 'newsletter_wizard_btn';
    openBtn.textContent = 'Subscrever';

    const panel = document.createElement('div');
    panel.className = 'newsletter_wizard_panel';

    const card = document.createElement('div');
    card.className = 'newsletter_wizard_card';

    const closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'newsletter_wizard_close';
    closeBtn.setAttribute('aria-label', 'Fechar');
    closeBtn.textContent = '✕';

    panel.appendChild(card);
    wrap.appendChild(openBtn);
    wrap.appendChild(panel);

    // insert wrapper before the form host content
    host.insertBefore(wrap, host.firstChild);

    // Move the form into the card
    card.appendChild(closeBtn);
    card.appendChild(form);

    // ✅ Move the success message into the same card too
    if (endMsg) card.appendChild(endMsg);

    form.style.display = ''; // visible inside panel (panel still hidden)

    // Build steps (only from visible fields, excluding hidden list_ids)
    const fieldEls = Array.from(rows.children).filter(el =&gt;
      el.classList.contains('s_website_form_field') &amp;&amp;
      !el.classList.contains('s_website_form_field_hidden')
    );

    if (fieldEls.length &lt;= 1) {
      // If only one field, just show form normally on open
      openBtn.addEventListener('click', () =&gt; {
        panel.classList.add('is-open');
        openBtn.style.display = 'none';
      });
      closeBtn.addEventListener('click', () =&gt; {
        panel.classList.remove('is-open');
        openBtn.style.display = '';
      });
      return;
    }

    // Wrap each field into a step
    const steps = fieldEls.map((fieldEl, idx) =&gt; {
      const step = document.createElement('div');
      step.className = 'o_form_wizard_q';
      step.dataset.stepIndex = String(idx);

      const title = document.createElement('div');
      title.className = 'o_form_wizard_title';
      title.textContent = getLabelText(fieldEl);

      step.appendChild(title);
      step.appendChild(fieldEl);

      rows.insertBefore(step, rows.firstChild);
      return step;
    }).sort((a,b) =&gt; parseInt(a.dataset.stepIndex,10) - parseInt(b.dataset.stepIndex,10));

    const submitRow = rows.querySelector('.s_website_form_submit') || form.querySelector('.s_website_form_submit');

    // Add nav
    const nav = document.createElement('div');
    nav.className = 'o_form_wizard_nav';
    nav.innerHTML = `
      <button type="button" class="o_form_wizard_btn js_prev" aria-label="Anterior">↑</button>
      <button type="button" class="o_form_wizard_btn js_next" aria-label="Seguinte">↓</button>
    `;
    card.appendChild(nav);

    let current = 0;

    const isStepAnswered = (stepEl) =&gt; {
      const fields = stepEl.querySelectorAll('input, select, textarea');
      if (!fields.length) return true;

      const checkboxes = stepEl.querySelectorAll('input[type="checkbox"]');
      if (checkboxes.length) return Array.from(checkboxes).some(c =&gt; c.checked);

      const field = fields[0];
      if (typeof field.checkValidity === 'function') return field.checkValidity();
      return (field.value || '').trim().length &gt; 0;
    };

    const renderNav = () =&gt; {
      const prevBtn = nav.querySelector('.js_prev');
      const nextBtn = nav.querySelector('.js_next');

      prevBtn.classList.toggle('is-disabled', current === 0);

      const isLast = current === (steps.length - 1);

      // show/hide default Odoo submit row only on last step
      if (submitRow) submitRow.style.display = isLast ? 'block' : 'none';

      nextBtn.textContent = isLast ? 'Submeter' : '↓';
      nextBtn.classList.toggle('o_form_wizard_ok', isLast);
    };

    const renderStep = (initial=false) =&gt; {
      steps.forEach((s,i) =&gt; {
        s.classList.toggle('is-active', i === current);
        if (i !== current) s.classList.remove('is-visible');
      });

      if (initial) setTimeout(() =&gt; steps[current].classList.add('is-visible'), 0);
      else steps[current].classList.add('is-visible');

      focusFirstField(steps[current]);
      renderNav();
    };

    const goNext = () =&gt; {
      const stepEl = steps[current];
      if (!isStepAnswered(stepEl)) {
        const firstField = stepEl.querySelector('input, textarea, select');
        if (firstField &amp;&amp; typeof firstField.reportValidity === 'function') firstField.reportValidity();
        return;
      }

      const isLast = current === (steps.length - 1);
      if (!isLast) {
        const old = current;
        current += 1;
        steps[old].classList.remove('is-visible');
        setTimeout(() =&gt; {
          steps.forEach((s,i) =&gt; s.classList.toggle('is-active', i === current));
          void steps[current].offsetWidth;
          steps[current].classList.add('is-visible');
          focusFirstField(steps[current]);
          renderNav();
        }, 160);
        return;
      }

      safeSubmit(form);
    };

    const goPrev = () =&gt; {
      if (current === 0) return;
      const old = current;
      current -= 1;
      steps[old].classList.remove('is-visible');
      setTimeout(() =&gt; {
        steps.forEach((s,i) =&gt; s.classList.toggle('is-active', i === current));
        void steps[current].offsetWidth;
        steps[current].classList.add('is-visible');
        focusFirstField(steps[current]);
        renderNav();
      }, 160);
    };

    nav.querySelector('.js_next').addEventListener('click', goNext);
    nav.querySelector('.js_prev').addEventListener('click', goPrev);

    form.addEventListener('keydown', (e) =&gt; {
      if (e.key !== 'Enter') return;
      const activeStep = steps[current];
      if (activeStep &amp;&amp; activeStep.querySelector('textarea:focus')) return;
      e.preventDefault();
      goNext();
    });

    // Open/close behavior
    openBtn.addEventListener('click', () =&gt; {
      panel.classList.add('is-open');
      openBtn.style.display = 'none'; // hide after click
      current = 0;
      renderStep(true);
    });

    const closePanel = () =&gt; {
      panel.classList.remove('is-open');
      openBtn.style.display = ''; // show button again
    };

    closeBtn.addEventListener('click', (e) =&gt; {
      e.preventDefault();
      e.stopPropagation();
      closePanel();
    });

    // Init in closed state
    renderStep(true);
  });
});
</script>
