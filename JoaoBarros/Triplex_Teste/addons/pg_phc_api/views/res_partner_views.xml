<odoo>
  <record id="view_partner_form_phc_sync" model="ir.ui.view">
    <field name="name">res.partner.form.phc.sync</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- Buttons: stable Studio anchor -->
      <xpath expr="/form//div[@name='warning_tax']" position="before">
        <header>
          <!-- Sync PHC only if not synced yet (or no ref) -->
          <button string="Sync PHC"
                  type="object"
                  name="action_sync_phc"
                  class="btn-primary"
                  invisible="is_phc_synced or ref"/>

          <!-- Update PHC only if already synced and ref exists -->
          <button string="Update PHC"
                  type="object"
                  name="action_update_phc"
                  class="btn-secondary"
                  invisible="not is_phc_synced or not ref"/>

          <!-- Toggle visible in header -->
          <field name="is_phc_synced"
                 widget="boolean_toggle"
                 class="o_inline"
                 string="PHC Synced"/>
        </header>
      </xpath>

      <!-- PHC debug tab -->
      <xpath expr="//sheet/notebook" position="inside">
        <page string="PHC">
          <group>
            <!-- Main toggle -->
            <field name="is_phc_synced" widget="boolean_toggle"/>

            <!-- Debug -->
            <field name="phc_last_response" nolabel="0" readonly="1"/>
          </group>
        </page>
      </xpath>

    </field>
  </record>
</odoo>
