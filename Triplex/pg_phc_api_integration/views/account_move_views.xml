<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherited.pgci.phc.api.integration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//group//group[@id='header_right_group']" position="inside">
                <field name="is_phc_synced" widget="boolean_toggle" invisible="move_type != 'out_invoice'" readonly="1" />
            </xpath>
            <xpath expr="//header//field[@name='state']" position="before">
                <button name="action_sync_to_phc" string="Sync To PHC" type="object" invisible="move_type != 'out_invoice' or is_phc_synced or state != 'posted'" data-hotkey="p" />
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='sale_info_group']" position="inside">
                <field name="filename" invisible="1" />
                <field name="phc_invoice" filename="filename" options="{'accepted_file_extensions': '.pdf'}" invisible="move_type != 'out_invoice'" readonly="1" />
                <field name="phc_last_response" readonly="1" invisible="move_type != 'out_invoice'" />
            </xpath>
        </field>
    </record>
</odoo>