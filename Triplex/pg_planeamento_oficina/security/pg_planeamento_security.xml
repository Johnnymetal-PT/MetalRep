<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_planeamento" model="ir.module.category">
        <field name="name">Planeamento Oficina</field>
        <field name="description">Painel de planeamento da oficina (CEO/Administração)</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_planeamento_manager" model="res.groups">
        <field name="name">Gestor de Planeamento</field>
        <field name="category_id" ref="module_category_planeamento"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">
            Acesso ao Painel de Planeamento da Oficina. Reservado a CEO,
            administração e gestores de produção autorizados.
        </field>
    </record>

    <record id="rule_pg_planeamento_line_multicompany" model="ir.rule">
        <field name="name">pg.planeamento.line: multi-empresa</field>
        <field name="model_id" ref="model_pg_planeamento_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
