<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Registos de tempo da operação: expõe o número de pessoas e as horas-pessoa, para
         o back office poder conferir e corrigir o que o chão de fábrica registou. -->
    <record id="view_mrp_production_work_order_form_people" model="ir.ui.view">
        <field name="name">mrp.workorder.form.pg.people.count</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_ids']/tree" position="inside">
                <field name="pg_people_count"/>
                <field name="pg_person_hours" widget="float_time" optional="show"/>
            </xpath>
            <!-- O número em vigor na operação, para o back office ver e corrigir sem ter de
                 abrir os registos de tempo um a um.
                 Ancorado em `duration_expected` e não em `duration`: a primeira ocorrência
                 de `duration` nesta vista está DENTRO da árvore dos registos de tempo, pelo
                 que um xpath sobre ela punha um campo da operação no sítio errado. -->
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="pg_people_count"/>
            </xpath>
        </field>
    </record>

</odoo>
