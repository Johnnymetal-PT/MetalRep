<odoo>
  <record id="view_users_form_phc_credentials" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.phc.credentials</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='storno']" position="after">
        <block title="PHC Credentials" id="pg_phc_credentials">
          <setting id="pg_phc_credentials_setting" help="Credentials used to sync with PHC for the selected company.">
            <div class="content-group">
              <div class="row mt16">
                <label for="phc_api_base_url" string="PHC WS URL" class="col-lg-3"/>
                <field name="phc_api_base_url"/>
              </div>
              <div class="row mt16">
                <label for="phc_api_user" string="Utilizador PHC" class="col-lg-3"/>
                <field name="phc_api_user"/>
              </div>
              <div class="row mt16">
                <label for="phc_api_password" string="Password PHC" class="col-lg-3"/>
                <field name="phc_api_password" password="True"/>
              </div>
            </div>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
