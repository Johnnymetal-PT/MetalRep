<templates>
   <!-- For radio display (unchanged) -->
   <t t-name="ptav-radio-image" t-inherit="sale_product_configurator.saleProductConfigurator.ptav-radio" t-inherit-mode="extension">
       <xpath expr="//div[hasclass('form-check')]" position="after">
           <img class="attr_value_img" style="width: 100px;" t-if="ptav.image"
                loading="lazy" decoding="async"
                t-attf-src="/web/image/product.template.attribute.value/{{ptav.id}}/image?width=128&amp;height=128"/>
       </xpath>
   </t>
</templates>

