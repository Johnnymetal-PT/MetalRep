<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_pricelist_view_pg_exempt_attrs" model="ir.ui.view">
        <field name="name">product.pricelist.form.pg.exempt.attrs</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field name="pg_exempt_attribute_ids" widget="many2many_tags"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
