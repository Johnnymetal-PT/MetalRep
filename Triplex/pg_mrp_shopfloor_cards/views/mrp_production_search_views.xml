<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_production_filter_pg_shopfloor_origin" model="ir.ui.view">
        <field name="name">mrp.production.filter.pg.shopfloor.origin</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="before">
                <field name="origin" string="Origem" filter_domain="[('origin', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//search/field[@name='name']" position="attributes">
                <attribute name="filter_domain">[('name', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//search/field[@name='origin' and not(@filter_domain)]" position="replace"/>
        </field>
    </record>
</odoo>
