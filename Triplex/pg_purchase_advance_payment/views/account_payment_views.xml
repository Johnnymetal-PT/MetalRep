<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pg_account_payment_form_purchase_order" model="ir.ui.view">
        <field name="name">account.payment.form.pg.purchase.order</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='ref']" position="after">
                <field name="pg_purchase_order_id"
                       options="{'no_create': True}"
                       invisible="partner_type != 'supplier' or is_internal_transfer"/>
            </xpath>
        </field>
    </record>

    <record id="pg_account_supplier_payment_tree_purchase_order" model="ir.ui.view">
        <field name="name">account.supplier.payment.tree.pg.purchase.order</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="pg_purchase_order_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
