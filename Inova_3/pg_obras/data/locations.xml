<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">
    <!-- "OBR" (view) por baixo de "Locations" -->
    <record id="location_obr" model="stock.location">
      <field name="name">OBR</field>
      <field name="location_id" eval="ref('stock.stock_location_locations')"/>
      <field name="usage">view</field>
      <field name="company_id" eval="ref('base.main_company')"/>
    </record>

    <!-- "OBR/Stock" (internal) -->
    <record id="location_obr_stock" model="stock.location">
      <field name="name">Stock</field>
      <field name="location_id" eval="ref('pg_obras.location_obr')"/>
      <field name="usage">internal</field>
      <field name="company_id" eval="ref('base.main_company')"/>
    </record>

  </data>
</odoo>
