<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_res_users_view_form" model="ir.ui.view">
        <field name="name">hr.res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form"/>
        <field name="arch" type="xml">
            <button name="action_create_employee" position="attributes">
                <attribute name="invisible">id == False or employee_id != False</attribute>
            </button>
        </field>
    </record>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="replace">
                <field name="user_id" string="Related User" help="" domain="[('company_ids', 'in', company_id)]" context="{'default_create_employee_id': id}" widget="many2one_avatar_user"/>
            </field>
        </field>
    </record>
</odoo>