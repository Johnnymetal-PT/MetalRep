<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="expense_state_steps">
        <ul class="status_step pull-right hidden-xs d-flex justify-content-end">
            <li t-att-class="step == 'draft' and 'text-primary' or 'text-muted'" id="step10">
                <a href="#" t-att-class="step == 'draft' and 'text-success' or 'o_link_disable'">
                    <span>To Submit</span>
                </a>
                <span class="chevron"/>
            </li>
            <li t-att-class="step == 'reported' and 'text-primary' or 'text-muted'" id="step20">
                <!-- <t t-set="step_operational_info" t-value="step&gt;20 and step&lt;50"/> -->
                <a href="#" t-att-class="step == 'reported' and 'text-success' or 'o_link_disable'">
                    <span>Submitted</span>
                </a>
                <span class="chevron"/>
            </li>
            <li t-att-class="step == 'approved' and 'text-primary' or 'text-muted'" class="text-primary" id="step30">
                <!-- <t t-set="step_operational_info" t-value="step&gt;30 and step&lt;50"/> -->
                <a href="#" t-att-class="step == 'approved' and 'text-success' or 'o_link_disable'">
                    <span>Approved</span>
                </a>
                <span class="chevron"/>
            </li>
            <li t-att-class="step == 'done' and 'text-primary' or 'text-muted'" class="text-primary" id="step40">
                <!-- <t t-set="step_operational_info" t-value="step&gt;30 and step&lt;50"/> -->
                <a href="#" t-att-class="step == 'done' and 'text-success' or 'o_link_disable'">
                    <span>Paid</span>
                </a>
                <span class="chevron"/>
            </li>
            <li t-att-class="step == 'refused' and 'text-primary' or 'text-muted'" class="text-primary" id="step50">
                <!-- <t t-set="step_operational_info" t-value="step&gt;30 and step&lt;50"/> -->
                <a href="#" t-att-class="step == 'refused' and 'text-success' or 'o_link_disable'">
                    <span>Refused</span>
                </a>
                <span class="chevron"/>
            </li>
        </ul>
    </template>

    <template id="portal_expense" name="Expense Request">
        <t t-call="portal.portal_layout">
            <div class="oe_structure"/>
            <div class="container oe_website_sale expense_hr_portal o_expense_request">
                <form class="form-horizontal container-fluid hr_expense_form p-3 bg-light" action="/expense/request" role="form" method="post" enctype="multipart/form-data">
                    <input type="hidden" id="expense" name="expense" t-att-value="expense.id if expense else None"/>
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t class="row">
                        <t class="card-header">
                            <div class="row no-gutters">
                                <div t-if="not expense" class="col-md">
                                    <h5 class="mb-1 mb-md-0">
                                        Create a Expense Request
                                    </h5>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <!-- <div t-if="expense" class='row justify-content-end'>
                                        <t t-call="portal_users_expense.expense_state_steps">
                                            <t class="step" t-value="expense.state"/>
                                        </t>
                                    </div> -->
                                    <div class='row justify-content-end align-items-center'>
                                        <h5 t-if="expense" class="mb-1 col-md-6 mb-md-0">
                                            <span t-esc="expense.name" style="text-transform: uppercase;"/>
                                            <t t-if="expense.state == 'draft'">
                                                <span class="badge badge-pill"  style="background-color: #999999; color: black;" title="Current stage of the task" t-field="expense.state" />
                                                <t />
                                            </t>
                                            <t t-if="expense.state == 'reported'">
                                                <span class="badge badge-pill"  style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-field="expense.state"/>
                                            </t>
                                            <t t-if="expense.state == 'approved'">
                                                <span class="badge badge-pill"  style="background-color: #16a2b8; color: black;" title="Current stage of the task" t-field="expense.state"/>
                                            </t>
                                            <t t-if="expense.state == 'done'">
                                                <span class="badge badge-pill"  style="background-color: #c16fb7; color: black;" title="Current stage of the task" t-field="expense.state"/>
                                            </t>
                                            <t t-if="expense.state == 'refused'">
                                                <span class="badge badge-pill"  style="background-color: #17a2b8; color: black;" title="Current stage of the task" t-field="expense.state"/>
                                            </t>
                                        </h5>
                                        <div class="col-md text-right col-md-6 justify-content-end d-flex">
                                            <button type="submit" t-if="not expense" id="create_expense_data" class="btn btn-primary">Create</button>
                                            <button type="submit" t-if="expense and expense.state == 'draft'" id="update_expense_data" class="btn btn-primary">Update</button>
                                            <a t-attf-href="/my/expense">
                                                <button class="btn btn-danger btn-md" type="button" special="cancel">Cancel</button>
                                            </a>
                                            <a t-attf-href="/my/expense/delete/#{expense.id}?{{ keep_query() }}" t-if="expense and expense.state not in ['done', 'approved'] and expense">
                                                <span class="fa fa-trash-o fa-2x remove-optionnal-item" title="Delete" aria-label="Delete"/>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t class="card-body">
                            <div class="row no-gutters" style="font-size: 15px;">
                                <div class="col-md-11" t-if="error">
                                    <div class="input-group">
                                        <div class="text-danger mt0 mb0 alert alert-danger">
                                            <span t-esc="error"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row oe_sub w-100">
                                    <div id="name_des" class="col-md-12">
                                        <div class="input-group row name_des">
                                            <label class="col-md-2 o_label col-5" for="name">Description</label>
                                            <input required="required" t-att-readonly="'readonly' if expense and expense.state not in ['draft'] else None" type="text" class="form-control col-md-10 col-sm-10 o_required_modifier" name="name" t-att-value="expense.name if expense else ''"/>
                                        </div>
                                    </div>
                                    <div id="product_id" class="col-md-6 mt-3">
                                        <div class="input-group row name_des">
                                            <label class="col-md-4 o_label col-5" for="product_id">Product</label>
                                            <select t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" id="product_id" name="product_id" class="form-control col-md-8 o_required_modifier">
                                                <t t-foreach="expense_products" t-as="product"><option t-att-selected="product.id == expense.product_id.id if expense and expense.product_id else None" t-att-value="product.id">
                                                        <t t-esc="product.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <div id="quantity" class="col-md-6 mt-3">
                                        <div class="input-group row">
                                            <label class="col-md-4 o_label col-5" for="quantity">Quantity
                                            </label>
                                            <input required="required" t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" type="number" step="any" min="1" class="form-control col-md-8 o_required_modifier" name="quantity" t-att-value="expense.quantity if expense else 1"/>
                                        </div>
                                    </div>
                                    <div id="price_unit" t-if="expense" class="col-md-6 mt-3">
                                        <div class="input-group row">
                                            <label class="col-md-4 o_label col-5" for="price_unit">Expense Amount</label>
                                            <input required="required" t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" type="number" step="any" min="0" class="form-control col-md-8 o_required_modifier price_unit" name="price_unit" t-att-value="expense.price_unit if expense else 0.0"/>
                                        </div>
                                    </div>
                                    <div id="date" class="col-md-6 mt-3">
                                        <div class="input-group row date">
                                            <label class="col-md-4  o_label col-5" for="date">Date</label>
                                            <input type="date" t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" class="form-control col-md-8 o_required_modifier" name="date" t-att-value="expense.date if expense else current_date"/>
                                        </div>
                                    </div>
                                    <div id="description" class="col-md-6 mt-3">
                                        <div class="input-group row description">
                                            <label class="col-md-4  o_label col-5" for="description">Internal Notes</label>
                                            <input type="text" class="form-control col-md-8 o_required_modifier" name="description" t-att-value="expense.description if expense else ''" t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" id="analytic_account_id"/>
                                        </div>
                                    </div>
                                    <div id="name_des" class="col-md-6 mt-3">
                                        <div class="input-group row name_des">
                                            <label class="col-md-4  o_label col-5" for="payment_mode">Paid By</label>
                                            <select t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" name="payment_mode" class="form-control col-md-8 o_required_modifier">
                                                <t t-foreach="payment_type" t-as="type"><option t-att-selected="type[0] == expense.payment_mode if expense and expense.payment_mode else None" t-att-value="type[0]">
                                                        <t t-esc="type[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <!-- <div id="include_salary" class="col-md-6 mt-3">
                                        <div class="input-group row include_salary">
                                            <label class="col-md-4  o_label col-5" for="include_salary">Include in Salary</label>
                                            <input type="checkbox" class="col-md-1 o_required_modifier" name="include_salary" t-att-checked="expense.include_salary if expense else False" t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None"/>
                                        </div>
                                    </div> -->
                                    <div t-if="group_analytic_accounting" id="analytic_account_id" class="col-md-6 mt-3">
                                        <div class="input-group row analytic_account_id">
                                            <label class="col-md-4  o_label col-5" for="analytic_account_id">Analytic Account</label>
                                            <select t-att-disabled="'disabled' if expense and expense.state not in ['draft'] else None" id="analytic_account_id" name="analytic_account_id" class="form-control col-md-8 o_required_modifier">
                                                <t t-foreach="analytic_accounts" t-as="analytic"><option t-att-selected="analytic.id == expense.analytic_account_id.id if expense and expense.analytic_account_id else None" t-att-value="analytic.id">
                                                        <t t-esc="analytic.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row oe_sub w-100">
                                    <div class="col-md-12">
                                        <div class="form-group row">
                                            <label class="col-md-6 o_label col-12 mt-3">Notes</label>
                                            <div class="col-md-8">
                                                <textarea t-att-disabled="expense.state not in ['draft'] if expense else None" rows="2" name="description" class="form-control col-md-8 o_required_modifier"><t t-if="expense" t-esc="expense.description"/></textarea>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label class="col-md-4 o_label col-12 mt-3">Add Attachments</label>
                                            <div class="col-md-6">
                                                <input t-att-disabled="expense.state not in ['draft'] if expense else None" type="file" id="uploadImage" class="form-control col-md-6 o_forum_file_upload" name="ufile" accept="image/*,application/pdf" multiple="multiple"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <div t-if="expense" class="mt32">
                        <h4><strong>Message and communication history</strong></h4>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="expense"/>
                            <t t-set="pid" t-value="pid"/>
                            <t t-set="chatter_mode" t-value="'json'"/>
                            <t t-set="hash" t-value="hash"/>
                        </t>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="thankyou_expense" name="Thank you">
        <t t-call="portal.portal_layout">
            <div id="wrap">
                <div class="oe_structure">
                    <div class="container pt32 pb32">
                        <div class="row pb32 alert alert-info pt32">
                            <div class="col-md-12">
                                <h1>Thank you!</h1>
                            </div>
                            <div class="col-md-12">
                                <h5>
                                    Your Expense Request is successfully submitted you can check your request here <a t-attf-href="/my/expense/{{record.id}}"> <t t-esc="record.name"/></a>.
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
