        <field name="name">res.partner.form.mb</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <page name="sales_purchases" position="inside">
                <group string="Multibanco" name="multibanco">
                    <field name="multibanco_invoice_exception" invisible="parent_id" />
                </group>
            </page>
        </field>
    </record>
</odoo>
