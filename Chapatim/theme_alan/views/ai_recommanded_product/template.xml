<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =============== Alan AI Product Recommanded Template ===============  -->
    <template id="ai_product_recommanded" name="AI Product Recommandation" inherit_id="website_sale.product">
        <xpath expr="//div[@id='oe_structure_website_sale_product_2']" position="after">
            <section class="product_recommanded_ai as-ai-product-recommanded" t-att-data-product-tmpl-id="product.id">
                <div class="product_recommanded_container"></div>
            </section>
        </xpath>
    </template>

    <!-- =============== AI Product Recommanded Shop Page Floating Bar Template ===============  -->
