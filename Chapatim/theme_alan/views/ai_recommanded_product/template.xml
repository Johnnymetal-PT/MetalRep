                <a href="#" role="button" data-bs-toggle="offcanvas" data-bs-target="#o_wsale_offcanvas_recommanded_product" title="Recommanded Product">
                    <div class="fa fa-box">
                        <div class="ai-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="27" viewBox="0 0 25 27" fill="none">
