                        </div>
                        <div class="ai-ef-02"/>
                        <div class="ai-ef-03"/>
                        <div class="ai-ef-in"></div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

    <!-- =============== AI Product Recommanded Shop Page Template ===============  -->
    <template id="ai_shop_product_recommanded" name="AI Shop Product Recommandation" inherit_id="website_sale.products" priority="99999">
        <xpath expr="//div[hasclass('products_header')]" position="inside">
