    >
        <aside id="products_grid_before" position="attributes">
            <attribute name="class" add="as_attribute_layout_style_3" remove="as_attribute_layout_default" separator=" "/>
        </aside>
    </template>

    <template
        id="theme_alan.as_attribute_layout_4"
        inherit_id="website_sale.products"
        name="Attrubute Layout - 4"
        priority="99"
        active="False"
    >
        <aside id="products_grid_before" position="attributes">
            <attribute name="class" add="as_attribute_layout_style_4" remove="as_attribute_layout_default" separator=" "/>
        </aside>
    </template>

    <template
        id="theme_alan.as_attribute_layout_5"
        inherit_id="website_sale.products"
        name="Attrubute Layout - 5"
        priority="99"
        active="False"
    >
        <aside id="products_grid_before" position="attributes">
            <attribute name="class" add="as_attribute_layout_style_5" remove="as_attribute_layout_default" separator=" "/>
        </aside>
    </template>
</odoo>
