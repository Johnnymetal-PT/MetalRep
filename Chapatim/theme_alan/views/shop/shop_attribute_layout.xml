<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Shop Page: Attribute Layout Options ==================== -->
    <template
        id="theme_alan.as_attribute_layout_default"
        inherit_id="website_sale.products"
        name="Attrubute Layout - Default"
    >
        <aside id="products_grid_before" position="attributes">
            <attribute name="class" add="as_attribute_layout_default" separator=" "/>
        </aside>
    </template>

    <template
        id="theme_alan.as_attribute_layout_1"
        inherit_id="website_sale.products"
        name="Attrubute Layout - 1"
        priority="99"
        active="False"
    >
        <aside id="products_grid_before" position="attributes">
            <attribute name="class" add="as_attribute_layout_style_1" remove="as_attribute_layout_default" separator=" "/>
        </aside>
    </template>

    <template
        id="theme_alan.as_attribute_layout_2"
