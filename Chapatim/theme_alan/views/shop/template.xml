<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Similar Product Offcanvas Template ==================== -->
    <template id="o_wsale_offcanvas_similar_product" name="Similar Product Offcanvans">
        <aside id="o_wsale_offcanvas_similar_product" class="o_website_offcanvas offcanvas offcanvas-end as-similar-product-modal">
            <div class="offcanvas-header">
                <h5>Similar Products</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"/>
            </div>
            <div class="offcanvas_similar_product offcanvas-body">
                <!-- Similar products will be dynamically loaded here -->
            </div>
        </aside>
    </template>
    <!-- ==================== End Similar Product Offcanvas Template ==================== -->

    <!-- ==================== Similar Product List Template ==================== -->
    <template id="as_similar_product" name="Similar Product">
        <div class="m_c_box as-similar-product-box">
            <!-- Empty State: No Similar Products Found -->
            <div t-if="not products" class="as-similar-empty">
                <div class="img">
