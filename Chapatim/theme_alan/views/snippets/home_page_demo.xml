<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== Alan Home Page Demo Snippet ==================== -->
    <!-- Drop this snippet → click it → sidebar shows "Open Demo Builder" button → click → wizard opens -->
    <template id="as_home_page_demo" name="Alan Home Page Demo">
        <section class="as-home-page-demo" data-as-snippet="as_home_page_demo">
            <div class="container">
                <div class="as-home-demo-placeholder text-center py-5">
                    <h3 class="as-h3-text-dynamic">Home Page Demo Builder</h3>
                    <p class="text-muted mb-3">Click <strong>"Open Home Page Demo Builder"</strong> in the right sidebar to configure all 12 homepage sections step-by-step.</p>
                    <div class="as-home-demo-steps-preview d-flex justify-content-center flex-wrap gap-2">
                        <span class="badge">Hero Slider</span>
                        <span class="badge">Categories</span>
                        <span class="badge">Features</span>
                        <span class="badge">Products</span>
                        <span class="badge">Brands</span>
                        <span class="badge">Blogs</span>
                        <span class="badge">+6 more</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ==================== End Alan Home Page Demo Snippet ==================== -->
</odoo>
