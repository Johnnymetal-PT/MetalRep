<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =============== B2B Terms And Conditions Page ===============  -->
    <template id="b2b_terms_conditions_page" name="B2B Terms and Conditions">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_text_block pt96 pb96 o_colored_level" data-snippet="s_text_block" data-name="Text">
                    <div class="container">
                        <h1 class="text-center mb-4">B2B Terms &amp; Conditions</h1>
                        <div class="row">
                            <div class="col-lg-10 offset-lg-1">
                                <div class="s_hr pt8 pb8" data-snippet="s_hr" data-name="Separator">
                                    <hr class="w-100 mx-auto" style="border-top: 1px solid rgb(206, 212, 218);"/>
                                </div>
                                <div class="pt32 pb32">
                                    <t t-if="terms_content">
                                        <div t-out="terms_content" class="o_terms_content"/>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-info text-center" role="alert">
                                            <i class="fa fa-info-circle"/> No terms and conditions have been configured yet.
                                            <t t-if="request.env.user.has_group('base.group_system')">
                                                <br/>
                                                <a href="/web#action=website.action_website_configuration" class="btn btn-primary mt-3">
                                                    Configure Terms &amp; Conditions
                                                </a>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>