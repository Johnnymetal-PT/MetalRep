<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Compare Page ==================== -->
    <template id="as_product_compare" inherit_id="website_sale_comparison.product_compare" name="Theme Alan Comparator Page">
        <xpath expr="//div[hasclass('product_summary')]/span[1]" position="attributes">
            <attribute name="t-attf-style">{{'display:none !important;' if request.env.user._is_public() and website.active_b2b_mode else ''}}</attribute>
        </xpath>
        <xpath expr="//button[@name='comparison_add_to_cart']" position="attributes">
            <attribute name="t-if">not request.env.user._is_public() and website.active_b2b_mode</attribute>
        </xpath>
        <xpath expr="//button[@name='comparison_add_to_cart']" position="before">
            <div t-if="(website.env.user._is_public() and website.active_b2b_mode)">
                <a role="button" href="/web/login" t-attf-class="#{'as_login_popup' if website.active_login_popup else ''} btn btn-primary">
                    <i class="asi asi-lock"></i> <span>Login for price</span>
                </a>
            </div>
        </xpath>
    </template>

    <!-- ==================== Shop Page ==================== -->
    <template id="theme_alan_products_add_to_cart" inherit_id="website_sale.shop_product_buttons" name="Theme Alan Add to Cart" >
        <xpath expr="//t[contains(@t-if, 'product._website_show_quick_add()')]" position="attributes">
            <attribute name="t-if" separator=" and " add=" not (request.env.user._is_public() and website.active_b2b_mode)"/>
        </xpath>
    </template>
    <template id="theme_alan_filter_products_price" inherit_id="website_sale.filter_products_price" name="Theme Alan Filter by Prices">
        <xpath expr="//div[@id='o_wsale_price_range_option']" position="attributes">
            <attribute name="t-attf-style">{{'display:none !important;' if request.env.user._is_public() and website.active_b2b_mode else ''}}</attribute>
        </xpath>
    </template>
    <template id="as_header_cart_link" inherit_id="website_sale.header_cart_link" name="Theme Alan Header Cart Link">
        <xpath expr="//t[@t-set='show_cart']" position="attributes">
            <attribute name="t-value">not (request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
    </template>

    <template id="as_shop_login" inherit_id="website_sale.shop_product_buttons" name="Shop Page Login" priority="999">
        <xpath expr="//div[hasclass('o_wsale_product_action_row')]" position="before">
             <div t-if="request.env.user._is_public() and website.active_b2b_mode" class="as-b2b-price">
                <a role="button" href="/web/login" t-attf-class="#{'as_login_popup btn btn-light' if website.active_login_popup else 'btn btn-light '}">
                    <i class="asi asi-lock"></i> <span class="o_label small ms-2">Login for price</span>
                </a>
            </div>
        </xpath>
    </template>

    <template id="as_shop_price" inherit_id="website_sale.products_item" name="Shop Page Price">
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="t-if">not (request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
    </template>
    <template id="theme_alan_similar_product" name="Theme Alan Similar Product" inherit_id="theme_alan.as_similar_product">
        <xpath expr="//div[@t-if='product.product_variant_ids']" position="attributes">
            <attribute name="t-if" add=" not(request.env.user._is_public() and website.active_b2b_mode)" separator=" and "/>
        </xpath>
    </template>

    <!-- ==================== Product Page ==================== -->
    <template id="theme_alan_product_price" inherit_id="website_sale.product_price">
        <xpath expr="//div[contains(@t-attf-class, 'product_price')]" position="attributes">
            <attribute name="t-if">not (request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
    </template>
    <template id="theme_alan_product_quantity" inherit_id="website_sale.product_quantity" priority="99">
        <xpath expr="//div[contains(@id,'add_to_cart_wrap')]" position="attributes">
            <attribute name="t-attf-style">{{'display:none !important;' if request.env.user._is_public() and website.active_b2b_mode else ''}}</attribute>
        </xpath>
        <xpath expr="//div[contains(@id,'add_to_cart_wrap')]" position="before">
             <div t-if="request.env.user._is_public() and website.active_b2b_mode" class="as-pd-login-popup-wrap">
                <a href="/web/login" t-attf-class="btn btn-primary #{'as_login_popup' if website.active_login_popup else ''}"> <i class="asi asi-lock"></i> <span>Login for price</span></a>
            </div>
        </xpath>
    </template>
    <template id="theme_alan_badge_extra_price" name="Theme Alan Badge Extra Price" inherit_id="website_sale.badge_extra_price">
        <xpath expr="//span[@t-if='price_extra']" position="attributes">
            <attribute name="t-if" add=" not(request.env.user._is_public() and website.active_b2b_mode)" separator=" and "/>
        </xpath>
    </template>
    <template id="theme_alan_stick_cart" name="Theme Alan Stick Cart" inherit_id="theme_alan.as_product_stick_cart">
        <xpath expr="//div[contains(@t-attf-class, 'as_product_price')]" position="attributes">
            <attribute name="t-if"> not(request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('as_add_cart')]" position="attributes">
            <attribute name="t-if"> not(request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('as_add_cart')]" position="after">
            <t t-if="request.env.user._is_public() and website.active_b2b_mode" >
                <div id="as_sticky_scroll_top" class="as-s-btn as-s-scroll as_sticky_scroll_top">
                    <i class="fa fa-chevron-up"/>
                </div>
            </t>
        </xpath>
    </template>
    <template id="theme_alan_product_pager" name="Theme Alan Product Pager" inherit_id="theme_alan.as_product_customization">
        <xpath expr="//div[hasclass('as_pre_price')]" position="attributes">
            <attribute name="t-if"> not(request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('as_next_price')]" position="attributes">
            <attribute name="t-if"> not(request.env.user._is_public() and website.active_b2b_mode)</attribute>
        </xpath>
    </template>

</odoo>