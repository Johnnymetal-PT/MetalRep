<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- ==================== Shop Category Layout Options ==================== -->
    <t t-name="theme_alan.ProductsListPageCategoryOption" t-inherit="website_sale.ProductsListPageOption" t-inherit-mode="extension">
        <xpath expr="//BuilderRow[@label.translate='Style'][1]/BuilderSelect" position="inside">
            <BuilderSelectItem
                actionParam="{views: ['theme_alan.as_categories_style_1']}"
                title.translate="Alan Style 1"
            >
                <Img
                    src="'/theme_alan/static/src/img/snippets/snippets_icon/category1.svg'"
                    style="'width:120px;'"
                />
            </BuilderSelectItem>
            <BuilderSelectItem
                actionParam="{views: ['theme_alan.as_categories_style_2']}"
                title.translate="Alan Style 2"
            >
                <Img
                    src="'/theme_alan/static/src/img/snippets/snippets_icon/category2.svg'"
                    style="'width:120px;'"
                />
            </BuilderSelectItem>
            <BuilderSelectItem
                actionParam="{views: ['theme_alan.as_categories_style_3']}"
                title.translate="Alan Style 3"
            >
                <Img
                    src="'/theme_alan/static/src/img/snippets/snippets_icon/category3.svg'"
                    style="'width:120px;'"
                />
            </BuilderSelectItem>
            <BuilderSelectItem
                actionParam="{views: ['theme_alan.as_categories_style_4']}"
                title.translate="Alan Style 4"
            >
                <Img
                    src="'/theme_alan/static/src/img/snippets/snippets_icon/category4.svg'"
                    style="'width:120px;'"
                />
            </BuilderSelectItem>
            <BuilderSelectItem
                actionParam="{views: ['theme_alan.as_categories_style_5']}"
                title.translate="Alan Style 5"
            >
                <Img
                    src="'/theme_alan/static/src/img/snippets/snippets_icon/category5.svg'"
                    style="'width:120px;'"
                />
            </BuilderSelectItem>
        </xpath>
    </t>
</templates>
