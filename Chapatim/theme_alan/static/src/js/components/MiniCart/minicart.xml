            <p>Your Shopping Cart is empty</p>
            <div class="button">
                <a href="/shop" class="btn as-btn btn-primary">Shop Now</a>
            </div>
        </div>
    </t>

    <!-- ==================== Mini Cart Apply Coupon Template ==================== -->
    <t t-name="theme_alan.coupon_form">
        <form class="mb-3 mt-3" t-on-submit.prevent="applyCoupon">
            <div class="input-group w-100">
                <input name="promo"
                    class="form-control"
                    type="text"
                    placeholder="Gift card or discount code..."
                    t-att-value="state.promo_code || ''"
                    t-att-disabled="state.isProcessing"/>
                <button type="submit"
                    class="btn btn-light border"
                    t-att-disabled="state.isProcessing">
                    <t t-if="state.isProcessing">
                        <i class="fa fa-spinner fa-spin me-1"/>
                    </t>
                    Apply
                </button>
            </div>
        </form>

        <!-- Display error message -->
        <t t-if="state.coupon_error">
            <div class="alert alert-danger text-start small" role="alert">
                <t t-esc="state.coupon_error"/>
            </div>
        </t>

        <!-- Display success message -->
        <t t-if="state.coupon_success">
            <div class="alert alert-success text-start small" role="alert">
                You have successfully applied the following code: <strong t-esc="state.promo_code"/>
            </div>
        </t>
    </t>

    <!-- ==================== Mini Cart Coupon Rewards ==================== -->
    <t t-name="theme_alan.coupon_rewards_display">
        <t t-if="state.website_sale_order and state.website_sale_order.claimable_rewards and state.website_sale_order.claimable_rewards.length">
            <div class="mt-3">
                <t t-foreach="state.website_sale_order.claimable_rewards" t-as="coupon_reward" t-key="coupon_reward_index">
                    <t t-set="coupon" t-value="coupon_reward[0]"/>
                    <t t-set="rewards" t-value="coupon_reward[1]"/>
                    <t t-set="is_loyalty" t-value="rewards[0].program_id.program_type === 'loyalty'"/>

                    <!-- Loyalty Points Display -->
                    <div
                        t-if="is_loyalty"
                        class="alert alert-primary d-flex justify-content-between align-items-center mb-0 p-2 rounded-bottom-0"
                        role="alert"
                    >
                        <strong class="text-start small" t-esc="coupon.point_name"/>
                        <strong class="small" name="o_loyalty_points" t-esc="coupon.points"/>
                    </div>

                    <!-- Rewards List -->
                    <t t-foreach="rewards" t-as="reward" t-key="reward.id">
                        <form t-on-submit.prevent="claimReward"
                            class="o_claim_reward_form"
                            method="post">
                            <input type="hidden" name="reward_id" t-att-value="reward.id"/>
                            <input type="hidden" name="code" t-att-value="coupon.code"/>

                            <div t-attf-class="{{is_loyalty ? 'border border-primary-subtle border-top-0 p-2 text-start' : 'alert alert-primary p-2 text-start'}} {{is_loyalty and reward_last ? 'rounded-bottom mb-3' : 'mb-2'}}">
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="flex-grow-1 text-break">
                                        <t t-set="program" t-value="reward.program_id"/>
                                        <t t-set="is_auto_applied" t-value="reward.reward_type === 'product' and !reward.multi_product"/>
                                        <!-- Gift Card Display -->
                                        <t t-if="program.program_type === 'gift_card'">
                                            <strong class="small">
                                                <t t-esc="reward.description"/>
                                                <t t-if="coupon.points"> - <t t-esc="coupon.points"/></t>
                                            </strong>
                                            <div class="d-md-block small">
                                                <span t-if="coupon.code and !program.is_nominative">
                                                    Code: <t t-esc="'⋮'.repeat(10) + coupon.code.slice(-4)"/>
                                                </span>
                                                <t t-if="coupon.expiration_date">
                                                    <br/>
                                                    <span>
                                                        Expired Date: <t t-esc="coupon.expiration_date"/>
                                                    </span>
                                                </t>
                                            </div>
                                            <!-- Info message for auto-applied free products -->
                                            <div t-if="is_auto_applied" class="badge bg-success-subtle text-success mt-1">
                                                <i class="fa fa-check-circle me-1"></i>
                                                Free product added to cart
                                            </div>
                                        </t>

                                        <!-- Coupons Display -->
                                        <t t-elif="program.program_type === 'coupons'">
                                            <strong class="small">
                                                Coupons - <t t-esc="reward.description"/>
                                            </strong>
                                            <div t-if="is_auto_applied" class="badge bg-success-subtle text-success mt-1">
                                                <i class="fa fa-check-circle me-1"></i>
                                                Free product added to cart
                                            </div>
                                        </t>

                                        <!-- Promo Code Display -->
                                        <t t-elif="program.program_type === 'promo_code'">
                                            <strong class="small" t-esc="reward.description"/>
                                            <div t-if="is_auto_applied" class="badge bg-success-subtle text-success mt-1">
                                                <i class="fa fa-check-circle me-1"></i>
                                                Free product added to cart
                                            </div>
                                        </t>

                                        <!-- eWallet Display -->
                                        <t t-elif="program.program_type === 'ewallet'">
                                            <div class="d-flex justify-content-between align-items-center h-100 me-2">
                                                <strong class="small" t-esc="reward.description"/>
                                                <strong class="small">
                                                    <t t-esc="coupon.currency"/>
                                                    <t t-esc="coupon.points"/>
                                                </strong>
                                            </div>
                                        </t>

                                        <!-- Loyalty Display -->
                                        <t t-else="">
                                            <strong class="small" t-esc="reward.description"/>
                                            <div t-if="program.portal_visible">
                                                <t t-if="!program.is_nominative">
                                                    <span t-esc="coupon.points"/>
                                                </t>
                                                <small
                                                    t-elif="program.program_type !== 'ewallet'"
                                                    t-esc="reward.required_points + ' points'"
                                                />
                                            </div>
                                            <div t-if="is_auto_applied" class="badge bg-success-subtle text-success mt-1">
                                                <i class="fa fa-check-circle me-1"></i>
                                                Free product added to cart
                                            </div>
                                        </t>

                                        <!-- Multi-product selector (only if not auto-applied) -->
                                        <select
                                            t-if="reward.multi_product"
                                            class="o_select w-100 form-select form-select-sm css_attribute_select mt-2"
                                            name="product_id"
                                            t-att-disabled="state.isProcessing"
                                        >
                                            <option
                                                t-foreach="reward.reward_product_ids"
                                                t-as="product"
                                                t-att-value="product.id"
                                                t-key="product.id"
                                            >
                                                <t t-esc="product.display_name"/>
                                            </option>
                                        </select>
                                    </div>

                                    <!-- Claim/Use Button - Only show if not auto-applied or if multi-product -->
                                    <div class="d-flex align-items-center">
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-primary"
                                            name="o_loyalty_claim"
                                            t-att-disabled="state.isProcessing"
                                        >
                                            <t t-if="state.isProcessing">
                                                <i class="fa fa-spinner fa-spin"/>
                                            </t>
                                            <t t-elif="(program.trigger === 'with_code' and program.program_type !== 'promo_code') or (program.trigger === 'auto' and program.applies_on === 'future')">
                                                Use
                                            </t>
                                            <t t-else="">Claim</t>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </t>
                </t>
            </div>
        </t>
    </t>

</templates>
