<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ==================== Mini Cart Main Dialog Template ==================== -->
    <t t-name="theme_alan.Minicart">
        <div class="o_dialog">
            <div role="dialog" class="modal as-mini-cart-modal d-block" tabindex="-1">
                <div class="modal-dialog" role="document">
                    <div class="modal-content as-mc-sidepannel">
                        <div class="modal-header as-mc-head ">
                            <div class="as-mc-head-grid">
                                <h5>
                                    <!-- <i class="asi asi-shopping-bag"></i>  -->
                                    Your Cart <span class="text-primary">(<t t-esc="props.card_qty"/><t t-if="props.card_qty > 1"> items</t><t t-else=""> item</t>)</span>
                                </h5>
                                <span t-if="props.card_qty > 0" t-on-click="() => this.clearCart()" class="as_clr_cart">
                                    Clear Cart
                                </span>
                            </div>
                            <button type="button" class="btn-close" t-on-click="() => props.close()" aria-label="Close"/>
                        </div>
                        <div class="modal-body as-mc-body">
                            <t t-if="!props.card_qty">
                                <t t-call="theme_alan.as_empty_mini_cart"/>
                            </t>
                            <t t-else="">
                                <!-- <div class="as-mc-clear ">
                                    <p>
                                        You have
                                        <span><t t-esc="props.card_qty"/></span>
                                        <span>
                                            <t t-if="props.card_qty > 1"> items</t>
                                            <t t-else=""> item</t>
                                        </span>
                                        in your cart
                                    </p>
                                    <span t-if="props.card_qty > 0" t-on-click="() => this.clearCart()" class="as_clr_cart">
                                        Clear Cart
                                    </span>
                                </div> -->
                                <div class="as-mc-main">
                                    <ul class="as-mc-line-section oe_cart">
                                        <t t-foreach="state.product_lines" t-as="line" t-key="line.product_id">
                                            <MiniCartLine t-props="line" main_obj="this"/>
                                        </t>
                                    </ul>
                                    <!-- Suggested Products -->
                                    <t t-call="theme_alan.as_suggested_products"/>
                                    <!-- Cart Summary-->
                                    <t t-call="theme_alan.as_mini_cart_summary"/>
                                    <!-- Coupon code-->
                                    <div class="coupon-section p-3 pt-0">
                                            <t t-if="!state.showCouponForm">
                                                <button class="btn btn-link text-decoration-none p-0"
                                                t-on-click="toggleCouponForm"
                                                t-att-disabled="state.isProcessing">

                                                <i class="fa fa-tag me-1"></i> Have a coupon code?
                                                </button>
                                            </t>

                                        <div t-if="state.showCouponForm">
                                            <t t-call="theme_alan.coupon_form"/>
                                        </div>
                                        <t t-call="theme_alan.coupon_rewards_display"/>
                                    </div>
                                    <!-- Free Shipping Detail-->
                                    <t t-call="theme_alan.as_free_shipping_eligibility"/>

                                    <div class="as-mc-checkout-section">
                                        <a href="/shop/cart" class="btn as-btn btn-primary">View Cart</a>
                                        <a href="/shop/checkout" class="as-btn btn btn-secondary">Checkout</a>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ==================== Mini Cart Line (Product Row) Template==================== -->
    <t t-name="theme_alan.Minicartline">
        <li class="as-mc-product-line">
            <div class="as-mcl-img">
                <span>
                    <img t-att-src="props.image_url" alt="Product Image" style="width: 132px;"/>
                </span>
            </div>
            <div class="as-mcl-info">
                <h6><a t-att-href="props.website_url"><t t-out="props.line_header"/></a></h6>
                <!-- <div t-if="props.description_lines" class="text-muted small">
                    <t t-foreach="props.description_lines" t-as="name_line" t-key="name_line">
                        <span
                            t-if="name_line"
                            t-attf-class="d-block mb-1"
                            t-out="name_line"
                        />
                    </t>
                </div> -->
                <t t-if="props.combination_name or props.has_multiple_uoms">
                    <!-- <span>-</span>
                    <span
                        t-if="props.combination_name"
                        class="h6 text-muted mb-1"
                        t-out="props.combination_name"
                    /> -->
                    <span
                        t-if="props.has_multiple_uoms"
                        class="badge bg-light mb-1"
                        t-out="props.product_uom"
                    />
                </t>
                <div class="as-mcl-price">
                    <del
                        t-if="props.show_strikethrough_price"
                        class="me-md-2 text-muted text-nowrap opacity-50"
                        t-out="props.strikethrough_price"
                    />
                    <span t-if="props.formated_product_price" t-out="props.formated_product_price"/>
                </div>

                <div class="as-mcl-qty">
                    <div class="input-group css_quantity">
                        <!-- Decrease Quantity -->
                        <button
                            class="btn btn-secondary quantity-btn"
                            type="button"
                            aria-label="Decrease quantity"
                            t-att-disabled="disableRemove"
                            t-on-click="onDecreaseQuantity">
                            <i class="oi oi-minus" aria-hidden="true"></i>
                        </button>

                        <!-- Quantity Input -->
                        <input
                            class="form-control quantity-input text-center"
                            type="number"
                            name="sale_quantity"
                            t-att-value="state.add_quantity"
                            t-on-change="onQuantityInputChange"
                            min="1"
                        />

                        <!-- Increase Quantity -->
                        <button
                            class="btn btn-secondary quantity-btn"
                            type="button"
                            aria-label="Increase quantity"
                            t-on-click="onIncreaseQuantity">
                            <i class="oi oi-plus" aria-hidden="true"></i>
                        </button>
                    </div>
                    <a href='#' aria-label="Remove" title="Remove from cart" t-on-click="removeProduct" class='no-decoration as-mcl-remove'><i class='fa fa-trash-o'></i></a>
                    <a href='#' aria-label="Save For Later" title="Save For Later" t-on-click="saveForLater" class='as-mcl-save-later no-decoration'><i class='asi asi-heart'></i> <span>Save For Later</span></a>
                </div>
            </div>
            <div>

            </div>
        </li>
    </t>

    <!-- ==================== Mini Cart Suggested Products Carousel ==================== -->
    <t t-name="theme_alan.as_suggested_products">
        <t>
            <div class="as-mc-suggested" t-if="state.suggested_products and state.suggested_products.length">
                <div id="suggestedProductControls" class="carousel slide" data-bs-ride="carousel" >
                    <h5 class="as-mc-sp-title" t-if="state.suggested_products">Suggested Accessories</h5>
                    <div class="carousel-inner">
                        <t t-foreach="state.suggested_products" t-as="suggested_prod" t-key="suggested_prod.product_id">
                            <div t-attf-class="carousel-item {{suggested_prod_first ? 'active' : ''}}">
                                <div class="as-mc-sp-main">
                                    <div class="as-mc-sp-img">
                                        <a t-att-href="suggested_prod.website_url">
                                            <img class="w-30" t-att-src="suggested_prod.image_url" alt="Product Image" style="width: 132px;"/>
                                        </a>
                                    </div>
                                    <div class="as-mc-sp-info">
                                        <h6>
                                            <a t-att-href="suggested_prod.website_url"><t t-esc="suggested_prod.product_name"/></a>
                                        </h6>
                                        <div class="as-mc-sp-price">
                                            <h6 class="oe_price_h4 css_editable_mode_hidden">
                                                <del t-attf-class="text-danger mr8 {{suggested_prod.has_discounted_price ? '' : 'd-none'}}" t-esc="suggested_prod.list_price" style="white-space: nowrap;"/>
                                                <span t-esc="suggested_prod.price" style="white-space: nowrap;"/>
                                            </h6>
                                        </div>
                                        <div class="as-mc-sp-addtocart">
                                            <button
                                                class="btn btn-dark text-nowrap"
                                                name="sp_add_cart_button"
                                                t-att-id = "suggested_prod.product_id"
                                                t-on-click="() => this.addSuggestedProduct(suggested_prod.product_id, suggested_prod.product_tmpl_id)">
                                                <i class="asi asi-shopping-cart"/>
                                                <span>Add to cart</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <t t-if="state.suggested_products and state.suggested_products.length > 1">
                        <button class="carousel-control-prev" type="button" data-bs-target="#suggestedProductControls" data-bs-slide="prev">
                            <span class="oi oi-chevron-left oe_unmovable" role="img" aria-label="Previous" title="Previous"/>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#suggestedProductControls" data-bs-slide="next">
                            <span class="oi oi-chevron-right oe_unmovable" role="img" aria-label="Next" title="Next"/>
                        </button>
                    </t>
                </div>
            </div>
        </t>
    </t>

    <!-- ==================== Mini Cart Summary Template ==================== -->
    <t t-name="theme_alan.as_mini_cart_summary">
        <div class="as-mc-summary">
            <div class="as-mc-summary-inner" t-if="state.cart_summary and state.product_lines">
            <table class="table mb-0">
                <tr id="order_delivery" t-if="state.cart_summary.amount_delivery and state.cart_summary.carrier_id">
                    <td colspan="2" class="ps-0 pt-0 pb-2 border-0 text-muted"
                        title="Delivery will be updated after choosing a new delivery method">
                        Delivery
                    </td>
                    <td class="text-end pe-0 pt-0 pb-2 border-0 text-muted">
                        <span t-esc="state.cart_summary.amount_delivery"
                            class="monetary_field"
                            style="white-space: nowrap;"/>
                    </td>
                </tr>
                <tr t-if="state.cart_summary.reward_amount">
                    <td colspan="2" class="ps-0 pt-0 pb-2 border-0 text-muted">
                        Discount:
                    </td>
                    <td class="text-end pe-0 pt-0 pb-2 border-0 text-muted">
                        <span t-esc="state.cart_summary.reward_amount"
                            class="monetary_field"
                            style="white-space: nowrap;"/>
                    </td>
                </tr>
                <tr t-if="state.cart_summary.amount_untaxed">
                    <td id="cart_total_subtotal"
                        class="border-0 pb-2 ps-0 pt-0 text-start text-muted"
                        colspan="2">
                        Subtotal
                    </td>
                    <td class="text-end border-0 pb-2 pe-0 pt-0">
                        <span t-esc="state.cart_summary.amount_untaxed"
                              class="monetary_field"
                              style="white-space: nowrap;"/>
                    </td>
                </tr>
                <tr t-if="state.cart_summary.amount_tax">
                    <td colspan="2" class="text-muted border-0 ps-0 pt-0 pb-3">Taxes</td>
                    <td class="text-end border-0 pe-0 pt-0 pb-3">
                        <span t-esc="state.cart_summary.amount_tax"
                              class="monetary_field"
                              style="white-space: nowrap;"/>
                    </td>
                </tr>
                <tr t-if="state.cart_summary.amount_total" class="border-top">
                    <td colspan="2" class="border-0 ps-0 pt-3"><strong>Total</strong></td>
                    <td class="text-end border-0 px-0 pt-3">
                        <strong t-esc="state.cart_summary.amount_total"
                                class="monetary_field text-end p-0"/>
                    </td>
                </tr>
            </table>
        </div>
        </div>
    </t>

