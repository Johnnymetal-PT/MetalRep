<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ==================== Product Queries Dialog Template ==================== -->
    <t t-name="theme_alan.ProductQueries">
        <div class="o_dialog">
            <div role="dialog" t-attf-class="modal d-block" tabindex="-1">
                <div class="modal-dialog" role="document">
                    <div class="modal-content queries-container alan-ask-queries">
                        <div class="modal-header align-items-start">
                            <div class="flex-fill">
                                <h5><t t-esc="props.dialog_header"/></h5>
                                <p class="mb-0"><t t-esc="props.dialog_header_desc"/></p>
                            </div>
                            <button type="button" class="btn-close" t-on-click="() => this.props.close()" aria-label="Close"></button>
                        </div>
                        <div class="modal-body ">
                            <div class="row gy-3 gx-2">
                                <div class="col-md-12">
                                    <label class="form-label small">Your Name</label>
                                    <input id="customer" name="customer_name" type="text" class="form-control website_form_input name" placeholder="Your Name" t-att-value="state.name" t-att-readonly="!props.is_public_user ? 'readonly' : null" t-on-keyup="() => this._onChangeInput()"/>
                                    <input id="customer_id" name="customer_id" type="hidden" t-att-value="props.user_id"/>
                                </div>
                                <!-- Email: visible when Email or Both is selected -->
                                <t t-if="state.contact_preference === 'Email' || state.contact_preference === 'Both'">
                                    <div class="col-md-12">
                                        <label class="form-label small">Your Email</label>
                                        <input id="email" name="customer_email" type="text" class="form-control website_form_input email" placeholder="Your Email" t-att-value="state.email" t-on-keyup="() => this._onChangeInput()"/>
                                        <small class="email-error text-danger mt-1" style="display:none"></small>
                                    </div>
                                </t>
                                <!-- Phone: visible when Phone or Both is selected -->
                                <t t-if="state.contact_preference === 'Phone' || state.contact_preference === 'Both'">
                                    <div class="col-md-12">
                                        <label class="form-label small">Your Phone</label>
                                        <input id="phone" name="customer_phone" type="tel" class="form-control website_form_input phone" placeholder="Your Phone Number" maxlength="20" inputmode="tel" t-on-keyup="() => this._onChangeInput()" t-att-value="state.phone"/>
                                        <small class="phone-error text-danger mt-1" style="display:none"></small>
                                    </div>
                                </t>
                                <div class="col-12">
                                    <label class="form-label small">What Can I Help You With Today?</label>
                                    <textarea id="message" name="customer_inquiry" type="text" class="form-control website_form_input msg" rows="3" placeholder="Message" t-on-keyup="() => this._onChangeInput()"><t t-esc="state.message"/></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small">How Would You Like Me To Contact You?</label>
                                    <div class="contact_info d-flex gap-2">
                                        <div>
                                            <input class="btn-check ContactPreference" type="radio" name="ContactPreference" id="Email" checked="checked" t-on-change="(ev) => this.onContactPreferenceChange(ev)"/>
                                            <label class="btn btn-outline-primary btn-sm" for="Email">
                                                Email
                                            </label>
                                        </div>
                                        <div>
                                            <input class="btn-check ContactPreference" type="radio" name="ContactPreference" id="Phone" t-on-change="(ev) => this.onContactPreferenceChange(ev)"/>
                                            <label class="btn btn-outline-primary btn-sm" for="Phone">
                                                Phone
                                            </label>
                                        </div>
                                        <div>
                                            <input class="btn-check ContactPreference" type="radio" name="ContactPreference" id="Both" t-on-change="(ev) => this.onContactPreferenceChange(ev)"/>
                                            <label class="btn btn-outline-primary btn-sm" for="Both">
                                                Both
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button type="button" class="btn btn-dark w-100" t-on-click="(ev) => this.send_queries(ev)">SEND QUESTIONS</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="thank-you" class="o_hidden modal-content text-center py-4">
                        <h1 class="text-success"><t t-esc="props.acknowledgement_message"/></h1>
                        <p>Your form is submitted successfully.</p>
                    </div>
                    <div id="error-message" class="o_hidden modal-content text-center py-4">
                        <h1 class="text-danger">Error</h1>
                        <p class="error-text"></p>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
