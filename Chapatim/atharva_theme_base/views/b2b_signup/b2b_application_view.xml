<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_b2b_application_list" model="ir.ui.view">
        <field name="name">b2b.application.list</field>
        <field name="model">b2b.application</field>
        <field name="arch" type="xml">
            <list string="B2B Applications">
                <field name="create_date"/>
                <field name="create_uid" string="Created By"/>
                <field name="name"/>
                <field name="business_name"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="state" widget="badge" decoration-success="state=='approved'" decoration-danger="state=='rejected'" decoration-info="state== 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_b2b_application_form" model="ir.ui.view">
        <field name="name">b2b.application.form</field>
        <field name="model">b2b.application</field>
        <field name="arch" type="xml">
            <form string="B2B Application">
                <header>
                    <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        invisible="state in ('approved','rejected')"/>

                <button name="action_reject"
                        string="Reject"
                        type="object"
                        invisible="state in ('approved', 'rejected')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Business Owner Information">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Business Information">
                            <field name="business_name"/>
                            <field name="business_number"/>
                            <field name="business_type_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Business Address">
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': country_id}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </group>
                        <group string="Related Partner Info"  invisible="state not in ('approved')">
                            <field name="partner_id" readonly="1"/>
                            <field name="property_product_pricelist"/>
                        </group>

                    </group>
                    <group string="Documents">
                        <field name="document_filename" invisible="1"/>
                        <field name="document_attachment" filename="document_filename"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <group string="Terms and Conditions">
                        <field name="terms_and_conditions" readonly="1"/>
                        <field name="terms_accepted" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_b2b_application_search" model="ir.ui.view">
        <field name="name">b2b.application.search</field>
        <field name="model">b2b.application</field>
        <field name="arch" type="xml">
            <search string="B2B Applications">
                <field name="name"/>
                <field name="first_name"/>
                <field name="business_name"/>
                <field name="email"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_b2b_form" model="ir.actions.act_window">
        <field name="name">B2B Applications</field>
        <field name="res_model">b2b.application</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first B2B Application
            </p>
            <p>
                Track and manage B2B business applications from your website.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_b2b_application_root" name="B2B Application" sequence="5"  web_icon="atharva_theme_base,static/description/B2b.png" groups="atharva_theme_base.group_b2b_admin" />
    <menuitem id="menu_b2b_application_all" name="All Application" parent="atharva_theme_base.menu_b2b_application_root" action="action_b2b_form" sequence="1" groups="atharva_theme_base.group_b2b_admin" />
</odoo>
