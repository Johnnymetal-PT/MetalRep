<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Sales Count Configuration -->
    <record id="res_config_settings_view_form_product_sales_count" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.website.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_payment_block" position="inside">
                <setting id="product_sales_count_config" string="Product Sales Count Configuration" help="Configure the settings for displaying product sales count on product pages.">
                    <field name="active_last_month_count"/>
                    <div class="content-group" invisible="not active_last_month_count">
                        <div class="row mt16">
                            <label class="o_light_label col-lg-3" string="Time Frame" for="time_range"/>
                            <field name="time_range"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
