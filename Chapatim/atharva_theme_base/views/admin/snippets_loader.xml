<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dynamic Snippet Builder Loader -->
    <record id="res_config_settings_view_form_dynamic_snippet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.snippet.loader.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <block id="website_settings" position="before">
                <block title="Snippets Loader" id="snippet_loader_settings">
                    <setting string="Dynamic Snippet Loader" help="Snippets Loader is used to load snippets in the website builder.">
                        <field name="snippets_loader" widget="image" class="float-start oe_avatar bg-view"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
