<odoo>
    <record id="view_hiper_sync_run_list" model="ir.ui.view">
        <field name="name">hiper.sync.run.list</field>
        <field name="model">hiper.sync.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="current_phase"/>
                <field name="progress_percent" widget="progressbar"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="total_records"/>
                <field name="published_records"/>
                <field name="skipped_records"/>
                <field name="error_records"/>
            </list>
        </field>
    </record>

    <record id="view_hiper_sync_run_form" model="ir.ui.view">
        <field name="name">hiper.sync.run.form</field>
        <field name="model">hiper.sync.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_now" string="Process Now" type="object" class="btn-primary" invisible="state not in ('queued', 'paused')"/>
                    <button name="action_pause_run" string="Pause" type="object" class="btn-secondary" invisible="state not in ('queued', 'running')"/>
                    <button name="action_cancel_run" string="Cancel" type="object" class="btn-secondary" invisible="state not in ('draft', 'queued', 'running', 'paused')"/>
                    <button name="action_force_cancel_run" string="Force Stop" type="object" class="btn-secondary" invisible="state not in ('running', 'queued', 'paused')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="progress_percent" widget="progressbar" readonly="1"/>
                        <field name="progress_note" readonly="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="current_phase"/>
                            <field name="current_vendor_id" readonly="1"/>
                            <field name="current_item_label" readonly="1"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration_seconds" readonly="1"/>
                            <field name="eta_seconds" readonly="1"/>
                            <field name="progress_updated_at" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="pause_requested" readonly="1"/>
                            <field name="cancel_requested" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_vendors" readonly="1"/>
                            <field name="processed_vendors" readonly="1"/>
                            <field name="planned_records" readonly="1"/>
                            <field name="processed_records" readonly="1"/>
                            <field name="total_records" readonly="1"/>
                            <field name="published_records" readonly="1"/>
                            <field name="skipped_records" readonly="1"/>
                            <field name="error_records" readonly="1"/>
                        </group>
                    </group>
                    <field name="vendor_ids" widget="many2many_tags"/>
                    <field name="notes"/>
                    <field name="line_ids">
                        <list>
                            <field name="state"/>
                            <field name="vendor_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="match_method"/>
                            <field name="ean13"/>
                            <field name="reference"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="publish_note"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
