<div class="product-additional-info">
  <ul>
    <li class="shipping-time">
      <i class="ti-timer"></i>
      <span fsdata="shipping-time">
        <strong>{l s='Buy today' mod='fusion'}</strong>
        {l s='and' mod='fusion'}
        <strong>{l s='receive' mod='fusion'}</strong>
        {l s='between' mod='fusion'}
        <strong>{$delivery_estimate}</strong>
      </span>
    </li>

    <li class="shipping-cost">
      <i class="ti-truck"></i>
      <span><strong>{l s='Free shipping' mod='fusion'}</strong> {l s='on orders over' mod='fusion'} <strong>{$free_shipping_over_value}</strong> </span>
    </li>

    <li class="returns">
      <i class="ti-reload"></i>
      <span>
        <strong>{l s='Returns' mod='fusion'}</strong> {l s='until 15 days' mod='fusion'}
        <a class="returns-link" href="#help"><i class="ti-info-alt"></i></a>
      </span>
    </li>

    <li class="help">
      <i class="ti-email"></i>
      <span> <a href="#helpform">{l s='You need help?' mod='fusion'}</a> </span>
    </li>

  </ul>
</div>