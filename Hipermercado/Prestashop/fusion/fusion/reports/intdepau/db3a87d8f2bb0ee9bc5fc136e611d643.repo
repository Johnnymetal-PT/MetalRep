al 7200 rpm LFF RW con garant\u00eda de 1 a\u00f1o y de m\u00faltiples proveedores<\/li><li><b>Tipo de unidad \u00f3ptica<\/b><\/li><li>Kit de bah\u00eda ODD opcional, no incluido<\/li><li><b>Seguridad<\/b><\/li><li>M\u00f3dulo de plataforma confiable (TPM) 2.0<\/li><li><b>Gesti\u00f3n de infraestructura<\/b><\/li><li>HPE iLO6, puerto iLO dedicado incluido<\/li><li><b>Tipo de fuente de alimentaci\u00f3n<\/b><\/li><li>1 adaptador de corriente externo de 180 W, fuente de alimentaci\u00f3n no redundante<\/li><li><b>Ranuras de expansi\u00f3n<\/b><\/li><li>2 PCIe, para obtener descripciones detalladas, consulte las especificaciones r\u00e1pidas<\/li><li><b>Controlador de red<\/b><\/li><li>4x1Gbe integrado<\/li><li><b>Controlador de almacenamiento<\/b><\/li><li>RAID de software SATA Intel VROC integrado<\/li><li><b>Caracter\u00edsticas del ventilador del sistema<\/b><\/li><li>1 ventilador de sistema no redundante incluido de serie<\/li><li><b>Factor de forma<\/b><\/li><li>Torre ultramicro<\/li><li><b>Dimensiones del producto (m\u00e9tricas)<\/b><\/li><li>37,7 x 46,7 x 25,54 cm<\/li><li><b>Peso<\/b><\/li><li>7,97 kilos<\/li><\/ul><\/p><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HEWLETT PACKARD ENTERPRISE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":1551.35,"unit_price_tax":1551.35,"tax_rules_group":null,"category":"Servidores","sub_category":"Servidores","quantity":0,"brand":"HEWLETT PACKARD ENTERPRISE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hps-p75207-425_1.jpg"],"wholesale_price":1544.35}}},"4549821622740":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4549821622740",false