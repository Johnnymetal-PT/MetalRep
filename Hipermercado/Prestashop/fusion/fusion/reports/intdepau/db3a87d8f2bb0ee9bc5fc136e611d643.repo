ng>1x Ranura SD y 1x Ranura TF:<\/strong><\/li><li>La ranura SD soporta tarjetas SDXC, SDHC, SD, MMC, RS-MMC<\/li><li>La ranura TF soporta tarjetas Micro SDXC, Micro SD, Micro SDHC<\/li><li>El lector de tarjetas admite una sola tarjeta por ranura a la vez. Si se insertan tarjetas en ambas ranuras, el lector solo leer\u00e1 la primera tarjeta insertada.<\/li><\/ul><\/p><h2>Especificaciones<\/h2><p><ul><li><strong>Longitud:<\/strong> 15cm<\/li><li><strong>Color:<\/strong> Gris<\/li><li><strong>Normativas:<\/strong> RoHS, CE<\/li><li><strong>Test de funcionamiento:<\/strong> 100% testeado<\/li><li><strong>Contenido del Paquete:<\/strong><\/li><li>1 x USB-C Dock 7 en 1<\/li><li>1 x Manual de Usuario Multi-idioma<\/li><\/ul><\/p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AISENS","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":17.08,"unit_price_tax":17.08,"tax_rules_group":null,"category":"Accesorios de Portatiles","sub_category":"Dockstations","quantity":0,"brand":"AISENS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-hub%20asuc-7p025-gr_1.jpg"],"wholesale_price":10.08}}},"8435739903155":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435739903155",false],"wholesale_price":[10.38,false],"price":[17.38,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:270046","Cat. IDs: 89","Associated Categories","Cat. Defa