on cable); 64 g (sin cable)<\/li>\t<li><b>Peso del empaque:<\/b> 300 g<\/li>\t<li><b>Peso del pallet:<\/b> 357 kg<\/li>\t<li><b>Contenido de la caja:<\/b> Auriculares; Cable USB Tipo-C; Adaptador USB Tipo-C\u00ae a USB Tipo-A<\/li>\t<li><b>Garant\u00eda del fabricante:<\/b> Garant\u00eda limitada est\u00e1ndar de dos a\u00f1os de Poly<\/li><\/ul><p><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"POLY","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":23.86,"unit_price_tax":23.86,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":0,"brand":"POLY","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hp-pol%208x214a6_1.jpg"],"wholesale_price":16.86}}},"0197498429014":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0197498429014",false],"wholesale_price":[20.34,false],"price":[27.34,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.2",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:270130","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/1965a28feffae44f0878f6e1397b38c6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auricular Poly Blackwire 3310 para Microsoft Teams + Adaptador USB-C\/A\/ con Micr\u00f3fono\/ USB Tipo-C\/ Negro","category":"Auriculares","sub