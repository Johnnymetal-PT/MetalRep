":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":67.34,"unit_price_tax":67.34,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares Bluetooth con estuche de carga","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-aur%20buds%205%20bk_1.jpg"],"wholesale_price":62.34}}},"6941812768464":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812768464",false],"wholesale_price":[62.34,false],"price":[67.34,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:219980","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/75ae8bc43b3cfba068823bf77787bfbc.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Bluetooth Xiaomi Buds 5 con estuche de carga\/ Blancos","category":"Auriculares","sub_category":"Auriculares Bluetooth con estuche de carga","unit_price":67.34,"reference":"BHR8117GL","ean13":"6941812768464","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"                                                                                                                                                ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-aur%20buds%205%20wh_1.jpg","wholesale_price":"62.34","unit_price_tax":67.34},"product_model":{"product_data":{"ean13":["6941812768464"],"reference":"BHR8117GL","name":{"1":"Auriculares Bluetooth Xiaomi Buds 5 con estuche de carga\/ Blancos","2":"","3":"","4":""},"description":{"1":"                                                                                                                                                ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":67.34,"unit_price_tax":67.34,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares Bluetooth con estuche de carga","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-aur%20buds%205%20wh_1.jpg"],"wholesale_price":62.34}}},"8436609912017":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436609912017",false],"wholesale_price":[29.78,false],"price":[34.78,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:219981","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e5899e994c41995d8ff32482045ce327.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Inal\u00e1mbricos SPC Heron 2 Studio\/ con Micr\u00f3fono\/ Bluetooth\/ Negros","category":"Auriculares","sub_category":"Auriculares","unit_price":34.78,"reference":"4628T","ean13":"8436609912017","weight":"0.3","quantity":2,"brand":"SPC","description_pt":"                                                <p><h2>SPC HERON 2 STUDIO<\/h2><div><p>Auriculares On - Ear inal\u00e1mbricos, sostenibles y disponibles en 3 colores. Con conexi\u00f3n simult\u00e1nea a dos dispositivos Bluetooth, 50 h de autonom\u00eda y botonera integrada.<\/p><p><ul><li>Diadema ajustable y auriculares plegables<\/li><li>Regulables y totalmente acolchados<\/li><li>Ligeros: solo 150 gr.<\/li><li>Audio sublime<\/li><li>Driver de 40 mm y neodimio<\/li><li>Gran autonom\u00eda: 50 horas de reproducci\u00f3n<\/li><li>Carga r\u00e1pida: 4h de m\u00fasica con 10 minutos de carga<\/li><li>Conexi\u00f3n simult\u00e1nea a dos dispositivos<\/li><li>Modo de juego: Menor latencia<\/li><li>Conexi\u00f3n Bluetooth 5.4 con alcance hasta 45m<\/li><li>Disponibles en 3 colores<\/li><li>Sostenibles: 60% material reciclado<\/li><\/ul><\/p><h2>Como una extensi\u00f3n de tu cuerpo<\/h2><p>HERON 2 STUDIO son los auriculares ligeros y c\u00f3modos, con diadema ajustable y totalmente acolchados que ni notas ni te cansas de llevar.<\/p><p>Se adaptan al contorno de la cabeza con suavidad y se apoyan sobre las orejas para llevarte, con mimo, la m\u00fasica que te llena durante muchas, muchas horas.<\/p><h2>Que no te enga\u00f1e su ligereza<\/h2><p>Puede ser dif\u00edcil de creer, pero en apenas 150 gr. de peso se esconden dos diafragmas de 40 mm fabricados en neodimio.<\/p><p>Este material es m\u00e1s potente que el utilizado tradicionalmente y ofrece mejor vibraci\u00f3n a la membrana y 8 o 10 veces m\u00e1s potencia para proporcionar un sonido definido, sin distorsiones y con graves contundentes.<\/p><h2>Perfectos para los despreocupados<\/h2><p>Tienen una bater\u00eda de 380 mAh que ofrece una gran autonom\u00eda de 50 horas y apagado autom\u00e1tico al detectar inactividad o desconexi\u00f3n Bluetooth.<\/p><p>Y, adem\u00e1s, si vas a salir y no hiciste caso a los avisos de bater\u00eda baja, basta con cargarlos 10 minutos para conseguir 4 horas de autonom\u00eda.<\/p><p>Si ni a eso te da tiempo, aqu\u00ed va otra soluci\u00f3n: con\u00e9ctalos a tu m\u00f3vil por cable USB-C para obtener una transferencia de bater\u00eda.<\/p><h2>Llegan lejos, muy lejos<\/h2><p>Gracias a la conexi\u00f3n Bluetooth 5.4 y al amplio alcance de hasta 45m, puedes dejar el m\u00f3vil lejos de ti para evitar la tentaci\u00f3n de revisarlo mientras escuchas los \u00faltimos \u00e9xitos de Spotify, o hacer una llamada mientras caminas libremente sin miedo a perder la conexi\u00f3n.<\/p><p>Y si algo de verdad los ha llevado lejos, es su capacidad de adaptaci\u00f3n. Se pliegan y se ajustan para caber en cualquier peque\u00f1o espacio de tu bolso, mochila o maleta. No hay excusas: ll\u00e9valos contigo siempre que quieras.<\/p><h2>Da el salto y sigue escuchando<\/h2><p>Ahora escuchas un videotutorial en la tablet, ahora un audio en el m\u00f3vil. Y sin hacer ajustes.<\/p><p>Ahora oyes un podcast desde el PC, ahora atiendes esa llamada. Y sin hacer cambios.<\/p><p>La posibilidad de conectarlos a dos dispositivos Bluetooth a la vez te da la opci\u00f3n de saltar entre ellos y escuchar en cada momento lo que quieres de uno y de otro.<\/p><p>Y si das el salto a los videojuegos, activa el modo juego para minimizar la latencia y lograr un menor retraso entre la creaci\u00f3n del sonido y cuando se escucha.<\/p><h2>Iguales por dentro, diferentes por fuera<\/h2><p>\u00bfEl pac\u00edfico DEEP SKY, el siempre combinable SUPERNOVA WHITE o el cl\u00e1sico y discreto DARK MATTER?<\/p><p>Elige el color m\u00e1s af\u00edn a tu personalidad y al\u00edate con la botonera integrada en el auricular derecho para controlar todo lo que llega a tus o\u00eddos.<\/p><p>\u00bfLo tienes claro? Pues dale al PLAY. Las 50h de m\u00fasica empiezan en 3, 2, 1&#8230;<\/p><h2>Estos auriculares escuchan al planeta<\/h2><p>Adem\u00e1s de confortable, el dise\u00f1o es respetuoso con el medio ambiente, ya que se ha fabricado con 60% de materiales reciclados y la caja protectora es de papel 100% reciclado y 100% reciclable.<\/p><p>Adem\u00e1s, hemos introducido el producto plegado. De esta forma, se necesita una caja m\u00e1s peque\u00f1a y disminuimos la cantidad de papel necesario para su creaci\u00f3n.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li><b>Datos t\u00e9cnicos y conexi\u00f3n<\/b><\/li><li>Perfiles - HSP, HFP, A2DP, AVRCP<\/li><li>Carga - USB-C<\/li><li>Bluetooth - 5.4<\/li><li>Otros - Manos libres. Asistente de voz. Conectividad con dos dispositivos simult\u00e1neamente. Sincronizaci\u00f3n autom\u00e1tica. Control de bot\u00f3n. Alcance m\u00e1ximo 45m.<\/li><li><b>Bater\u00eda y carga<\/b><\/li><li>Bater\u00eda - 380mAh<\/li><li>Autonom\u00eda total - 50 H<\/li><li><b>Caracter\u00edsticas generales<\/b><\/li><li>Llamadas - S\u00ed<\/li><li>Asistentes de voz - S\u00ed<\/li><li>ENC - No<\/li><li>ANC - No<\/li><li>Modo de Juego - S\u00ed<\/li><li>Conexi\u00f3n Autom\u00e1tica - S\u00ed<\/li><li><b>Dimensiones y peso<\/b><\/li><li>Altura - 180.6 mm<\/li><li>Anchura - 147 mm<\/li><li>Profundidad - 70,7 mm<\/li><li>Peso - 150 g<\/li><li><b>Contenido de la caja<\/b><\/li><li>SPC Heron 2 Studio, cable de carga USB-C y gu\u00eda r\u00e1pida.<\/li><\/ul><\/p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-aur%20heron%202%20studio%20bk_1.jpg","wholesale_price":"29.78","unit_price_tax":34.78},"product_model":{"product_data":{"ean13":["8436609912017"],"reference":"4628T","name":{"1":"Auriculares Inal\u00e1mbricos SPC Heron 2 Studio\/ con Micr\u00f3fono\/ Bluetooth\/ Negros","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>SPC HERON 2 STUDIO<\/h2><div><p>Auriculares On - Ear inal\u00e1mbricos, sostenibles y disponibles en 3 colores. Con conexi\u00f3n simult\u00e1nea a dos dispositivos Bluetooth, 50 h de autonom\u00eda y botonera integrada.<\/p><p><ul><li>Diadema ajustable y auriculares plegables<\/li><li>Regulables y totalmente acolchados<\/li><li>Ligeros: solo 150 gr.<\/li><li>Audio sublime<\/li><li>Driver de 