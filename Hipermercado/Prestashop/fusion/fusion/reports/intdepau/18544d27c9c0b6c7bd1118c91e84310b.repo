dn2.depau.es\/articulos\/800\/800\/fixed\/art_apa-microsd%2064gb%20ap64gmcsx1_1.jpg"],"wholesale_price":4.4}}},"6941812775004":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812775004",false],"wholesale_price":[42.18,false],"price":[47.18,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:220674","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/4088e66406e80813e200e22ce0653138.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara de Videovigilancia Xiaomi Outdoor Camera BW300\/ 2K\/ 130\u00ba\/ Visi\u00f3n Nocturna\/ Control desde APP","category":"Videovigilancia","sub_category":"Camaras Videovigilancia","unit_price":47.18,"reference":"BHR8303GL","ean13":"6941812775004","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"                                                <p><\/p><h2>Resoluci\u00f3n 2K para una calidad de imagen mejorada<\/h2><p>La c\u00e1mara de 3 MP produce im\u00e1genes m\u00e1s finas y captura claramente cada detalle din\u00e1mico, brind\u00e1ndole una vista exterior completa.<\/p><p><\/p><h2>Vistas claras en una variedad de escenarios<\/h2><p>Matr\u00edculas de veh\u00edculos a distancia\/Mensajeros de reparto a domicilio\/Ni\u00f1os jugando en la puerta<\/p><p><\/p><h2>No te pierdas ning\u00fan detalle ni tengas un punto ciego con un campo de visi\u00f3n amplio de 130\u00b0<\/h2><p>La gran apertura f\/1.6 permite una mayor entrada de luz para obtener im\u00e1genes m\u00e1s claras. El campo de visi\u00f3n de 130\u00b0 ofrece una visi\u00f3n completa y detallada de un vistazo, al tiempo que minimiza los puntos ciegos.<\/p><h2>Visi\u00f3n nocturna inteligente a todo color para una visibilidad clara en condiciones de poca luz<\/h2><p>Ilumina de forma inteligente escenas nocturnas con poca luz y captura cualquier actividad anormal con claridad con luces infrarrojas y LED de alta potencia.<\/p><p><b>Habilitar el modo de visi\u00f3n nocturna en blanco y negro<\/b><\/p><p>En el modo de visi\u00f3n nocturna, active los infrarrojos para obtener una visi\u00f3n m\u00e1s brillante.<\/p><p><\/p><p><b>Habilitar el modo de visi\u00f3n nocturna a todo color<\/b><\/p><p>En el modo de visi\u00f3n nocturna, enciende la luz blanca para ver los detalles con mayor claridad.<\/p><p><\/p><h2>Bater\u00eda supergrande de 4900 mAh para un uso duradero y sin preocupaciones<\/h2><p>Una combinaci\u00f3n de filtrado de algoritmos locales y arquitectura de bajo consumo reduce el consumo de energ\u00eda y prolonga la vida \u00fatil de la bater\u00eda, duplicando efectivamente su protecci\u00f3n.<\/p><h2>Resistencia profesional al agua y al polvo IP67 para soportar duras condiciones exteriores.<\/h2><p>Con una impermeabilidad excepcional, la c\u00e1mara protege contra la entrada de polvo para garantizar un rendimiento estable incluso en condiciones clim\u00e1ticas adversas, brindando una protecci\u00f3n segura y confiable para su hogar.<\/p><h2>La captura de movimiento con tecnolog\u00eda de inteligencia artificial rastrea cada sombra en movimiento<\/h2><p>Despu\u00e9s de detectar autom\u00e1ticamente un objeto en movimiento, se activan el seguimiento y el disparo inteligentes para preservar instant\u00e1neamente la trayectoria de movimiento del objeto con mayor detalle.<\/p><h2>Audio bidireccional perfecto con sonido claro incluso en entornos ruidosos<\/h2><p>El micr\u00f3fono incorporado de alta sensibilidad capta con precisi\u00f3n las voces humanas en un radio de 7 metros y reduce el ruido de fondo para ofrecer un audio claro y potente.<\/p><h2>Las advertencias auditivas y visuales alejan a los visitantes no deseados<\/h2><p>Cuando se detecta un intruso, el sistema activa una alarma y luces para asustarlo, reduciendo posibles riesgos de seguridad.<\/p><h2>Mant\u00e9ngase informado con alertas instant\u00e1neas que le notifican sobre actividad anormal y actualizaciones del hogar en tiempo real.<\/h2><p>Cuando est\u00e1s fuera de casa y surge una situaci\u00f3n anormal, la aplicaci\u00f3n Mi Home\/Xiaomi Home env\u00eda r\u00e1pidamente un mensaje a tu tel\u00e9fono inteligente para mantenerte informado.<\/p><h2>Transmisi\u00f3n de video totalmente encriptada para proteger su seguridad y privacidad<\/h2><p>El chipset de seguridad MJA1 y el algoritmo de cifrado AES-128 act\u00faan como un escudo de seguridad para proteger sus datos y mantenerlos privados en todo momento.<\/p><h2>Integraci\u00f3n multiplataforma de Smart Link con Google Home y Alexa<\/h2><p>Cuando se conecta a las pantallas Google Home o Alexa, puedes estar atento a todo lo que te importa, en cualquier momento.<\/p><h2>Recordatorio gratuito de emergencias en tiempo real con im\u00e1genes para una f\u00e1cil visualizaci\u00f3n<\/h2><p>Si la membres\u00eda de Xiaomi Cloud Storage Pro no est\u00e1 abierta, tambi\u00e9n enviar\u00e1 un mensaje de advertencia cuando se active el evento y proporcionar\u00e1 3 im\u00e1genes y un servicio de almacenamiento continuo de 7 d\u00edas para ver la situaci\u00f3n de monitoreo en tiempo real.<\/p><h2>Instalaci\u00f3n flexible para una monitorizaci\u00f3n personalizada en cualquier entorno exterior<\/h2><p>La base de la c\u00e1mara se fija con tornillos para facilitar su instalaci\u00f3n. Si se combina con una base giratoria, el \u00e1ngulo de visi\u00f3n se puede ajustar seg\u00fan sea necesario.<\/p><h2><br><\/h2><h2>Especificaciones del producto<\/h2><p><\/p><ul><li>Resoluci\u00f3n: 2K<\/li><li>Capacidad de la bater\u00eda: 4900 mAh<\/li><li>\u00c1ngulo de visi\u00f3n: D130\u00b0<\/li><li><b>Contenido del paquete<\/b><\/li><li>C\u00e1mara de v\u00eddeo x1<\/li><li>Manual de usuario x1<\/li><li>Soporte x1<\/li><li>Plantilla de montaje adhesiva x1<\/li><li>Cable de carga x1<\/li><li>Pegatina de advertencia x1<\/li><li>Tornillos x4<\/li><li>Tornillos de expansi\u00f3n x4<\/li><\/ul><p><\/p><p><\/p><p><\/p><p><\/p><p><\/p><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-cam%20out%20cam%20bw300_1.jpg","wholesale_price":"42.18","unit_price_tax":47.18},"product_model":{"product_data":{"ean13":["6941812775004"],"reference":"BHR8303GL","name":{"1":"C\u00e1mara de Videovigilancia Xiaomi Outdoor Camera BW300\/ 2K\/ 130\u00ba\/ Visi\u00f3n Nocturna\/ Control desde APP","2":"","3":"","4":""},"description":{"1":"                                                <p><\/p><h2>Resoluci\u00f3n 2K para una calidad de imagen mejorada<\/h2><p>La c\u00e1mara de 3 MP produce im\u00e1genes m\u00e1s finas y captura claramente cada detalle din\u00e1mico, brind\u00e1ndole una vista exterior completa.<\/p><p><\/p><h2>Vistas claras en una variedad de escenarios<\/h2><p>Matr\u00edculas de veh\u00edculos a distancia\/Mensajeros de reparto a domicilio\/Ni\u00f1os jugando en la puerta<\/p><p><\/p><h2>No te pierdas ning\u00fan detalle ni tengas un punto ciego con un campo de visi\u00f3n amplio de 130\u00b0<\/h2><p>La gran apertura f\/1.6 permite una mayor entrada de luz para obtener im\u00e1genes m\u00e1s claras. El campo de visi\u00f3n de 130\u00b0 ofrece una visi\u00f3n completa y detallada de un vistazo, al tiempo que minimiza los puntos ciegos.<\/p><h2>Visi\u00f3n nocturna inteligente a todo color para una visibilidad clara en condiciones de poca luz<\/h2><p>Ilumina de forma inteligente escenas nocturnas con poca luz y captura cualquier actividad anormal con claridad con luces infrarrojas y LED de alta potencia.<\/p><p><b>Habilitar el modo de visi\u00f3n nocturna en blanco y negro<\/b><\/p><p>En el modo de visi\u00f3n nocturna, active los infrarrojos para 