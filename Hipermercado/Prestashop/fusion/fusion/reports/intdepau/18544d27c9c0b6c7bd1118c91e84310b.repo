100"],"reference":"EL.32G21.PSH","name":{"1":"Memoria RAM Apacer 32GB\/ DDR4\/ 3200MHz\/ 1.2V\/ CL22\/ DIMM","2":"","3":"","4":""},"description":{"1":"                                                <p><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Tipo de memoria: DIMM<\/li>  <li>DDR4  <\/li><li>Capacidad 32GB<\/li>  <li>Frecuencia 3200 MHz<\/li>  <li>CL 22<\/li>  <li>Voltaje 1.2V<\/li><\/ul><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APACER","supplier":null,"width":null,"height":null,"depth":null,"weight":0.03,"unit_price":66.11,"unit_price_tax":66.11,"tax_rules_group":null,"category":"Componentes","sub_category":"Memoria RAM","quantity":5,"brand":"APACER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apa-32gb%20el%2032g21%20psh_1.jpg"],"wholesale_price":61.11}}},"4711342290597":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4711342290597",false],"wholesale_price":[165.47,false],"price":[170.47,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 1.21",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:220002","Cat. IDs: 190,99","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2a662efbe74c5aba2a0c838cfb72a256.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tarjeta Gr\u00e1fica Sparkle Intel Arc A750 ROC OC\/ 8GB GDDR6","category":"Componentes","sub_category":"Tarjetas Graficas","unit_price":170.47,"reference":"1A1-S00413500G","ean13":"4711342290597","weight":"1.21","quantity":2,"brand":"SPARKLE","description_pt":"<h2>SPARKLE Intel Arc A750 ROC OC Edition, 8GB GDDR6, SA750R-8GOC<\/h2><div><p>La SPARKLE Intel Arc A750 ROC OC Edition es la nueva MEJOR opci\u00f3n de la serie A750, que ofrece un alto rendimiento y una gran productividad sin que nada se interponga en su camino.<\/p><p>La serie ROC est\u00e1 equipada con un ventilador doble de 100 mm con cojinetes de bolas dobles y un dise\u00f1o de disipador t\u00e9rmico de 2,5 ranuras que reduce la longitud de la tarjeta de manera eficaz y est\u00e1 lista para encajar en un sistema compacto. Adem\u00e1s, los ventiladores DBB de 100 mm han tra\u00eddo una mayor eficiencia de refrigeraci\u00f3n, lo que genera una experiencia ultra silenciosa sin comprometer el rendimiento.<\/p><h2>CARACTER\u00cdSTICAS PRINCIPALES<\/h2><p><\/p><ul><li>2 ventiladores de 100 mm con doble cojinete de bolas<\/li><li>Placa posterior de metal, preinstalada<\/li><li>Trazado de rayos<\/li><li>Sombreado de velocidad variable (VSR)<\/li><li>DirectX 12 Ultimate<\/li><li>Vulkan 1.3<\/li><li>OpenGL 4.6<\/li><li>OpenCL 3.0<\/li><li>Sincronizaci\u00f3n adaptativa<\/li><li>Codificaci\u00f3n\/decodificaci\u00f3n AV1<\/li><li>VP9 Bitstream y decodificaci\u00f3n<\/li><li>Intel Deep Link Hyper Compute<\/li><li>Intel Deep Link Hyper Encode<\/li><li>Intel Deep Link Stream Assist.<\/li><\/ul><p><\/p><br><\/div><div><h2>ESPECIFICACIONES<\/h2><p><ul><li>Boost Clock: 2200 MHz<\/li><li>Xe-Core: 28<\/li><li>Unidades de trazado de rayos: 28<\/li><li>Motores Intel\u00ae XMX: 448<\/li><li>Motores Xe Vector: 448<\/li><li>Tama\u00f1o de la memoria: 8 GB GDDR6<\/li><li>Interfaz de memoria gr\u00e1fica: 256 bits<\/li><li>Ancho de banda de la memoria gr\u00e1fica: 512 GB\/s<\/li><li>Velocidad de la memoria gr\u00e1fica: 16 Gbps<\/li><li>Configuraciones de PCI Express: PCI Express 4.0 x16<\/li><li>TBP: 225 vatios<\/li><li>Logotipo LED: Barra luminosa de Intel Arc<\/li><li><b>RESOLUCI\u00d3N Y ACTUALIZACI\u00d3N<\/b><\/li><li>1x HDMI 2.0b (m\u00e1x.): 4096 x 2160 a 60 Hz<\/li><li>3x DisplayPort 2.0* (m\u00e1x.): 7680 x 4320 a 60 Hz<\/li><li>*Dise\u00f1ado para DP2.0, certificaci\u00f3n pendiente de lanzamiento VESA CTS.<\/li><li><b>REQUISITOS<\/b><\/li><li>Fuente de alimentaci\u00f3n de 650 vatios o m\u00e1s.<\/li><li>Dos conectores PCIe de 8 pines o 6+2 pines disponibles<\/li><li>Windows 11, Windows 10, Ubuntu 22.04<\/li><li>Placa base compatible con PCI Express 3.0, 4.0 o 5.0 con&nbsp;<span style='background-color: initial;'>una ranura para gr\u00e1ficos.<\/span><\/li><li><b>DIMENSIONES<\/b><\/li><li>Dimensiones: 281 x 131 x 51 mm<\/li><li>Peso: 880 g<\/li><li>Ancho: 2,5 ranuras<\/li><\/ul><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spk-gf%20arc%20a750%20roc%20oc%208g_1.jpg","wholesale_price":"165.47","unit_price_tax":170.47},"product_model":{"product_data":{"ean13":["4711342290597"],"reference":"1A1-S00413500G","name":{"1":"Tarjeta Gr\u00e1fica Sparkle Intel Arc A750 ROC OC\/ 8GB GDDR6","2":"","3":"","4":""},"description":{"1":"<h2>SPARKLE Intel Arc A750 ROC OC Edition, 8GB GDDR6, SA750R-8GOC<\/h2><div><p>La SPARKLE Intel Arc A750 ROC OC Edition es la nueva MEJOR opci\u00f3n de la serie A750, que ofrece un alto rendimiento y una gran productividad sin que nada se interponga en su camino.<\/p><p>La serie ROC est\u00e1 equipada con un ventilador doble de 100 mm con cojinetes de bolas dobles y un dise\u00f1o de disipador t\u00e9rmico de 2,5 ranuras que reduce la longitud de la tarjeta de manera eficaz y est\u00e1 lista para encajar en un sistema compacto. Adem\u00e1s, los ventiladores DBB de 100 mm han tra\u00eddo una mayor eficiencia de refrigeraci\u00f3n, lo que genera una experiencia ultra silenciosa sin comprometer el rendimiento.<\/p><h2>CARACTER\u00cdSTICAS PRINCIPALES<\/h2><p><\/p><ul><li>2 ventiladores de 100 mm con doble cojinete de bolas<\/li><li>Placa posterior de metal, preinstalada<\/li><li>Trazado de rayos<\/li><li>Sombreado de velocidad variable (VSR)<\/li><li>DirectX 12 Ultimate<\/li><li>Vulkan 1.3<\/li><li>OpenGL 4.6<\/li><li>OpenCL 3.0<\/li><li>Sincronizaci\u00f3n adaptativa<\/li><li>Codificaci\u00f3n\/decodificaci\u00f3n AV1<\/li><li>VP9 Bitstream y decodificaci\u00f3n<\/li><li>Intel Deep Link Hyper Compute<\/li><li>Intel Deep Link Hyper Encode<\/li><li>Intel Deep Link Stream Assist.<\/li><\/ul><p><\/p><br><\/div><div><h2>ESPECIFICACIONES<\/h2><p><ul><li>Boost Clock: 2200 MHz<\/li><li>Xe-Core: 28<\/li><li>Unidades de trazado de rayos: 28<\/li><li>Motores Intel\u00ae XMX: 448<\/li><li>Motores Xe Vector: 448<\/li><li>Tama\u00f1o de la memoria: 8 GB GDDR6<\/li><li>Interfaz de memoria gr\u00e1fica: 256 bits<\/li><li>Ancho de banda de la memoria gr\u00e1fica: 512 GB\/s<\/li><li>Velocidad de la memoria gr\u00e1fica: 16 Gbps<\/li><li>Configuraciones de PCI Express: PCI Express 4.0 x16<\/li><li>TBP: 225 vatios<\/li><li>Logotipo LED: Barra luminosa de Intel Arc<\/li><li><b>RESOLUCI\u00d3N Y ACTUALIZACI\u00d3N<\/b><\/li><li>1x HDMI 2.0b (m\u00e1x.): 4096 x 2160 a 60 Hz<\/li><li>3x DisplayPort 2.0* (m\u00e1x.): 7680 x 4320 a 60 Hz<\/li><li>*Dise\u00f1ado para DP2.0, certificaci\u00f3n pendiente de lanzamiento VESA CTS.<\/li><li><b>REQUISITOS<\/b><\/li><li>Fuente de alimentaci\u00f3n de 650 vatios o m\u00e1s.<\/li><li>Dos conectores PCIe de 8 pines o 6+2 pines disponibles<\/li><li>Windows 11, Windows 10, Ubuntu 22.04<\/li><li>Placa base compatible con PCI Express 3.0, 4.0 o 5.0 con&nbsp;<span style='background-color: initial;'>una ranura para gr\u00e1ficos.<\/span><\/li><li><b>DIMENSIONES<\/b><\/li><li>Dimensiones: 281 x 131 x 51 mm<\/li><li>Peso: 880 g<\/li><li>Ancho: 2,5 ranuras<\/li><\/ul><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewri