"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":47.18,"unit_price_tax":47.18,"tax_rules_group":null,"category":"Videovigilancia","sub_category":"Camaras Videovigilancia","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-cam%20out%20cam%20bw300_1.jpg"],"wholesale_price":42.18}}},"6941812774984":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812774984",false],"wholesale_price":[57.5,false],"price":[62.5,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:220675","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/1877e218ac878d9c204455374b2d509a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara de Videovigilancia Xiaomi Outdoor Camera BW500\/ 2K\/ 136\u00ba\/ Visi\u00f3n Nocturna\/ Control desde APP","category":"Videovigilancia","sub_category":"Camaras Videovigilancia","unit_price":62.5,"reference":"BHR8301GL","ean13":"6941812774984","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"                                                                                                <p><\/p><h2>La bater\u00eda duradera de 6 meses garantiza un uso sin preocupaciones<\/h2><p>Si\u00e9ntete m\u00e1s seguro de tus movimientos.<\/p><h2>Visi\u00f3n nocturna a todo color de 2,5 K<\/h2><p>Seguridad mejorada con im\u00e1genes n\u00edtidas durante la noche.<\/p><h2>Potente potencia de procesamiento de 1,2 T<\/h2><p>Detecci\u00f3n r\u00e1pida y precisa.<\/p><h2>Clasificaci\u00f3n profesional de resistencia al agua y al polvo IP67<\/h2><p>Mant\u00e9ngase protegido en condiciones clim\u00e1ticas adversas.<\/p><h2>Transmisi\u00f3n de datos encriptados<\/h2><p>Proteja la privacidad de sus datos<\/p><h2>8 GB de almacenamiento incorporado<\/h2><p>Mantenga los datos seguros.<\/p><h2>Im\u00e1genes claras y fluidas de 2,5K Un salto en la calidad de imagen que es realmente excepcional<\/h2><p>El sensor de imagen grande y de alta calidad cuidadosamente seleccionado ofrece im\u00e1genes refinadas que capturan cada detalle con una precisi\u00f3n incre\u00edble.<\/p><h2>Apertura grande f\/1.6 Im\u00e1genes superiores con mayor transmisi\u00f3n de luz<\/h2><p>La apertura m\u00e1s grande de f\/1.6 permite una mayor entrada de luz, brindando im\u00e1genes detalladas y claras incluso en entornos con poca luz.<\/p><h2>Campo de visi\u00f3n amplio de 136\u00b0 La cobertura gran angular mejorada minimiza los puntos ciegos<\/h2><p>La c\u00e1mara cuenta con una lente gran angular de 136\u00b0 para un campo de visi\u00f3n m\u00e1s amplio que reduce los puntos ciegos y mejora su seguridad con im\u00e1genes m\u00e1s claras y secuencias m\u00e1s completas.<\/p><h2>Visi\u00f3n nocturna a todo color de 10 m Seguridad las 24 horas<\/h2><p>Infrarrojos de alta potencia + LED a todo color que brindan una luz m\u00e1s brillante y un \u00e1rea iluminada m\u00e1s grande. Detecta los niveles de luz ambiental para iluminar con poca luz de manera inteligente y cuenta con una visi\u00f3n nocturna clara a 10 metros, por lo que se puede identificar a los visitantes o ladrones de un vistazo.<\/p><p><b>Visi\u00f3n nocturna en blanco y negro<\/b><\/p><p>Cuando se configura en modo de visi\u00f3n nocturna en blanco y negro, se utiliza el relleno infrarrojo en condiciones de toma de fotograf\u00edas con poca luz.<\/p><p><b>Visi\u00f3n nocturna a todo color<\/b><\/p><p>Cuando se configura en modo de visi\u00f3n nocturna en color, se utiliza luz blanca de relleno en situaciones de iluminaci\u00f3n insuficiente.<\/p><h2>Capacidad de bater\u00eda s\u00faper grande para 180 d\u00edas de grabaci\u00f3n sin preocupaciones<\/h2><p>La bater\u00eda de alta capacidad de 10 000 mAh* garantiza una carga prolongada durante hasta seis meses*. Dile adi\u00f3s a la ansiedad por la bater\u00eda.<\/p><h2>Dise\u00f1o de sistemas de bajo consumo de energ\u00eda Distribuci\u00f3n de energ\u00eda a demanda con eficiencia energ\u00e9tica<\/h2><p>Los algoritmos locales integrados y la tecnolog\u00eda de bajo consumo permiten que la c\u00e1mara ajuste de forma inteligente el uso de la bater\u00eda seg\u00fan los cambios en el entorno de monitoreo, lo que garantiza un consumo de energ\u00eda eficiente y una mayor duraci\u00f3n de la bater\u00eda.<\/p><h2>Clasificaci\u00f3n profesional de resistencia al agua y al polvo IP67 Protecci\u00f3n contra el viento y la lluvia<\/h2><p>Excelente sellado para evitar la entrada de polvo. No importa si est\u00e1 expuesta al viento, la lluvia, la nieve o el sol, puede funcionar de manera estable en una variedad de entornos hostiles. Es confiable y duradera, y protege la puerta para mantenerte a salvo.<\/p><h2>Chip inform\u00e1tico de 1,2 T Detecci\u00f3n eficiente para una protecci\u00f3n inteligente<\/h2><p>Gracias a un chip de computaci\u00f3n de inteligencia artificial de 1,2 TOPS, la c\u00e1mara puede alcanzar la asombrosa cifra de 1,2 billones de operaciones por segundo, lo que le permite lograr una velocidad, precisi\u00f3n y eficiencia incomparables. Puede identificar con precisi\u00f3n a personas, veh\u00edculos, animales y paquetes, y filtrar de manera inteligente las falsas alarmas causadas por movimientos menores, lo que le brinda tranquilidad sin la necesidad de una vigilancia constante.<\/p><h2>Disponible en m\u00faltiples plataformas No te pierdas nunca informaci\u00f3n importante<\/h2><p>La c\u00e1mara admite la vinculaci\u00f3n inteligente multiplataforma con Google Assistant y Alexa, lo que permite una mayor comodidad y una experiencia de usuario m\u00e1s optimizada.<\/p><h2>Aviso de disuasi\u00f3n audiovisual Notificaciones push de informaci\u00f3n de alarma instant\u00e1nea<\/h2><p>Cuando una persona o un veh\u00edculo ingresa a la zona monitoreada, se activa inmediatamente un sonido de alarma y se enciende una luz blanca. Adem\u00e1s de asustar a los invitados no deseados, la aplicaci\u00f3n Xiaomi Home enviar\u00e1 un mensaje de advertencia al propietario lo antes posible para que pueda evaluar cualquier riesgo.<\/p><p><h2>Almacenamiento eMMC local de gran capacidad de 8G La memoria flash segura es a\u00fan m\u00e1s segura<\/h2><p>Las innovadoras capacidades de almacenamiento se proporcionan mediante un espacio de almacenamiento eMMC de alta capacidad de 8 GB integrado que cuenta con codificaci\u00f3n H.265 para una mayor resoluci\u00f3n, velocidades de lectura m\u00e1s r\u00e1pidas y una reproducci\u00f3n m\u00e1s fluida. Grabe y almacene sus datos de forma segura a largo plazo sin preocuparse por quedarse sin espacio.<\/p><h2>Cancelaci\u00f3n de ruido para llamadas Comunicaci\u00f3n n\u00edtida<\/h2><p>La potente funci\u00f3n de cancelaci\u00f3n de ruido y mejora de la voz humana puede capturar audio preciso desde una distancia de hasta 7 metros. Con un sonido claro y de alta fidelidad incluso en entornos ruidosos, las conversaciones se sienten como si estuvieran sucediendo en persona.<\/p><h2>Incorpora el chip de seguridad Mi Home que garantiza una mayor protecci\u00f3n y seguridad de la privacidad.<\/h2><p>Cada chip viene con su propia clave y certificado \u00fanicos, lo que proporciona una protecci\u00f3n s\u00f3lida contra violaciones de datos y garantiza la m\u00e1xima seguridad para la comunicaci\u00f3n y privacidad de sus datos.<\/p><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li>Nombre del producto<\/li><li>C\u00e1mara para exteriores Xiaomi BW500<\/li><li>N\u00famero de modelo del producto<\/li><li>MJSXJ06BY<\/li><li>Resoluci\u00f3n<\/li><li>2560 x 1440<\/li><li>Abertura<\/li><li>f\/1.6<\/li><li>\u00c1ngulo de la lente<\/li><li>136\u00b0<\/li><li>Codificaci\u00f3n de v\u00eddeo<\/li><li>H.265<\/li><li>Conectividad inal\u00e1mbrica<\/li><li>Wi-Fi IEEE 802.11b\/g\/n\/ax 2,4 GHz<\/li><li>Sistemas compatibles<\/li><li>Android 8.0 o iOS 12.0 y superior<\/li><li>Clasificaci\u00f3n de resistencia al agua<\/li><li>IP67<\/li><li>Capacidad de almacenamiento interno<\/li><li>8 GB<\/li><li>Entrada nominal<\/li><li>5 V-2 A<\/li><li>Temperatura de funcionamiento<\/li><li>-20\u00b0C a 55\u00b0C<\/li><li>Frecuencia de funcionamiento de Wi-Fi<\/li><li>2,4 GHz<\/li><li>Potencia m\u00e1xima de salida de Wi-Fi<\/li><li><20 dBm<\/li><li><b>Contenido del paquete<\/b><\/li><li>C\u00e1mara x1<\/li><li>Soporte x1<\/li><li>Cable de carga x1<\/li><li>Plantilla de montaje adhesiva x1<\/li><li>Perno de expansi\u00f3n x4<\/li><li>Tornillo x4<\/li><li>Etiqueta de advertencia x1<\/li><li>Manual de usuario x1<\/li><\/ul><\/p><\/p><p><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-cam%20out%20cam%20bw500_1.jpg","wholesale_price":"57.50","unit_price_tax":62.5},"product_model":{"product_data":{"ean13":["6941812774984"],"reference":"BHR8301GL","name":{"1":"C\u00e1mara de Videovigilancia Xiaomi Outdoor Camera BW500\/ 2K\/ 136\u00ba\/ Visi\u00f3n Nocturna\/ Control desde APP","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><\/p><h2>La bater\u00eda duradera de 6 meses garantiza un uso sin preocupaciones<\/h2><p>Si\u00e9ntete m\u00e1s seguro de tus movimientos.<\/p><h2>Visi\u00f3n nocturna a todo color de 2,5 K<\/h2><p>Seguridad mejorada con im\u00e1genes n\u00edtidas durante la noche.<\/p><h2>Potente potencia de procesamiento de 1