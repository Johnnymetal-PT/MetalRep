:"                                                    ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20redmi%2015c%204-256%20bl_1.jpg","wholesale_price":"93.62","unit_price_tax":100.62},"product_model":{"product_data":{"ean13":["6932554458218"],"reference":"REDMI 15C 4-256 BL","name":{"1":"Smartphone Xiaomi Redmi 15C 4GB\/ 256GB\/ 6.9'\/ Azul","2":"","3":"","4":""},"description":{"1":"                                                    ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0.41,"unit_price":100.62,"unit_price_tax":100.62,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20redmi%2015c%204-256%20bl_1.jpg"],"wholesale_price":93.62}}},"6941812727904":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812727904",false],"wholesale_price":[5.28,false],"price":[12.28,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.04",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:276666","Cat. IDs: 76","Associated Categories","Cat. Default: 76","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d0b3bf1fa8a5b38cafac2fd6606d5a5b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Clip para Correr para Smartband 8 Xiaomi Smartband 8 Running Clip\/ Verde","category":"SmartWatch - Pulseras","sub_category":"Pulseras Smartband","unit_price":12.280000000000001,"reference":"SB8 RUN CLIP GRE","ean13":"6941812727904","weight":"0.04","quantity":0,"brand":"XIAOMI","description_pt":"<p><h2>Xiaomi Smart Band 8&nbsp;<span style='background-color: initial;'>Running Clip<\/span><\/h2><h2>Un entrenamiento m\u00e1s profesional<\/h2><p>Despu\u00e9s de activar el pebble mode, coloca el reloj en el clip para correr y eng\u00e1nchalo a los cordones de las zapatillas con la pantalla orientada hacia ti. Medir\u00e1 tu postura de carrera y te proporcionar\u00e1 varios datos de carrera. La intensa combinaci\u00f3n de negro y verde, con materiales de pl\u00e1stico de policarbonato y caucho TPU, la convierten en una opci\u00f3n fiable.<\/p><br><\/p><p><h2><span style='background-color: initial;'>Especificaciones<\/span><\/h2><p><ul><li><b>Material de la correa<\/b><\/li><li>Policarbonato, TPU&nbsp;<\/li><li><b>Situaciones aplicables<\/b><\/li><li>Carrera, ciclismo<\/li><li><b>Elementos de datos admitidos<\/b><\/li><li>Recuento de pasos, zancada, cadencia (ppm), ritmo, distancia, relaci\u00f3n cadencia-ritmo, tiempo de contacto con el suelo, tiempo en el aire, relaci\u00f3n de tiempo en el aire, pronaci\u00f3n y supinaci\u00f3n, patr\u00f3n de pisada, fuerza de impacto, cadencia (rpm)<\/li><li><b>Contenido del paquete<\/b><\/li><li>1 Running Clip<\/li><li>1 manual de usuario<\/li><li>1 herramienta de apertura<\/li><li>(El cuerpo del reloj no viene incluido y se vende por separado)&nbsp;<\/li><\/ul><\/p><br><\/p><p><p><ul><li><b>Instalaci\u00f3n:<\/b><\/li><li>1. Presiona e inserta el cuerpo del reloj en la cavidad del Running Clip en la direcci\u00f3n correcta.<\/li><li>2. Presiona la pesta\u00f1a de la parte inferior del Running Clip para abrirlo.<\/li><li>3. Inserta el clip entre el zapato y los cordones y presi\u00f3nalo para fijarlo.<\/li><li>*La pantalla del reloj debe estar orientada hacia ti al acoplar el clip. Una orientaci\u00f3n incorrecta afectar\u00e1 a la precisi\u00f3n de los datos.<\/li><li>Nota:<\/li><li>Te recomendamos que fijes el clip a varias secciones de los cordones para asegurarlo. El clip podr\u00eda aflojarse si se fija a pocas secciones y podr\u00eda romperse si se fija a demasiadas.<\/li><li><b>Extracci\u00f3n:<\/b><\/li><li>1. Presiona la pesta\u00f1a de la parte inferior del Running Clip para abrirlo. Retira el clip de los cordones.<\/li><li>2. Inserta suavemente la punta del dedo o una herramienta de apertura bajo la parte superior o inferior del Running Clip. Sujeta las zonas rebajadas del cuerpo del reloj y tira de \u00e9l hacia arriba.<\/li><li>3. Separa el cuerpo del Running Clip.<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-strap%20sb8%20run%20clip%20gre_1.jpg","wholesale_price":"5.28","unit_price_tax":12.280000000000001},"product_model":{"product_data":{"ean13":["6941812727904"],"reference":"SB8 RUN CLIP GRE","name":{"1":"Clip para Correr para Smartband 8 Xiaomi Smartband 8 Running Clip\/ Verde","2":"","3":"","4":""},"description":{"1":"<p><h2>Xiaomi Smart Band 8&nbsp;<span style='background-color: initial;'>Running Clip<\/span><\/h2><h2>Un entrenamiento m\u00e1s profesional<\/h2><p>Despu\u00e9s de activar el pebble mode, coloca el reloj en el clip para correr y eng\u00e1nchalo a los cordones de las zapatillas con la pantalla orientada hacia ti. Medir\u00e1 tu postura de carrera y te proporcionar\u00e1 varios datos de carrera. La intensa combinaci\u00f3n de negro y verde, con materiales de pl\u00e1stico de policarbonato y caucho TPU, la convierten en una opci\u00f3n fiable.<\/p><br><\/p><p><h2><span style='background-color: initial;'>Especificaciones<\/span><\/h2><p><ul><li><b>Material de la correa<\/b><\/li><li>Policarbonato, TPU&nbsp;<\/li><li><b>Situaciones aplicables<\/b><\/li><li>Carrera, ciclismo<\/li><li><b>Elementos de datos admitidos<\/b><\/li><li>Recuento de pasos, zancada, cadencia (ppm), ritmo, distancia, relaci\u00f3n cadencia-ritmo, tiempo de contacto con el suelo, tiempo en el aire, relaci\u00f3n de tiempo en el aire, pronaci\u00f3n y supinaci\u00f3n, patr\u00f3n de pisada, fuerza de impacto, cadencia (rpm)<\/li><li><b>Contenido del paquete<\/b><\/li><li>1 Running Clip<\/li><li>1 manual de usuario<\/li><li>1 herramienta de apertura<\/li><li>(El cuerpo del reloj no viene incluido y se vende por separado)&nbsp;<\/li><\/ul><\/p><br><\/p><p><p><ul><li><b>Instalaci\u00f3n:<\/b><\/li><li>1. Presiona e inserta el cuerpo del reloj en la cavidad del Running Clip en la direcci\u00f3n correcta.<\/li><li>2. Presiona la pesta\u00f1a de la parte inferior del Running Clip para abrirlo.<\/li><li>3. Inserta el clip entre el zapato y los cordones y presi\u00f3nalo para fijarlo.<\/li><li>*La pantalla del reloj debe estar orientada hacia ti al acoplar el clip. Una orientaci\u00f3n incorrecta afectar\u00e1 a la precisi\u00f3n de los datos.<\/li><li>Nota:<\/li><li>Te recomendamos que fijes el clip a varias secciones de los cordones para asegurarlo. El clip podr\u00eda aflojarse si se fija a pocas secciones y podr\u00eda romperse si se fija a demasiadas.<\/li><li><b>Extracci\u00f3n:<\/b><\/li><li>1. Presiona la pesta\u00f1a de la parte inferior del Running Clip para abrirlo. Retira el clip de los cordones.<\/li><li>2. Inserta suavemente la punta del dedo o una herramienta de apertura bajo la parte superior o inferior del Running Clip. Sujeta las zonas rebajadas del cuerpo del reloj y tira de \u00e9l hacia arriba.<\/li><li>3. Separa el cuerpo del Running Clip.<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0.04,"unit_price":12.28,"unit_price_tax":12.28,"tax_rules_group":null,"category":"SmartWatch - Pulseras","sub_category":"Pulseras Smartband","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-strap%20sb8%20run%20clip%20gre_1.jpg"],"wholesale_price":5.28}}},"8806097195733":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806097195733",false],"wholesale_price":[362.51,false],"price":[369.51,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.74",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:276706","Cat. IDs: 196","Associated Categories","Cat. Default: 196","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/af006a598d1c7b381b959dd522b6e4ff.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tablet Samsung Galaxy Tab S10 FE 10.9'\/ 8GB\/ 128GB\/ Octacore\/ Gris","category":"Tablets","sub_category":"Tablets","unit_price":369.51,"reference":"SM-X520NZAREUE","ean13":"8806097195733","weight":"0.74","quantity":5,"brand":"SAMSUNG","description_pt":"<h2>Hazte ver con un look ic\u00f3nico<\/h2><p>Insp\u00edrate y expr\u00e9sate con los elegantes Galaxy Tab S10 FE y Tab S10 FE+ con S Pen. Los detalles en tonos claros del dise\u00f1o a\u00f1aden un toque de frescura para que tu look llame la atenci\u00f3n. Hazte con el tuyo en gris, plata o azul.<\/p><h2>Rod\u00e9alo, encu\u00e9ntralo en la gran pantalla<\/h2><p>Busca cualquier imagen, v\u00eddeo o texto en tu pantalla. Rodea, resalta, garabatea o toca para localizar lo que te interesa, sin necesidad de hacer capturas de pantalla.<\/p><h2>Una pantalla tan grande como tu imaginaci\u00f3n<\/h2><p>Sue\u00f1a a lo grande con el amplio Galaxy Tab S10 FE de 10,9', o ve a\u00fan m\u00e1s all\u00e1 con la enorme pantalla de Tab S10 FE+ de 13,1', la m\u00e1s grande de siempre en un dispositivo Galaxy Tab FE.<\/p><h2>Potencia con un gran rendimiento<\/h2><p>Crea, estudia y juega con el rendimiento superr\u00e1pido del procesador Exynos 1580. Experimenta la innovaci\u00f3n impulsada por AI con pr\u00e1cticas funciones de productividad. Realiza varias tareas a la vez sin problemas con la gran memoria de ambos modelos y almacena lo que m\u00e1s te gusta con la compatibilidad con tarjetas microSD de hasta 2 TB.<\/p><h2>Pantalla iluminada. Im\u00e1genes fluidas<\/h2><p>Echa un vistazo a la pantalla de alta resoluci\u00f3n y definici\u00f3n con detalles n\u00edtidos y visuales fluidos a 90 Hz. Vision Booster se asegura de que tu visi\u00f3n sea brillante incluso en exteriores, con hasta 800 nits en el modo High Brightness. Sigue disfrutando del contenido de tu pantalla gracias a la luz azul de baja intensidad para una mayor comodidad ocular.<\/p><h2>Fina. Ligera. Se ajusta a la perfecci\u00f3n<\/h2><p>Viaja donde quieras con el tablet Galaxy Tab S10 FE o Tab S10 FE+. Fina y ligera, se adapta sin esfuerzo a tu din\u00e1mico estilo de vida, y a tu mochila, para que puedas llevar el trabajo y la diversi\u00f3n contigo.<\/p><h2>Un toque. La clave de la AI<\/h2><p>Pulsa una vez en la tecla Galaxy AI para acceder instant\u00e1neamente a tu mundo de Inteligencia Artificial. Personaliza el bot\u00f3n con tu asistente de IA preferido para simplificar tu flujo y obtener ayuda inteligente en un instante.<\/p><h2>Una c\u00e1mara de 13 MP mejora la resoluci\u00f3n<\/h2><p>Prep\u00e1rate para una raci\u00f3n de fotograf\u00eda y v\u00eddeo \u00e9picos en alta resoluci\u00f3n. La c\u00e1mara trasera mejorada de 13 MP captura tu mundo con m\u00e1s claridad y detalle, haciendo que tus fotos destaquen.<\/p><h2>Sal a la calle. Mantente protegido<\/h2><p>Con resistencia al agua y al polvo con clasificaci\u00f3n IP68, Galaxy Tab S10 FE y Tab S10 FE+ con S Pen est\u00e1n listos para seguirte en tu pr\u00f3xima aventura al aire libre.<\/p><h2>Obt\u00e9n un informe de tu casa personalizado<\/h2><p>Comprueba el estado de tu casa con un resumen panor\u00e1mico en el widget Home Insight. El panel te ofrece informaci\u00f3n clave sobre tu hogar basada en sensores y dispositivos conectados. Explora tu espacio con un mapa en 3D y obt\u00e9n sugerencias de IA personalizadas.<\/p><h2>Especificaciones<\/h2><ul>\t<li><strong>Caracter\u00edsticas<\/strong><\/li>\t<li>Velocidad CPU<\/li>\t<li>2.9GHz, 2.6GHz, 1.9GHz<\/li>\t<li>Tama\u00f1o (Pantalla principal)<\/li>\t<li>10.9' (277.0mm)<\/li>\t<li>C\u00e1mara principal - Resoluci\u00f3n<\/li>\t<li>13.0 MP<\/li>\t<li>Peso (g)<\/li>\t<li>500<\/li>\t<li><strong>Procesador<\/strong><\/li>\t<li>Velocidad CPU<\/li>\t<li>2.9GHz, 2.6GHz, 1.9GHz<\/li>\t<li>Tipo CPU<\/li>\t<li>Octa-Core<\/li>\t<li><strong>Pantalla<\/strong><\/li>\t<li>Tama\u00f1o (Pantalla principal)<\/li>\t<li>10.9' (277.0mm)<\/li>\t<li>Tama\u00f1o (Pantalla principal)<\/li>\t<li>277.0mm (10.9' full rectangle) \/ 275.1mm (10.8' rounded corners)<\/li>\t<li>Resoluci\u00f3n (Pantalla principal)<\/li>\t<li>2304 x 1440 (WUXGA+)<\/li>\t<li>Tecnolog\u00eda (Pantalla principal)<\/li>\t<li>TFT<\/li>\t<li>N\u00famero de colores (Pantalla principal)<\/li>\t<li>16M<\/li>\t<li>S Pen<\/li>\t<li>S\u00ed<\/li>\t<li><strong>C\u00e1mara<\/strong><\/li>\t<li>C\u00e1mara principal - Resoluci\u00f3n<\/li>\t<li>13.0 MP<\/li>\t<li>C\u00e1mara principal - Autofocus<\/li>\t<li>S\u00ed<\/li>\t<li>C\u00e1mara frontal - Resoluci\u00f3n<\/li>\t<li>12.0 MP<\/li>\t<li>C\u00e1mara principal - Flash<\/li>\t<li>No<\/li>\t<li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li>\t<li>UHD 4K (3840 x 2160)@30fps<\/li>\t<li><strong>Almacenamiento\/Memoria<\/strong><\/li>\t<li>Memoria_(GB)<\/li>\t<li>8<\/li>\t<li>Almacenamiento (GB)<\/li>\t<li>128<\/li>\t<li>Soporte de almacenamiento externo<\/li>\t<li>MicroSD (hasta 2TB)<\/li>\t<li><strong>Conectividad<\/strong><\/li>\t<li>Versi\u00f3n USB<\/li>\t<li>USB 2.0<\/li>\t<li>Localizaci\u00f3n<\/li>\t<li>GPS, Glonass, Beidou, Galileo, QZSS<\/li>\t<li>Auriculares<\/li>\t<li>USB Type-C<\/li>\t<li>MHL<\/li>\t<li>No<\/li>\t<li>Wi-Fi<\/li>\t<li>802.11a\/b\/g\/n\/ac\/ax 2.4GHz+5GHz, HE80, MIMO, 1024-QAM<\/li>\t<li>Wi-Fi Direct<\/li>\t<li>S\u00ed<\/li>\t<li>Versi\u00f3n Bluetooth<\/li>\t<li>Bluetooth v5.3<\/li>\t<li>NFC<\/li>\t<li>No<\/li>\t<li>Perfiles Bluetooth<\/li>\t<li>A2DP, AVRCP, DI, HAP, HFP, HID, HOGP, HSP, MAP, OPP, PAN, PBAP, PBP, TMAP<\/li>\t<li>PC Sync.<\/li>\t<li>Smart Switch (PC version)<\/li>\t<li><strong>Sistema Operativo<\/strong><\/li>\t<li>Android<\/li>\t<li><strong>Informaci\u00f3n general<\/strong><\/li>\t<li>Color<\/li>\t<li>Gris<\/li>\t<li>Formato<\/li>\t<li>Tablet<\/li>\t<li>Sensores<\/li>\t<li>Aceler\u00f3metro, Sensor de huella dactilar, Giroscopio, Geomagn\u00e9tico, Hall, Luminosidad<\/li>\t<li><strong>Especificaciones f\u00edsicas<\/strong><\/li>\t<li>Dimensiones (AlxAnxProf, mm)<\/li>\t<li>165.8 x 254.3 x 6.0<\/li>\t<li>Peso (g)<\/li>\t<li>500<\/li>\t<li>Bater\u00eda<\/li>\t<li>Tiempo de reproducci\u00f3n de V\u00eddeo (Horas, Wireless)<\/li>\t<li>Hasta 20<\/li>\t<li>Capacidad de bater\u00eda (mAh, t\u00edpico)<\/li>\t<li>8000<\/li>\t<li>Extra\u00edble<\/li>\t<li>No<\/li>\t<li><strong>Audio y V\u00eddeo<\/strong><\/li>\t<li>Formatos de reproducci\u00f3n de V\u00eddeo<\/li>\t<li>MP4, M4V, 3GP, 3G2, AVI, FLV, MKV, WEBM<\/li>\t<li>Resoluci\u00f3n de reproducci\u00f3n de V\u00eddeo<\/li>\t<li>UHD 4K (3840 x 2160) @60fps<\/li>\t<li>Formatos de reproducci\u00f3n de Audio<\/li>\t<li>MP3, M4A, 3GA, AAC, OGG, OGA, WAV, AMR, AWB, FLAC, MID, MIDI, XMF, MXMF, IMY, RTTTL, RTX, OTA<\/li>\t<li><strong>Servicios y Aplicaciones<\/strong><\/li>\t<li>Compatibilidad Gear<\/li>\t<li>Galaxy Buds3 Pro, Galaxy Buds2 Pro, Galaxy Buds Pro, Galaxy Buds Live, Galaxy Buds+, Galaxy Buds3, Galaxy Buds2, Galaxy Buds, Galaxy Buds FE<\/li>\t<li>Mobile TV<\/li>\t<li>No<\/li>\t<li>SmartThings Support<\/li>\t<li>Yes<\/li><\/ul>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-tab%20x520%208-128%20gy%20v2_1.jpg","wholesale_price":"362.51","unit_price_tax":369.51},"product_model":{"product_data":{"ean13":["8806097195733"],"reference":"SM-X520NZAREUE","name":{"1":"Tablet Samsung Galaxy Tab S10 FE 10.9'\/ 8GB\/ 128GB\/ Octacore\/ Gris","2":"","3":"","4":""},"description":{"1":"<h2>Hazte ver con un look ic\u00f3nico<\/h2><p>Insp\u00edrate y expr\u00e9sate con los elegantes Galaxy Tab S10 FE y Tab S10 FE+ con S Pen. Los detalles en tonos claros del dise\u00f1o a\u00f1aden un toque de frescura para que tu look llame la atenci\u00f3n. Hazte con el tuyo en gris, plata o azul.<\/p><h2>Rod\u00e9alo, encu\u00e9ntralo en la gran pantalla<\/h2><p>Busca cualquier imagen, v\u00eddeo o texto en tu pantalla. Rodea, resalta, garabatea o toca para localizar lo que te interesa, sin necesidad de hacer capturas de pantalla.<\/p><h2>Una pantalla tan grande como tu imaginaci\u00f3n<\/h2><p>Sue\u00f1a a lo grande con el amplio Galaxy Tab S10 FE de 10,9', o ve a\u00fan m\u00e1s all\u00e1 con la enorme pantalla de Tab S10 FE+ de 13,1', la m\u00e1s grande de siempre en un dispositivo Galaxy Tab FE.<\/p><h2>Potencia con un gran rendimiento<\/h2><p>Crea, estudia y juega con el rendimiento superr\u00e1pido del procesador Exynos 1580. Experimenta la innovaci\u00f3n impulsada por AI con pr\u00e1cticas funciones de productividad. Realiza varias tareas a la vez sin problemas con la gran memoria de ambos modelos y almacena lo que m\u00e1s te gusta con la compatibilidad con tarjetas microSD de hasta 2 TB.<\/p><h2>Pantalla iluminada. Im\u00e1genes fluidas<\/h2><p>Echa un vistazo a la pantalla de alta resoluci\u00f3n y definici\u00f3n con detalles n\u00edtidos y visuales fluidos a 90 Hz. Vision Booster se asegura de que tu visi\u00f3n sea brillante incluso en exteriores, con hasta 800 nits en el modo High Brightness. Sigue disfrutando del contenido de tu pantalla gracias a la luz azul de baja intensidad para una mayor comodidad ocular.<\/p><h2>Fina. Ligera. Se ajusta a la perfecci\u00f3n<\/h2><p>Viaja donde quieras con el tablet Galaxy Tab S10 FE o Tab S10 FE+. Fina y ligera, se adapta sin esfuerzo a tu din\u00e1mico estilo de vida, y a tu mochila, para que puedas llevar el trabajo y la diversi\u00f3n contigo.<\/p><h2>Un toque. La clave de la AI<\/h2><p>Pulsa una vez en la tecla Galaxy AI para acceder instant\u00e1neamente a tu mundo de Inteligencia Artificial. Personaliza el bot\u00f3n con tu asistente de IA preferido para simplificar tu flujo y obtener ayuda inteligente en un instante.<\/p><h2>Una c\u00e1mara de 13 MP mejora la resoluci\u00f3n<\/h2><p>Prep\u00e1rate para una raci\u00f3n de fotograf\u00eda y v\u00eddeo \u00e9picos en alta resoluci\u00f3n. La c\u00e1mara trasera mejorada de 13 MP captura tu mundo con m\u00e1s claridad y detalle, haciendo que tus fotos destaquen.<\/p><h2>Sal a la calle. Mantente protegido<\/h2><p>Con resistencia al agua y al polvo con clasificaci\u00f3n IP68, Galaxy Tab S10 FE y Tab S10 FE+ con S Pen est\u00e1n listos para seguirte en tu pr\u00f3xima aventura al aire libre.<\/p><h2>Obt\u00e9n un informe de tu casa personalizado<\/h2><p>Comprueba el estado de tu casa con un resumen panor\u00e1mico en el widget Home Insight. El panel te ofrece informaci\u00f3n clave sobre tu hogar basada en sensores y dispositivos conectados. Explora tu espacio con un mapa en 3D y obt\u00e9n sugerencias de IA personalizadas.<\/p><h2>Especificaciones<\/h2><ul>\t<li><strong>Caracter\u00edsticas<\/strong><\/li>\t<li>Velocidad CPU<\/li>\t<li>2.9GHz, 2.6GHz, 1.9GHz<\/li>\t<li>Tama\u00f1o (Pantalla principal)<\/li>\t<li>10.9' (277.0mm)<\/li>\t<li>C\u00e1mara principal - Resoluci\u00f3n<\/li>\t<li>13.0 MP<\/li>\t<li>Peso (g)<\/li>\t<li>500<\/li>\t<li><strong>Procesador<\/strong><\/li>\t<li>Velocidad CPU<\/li>\t<li>2.9GHz, 2.6GHz, 1.9GHz<\/li>\t<li>Tipo CPU<\/li>\t<li>Octa-Core<\/li>\t<li><strong>Pantalla<\/strong><\/li>\t<li>Tama\u00f1o (Pantalla principal)<\/li>\t<li>10.9' (277.0mm)<\/li>\t<li>Tama\u00f1o (Pantalla principal)<\/li>\t<li>277.0mm (10.9' full rectangle) \/ 275.1mm (10.8' rounded corners)<\/li>\t<li>Resoluci\u00f3n (Pantalla principal)<\/li>\t<li>2304 x 1440 (WUXGA+)<\/li>\t<li>Tecnolog\u00eda (Pantalla principal)<\/li>\t<li>TFT<\/li>\t<li>N\u00famero de colores (Pantalla principal)<\/li>\t<li>16M<\/li>\t<li>S Pen<\/li>\t<li>S\u00ed<\/li>\t<li><strong>C\u00e1mara<\/strong><\/li>\t<li>C\u00e1mara principal - Resoluci\u00f3n<\/li>\t<li>13.0 MP<\/li>\t<li>C\u00e1mara principal - Autofocus<\/li>\t<li>S\u00ed<\/li>\t<li>C\u00e1mara frontal - Resoluci\u00f3n<\/li>\t<li>12.0 MP<\/li>\t<li>C\u00e1mara principal - Flash<\/li>\t<li>No<\/li>\t<li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li>\t<li>UHD 4K (3840 x 2160)@30fps<\/li>\t<li><strong>Almacenamiento\/Memoria<\/strong><\/li>\t<li>Memoria_(GB)<\/li>\t<li>8<\/li>\t<li>Almacenamiento (GB)<\/li>\t<li>128<\/li>\t<li>Soporte de almacenamiento externo<\/li>\t<li>MicroSD (hasta 2TB)<\/li>\t<li><strong>Conectividad<\/strong><\/li>\t<li>Versi\u00f3n USB<\/li>\t<li>USB 2.0<\/li>\t<li>Localizaci\u00f3n<\/li>\t<li>GPS, Glonass, Beidou, Galileo, QZSS<\/li>\t<li>Auriculares<\/li>\t<li>USB Type-C<\/li>\t<li>MHL<\/li>\t<li>No<\/li>\t<li>Wi-Fi<\/li>\t<li>802.11a\/b\/g\/n\/ac\/ax 2.4GHz+5GHz, HE80, MIMO, 1024-QAM<\/li>\t<li>Wi-Fi Direct<\/li>\t<li>S\u00ed<\/li>\t<li>Versi\u00f3n Bluetooth<\/li>\t<li>Bluetooth v5.3<\/li>\t<li>NFC<\/li>\t<li>No<\/li>\t<li>Perfiles Bluetooth<\/li>\t<li>A2DP, AVRCP, DI, HAP, HFP, HID, HOGP, HSP, MAP, OPP, PAN, PBAP, PBP, TMAP<\/li>\t<li>PC Sync.<\/li>\t<li>Smart Switch (PC version)<\/li>\t<li><strong>Sistema Operativo<\/strong><\/li>\t<li>Android<\/li>\t<li><strong>Informaci\u00f3n general<\/strong><\/li>\t<li>Color<\/li>\t<li>Gris<\/li>\t<li>Formato<\/li>\t<li>Tablet<\/li>\t<li>Sensores<\/li>\t<li>Aceler\u00f3metro, Sensor de huella dactilar, Giroscopio, Geomagn\u00e9tico, Hall, Luminosidad<\/li>\t<li><strong>Especificaciones f\u00edsicas<\/strong>