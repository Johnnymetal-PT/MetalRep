 2.1 hasta 7680 x 4320 @120Hz, 3x DisplayPort 2.1 hasta 7680 x 4320 @60Hz<\/li>    <li><b>Requisitos m\u00ednimos:<\/b> CPU Intel\u00ae Core&#8482; 10\u00aa Gen \/ AMD Ryzen&#8482; Serie 3000 o superior con soporte Resizable BAR \/ Smart Access Memory, placa base con ranura PCIe x16, PSU 600W o superior con 1x conector PCIe de 8 pines, 8 GB RAM m\u00ednima (16 GB recomendada), Windows\u00ae 11 64-bit o Windows\u00ae 10 64-bit<\/li>    <li><b>Dimensiones:<\/b> 242 x 105 x 44 mm<\/li>    <li><b>Peso:<\/b> 796 g<\/li>    <li><b>Anchura:<\/b> 2.2 ranuras<\/li>  <\/ul><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SPARKLE","supplier":null,"width":null,"height":null,"depth":null,"weight":1.2,"unit_price":181.93,"unit_price_tax":181.93,"tax_rules_group":null,"category":"Componentes","sub_category":"Tarjetas Graficas","quantity":5,"brand":"SPARKLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spk-gf%20arc%20b570%20ec%20oc%2010g_1.jpg"],"wholesale_price":174.93}}},"4711342291105":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4711342291105",false],"wholesale_price":[229.18,false],"price":[236.18,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 1.65",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:282282","Cat. IDs: 190,99","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/40f2bb3cd691d86ec86fbe31860b33d8.jpg; <br>-------------------------------"],"resul