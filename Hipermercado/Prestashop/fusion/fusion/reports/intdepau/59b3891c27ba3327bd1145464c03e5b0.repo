 \u00b0C<\/li><li><strong>Humedad operativa:<\/strong>&nbsp;8 % a 80 % RH<\/li><li><strong>Humedad de almacenamiento:<\/strong>&nbsp;5 % a 95 % RH<\/li><li><strong>Certificaciones:<\/strong>&nbsp;FCC, CE, BSMI, VCCI, RCM, UKCA, EAC, CCC, KC, BIS<\/li><li><strong>Conformidad ambiental:<\/strong>&nbsp;RoHS<\/li><li><strong>Contenido del paquete:<\/strong><ul><li>1x Unidad principal<\/li><li>1x Adaptador de corriente y cable<\/li><li>2x Cables RJ-45 LAN<\/li><li>1x Paquete de accesorios<\/li><\/ul><\/li><li><strong>Accesorios opcionales:<\/strong><ul><li>DDR4 ECC: D4ES04-4G \/ D4ES03-8G \/ D4ES03-16G<\/li><li>Expansi\u00f3n: DX525<\/li><li>HDD Enterprise: Serie HAT5300<\/li><li>HDD Plus: Serie HAT3300<\/li><li>SSD SATA: SAT5200<\/li><li>SSD NVMe: SNV3400 \/ SNV5400<\/li><\/ul><\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SYNOLOGY","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":464.85,"unit_price_tax":464.85,"tax_rules_group":null,"category":"Discos Duros Externos","sub_category":"Discos Duros de Red - NAS","quantity":0,"brand":"SYNOLOGY","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_syn-nas%20ds725%20plus%208gb_1.jpg"],"wholesale_price":457.85}}},"8435797000360":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435797000360",false],"wholesale_price":[661.9,false],"price":[668.9,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:282308","Cat. IDs