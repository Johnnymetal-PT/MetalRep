nes<\/h2><ul>  <li><b>Compatibilidad:<\/b> iOS (Apple Buscar) \/ Android (Google Localizador)<\/li>  <li><b>Certificaci\u00f3n:<\/b> Producto certificado por Apple y Google<\/li>  <li><b>Funcionamiento:<\/b> Sin apps adicionales, con aplicaciones oficiales<\/li>  <li><b>Alertas sonoras:<\/b> S\u00ed, emite sonido potente para localizaci\u00f3n cercana<\/li>  <li><b>Ubicaci\u00f3n v\u00eda mapa:<\/b> S\u00ed, permite ver posici\u00f3n en mapas de Apple y Google<\/li>  <li><b>Modo perdido:<\/b> S\u00ed, con contacto personalizado<\/li>  <li><b>Compartir Tag:<\/b> Puede compartirse con otros usuarios<\/li>  <li><b>Protecci\u00f3n de privacidad:<\/b> Cifrado end-to-end<\/li>  <li><b>Autonom\u00eda de bater\u00eda:<\/b> 200&#8211;300 d\u00edas<\/li>  <li><b>Resistencia:<\/b> IP65 (agua y polvo)<\/li>  <li><b>Localizaci\u00f3n global:<\/b> S\u00ed, gracias a las redes Apple &amp; Google<\/li>  <li><b>Aplicaciones recomendadas:<\/b> Buscar (Apple) \/ Localizador (Google)<\/li>  <li><b>Objetos sugeridos:<\/b> Llaves, bolso, cartera, mochila, equipaje, mascota, bicicleta, coche<\/li><\/ul>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LEOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":0.05,"unit_price":19.6,"unit_price_tax":19.6,"tax_rules_group":null,"category":"SmartWatch - Pulseras","sub_category":"Localizadores TAG","quantity":5,"brand":"LEOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_leo-loc%20letag02bw_1.jpg"],"wholesale_price":12.6}}},"8436588883551":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436588883551",false],"wholesale_price":[12.6,false],"price":[19.6,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"wei