2.depau.es\/articulos\/800\/800\/fixed\/art_can-mult%20mf664cdw_1.jpg"],"wholesale_price":285.04}}},"4549292250411":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4549292250411",false],"wholesale_price":[342.49,false],"price":[349.49,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:288083","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/eed9e3187eb13f88e400f80f7126de8a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Multifunci\u00f3n L\u00e1ser Color Canon i-SENSYS MF752CDW II WiFi\/ D\u00faplex\/ Blanca","category":"Multifunciones  e Impresoras","sub_category":"Multifunciones","unit_price":349.49,"reference":"7185C013","ean13":"4549292250411","weight":"0","quantity":0,"brand":"CANON","description_pt":"                                                                                                                                                <p><\/p><h2>Impresora l\u00e1ser multifunci\u00f3n en color Canon i-SENSYS MF752Cdw II<\/h2><p><\/p><div>La impresora l\u00e1ser en color i-SENSYS MF752Cdw II de Canon es un dispositivo compacto para imprimir y escanear a gran velocidad mediante Wi-Fi, por lo que es ideal para la casa y oficinas dom\u00e9sticas con espacio limitado. Este modelo con un dise\u00f1o f\u00e1cil de usar cuenta con una \u00fatil pantalla LCD de 5 pulgadas que proporciona im\u00e1genes claras. Te ofrece toda la informaci\u00f3n que necesitas con actualizaciones autom\u00e1ticas a los drivers m\u00e1s recientes y asistencia instant\u00e1nea a trav\u00e9s de c\u00f3digos QR en pantalla que redirigen a manuales completos online.<br><\/div><ul>\t<li>Impresora l\u00e1ser en color 3 en 1 para oficina<\/li>\t<li>Impresi\u00f3n, copia y escaneo de documentos A4<\/li>\t<li>Wi-Fi, pantalla LCD de 5 pulgadas y biblioteca de aplicaciones<\/li><\/ul><p><\/p><h2>Ventajas<\/h2><p>Aumenta la productividad en las tareas de oficina con velocidades de impresi\u00f3n y escaneo de hasta 33 ppm y 100 ipm en un dise\u00f1o compacto que se adapta perfectamente a espacios de trabajo reducidos<\/p><p>Genera documentos con una nitidez excepcional y una gran intensidad crom\u00e1tica gracias a la tecnolog\u00eda de t\u00f3ner con una amplia gama de colores que ofrece impresiones de calidad profesional siempre que lo necesitas<\/p><p>Establece los ajustes de protecci\u00f3n necesarios con solo unos toques gracias al intuitivo Security Navigator, que te ofrece una tranquilidad total gracias a la s\u00f3lida seguridad integral con medidas avanzadas como el refuerzo de las contrase\u00f1as, SMB 3.1.1, WPA3, OAuth 2.0 y la integraci\u00f3n de SIEM<\/p><p>Obt\u00e9n asistencia de inmediato gracias a los c\u00f3digos QR en pantalla, que redirigen a manuales completos online para que los usuarios puedan solucionar r\u00e1pidamente los problemas de forma r\u00e1pida y aut\u00f3noma<\/p><p>Optimiza las tareas diarias con la biblioteca de aplicaciones, que ofrece opciones de automatizaci\u00f3n personalizadas para adaptarse a flujos de trabajo \u00fanicos en diferentes sectores<\/p><p>Escanea una gran variedad de documentos, desde papeles en formatos comunes hasta otros m\u00e1s peque\u00f1os como cheques y recibos, para que nada importante se quede fuera<\/p><p>Mant\u00e9n la seguridad y accesibilidad de tus registros empresariales durante a\u00f1os gracias a la compatibilidad con PDF\/A, el formato est\u00e1ndar internacional para el almacenamiento digital seguro de documentos a largo plazo<\/p><p><\/p><h2>Motivos para comprarlo<\/h2><ul>  <li>Equipo 3 en 1: impresi\u00f3n, copia y escaneo en color de alto rendimiento.<\/li>  <li>Alta velocidad de trabajo: hasta 33 ppm en A4 e impresi\u00f3n a doble cara autom\u00e1tica.<\/li>  <li>Escaneado d\u00faplex de una sola pasada con hasta 100 ipm en blanco y negro.<\/li>  <li>Funciones avanzadas de seguridad (impresi\u00f3n segura, cifrado, TLS 1.3, IPSec, filtrado IP\/MAC).<\/li>  <li>Amplias opciones de conectividad: USB, Ethernet, WiFi, Wireless Direct y nube.<\/li>  <li>Admite t\u00f3ner de alto rendimiento (serie 069H) para reducir costes por p\u00e1gina.<\/li>  <li>Panel t\u00e1ctil a color de 12,7 cm y gesti\u00f3n centralizada de flotas con iW Enterprise Management Console.<\/li><\/ul><h2>Especificaciones T\u00e9cnicas<\/h2><ul>  <li><b>Tipo de equipo:<\/b> Equipo l\u00e1ser multifunci\u00f3n en color<\/li>  <li><b>Funciones:<\/b> Impresi\u00f3n, copia y escaneo<\/li>  <li><b>Velocidad de impresi\u00f3n (A4 una cara):<\/b> Hasta 33 ppm<\/li>  <li><b>Velocidad de impresi\u00f3n (A5 horizontal):<\/b> Hasta 60 ppm<\/li>  <li><b>Velocidad de impresi\u00f3n a doble cara (A4):<\/b> Hasta 29,5 ipm<\/li>  <li><b>M\u00e9todo de impresi\u00f3n:<\/b> Impresi\u00f3n l\u00e1ser en color<\/li>  <li><b>Resoluci\u00f3n de impresi\u00f3n:<\/b> Hasta 1200 x 1200 ppp<\/li>  <li><b>Tiempo de calentamiento:<\/b> Aprox. 14 s o menos desde el encendido<\/li>  <li><b>Primera impresi\u00f3n:<\/b> Color aprox. 8,38 s \/ Mono aprox. 8,16 s<\/li>  <li><b>Lenguajes de impresi\u00f3n:<\/b> UFRII, PCL 5c, PCL6<\/li>  <li><b>Fuentes:<\/b> 45 fuentes PCL<\/li>  <li><b>M\u00e1rgenes de impresi\u00f3n:<\/b> 5 mm (sup\/inf\/izq\/der), sobres 10 mm<\/li>  <li><b>Modo ahorro de t\u00f3ner:<\/b> S\u00ed<\/li>  <li><b>Funciones de impresi\u00f3n avanzadas:<\/b> Impresi\u00f3n segura cifrada, impresi\u00f3n segura, impresi\u00f3n desde USB (JPEG\/TIFF\/PDF), impresi\u00f3n desde la nube (Dropbox, Google Drive, OneDrive), Microsoft Universal Print, AirPrint, Mopria, Canon PRINT, IPP Everywhere<\/li>  <li><b>Velocidad de copia (A4 una cara):<\/b> Hasta 33