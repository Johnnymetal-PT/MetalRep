 5.4<\/li>\t<li><b>Red cableada:<\/b> No<\/li>\t<li><b>Puertos:<\/b>&nbsp;<\/li><ul><li>2x USB 3.2 Gen2 Type-A,&nbsp;<\/li><li>2x Thunderbolt 4 (USB-C, DisplayPort Alt Mode, carga),&nbsp;<\/li><li>1x HDMI 2.1,&nbsp;<\/li><li>combo auriculares\/micr\u00f3fono<\/li><\/ul>\t<li><b>Teclado:<\/b> QWERTY Espa\u00f1ol, retroiluminado, sin teclado num\u00e9rico, touchpad<\/li>\t<li><b>Bater\u00eda:<\/b> 63 Wh, 3 celdas, ion de litio<\/li>\t<li><b>Fuente de alimentaci\u00f3n:<\/b> Adaptador AC 65 W (100-240 V, 50-60 Hz, salida 20 V \/ 3,25 A), carga por USB-C, Power Delivery<\/li>\t<li><b>Seguridad:<\/b> Ranura Kensington, lector de huellas, Windows Hello, TPM 2.0, protecci\u00f3n por contrase\u00f1a (BIOS, disco, Usuario)<\/li>\t<li><b>Certificaciones:<\/b> REACH, FSC Recycled, TCO, ENERGY STAR, EPEAT Climate+, EPEAT Gold<\/li>\t<li><b>Dimensiones:<\/b> 312 x 223,2 x 14,9-16,4 mm<\/li>\t<li><b>Peso:<\/b> 1,27 kg<\/li>\t<li><b>Color:&nbsp;<\/b>Misty Grey<\/li><\/ul><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ASUS","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":626,"unit_price_tax":626,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":0,"brand":"ASUS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_asu-p%20p5405csa-nz0718_1.jpg"],"wholesale_price":619}}},"4711636211567":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4711636211567",false],"wholesale_price":[819,false],"price":[826,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features