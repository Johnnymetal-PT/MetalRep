:"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":192.51,"unit_price_tax":192.51,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":0,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-sp%20a336b%206-128%20bk%20v2_1.jpg"],"wholesale_price":187.51}}},"8806095137469":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806095137469",false],"wholesale_price":[452.13,false],"price":[457.13,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Samsung Galaxy S23 FE 8GB\/ 256GB\/ 6,4&#39;\/ 5G\/ Verde Menta"],"result":false},"feed_data":{"name_pt":"Smartphone Samsung Galaxy S23 FE 8GB\/ 256GB\/ 6.4'\/ 5G\/ Verde Menta","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":457.13,"reference":"S711 8-256 GREE V2","ean13":"8806095137469","weight":"0.36","quantity":0,"brand":"SAMSUNG","description_pt":"<p><h2>Lo \u00e9pico empieza aqu\u00ed<\/h2><p>Los momentos m\u00e1s \u00e9picos ya est\u00e1n al alcance de todos. Galaxy S23 FE abre las puertas de lo extraordinario a todo el mundo. Con una bater\u00eda de larga duraci\u00f3n y unas incre\u00edbles fotos nocturnas, este m\u00f3vil es tu aliado para conservar recuerdos \u00e9picos y duraderos.<\/p><h2>Un legado de dise\u00f1o atemporal<\/h2><p>Galaxy S23 FE toma el relevo del ic\u00f3nico dise\u00f1o de Galaxy S23 Series adoptando su est\u00e9tica cl\u00e1sica y muchos de sus elementos pr\u00e1cticos.<\/p><h2>Durabilidad y fiabilidad se dan la mano<\/h2><p>Es un m\u00f3vil hecho para durar, tal y como demuestran el recubrimiento frontal y trasero de Corning\u00ae Gorilla\u00ae Glass 5 y la certificaci\u00f3n IP68 de resistencia al agua y al polvo.<\/p><h2>Fotos \u00e9picas de d\u00eda y de noche<\/h2><p>Captura los mejores momentos de la vida con una c\u00e1mara profesional capaz de convertir tus capturas en obras de arte, tanto de d\u00eda como de noche. Su sensor de alta resoluci\u00f3n permite que tus fotos queden s\u00faper claras y est\u00e9n llenas de detalles.<\/p><h2>Inmortaliza tus noches con todo lujo de detalles<\/h2><p>Reinventa tu forma de percibir el mundo cuando oscurece y empieza a capturarlo con colores vivos y menos ruido.<\/p><h2>Fotos n\u00edtidas y luminosas, tambi\u00e9n con poca luz<\/h2><p>Gracias al potente sistema de c\u00e1maras, tus fotos salen claras y llenas de detalles en todas las condiciones de luz.<\/p><h2>S\u00faper estable y s\u00faper suave, incluso de noche<\/h2><p>No permitas que la falta de luz te frene. Consigue v\u00eddeos nocturnos estables y n\u00edtidos tambi\u00e9n a oscuras con el sistema Nightography.<\/p><h2>El secreto de los selfies m\u00e1s espectaculares<\/h2><p>Muestra tu aut\u00e9ntico yo con la c\u00e1mara frontal y consigue selfies naturales y claros desde cualquier \u00e1ngulo que saquen lo mejor de ti.<\/p><h2>50 MP son sin\u00f3nimo de fotos \u00e9picas<\/h2><p>Empieza a disfrutar tus recuerdos en alta resoluci\u00f3n gracias a una c\u00e1mara capaz de capturar hasta los detalles m\u00e1s sutiles de aquello que te rodea.<\/p><h2>Da vida a tus recuerdos m\u00e1s preciados<\/h2><p>Photo Remaster da un soplo de aire fresco a tus fotos antiguas o borrosas para que disfrutes tus recuerdos tal y como los conservas en la memoria.<\/p><h2>Im\u00e1genes definidas e inmersivas<\/h2><p>La pantalla Dynamic AMOLED 2x hace que los detalles cobren vida, idependientemente de las condiciones de luz, y Eye Comfort Shield reduce la emisi\u00f3n de luz azul para que tus ojos no sufran aunque est\u00e9s a oscuras.<\/p><h2>Ni el sol eclipsa su pantalla<\/h2><p>Vision Booster optimiza los ajustes de la pantalla para ofrecer im\u00e1genes claras incluso a pleno sol. Adem\u00e1s, la tasa de refresco adaptativa de 120 Hz garantiza un scroll fluido para que la experiencia sea inmejorable.<\/p><h2>Rendimiento de otro nivel<\/h2><p>Este dispositivo puede con todo lo que le eches gracias al potente procesador octa-core: hazte una marat\u00f3n de tus series y juegos favoritos o trabaja y graba v\u00eddeos sin despeinarte.<\/p><h2>Bater\u00eda grande, preocupaciones peque\u00f1as<\/h2><p>La bater\u00eda (t\u00edpica) de 4.500 mAh te permite jugar y divertirte sin fin y sin preocuparte por si se agota.<\/p><h2>Carga s\u00faper r\u00e1pida<\/h2><p>\u00bfBater\u00eda baja? No por mucho tiempo. Rec\u00e1rgala r\u00e1pidamente y sin necesidad de cables cuando lo necesites o enchufa el m\u00f3vil al cargador de pared para activar la carga s\u00faper r\u00e1pida y tardar a\u00fan menos.<\/p><p><br><\/p><ul><li><strong>Procesador<\/strong><\/li><li>Velocidad CPU<\/li><li>2.8GHz, 2.5GHz, 1.8GHz<\/li><li>Tipo CPU<\/li><li>Octa-Core<\/li><li>Nombre CPU<\/li><li>Samsung Exynos 2200<\/li><li><strong>Pantalla<\/strong><\/li><li>Tama\u00f1o<\/li><li>163.1mm (6.4' full rectangle) \/ 158.9mm (6.3' rounded corners)<\/li><li>Resoluci\u00f3n<\/li><li>1080 x 2340 (FHD+)<\/li><li>Tecnolog\u00eda<\/li><li>Dynamic AMOLED 2X<\/li><li>N\u00famero de colores<\/li><li>16M<\/li><li>Tasa de refresco m\u00e1x<\/li><li>120 Hz<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara principal - Resoluci\u00f3n (M\u00faltiple)<\/li><li>50.0 MP + 12.0 MP + 8.0 MP<\/li><li>C\u00e1mara principal - Apertura (M\u00faltiple)<\/li><li>F1.8 , F2.2 , F2.4<\/li><li>C\u00e1mara principal - Autofocus<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal - OIS<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal - Zoom<\/li><li>Zoom \u00f3ptico de 3x, Zoom digital hasta 30x<\/li><li>C\u00e1mara frontal - Resoluci\u00f3n<\/li><li>10.0 MP<\/li><li>C\u00e1mara frontal - Apertura<\/li><li>F2.4<\/li><li>C\u00e1mara frontal - Autoenfoque<\/li><li>No<\/li><li>C\u00e1mara principal - Flash<\/li><li>S\u00ed<\/li><li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li><li>UHD 8K (7680 x 4320)@24fps<\/li><li>Slow Motion<\/li><li>960fps @HD, 240fps @FHD<\/li><li><strong>Almacenamiento\/Memoria<\/strong><\/li><li>Memoria_(GB)<\/li><li>8<\/li><li>Almacenamiento (GB)<\/li><li>256<\/li><li><strong>Redes\/Bandas<\/strong><\/li><li>N\u00famero de SIM<\/li><li>Dual-SIM<\/li><li>Tipo de SIM<\/li><li>Nano-SIM (4FF), SIM embebida<\/li><li>Tipo de bandeja de SIM<\/li><li>SIM 1 + SIM 2 o SIM integrada<\/li><li>Infra<\/li><li>2G GSM, 3G WCDMA, 4G LTE FDD, 4G LTE TDD, 5G Sub6 FDD, 5G Sub6 TDD, 5G Sub6 SDL<\/li><li>2G GSM<\/li><li>GSM850, GSM900, DCS1800, PCS1900<\/li><li>3G UMTS<\/li><li>B1(2100), B2(1900), B4(AWS), B5(850), B8(900)<\/li><li>4G FDD LTE<\/li><li>B1(2100), B2(1900), B3(1800), B4(AWS), B5(850), B7(2600), B8(900), B12(700), B17(700), B20(800), B26(850), B28(700), B32(1500), B66(AWS-3)<\/li><li>4G TDD LTE<\/li><li>B38(2600), B40(2300), B41(2500)<\/li><li>5G FDD Sub6<\/li><li>N1(2100), N3(1800), N5(850), N7(2600), N8(900), N20(800), N28(700), N66(AWS-3)<\/li><li>5G TDD Sub6<\/li><li>N38(2600), N40(2300), N41(2500), N77(3700), N78(3500)<\/li><li>5G SDL Sub6<\/li><li>N75(1500+)<\/li><li><strong>Conectividad<\/strong><\/li><li>Interfaz USB<\/li><li>USB Tipo C<\/li><li>Versi\u00f3n USB<\/li><li>USB 3.2 Gen 1<\/li><li>Localizaci\u00f3n<\/li><li>GPS, Glonass, Beidou, Galileo, QZSS<\/li><li>Auriculares<\/li><li>USB Type-C<\/li><li>MHL<\/li><li>No<\/li><li>Wi-Fi<\/li><li>802.11a\/b\/g\/n\/ac\/ax 2.4GHz+5GHz+6GHz, HE160, MIMO, 1024-QAM<\/li><li>Wi-Fi Direct<\/li><li>S\u00ed<\/li><li>Versi\u00f3n Bluetooth<\/li><li>Bluetooth v5.3<\/li><li>NFC<\/li><li>S\u00ed<\/li><li>PC Sync.<\/li><li>Smart Switch (PC version)<\/li><li><strong>Sistema Operativo<\/strong><\/li><li>Android<\/li><li><strong>Informaci\u00f3n general<\/strong><\/li><li>Formato<\/li><li>T\u00e1ctil<\/li><li><strong>Sensores<\/strong><\/li><li>Aceler\u00f3metro, Bar\u00f3metro, Sensor de huella dactilar, Giroscopio, Geomagn\u00e9tico, Hall, Luminosidad, Sensor de proximidad virtual<\/li><li><strong>Especificaciones f\u00edsicas<\/strong><\/li><li>Dimensiones (AlxAnxProf, mm)<\/li><li>158.0 x 76.5 x 8.2<\/li><li>Peso (g)<\/li><li>209<\/li><li><strong>Bater\u00eda<\/strong><\/li><li>Tiempo de uso de Internet (4G) (Horas)<\/li><li>Hasta 19<\/li><li>Tiempo de uso de Internet (Wi-Fi) (Horas)<\/li><li>Hasta 20<\/li><li>Tiempo de reproducci\u00f3n de V\u00eddeo (Horas, Wireless)<\/li><li>Hasta 22<\/li><li>Capacidad de bater\u00eda (mAh, t\u00edpico)<\/li><li>4500<\/li><li>Extra\u00edble<\/li><li>No<\/li><li>Tiempo de reproducci\u00f3n de Audio (Horas, Wireless)<\/li><li>Hasta 69<\/li><li>Tiempo en conversaci\u00f3n (4G LTE) (Horas)<\/li><li>Hasta 39<\/li><li><strong>Audio y V\u00eddeo<\/strong><\/li><li>Soporte est\u00e9reo<\/li><li>S\u00ed<\/li><li>Formatos de reproducci\u00f3n de V\u00eddeo<\/li><li>MP4, M4V, 3GP, 3G2, AVI, FLV, MKV, WEBM<\/li><li>Resoluci\u00f3n de reproducci\u00f3n de V\u00eddeo<\/li><li>UHD 8K (7680 x 4320) @60fps<\/li><li>Formatos de reproducci\u00f3n de Audio<\/li><li>MP3, M4A, 3GA, AAC, OGG, OGA, WAV, AMR, AWB, FLAC, MID, MIDI, XMF, MXMF, IMY, RTTTL, RTX, OTA, DFF, DSF, APE<\/li><li><strong>Servicios y Aplicaciones<\/strong><\/li><li>Compatibilidad Gear<\/li><li>Galaxy Buds2 Pro, Galaxy Buds Pro, Galaxy Buds Live, Galaxy Buds+, Galaxy Buds2, Galaxy Buds, Galaxy Fit2, Galaxy Fit e, Galaxy Fit, Galaxy Watch6, Galaxy Watch5, Galaxy Watch4, Galaxy Watch3, Galaxy Watch, Galaxy Watch Active2, Galaxy Watch Active, Gear Fit2 Pro, Gear Fit2, Gear Sport, Gear S3, Gear S2<\/li><li>Samsung DeX Support<\/li><li>Yes<\/li><li>Bluetooth\u00ae Hearing Aid Support<\/li><li>Android Audio Streaming for Hearing Aid(ASHA)<\/li><li>Mobile TV<\/li><li>No<\/li><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-sp%20s711%208-256%20gree%20v2_1.jpg","wholesale_price":"452.13","unit_price_tax":457.13},"product_model":{"product_data":{"ean13":["8806095137469"],"reference":"S711 8-256 GREE V2","name":{"1":"Smartphone Samsung Galaxy S23 FE 8GB\/ 256GB\/ 6.4'\/ 5G\/ Verde Menta","2":"","3":"","4":""},"description":{"1":"<p><h2>Lo \u00e9pico empieza aqu\u00ed<\/h2><p>Los momentos m\u00e1s \u00e9picos ya est\u00e1n al alcance de todos. Galaxy S23 FE abre las puertas de lo extraordinario a todo el mundo. Con una bater\u00eda de larga duraci\u00f3n y unas incre\u00edbles fotos nocturnas, este m\u00f3vil es tu aliado para conservar recuerdos \u00e9picos y duraderos.<\/p><h2>Un legado de dise\u00f1o atemporal<\/h2><p>Galaxy S23 FE toma el relevo del ic\u00f3nico dise\u00f1o de Galaxy S23 Series adoptando su est\u00e9tica cl\u00e1sica y muchos de sus elementos pr\u00e1cticos.<\/p><h2>Durabilidad y fiabilidad se dan la mano<\/h2><p>Es un m\u00f3vil hecho para durar, tal y como demuestran el recubrimiento frontal y trasero de Corning\u00ae Gorilla\u00ae Glass 5 y la certificaci\u00f3n IP68 de resistencia al agua y al polvo.<\/p><h2>Fotos \u00e9picas de d\u00eda y de noche<\/h2><p>Captura los mejores momentos de la vida con una c\u00e1mara profesional capaz de convertir tus capturas en obras de arte, tanto de d\u00eda como de noche. Su sensor de alta resoluci\u00f3n permite que tus fotos queden s\u00faper claras y est\u00e9n llenas de detalles.<\/p><h2>Inmortaliza tus noches con todo lujo de detalles<\/h2><p>Reinventa tu forma de percibir el mundo cuando oscurece y empieza a capturarlo con colores vivos y menos ruido.<\/p><h2>Fotos n\u00edtidas y luminosas, tambi\u00e9n con poca luz<\/h2><p>Gracias al potente sistema de c\u00e1maras, tus fotos salen claras y llenas de detalles en todas las condiciones de luz.<\/p><h2>S\u00faper estable y s\u00faper suave, incluso de noche<\/h2><p>No permitas que la falta de luz te frene. Consigue v\u00eddeos nocturnos estables y n\u00edtidos tambi\u00e9n a oscuras con el sistema Nightography.<\/p><h2>El secreto de los selfies m\u00e1s espectaculares<\/h2><p>Muestra tu aut\u00e9ntico yo con la c\u00e1mara frontal y consigue selfies naturales y claros desde cualquier \u00e1ngulo que saquen lo mejor de ti.<\/p><h2>50 MP son sin\u00f3nimo de fotos \u00e9picas<\/h2><p>Empieza a disfrutar tus recuerdos en alta resoluci\u00f3n gracias a una c\u00e1mara capaz de capturar hasta los detalles m\u00e1s sutiles de aquello que te rodea.<\/p><h2>Da vida a tus recuerdos m\u00e1s preciados<\/h2><p>Photo Remaster da un soplo de aire fresco a tus fotos antiguas o borrosas para que disfrutes tus recuerdos tal y como los conservas en la memoria.<\/p><h2>Im\u00e1genes definidas e inmersivas<\/h2><p>La pantalla Dynamic AMOLED 2x hace que los detalles cobren vida, idependientemente de las condiciones de luz, y Eye Comfort Shield reduce la emisi\u00f3n de luz azul para que tus ojos no sufran aunque est\u00e9s a oscuras.<\/p><h2>Ni el sol eclipsa su pantalla<\/h2><p>Vision Booster optimiza los ajustes de la pantalla para ofrecer im\u00e1genes claras incluso a pleno sol. Adem\u00e1s, la tasa de refresco adaptativa de 120 Hz garantiza un scroll fluido para que la experiencia sea inmejorable.<\/p><h2>Rendimiento de otro nivel<\/h2><p>Este dispositivo puede con todo lo que le eches gracias al potente procesador octa-core: hazte una marat\u00f3n de tus series y juegos favoritos o trabaja y graba v\u00eddeos sin despeinarte.<\/p><h2>Bater\u00eda grande, preocupaciones peque\u00f1as<\/h2><p>La bater\u00eda (t\u00edpica) de 4.500 mAh te permite jugar y divertirte sin fin y sin preocuparte por si se agota.<\/p><h2>Carga s\u00faper r\u00e1pida<\/h2><p>\u00bfBater\u00eda baja? No por mucho tiempo. Rec\u00e1rgala r\u00e1pidamente y sin necesidad de cables cuando lo necesites o enchufa el m\u00f3vil al cargador de pared para activar la carga s\u00faper r\u00e1pida y tardar a\u00fan menos.<\/p><p><br><\/p><ul><li><strong>Procesador<\/strong><\/li><li>Velocidad CPU<\/li><li>2.8GHz, 2.5GHz, 1.8GHz<\/li><li>Tipo CPU<\/li><li>Octa-Core<\/li><li>Nombre CPU<\/li><li>Samsung Exynos 2200<\/li><li><strong>Pantalla<\/strong><\/li><li>Tama\u00f1o<\/li><li>163.1mm (6.4' full rectangle) \/ 158.9mm (6.3' rounded corners)<\/li><li>Resoluci\u00f3n<\/li><li>1080 x 2340 (FHD+)<\/li><li>Tecnolog\u00eda<\/li><li>Dynamic AMOLED 2X<\/li><li>N\u00famero de colores<\/li><li>16M<\/li><li>Tasa de refresco m\u00e1x<\/li><li>120 Hz<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara principal - Resoluci\u00f3n (M\u00faltiple)<\/li><li>50.0 MP + 12.0 MP + 8.0 MP<\/li><li>C\u00e1mara principal - Apertura (M\u00faltiple)<\/li><li>F1.8 , F2.2 , F2.4<\/li><li>C\u00e1mara principal - Autofocus<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal - OIS<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal - Zoom<\/li><li>Zoom \u00f3ptico de 3x, Zoom digital hasta 30x<\/li><li>C\u00e1mara frontal - Resoluci\u00f3n<\/li><li>10.0 MP<\/li><li>C\u00e1mara frontal - Apertura<\/li><li>F2.4<\/li><li>C\u00e1mara frontal - Autoenfoque<\/li><li>No<\/li><li>C\u00e1mara principal - Flash<\/li><li>S\u00ed<\/li><li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li><li>UHD 8K (7680 x 4320)@24fps<\/li><li>Slow Motion<\/li><li>960fps @HD, 240fps @FHD<\/li><li><strong>Almacenamiento\/Memoria<\/strong><\/li><li>Memoria_(GB)<\/li><li>8<\/li><li>Almacenamiento (GB)<\/li><li>256<\/li><li><strong>Redes\/Bandas<\/strong><\/li><li>N\u00famero de SIM<\/li><li>Dual-SIM<\/li><li>Tipo de SIM<\/li><li>Nano-SIM (4FF), SIM embebida<\/li><li>Tipo de bandeja de SIM<\/li><li>SIM 1 + SIM 2 o SIM integrada<\/li><li>Infra<\/li><li>2G GSM, 3G WCDMA, 4G LTE FDD, 4G LTE TDD, 5G Sub6 FDD, 5G Sub6 TDD, 5G Sub6 SDL<\/li><li>2G GSM<\/li><li>GSM850, GSM900, DCS1800, PCS1900<\/li><li>3G UMTS<\/li><li>B1(2100), B2(1900), B4(AWS), B5(850), B8(900)<