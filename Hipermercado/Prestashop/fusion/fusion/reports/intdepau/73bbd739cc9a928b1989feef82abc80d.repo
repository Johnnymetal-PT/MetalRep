on un pa\u00f1o. Siente la seguridad de una mochila siempre limpia.<\/p><br><\/p><p><h2>Especificaciones<\/h2><p><ul><li>Bolsillos externos Accesorios; 1 acceso r\u00e1pido; RFID; 2 bolsillos para botellas de agua o paraguas<\/li><li>Bolsillos internos Tableta; Accesorios; Port\u00e1til acolchado; Rastreador; Compartimento para bol\u00edgrafos<\/li><li>Caracter\u00edsticas de seguridad Cremalleras con cerradura<\/li><li>Caracter\u00edsticas de viaje Acoplamiento en carrito<\/li><li>Color Negro<\/li><li>Compartimentos Ordenador port\u00e1til; Documento; Principal; Accesorios<\/li><li>Compatibilidad con hardware Sirve para la mayor\u00eda de port\u00e1tiles con diagonal de 17,3 pulgadas.<\/li><li>Sistema de cierre Cremallera&nbsp;<\/li><li>Tama\u00f1o de la pantalla (diagonal) 17.3'<\/li><\/ul><\/p><br><\/p><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HP","supplier":null,"width":null,"height":null,"depth":null,"weight":1.25,"unit_price":28.87,"unit_price_tax":28.87,"tax_rules_group":null,"category":"Accesorios de Portatiles","sub_category":"Mochilas para Portatil","quantity":5,"brand":"HP","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hpap-moc%20renew%20bus%2017_1.jpg"],"wholesale_price":23.87}}},"4573595784960":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["4573595784960",false],"wholesale_price":[38.05,false],"price":[43.05,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Maleta executiva HP Renew para laptops de at\u00e9 16&#39;\/preta"],"