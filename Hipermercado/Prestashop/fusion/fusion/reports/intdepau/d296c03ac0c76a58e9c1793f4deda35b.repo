odo que puedes dejar el tel\u00e9fono a cargar con total tranquilidad.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Sostenibilidad<\/li>  <li>Material de plastico<\/li>  <li>ABS<\/li>  <li>m\u00e9todo de sostenibilidad<\/li>  <li>PCR<\/li>  <li>Contenido reciclado %<\/li>  <li>85 %<\/li>  <li>Caracter\u00edsticas<\/li>  <li>Carga r\u00e1pida<\/li>  <li>S\u00ed<\/li>  <li>Carga r\u00e1pida para marcas<\/li>  <li>Apple, Samsung<\/li>  <li>Accesorios<\/li>  <li>Cable de carga USB&#8209;C<\/li>  <li>Tama\u00f1o y peso<\/li>  <li>Peso total<\/li>  <li>90g<\/li>  <li>Peso de la unidad principal<\/li>  <li>62 gramos<\/li>  <li>Profundidad del producto principal (en mm)<\/li>  <li>100mm<\/li>  <li>Ancho del producto principal (en mm)<\/li>  <li>100mm<\/li>  <li>Altura del producto principal (en mm)<\/li>  <li>8mm<\/li>  <li>Carga inalambrica<\/li>  <li>Certificado por Qi<\/li>  <li>S\u00ed<\/li>  <li>Tecnolog\u00eda de carga inal\u00e1mbrica<\/li>  <li>Qi<\/li>  <li>Versi\u00f3n de tecnolog\u00eda de carga inal\u00e1mbrica<\/li>  <li>Qi 1.2.4<\/li>  <li>Detecci\u00f3n de objetos extra\u00f1os<\/li>  <li>S\u00ed<\/li>  <li>Alimentaci\u00f3n<\/li>  <li>Fuente de alimentaci\u00f3n<\/li>  <li>USB, USB-C<\/li>  <li>Puerto de entrada<\/li>  <li>USB-C<\/li>  <li>Potencia de entrada<\/li>  <li>20W<\/li>  <li>Salida<\/li>  <li>Modos de salida de potencia inal\u00e1mbrica<\/li>  <li>5 W, 7,5 W, 10 W, 15 W<\/li>  <li>Tecnolog\u00eda de carga<\/li>  <li>Carga r\u00e1pida 3.0, USB PD 3.0 + PPS<\/li>  <li>Compatibilidad<\/li>  <li>Tipos de dispositivos compatibles<\/li>  <li>Smartphone<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-car%20viro%20bk_1.jpg","wholesale_price":"12.84","unit_price_tax":17.84},"product_model":{"product_data":{"ean13":["8713439247848"],"reference":"24784","name":{"1":"Cargador Inal\u00e1mbrico Trust Viro\/ 15W","2":"","3":"","4":""},"description":{"1":"<p><h2>Cargador inal\u00e1mbrico r\u00e1pido de 15W<\/h2>Carg