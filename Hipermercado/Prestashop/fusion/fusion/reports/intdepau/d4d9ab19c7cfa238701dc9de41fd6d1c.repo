><li>Servicios de localizaci\u00f3n<\/li><li>GPS + GLONASS + Galileo<\/li><li><strong>Puertos est\u00e1ndar<\/strong><\/li><li>1x USB-C\u00ae 2.0 (admite transferencia de datos y carga)<\/li><li>1x conector combinado para auriculares\/micr\u00f3fono (3,5 mm)<\/li><li>1x ranura para tarjeta<\/li><li><strong>ACCESORIOS<\/strong><\/li><li>Accesorios incluidos<\/li><li>Lenovo\u00ae Tab Pen<\/li><li><strong>CERTIFICACIONES<\/strong><\/li><li>Certificaciones Verdes<\/li><li><strong>ENERG\u00cdA STAR\u00ae 8.0<\/strong><\/li><li>ErP Lote 6<\/li><li>ErP Lote 26<\/li><li>RoHS<\/li><li>Otras certificaciones<\/li><li>T\u00dcV Rheinland\u00ae Luz azul baja (soluci\u00f3n de hardware)<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LENOVO","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":142.42,"unit_price_tax":142.42,"tax_rules_group":null,"category":"Tablets","sub_category":"Tablets","quantity":0,"brand":"LENOVO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_len-tab%20m11%204-128%204g%20gy%20p%20v2_1.jpg"],"wholesale_price":135.42}}},"0197532683013":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0197532683013",false],"wholesale_price":[112.5,false],"price":[119.5,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:283447","Cat. IDs: 196","Associated Categories","Cat. Default: 196","Deleted old images","New images created","Add: \/home\/hipermercado\/public_