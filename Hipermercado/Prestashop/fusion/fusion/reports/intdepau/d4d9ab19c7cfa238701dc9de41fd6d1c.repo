58"],"reference":"7925614","name":{"1":"C\u00e1psula Delta Combo Qualidus + Caramelo para cafeteras Delta\/ Caja de 40","2":"","3":"","4":""},"description":{"1":"<p><h2>Pack 40 c\u00e1psulas compuesto por 30 Qalidus y 10 Caramelo<\/h2><p>Delta Q Qalidus produce un expreso con cuerpo y fuerte presencia en la taza, leve acidez y notas de caramelo.<\/p><p><p>Delta Q Caramelo es un caf\u00e9 de intenso sabor y aroma a caramelo, de textura suave y sabor dulce.<\/p><br><\/p><h2>Especificaciones<\/h2><p><ul><li><b>Tipo de producto<\/b>: Caf\u00e9 en c\u00e1psulas<\/li><li><b>Nombre comercial<\/b>: Pack Delta Q Qalidus + Caramelo<\/li><li><b>Contenido del pack<\/b>: 40 c\u00e1psulas (30 Qalidus + 10 Caramelo)<\/li><li>Variedad 1: Delta Q Qalidus<\/li><li><b>Perfil Qalidus<\/b>: Espresso con cuerpo, fuerte presencia, leve acidez y notas de caramelo<\/li><li>Variedad 2: Delta Q Caramelo<\/li><li><b>Perfil Caramelo<\/b>: Caf\u00e9 de sabor intenso, aroma a caramelo, textura suave y sabor dulce<\/li><li><b>Presentaci\u00f3n<\/b>: C\u00e1psulas compatibles con sistema Delta Q<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"DELTA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.58,"unit_price":20.5,"unit_price_tax":20.5,"tax_rules_group":null,"category":"Cocina","sub_category":"Capsulas de cafe","quantity":5,"brand":"DELTA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_del-cafe%2030%20qua%2010%20caram_1.jpg"],"wholesale_price":13.5}}},"5601082058603":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5601082058603",false],"wholesale_price":[13.88,false],"price":[20.88,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.57",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:283227","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fdd0ca1bb2f1b20d3f281d7c9b9ecbf9.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1psula Delta Q Colombia para cafeteras Delta\/ Caja de 40","category":"Cocina","sub_category":"Capsulas de cafe","unit_price":20.880000000000003,"reference":"7925610","ean13":"5601082058603","weight":"0.57","quantity":2,"brand":"DELTA","description_pt":"<p><h2>Delta Q Colombia<\/h2><p><b>Viaje al sabor de Colombia<\/b><\/p><p>De la elecci\u00f3n y selecci\u00f3n de los mejores granos de caf\u00e9 colombiano nace un nuevo caf\u00e9 \u00fanico y especial. Delta Q Colombia es originario de uno de los mayores productores de caf\u00e9 del mundo y da origen a un caf\u00e9 rico, con cuerpo y dulce, con notas florales y chocolateras.<\/p><p>Enam\u00f3rate de este caf\u00e9 y vive una experiencia sensorial \u00fanica.<\/p><h2>Viaja al sabor de Colombia<\/h2><\/p><p>Colombia es uno de los mayores productores de caf\u00e9 del mundo. La enorme diversidad geogr\u00e1fica y clim\u00e1tica, combinan caracter\u00edsticas muy especiales que le permiten producir uno de los mejores caf\u00e9s del mundo: el suelo muy f\u00e9rtil, de origen volc\u00e1nico, la altitud, el clima (sol y lluvias regulares) y la proximidad al ecuador.<br><\/p><h2>Perfil Sensorial<\/h2><p>Delta Q Colombia es un caf\u00e9 de intensidad 8 que da lugar a un espresso rico, con cuerpo y endulzado, con notas de aroma floral y chocolate.<br><\/p><p><br><\/p><h2>Especificaciones<\/h2><p><p><ul><li><b>Tipo de producto<\/b>: Caf\u00e9 en c\u00e1psulas<\/li><li><b>Nombre comercial:<\/b> Delta Q Colombia<\/li><li><b>Origen<\/b>: Colombia<\/li><li><b>Intensidad<\/b>: 8<\/li><li><b>Tipo de caf\u00e9<\/b>: Espresso<\/li><li><b>Notas de cata<\/b>: Florales, chocolate<\/li><li><b>Perfil sensorial<\/b>: Espresso rico, con cuerpo y dulzor equilibrado<\/li><li><b>Caracter\u00edsticas destacadas<\/b>: Elaborado con granos seleccionados de caf\u00e9 colombiano<\/li><li><b>Altitud del cultivo<\/b>: Alta monta\u00f1a (regi\u00f3n andina)<\/li><li><b>Condiciones clim\u00e1ticas<\/b>: Suelo volc\u00e1nico, lluvias regulares, proximidad al ecuador<\/li><li><b>Presentaci\u00f3n<\/b>: C\u00e1psulas Delta Q<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_del-cafe%20q%20colombia%2040_1.jpg","wholesale_price":"13.88","unit_price_tax":20.880000000000003},"product_model":{"product_data":{"ean13":["5601082058603"],"reference":"7925610","name":{"1":"C\u00e1psula Delta Q Colombia para cafeteras Delta\/ Caja de 40","2":"","3":"","4":""},"description":{"1":"<p><h2>Delta Q Colombia<\/h2><p><b>Viaje al sabor de Colombia<\/b><\/p><p>De la elecci\u00f3n y selecci\u00f3n de los mejores granos de caf\u00e9 colombiano nace un nuevo caf\u00e9 \u00fanico y especial. Delta Q Colombia es originario de uno de los mayores productores de caf\u00e9 del mundo y da origen a un caf\u00e9 rico, con cuerpo y dulce, con notas florales y chocolateras.<\/p><p>Enam\u00f3rate de este caf\u00e9 y vive una experiencia sensorial \u00fanica.<\/p><h2>Viaja al sabor de Colombia<\/h2><\/p><p>Colombia es uno de los mayores productores de caf\u00e9 del mundo. La enorme diversidad geogr\u00e1fica y clim\u00e1tica, combinan caracter\u00edsticas muy especiales que le permiten producir uno de los mejores caf\u00e9s del mundo: el suelo muy f\u00e9rtil, de origen volc\u00e1nico, la altitud, el clima (sol y lluvias regulares) y la proximidad al ecuador.<br><\/p><h2>Perfil Sensorial<\/h2><p>Delta Q Colombia es un caf\u00e9 de intensidad 8 que da lugar a un espresso rico, con cuerpo y endulzado, con notas de aroma floral y chocolate.<br><\/p><p><br><\/p><h2>Especificaciones<\/h2><p><p><ul><li><b>Tipo de producto<\/b>: Caf\u00e9 en c\u00e1psulas<\/li><li><b>Nombre comercial:<\/b> Delta Q Colombia<\/li><li><b>Origen<\/b>: Colombia<\/li><li><b>Intensidad<\/b>: 8<\/li><li><b>Tipo de caf\u00e9<\/b>: Espresso<\/li><li><b>Notas de cata<\/b>: Florales, chocolate<\/li><li><b>Perfil sensorial<\/b>: Espresso rico, con cuerpo y dulzor equilibrado<\/li><li><b>Caracter\u00edsticas destacadas<\/b>: Elaborado con granos seleccionados de caf\u00e9 colombiano<\/li><li><b>Altitud del cultivo<\/b>: Alta monta\u00f1a (regi\u00f3n andina)<\/li><li><b>Condiciones clim\u00e1ticas<\/b>: Suelo volc\u00e1nico, lluvias regulares, proximidad al ecuador<\/li><li><b>Presentaci\u00f3n<\/b>: C\u00e1psulas Delta Q<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"DELTA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.57,"unit_price":20.88,"unit_price_tax":20.88,"tax_rules_group":null,"category":"Cocina","sub_category":"Capsulas de cafe","quantity":2,"brand":"DELTA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_del-cafe%20q%20colombia%2040_1.jpg"],"wholesale_price":13.88}}},"5601082058597":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5601082058597",false],"wholesale_price":[3.48,false],"price":[10.48,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.14",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:283228",