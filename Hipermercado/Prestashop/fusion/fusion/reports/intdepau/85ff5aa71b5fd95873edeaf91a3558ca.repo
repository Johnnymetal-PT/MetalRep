:[13.04,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:82124","Cat. IDs: 77","Associated Categories","Cat. Default: 77","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/9ad477979b16166c91bf6ebe7ae3007c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cargador de Pared Tech One Tech TEC2262\/ 1xUSB Tipo-C + Cable Lightning\/ 3A\/ Blanco","category":"Accesorios de SmartPhones","sub_category":"Cargadores para Smartphones","unit_price":13.04,"reference":"TEC2262","ean13":"8436546593706","weight":"0","quantity":0,"brand":"TECH ONE TECH","description_pt":"<p><ul>  <li>Cargador ultrarr\u00e1pido Power Delivery 3.0 (PD) 20W, color blanco. Carga hasta un 400% m\u00e1s r\u00e1pido que un cargador est\u00e1ndar de 5W. Compatible con dispositivos anteriores. Conector tipo USB-C de 3A.&nbsp; Este cargador permite cargar dispositivos como tabletas, m\u00f3viles, consolas, bater\u00edas, auriculares, etc.&nbsp; &nbsp;<\/li>  <li><b>Compatibilidad<\/b><\/li>  <li>Compatible entre otros en Abril 2021 con iPhone 13, 13 Pro, 12,12 Pro, 12 Pro Max , 12 Mini , iPhone 11, 11 Pro , 11 Pro Max , iPhone SE , XS , XS Max , XR , X , iPhone 8 , 8 Plus, iPad Pro 2018, 2020. Samsung S21 Ultra , S21+ , S21 , S20 Ultra , S20+ , S20, S10 , S10 + , S10e , S9 , S9 + , S8 , S8 + , Note 10, Samsung Galaxy Tab.Xiaomi Redmi Note 9S, Note 8, Note 10, Note 11, Mi12, Mi11, Mi 10, Mi 9. Google Pixel 4, 4XL, 3XL , 2 , 2 XL, Pixel XL, Google Pixel Slate. Microsoft Surface. Huawei Mate 30 Pro \/ Mate 30 \/ Mate 20 Pro \/ Mate 20 \/ P40 Pro \/ P40 \/ P30 Pro \/ P30 \/ nova 7 \/ nova 6 y modelos nuevos a partir de la fecha de publicaci\u00f3n.<\