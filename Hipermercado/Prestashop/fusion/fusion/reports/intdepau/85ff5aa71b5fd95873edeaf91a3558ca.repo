meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GOOGLE","supplier":null,"width":null,"height":null,"depth":null,"weight":1.75,"unit_price":68.8,"unit_price_tax":68.8,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":5,"brand":"GOOGLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_goo-nest%20audio%20ga01586-es_1.jpg"],"wholesale_price":63.8}}},"0193575023625":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0193575023625",false],"wholesale_price":[56.22,false],"price":[61.22,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:82178","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/d7e46e1cf96efbf1feffde4ee5d2b328.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Altavoz Inteligente Google NEST HUB (2\u00aa Generaci\u00f3n) Gris Carb\u00f3n","category":"Altavoces","sub_category":"Altavoces","unit_price":61.22,"reference":"GA01892-IT","ean13":"0193575023625","weight":"1.1","quantity":2,"brand":"GOOGLE","description_pt":"                                                <p><\/p><h2>M\u00fasica. Series. Control sencillo del hogar inteligente.<\/h2><h2>La manera m\u00e1s sencilla de entretenerse.<\/h2>Ponte al d\u00eda con Netflix, reproduce v\u00eddeos de recetas de YouTube, escucha m\u00fasica a trav\u00e9s del altavoz mejorado,2 revive tus momentos favoritos con Google Fotos y mucho m\u00e1s.<p><\/p><p><br><\/p><h2>Sigue escuchando tu contenido en cualquier habitaci\u00f3n.<\/h2>El altavoz mejorado ofrece un 50 % m\u00e1s de graves que el primer Nest Hub. Crea grupos con otros altavoces y pantallas Nest para disfrutar de sonido de calidad en cada habitaci\u00f3n.<p><\/p><p><br><\/p><h2>Solo tienes que mover la mano.<\/h2>Gestos R\u00e1pidos te permite controlar muchas de las funciones de Nest Hub. Puedes reproducir o pausar una canci\u00f3n o un v\u00eddeo, posponer una alarma y parar un temporizador. Gestos R\u00e1pidos usa Motion Sense para detectar el movimiento de tu mano sin utilizar una c\u00e1mara.<p><\/p><p><br><\/p><h2>Ayuda en casa con solo usar la voz<\/h2>Pide a Google que ponga m\u00fasica o un v\u00eddeo, pause una canci\u00f3n, ajuste el volumen y mucho m\u00e1s.<p><\/p><p><br><\/p><h2>Controla tu hogar inteligente<\/h2>Nest Hub te permite controlar tu hogar inteligente desde un mismo lugar y funciona con cientos de dispositivos compatibles.<p><\/p><p><br><\/p><h2>Mant\u00e9n a tu familia conectada.<\/h2>Nest Hub te ayuda a estar preparado y a no perder el ritmo a lo largo del d\u00eda, todos los d\u00edas.<p><\/p><p><br><\/p><h2>Obt\u00e9n noticias e informaci\u00f3n meteorol\u00f3gica.<\/h2>Utiliza la voz para obtener informaci\u00f3n importante al prepararte para la jornada.<br>Anuncia mensajes.<br>Anuncia a todo el mundo que la cena est\u00e1 lista o que es la hora de salir de casa. El mensaje se oir\u00e1 en todos tus altavoces y pantallas Nest.<p><\/p><p><br><\/p><h2>Configura alarmas y temporizadores.<\/h2>Pide a Google que ponga recordatorios, temporizadores y alarmas. Son perfectos para recetas, citas, la hora de hacer los deberes, etc.<p><\/p><p><br><\/p><h2>Te ayuda a relajarte y a despertarte.<\/h2>Te ayuda a despertar con sonidos agradables y el brillo de la pantalla se ajusta a la iluminaci\u00f3n de la habitaci\u00f3n para crear un ambiente adecuado para el descanso en tu dormitorio.<p><\/p><p><br><\/p><h2>Una forma sencilla de obtener informaci\u00f3n sobre tu sue\u00f1o<\/h2>El Sensor de Sue\u00f1o4 usa el movimiento y el sonido para analizar tu sue\u00f1o. Consulta cu\u00e1ndo te vas a la cama, cu\u00e1ndo te levantas y cu\u00e1nto tiempo has descansado.<br>Por la ma\u00f1ana puedes ver en Nest Hub un resumen de tu sue\u00f1o. O puedes preguntar directamente 'Hey Google, \u00bfc\u00f3mo he dormido esta noche?'.<p><\/p><p><br><\/p><h2>Nest Hub respeta tu privacidad.<\/h2>Puedes desactivar el micr\u00f3fono con el interruptor en cualquier momento. Tambi\u00e9n tienes la opci\u00f3n de borrar el historial del Asistente de Google siempre que quieras.<p><\/p><p><br><\/p><h2>Dise\u00f1ado al detalle, por dentro y por fuera.<\/h2>Dise\u00f1o sencillo. Materiales sostenibles.<br>El sencillo dise\u00f1o y los colores sutiles de Nest Hub hacen que encaje en cualquier habitaci\u00f3n. El brillo de la pantalla se ajusta a la iluminaci\u00f3n de la habitaci\u00f3n para que no haya demasiado contraste. Nest Hub est\u00e1 fabricado pensando en el medioambiente: la carcasa est\u00e1 fabricada con un 54 % de pl\u00e1stico reciclado.<div><br><h2>Especificaciones t\u00e9cnicas<\/h2><ul>  <li><b>Dimensiones y peso<\/b><\/li>  <li>Altura: 120,4 mm\u00a0<\/li><li>Anchura: 177,4 mm<\/li>  <li><b>Pantalla<\/b><\/li>  <li>Pantalla t\u00e1ctil de 7 pulgadas<\/li>  <li><b>Altavoz y micr\u00f3fonos<\/b><\/li>  <li>Altavoz de rango completo\u00a0<\/li><li>3 micr\u00f3fonos<\/li>  <li><b>Sensores<\/b><\/li>  <li>Soli\u00a0<\/li><li>Ambient EQ\u00a0<\/li><li>Temperatura<\/li>  <li><b>Puertos<\/b><\/li>  <li>Conector de CC<\/li>  <li><b>Alimentaci\u00f3n<\/b><\/li>  <li>Adaptador de alimentaci\u00f3n de 15 W<\/li>  <li><b>Conectividad<\/b><\/li>  <li>Wi-Fi\u00a0<\/li><li>Bluetooth<\/li><li>Thread<\/li>  <li><b>Procesador<\/b><\/li>  <li>CPU ARM con motor de hardware de aprendizaje autom\u00e1tico<\/li>  <li><b>Sostenibilidad<\/b><\/li>  <li>La carcasa est\u00e1 fabricada con un 54 % de pl\u00e1stico reciclado.<\/li>  <li><b>Idiomas<\/b><\/li>  <li>Idiomas disponibles<\/li>  <li><b>Contenido de la caja<\/b><\/li>  <li>Adaptador de corriente<\/li>  <li>Gu\u00eda de inicio r\u00e1pido<\/li>  <li>Tarjeta de privacidad<\/li>  <li>Manual de seguridad y garant\u00eda<\/li>  <li><b>Requisitos<\/b><\/li>  <li>Toma de corriente cercana<\/li>  <li>Red Wi-Fi<\/li>  <li>Dispositivo m\u00f3vil compatible (Android, iOS)<\/li><\/ul><p><\/p><\/div>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_goo-nest%20hub%202gen%20carbon_1.jpg","wholesale_price":"56.22","unit_price_tax":61.22},"product_model":{"product_data":{"ean13":["0193575023625"],"reference":"GA01892-IT","name":{"1":"Altavoz Inteligente Google NEST HUB (2\u00aa Generaci\u00f3n) Gris Carb\u00f3n","2":"","3":"","4":""},"description":{"1":"                                                <p><\/p><h2>M\u00fasica. Series. Control sencillo del hogar inteligente.<\/h2><h2>La manera m\u00e1s sencilla de entretenerse.<\/h2>Ponte al d\u00eda con Netflix, reproduce v\u00eddeos de recetas de YouTube, escucha m\u00fasica a trav\u00e9s del altavoz mejorado,2 revive tus momentos favoritos con Google Fotos y mucho m\u00e1s.<p><\/p><p><br><\/p><h2>Sigue escuchando tu contenido en cualquier habitaci\u00f3n.<\/h2>El altavoz mejorado ofrece un 50 % m\u00e1s de graves que el primer Nest Hub. Crea grupos con otros altavoces y pantallas Nest para disfrutar de sonido de calidad en cada habitaci\u00f3n.<p><\/p><p><br><\/p><h2>Solo tienes que mover la mano.<\/h2>Gestos R\u00e1pidos te permite controlar muchas de las funciones de Nest Hub. Puedes reproducir o pausar una canci\u00f3n o un v\u00eddeo, posponer una alarma y parar un temporizador. Gestos R\u00e1pidos usa Motion Sense para detectar el movimiento de tu mano sin utilizar una c\u00e1mara.<p><\/p><p><br><\/p><h2>Ayuda en casa con solo usar la voz<\/h2>Pide a Google que ponga m\u00fasica o un v\u00eddeo, pause una canci\u00f3n, ajuste el volumen y mucho m\u00e1s.<p><\/p><p><br><\/p><