 MC1<\/li><li>Sistema operativo - Android 14<\/li><li>WIFI - WiFi 5 (b\/g\/n\/ac\/ax)<\/li><li>Bluetooth - 5.0<\/li><li>Salida de audio -&nbsp; No<\/li><li><b>Pantalla y c\u00e1maras<\/b><\/li><li>Tama\u00f1o - 10,1&#8221;&nbsp;<\/li><li>Relaci\u00f3n de aspecto - 16:10<\/li><li>Tipo - IPS Incell<\/li><li>Resoluci\u00f3n - 1280x800<\/li><li>Multit\u00e1ctil - S\u00ed<\/li><li>C\u00e1mara trasera - 2Mpx<\/li><li>C\u00e1mara frontal - 2Mpx<\/li><li>Flash - S\u00ed<\/li><li>Grabaci\u00f3n de v\u00eddeo - 720p<\/li><li><b>Almacenamiento<\/b><\/li><li>Memoria RAM - 4 GB<\/li><li>Memoria interna - 64 GB<\/li><li>Memoria ampliable - Micro SD de hasta 512 GB<\/li><li>Bater\u00eda, carga y caracter\u00edsticas generales<\/li><li>Bater\u00eda - 5.000mAh (18,5 Wh)&nbsp;<\/li><li>Conexi\u00f3n USB - Conexi\u00f3n USB-C<\/li><li>USB OTG - S\u00ed<\/li><li>Idiomas - M\u00faltiples<\/li><li><b>Dimensiones, peso y contenido de la caja<\/b><\/li><li>Alto - 156 mm<\/li><li>Ancho - 239,7 mm<\/li><li>Fondo - 7,8 mm<\/li><li>Peso - 503 g<\/li><li>SPC GRAVITY, cable USB-C a USB-C y gu\u00eda r\u00e1pida.<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SPC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":90.56,"unit_price_tax":90.56,"tax_rules_group":null,"category":"Tablets","sub_category":"Tablets","quantity":0,"brand":"SPC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-tab%20grav%2010%206th%204-64%20bk_1.jpg"],"wholesale_price":83.56}}},"8436609913434":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436609913434",false],"wholesale_price":[83.56,false],"price":[90.56,false],"id_tax_rules_group":[1,false],"categorys":["1 category