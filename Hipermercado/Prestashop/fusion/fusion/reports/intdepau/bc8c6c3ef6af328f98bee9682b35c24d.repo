r%20ether%202p%20wh_1.jpg"],"wholesale_price":23.66}}},"6922794780224":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6922794780224",false],"wholesale_price":[9.1,false],"price":[14.1,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190628","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/216cd9dc6f5f5495e8423da8f8e8dc61.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Bluetooth Vention AIR A01 NBMN0 con estuche de carga\/ Autonom\u00eda 7h\/ Blancos","category":"Auriculares","sub_category":"Auriculares Bluetooth con estuche de carga","unit_price":14.1,"reference":"NBMN0","ean13":"6922794780224","weight":"0","quantity":0,"brand":"VENTION","description_pt":"<p><h2>Auriculares Bluetooth True Wireless Air A01<\/h2><ul><li>Pantalla LED Inteligente<\/li><li>Bluetooth 5.3<\/li><li>Transmisi\u00f3n de Se\u00f1al Estable<\/li><li>24 Horas de Bater\u00eda<\/li><li>IPX4&nbsp;<\/li><\/ul><h2>Escucha Aumentada<\/h2><p>True Wireless Bluetooth Earbuds<\/p><h2>Estilo de Caja Espacial<\/h2><p>El estilo futur\u00edstico de la caja a\u00f1ade estilo a tu jornada auditiva<\/p><h2>Pantalla LED Inteligente<\/h2><p>Comprueba el nivel de bater\u00eda y su estatus de carga.<\/p><h2>Conexi\u00f3n Estable y Confiable<\/h2><p>Equipado con la ultima versi\u00f3n de Bluetooth 5.3. Est\u00e9 posee una transmisi\u00f3n m\u00e1s r\u00e1pida, menor consumo de energ\u00eda, fuertes anti interferencias, y una conexi\u00f3n Bluetooth m\u00e1s estable que la del Bluetooth 5.0<\/p><h2>24 Horas de Bater\u00eda<\/h2><p>Se puede llevar c\u00f3modamente las 24 horas del d\u00eda, manteni\u00e9ndote en contacto con personas y lugares.<\/p><h2>Rica Experiencia Auditiva<\/h2><p>Driver de 10mm especialmente dise\u00f1ado para producir un rango de frecuencia ancho que descubre detalles ricos cada segundo.<\/p><p>SBC\/AAC Audio Codec<\/p><h2>Resistente al clima y al sudor<\/h2><p>IPX4 puede lidiar con salpicaduras, entrenamientos y d\u00edas lluviosos y mantener el ritmo con tu vida bajo cualquier circunstancia.<\/p><h2>Intuitivo<\/h2><p>Todo en tus puntas de los dedos.<\/p><ul><li><strong>Play \/ Pausa<\/strong>&nbsp; Golpea Ambos Earbuds r\u00e1pidamente&nbsp;(izquierda\/derecha)<\/li><li><strong>Saltar atr\u00e1s<\/strong>&nbsp; &nbsp;Presiona y mant\u00e9n durante 2 segundos (izquierda)<\/li><li><strong>Saltar adelante<\/strong>&nbsp; Presiona y mant\u00e9n durante 2 segundos (derecha)<\/li><li><strong>Incrementa el volumen<\/strong>&nbsp; Golpea una vez (derecho)<\/li><li><strong>Incrementa el volumen<\/strong>&nbsp;Golpea una vez (izquierda)<\/li><li><strong>Contesta una llamada<\/strong>&nbsp;Golpea var\u00edas veces r\u00e1pidamente (izquierda\/derecha)<\/li><li><strong>Termina una llamada<\/strong>&nbsp;Presiona y mant\u00e9n durante 2 segundos (izquierda\/derecha)<\/li><li><strong>Rechaza una llamada<\/strong>&nbsp;Presiona y mant\u00e9n durante 2 segundos (izquierda\/derecha)<\/li><li><strong>Activa el asistente de voz<\/strong>&nbsp;Golpea 3 veces r\u00e1pidamente<\/li><\/ul><div><br><\/div><h2>Especificaciones<\/h2><ul><li>Versi\u00f3n Bluetooth&nbsp;bluetooth 5.3<\/li><li>C\u00f3dec compatible&nbsp;AVRCP\/A2DP\/HFP\/HSP<\/li><li>Alcance efectivo 12m<\/li><li>Banda de frecuencia bluetooth&nbsp;2402MHz-2480MHz<\/li><li>Rango de frecuencia&nbsp;20H2-20KHz<\/li><li>Capacidad de la bater\u00eda de los auriculares&nbsp;40mAh\/0,148Wh<\/li><li>Potencia de entrada de los auriculares&nbsp;5V-500mA<\/li><li>Capacidad de la Bater\u00eda 320 mAh<\/li><li><strong>Accesorios&nbsp;<\/strong>Cable USB-C a USB (0,3 m) x 1, almohadillas para los o\u00eddos x 3<\/li><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-aur%20air%20a01%20nbmn0_1.jpg","wholesale_price":"9.10","unit_price_tax":14.1},"product_model":{"product_data":{"ean13":["6922794780224"],"reference":"NBMN0","name":{"1":"Auriculares Bluetooth Vention AIR A01 NBMN0 con estuche de carga\/ Autonom\u00eda 7h\/ Blancos","2":"","3":"","4":""},"description":{"1":"<p><h2>Auriculares Bluetooth True Wireless Air A01<\/h2><ul><li>Pantalla LED Inteligente<\/li><li>Bluetooth 5.3<\/li><li>Transmisi\u00f3n de Se\u00f1al Estable<\/li><li>24 Horas de Bater\u00eda<\/li><li>IPX4&nbsp;<\/li><\/ul><h2>Escucha Aumentada<\/h2><p>True Wireless Bluetooth Earbuds<\/p><h2>Estilo de Caja Espacial<\/h2><p>El estilo futur\u00edstico de la caja a\u00f1ade estilo a tu jornada auditiva<\/p><h2>Pantalla LED Inteligente<\/h2><p>Comprueba el nivel de bater\u00eda y su estatus de carga.<\/p><h2>Conexi\u00f3n Estable y Confiable<\/h2><p>Equipado con la ultima versi\u00f3n de Bluetooth 5.3. Est\u00e9 posee una transmisi\u00f3n m\u00e1s r\u00e1pida, menor consumo de energ\u00eda, fuertes anti interferencias, y una conexi\u00f3n Bluetooth m\u00e1s estable que la del Bluetooth 5.0<\/p><h2>24 Horas de Bater\u00eda<\/h2><p>Se puede llevar c\u00f3modamente las 24 horas del d\u00eda, manteni\u00e9ndote en contacto con personas y lugares.<\/p><h2>Rica Experiencia Auditiva<\/h2><p>Driver de 10mm especialmente dise\u00f1ado para producir un rango de frecuencia ancho que descubre detalles ricos cada segundo.<\/p><p>SBC\/AAC Audio Codec<\/p><h2>Resistente al clima y al sudor<\/h2><p>IPX4 puede lidiar con salpicaduras, entrenamientos y d\u00edas lluviosos y mantener el ritmo con tu vida bajo cualquier circunstancia.<\/p><h2>Intuitivo<\/h2><p>Todo en tus puntas de los dedos.<\/p><ul><li><strong>Play \/ Pausa<\/strong>&nbsp; Golpea Ambos Earbuds r\u00e1pidamente&nbsp;(izquierda\/derecha)<\/li><li><strong>Saltar atr\u00e1s<\/strong>&nbsp; &nbsp;Presiona y mant\u00e9n durante 2 segundos (izquierda)<\/li><li><strong>Saltar adelante<\/strong>&nbsp; Presiona y mant\u00e9n durante 2 segundos (derecha)<\/li><li><strong>Incrementa el volumen<\/strong>&nbsp; Golpea una vez (derecho)<\/li><li><strong>Incrementa el volumen<\/strong>&nbsp;Golpea una vez (izquierda)<\/li><li><strong>Contesta una llamada<\/strong>&nbsp;Golpea var\u00edas veces r\u00e1pidamente (izquierda\/derecha)<\/li><li><strong>Termina una llamada<\/strong>&nbsp;Presiona y mant\u00e9n durante 2 segundos (izquierda\/derecha)<\/li><li><strong>Rechaza una llamada<\/strong>&nbsp;Presiona y mant\u00e9n durante 2 segundos (izquierda\/derecha)<\/li><li><strong>Activa el asistente de voz<\/strong>&nbsp;Golpea 3 veces r\u00e1pidamente<\/li><\/ul><div><br><\/div><h2>Especificaciones<\/h2><ul><li>Versi\u00f3n Bluetooth&nbsp;bluetooth 5.3<\/li><li>C\u00f3dec compatible&nbsp;AVRCP\/A2DP\/HFP\/HSP<\/li><li>Alcance efectivo 12m<\/li><li>Banda de frecuencia bluetooth&nbsp;2402MHz-2480MHz<\/li><li>Rango de frecuencia&nbsp;20H2-20KHz<\/li><li>Capacidad de la bater\u00eda de los auriculares&nbsp;40mAh\/0,148Wh<\/li><li>Potencia de entrada de los auriculares&nbsp;5V-500mA<\/li><li>Capacidad de la Bater\u00eda 320 mAh<\/li><li><strong>Accesorios&nbsp;<\/strong>Cable USB-C a USB (0,3 m) x 1, almohadillas para los o\u00eddos x 3<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":14.1,"unit_price_tax":14.1,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares Bluetooth con estuche de carga","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-aur%2