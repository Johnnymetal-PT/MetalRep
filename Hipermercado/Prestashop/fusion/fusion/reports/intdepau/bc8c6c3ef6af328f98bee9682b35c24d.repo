:"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"FELLOWES","supplier":null,"width":null,"height":null,"depth":null,"weight":1.75,"unit_price":15.53,"unit_price_tax":15.53,"tax_rules_group":null,"category":"Material de Oficina","sub_category":"Encuadernaci\u00f3n, Plastificaci\u00f3n","quantity":2,"brand":"FELLOWES","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_fell-portada%205476603_1.jpg"],"wholesale_price":10.53}}},"8411796117117":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8411796117117",false],"wholesale_price":[10.82,false],"price":[15.82,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190716","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d5030b4e78d2f264a462434e995c72d0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Sart\u00e9n Bra Next A122118\/ \u00d818cm\/ Aluminio fundido\/ Apta para Inducci\u00f3n","category":"Menaje de Hogar","sub_category":"Sartenes","unit_price":15.82,"reference":"A122118","ean13":"8411796117117","weight":"0","quantity":0,"brand":"BRA","description_pt":"<p>La sart\u00e9n Next combina una gran antiadherencia con una superficie ultra resistente y un fondo difusor m\u00e1s amplio, para una mayor eficiencia energ\u00e9tica y un rendimiento excepcional en la cocina con los mejores resultados. Es una sart\u00e9n fuerte y muy resistente, gracias a su cuerpo fabricado en aluminio forjado y a la calidad superior de su antiadherente tricapa Eclipse&#8482; de PPG\u00ae reforzado y libre de PFOA.<br><br>Es apta para todas las fuentes de calor (incluida la inducci\u00f3n) gracias a su amplio fondo difusor full induction, que proporciona una mayor y m\u00e1s duradera transmisi\u00f3n del calor, permitiendo finalizar la cocci\u00f3n con el fuego apagado, consiguiendo el aprovechamiento m\u00e1ximo de la energ\u00eda para una cocina m\u00e1s eficiente y el resultado perfecto de todas nuestras recetas.<br><br>Su excelente antiadherencia proporciona un rendimiento excepcional, permitiendo cocinar sin o con muy poco aceite, para unos resultados m\u00e1s saludables.<br><br>Con un dise\u00f1o moderno, los detalles de su mango ergon\u00f3mico y el cuerpo exterior en color rojo le confieren un aspecto muy actual. Es una sart\u00e9n con una gran relaci\u00f3n calidad-precio.<\/p><p><br><ul>  <li><b>Materiales<\/b><\/li>  <li>Fabricada en aluminio forjado extremadamente resistente a la deformaci\u00f3n (4 mm de espesor en la base) y 100% reciclable.<\/li>  <li>Revestimiento antiadherente tricapa Eclipse&#8482; de PPG\u00ae reforzado, ultra resistente y libre de PFOA.<\/li>  <li>Fondo full induction system compatible con todas las fuentes de calor incluida la inducci\u00f3n, que proporciona un mayor ahorro energ\u00e9tico.<\/li>  <li>Mango ergon\u00f3mico con detalles en color rojo.Cuerpo exterior en color rojo.<\/li>  <li>Superficie ultra resistente. Sart\u00e9n de larga vida de duraci\u00f3n.<\/li>  <li>F\u00e1cil limpieza exterior e interior.<\/li>  <li>Dise\u00f1ada en Espa\u00f1a.<\/li>  <li><b>Usos<\/b><\/li>  <li>Lavavajillas, El\u00e9ctrica, Gas, Vitrocer\u00e1mica, Inducci\u00f3n.<\/li>  <li><b>Especificaciones<\/b><\/li>  <li>Dimensiones&nbsp; <\/li>  <li>37.00cm (Largo) x 19.00cm (Ancho) x 4.90cm (Alto)<\/li>  <li>Diametro&nbsp; <\/li>  <li>18 cm<\/li>  <li>Diametro base inducci\u00f3n&nbsp; <\/li>  <li>13 cm<\/li>  <li>Espesor base&nbsp;   <\/li><li>4 mm.<\/li>  <li>Peso&nbsp;   <\/li><li>663 g<\/li>  <li>Colecci\u00f3n&nbsp;   <\/li><li>Next<\/li>  <li>Color&nbsp;   <\/li><li>Negro y rojo<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-sarten%20next%2018cm_1.jpg","wholesale_price":"10.82","unit_price_tax":15.82},"product_model":{"product_data":{"ean13":["8411796117117"],"reference":"A122118","name":{"1":"Sart\u00e9n Bra Next A122118\/ \u00d818cm\/ Aluminio fundido\/ Apta para Inducci\u00f3n","2":"","3":"","4":""},"description":{"1":"<p>La sart\u00e9n Next combina una gran antiadherencia con una superficie ultra resistente y un fondo difusor m\u00e1s amplio, para una mayor eficiencia energ\u00e9tica y un rendimiento excepcional en la cocina con los mejores resultados. Es una sart\u00e9n fuerte y muy resistente, gracias a su cuerpo fabricado en aluminio forjado y a la calidad superior de su antiadherente tricapa Eclipse&#8482; de PPG\u00ae reforzado y libre de PFOA.<br><br>Es apta para todas las fuentes de calor (incluida la inducci\u00f3n) gracias a su amplio fondo difusor full induction, que proporciona una mayor y m\u00e1s duradera transmisi\u00f3n del calor, permitiendo finalizar la cocci\u00f3n con el fuego apagado, consiguiendo el aprovechamiento m\u00e1ximo de la energ\u00eda para una cocina m\u00e1s eficiente y el resultado perfecto de todas nuestras recetas.<br><br>Su excelente antiadherencia proporciona un rendimiento excepcional, permitiendo cocinar sin o con muy poco aceite, para unos resultados m\u00e1s saludables.<br><br>Con un dise\u00f1o moderno, los detalles de su mango ergon\u00f3mico y el cuerpo exterior en color rojo le confieren un aspecto muy actual. Es una sart\u00e9n con una gran relaci\u00f3n calidad-precio.<\/p><p><br><ul>  <li><b>Materiales<\/b><\/li>  <li>Fabricada en aluminio forjado extremadamente resistente a la deformaci\u00f3n (4 mm de espesor en la base) y 100% reciclable.<\/li>  <li>Revestimiento antiadherente tricapa Eclipse&#8482; de PPG\u00ae reforzado, ultra resistente y libre de PFOA.<\/li>  <li>Fondo full induction system compatib