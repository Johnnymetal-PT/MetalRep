ol remoto para tomar fotos, buscar anillo, control por gestos, juegos, ciclo menstrual, Indicador LED<\/li><\/ul><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LEOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":0.1,"unit_price":37.73,"unit_price_tax":37.73,"tax_rules_group":null,"category":"SmartWatch - Pulseras","sub_category":"Anillos Inteligentes","quantity":2,"brand":"LEOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_leo-anillo%20lesr02s11%20sv_1.jpg"],"wholesale_price":30.73}}},"8429015017988":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8429015017988",false],"wholesale_price":[24.89,false],"price":[31.89,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:271335","Cat. IDs: 195,71","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/74c3da21837b2a0b6969b30e8499eb77.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Reproductor MP4 Sunstech IbizaBT\/ 8GB\/ Pantalla 1.8'\/ Radio FM\/ Negro","category":"Sonido","sub_category":"Reproductores de MP4","unit_price":31.89,"reference":"IBIZABT8GBBK","ean13":"8429015017988","weight":"0","quantity":0,"brand":"SUNSTECH","description_pt":"<p><\/p><h2>IBIZABT<\/h2><p>Pr\u00e1ctico y compacto MP4 con Bluetooth y funci\u00f3n pod\u00f3metro, auricular (3,5 mm) y