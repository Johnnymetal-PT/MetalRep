","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LG","supplier":null,"width":null,"height":null,"depth":null,"weight":5.3,"unit_price":105.8,"unit_price_tax":105.8,"tax_rules_group":null,"category":"Monitores","sub_category":"Monitores","quantity":5,"brand":"LG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lg-m%2027ms500-b_1.jpg"],"wholesale_price":100.8}}},"8806084826046":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806084826046",false],"wholesale_price":[263.54,false],"price":[268.54,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: LG UltraFine 32UR550-B 31,5&#39;\/ 4K\/ Multim\u00eddia\/ Monitor Profissional Preto"],"result":false},"feed_data":{"name_pt":"Monitor Profesional LG UltraFine 32UR550-B 31.5'\/ 4K\/ Multimedia\/ Negro","category":"Monitores","sub_category":"Monitores","unit_price":268.54,"reference":"32UR550-B","ean13":"8806084826046","weight":"0","quantity":0,"brand":"LG","description_pt":"                                                <h2>Monitor HDR UHD 4K de 31,5&#8221;<\/h2><p>Monitor UHD Polivalente (Panel VA: 3840x2160,250nit,3000:1,DCI-P3 90%,4ms,60Hz) Diag.80 Entradas: HDMI x2 DP x1.<\/p><p><\/p><h2>Detalles dominados<\/h2><p>Experimente una claridad visual sorprendente y colores vibrantes con el monitor LG UHD 4K HDR. Con su amplia pantalla de 31,5 pulgadas, puedes trabajar de manera eficiente y sumergirte en la transmisi\u00f3n.<\/p><h2>Juegos inmersivos<\/h2><p>32UR550 no solo brinda emoci\u00f3n con su imagen decente y sonido est\u00e9reo (con Waves MaxxAudio\u00ae), sino que tambi\u00e9n ofrece AMD FreeSync&#8482;, Dynamic Action Sync y Black Stabilizer para una experiencia de juego realista.<\/p><h2>Movimiento fluido y r\u00e1pido.<\/h2><p>Con la tecnolog\u00eda AMD FreeSync&#8482;, los jugadores pueden disfrutar de movimientos fluidos y claros en juegos de alta resoluci\u00f3n y ritmo r\u00e1pido. Pr\u00e1cticamente elimina el desgarro y el tartamudeo de la pantalla, brindando una experiencia de juego inmersiva.<\/p><h2>Reaccionar r\u00e1pidamente<\/h2><p>Al reducir el retraso de entrada con Dynamic Action Sync, los jugadores pueden captar momentos cr\u00edticos en tiempo real y responder r\u00e1pidamente.<\/p><h2>Da un paso adelante en la oscuridad<\/h2><p>Black Stabilizer ayuda a los jugadores a detectar francotiradores que acechan en los rincones m\u00e1s oscuros y navegar r\u00e1pidamente por explosiones repentinas.<\/p><h2>Esplendor visual<\/h2><p>Descubra contenido HDR de varios servicios de transmisi\u00f3n y disfrute de un brillo v\u00edvido y una amplia gama de colores en el monitor LG UHD 4K. Con la tecnolog\u00eda HDR compatible con el espacio de color DCI-P3, sum\u00e9rgete en im\u00e1genes impresionantes que dan vida a tu entretenimiento.<\/p><h2>Control optimizado<\/h2><p>Controle f\u00e1cilmente la configuraci\u00f3n de la pantalla con unos pocos clics utilizando el software OnScreen Control. Tambi\u00e9n puedes dividir f\u00e1cilmente toda el \u00e1rea de visualizaci\u00f3n con Screen Split.<\/p><h2>F\u00e1cil y c\u00f3modo<\/h2><p>Logre una posici\u00f3n adecuada con el soporte ergon\u00f3mico: ajuste f\u00e1cilmente la altura, la inclinaci\u00f3n y el giro para lograr una experiencia de visualizaci\u00f3n ideal.<\/p><p><\/p><p><br><\/p><p><\/p><p><\/p><ul><li><b>DIMENSION\/PESO\u00a0<\/b><\/li><li>Dimensiones con peana (Ancho x Alto x Profundo) [mm]<\/li><li>714.3x597.1x239.3(&#8593;)<\/li><li>Dimensiones sin peana (Ancho x Alto x Profundo) [mm]<\/li><li>714.3x420.1x45.7<\/li><li>Dimensiones empaquetado (Ancho x Alto x Profundo) [mm]<\/li><li>821x507x226<\/li><li>Peso con Peana [kg]<\/li><li>7<\/li><li>Peso sin Peana [kg]<\/li><li>5.2<\/li><li>Peso empaquetado [kg]<\/li><li>10.1<\/li><li><b>CARACTERISTICAS<\/b><\/li><li>HDR 10<\/li><li>S\u00ed<\/li><li>Modo de lectura<\/li><li>S\u00ed<\/li><li>Debilidad de Color<\/li><li>S\u00ed<\/li><li>Super Resolution+<\/li><li>S\u00ed<\/li><li>AMD FreeSync&#8482;<\/li><li>S\u00ed<\/li><li>Dynamic Action Sync<\/li><li>S\u00ed<\/li><li>Ahorro inteligente de energia<\/li><li>S\u00ed<\/li><li><b>POTENCIA<\/b><\/li><li>Entrada CA<\/li><li>100~240V (50\/60Hz)<\/li><li>Consumo de potencia (Tip)<\/li><li>45W<\/li><li>Consumo de potencia (Modo suspension)<\/li><li>0,5 W<\/li><li>Consumo de potencia (DC apagado)<\/li><li>Inferior a 0,3 W<\/li><li><b>CONECTIVIDAD<\/b><\/li><li>HDMI<\/li><li>S\u00ed (2ea)<\/li><li>DisplayPort<\/li><li>S\u00ed (1ea)<\/li><li>Version DP<\/li><li>1.4<\/li><li>Puerto USB de Subida<\/li><li>S\u00ed (1ea\/ver3.0)<\/li><li>Puerto USB de Bajada<\/li><li>S\u00ed (2ea\/ver3.0)<\/li><li>Salida para Auriculares<\/li><li>3 polos (Solo sonido)<\/li><li><b>PANTALLA<\/b><\/li><li>Tama\u00f1o [Pulgada]<\/li><li>31.5<\/li><li>Tama\u00f1o [cm]<\/li><li>80<\/li><li>Resoluci\u00f3n<\/li><li>3840 x 2160<\/li><li>Tipo de Panel<\/li><li>VA<\/li><li>Ratio de Aspecto<\/li><li>16:09<\/li><li>Tamano del pixel [mm]<\/li><li>0.06053 x 0.18159<\/li><li>Brillo (Min.)[cd\/m\u00b2]<\/li><li>200<\/li><li>Brillo (Tip.)[cd\/m\u00b2]<\/li><li>250<\/li><li>Gama de Color (Min.)<\/li><li>DCI-P3 80%(CIE1976)<\/li><li>Gama de Color (Tip.)<\/li><li>DCI-P3 90% (CIE1976)<\/li><li>Profundidad de Color (Numero de colores)<\/li><li>1.07B<\/li><li>Ratio de Contraste (Min.)<\/li><li>2100:01:00<\/li><li>Ratio de contraste(Tip.)<\/li><li>3000:01:00<\/li><li>Tiempo de respuesta<\/li><li>4ms (GtG en Faster)<\/li><li>Angulo de vision (CR&#8805;10)<\/li><li>178\u00b0(R\/L), 178\u00b0(U\/D)<\/li><li><b>APLICACION SW<\/b><\/li><li>Control Dual<\/li><li>S\u00ed<\/li><li>OnScreen Control (LG Screen Manager)<\/li><li>S\u00ed<\/li><li><b>SOUND<\/b><\/li><li>Altavoces S\u00ed<\/li><li>Potencia Altavoces 5W<\/li><li>N de altavoces x2<\/li><li>Maxx Audio S\u00ed<\/li><li><b>MECANICO<\/b><\/li><li>Ajustes de posici\u00f3n de la pantalla<\/li><li>Inclinaci\u00f3n \/ Altura \/ Orientaci\u00f3n<\/li><li>Montaje en pared [mm]<\/li><li>100 x 100 mm<\/li><li><b>ACCESORIO<\/b><\/li><li>HDMI<\/li><li>S\u00ed<\/li><li><b>UNIDAD DE SENSOR (PANEL)<\/b><\/li><li>Salida de Datos<\/li><li>5W x 2<\/li><\/ul><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lg-m%2032ur550-b_1.jpg","wholesale_price":"263.54","unit_price_tax":268.54},"product_model":{"product_data":{"ean13":["8806084826046"],"reference":"32UR550-B","name":{"1":"Monitor Profesional LG UltraFine 32UR550-B 31.5'\/ 4K\/ Multimedia\/ Negro","2":"","3":"","4":""},"description":{"1":"                                                <h2>Monitor HDR UHD 4K de 31,5&#8221;<\/h2><p>Monitor UHD Polivalente (Panel VA: 3840x2160,250nit,3000:1,DCI-P3 90%,4ms,60Hz) Diag.80 Entradas: HDMI x2 DP x1.<\/p><p><\/p><h2>Detalles dominados<\/h2><p>Experimente una claridad visual sorprendente y colores vibrantes con el monitor LG UHD 4K HDR. Con su amplia pantalla de 31,5 pulgadas, puedes trabajar de manera eficiente y sumergirte en la transmisi\u00f3n.<\/p><h2>Juegos inmersivos<\/h2><p>32UR550 no solo brinda emoci\u00f3n con su imagen decente y sonido est\u00e9reo (con Waves MaxxAudio\u00ae), sino que tambi\u00e9n ofrece AMD FreeSync&#8482;, Dynamic Action Sync y Black Stabilizer para una experiencia de juego realista.<\/p><h2>Movimiento fluido y r\u00e1pido.<\/h2><p>Con la tecnolog\u00eda AMD FreeSync&#8482;, los jugadores pueden disfrutar de movimientos fluidos y claros en juegos de alta resoluci\u00f3n y ritmo r\u00e1pido. Pr\u00e1cticamente elimina el desgarro y el tartamudeo de la pantalla, brindando una experiencia de juego inmersiva.<\/p><h2>Reaccionar r\u00e1pidamente<\/h2><p>Al reducir el retraso de entrada con Dynamic Action Sync, los jugadores pueden captar momentos cr\u00edticos en tiempo real y responder r\u00e1pidamente.<\/p><h2>Da un paso adelante en la oscuridad<\/h2><p>Black Stabilizer ayuda a los jugadores a detectar francotiradores que acechan en los rincones m\u00e1s oscuros y navegar r\u00e1pidamente por explosiones repentinas.<\/p><h2>Esplendor visual<\/h2><p>Descubra contenido HDR de varios servicios de transmisi\u00f3n y disfrute de un brillo v\u00edvido y una amplia gama de colores en el monitor LG UHD 4K. Con la tecnolog\u00eda HDR compatible con el espacio de color DCI-P3, sum\u00e9rgete en im\u00e1genes impresionantes que dan vida a tu entretenimiento.<\/p><h2>Control optimizado<\/h2><p>Controle f\u00e1cilmente la configuraci\u00f3n de la pantalla con unos pocos clics utilizando el software OnScreen Control. Tambi\u00e9n puedes dividir f\u00e1cilmente toda el \u00e1rea de visualizaci\u00f3n con Screen Split.<\/p><h2>F\u00e1cil y c\u00f3modo<\/h2><p>Logre una posici\u00f3n adecuada con el soporte ergon\u00f3mico: ajuste f\u00e1cilmente la altura, la inclinaci\u00f3n y el giro para lograr una experiencia de visualizaci\u00f3n ideal.<\/p><p><\/p><p><br><\/p><p><\/p><p><\/p><ul><li><b>DIMENSION\/PESO\u00a0<\/b><\/li><li>Dimensiones con peana (Ancho x Alto x Profundo) [mm]<\/li><li>714.3x597.1x239.3(&#8593;)<\/li><li>Dimensiones sin peana (Ancho x Alto x Profundo) [mm]<\/li><li>714.3x420.1x45.7<\/li><li>Dimensiones empaquetado (Ancho x Alto x Profundo) [mm]<\/li><li>821x507x226<\/li><li>Peso con Peana [kg]<\/li><li>7<\/li><li>Peso sin Peana [kg]<\/li><li>5.2<\/li><li>Peso empaquetado [kg]<\/li><li>10.1<\/li><li><b>CARACTERISTICAS<\/b><\/li><li>HDR 10<\/li><li>S\u00ed<\/li><li>Modo de lectura<\/li><li>S\u00ed<\/li><li>Debilidad de Color<\/li><li>S\u00ed<\/li><li>Super Resolution+<\/li><li>S\u00ed<\/li><li>AMD FreeSync&#8482;<\/li><li>S\u00ed<\/li><li>Dynamic Action Sync<\/li><li>S\u00ed<\/li><li>Ahorro inteligente de energia<\/li><li>S\u00ed<\/li><li><b>POTENCIA<\/b><\/li><li>Entrada CA<\/li><li>100~240V (50\/60Hz)<\/li><li>Consumo de potencia (Tip)<\/li><li>45W<\/li><li>Consumo de potencia (Modo suspension)<\/li><li>0,5 W<\/li><li>Consumo de potencia (DC apagado)<\/li><li>Inferior a 0,3 W<\/li><li><b>CONECTIVIDAD<\/b><\/li><li>HDMI<\/li><li>S\u00ed (2ea)<\/li><li>DisplayPort<\/li><li>S\u00ed (1ea)<\/li><li>Version DP<\/li><li>1.4<\/li><li>Puerto USB de Subida<\/li><li>S\u00ed (1ea\/ver3.0)<\/li><li>Puerto USB de Bajada<\/li><li>S\u00ed (2ea\/ver3.0)<\/li><li>Salida para Auriculares<\/li><li>3 polos (Solo sonido)<\/li><li><b>PANTALLA<\/b><\/li><li>Tama\u00f1o [Pulgada]<\/li><li>31.5<\/li><li>Tama\u00f1o [cm]<\/li><li>80<\/li><li>Resoluci\u00f3n<\/li><li>3840 x 2160<\/li><li>Tipo de Panel<\/li><li>VA<\/li><li>Ratio de Aspecto<\/li><li>16:09<\/li><li>Tamano del pixel [mm]<\/li><li>0.06053 x 0.18159<\/li><li>Brillo (Min.)[cd\/m\u00b2]<\/li><li>200<\/li><li>Brillo (Tip.)[cd\/m\u00b2]<\/li><li>250<\/li><li>Gama de Color (Min.)<\/li><li>DCI-P3 80%(CIE1976)<\/li><li>Gama de Color (Tip.)<\/li><li>DCI-P3 90% (CIE1976)<\/li><li>Profundidad de Color (Numero de colores)<\/li><li>1.07B<\/li><li>Ratio de Contraste (Min.)<\/li><li>2100:01:00<\/li><li>Ratio de contraste(Tip.)<\/li><li>3000:01:00<\/li><li>Tiempo de respuesta<\/li><li>4ms (GtG en Faster)<\/li><li>Angulo de vision (CR&#8805;10)<\/li><li>178\u00b0(R\/L), 178\u00b0(U\/D)<\/li><li><b>APLICACION SW<\/b><\/li><li>Control Dual<\/li><li>S\u00ed<\/li><li>OnScreen Control (LG Screen Manager)<\/li><li>S\u00ed<\/li><li><b>SOUND<\/b><\/li><li>Altavoces S\u00ed<\/li><li>Potencia Altavoces 5W<\/li><li>N de altavoces x2<\/li><li>Maxx Audio S\u00ed<\/li><li><b>MECANICO<\/b><\/li><li>Ajustes de posici\u00f3n de la pantalla<\/li><li>Inclinaci\u00f3n \/ Altura \/ Orientaci\u00f3n<\/li><li>Montaje en pared [mm]<\/li><li>100 x 100 mm<\/li><li><b>ACCESORIO<\/b><\/li><li>HDMI<\/li><li>S\u00ed<\/li><li><b>UNIDAD DE SENSOR (PANEL)<\/b><\/li><li>Salida de Datos<\/li><li>5W x 2<\/li><\/ul><p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":268.54,"unit_price_tax":268.54,"tax_rules_group":null,"category":"Monitores","sub_category":"Monitores","quantity":0,"brand":"LG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lg-m%2032ur550-b_1.jpg"],"wholesale_price":263.54}}},"0195908882510":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195908882510",false],"wholesale_price":[85.58,false],"price":[90.58,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:179587","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/f92bc5975827d9fa031a00535cd6421c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Multifunci\u00f3n HP Envy Inspire 7220e WiFi\/ D\u00faplex\/ Blanca","category":"Multifunciones  e Impresoras","sub_category":"Multifunciones","unit_price":90.58,"reference":"242P6B V2","ean13":"0195908882510","weight":"0","quantity":0,"brand":"HP","description_pt":"<p><p>Trabaje, aprenda y cree con la impresora que imprime todo para que pueda abordar cualquier cosa, desde fotograf\u00edas de alta calidad hasta documentos.&nbsp;Elija HP+ y obtenga el sistema de impresi\u00f3n inteligente que lo mantiene conectado y listo para imprimir desde pr\u00e1cticamente&nbsp;cualquier lugar<\/p><h2>Creado para equilibrarlo todo<\/h2><p>Experimente una impresora dom\u00e9stica verdaderamente polivalente.&nbsp;Con la impresi\u00f3n autom\u00e1tica a doble cara y una bandeja de fotos integrada, usted y su familia pueden crear fotos y documentos sorprendentes siempre que los necesiten, desde cualquier dispositivo, de forma r\u00e1pida y sencilla con la&nbsp;aplicaci\u00f3n HP Smart<\/p><h2>Recuerdos hechos modernos<\/h2><p>Haz que tus fotos cobren vida con una&nbsp;calidad vibrante y fiel a la del tel\u00e9fono, personal\u00edcelos con impresi\u00f3n a dos caras de 10x15 cm (4x6') e imprima en una variedad de tama\u00f1os tradicionales y modernos, incluidos cuadrados y panor\u00e1micos, todo a trav\u00e9s de la mejor&nbsp;aplicaci\u00f3n HP Smart de su clase.<\/p><h2>Nunca te quedes sin tinta con Instant&nbsp;Ink&nbsp;<\/h2><p>Nunca te quedes&nbsp;sin&nbsp;y ahorra hasta un 70 % con Instant&nbsp;Ink.<\/p><h2>HP+: Ha llegado la impresi\u00f3n inteligente<\/h2><p>HP+, el sistema de impresi\u00f3n inteligente que piensa en el futuro para que su impresora est\u00e9 lista cuando usted lo est\u00e9, m\u00e1s segura y productiva que&nbsp;nunca.&nbsp;<\/p><h2>Informaci\u00f3n importante sobre HP +<\/h2>Esta impresora HP+ requiere para su funcionamiento una cuenta HP, conexi\u00f3n a Internet y el uso de Tinta o T\u00f3ner Original HP durante la vida \u00fatil de la impresora. Una vez activado, HP+ se integra en el dispositivo y requerir\u00e1 el uso de Tinta o T\u00f3ner Original HP durante la vida \u00fatil de la impresora.<br>Los clientes HP disponen de opciones a la hora de adquirir impresoras HP. Existen funcionalidades equivalentes en impresoras HP disponibles sin&nbsp;HP+. Para adquirir impresoras HP LaserJet sin&nbsp;HP+, puedes adquirir la versi\u00f3n est\u00e1ndar de la impresora. Para obtener m\u00e1s informaci\u00f3n, visita www.hp.com\/standard . En impresoras HP Inkjet, un cliente puedes optar por omitir la activaci\u00f3n de&nbsp;HP+&nbsp;durante la configuraci\u00f3n de la impresora. Al omitir la activaci\u00f3n de&nbsp;HP+&nbsp;durante la configuraci\u00f3n, el cliente no podr\u00e1 acceder a las ventajas de&nbsp;HP+.<br>Las impresoras HP+ requieren el uso de tinta o t\u00f3ner Original HP para funcionar incluso despu\u00e9s de expirar la prueba de Instant Ink.<br><br><h2><ul><li>ESPECIFICACIONES<\/li><\/ul><\/h2><ul><li><b>Funciones<\/b><\/li><li>Imprimir, Escanear, Copiar, Foto<\/li><li>Velocidad de impresi\u00f3n en negro (ISO)<\/li><li>Hasta 15ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en negro (borrador, carta)<\/li><li>Hasta 22ppm<\/li><li>Velocidad de impresi\u00f3n en negro (borrador, A4)<\/li><li>Hasta 22ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en negro (ISO, carta)<\/li><li>Hasta 15ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en negro (ISO, A4)<\/li><li>Hasta 15ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li><li>Hasta 10ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, carta)<\/li><li>Hasta 20ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, A4)<\/li><li>Hasta 20ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li><li>Hasta 10ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li><li>Hasta 10ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, foto 4x6)<\/li><li>Tan r\u00e1pido como 40 segundos&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, foto 10x15)<\/li><li>Tan r\u00e1pido como 40 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina en negro (carta, lista)<\/li><li>Tan r\u00e1pido como 16 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina en negro (A4, listo)<\/li><li>Tan r\u00e1pido como 16 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina a color (carta, listo)<\/li><li>Tan r\u00e1pido como 18 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina a color (A4, listo)<\/li><li>Tan r\u00e1pido como 18 segundos&nbsp;<\/li><li>Impresi\u00f3n a doble cara<\/li><li>Autom\u00e1tico<\/li><li>Ciclo de trabajo (mensual, carta)<\/li><li>Hasta 1000 p\u00e1ginas Hasta 1000 p\u00e1ginas (El ciclo de trabajo se define como el n\u00famero m\u00e1ximo de p\u00e1ginas por mes de salida con im\u00e1genes. Este valor proporciona una comparaci\u00f3n de la robustez del producto en relaci\u00f3n con otros dispositivos HP LaserJet o HP Color LaserJet, y permite la implementaci\u00f3n adecuada de impresoras y MFP para satisfacer las demandas de individuos o grupos conectados).<\/li><li>Ciclo de trabajo (mensual, A4)<\/li><li>Hasta 1000 p\u00e1ginas (El ciclo de trabajo se define como el n\u00famero m\u00e1ximo de p\u00e1ginas por mes de salida con im\u00e1genes. Este valor proporciona una comparaci\u00f3n de la robustez del producto en relaci\u00f3n con otros dispositivos HP LaserJet o HP Color LaserJet, y permite la implementaci\u00f3n adecuada de impresoras y MFP para satisfacer las demandas de individuos o grupos conectados).<\/li><li>Volumen de p\u00e1ginas mensual recomendado<\/li><li>300 a 400 (HP recomienda que la cantidad de p\u00e1ginas impresas por mes est\u00e9 dentro del rango establecido para un rendimiento \u00f3ptimo del dispositivo, seg\u00fan factores que incluyen el reemplazo de consumibles)<\/li><li>Calidad de impresi\u00f3n en negro (\u00f3ptima)<\/li><li>Hasta 1200 x 1200 ppp renderizados<\/li><li>Color de calidad de impresi\u00f3n (mejor)<\/li><li>Color optimizado de hasta 4800 x 1200 ppp (al imprimir desde una computadora y 1200 ppp de entrada)<\/li><li>Idiomas de impresi\u00f3n<\/li><li>Interfaz gr\u00e1fica de usuario HP PCL 3<\/li><li>Tecnolog\u00eda de impresi\u00f3n<\/li><li>Inyecci\u00f3n de tinta t\u00e9rmica HP<\/li><li><b>Conectividad, est\u00e1ndar<\/b><\/li><li>1 cliente USB 2.0; 1 Wi-Fi 802.11a\/b\/g\/n\/ac, banda dual Wi-Fi 2.4\/5Ghz<\/li><li>Capacidad de impresi\u00f3n m\u00f3vil<\/li><li>AirPrint de Apple; Servicio de impresi\u00f3n Mopria; Sistema operativo Chrome; Aplicaci\u00f3n inteligente HP&nbsp;<\/li><li>Capacidades de red<\/li><li>Doble banda (2,4\/5 GHz) inal\u00e1mbrica 802.11a\/b\/g\/n\/ac<\/li><li>Capacidad inal\u00e1mbrica<\/li><li>S\u00ed, Wi-Fi 802.11a\/b\/g\/n\/ac de doble banda integrado con recuperaci\u00f3n autom\u00e1tica<\/li><li>Tecnolog\u00edas inal\u00e1mbricas<\/li><li>802.11a\/b\/g\/n\/ac<\/li><li>Requisitos m\u00ednimos del sistema para Macintosh<\/li><li>macOS High Sierra v10.13 (o posterior); 1,5 GB de espacio disponible; acceso a Internet<\/li><li>Requerimientos m\u00ednimos del sistema<\/li><li>Procesador Intel Pentium II, Celeron o 233 MHz o mejor; 2 GB de espacio disponible en disco duro; Conexi\u00f3n a Internet; navegador web<\/li><li>Funciones est\u00e1ndar de env\u00edo digital<\/li><li>Escanear a PC<\/li><li><b>Monitor<\/b><\/li><li>Gr\u00e1ficos en color de pantalla t\u00e1ctil capacitiva de 6,75 cm (2,65 pulgadas)<\/li><li><b>Velocidad del procesador<\/b><\/li><li>800 MHz<\/li><li>Memoria m\u00e1xima<\/li><li>DDR3 de 256 MB<\/li><li>Memoria<\/li><li>DDR3 de 256 MB (La memoria no es actualizable)<\/li><li>Compatibilidad con tarjetas de memoria<\/li><li>No soportado<\/li><li>Almacenamiento interno<\/li><li>No<\/li><li><b>Sistemas operativos compatibles<\/b><\/li><li>ventanas 11; ventanas 10; ventanas 7; macOS 10.13 Alta Sierra; Sistema operativo Chrome(Windows 8 y 8.1 no son compatibles)<\/li><li>Entrada de manejo de papel, est\u00e1ndar<\/li><li>Bandeja de entrada de 125 hojas, bandeja fotogr\u00e1fica de 15 hojas<\/li><li>Salida de manejo de papel, est\u00e1ndar<\/li><li>bandeja de salida de 60 hojas<\/li><li>Manejo de salida terminado<\/li><li>alimentado por hojas<\/li><li><b>Tipos de medios<\/b><\/li><li>Papel normal; papeles fotogr\u00e1ficos HP; folleto HP mate o papel profesional; papel de presentaci\u00f3n mate HP; folleto HP brillante o papel profesional; otros papeles fotogr\u00e1ficos para inyecci\u00f3n de tinta; otros papeles mate para inyecci\u00f3n de tinta; Otros papeles brillantes para inyecci\u00f3n de tinta, papel normal, ligero\/reciclado<\/li><li>Tama\u00f1os de medios admitidos<\/li><li>Bandeja principal: A4, A5, A6, B5(ISO), B5(JIS), 10 x 15 cm, 10 x 30 cm, 2L, Hagaki, Ofuku Hagaki, Sobre (A2, C5, C6, DL, #10, Chou #3); Bandeja de fotos: 10 x 15 cm, 13 x 13 cm, 13 x 18 cm<\/li><li><b>Tama\u00f1os de medios, personalizados<\/b><\/li><li>Bandeja principal: 97,79 x 215 a 127 x 309 mm; Bandeja de fotos: no hay tama\u00f1os de medios personalizados<\/li><li>Impresi\u00f3n sin bordes<\/li><li>S\u00ed (hasta 8,5 x 11 pulgadas, 216 x 297 mm)<\/li><li>Peso del soporte, recomendado<\/li><li>70 a 90 g\/m\u00b2&nbsp;<\/li><li>Formato de archivo compatible<\/li><li>PDF; TIF; JPG<\/li><li>Formato de archivo de escaneo<\/li><li>JPG, BMP, TIFF, PDF, PNG&nbsp;<\/li><li>Resoluci\u00f3n de escaneado mejorada<\/li><li>Hasta 1200 ppp<\/li><li>Resoluci\u00f3n de escaneo, \u00f3ptica<\/li><li>Hasta 1200 ppp<\/li><li>Tama\u00f1o de escaneo, m\u00e1ximo<\/li><li>215,9 x 297 mm<\/li><li><b>Tecnolog\u00eda de escaneo<\/b><\/li><li>Sensor de imagen de contacto (CIS)<\/li><li>Velocidad de copia en negro (m\u00e1ximo, A4)<\/li><li>Hasta 22 cpm&nbsp;<\/li><li>Velocidad de copia en negro (borrador, carta)<\/li><li>Hasta 22 cpm&nbsp;<\/li><li>Velocidad de copia en negro (ISO)<\/li><li>Hasta 13 cpm&nbsp;<\/li><li>Velocidad de copia color (ISO)<\/li><li>Hasta 6 cpm&nbsp;<\/li><li>Velocidad de copia color (borrador, carta)<\/li><li>Hasta 15 cpm&nbsp;<\/li><li>Velocidad de copia en color (m\u00e1ximo, A4)<\/li><li>Hasta 15 cpm&nbsp;<\/li><li>Resoluci\u00f3n de copia (texto negro)<\/li><li>Hasta 600 ppp<\/li><li>Resoluci\u00f3n de copia (texto y gr\u00e1ficos en color)<\/li><li>Hasta 600 x 600 ppp<\/li><li><b>Resoluci\u00f3n de copia (gr\u00e1ficos en negro)<\/b><\/li><li>Hasta 600 ppp<\/li><li>Copias, m\u00e1ximo<\/li><li>Hasta 50 copias<\/li><li>Copiar ajustes de reducci\u00f3n\/ampliaci\u00f3n<\/li><li>25 a 400%<\/li><li>Configuraci\u00f3n de la copiadora<\/li><li>N\u00famero de copias; dos caras; m\u00e1s claro\/m\u00e1s oscuro; Copia de DNI; cambiar el tama\u00f1o; Calidad; Tama\u00f1o de papel; Tipo de papel; Cotejar; Cambio de margen; Cultivo; Copiar vista previa; Mejoras<\/li><li>El consumo de energ\u00eda<\/li><li>Hasta 14 vatios (impresi\u00f3n), 4,9 W (lista), 1,05 W (suspensi\u00f3n), 0,05 vatios ( apagado manual) [ 5 ]&nbsp;<\/li><li><b>Energ\u00eda<\/b><\/li><li>Fuente de alimentaci\u00f3n de CA\/CC de modo dual interna de 2 hilos (Clase 2). 100-240 V CA, 50\/60 Hz, entrada de 0,7 A. Salida de 32 V\/12 V (reposo), 469 mA\/166 mA (reposo), 15 W\/2 W (reposo). No es de doble voltaje, la fuente de alimentaci\u00f3n var\u00eda seg\u00fan el n\u00famero de pieza con el identificador de c\u00f3digo de opci\u00f3n #.<\/li><li>Rango de humedad de funcionamiento<\/li><li>20 a 80% HR<\/li><li>Rango de humedad de funcionamiento recomendado<\/li><li>20 a 80% HR<\/li><li>Rango de humedad no operativa<\/li><li>10 a 90 % de HR (sin condensaci\u00f3n)<\/li><li>Rango de temperatura de funcionamiento<\/li><li>5 a 40\u00b0C<\/li><li>Rango de temperatura de funcionamiento<\/li><li>41 a 104\u00b0F<\/li><li>Tecnolog\u00eda de funci\u00f3n de ahorro de energ\u00eda<\/li><li>Tecnolog\u00eda de apagado autom\u00e1tico de HP; Programar encendido y programar apagado<\/li><li><b>Seguridad<\/b><\/li><li>IEC 60950-1:2005 (2.\u00aa edici\u00f3n) Am1:2009 + Am2:2013\/EN 60950-1:2006 + A11:2009 + A1:2010 + A12:2011 + A2:2013; IEC62368-1:2014 (2.\u00aa edici\u00f3n)\/EN62368-1:2014+A11:2017; UL 62368-1: 2.\u00aa edici\u00f3n; GS alem\u00e1n; Rusia EAC; CCC de China; Taiw\u00e1n BSMI<\/li><li>Dimensiones m\u00ednimas (An x Pr x Al)<\/li><li>460x383x191mm&nbsp;<\/li><li>Dimensiones m\u00e1ximas (An x Pr x Al)<\/li><li>460 x 511 x 190,5 mm&nbsp;<\/li><li>Peso<\/li><li>6,91 kg&nbsp;<\/li><li><b>Qu\u00e9 hay en la caja<\/b><\/li><li>Impresora multifunci\u00f3n HP ENVY Inspire 7220e; Cartucho negro listo para tinta instant\u00e1nea HP 303 Setup; Cartucho listo para tinta instant\u00e1nea HP 303 Setup tricolor; Folleto de precauci\u00f3n de tinta; folleto reglamentario; Guia de preparacion; Guia de referencia; Estuche para bandeja de entrada fotogr\u00e1fica HP Advanced Glossy Matte; Cable de alimentaci\u00f3n [Para obtener informaci\u00f3n sobre el volumen de tinta y el rendimiento de p\u00e1ginas, visite&nbsp;<a href='http:\/\/hp.com\/go\/learnaboutsupplies'>http:\/\/hp.com\/go\/learnaboutsupplies<\/a>&nbsp;]&nbsp;<\/li><li>N\u00famero de cartuchos de impresi\u00f3n<\/li><li>2 (1 de cada negro, tricolor)<\/li><li>Cartuchos de repuesto<\/li><li>Cartucho de tinta original HP 303 negro (~200 p\u00e1ginas) T6N02A; Cartucho de tinta original HP 303 tricolor (~165 p\u00e1ginas) T6N01A; Cartucho de tinta original HP 303XL negro (~600 p\u00e1ginas) T6N04A; Cartucho de tinta original HP 303XL tricolor (~415 p\u00e1ginas) T6N03A.&nbsp;<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hp-mult%20envy%20insp%207220e%20v2_1.jpg","wholesale_price":"85.58","unit_price_tax":90.58},"product_model":{"product_data":{"ean13":["0195908882510"],"reference":"242P6B V2","name":{"1":"Multifunci\u00f3n HP Envy Inspire 7220e WiFi\/ D\u00faplex\/ Blanca","2":"","3":"","4":""},"description":{"1":"<p><p>Trabaje, aprenda y cree con la impresora que imprime todo para que pueda abordar cualquier cosa, desde fotograf\u00edas de alta calidad hasta documentos.&nbsp;Elija HP+ y obtenga el sistema de impresi\u00f3n inteligente que lo mantiene conectado y listo para imprimir desde pr\u00e1cticamente&nbsp;cualquier lugar<\/p><h2>Creado para equilibrarlo todo<\/h2><p>Experimente una impresora dom\u00e9stica verdaderamente polivalente.&nbsp;Con la impresi\u00f3n autom\u00e1tica a doble cara y una bandeja de fotos integrada, usted y su familia pueden crear fotos y documentos sorprendentes siempre que los necesiten, desde cualquier dispositivo, de forma r\u00e1pida y sencilla con la&nbsp;aplicaci\u00f3n HP Smart<\/p><h2>Recuerdos hechos modernos<\/h2><p>Haz que tus fotos cobren vida con una&nbsp;calidad vibrante y fiel a la del tel\u00e9fono, personal\u00edcelos con impresi\u00f3n a dos caras de 10x15 cm (4x6') e imprima en una variedad de tama\u00f1os tradicionales y modernos, incluidos cuadrados y panor\u00e1micos, todo a trav\u00e9s de la mejor&nbsp;aplicaci\u00f3n HP Smart de su clase.<\/p><h2>Nunca te quedes sin tinta con Instant&nbsp;Ink&nbsp;<\/h2><p>Nunca te quedes&nbsp;sin&nbsp;y ahorra hasta un 70 % con Instant&nbsp;Ink.<\/p><h2>HP+: Ha llegado la impresi\u00f3n inteligente<\/h2><p>HP+, el sistema de impresi\u00f3n inteligente que piensa en el futuro para que su impresora est\u00e9 lista cuando usted lo est\u00e9, m\u00e1s segura y productiva que&nbsp;nunca.&nbsp;<\/p><h2>Informaci\u00f3n importante sobre HP +<\/h2>Esta impresora HP+ requiere para su funcionamiento una cuenta HP, conexi\u00f3n a Internet y el uso de Tinta o T\u00f3ner Original HP durante la vida \u00fatil de la impresora. Una vez activado, HP+ se integra en el dispositivo y requerir\u00e1 el uso de Tinta o T\u00f3ner Original HP durante la vida \u00fatil de la impresora.<br>Los clientes HP disponen de opciones a la hora de adquirir impresoras HP. Existen funcionalidades equivalentes en impresoras HP disponibles sin&nbsp;HP+. Para adquirir impresoras HP LaserJet sin&nbsp;HP+, puedes adquirir la versi\u00f3n est\u00e1ndar de la impresora. Para obtener m\u00e1s informaci\u00f3n, visita www.hp.com\/standard . En impresoras HP Inkjet, un cliente puedes optar por omitir la activaci\u00f3n de&nbsp;HP+&nbsp;durante la configuraci\u00f3n de la impresora. Al omitir la activaci\u00f3n de&nbsp;HP+&nbsp;durante la configuraci\u00f3n, el cliente no podr\u00e1 acceder a las ventajas de&nbsp;HP+.<br>Las impresoras HP+ requieren el uso de tinta o t\u00f3ner Original HP para funcionar incluso despu\u00e9s de expirar la prueba de Instant Ink.<br><br><h2><ul><li>ESPECIFICACIONES<\/li><\/ul><\/h2><ul><li><b>Funciones<\/b><\/li><li>Imprimir, Escanear, Copiar, Foto<\/li><li>Velocidad de impresi\u00f3n en negro (ISO)<\/li><li>Hasta 15ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en negro (borrador, carta)<\/li><li>Hasta 22ppm<\/li><li>Velocidad de impresi\u00f3n en negro (borrador, A4)<\/li><li>Hasta 22ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en negro (ISO, carta)<\/li><li>Hasta 15ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en negro (ISO, A4)<\/li><li>Hasta 15ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li><li>Hasta 10ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, carta)<\/li><li>Hasta 20ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, A4)<\/li><li>Hasta 20ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li><li>Hasta 10ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li><li>Hasta 10ppm&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, foto 4x6)<\/li><li>Tan r\u00e1pido como 40 segundos&nbsp;<\/li><li>Velocidad de impresi\u00f3n en color (borrador, foto 10x15)<\/li><li>Tan r\u00e1pido como 40 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina en negro (carta, lista)<\/li><li>Tan r\u00e1pido como 16 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina en negro (A4, listo)<\/li><li>Tan r\u00e1pido como 16 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina a color (carta, listo)<\/li><li>Tan r\u00e1pido como 18 segundos&nbsp;<\/li><li>Salida de la primera p\u00e1gina a color (A4, listo)<\/li><li>Tan r\u00e1pido como 18 segundos&nbsp;<\/li><li>Impresi\u00f3n a doble cara<\/li><li>Autom\u00e1tico<\/li><li>Ciclo de trabajo (mensual, carta)<\/li><li>Hasta 1000 p\u00e1ginas Hasta 1000 p\u00e1ginas (El ciclo de trabajo se define como el n\u00famero m\u00e1ximo de p\u00e1ginas por mes de salida con im\u00e1genes. Este valor proporciona una comparaci\u00f3n de la robustez del producto en relaci\u00f3n con otros dispositivos HP LaserJet o HP Color LaserJet, y permite la implementaci\u00f3n adecuada de impresoras y MFP para satisfacer las demandas de individuos o grupos conectados).<\/li><li>Ciclo de trabajo (mensual, A4)<\/li><li>Hasta 1000 p\u00e1ginas (El ciclo de trabajo se define como el n\u00famero m\u00e1ximo de p\u00e1ginas por mes de salida con im\u00e1genes. Este valor proporciona una comparaci\u00f3n de la robustez del producto en relaci\u00f3n con otros dispositivos HP LaserJet o HP Color LaserJet, y permite la implementaci\u00f3n adecuada de impresoras y MFP para satisfacer las demandas de individuos o grupos conectados).<\/li><li>Volumen de p\u00e1ginas mensual recomendado<\/li><li>300 a 400 (HP recomienda que la cantidad de p\u00e1ginas impresas por mes est\u00e9 dentro del rango establecido para un rendimiento \u00f3ptimo del dispositivo, seg\u00fan factores que incluyen el reemplazo de consumibles)<\/li><li>Calidad de impresi\u00f3n en negro (\u00f3ptima)<\/li><li>Hasta 1200 x 1200 ppp renderizados<\/li><li>Color de calidad de impresi\u00f3n (mejor)<\/li><li>Color optimizado de hasta 4800 x 1200 ppp (al imprimir desde una computadora y 1200 ppp de entrada)<\/li><li>Idiomas de impresi\u00f3n<\/li><li>Interfaz gr\u00e1fica de usuario HP PCL 3<\/li><li>Tecnolog\u00eda de impresi\u00f3n<\/li><li>Inyecci\u00f3n de tinta t\u00e9rmica HP<\/li><li><b>Conectividad, est\u00e1ndar<\/b><\/li><li>1 cliente USB 2.0; 1 Wi-Fi 802.11a\/b\/g\/n\/ac, banda dual Wi-Fi 2.4\/5Ghz<\/li><li>Capacidad de impresi\u00f3n m\u00f3vil<\/li><li>AirPrint de Apple; Servicio de impresi\u00f3n Mopria; Sistema operativo Chrome; Aplicaci\u00f3n inteligente HP&nbsp;<\/li><li>Capacidades de red<\/li><li>Doble banda (2,4\/5 GHz) inal\u00e1mbrica 802.11a\/b\/g\/n\/ac<\/li><li>Capacidad inal\u00e1mbrica<\/li><li>S\u00ed, Wi-Fi 802.11a\/b\/g\/n\/ac de doble banda integrado con recuperaci\u00f3n autom\u00e1tica<\/li><li>Tecnolog\u00edas inal\u00e1mbricas<\/li><li>802.11a\/b\/g\/n\/ac<\/li><li>Requisitos m\u00ednimos del sistema para Macintosh<\/li><li>macOS High Sierra v10.13 (o posterior); 1,5 GB de espacio disponible; acceso a Internet<\/li><li>Requerimientos m\u00ednimos del sistema<\/li><li>Procesador Intel Pentium II, Celeron o 233 MHz o mejor; 2 GB de espacio disponible en disco duro; Conexi\u00f3n a Internet; navegador web<\/li><li>Funciones est\u00e1ndar de env\u00edo digital<\/li><li>Escanear a PC<\/li><li><b>Monitor<\/b><\/li><li>Gr\u00e1ficos en color de pantalla t\u00e1ctil capacitiva de 6,75 cm (2,65 pulgadas)<\/li><li><b>Velocidad del procesador<\/b><\/li><li>800 MHz<\/li><li>Memoria m\u00e1xima<\/li><li>DDR3 de 256 MB<\/li><li>Memoria<\/li><li>DDR3 de 256 MB (La memoria no es actualizable)<\/li><li>Compatibilidad con tarjetas de memoria<\/li><li>No soportado<\/li><li>Almacenamiento interno<\/li><li>No<\/li><li><b>Sistemas operativos compatibles<\/b><\/li><li>ventanas 11; ventanas 10; ventanas 7; macOS 10.13 Alta Sierra; Sistema operativo Chrome(Windows 8 y 8.1 no son compatibles)<\/li><li>Entrada de manejo de papel, est\u00e1ndar<\/li><li>Bandeja de entrada de 125 hojas, bandeja fotogr\u00e1fica de 15 hojas<\/li><li>Salida de manejo de papel, est\u00e1ndar<\/li><li>bandeja de salida de 60 hojas<\/li><li>Manejo de salida terminado<\/li><li>alimentado por hojas<\/li><li><b>Tipos de medios<\/b><\/li><li>Papel normal; papeles fotogr\u00e1ficos HP; folleto HP mate o papel profesional; papel de presentaci\u00f3n mate HP; folleto HP brillante o papel profesional; otros papeles fotogr\u00e1ficos para inyecci\u00f3n de tinta; otros papeles mate para inyecci\u00f3n de tinta; Otros papeles brillantes para inyecci\u00f3n de tinta, papel normal, ligero\/reciclado<\/li><li>Tama\u00f1os de medios admitidos<\/li><li>Bandeja principal: A4, A5, A6, B5(ISO), B5(JIS), 10 x 15 cm, 10 x 30 cm, 2L, Hagaki, Ofuku Hagaki, Sobre (A2, C5, C6, DL, #10, Chou #3); Bandeja de fotos: 10 x 15 cm, 13 x 13 cm, 13 x 18 cm<\/li><li><b>Tama\u00f1os de medios, personalizados<\/b><\/li><li>