"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SONY","supplier":null,"width":null,"height":null,"depth":null,"weight":0.16,"unit_price":135.41,"unit_price_tax":135.41,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":2,"brand":"SONY","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sony-aur%20linkbuds%20open%20vl_1.jpg"],"wholesale_price":128.41}}},"8435739902479":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435739902479",false],"wholesale_price":[8.43,false],"price":[15.43,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.04",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:248288","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0d2b0c17492f3317a4fecbe234f67d30.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Conversor HDMI Aisens A109-0913\/ USB + USB Tipo-C 3.1 Macho - HDMI Macho\/ 15cm\/ Gris","category":"Cables","sub_category":"Cables HDMI","unit_price":15.43,"reference":"A109-0913","ean13":"8435739902479","weight":"0.04","quantity":5,"brand":"AISENS","description_pt":"<p><h2>Conversor HDMI Aisens A109-0913<\/h2><p>Convertidor con carcasa de aluminio USB-A+USB-C a HDMI, con conector USB-A y USB-C macho en un extremo y conector HDMI 1080P@60Hz hembra en el otro.<\/p><p>Este conversor permite transformar un puerto USB (USB-A o USB-C) a HDMI sin necesidad de un puerto USB-C especial para video. Se recomienda conectar a un puerto USB 3.0 para obtener una mejor experiencia.<\/p><p>El puerto HDMI soporta la resoluci\u00f3n m\u00e1xima 1080P@60HZ. Retrocompatible con las especificaciones HDMI anteriores.<\/p><h2>Especificaciones<\/h2><p><ul><li>Conexi\u00f3n USB-A o USB-C USB 3.0 (USB3.1 GEN1), retrocompatible con USB 2.0.<\/li><li>Sistemas operativos soportados: Windows Win 10\/11, Mac OS 10.14 o superior.<\/li><li>Nota: Necesario instalar los controladores antes de usarlo. De lo contrario, el conversor no funcionar\u00e1.<\/li><li>Longitud: 15 CM.<\/li><li>Color: Gris.<\/li><li>Normativas: RoHS, CE.<\/li><li>Test de funcionamiento: 100% testeado.<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-adp%20a109-0913_1.jpg","wholesale_price":"8.43","unit_price_tax":15.43},"product_model":{"product_data":{"ean13":["8435739902479"],"reference":"A109-0913","name":{"1":"Conversor HDMI Aisens A109-0913\/ USB + USB Tipo-C 3.1 Macho - HDMI Macho\/ 15cm\/ Gris","2":"","3":"","4":""},"description":{"1":"<p><h2>Conversor HDMI Aisens A109-0913<\/h2><p>Convertidor con carcasa de aluminio USB-A+USB-C a HDMI, con conector USB-A y USB-C macho en un extremo y conector HDMI 1080P@60Hz hembra en el otro.<\/p><p>Este conversor permite transformar un puerto USB (USB-A o USB-C) a HDMI sin necesidad de un puerto USB-C especial para video. Se recomienda conectar a un puerto USB 3.0 para obtener una mejor experiencia.<\/p><p>El puerto HDMI soporta la resoluci\u00f3n m\u00e1xima 1080P@60HZ. Retrocompatible con las especificaciones HDMI anteriores.<\/p><h2>Especificaciones<\/h2><p><ul><li>Conexi\u00f3n USB-A o USB-C USB 3.0 (USB3.1 GEN1), retrocompatible con USB 2.0.<\/li><li>Sistemas operativos soportados: Windows Win 10\/11, Mac OS 10.14 o superior.<\/li><li>Nota: Necesario instalar los controladores antes de usarlo. De lo contrario, el conversor no funcionar\u00e1.<\/li><li>Longitud: 15 CM.<\/li><li>Color: Gris.<\/li><