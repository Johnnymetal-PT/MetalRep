holesale_price":[514.74,false],"price":[521.74,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:260865","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/62637ef774cde36c0ce84ba8be0b6bab.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Port\u00e1til LG Gram Book 15UD50T-G.AX55B Intel Core i5-1334U\/ 16GB\/ 512GB SSD\/ 15.6'\/ Sin Sistema Operativo","category":"Portatiles","sub_category":"Portatiles","unit_price":521.74,"reference":"15UD50T-G.AX55B","ean13":"8806096456668","weight":"0","quantity":0,"brand":"LG","description_pt":"<h2>Port\u00e1til 15.6' LG gram Book&nbsp;15UD50T<\/h2><p>Libera el poder de la AI con Copilot, acceso r\u00e1pido desde el teclado, multitarea eficiente y rendimiento fluido<br><\/p><p><\/p><h2>Impulsa tu potencial&nbsp;<\/h2><p>Donde el dise\u00f1o y la potencia confluyen con la AI&nbsp;<\/p><p>LG gram Book cuenta con un procesador robusto y una velocidad adaptable seg\u00fan tus necesidades.<\/p><h2>Fusi\u00f3n de estilo y funcionalidad<\/h2><p>LG gram Book ofrece un dise\u00f1o robusto y elegante que destaca en cualquier espacio. Su dise\u00f1o con bordes redondeados crea una silueta ic\u00f3nica, mientras que el color gris a\u00f1ade fuerza al estilo.<\/p><h2>Privacidad en un instante<\/h2><p>Abre y cierra la cubierta de la webcam cuando lo necesites manteniendo tu privacidad y seguridad en todo momento<\/p><h2>Almacenamiento ampliable<\/h2><p>LG gram Book est\u00e1 equipado con dos ranuras M.2 para tarjetas SSD actualizables adapt\u00e1ndose a tus necesidades de cada momento y de f\u00e1cil acceso.<\/p><div><p><br><\/p><p><h2>Especificaciones<\/h2><p><p><ul><li><b>Procesador:<\/b><\/li><li>Intel Core i5-1334U<\/li><li><b>Memoria RAM:<\/b><\/li><li>Slot 1: 16GB DDR4 (Dual Channel, 3200 MHz)<\/li><li>Slot 2: Ampliable<\/li><li><b>Disco duro:<\/b><\/li><li>Slot 1: 512GB M.2 (NVMe Gen 4)<\/li><li>Slot 2: M.2 Dual SSD<\/li><li><b>Gr\u00e1ficos:<\/b><\/li><li>Tarjeta Gr\u00e1fica Integrada Intel\u00ae Iris Xe Graphics<\/li><li><b>Sistema Operativo:<\/b><\/li><li>FreeDOS<\/li><li><b>Pantalla:<\/b><\/li><li>Tipo: IPS (LGD)<\/li><li>Resoluci\u00f3n: Full HD (1920 x 1080)<\/li><li>Tama\u00f1o: 39,6 cm (15,6')<\/li><li>Formato: 16:9<\/li><li>sRGB: 62,5%<\/li><li>Tratamiento antirreflejos: S\u00ed<\/li><li>T\u00e1ctil: No<\/li><li><b>Audio<\/b>:<\/li><li>Altavoces est\u00e9reo: 1.5W x 2<\/li><li>Salida auriculares\/micr\u00f3fono 3.5mm<\/li><li>Tecnolog\u00eda: Dolby Atmos<\/li><li><b>C\u00e1mara<\/b>:<\/li><li>C\u00e1mara HD con obturador<\/li><li><b>Conectividad:<\/b><\/li><li>2 x USB Tipo A (USB 3.2 Gen 1x1)<\/li><li>2 x USB Tipo C (USB 4 Gen3x2 con carga r\u00e1pida, DisplayPort, Thunderbolt 4)<\/li><li>1 x HDMI 2.1<\/li><li>1 x Jack 3.5mm audio<\/li><li>Bluetooth 5.2<\/li><li>Wi-Fi con Intel Connectivity Performance Suite<\/li><li>Adaptador USB-C a RJ45 (no incluido)<\/li><li><b>Bater\u00eda:<\/b><\/li><li>Tipo: I\u00f3n-Litio de alta densidad<\/li><li>Capacidad: 51Wh<\/li><li>Duraci\u00f3n estimada: hasta 23.5 horas*<\/li><li>Carga r\u00e1pida: S\u00ed<\/li><li><b>Dimensiones y peso:<\/b><\/li><li>Dimensiones equipo: 359.8 x 237.8 x 18.9~19.4 mm<\/li><li>Peso equipo: 1.7 kg (1.69 kg)<\/li><li><span style='background-color: initial;'><b>Dise\u00f1o:<\/b><\/span><\/li><li>Chasis: Composite de alta resistencia<\/li><li>Acabado\/color: Plateado<\/li><li><b>Dispositivos de entrada:<\/b><\/li><li>Teclado espa\u00f1ol completo (98 teclas con teclado num\u00e9rico de 3 filas)<\/li><li>Touchpad amplio de alta precisi\u00f3n con scroll y gestos<\/li><li>Bot\u00f3n de encendido<\/li><li><b>Seguridad:<\/b><\/li><li>Encriptaci\u00f3n TPM<\/li><li><b>Seguridad SSD<\/b><\/li><li>Ranura Kensington Lock (Slim)<\/li><li><b>Software y funciones adicionales:<\/b><\/li><li>LG Quick Guide<\/li><li>LG On Screen Display<\/li><li>LG Glance by Mirametrix\u00ae<\/li><li>LG Power Manager<\/li><li>Bamboo Paper<\/li><li>Gram Chat (AI)<\/li><li>LG Pen Settings<\/li><li><b>Accesorios incluidos:<\/b><\/li><li>Adaptador de corriente 65W USB Tipo C<\/li><\/ul><\/p><\/p><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lgp-15ud50t-g%20ax55b_1.jpg","wholesale_price":"514.74","unit_price_tax":521.74},"product_model":{"product_data":{"ean13":["8806096456668"],"reference":"15UD50T-G.AX55B","name":{"1":"Port\u00e1til LG Gram Book 15UD50T-G.AX55B Intel Core i5-1334U\/ 16GB\/ 512GB SSD\/ 15.6'\/ Sin Sistema Operativo","2":"","3":"","4":""},"description":{"1":"<h2>Port\u00e1til 15.6' LG gram Book&nbsp;15UD50T<\/h2><p>Libera el poder de la AI con Copilot, acceso r\u00e1pido desde el teclado, multitarea eficiente y rendimiento fluido<br><\/p><p><\/p><h2>Impulsa tu potencial&nbsp;<\/h2><p>Donde el dise\u00f1o y la potencia confluyen con la AI&nbsp;<\/p><p>LG gram Book cuenta con un procesador robusto y una velocidad adaptable seg\u00fan tus necesidades.<\/p><h2>Fusi\u00f3n de estilo y funcionalidad<\/h2><p>LG gram Book ofrece un dise\u00f1o robusto y elegante que destaca en cualquier espacio. Su dise\u00f1o con bordes redondeados crea una silueta ic\u00f3nica, mientras que el color gris a\u00f1ade fuerza al estilo.<\/p><h2>Privacidad en un instante<\/h2><p>Abre y cierra la cubierta de la webcam cuando lo necesites manteniendo tu privacidad y seguridad en todo momento<\/p><h2>Almacenamiento ampliable<\/h2><p>LG gram Book est\u00e1 equipado con dos ranuras M.2 para tarjetas SSD actualizables adapt\u00e1ndose a tus necesidades de cada momento y de f\u00e1cil acceso.<\/p><div><p><br><\/p><p><h2>Especificaciones<\/h2><p><p><ul><li><b>Procesador:<\/b><\/li><li>Intel Core i5-1334U<\/li><li><b>Memoria RAM:<\/b><\/li><li>Slot 1: 16GB DDR4 (Dual Channel, 3200 MHz)<\/li><li>Slot 2: Ampliable<\/li><li><b>Disco duro:<\/b><\/li><li>Slot 1: 512GB M.2 (NVMe Gen 4)<\/li><li>Slot 2: M.2 Dual SSD<\/li><li><b>Gr\u00e1ficos:<\/b><\/li><li>Tarjeta Gr\u00e1fica Integrada Intel\u00ae Iris Xe Graphics<\/li><li><b>Sistema Operativo:<\/b><\/li><li>FreeDOS<\/li><li><b>Pantalla:<\/b><\/li><li>Tipo: IPS (LGD)<\/li><li>Resoluci\u00f3n: Full HD (1920 x 1080)<\/li><li>Tama\u00f1o: 39,6 cm (15,6')<\/li><li>Formato: 16:9<\/li><li>sRGB: 62,5%<\/li><li>Tratamiento antirreflejos: S\u00ed<\/li><li>T\u00e1ctil: No<\/li><li><b>Audio<\/b>:<\/li><li>Altavoces est\u00e9reo: 1.5W x 2<\/li><li>Salida auriculares\/micr\u00f3fono 3.5mm<\/li><li>Tecnolog\u00eda: Dolby Atmos<\/li><li><b>C\u00e1mara<\/b>:<\/li><li>C\u00e1mara HD con obturador<\/li><li><b>Conectividad:<\/b><\/li><li>2 x USB Tipo A (USB 3.2 Gen 1x1)<\/li><li>2 x USB Tipo C (USB 4 Gen3x2 con carga r\u00e1pida, DisplayPort, Thunderbolt 4)<\/li><li>1 x HDMI 2.1<\/li><li>1 x Jack 3.5mm audio<\/li><li>Bluetooth 5.2<\/li><li>Wi-Fi con Intel Connectivity Performance Suite<\/li><li>Adaptador USB-C a RJ45 (no incluido)<\/li><li><b>Bater\u00eda:<\/b><\/li><li>Tipo: I\u00f3n-Litio de alta densidad<\/li><li>Capacidad: 51Wh<\/li><li>Duraci\u00f3n estimada: hasta 23.5 horas*<\/li><li>Carga r\u00e1pida: S\u00ed<\/li><li><b>Dimensiones y peso:<\/b><\/li><li>Dimensiones equipo: 359.8 x 237.8 x 18.9~19.4 mm<\/li><li>Peso equipo: 1.7 kg (1.69 kg)<\/li><li><span style='background-color: initial;'><b>Dise\u00f1o:<\/b><\/span><\/li><li>Chasis: Composite de alta resistencia<\/li><li>Acabado\/color: Plateado<\/li><li><b>Dispositivos de entrada:<\/b><\/li><li>Teclado espa\u00f1ol completo (98 teclas con teclado num\u00e9rico de 3 filas)<\/li><li>Touchpad amplio de alta precisi\u00f3n con scroll y gestos<\/li><li>Bot\u00f3n de encendido<\/li><li><b>Seguridad:<\/b><\/li><li>Encriptaci\u00f3n TPM<\/li><li><b>Seguridad SSD<\/b><\/li><li>Ranura Kensington Lock (Slim)<\/li><li><b>Software y funciones adicionales:<\/b><\/li><li>LG Quick Guide<\/li><li>LG On Screen Display<\/li><li>LG Glance by Mirametrix\u00ae<\/li><li>LG Power Manager<\/li><li>Bamboo Paper<\/li><li>Gram Chat (AI)<\/li><li>LG Pen Settings<\/li><li><b>Accesorios incluidos:<\/b><\/li><li>Adaptador de corriente 65W USB Tipo C<\/li><\/ul><\/p><\/p><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":521.74,"unit_price_tax":521.74,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":0,"brand":"LG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lgp-15ud50t-g%20ax55b_1.jpg"],"wholesale_price":514.74}}},"8806095890050":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806095890050",false],"wholesale_price":[649,false],"price":[656,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:260876","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/6e96fcc31d91ae75d0e9217671dc0efd.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Port\u00e1til Samsung Galaxy Book4 Edge Qualcomm Snapdragon X Plus X1P-42-100\/ 16GB\/ 512GB SSD\/ 15.6' T\u00e1ctil\/ Win11 Pro","category":"Portatiles","sub_category":"Portatiles","unit_price":656,"reference":"NP754XQA-KB1ES","ean13":"8806095890050","weight":"0","quantity":0,"brand":"SAMSUNG","description_pt":"                                                <p><\/p><h2>F\u00e1cil de transportar<\/h2><p>Galaxy Book4 Edge es fino y ligero, un dispositivo ultraport\u00e1til que va contigo en tu camino hacia el \u00e9xito. Est\u00e1 disponible en dos tama\u00f1os y, gracias a su dise\u00f1o minimalista, es f\u00e1cil de transportar. As\u00ed, puedes llev\u00e1rtelo a tus viajes y reuniones con total comodidad.<\/p><h2>Un aspecto ic\u00f3nico en nuevos colores<\/h2><p>Disponible en nuevo tono Sapphire Blue, Galaxy Book4 Edge tiene una est\u00e9tica inconfundible y refinada. Su delicado acabado transmite una sensaci\u00f3n de elegancia y perfecci\u00f3n, convirit\u00e9ndolo en un dispositivo con mucho estilo que destaca all\u00e1 donde va.<\/p><h2>Rendimiento asombroso a la velocidad de la AI<\/h2><p>Galaxy Book4 Edge supera todas tus expectativas con su alt\u00edsimo y veloz rendimiendo potenciado por AI. Equipado con el procesador l\u00eddel del sector Snapdragon\u00ae X Elite y con una NPU avanzada, este port\u00e1til con AI te brinda una experiencia totalmente transformadora para crear y trabajar.<\/p><h2>Encuentra lo que buscas con Recall<\/h2><p>Utiliza Recall para buscar sin problemas en el historial de tu PC y encontrar r\u00e1pidamente lo que est\u00e1s buscando. Verifica tu actividad pasada a trav\u00e9s de instant\u00e1neas que se muestran en pantalla y recupera la informaci\u00f3n que necesita, ya sea de un documento, imagen, correo electr\u00f3nico o incluso tu historial de navegaci\u00f3n anterior.<\/p><p>Recall no estar\u00e1 disponible en el Galaxy Book4 Edge en el momento del lanzamiento. La disponibilidad de Recall depende del calendario de lanzamiento de Microsoft.<\/p><h2>Conecta tu m\u00f3vil y desata el poder de Galaxy AI en tu PC<\/h2><p>Conecta tu tel\u00e9fono inteligente a su PC a trav\u00e9s de Phone Link para acceder a p\u00e1ginas web visitadas recientemente o iniciar hasta 5 aplicaciones m\u00f3viles directamente desde tu port\u00e1til. Utiliza funciones inteligentes como Circle to Search with Google, Note Assist y Chat Assist desde tu Smartphone Galaxy y consigue una vista ampliada en la pantalla grande de Galaxy Book4 Edge.<\/p><h2>El trabajo fluye entre tu PC y tu m\u00f3vil<\/h2><p>Copilot en Windows te da acceso a tu m\u00f3vil para gestionar tareas entre dispositivos con comandos por chat r\u00e1pidos. As\u00ed, tu experiencia de trabajo es m\u00e1s fluida y puedes abrir herramientas de comunicaci\u00f3n inteligentes para acceder a tus contactos o enviar mensajes desde el PC o el m\u00f3vil de con un sencillo comando.<\/p><h2>Imagina, esboza y Cocreator har\u00e1 el resto<\/h2><p>Termina tu pr\u00f3xima obra de arte con la ayuda de Cocreator. Solo necesitas tener una idea, hacer un boceto, lanzar un comando a tu AI y \u00a1voil\u00e0! Tus doodles lo transforman en una obra maestra.<\/p><h2>Subt\u00edtulos en directo con traducci\u00f3n por AI en vivo<\/h2><p>Live Captions proporciona traducciones en tiempo real para tus reuniones online o para ver v\u00eddeos. La inteligencia artificial detecta el idioma del hablante y convierte de manera inteligente la conversaci\u00f3n en subt\u00edtulos en la lengua que escojas.<\/p><h2>Prep\u00e1rate para las c\u00e1maras con Windows Studio Effects<\/h2><p>Saca lo mejor de ti en tus videollamadas con Windows Studio Effects en Galaxy Book4 Edge. Retoca tu aspecto con las funcionalidades AI, como Auto Framing, la correcci\u00f3n de contacto visual, la correcci\u00f3n de luz, los efectos de fondo y los filtros para dar tu mejor perfil en tus reuniones.<\/p><h2>Cristal antirreflejos. Visibilidad impecable desde cualquier \u00e1ngulo.<\/h2><p>La pantalla de Galaxy Book4 Edge est\u00e1 fabricada con Corning\u00ae Gorilla\u00ae Glass con DX para reducir la cantidad de luz reflejada por la pantalla. Esto se traduce en una mejora de la visibilidad desde varios \u00e1ngulos y en distintas condiciones, como en ambientes con mucha luz.<\/p><h2>C\u00e1rgalo una vez y \u00fasalo muchas<\/h2><p>En la oficina y fuera de ella: la bater\u00eda de tu Galaxy Book4 Edge de 16' no te falla. Te proporciona energ\u00eda para hasta 22 horas de reproducci\u00f3n de v\u00eddeo y, gracias a la Carga Super R\u00e1pida del cargador incluido, podr\u00e1s recargar un 40 % en solo 30 minutos.<\/p><h2>Wi-Fi 7. A toda velocidad<\/h2><p>Navega, transmite y comparte contenido sobre la marcha con la velocidad ultrarr\u00e1pida de Wi-Fi 7. Desde cargar trabajos creativos en l\u00ednea a disfrutar de sus programas favoritos en un instante con latencia ultrabaja y mejor confiabilidad.<\/p><h2>Especificaciones<\/h2><p><\/p><p><\/p><ul><li><b>Sistema operativo<\/b><\/li><li>Windows 11 Pro<\/li><li><b>Procesador \/ Chipset<\/b><\/li><li>Snapdragon\u00ae X Plus de 8 n\u00facleos X1P-42-100 (8 n\u00facleos de hasta 3,2 GHz con un solo n\u00facleo de hasta 3,4 GHz)<\/li><li><b>Gr\u00e1ficos<\/b><\/li><li>GPU Qualcomm\u00ae Adreno<\/li><li><b>NPU<\/b><\/li><li>Qualcomm\u00ae Hexagon&#8482; NPU<\/li><li><b>Pantalla<\/b><\/li><li>Pantalla LED FHD de 15,6' (1920 x 1080), antirreflejo<\/li><li><b>Memoria<\/b><\/li><li>Memoria LPDDR5X de 16 GB (16 GB integrados)<\/li><li><b>Almacenamiento<\/b><\/li><li>512 GB eUFS<\/li><li><b>Color<\/b><\/li><li>Sapphire Blue<\/li><li><b>MULTIMEDIA<\/b><\/li><li>Altavoces est\u00e9reo (1,5 W x 2) Micr\u00f3fono digital interno de matriz dual<\/li><li>Dolby Atmos\u00ae C\u00e1mara de 2 M<\/li><li><b>Network<\/b><\/li><li>Bluetooth v5.3<\/li><li>Wi-Fi 7, 802.11 be 2x2<\/li><li><b>Ports<\/b><\/li><li>HDMI 2.1 (Supports 4K@60Hz)<\/li><li>1 USB3.2<\/li><li>2 USB4.0<\/li><li>MicroSD Multi-media Card Reader<\/li><li>Headphone out\/Mic-in Combo<\/li><li><b>Input<\/b><\/li><li>Teclado profesional con teclado num\u00e9rico<\/li><li><b>Seguridad<\/b><\/li><li>Ranura de seguridad<\/li><li>TPM, lector de huellas dactilares<\/li><li><b>Consumo de energ\u00eda<\/b><