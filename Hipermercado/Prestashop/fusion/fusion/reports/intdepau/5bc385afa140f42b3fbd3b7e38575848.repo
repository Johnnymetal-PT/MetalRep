en desmontar y lavar, lo que reduce los residuos y aumenta la vida \u00fatil<\/p><p><br><\/p><ul><li><b>Especificaciones<\/b><\/li><li>Nombre del producto<\/li><li>Mi Vacuum Cleaner Mini<\/li><li>Dimensiones<\/li><li>267 \u00d7 55 \u00d7 55 mm<\/li><li>Peso neto<\/li><li>Aproximadamente 0,5 kg<\/li><li>Tensi\u00f3n nominal<\/li><li>10,8 V&#9107;<\/li><li>Potencia nominal<\/li><li>120 W<\/li><li>Capacidad de la bater\u00eda: 2000 mAh<\/li><li><b>Contenido del paquete<\/b><\/li><ul><li>1 unidad principal<\/li><li>1 boquilla estrecha<\/li><li>1 boquilla de cepillo<\/li><li>1 cable de carga tipo C<\/li><li>1 manual de usuario<\/li><\/ul><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0.73,"unit_price":38.74,"unit_price_tax":38.74,"tax_rules_group":null,"category":"Limpieza de Hogar","sub_category":"Aspiradores","quantity":5,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-asp%20mi%20vc%20mini%20v3%20120w_1.jpg"],"wholesale_price":33.74}}},"4895229112605":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4895229112605",false],"wholesale_price":[8.75,false],"price":[13.75,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.49",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:149794","Cat. IDs: 2,65","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/715725c1c6