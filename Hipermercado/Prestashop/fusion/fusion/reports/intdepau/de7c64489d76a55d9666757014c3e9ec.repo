tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:78646","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/78be3ecfa1a661c457a1b999970da760.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Soporte Refrigerante Trust Gaming GXT 278 Yozu para Port\u00e1tiles hasta 17.3'","category":"Accesorios de Portatiles","sub_category":"Bases Refrigeradoras","unit_price":37.09,"reference":"20817","ean13":"8713439208177","weight":"0.98","quantity":5,"brand":"TRUST GAMING","description_pt":"<h2>Gaming laptop cooling<\/h2> Mantenga su computadora port\u00e1til funcionando de manera \u00f3ptima mientras juega durante horas, con el soporte de refrigeraci\u00f3n para computadora port\u00e1til Trust Gaming. Los cuatro ventiladores iluminados se pueden configurar seg\u00fan sus preferencias, desde apagarlos hasta enfriarlos a alta velocidad. Y para aumentar la comodidad, el soporte de refrigeraci\u00f3n se puede configurar en tres \u00e1ngulos de visi\u00f3n diferentes.<div><h2>Optimal performance<\/h2><p>Los juegos tienen un gran impacto en el rendimiento de su computadora port\u00e1til y muchas veces provocan un sobrecalentamiento. El GXT 278 evita que su computadora port\u00e1til sufra este problema al enfriarla con cuatro ventiladores que optimizan el flujo de aire. La temperatura de su computadora port\u00e1til se mantiene bajo control, lo que le permite jugar sus juegos favoritos durante horas. Tanto la velocidad del ventilador como el \u00e1ngulo de visi\u00f3n son f\u00e1cilmente ajustables.<\/p><p><br><\/p><ul>\t<li><b>Especificaciones<\/b><\/li>\t<li>General<\/li>\t<li>m\u00e1x. altura de elevaci\u00f3n<\/li>\t<li>4,5cm<\/li>\t<li>Ventilador incluido<\/li>\t<li>si, 4x<\/li>\t<li>Luces de juego en ventiladores. Botones: 1 controlador de ventilador superior, 1 controlador de ventilador inferior<\/li>\t<li><b>Caracter\u00edsticas<\/b><\/li>\t<li>N\u00famero de ventiladores<\/li>\t<li>4<\/li>\t<li>Velocidad de rotaci\u00f3n<\/li>\t<li>1200 RPM<\/li>\t<li>Control<\/li>\t<li>Bot\u00f3n de encendido \/ apagado<\/li>\t<li>S\u00ed<\/li>\t<li><b>Conectividad<\/b><\/li>\t<li>cables incluidos<\/li>\t<li>separado, 60cm<\/li>\t<li>Iluminaci\u00f3n<\/li>\t<li>Luces<\/li>\t<li>S\u00ed<\/li>\t<li>Colores LED<\/li>\t<li>Rojo<\/li>\t<li><b>Ajustabilidad<\/b><\/li>\t<li>Altura ajustable<\/li>\t<li>S\u00ed<\/li>\t<li>Ajuste de altura (pasos)<\/li>\t<li>3 pasos<\/li>\t<li><b>Alimentaci\u00f3n<\/b><\/li>\t<li>Fuente de alimentaci\u00f3n<\/li>\t<li>USB<\/li>\t<li><b>Compatibilidad<\/b><\/li>\t<li>m\u00e1x. tama\u00f1o del port\u00e1til<\/li>\t<li>17.3 '<\/li>\t<li>m\u00e1x. peso<\/li>\t<li>5kg<\/li>\t<li><b>Tama\u00f1o y peso<\/b><\/li>\t<li>Peso total<\/li>\t<li>752 gramos<\/li>\t<li>Profundidad del producto principal (en mm)<\/li>\t<li>30mm<\/li>\t<li>Ancho del producto principal (en mm)<\/li>\t<li>286mm<\/li>\t<li>Altura del producto principal (en mm)<\/li>\t<li>406mm<\/li><\/ul><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-ref%20gxt%20278%20yozu_1.jpg","wholesale_price":"32.09","unit_price_tax":37.09},"product_model":{"product_data":{"ean13":["8713439208177"],"reference":"20817","name":{"1":"Soporte Refrigerante Trust Gaming GXT 278 Yozu para Port\u00e1tiles hasta 17.3'","2":"","3":"","4":""},"description":{"1":"<h2>Gaming laptop cooling<\/h2> Mantenga su computadora port\u00e1til funcionando de manera \u00f3ptima mientras juega durante horas, con el soporte de refrigeraci\u00f3n para computadora port\u00e1til Trust Gaming. Los cuatro ventiladores iluminados se pueden configurar seg\u00fan sus preferencias, desde apagarlos hasta enfriarlos a alta velocidad. Y para aumentar la comodidad, el soporte de refrigeraci\u00f3n se puede configurar en tres \