","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":194.37,"unit_price_tax":194.37,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20poco%20m6p%2012-512%20pur_1.jpg"],"wholesale_price":189.37}}},"6941399092242":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941399092242",false],"wholesale_price":[68.48,false],"price":[73.48,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Realme C30 3GB\/ 32GB\/ 6,5&#39;\/ Denim Preto"],"result":false},"feed_data":{"name_pt":"Smartphone Realme C30 3GB\/ 32GB\/ 6.5'\/ Negro Vaquero","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":73.48,"reference":"6048744","ean13":"6941399092242","weight":"0.37","quantity":5,"brand":"REALME","description_pt":"                                                <h2>Realme C30<\/h2><div><span style='background-color: initial;'>Dise\u00f1o Compacto<\/span><br><span style='background-color: initial;'>M\u00e1s Diversi\u00f3n<\/span><br><\/div><div><span style='background-color: initial;'><h2>Procesador Unisoc T612<\/h2><p><b>Interior potente<\/b><\/p><p>El procesador de ocho n\u00facleos Unisoc T612 tiene un rendimiento potente con una puntuaci\u00f3n de referencia AnTuTu de 210 036, lo que te ofrece una experiencia gaming estable y fluida<\/p><h2>Almacenamiento flash UFS 2.2<\/h2><p><b>300 % m\u00e1s r\u00e1pido que eMMC 5.1<\/b><\/p><p>UFS 2.2 tiene un mejor rendimiento y mayor velocidad que eMMC 5.1, que es un 300 % m\u00e1s r\u00e1pido, lo que ofrece transferencias de archivos m\u00e1s r\u00e1pidas y lanzamientos de juegos m\u00e1s r\u00e1pidos.<\/p><h2>Gran bater\u00eda de 5000 mAh<\/h2><p><b>M\u00e1s potencia. M\u00e1s diversi\u00f3n.<\/b><\/p><p>Una mayor capacidad de la bater\u00eda significa m\u00e1s diversi\u00f3n durante m\u00e1s tiempo. Con una gran bater\u00eda de 5000 mAh, puedes dejar de preocuparte por la bater\u00eda y sumergirte en juegos o v\u00eddeos durante todo el d\u00eda<\/p><h2>Modo ultraahorro<\/h2><p>Con un solo toque para activar el modo ultraahorro, tambi\u00e9n puedes disfrutar de 45,3 horas de pausa ultralarga al 5 % de energ\u00eda, lo que facilita enfrentarse a situaciones de bajo consumo<\/p><h2>Dise\u00f1o ultrafino de 8,5 mm<\/h2><p>El realme C30 contin\u00faa con el dise\u00f1o fino y liviano de la serie C con un grosor de solo 8,5 mm y un peso de s\u00f3lo 182 g, lo que lo hace visualmente muy liviano y c\u00f3modo en la mano<\/p><h2>Pantalla de 16,5 cm (6,5&#8221;)\u00a0<span style='background-color: initial;'>Juegos y v\u00eddeos llenos de diversi\u00f3n<\/span><\/h2>Con una gran pantalla de 16,5 cm (6,5') y una ratio pantalla-cuerpo del 88,7 %, disfrutar\u00e1s de una experiencia supern\u00edtida, tanto si juegas, ves v\u00eddeos o examinas im\u00e1genes<br><\/span><\/div><div><span style='background-color: initial;'><h2>C\u00e1mara de 8 MP con IA<\/h2><p>Los p\u00edxeles m\u00e1s altos significan que puedes hacer fotos de alta calidad con facilidad<\/p><h2>C\u00e1mara frontal de 5 MP<\/h2><p>Haz un selfi desde cualquier \u00e1ngulo.<\/p><h2>Ranura para 3 tarjetas<\/h2><p><b>Memoria externa de hasta 1 TB<\/b><\/p><p>realme C30 admite dos ranuras para tarjetas SIM y una ranura para tarjetas microSD para necesidades de almacenamiento m\u00e1s grandes. Puedes ampliar el almacenamiento hasta 1 TB para fotos y v\u00eddeos.<\/p><br><\/span><\/div><div><span style='background-color: initial;'><h2>Especificaciones<\/h2><p><ul><li><b>Procesador<\/b><\/li><li>Procesador Unisoc T612<\/li><li>CPU: ocho n\u00facleos, 12 nm y hasta 1,82 GHz<\/li><li>GPU: ARM Mali-G57<\/li><li><b>Almacenamiento y RAM<\/b><\/li><li>RAM: 3GB LPDDR4X<\/li><li>ROM: UFS 2.2 de 32 GB<\/li><li>Memoria externa de hasta 1 TB<\/li><li><b>Pantalla<\/b><\/li><li>Pantalla completa de 16,5 cm (6,5'')<\/li><li>Relaci\u00f3n pantalla-cuerpo: 88,7 %<\/li><li>Velocidad de muestreo t\u00e1ctil: 120 Hz<\/li><li>Colores de pantalla: 16,7 M<\/li><li><b>C\u00e1mara<\/b><\/li><li>C\u00e1mara de 8 MP con IA<\/li><li>Apertura f\/2.0<\/li><li>Lente de 4P<\/li><li><b>Funciones de fotograf\u00eda:<\/b><\/li><li>Belleza, Filtro, HDR, Vista panor\u00e1mica, Retrato, Lapso de tiempo, Experto, Super Night<\/li><li><b>Grabaci\u00f3n de v\u00eddeo<\/b><\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 1080p\/30 fps<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 720p\/30 fps<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 480p\/30 fps<\/li><li>C\u00e1mara frontal de 5 MP con IA<\/li><li>Apertura f\/2.2<\/li><li>Lente de 3 P<\/li><li><b>Funciones de fotograf\u00eda:<\/b><\/li><li>Belleza, Filtro, HDR<\/li><li>Grabaci\u00f3n de v\u00eddeo<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 720p\/30 fps<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 480p\/30 fps<\/li><li><b>Carga y bater\u00eda<\/b><\/li><li>Gran bater\u00eda de 5000 mAh (t\u00edp.)<\/li><li>Carga r\u00e1pida de 10 W<\/li><li>Una capacidad de la bater\u00eda de 4890 mAh (min) incluye un adaptador de carga de 10 W<\/li><li><b>Conexi\u00f3n m\u00f3vil e inal\u00e1mbrica<\/b><\/li><li>2 ranuras para tarjetas nano + 1 micro-SD<\/li><li>GSM: 850\/900\/1800\/1900<\/li><li>WCDMA: Bandas 1\/5\/8<\/li><li>FDD-LTE: Bandas 1\/3\/5\/7\/8\/20\/28<\/li><li>TD-LTE: Bandas 38\/40\/41 (2535-2655 MHz)<\/li><li><b>Conexi\u00f3n inal\u00e1mbrica:<\/b><\/li><li>2.4GHz<\/li><li>Bluetooth 5.0<\/li><li><b>Tama\u00f1o y peso<\/b><\/li><li>Longitud: 164,1 mm<\/li><li>Anchura: 75,6 mm<\