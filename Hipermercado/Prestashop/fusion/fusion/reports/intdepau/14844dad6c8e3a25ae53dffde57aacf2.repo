li>V\u00eddeo<\/li><li>Admite formatos de v\u00eddeo como MP4 I 3GP i MKV i WEBM<\/li><li><strong>Resistente a salpicaduras, al agua y al polvo<\/strong><\/li><li>IP54<\/li><li><strong>Sensores<\/strong><\/li><li>Sensor de proximidad | Sensor de luz ambiental | Aceler\u00f3metro | Br\u00fajula electr\u00f3nica | Emisor de infrarrojos | Giroscopio | Motor de vibraci\u00f3n lineal de eje Z<\/li><li><strong>Sistema operativo<\/strong><\/li><li>MIUI 14 para POCO<\/li><li><strong>Contenido del paquete<\/strong><\/li><li>Tel\u00e9fono m\u00f3vil, adaptador, cable USB tipo C, extractor de SIM, funda protectora, gu\u00eda de inicio r\u00e1pido y tarjeta de garant\u00eda<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":194.37,"unit_price_tax":194.37,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20poco%20m6p%2012-512%20bl_1.jpg"],"wholesale_price":189.37}}},"6941812761359":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941812761359",false],"wholesale_price":[189.37,false],"price":[194.37,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Xiaomi POCO M6 Pro Smartphone 12GB\/ 512GB\/ 6,67&#39;\/ Roxo"],"result":false},"feed_data":{"name_pt":"Smartphone Xiaomi POCO M6 Pro 12GB\/ 512GB\/ 6.67'\/ P\u00farpura","category":"SmartPhones y Moviles"