":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AMAZFIT","supplier":null,"width":null,"height":null,"depth":null,"weight":0.08,"unit_price":40.11,"unit_price_tax":40.11,"tax_rules_group":null,"category":"SmartWatch - Pulseras","sub_category":"Pulseras Smartband","quantity":2,"brand":"AMAZFIT","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hmi-pulsera%20amaz%20band7%20bk_1.jpg"],"wholesale_price":35.11}}},"6972596100621":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6972596100621",false],"wholesale_price":[34.79,false],"price":[39.79,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.2",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:93905","Cat. IDs: 76","Associated Categories","Cat. Default: 76","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/519e78dcdfa146dfdecccc21efac396c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Smartwatch Huami Amazfit Bip S Lite\/ Notificaciones\/ Frecuencia Cardiaca\/ Rosa","category":"SmartWatch - Pulseras","sub_category":"SmartWatch","unit_price":39.79,"reference":"AMAZ BIP S LITE PK","ean13":"6972596100621","weight":"0.2","quantity":5,"brand":"AMAZFIT","description_pt":"<p><h2>Pantalla brillante y siempre encendida&nbsp;<\/h2><p>La pantalla a color transflectiva siempre est\u00e1 encendida y permite una excelente legibilidad de la pantalla a la vez que ofrece un bajo consumo de energ\u00eda y protecci\u00f3n para los ojos. Bip S lite reloj inteligente deporte le permite ver claramente la pantalla incluso si la luz de fondo consume mucha energ\u00eda no est\u00e1 encendido. En el exterior, cuanto m\u00e1s brillante es la luz del sol, m\u00e1s clara se puede ver la pantalla.<\/p><h2>Notificaciones de Inteligente en su mu\u00f1eca<\/h2><p>Con Bip S Lite Smartwatch Fitness, pareciendo un amigo inteligente puede recordarle las llamadas entrantes \/ mensajes \/ notificaciones de aplicaciones (incluidos SMS, Facebook, Whatsapp, Twitter, Instagram, Facebook Messenger y m\u00e1s) \/ alarma reloj \/ pron\u00f3stico del tiempo \/ reloj mundial, recordatorios sedentarios y control de m\u00fasica del tel\u00e9fono.<\/p><h2>Gran compa\u00f1ero deportivo<\/h2><p>Amazfit Bip S Lite reloj inteligente para homre y mujer es resistente al agua hasta 50 metros. Puede usarlo mientras nada, y tambi\u00e9n registrar datos interesantes de nataci\u00f3n, que incluyen frecuencia de brazada, tiempos de brazada, \u00edndice SWOLF, pistas en aguas abiertas, etc. El reloj tambi\u00e9n admite 14 modos deportivos, que proporcionan datos como la visualizaci\u00f3n de la pista, la velocidad, la frecuencia card\u00edaca, los recordatorios de distancia.<\/p><h2>Duraci\u00f3n excepcional de la bater\u00eda de 30 d\u00edas<\/h2><p>Gracias a la selecci\u00f3n de componentes electr\u00f3nicos y la tecnolog\u00eda de optimizaci\u00f3n de energ\u00eda, el estado del reloj inteligente Fitness Amazfit Bip S lite puede continuar 30 d\u00edas. Disfrute de la libertad de realizar un viaje de un mes sin su cargador, sabiendo que su reloj no le permitir\u00e1 abajo.<\/p><h2>Monitoreo de salud y seguimiento de actividad todo el d\u00eda&nbsp;<\/h2><p>Con el sensor \u00f3ptico de seguimiento biol\u00f3gico Huami BioTracker PPG, Amazfit Bip S Lite Smartwatch para homre y mujer proporciona un seguimiento continuo de la frecuencia card\u00edaca de alta precisi\u00f3n las 24 horas, lo que le permite saber m\u00e1s sobre su condici\u00f3n f\u00edsica. Adem\u00e1s, el reloj tambi\u00e9n medir\u00e1 su sue\u00f1o para darle un an\u00e1lisis de sus patrones de sue\u00f1o.<\/p><p><b style='background-color: initial;'><br><\/b><\/p><h2><span style='background-color: initial;'>Especificaciones T\u00e9cnicas<\/span><\/h2><\/p><p><p><ul><li><b>Dimensiones<\/b><\/li><li>42 x 35.3 x 11.4 mm<\/li><li><b>Peso<\/b><\/li><li>30 g (con correa) y 18 g (sin correa)<\/li><li><b>Material de la carcasa<\/b><\/li><li>Policarbonato<\/li><li><b>Material de la correa<\/b><\/li><li>Silicona y TPU apto para contacto con la piel<\/li><li><b>Largo de la correa<\/b><\/li><li>110 mm (larga), 85 mm (corta)<\/li><li><b>Ancho de la correa<\/b><\/li><li>20mm<\/li><li><b>Grado de impermeabilidad<\/b><\/li><li>5 ATM<\/li><li><b>Pantalla<\/b><\/li><li>TFT transflectiva a color de 1,28', resoluci\u00f3n 176 x 176,<\/li><li>siempre visible, gama de colores 64 RGB<\/li><li><b>Pantalla t\u00e1ctil<\/b><\/li><li>Cristal templado Corning Gorilla 3 de 2,5D +<\/li><li>revestimiento antihuellas<\/li><li><b>Sensores<\/b><\/li><li>Sensor \u00f3ptico de seguimiento biol\u00f3gico BioTracker TMPPG<\/li><li>Sensor de aceleraci\u00f3n de 3 ejes<\/li><li><b>Bluetooth<\/b><\/li><li>BT5.0\/BLE<\/li><li><b>Bater\u00eda<\/b><\/li><li>Bater\u00eda de pol\u00edmeros de iones de litio de 200 mAh (valor t\u00edpico)<\/li><li><b>Tiempo de carga<\/b><\/li><li>&lt; 2.5 horas<\/li><li><b>M\u00e9todo de carga<\/b><\/li><li>Conector POGO de 2 pines<\/li><li><b>Duraci\u00f3n de la bater\u00eda<\/b><\/li><li>Situaci\u00f3n de uso t\u00edpica: 30 d\u00edas<\/li><li>Modo de espera: 90 d\u00edas<\/li><li><b>Sistema operativo<\/b><\/li><li>Amaz&#64257;t OS<\/li><li><b>Dispositivos compatibles<\/b><\/li><li>Android 5.0 or iOS 10.0 and above<\/li><li><b>Accesorios<\/b><\/li><li>Base de carga, manual del usuario<\/li><li>M\u00e9todo de almacenamiento<\/li><li>Amazfit App<\/li><\/ul><\/p><p><br><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hmi-reloj%20amaz%20bip%20s%20lite%20pk_1.jpg","wholesale_price":"34.79","unit_price_tax":39.79},"product_model":{"product_data":{"ean13":["6972596100621"],"reference":"AMAZ BIP S LITE PK","name":{"1":"Smartwatch Huami Amazfit Bip S Lite\/ Notificaciones\/ Frecuencia Cardiaca\/ Rosa","2":"","3":"","4":""},"description":{"1":"<p><h2>Pantalla brillante y siempre encendida&nbsp;<\/h2><p>La pantalla a color transflectiva siempre est\u00e1 encendida y permite una excelente legibilidad de la pantalla a la vez que ofrece un bajo consumo de energ\u00eda y protecci\u00f3n para los ojos. Bip S lite reloj inteligente deporte le permite ver claramente la pantalla incluso si la luz de fondo consume mucha energ\u00eda no est\u00e1 encendido. En el exterior, cuanto m\u00e1s brillante es la luz del sol, m\u00e1s clara se puede ver la pantalla.<\/p><h2>Notificaciones de Inteligente en su mu\u00f1eca<\/h2><p>Con Bip S Lite Smartwatch Fitness, pareciendo un amigo inteligente puede recordarle las llamadas entrantes \/ mensajes \/ notificaciones de aplicaciones (incluidos SMS, Facebook, Whatsapp, Twitter, Instagram, Facebook Messenger y m\u00e1s) \/ alarma reloj \/ pron\u00f3stico del tiempo \/ reloj mundial, recordatorios sedentarios y control de m\u00fasica del tel\u00e9fono.<\/p><h2>Gran compa\u00f1ero deportivo<\/h2><p>Amazfit Bip S Lite reloj inteligente para homre y mujer es resistente al agua hasta 50 metros. Puede usarlo mientras nada, y tambi\u00e9n registrar datos interesantes de nataci\u00f3n, que incluyen frecuencia de brazada, tiempos de brazada, \u00edndice SWOLF, pistas en aguas abiertas, etc. El reloj tambi\u00e9n admite 14 modos deportivos, que proporcionan datos como la visualizaci\u00f3n de la pista, la velocidad, la frecuencia card\u00edaca, los recordatorios de distancia.<\/p><h2>Duraci\u00f3n excepcional de la bater\u00eda de 30 d\u00edas<\/h2><p>Gracias a la selecci\u00f3n de componentes electr\u00f3nicos y la tecnolog\u00eda de optimizaci\u00f3n de energ\u00eda, el estado del reloj inteligente Fitness Amazfit Bip S lite puede continuar 30 d\u00edas. Disfrute de la libertad de realizar un viaje de un mes sin su car