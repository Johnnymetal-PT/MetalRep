\/home\/hipermercado\/public_html\/img\/tmp\/ddb9e00719ebfe929d07c50791c9e64b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Teclado Inal\u00e1mbrico Xiaomi MIIIW Dual Mode\/ Blanco","category":"Teclados","sub_category":"Teclados","unit_price":38.15,"reference":"MIIIW WH","ean13":"6971519750035","weight":"1.16","quantity":2,"brand":"XIAOMI","description_pt":"<p><\/p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Modelo: MIIIW<\/li>  <li>Teclado inal\u00e1mbrico<\/li>  <li>Teclado QWERTY<\/li>  <li>Modo de conexi\u00f3n:<\/li>  <li>Bluetooth v4.0<\/li>  <li>WiFi 2.4GHz<\/li>  <li>Distancia de transmisi\u00f3n: hasta 10 metros<\/li>  <li>Altura de las teclas: 1.5 mm<\/li>  <li>Teclas circulares<\/li>  <li>Material: ABS y aleaci\u00f3n de aluminio<\/li>  <li>Bater\u00eda: 2 pilas AAA   <\/li><li>Dimensiones: 40.8 x 14.3 x 2.36 cm<\/li>  <li>Peso: 897 gr<\/li><li><b>Teclado Ingles<\/b><\/li><\/ul><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-tec%20miiiw%20wh_1.jpg","wholesale_price":"33.15","unit_price_tax":38.15},"product_model":{"product_data":{"ean13":["6971519750035"],"reference":"MIIIW WH","name":{"1":"Teclado Inal\u00e1mbrico Xiaomi MIIIW Dual Mode\/ Blanco","2":"","3":"","4":""},"description":{"1":"<p><\/p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Modelo: MIIIW<\/li>  <li>Teclado inal\u00e1mbrico<\/li>  <li>Teclado QWERTY<\/li>  <li>Modo de conexi\u00f3n:<\/li>  <li>Bluetooth v4.0<\/li>  <li>WiFi 2.4GHz<\/li>  <li>Distancia de transmisi\u00f3n: hasta 10 metros<\/li>  <li>Altura de las teclas: 1.5 mm<\/li>  <li>Teclas circulares<\/li>  <li>Material: ABS y aleaci\u00f3n de aluminio<\/li>  <li>Bater\u00eda: 2 pilas AAA   <\/li><li>Dimensiones: 40.8 x 14.3 x 2.36 cm<\/li>  <li>Peso: 897 gr<\/li><li><b>Teclado Ingles<\/b><\/li><\/ul><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":1.16,"unit_price":38.15,"unit_price_tax":38.15,"tax_rules_group":null,"category":"Teclados","sub_category":"Teclados","quantity":2,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-tec%20miiiw%20wh_1.jpg"],"wholesale_price":33.15}}},"4250366861838":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4250366861838",false],"wholesale_price":[71.59,false],"price":[76.59,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.34",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:94082","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b8100f3d873789a9e45a3ede1da1f7e1.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tel\u00e9fono Inal\u00e1mbrico Gigaset S700H Pro\/ Antracita","category":"Tel\u00e9fonos Fijos  Inal\u00e1mbricos","sub_category":"Telefonos Fijos e Inalambricos DECT","unit_price":76.59,"reference":"S30852-H2974-R102","ean13":"4250366861838","weight":"0.34","quantity":0,"brand":"GIGASET","description_pt":"<p><h2>El tel\u00e9fono vers\u00e1til con m\u00faltiples funciones siempre triunfa en los entornos de trabajo diarios<\/h2>Cuando las cosas se alargan m\u00e1s de lo previsto en el trabajo, es necesario un tel\u00e9fono resistente. El Gigaset S700H PRO es fiable en todo momento: El tiempo de espera extralargo y la superficie robusta, resistente incluso a los desinfectantes, son algunas de las caracter\u00edsticas m\u00e1s destacadas.<br><br>Adem\u00e1s, el dispositivo m\u00f3vil DECT profesional de Gigaset incorpora muchas funciones, como perfiles de audio y una calidad de sonido HD excepcional. Es ligero e intuitivo, y podr\u00e1 acceder f\u00e1cilmente a los directorios y contactos. Si lo que busca es una comunicaci\u00f3n impecable y sin concesiones, esto es lo que necesita.<br><br><h2>Encuentra un socio<\/h2>La gama Gigaset pro se distribuye exclusivamente a trav\u00e9s de socios comerciales cualificados.<br><br>Nuestros socios son distribuidores de TI y telecomunicaciones, as\u00ed como distribuidores de valor a\u00f1adido (VAR) y proveedores de sistemas empresariales. Nuestros socios asesoran, venden, instalan y prestan otros servicios de Gigaset pro.<br><br><h2>Vers\u00e1til para adaptarse a los requisitos m\u00e1s estrictos<\/h2>Lo grande no siempre es mejor, pero en este caso s\u00ed: El Gigaset S700H PRO incorpora una gran pantalla de color TFT de 2,4 pulgadas iluminada. Es un aut\u00e9ntico todoterreno y satisface todos los requisitos de un tel\u00e9fono DECT profesional. Numerosas funciones, como SUOTA, Bluetooth 4.2, perfiles de audio y una calidad de sonido excepcional (HDSP&#8482;) convierten el dispositivo en el compa\u00f1ero ideal para los entornos de trabajo diarios.<br><br><h2>Resistencia profesional con tiempos de carga cortos<\/h2>Cuando las cosas se alargan m\u00e1s de lo previsto, este tel\u00e9fono inal\u00e1mbrico es ideal: Es c\u00f3modo y destaca por su excelente calidad de sonido. Incluso despu\u00e9s de una larga jornada laboral, no le fallar\u00e1: Con 13 horas de conversaci\u00f3n y hasta 320 horas en modo de espera, es extremadamente resistente. Los tiempos de carga son sorprendentemente cortos. Adem\u00e1s, ofrece una c\u00f3moda opci\u00f3n de carga desde el puerto micro-USB.<br><br><h2>Libertad y flexibilidad<\/h2>Oc\u00fapese solo de las llamadas, nosotros nos encargamos de los detalles: Por ejemplo, gracias al innovador clip de cintur\u00f3n giratorio 360\u00b0, tendr\u00e1 el tel\u00e9fono a mano en todo momento... y las manos libres. En el Gigaset S700H PRO se ha estudiado hasta el m\u00e1s m\u00ednimo detalle: Muchas otras funciones simplifican el trabajo diario.&nbsp; Como el bloqueo del teclado con protecci\u00f3n mediante PIN o los perfiles de audio seleccionables por separado. Y luego est\u00e1n las teclas de funci\u00f3n configurables, con las que puede marcar directamente de forma r\u00e1pida y sencilla o activar una llamada de emergencia.<br><br><h2>Dise\u00f1o resistente a los desinfectantes<\/h2>Un sobresaliente en prestaciones, precio y dise\u00f1o: Este tel\u00e9fono profesional es de gran calidad, tiene un precio atractivo y una forma elegante. Para seguir en esta l\u00ednea, tiene un recubrimiento de superficie m\u00e1s duro.Esto significa: Los ara\u00f1azos y desinfectantes no son problem\u00e1ticos, y la suciedad y los virus no tienen nada que hacer. Est\u00e1 certificado con el grado de protecci\u00f3n IP40 y dise\u00f1ado para que no penetre en \u00e9l polvo met\u00e1lico.<br><br><h2>Protecci\u00f3n gracias a las opciones de seguridad<\/h2>No molestar: Para proteger la informaci\u00f3n privada, este tel\u00e9fono DECT inal\u00e1mbrico tiene una opci\u00f3n de Hotel. Gracias a ella, todas las listas de llamadas y datos sensibles dentro de un periodo de tiempo predefinido son eliminados para que otros usuarios no puedan acceder a ellos. Esto ofrece una seguridad adicional, no solo en el sector de la hosteler\u00eda y la restauraci\u00f3n: El Gigaset S700H PRO se adapta perfectamente a los entornos de trabajo diarios. <br><br><h2>Profesionalidad con un enfoque sistem\u00e1tico<\/h2>Como es de sobras conocido, la comunicaci\u00f3n es fundamental para el \u00e9xito. Por eso es importante que se prepare lo mejor posible para las tareas de comunicaci\u00f3n en su trabajo: El Gigaset S700H PRO est\u00e1 optimizado para el uso con todos los sistemas DECT profesionales de Gigaset. Pero tambi\u00e9n se puede utilizar con bases de terceros compatibles con CAT-iq y GAP.\u00bfQue si existe un enfoque sistem\u00e1tico aqu\u00ed? \u00a1No le quepa la menor duda!<br><br><h2>Dispositivo de usuario de un sistema AML<\/h2>El S700H PRO puede integrarse idealmente en un sistema de alarma, mensajer\u00eda y localizaci\u00f3n (AML) como dispositivo de usuario. Dispone de una tecla de alarma, con la que se pueden activar dos alarmas diferentes con pulsaciones cortas y prolongadas. Los mensajes de texto se pueden recibir y clasificar por diferentes opciones (como la prioridad y el estado del mensaje). Tambi\u00e9n es posible realizar un seguimiento muy preciso de la ubicaci\u00f3n.<br><br><ul>  <li><b>Caracter\u00edsticas generales<\/b><\/li>  <li>Color: Antracita<\/li>  <li>Versi\u00f3n: Auricular<\/li>  <li>Conexi\u00f3n: Anal\u00f3gico, RDSI, VoIP<\/li>  <li>Llamadas en paralelo (anal\u00f3gico): 1<\/li>  <li>Llamadas en paralelo (IP): 2<\/li>  <li>Llamadas en paralelo (RDSI): 2<\/li>  <li>Conexi\u00f3n m\u00f3vil: no<\/li>  <li>Est\u00e1ndares DECT: DECT, GAP, CAT iq 2.0<\/li>  <li>Interfaz interna: Bluetooth\u00ae, Micro-USB, Conexi\u00f3n de auricular de 3,5 mm<\/li>  <li>DECT ECO: autom\u00e1tico reducci\u00f3n de la potencia de transmisi\u00f3n, sin radiaci\u00f3n en modo de espera, bajo consumo de energ\u00eda<\/li>  <li><b>Caracter\u00edsticas adicionales<\/b><\/li>  <li>Tiempo de espera hasta (h): 320<\/li>  <li>Tiempo de conversaci\u00f3n hasta (h): 13<\/li>  <li>N\u00famero de entradas de la libreta de direcciones (nombre, apellido, 3 n\u00fameros, recordatorio de fecha, sonidos): 500<\/li>  <li>Tonos de llamada individuales para entradas VIP: Si<\/li>  <li>Transferencia de V-Card, m\u00f3vil a tel\u00e9fono a trav\u00e9s de Bluetooth\u00ae: Si<\/li>  <li>Sincronizaci\u00f3n de la libreta de direcciones a trav\u00e9s de QuickSync (Contactos de Outlook Windows): Si<\/li>  <li>Teclas de marcaci\u00f3n directa en el tel\u00e9fono: 12<\/li>  <li>Funci\u00f3n de rellamada autom\u00e1tica en el tel\u00e9fono: Si<\/li>  <li>Calendario: Si<\/li>  <li>Funci\u00f3n de alarma: Si<\/li>  <li>Funci\u00f3n SOS: Si<\/li>  <li>Se\u00f1alizaci\u00f3n \u00f3ptica de llamadas: Pantalla iluminada, tecla de env\u00edo parpadeante<\/li>  <li><b>Caracter\u00edsticas de sonido<\/b><\/li>  <li>Calidad de sonido\/Caracter\u00edsticas ac\u00fasticas: HD Voice (certificaci\u00f3n CAT-iq), HD Voice (voz de banda ancha)<\/li>  <li>hablar con manos libres: Pr\u00e1ctico hablar con manos libres (calidad full d\u00faplex)<\/li>  <li>Auricular parlante manos libres \/ base \/ Dispositivo principal: Auricular<\/li>  <li>Volumen ajustable: A trav\u00e9s del men\u00fa, a trav\u00e9s de la tecla lateral<\/li>  <li>N\u00famero de tonos de llamada: 32<\/li>  <li>Subir tonos de llamada propios: Si<\/li>  <li>Vibrallamada: Si<\/li>  <li><b>Caracter\u00edsticas de la pantalla<\/b><\/li>  <li>Tipo de visualizaci\u00f3n: Pantalla a color<\/li>  <li>Dimensiones (Al x An mm): 49x37<\/li>  <li>Separaci\u00f3n diagonal (pulgadas): 2,4'<\/li>  <li>Resoluci\u00f3n (px): 240x320<\/li>  <li>Fuentes gigantes: No<\/li>  <li>Visualizaci\u00f3n de la persona que llama: Visualizaci\u00f3n del n\u00famero de la persona que llama (CLIP) con imagen (Picture CLIP)<\/li>  <li>Lista de las \u00faltimas # llamadas perdidas con fecha y hora: 20<\/li>  <li>Lista de # llamadas salientes con fecha y hora: 20<\/li>  <li>Lista de # llamadas recibidas con hora y fecha: 20<\/li>  <li>Lista de # todas las llamadas con hora y fecha: 60<\/li>  <li>Men\u00fa multiling\u00fce (varios idiomas de visualizaci\u00f3n): Si<\/li>  <li>Hora \/ Fecha mostrada: Si<\/li>  <li><b>Caracter\u00edsticas del teclado<\/b><\/li>  <li>Teclado iluminado: Si<\/li>  <li>F\u00e1cil manejo con tecla de navegaci\u00f3n: Si<\/li>  <li>Tecla indicadora de mensaje: Si<\/li>  <li>Protecci\u00f3n Agua\/Polvo\/Golpes (seg\u00fan IP 65): No<\/li>  <li>Resistencia a rayones y desinfectantes: Si<\/li>  <li><b>Tama\u00f1o\/especificaciones t\u00e9cnicas<\/b><\/li>  <li>Auricular, Al x An x Pr en mm: 151x49x26<\/li>  <li>Cargador, Al x An x Pr en mm: 40x81x80<\/li>  <li>Tipo de bater\u00eda: 2 pilas NiMH AAA<\/li>  <li><b>Compatibilidad<\/b><\/li>  <li>Sistemas monocelda profesionales Gigaset: Si<\/li>  <li>Sistemas multicelda profesionales Gigaset: Si<\/li>  <li>Estaciones base compatibles con GAP: Si<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_giga-tel%20s700h%20pro_1.jpg","wholesale_price":"71.59","unit_price_tax":76.59},"product_model":{"product_data":{"ean13":["4250366861838"],"reference":"S30852-H2974-R102","name":{"1":"Tel\u00e9fono Inal\u00e1mbrico Gigaset S700H Pro\/ Antracita","2":"","3":"","4":""},"description":{"1":"<p><h2>El tel\u00e9fono vers\u00e1til con m\u00faltiples funciones siempre triunfa en los entornos de trabajo diarios<\/h2>Cuando las cosas se alargan m\u00e1s de lo previsto en el trabajo, es necesario un tel\u00e9fono resistente. El Gigaset S700H PRO es fiable en todo momento: El tiempo de espera extralargo y la superficie robusta, resistente incluso a los desinfectantes, son algunas de las caracter\u00edsticas m\u00e1s destacadas.<br><br>Adem\u00e1s, el dispositivo m\u00f3vil DECT profesional de Gigaset incorpora muchas funciones, como perfiles de audio y una calidad de sonido HD excepcional. Es ligero e intuitivo, y podr\u00e1 acceder f\u00e1cilmente a los directorios y contactos. Si lo que busca es una comunicaci\u00f3n impecable y sin concesiones, esto es lo que necesita.<br><br><h2>Encuentra un socio<\/h2>La gama Gigaset pro se distribuye exclusivamente a trav\u00e9s de socios comerciales cualificados.<br><br>Nuestros socios son distribuidores de TI y telecomunicaciones, as\u00ed como distribuidores de valor a\u00f1adido (VAR) y proveedores de sistemas empresariales. Nuestros socios asesoran, venden, instalan y prestan otros servicios de Gigaset pro.<br><br><h2>Vers\u00e1til para adaptarse a los requisitos m\u00e1s estrictos<\/h2>Lo grande no siempre es mejor, pero en este caso s\u00ed: El Gigaset S700H PRO incorpora una gran pantalla de color TFT de 2,4 pulgadas iluminada. Es un aut\u00e9ntico todoterreno y satisface todos los requisitos de un tel\u00e9fono DECT profesional. Numerosas funciones, como SUOTA, Bluetooth 4.2, perfiles de audio y una calidad de sonido excepcional (HDSP&#8482;) convierten el dispositivo en el compa\u00f1ero ideal para los entornos de trabajo diarios.<br><br><h2>Resistencia profesional con tiempos de carga cortos<\/h2>Cuando las cosas se alargan m\u00e1s de lo previsto, este tel\u00e9fono inal\u00e1mbrico es ideal: Es c\u00f3modo y destaca por su excelente calidad de sonido. Incluso despu\u00e9s de una larga jornada laboral, no le fallar\u00e1: Con 13 horas de conversaci\u00f3n y hasta 320 horas en modo de espera, es extremadamente resistente. Los tiempos de carga son sorprendentemente cortos. Adem\u00e1s, ofrece una c\u00f3moda opci\u00f3n de carga desde el puerto micro-USB.<br><br><h2>Libertad y flexibilidad<\/h2>Oc\u00fapese solo de las llamadas, nosotros nos encargamos de los detalles: Por ejemplo, gracias al innovador clip de cintur\u00f3n giratorio 360\u00b0, tendr\u00e1 el tel\u00e9fono a mano en todo momento... y las manos libres. En el Gigaset S700H PRO se ha estudiado hasta el m\u00e1s m\u00ednimo detalle: Muchas otras funciones simplifican el trabajo diario.&nbsp; Como el bloqueo del teclado con protecci\u00f3n mediante PIN o los perfiles de audio seleccionables por separado. Y luego est\u00e1n las teclas de funci\u00f3n configurables, con las que puede marcar directamente de forma r\u00e1pida y sencilla o activar una llamada de emergencia.<br><br><h2>Dise\u00f1o resistente a los desinfectantes<\/h2>Un sobresaliente en prestaciones, precio y dise\u00f1o: Este tel\u00e9fono profesional es de gran calidad, tiene un precio atractivo y una forma elegante. Para seguir en esta l\u00ednea, tiene un recubrimiento de superficie m\u00e1s duro.Esto significa: Los ara\u00f1azos y desinfectantes no son problem\u00e1ticos, y la suciedad y los virus no tienen nada que hacer. Est\u00e1 certificado con el grado de protecci\u00f3n IP40 y dise\u00f1ado para que no penetre en \u00e9l polvo met\u00e1lico.<br><br><h2>Protecci\u00f3n gracias a las opciones de seguridad<\/h2>No molestar: Para proteger la informaci\u00f3n privada, este tel\u00e9fono DECT inal\u00e1mbrico tiene una opci\u00f3n de Hotel. Gracias a ella, todas las listas de llamadas y datos sensibles dentro de un periodo de tiempo predefinido son eliminados para que otros usuarios no puedan acceder a ellos. Esto ofrece una seguridad adicional, no solo en el sector de la hosteler\u00eda y la restauraci\u00f3n: El Gigaset S700H PRO se adapta perfectamente a los entornos de trabajo diarios. <br><br><h2>Profesionalidad con un enfoque sistem\u00e1tico<\/h2>Como es de sobras conocido, la comunicaci\u00f3n es fundamental para el \u00e9xito. Por eso es importante que se prepare lo mejor posible para las tareas de comunicaci\u00f3n en su trabajo: El Gigaset S700H PRO est\u00e1 optimizado para el uso con todos los sistemas DECT profesionales de Gigaset. Pero tambi\u00e9n se puede utilizar con bases de terceros compatibles con CAT-iq y GAP.\u00bfQue si existe un enfoque sistem\u00e1tico aqu\u00ed? \u00a1No le quepa la menor duda!<br><br><h2>Dispositivo de usuario de un sistema AML<\/h2>El S700H PRO puede integrarse idealmente en un sistema de alarma, mensajer\u00eda y localizaci\u00f3n (AML) como dispositivo de usuario. Dispone de una tecla de alarma, con la que se pueden activar dos alarmas diferentes con pulsaciones cortas y prolongadas. Los mensajes de texto se pueden recibir y clasificar por diferentes opciones (como la prioridad y el estado del mensaje). Tambi\u00e9n es posible realizar un seguimiento muy preciso de la ubicaci\u00f3n.<br><br><ul>  <li><b>Caracter\u00edsticas generales<\/b><\/li>  <li>Color: Antracita<\/li>  <li>Versi\u00f3n: Auricular<\/li>  <li>Conexi\u00f3n: Anal\u00f3gico, RDSI, VoIP<\/li>  <li>Llamadas en paralelo (anal\u00f3gico): 1<\/li>  <li>Llamadas en paralelo (IP): 2<\/li>  <li>Llamadas en paralelo (RDSI): 2<\/li>  <li>Conexi\u00f3n m\u00f3vil: no<\/li>  <li>Est\u00e1ndares DECT: DECT, GAP, CAT iq 2.0<\/li>  <li>Interfaz interna: Bluetooth\u00ae, Micro-USB, Conexi\u00f3n de auricular de 3,5 mm<\/li>  <li>DECT ECO: autom\u00e1tico reducci\u00f3n de la potencia de transmisi\u00f3n, sin radiaci\u00f3n en modo de espera, bajo consumo de energ\u00eda<\/li>  <li><b>Caracter\u00edsticas adicionales<\/b><\/li>  <li>Tiempo de espera hasta (h): 320<\/li>  <li>Tiempo de conversaci\u00f3n hasta (h): 13<\/li>  <li>N\u00famero de entradas de la libreta de direcciones (nombre, apellido, 3 n\u00fameros, recordatorio de fecha, sonidos): 500<\/li>  <li>Tonos de llamada individuales para entradas VIP: Si<\/li>  <li>Transferencia de V-Card, m\u00f3vil a tel\u00e9fono a trav\u00e9s de Bluetooth\u00ae: Si<\/li>  <li>Sincronizaci\u00f3n de la libreta de direcciones a trav\u00e9s de QuickSync (Contactos de Outlook Windows): Si<\/li>  <li>Teclas de marcaci\u00f3n directa en el tel\u00e9fono: 12<\/li>  <li>Funci\u00f3n de rellamada autom\u00e1tica en el tel\u00e9fono: Si<\/li>  <li>Calendario: Si<\/li>  <li>Funci\u00f3n de alarma: Si<\/li>  <li>Funci\u00f3n SOS: Si<\/li>  <li>Se\u00f1alizaci\u00f3n \u00f3ptica de llamadas: Pantalla iluminada, tecla de env\u00edo parpadeante<\/li>  <li><b>Caracter\u00edsticas de sonido<\/b><\/li>  <li>Calidad de sonido\/Caracter\u00edsticas ac\u00fasticas: HD Voice (certificaci\u00f3n CAT-iq), HD Voice (voz de banda ancha)<\/li>  <li>hablar con manos libres: Pr\u00e1ctico hablar con manos libres (calidad full d\u00faplex)<\/li>  <li>Auricular parlante manos libres \/ base \/ Dispositivo principal: Auricular<\/li>  <li>Volumen ajustable: A trav\u00e9s del men\u00fa, a trav\u00e9s de la tecla lateral<\/li>  <li>N\u00famero de tonos de llamada: 32<\/li>  <li>Subir tonos de llamada propios: Si<\/li>  <li>Vibrallamada: Si<\/li>  <li><b>Caracter\u00edsticas de la pantalla<\/b><\/li>  <li>Tipo de visualizaci\u00f3n: Pantalla a color<\/li>  <li>Dimensiones (Al x An mm): 49x37<\/li>  <li>Separaci\u00f3n diagonal (pulgadas): 2,4'<\/li>  <li>Resoluci\u00f3n (px): 240x320<\/li>  <li>Fuentes gigantes: No<\/li>  <li>Visualizaci\u00f3n de la persona que llama: Visualizaci\u00f3n del n\u00famero de la persona que llama (CLIP) con imagen (Picture CLIP)<\/li>  <li>Lista de las \u00faltimas # llamadas perdidas con fecha y hora: 20<\/li>  <li>Lista de # llamadas salientes con fecha y hora: 20<\/li>  <li>Lista de # llamadas recibidas con hora y fecha: 20<\/li>  <li>Lista de # todas las llamadas con hora y fecha: 60<\/li>  <li>Men\u00fa multiling\u00fce (varios idiomas de visualizaci\u00f3n): Si<\/li>  <li>Hora \/ Fecha mostrada: Si<\/li>  <li><b>Caracter\u00edsticas del teclado<\/b><\/li>  <li>Teclado iluminado: Si<\/li>  <li>F\u00e1cil manejo con tecla de navegaci\u00f3n: Si<\/li>  <li>Tecla indicadora de mensaje: Si<\/li>  <li>Protecci\u00f3n Agua\/Polvo\/Golpes (seg\u00fan IP 65): No<\/li>  <li>Resistencia a rayones y desinfectantes: Si<\/li>  <li><b>Tama\u00f1o\/especificaciones t\u00e9cnicas<\/b><\/li>  <li>Auricular, Al x An x Pr en mm: 151x49x26<\/li>  <li>Cargador, Al x An x Pr en mm: 40x81x80<\/li>  <li>Tipo de bater\u00eda: 2 pilas NiMH AAA<\/li>  <li><b>Compatibilidad<\/b><\/li>  <li>Sistemas monocelda profesionales Gigaset: Si<\/li>  <li>Sistemas multicelda profesionales Gigaset: Si<\/li>  <li>Estaciones base compatibles con GAP: Si<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GIGASET","supplier":null,"width":null,"height":null,"depth":null,"weight":0.34,"unit_price":76.59,"unit_price_tax":76.59,"tax_rules_group":null,"category":"Tel\u00e9fonos Fijos  Inal\u00e1mbricos","sub_category":"Telefonos Fijos e Inalambricos DECT","quantity":0,"brand":"GIGASET","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_giga-tel%20s700h%20pro_1.jpg"],"wholesale_price":71.59}}},"6951613999486":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6951613999486",false],"wholesale_price":[24.47,false],"price":[29.47,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.5",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:94083","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fdf11892a02213bb4cfcd9348f12fa16.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tel\u00e9fono Inal\u00e1mbrico Philips LINEA V M3501B\/23 V2\/ Negro","category":"Tel\u00e9fonos Fijos  Inal\u00e1mbricos","sub_category":"Telefonos Fijos e Inalambricos DECT","unit_price":29.47,"reference":"M3501B\/23","ean13":"6951613999486","weight":"0.5","quantity":5,"brand":"PHILIPS","description_pt":"                                                                                                                                                <p><h2>La l\u00ednea de conexi\u00f3n m\u00e1s fina<\/h2><p>En el preciso Philips LINEA V, el dise\u00f1o se convierte en el centro de atenci\u00f3n gracias a una provocadora forma y una silueta ic\u00f3nica. La elegante arquitectura es compatible con funciones inteligentes y proporciona una gran comodidad. Todo ello hace que el LINEA V sea un producto imprescindible<\/p><ul><li>Pantalla 1,8'\/retroiluminaci\u00f3n blanca<\/li><li>Manos libres<\/li><\/ul><h2>Cero emisiones de energ\u00eda cuando el modo ECO+ est\u00e1 activado<\/h2><p>Los tel\u00e9fonos de Philips son de bajo consumo y se han dise\u00f1ado para respetar el medio ambiente. Al activar el modo ECO, la radiaci\u00f3n emitida se reduce hasta un 60\u00a0% y hasta un 95\u00a0% cuando el tel\u00e9fono se est\u00e1 cargando. Con la activaci\u00f3n del modo ECO+, la radiaci\u00f3n se reduce a cero.<\/p><h2>El altavoz te permite hablar en manos libres<\/h2><p>Con el modo de manos libres puedes escuchar a la persona que te llama a trav\u00e9s de un altavoz integrado, lo que te permitir\u00e1 conversar sin tener que sujetar el tel\u00e9fono junto al o\u00eddo. Esto resulta particularmente \u00fatil si quieres compartir una llamada con m\u00e1s gente o simplemente realizar otras tareas.<\/p><h2>HQ-Sound: ingenier\u00eda ac\u00fastica de alta calidad para un sonido soberbio<\/h2><p>HQ-Sound: ingenier\u00eda ac\u00fastica de alta calidad para una reproducci\u00f3n del sonido soberbia. Contamos con d\u00e9cadas de experiencia e innovaciones vanguardistas en el desarrollo de productos de audio Hi-Fi y auriculares de gama alta que nos permiten ofrecer una claridad de voz excelente en nuestros tel\u00e9fonos DECT. Cuando se trata de mejorar la calidad de sonido, nuestros ingenieros y arquitectos de sonido han pensado en todo: componentes de alta calidad, procesamiento digital de la se\u00f1al, dise\u00f1o ac\u00fastico preciso, pruebas avanzadas y ajuste preciso. El resultado es un sonido n\u00edtido, claro y aut\u00e9ntico. Un sonido tan bueno y natural, que es casi como estar all\u00ed en persona.<\/p><h2>Pantalla invertida de alto contraste de 2 l\u00edneas de 4,6 cm (1,8')<\/h2><p>La pantalla LCD invertida de alto contraste blanco sobre negro garantiza una lectura f\u00e1cil y se integra perfectamente con el elegante idioma de dise\u00f1o general.<\/p><h2>Guarda hasta 50\u00a0contactos favoritos en la agenda<\/h2><p>Guarda hasta 50\u00a0contactos favoritos en la agenda.<\/p><h2>Botones calibrados e integrados perfectamente para una marcaci\u00f3n precisa<\/h2><p>El teclado calibrado te permite sentir claramente cada pulsaci\u00f3n de un bot\u00f3n, ya est\u00e9s marcando un n\u00famero o introduciendo un contacto en la agenda. Un estudio detallado de los materiales y las estructuras del teclado, adem\u00e1s de amplias pruebas con usuarios, han dado como resultado un equilibrio adecuado entre la fuerza de pulsaci\u00f3n de los botones y la respuesta de los mismos, para garantizar una marcaci\u00f3n precisa.<\/p><h2>Delgado y compacto para ahorrar espacio<\/h2><p>Delgado y compacto para ahorrar espacio<\/p><h2>Mantente conectado durante cortes el\u00e9ctricos con el cargador micro USB<\/h2><p>La toma de conector micro USB integrada en la unidad base garantiza que el tel\u00e9fono se mantiene cargado a trav\u00e9s del cargador precargado, para que puedas realizar llamadas incluso si se corta la corriente. La funci\u00f3n de carga del cargador es compatible con la mayor\u00eda de productos de carga que puedan proporcionar una corriente de salida m\u00ednima inferior a 85\u00a0mA sin apagado autom\u00e1tico. El cargador se vende por separado.<\/p><p><\/p><h2>Ajustes de privacidad: bloqueo de llamadas<\/h2><p>\u00bfValoras tu privacidad y tranquilidad en casa? La lista negra restringe las llamadas de n\u00fameros espec\u00edficos o que empiecen por determinados d\u00edgitos, protegi\u00e9ndote de la recepci\u00f3n de llamadas no deseadas. Puedes bloquear hasta 4 grupos de n\u00fameros. Cada grupo puede tener entre 1 y 24 d\u00edgitos. Tu tel\u00e9fono no sonar\u00e1 si detecta que el n\u00famero de una llamada entrante empieza por alguno de los grupos de n\u00fameros o los n\u00fameros exactos que has decidido bloquear. Gracias al bloqueo de llamadas, puedes evitar sorpresas negativas en tu factura telef\u00f3nica bloqueando las llamadas a n\u00fameros espec\u00edficos que comienzan con determinados d\u00edgitos (por ejemplo, n\u00fameros de pago).<\/p><h2>Disfruta de 10\u00a0horas de conversaci\u00f3n con una sola carga<\/h2><p>Disfruta de 10\u00a0horas de conversaci\u00f3n con una sola carga<\/p><br><ul><li><b>Especificaciones t\u00e9cnicas<\/b><\/li><li>C\u00f3modas funciones<\/li><li>Estructura del men\u00fa en el microtel\u00e9fono<\/li><li>Men\u00fa de lista<\/li><li>Manos libres: libertad en tus llamadas<\/li><li>S\u00ed<\/li><li>Indicador de intensidad de la se\u00f1al<\/li><li>Indicador de 3 barras<\/li><li>Indicador de nivel de la bater\u00eda<\/li><li>Icono de bater\u00eda de 3 barras<\/li><li>Fecha\/hora en pantalla<\/li><li>S\u00ed<\/li><li>Indicador de carga de la bater\u00eda<\/li><li>S\u00ed<\/li><li>Indicaci\u00f3n de la fuerza de la se\u00f1al<\/li><li>S\u00ed<\/li><li>Teclas de acceso r\u00e1pido programables<\/li><li>Teclas 1 y 2<\/li><li>Gesti\u00f3n de llamadas<\/li><li>Llamada en espera*<\/li><li>Identificaci\u00f3n de llamadas entrantes*<\/li><li>Silenciamiento del micr\u00f3fono<\/li><li>Llamadas perdidas<\/li><li>Llamadas recibidas<\/li><li>Llamadas marcadas<\/li><li>Bloqueo del teclado<\/li><li>S\u00ed<\/li><li>Activaci\u00f3n\/desactivaci\u00f3n de tono de tecla<\/li><li>S\u00ed<\/li><li>Colgar autom\u00e1ticamente<\/li><li>S\u00ed<\/li><li>Capacidad para varias bases<\/li><li>1<\/li><li>Teclado retroiluminado<\/li><li>\u00c1mbar suave<\/li><li>Hasta 180 horas en modo de espera<\/li><li>S\u00ed<\/li><li>Tiempo de carga: 8 horas<\/li><li>S\u00ed<\/li><li>Longitud del cable de l\u00ednea<\/li><li>1,8 m<\/li><li>Longitud del cable de alimentaci\u00f3n<\/li><li>1,8 m<\/li><li>Alcance<\/li><li>En exteriores <300 m; en interiores <50 m<\/li><li>Alarmas<\/li><li>Reloj despertador<\/li><li>Teclas de la base<\/li><li>Tecla de localizador<\/li><li>Bloqueo de interlocutores\/lista negra*<\/li><li>Restricci\u00f3n del tel\u00e9fono para que no suene con n\u00fameros entrantes espec\u00edficos<\/li><li>Bloqueo de llamada<\/li><li>Restricci\u00f3n del tel\u00e9fono para no realizar llamadas espec\u00edficas<\/li><li>Notificaciones de eventos<\/li><li>Para el estado de eventos<\/li><li>Teclado iluminado<\/li><li>S\u00ed<\/li><li>N\u00famero de teclas<\/li><li>20<\/li><li>Hasta 10 horas de conversaci\u00f3n<\/li><li>S\u00ed\u00a0 hora<\/li><li><b>Sonido<\/b><\/li><li>Tonos de llamada en el microtel\u00e9fono<\/li><li>10 tonos polif\u00f3nicos<\/li><li>HQ-Sound<\/li><li>S\u00ed<\/li><li>Control de volumen en el microtel\u00e9fono<\/li><li>S\u00ed<\/li><li><b>Imagen\/Pantalla<\/b><\/li><li>Tama\u00f1o de pantalla<\/li><li>1,8' (4,6 cm)<\/li><li>Tipo de pantalla<\/li><li>Matriz de puntos de 1 l\u00ednea + teclado num\u00e9rico de 1 l\u00ednea + teclas de iconos<\/li><li>Retroiluminaci\u00f3n: s\u00ed<\/li><li>S\u00ed<\/li><li>Color de retroiluminaci\u00f3n<\/li><li>Blanco<\/li><li><b>Capacidad de la memoria<\/b><\/li><li>Agenda<\/li><li>50 nombres y n\u00fameros<\/li><li>Capacidad de lista de rellamada<\/li><li>10 entradas<\/li><li>Lista de llamadas<\/li><li>20 entradas<\/li><li>Almacenamiento de la agenda en la base<\/li><li>S\u00ed<\/li><li><b>Potencia<\/b><\/li><li>Capacidad de la bater\u00eda<\/li><li>300 mAh<\/li><li>Tipo de bater\u00eda<\/li><li>2 pilas AAA NiMH recargables<\/li><li>Red el\u00e9ctrica<\/li><li>100-240 V CA, ~50\/60 Hz<\/li><li>Consumo de energ\u00eda<\/li><li>< 0,7 W<\/li><li><b>Seguridad<\/b><\/li><li>Codificaci\u00f3n de la transmisi\u00f3n: s\u00ed<\/li><li>S\u00ed<\/li><li><b>Prestaciones de la red<\/b><\/li><li>Compatible<\/li><li>GAP<\/li><li><b>Valor SAR<\/b><\/li><li>Microtel\u00e9fonos Philips<\/li><li>< 0,1 W\/kg<\/li><li><b>Dise\u00f1o ecol\u00f3gico<\/b><\/li><li>Eco+<\/li><li>S\u00ed<\/li><li><b>Dimensiones del embalaje<\/b><\/li><li>Tipo de embalaje<\/li><li>Cart\u00f3n<\/li><li>N\u00famero de productos incluidos<\/li><li>1<\/li><li>Tipo de colocaci\u00f3n<\/li><li>Horizontal<\/li><li>Altura<\/li><li>22,5\u00a0 cm<\/li><li>Anchura<\/li><li>12,1\u00a0 cm<\/li><li>Profundidad<\/li><li>10,1\u00a0 cm<\/li><\/ul><\/p>                                      