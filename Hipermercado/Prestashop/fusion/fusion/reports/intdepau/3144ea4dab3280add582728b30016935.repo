ries","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8bb8faa4304833a46eb84f1ced90771b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares JVC HAS180\/ Jack 3.5\/ Blancos","category":"Auriculares","sub_category":"Auriculares","unit_price":13.48,"reference":"HA-S180-W-E","ean13":"4975769424878","weight":"0.26","quantity":0,"brand":"JVC","description_pt":"                                                <p>Auriculares cerrados y ligeros con dise\u00f1o plegable dual para mayor portabilidad, sistema Deep Bass, sonido de alta calidad y cable de 1,2 m, en color blanco<br><\/p><p><ul><li>Reproducci\u00f3n de sonido de alta calidad con excitador de neodimio de 30 mm<\/li><li>Graves potentes gracias al sistema Deep Bass<\/li><li>Dise\u00f1o plegable dual (plano & compacto) para una m\u00e1xima portabilidad<\/li><li>Dise\u00f1o ligero para disfrutar de escuchas prolongadas<\/li><li>Disponible en 4 colores<\/li><li>Cable de 1,2 m. con conector delgado ba\u00f1ado en oro compatible con iPhone<\/li><\/ul><br><\/p><ul>  <li>    <h2>Especificaciones<\/h2>  <\/li>  <li>Auriculares<\/li>  <li>Unidad de excitador: 30 mm<\/li>  <li>Tipo de im\u00e1n: Neodimio<\/li>  <li>Respuesta de frecuencia: 10-22.000 Hz<\/li>  <li>Capacidad de entrada m\u00e1xima: 500 mW (IEC)<\/li>  <li>Longitud del cable: 1.2m<\/li>  <li>Peso (sin cable): 108 g<\/li>  <li>Conector: Compatible con iPhone, ba\u00f1ado en oro<\/li><\/ul><br><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_jvc-aur%20ha-s180-w-e_1.jpg","wholesale_price":"8.48","unit_price_tax":13.48},"product_model":{"product_data":{"ean13":["4975769424878"],"reference":"HA-S180-W-E","name":{"1":"Auriculares JVC HAS180\/ Jack 3.5\/ Blancos","2":"","3":"","4":""},"description":{"1":"                                                <p>Auriculares cerrados y ligeros con dise\u00f1o plegable dual para mayor portabilidad, sistema Deep Bass, sonido de alta calidad y cable de 1,2 m, en color blanco<br><\/p><p><ul><li>Reproducci\u00f3n de sonido de alta calidad con excitador de neodimio de 30 mm<\/li><li>Graves potentes gracias al sistema Deep Bass<\/li><li>Dise\u00f1o plegable dual (plano & compacto) para una m\u00e1xima portabilidad<\/li><li>Dise\u00f1o ligero para disfrutar de escuchas prolongadas<\/li><li>Disponible en 4 colores<\/li><li>Cable de 1,2 m. con conector delgado ba\u00f1ado en oro compatible con iPhone<\/li><\/ul><br><\/p><ul>  <li>    <h2>Especificaciones<\/h2>  <\/li>  <li>Auriculares<\/li>  <li>Unidad de excitador: 30 mm<\/li>  <li>Tipo de im\u00e1n: Neodimio<\/li>  <li>Respuesta de frecuencia: 10-22.000 Hz<\/li>  <li>Capacidad de entrada m\u00e1xima: 500 mW (IEC)<\/li>  <li>Longitud del cable: 1.2m<\/li>  <li>Peso (sin cable): 108 g<\/li>  <li>Conector: Compatible con iPhone, ba\u00f1ado en oro<\/li><\/ul><br><p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"JVC","supplier":null,"width":null,"height":null,"depth":null,"weight":0.26,"unit_price":13.48,"unit_price_tax":13.48,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":0,"brand":"JVC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_jvc-aur%20ha-s180-w-e_1.jpg"],"wholesale_price":8.48}}},"8435430614343":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435430614343",false],"wholesale_price":[4.18,false],"price":[9.18,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:93229","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a37c9a44505a1ad46ffdacc676efa173.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Intrauditivos NGS Cross Rally\/ con Micr\u00f3fono\/ Jack 3.5\/ Grafito","category":"Auriculares","sub_category":"Auriculares","unit_price":9.18,"reference":"CROSSRALLYGRAPHITE","ean13":"8435430614343","weight":"0.05","quantity":0,"brand":"NGS","description_pt":"<ul><li>Originales auriculares met\u00e1licos intrauditivos con conexi\u00f3n jack 3.5 mm.<\/li><li>Dispone de bot\u00f3n bot\u00f3n multifunci\u00f3n y tecnolog\u00eda Voice Assistant que permite conectarse con el asistente de voz del m\u00f3vil o Tablet pulsando solo un bot\u00f3n.<\/li><li>NGS Cross Rally es compatible con tu smartphone o reproductor de audio y destaca por su gran calidad de sonido, as\u00ed como su durabilidad.<\/li><li>El micr\u00f3fono integrado en el cable te permite responder a todas tus llamadas sin necesidad de sacar el smartphone del bolsillo<\/li><li>Podr\u00e1s avanzar y retroceder la canci\u00f3n con el bot\u00f3n multifunci\u00f3n que te permite controlar la reproducci\u00f3n desde el propio auricular.<\/li><li>NGS Cross Rally est\u00e1 equipado con un cable plano de 1.20 m que evita que se produzcan enredos y con el que podr\u00e1s moverte con libertad total.<\/li><li>Este auricular de bot\u00f3n es ideal para correr o ir al gym ya que incluye almohadillas fabricadas en silicona que se ajustan perfectamente a la oreja, evitando que se caigan.<\/li><li>Equipado con 3 pares de almohadillas de 3 tama\u00f1os diferentes (S\/M\/L) para adaptarse perfectamente a tu o\u00eddo.<\/li><\/ul><meta http-equiv='content-type' content='text\/html; charset=UTF-8'><title><\/title><br><ul><li><b>Especificaciones:<\/b><\/li><li> Bot\u00f3n multifuncional<\/li><li> Depende de la marca y modelo de su dispositivo. Compatible con Siri y Asistente de Google.<\/li><li> Auricular de metal (aluminio)<\/li><li> Drivers: 9mm<\/li><li> Respuesta de frecuencia: 20Hz-20kHz<\/li><li> Impedancia: 16 Ohms<\/li><li> Sensibilidad: 95dB a 1 kHz<\/li><li> Longitud del cable: 1,2m \u00b110 %<\/li><li> Tama\u00f1o del conector: 3,5mm<\/li><li> Cable plano <\/li><\/ul>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ngs-aur%20crossrallygraphite_1.jpg","wholesale_price":"4.18","unit_price_tax":9.18},"product_model":{"product_data":{"ean13":["8435430614343"],"reference":"CROSSRALLYGRAPHITE","name":{"1":"Auriculares Intrauditivos NGS Cross Rally\/ con Micr\u00f3fono\/ Jack 3.5\/ Grafito","2":"","3":"","4":""},"description":{"1":"<ul><li>Originales auriculares met\u00e1licos intrauditivos con conexi\u00f3n jack 3.5 mm.<\/li><li>Dispone de bot\u00f3n bot\u00f3n multifunci\u00f3n y tecnolog\u00eda Voice Assistant que permite conectarse con el asistente de voz del m\u00f3vil o Tablet pulsando solo un bot\u00f3n.<\/li><li>NGS Cross Rally es compatible con tu smartphone o reproductor de audio y destaca por su gran calidad de sonido, as\u00ed como su durabilidad.<\/li><li>El micr\u00f3fono integrado en el cable te permite responder a todas tus llamadas sin necesidad de sacar el smartphone del bolsillo<\/li><li>Podr\u00e1s avanzar y retroceder la canci\u00f3n con el bot\u00f3n multifunci\u00f3n que te permite controlar la reproducci\u00f3n desde el propio auricular.<\/li><li>NGS Cross Rally est\u00e1 equipado con un cable plano de 1.20 m que evita que se produzcan enredos y con el que podr\u00e1s moverte con libertad total.<\/li><li>Este auricular de bot\u00f3n es ideal para correr o ir al gym ya que incluye almohadillas fabricadas en silicona que se ajustan perfectamente a la oreja, evitando que se caigan.<\/li><li>Equipado con 3 pares de almohadillas de 3 tama\u00f1os diferentes (S\/M\/L) para adaptarse perfectamente a tu o\u00eddo.<\/li><\/ul><meta http-equiv='content-type' content='text\/html; charset=UTF-8'><title><\/title><br><ul><li><b>Especificaciones:<\/b><\/li><li> Bot\u00f3n multifuncional<\/li><li> Depende de la marca y modelo de su dispositivo. Compatible con Siri y Asistente de Google.<\/li><li> Auricular de metal (aluminio)<\/li><li> Drivers: 9mm<\/li><li> Respuesta de frecuencia: 20Hz-20kHz<\/li><li> Impedancia: 16 Ohms<\/li><li> Sensibilidad: 95dB a 1 kHz<\/li><li> Longitud del cable: 1,2m \u00b110 %<\/li><li> Tama\u00f1o del conector: 3,5mm<\/li><li> Cable plano <\/li><\/ul>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NGS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.05,"unit_price":9.18,"unit_price_tax":9.18,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":0,"brand":"NGS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ngs-aur%20crossrallygraphite_1.jpg"],"wholesale_price":4.18}}},"8435430614800":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435430614800",false],"wholesale_price":[4.18,false],"price":[9.18,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.04",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:93235","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fa609f85664c2e0ebed1d03b