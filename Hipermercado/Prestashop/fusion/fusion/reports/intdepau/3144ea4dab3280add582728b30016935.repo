weight":["Product weight is 15",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:93514","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/542d268a790f7ddd926bd006912a5908.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Multifunci\u00f3n Canon MAXIFY MB2750 WiFi\/ Fax\/ D\u00faplex\/ Negra","category":"Multifunciones  e Impresoras","sub_category":"Multifunciones","unit_price":119.59,"reference":"0958C009AA","ean13":"4549292051094","weight":"15","quantity":2,"brand":"CANON","description_pt":"<p>Potente equipo multifunci\u00f3n para usuarios de oficina dom\u00e9stica que necesitan fiabilidad y rendimiento<br><\/p><p>Equipa tu oficina dom\u00e9stica con un equipo de inyecci\u00f3n de tinta multifunci\u00f3n en color r\u00e1pido y fiable para resultados de alta calidad. Aprovecha la comodidad y eficiencia de una impresora, esc\u00e1ner, copiadora y fax totalmente equipada dise\u00f1ada espec\u00edficamente para tu oficina dom\u00e9stica. Disfruta de una impresi\u00f3n y escaneo r\u00e1pidos y sencillos desde dispositivos m\u00f3viles y a trav\u00e9s de servicios en la nube. Saca el m\u00e1ximo partido de una capacidad de papel de 500 hojas y una velocidad de impresi\u00f3n r\u00e1pida de 24 ipm mono para maximizar la productividad.<br><\/p><p><\/p><h2>Ventajas<\/h2><ul><li>Disfruta de una impresi\u00f3n r\u00e1pida de 24 im\u00e1genes por minuto (ipm) en blanco y negro y 15,5 ipm en color<\/li><li>Produce m\u00e1s con un alimentador de 500 hojas de capacidad y un alimentador de documentos autom\u00e1tico de (ADF) de 50 hojas<\/li><li>Saca el m\u00e1ximo rendimiento de tinta de 1200 p\u00e1ginas en blanco y negro y 900 p\u00e1ginas en color<\/li><li>Impresi\u00f3n y