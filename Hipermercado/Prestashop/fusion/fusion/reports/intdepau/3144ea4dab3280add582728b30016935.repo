weight: normal;'>1.5 m<\/span><\/li><li><span style='font-weight: normal;'>DP Cable<\/span><\/li><li><span style='font-weight: normal;'>S\u00ed<\/span><\/li><li><span style='font-weight: normal;'>USB 3.0 Cable<\/span><\/li><li><span style='font-weight: normal;'>S\u00ed<\/span><\/li><\/ul><\/p><\/h2><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":956.58,"unit_price_tax":956.58,"tax_rules_group":null,"category":"Monitores","sub_category":"Monitores","quantity":0,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-m%20lc49g95tsspxen_1.jpg"],"wholesale_price":951.58}}},"8806094796568":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806094796568",false],"wholesale_price":[1031,false],"price":[1036,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Monitor de jogo curvo Samsung Odyssey Neo G7 S32BG750NP 32&#39;\/ 4K\/ 1ms\/ 165Hz\/ VA\/ Preto"],"result":false},"feed_data":{"name_pt":"Monitor Gaming Curvo Samsung Odyssey Neo G7 S32BG750NP 32'\/ 4K\/ 1ms\/ 165Hz\/ VA\/ Negro","category":"Monitores","sub_category":"Monitores","unit_price":1036,"reference":"LS32BG750NPXEN","ean13":"8806094796568","weight":"0","quantity":0,"brand":"SAMSUNG","description_pt":"<p><h2>El universo de la inmersi\u00f3n acaba de expandirse<\/h2><p><b>Quantum Matrix Technology<\/b><\/p><p>Una experiencia visual inigualable. La revolucionaria tecnolog\u00eda Quantum Matrix con mini LEDs Quantum crea un brillo controlado y un contraste perfecto para una definici\u00f3n refinada. Las zonas de atenuaci\u00f3n local se aumentaron a 1.196 y se combinaron con los m\u00e1s altos niveles de negro de 12 bits para crear una calidad de imagen inigualable.<\/p><h2>Atrapa cada detalle, y a tus enemigos<\/h2><p><b>Quantum HDR 2000<\/b><\/p><p>Ve cada detalle en todo su esplendor. Desde las sombras m\u00e1s tenebrosas hasta las escenas m\u00e1s iluminadas, el brillo m\u00e1ximo de 2.000 nits y la relaci\u00f3n de contraste de 1.000.000:1 permiten mejorar la expresi\u00f3n del color y la profundidad. Obt\u00e9n una ventaja competitiva al jugar juegos con Ray Tracing detectando a los enemigos ocultos mediante sus reflejos.<\/p><h2>Mundos hiperrealistas en tu pantalla<\/h2><p><b>Resoluci\u00f3n UHD<\/b><\/p><p>Experimenta los juegos como si fueran la realidad. Con la resoluci\u00f3n UHD, el Odyssey Neo G7 permite a los jugadores ser testigos de im\u00e1genes de alta calidad y con detalles reales. Sum\u00e9rgete en el mundo que elijas<\/p><h2>Tasa de refresco en 4K<\/h2><p><b>Velocidad de refresco de 165 Hz y 1ms<\/b><\/p><p>Conquista a todos los enemigos, incluso a velocidad extrema. La frecuencia de refresco de 165 Hz elimina el retardo para un juego estimulante con una acci\u00f3n ultrasuave. Identifica a los enemigos con una precisi\u00f3n de \u00e9lite con un tiempo de respuesta de 1 ms, movimientos precisos del rat\u00f3n y fotogramas sin desenfoque, sin efecto fantasma.<\/p><h2>Conc\u00e9ntrate sin interrumpir el flujo<\/h2><p><b>AMD FreeSync Premium Pro<\/b><\/p><p>Gameplays fluidos y sin esfuerzo. AMD FreeSync Premium Pro cuenta con una tecnolog\u00eda de sincronizaci\u00f3n adaptativa que reduce el desgarro de la pantalla, el tartamudeo y la latencia de entrada. La compensaci\u00f3n de la baja frecuencia de imagen garantiza que todas las escenas fluyan sin problemas.<\/p><h2>Sorprende a tus sentidos<\/h2><p><b>Curvatura 1000R<\/b><\/p><p>Las escenas v\u00edvidas te envuelven a\u00fan m\u00e1s. Experimente el siguiente nivel gaming de infarto, superior a todo lo que has visto antes. La pantalla 1000R de 32 pulgadas s\u00faper ultra-ancha llena tu visi\u00f3n perif\u00e9rica y te mete en la piel del personaje.<\/p><h2>Dise\u00f1ado para iluminar tu mundo<\/h2><p><b>Core Lighting dise\u00f1ado con CoreSync<\/b><\/p><p>Rod\u00e9ate de cada escena. Con Core Lighting a\u00f1ades personalidad a tu configuraci\u00f3n con m\u00faltiples modos de color que escapan de la pantalla a tu realidad. Tu experiencia de juego se escapar\u00e1 m\u00e1s all\u00e1 de la pantalla con la tecnolog\u00eda CoreSync, que hace coincidir los colores del juego en pantalla para lograr una inmersi\u00f3n en el mundo.<\/p><h2>Revela lo invisible<\/h2><p><b>Juega con una visi\u00f3n ultra-ancha<\/b><\/p><p>Encuentra m\u00e1s con la vista ampliada. Descubre los tesoros ocultos o flanquea a los enemigos con total sigilo gracias a la relaci\u00f3n de aspecto ultra-ancha de 21:9. Llega m\u00e1s r\u00e1pido al top de la tabla de clasificaci\u00f3n con ayuda de m\u00e1s contexto visual.<\/p><h2>Con\u00e9ctate autom\u00e1ticamente, en un instante<\/h2><p><b>Auto Source Switch+<\/b><\/p><p>Encendido para una reproducci\u00f3n instant\u00e1nea. Con Auto Source Switch+, el monitor detecta cuando se encienden los dispositivos conectados y cambia al instante a la nueva se\u00f1al de origen. Esto te ayuda a llegar m\u00e1s r\u00e1pido a la acci\u00f3n del juego sin tener que pasar por varias fuentes de entrada.<\/p><h2>Comodidad para ganar<\/h2><p><b>Soporte ergon\u00f3mico<\/b><\/p><p>Encuentre tu posici\u00f3n ganadora. Gira, inclina y ajusta la altura hasta que est\u00e9 lista para la victoria. Totalmente compatible con los brazos de un monitor est\u00e1ndar VESA, la pantalla se puede mover sin esfuerzo a tu posici\u00f3n ideal. Los m\u00faltiples puertos son de f\u00e1cil acceso, y se conectan a tus dispositivos favoritos sin ning\u00fan problema.<\/p><br><\/p><p><h2>Especificaciones<\/h2><p><ul><li><b>Curvatura de Pantalla<\/b><\/li><li>1000R<\/li><li><b>Relaci\u00f3n de aspecto<\/b><\/li><li>16:9<\/li><li><b>Brillo (Normal)<\/b><\/li><li>350 cd\/&#13217;<\/li><li><b>Relaci\u00f3n de contraste est\u00e1tico<\/b><\/li><li>1,000,000:1<\/li><li><b>Resoluci\u00f3n<\/b><\/li><li>3,840 x 2,160<\/li><li><b>Tiempo de Respuesta<\/b><\/li><li>1ms(GTG)<\/li><li><b>Detalle de especificaciones<\/b><\/li><li>Pantalla<\/li><li>Clase de pantalla<\/li><li>32<\/li><li><b>Plana\/Curva<\/b><\/li><li>Curva<\/li><li>Active Display Size (HxV) (mm)<\/li><li>697.306 (H) x 392.234 (V) mm<\/li><li>Curvatura de Pantalla<\/li><li>1000R<\/li><li>Relaci\u00f3n de aspecto<\/li><li>16:9<\/li><li><b>Panel<\/b><\/li><li>VA<\/li><li>Brillo (Normal)<\/li><li>350 cd\/&#13217;<\/li><li>Brillo (Min)<\/li><li>300 cd\/&#13217;<\/li><li>Relaci\u00f3n de contraste est\u00e1tico<\/li><li>1,000,000:1<\/li><li>Contrast Ratio (Dynamic)<\/li><li>Mega DCR<\/li><li>HDR(High Dynamic Range)<\/li><li>Quantum HDR 2000<\/li><li>Mini LED Local Dimming<\/li><li>S\u00ed (1,196 zones)<\/li><li><b>Resoluci\u00f3n<\/b><\/li><li>3,840 x 2,160<\/li><li>Tiempo de Respuesta<\/li><li>1ms(GTG)<\/li><li>\u00c1ngulo de Visi\u00f3n (H\/V)<\/li><li>178\u00b0(H)\/178\u00b0(V)<\/li><li>Color<\/li><li>Max 1B<\/li><li>Color Gamut (DCI Coverage)<\/li><li>95% (Typ)<\/li><li><b>Refresco<\/b><\/li><li>Max 165Hz<\/li><li><b>Caracter\u00edsticas generales<\/b><\/li><li>Eco Light Sensor<\/li><li>S\u00ed<\/li><li>Modo Eye Saver<\/li><li>S\u00ed<\/li><li>Flicker Free<\/li><li>S\u00ed<\/li><li>PIP<\/li><li>S\u00ed<\/li><li>Quantum Dot Color<\/li><li>S\u00ed<\/li><li><b>Certificado Windows<\/b><\/li><li>Windows 10<\/li><li><b>FreeSync<\/b><\/li><li>FreeSync Premium Pro<\/li><li>Off Timer Plus<\/li><li>S\u00ed<\/li><li>Black Equalizer<\/li><li>S\u00ed<\/li><li>Low Input Lag Mode<\/li><li>S\u00ed<\/li><li>Virtual AIM Point<\/li><li>S\u00ed<\/li><li>Core Sync<\/li><li>S\u00ed<\/li><li>Refresh Rate Optimizor<\/li><li>S\u00ed<\/li><li>Super Arena Gaming UX<\/li><li>S\u00ed<\/li><li>Auto Source Switch+<\/li><li>S\u00ed<\/li><li>Adaptive Picture<\/li><li>S\u00ed<\/li><li>Ultrawide Game View<\/li><li>S\u00ed<\/li><li><b>Interfaz<\/b><\/li><li>Display Port<\/li><li>1 EA<\/li><li>Display Port Version<\/li><li>1.4<\/li><li>HDMI<\/li><li>2 EA<\/li><li>HDMI Version<\/li><li>2.1<\/li><li>HDCP Version (HDMI)<\/li><li>2.2<\/li><li><b>Auriculares<\/b><\/li><li>S\u00ed<\/li><li>USB Hub<\/li><li>2<\/li><li>USB Hub Version<\/li><li>3<\/li><li><b>Operaci\u00f3n<\/b><\/li><li>Temperatura<\/li><li>10~40 &#8451;<\/li><li>Humedad<\/li><li>10~80,non-condensing<\/li><li>Calibration<\/li><li>Factory Tunning<\/li><li>S\u00ed<\/li><li><b>Color Mode<\/b><\/li><li>Custom\/FPS\/RTS\/RPG\/Sports\/sRGB\/Cinema\/Dynamic Contrast<\/li><li><b>Dise\u00f1o<\/b><\/li><li>Color Frontal<\/li><li>NEGRO<\/li><li>Rear Color<\/li><li>NEGRO<\/li><li>Stand Color<\/li><li>NEGRO<\/li><li>Tipo de peana<\/li><li>HAS PIVOT<\/li><li>Peana Ajustable en Altura<\/li><li>120.0 \u00b15.0<\/li><li><b>Inclinaci\u00f3n<\/b><\/li><li>-9.0\u00ba(\u00b1 2\u00b0) ~ 13.0\u00ba(\u00b1 2\u00b0)<\/li><li><b>Giro<\/b><\/li><li>-15.0\u00ba ~ 15.0\u00ba<\/li><li><b>Pivotaje<\/b><\/li><li>-92.0\u00ba(\u00b1 2\u00b0) ~ 92.0\u00ba(\u00b1 2\u00b0)<\/li><li><b>Montaje Pared<\/b><\/li><li>100 x 100<\/li><li><b>Funciones ECO<\/b><\/li><li>Clase de Eficiencia Energ\u00e9tica<\/li><li>G<\/li><li><b>Intensidad M\u00e1xima<\/b><\/li><li>Fuente de Alimentaci\u00f3n<\/li><li>AC 100~240V<\/li><li>Consumo t\u00edpico<\/li><li>33.2 W<\/li><li>Consumo (DPMS)<\/li><li>0.50 W<\/li><li>Consumo (Apagado)<\/li><li>0.30 W<\/li><li>Consumo anual<\/li><li>48 kWh\/year<\/li><li><b>Tipo<\/b><\/li><li>Adaptador externo<\/li><li><b>Dimensiones<\/b><\/li><li>Dimensiones Netas con Peana (AnxAltxProf)<\/li><li>713.0 x 606.2 x 311.1 mm<\/li><li>Dimensiones Netas sin Peana (AnxAltxProf)<\/li><li>713.0 x 440.3 x 185.0 mm<\/li><li>Dimensiones embalado (AnxAltxProf)<\/li><li>827.0 x 231.0 x 499.0 mm<\/li><li><b>Peso<\/b><\/li><li>Peso con Peana (kg)<\/li><li>8.6 kg<\/li><li>Peso sin Peana (kg)<\/li><li>6.7 kg<\/li><li>Peso con Caja (kg)<\/li><li>12.0 kg<\/li><li><b>Accesorios<\/b><\/li><li>Longitud del Cable de Alimentaci\u00f3n<\/li><li>1.5 m<\/li><li>DP Cable<\/li><li>S\u00ed<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-m%20s32bg750np_1.jpg","wholesale_price":"1031.00","unit_price_tax":1036},"product_model":{"product_data":{"ean13":["8806094796568"],"reference":"LS32BG750NPXEN","name":{"1":"Monitor Gaming Curvo Samsung Odyssey Neo G7 S32BG750NP 32'\/ 4K\/ 1ms\/ 165Hz\/ VA\/ Negro","2":"","3":"","4":""},"description":{"1":"<p><h2>El universo de la inmersi\u00f3n acaba de expandirse<\/h2><p><b>Quantum Matrix Technology<\/b><\/p><p>Una experiencia visual inigualable. La revolucionaria tecnolog\u00eda Quantum Matrix con mini LEDs Quantum crea un brillo controlado y un contraste perfecto para una definici\u00f3n refinada. Las zonas de atenuaci\u00f3n local se aumentaron a 1.196 y se combinaron con los m\u00e1s altos niveles de negro de 12 bits para crear una calidad de imagen inigualable.<\/p><h2>Atrapa cada detalle, y a tus enemigos<\/h2><p><b>Quantum HDR 2000<\/b><\/p><p>Ve cada detalle en todo su esplendor. Desde las sombras m\u00e1s tenebrosas hasta las escenas m\u00e1s iluminadas, el brillo m\u00e1ximo de 2.000 nits y la relaci\u00f3n de contraste de 1.000.000:1 permiten mejorar la expresi\u00f3n del color y la profundidad. Obt\u00e9n una ventaja competitiva al jugar juegos con Ray Tracing detectando a los enemigos ocultos mediante sus reflejos.<\/p><h2>Mundos hiperrealistas en tu pantalla<\/h2><p><b>Resoluci\u00f3n UHD<\/b><\/p><p>Experimenta los juegos como si fueran la realidad. Con la resoluci\u00f3n UHD, el Odyssey Neo G7 permite a los jugadores ser testigos de im\u00e1genes de alta calidad y con detalles reales. Sum\u00e9rgete en el mundo que elijas<\/p><h2>Tasa de refresco en 4K<\/h2><p><b>Velocidad de refresco de 165 Hz y 1ms<\/b><\/p><p>Conquista a todos los enemigos, incluso a velocidad extrema. La frecuencia de refresco de 165 Hz elimina el retardo para un juego estimulante con una acci\u00f3n ultrasuave. Identifica a los enemigos con una precisi\u00f3n de \u00e9lite con un tiempo de respuesta de 1 ms, movimientos precisos del rat\u00f3n y fotogramas sin desenfoque, sin efecto fantasma.<\/p><h2>Conc\u00e9ntrate sin interrumpir el flujo<\/h2><p><b>AMD FreeSync Premium Pro<\/b><\/p><p>Gameplays fluidos y sin esfuerzo. AMD FreeSync Premium Pro cuenta con una tecnolog\u00eda de sincronizaci\u00f3n adaptativa que reduce el desgarro de la pantalla, el tartamudeo y la latencia de entrada. La compensaci\u00f3n de la baja frecuencia de imagen garantiza que todas las escenas fluyan sin problemas.<\/p><h2>Sorprende a tus sentidos<\/h2><p><b>Curvatura 1000R<\/b><\/p><p>Las escenas v\u00edvidas te envuelven a\u00fan m\u00e1s. Experimente el siguiente nivel gaming de infarto, superior a todo lo que has visto antes. La pantalla 1000R de 32 pulgadas s\u00faper ultra-ancha llena tu visi\u00f3n perif\u00e9rica y te mete en la piel del personaje.<\/p><h2>Dise\u00f1ado para iluminar tu mundo<\/h2><p><b>Core Lighting dise\u00f1ado con CoreSync<\/b><\/p><p>Rod\u00e9ate de cada escena. Con Core Lighting a\u00f1ades personalidad a tu configuraci\u00f3n con m\u00faltiples modos de color que escapan de la pantalla a tu realidad. Tu experiencia de juego se escapar\u00e1 m\u00e1s all\u00e1 de la pantalla con la tecnolog\u00eda CoreSync, que hace coincidir los colores del juego en pantalla para lograr una inmersi\u00f3n en el mundo.<\/p><h2>Revela lo invisible<\/h2><p><b>Juega con una visi\u00f3n ultra-ancha<\/b><\/p><p>Encuentra m\u00e1s con la vista ampliada. Descubre los tesoros ocultos o flanquea a los enemigos con total sigilo gracias a la relaci\u00f3n de aspecto ultra-ancha de 21:9. Llega m\u00e1s r\u00e1pido al top de la tabla de clasificaci\u00f3n con ayuda de m\u00e1s contexto visual.<\/p><h2>Con\u00e9ctate autom\u00e1ticamente, en un instante<\/h2><p><b>Auto Source Switch+<\/b><\/p><p>Encendido para una reproducci\u00f3n instant\u00e1nea. Con Auto Source Switch+, el monitor detecta cuando se encienden los dispositivos conectados y cambia al instante a la nueva se\u00f1al de origen. Esto te ayuda a llegar m\u00e1s r\u00e1pido a la acci\u00f3n del juego sin tener que pasar por varias fuentes de entrada.<\/p><h2>Comodidad para ganar<\/h2><p><b>Soporte ergon\u00f3mico<\/b><\/p><p>Encuentre tu posici\u00f3n ganadora. Gira, inclina y ajusta la altura hasta que est\u00e9 lista para la victoria. Totalmente compatible con los brazos de un monitor est\u00e1ndar VESA, la pantalla se puede mover sin esfuerzo a tu posici\u00f3n ideal. Los m\u00faltiples puertos son de f\u00e1cil acceso, y se conectan a tus dispositivos favoritos sin ning\u00fan problema.<\/p><br><\/p><p><h2>Especificaciones<\/h2><p><ul><li><b>Curvatura de Pantalla<\/b><\/li><li>1000R<\/li><li><b>Relaci\u00f3n de aspecto<\/b><\/li><li>16:9<\/li><li><b>Brillo (Normal)<\/b><\/li><li>350 cd\/&#13217;<\/li><li><b>Relaci\u00f3n de contraste est\u00e1tico<\/b><\/li><li>1,000,000:1<\/li><li><b>Resoluci\u00f3n<\/b><\/li><li>3,840 x 2,160<\/li><li><b>Tiempo de Respuesta<\/b><\/li><li>1ms(GTG)<\/li><li><b>Detalle de especificaciones<\/b><\/li><li>Pantalla<\/li><li>Clase de pantalla<\/li><li>32<\/li><li><b>Plana\/Curva<\/b><\/li><li>Curva<\/li><li>Active Display Size (HxV) (mm)<\/li><li>697.306 (H) x 392.234 (V) mm<\/li><li>Curvatura de Pantalla<\/li><li>1000R<\/li><li>Relaci\u00f3n de aspecto<\/li><li>16:9<\/li><li><b>Panel<\/b><\/li><li>VA<\/li><li>Brillo (Normal)<\/li><li>350 cd\/&#13217;<\/li><li>Brillo (Min)<\/li><li>300 cd\/&#13217;<\/li><li>Relaci\u00f3n de contraste est\u00e1tico<\/li><li>1,000,000:1<\/li><li>Contrast Ratio (Dynamic)<\/li><li>Mega DCR<\/li><li>HDR(High Dynamic Range)<\/li><li>Quantum HDR 2000<\/li><li>Mini LED Local Dimming<\/li><li>S\u0