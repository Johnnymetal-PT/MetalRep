\/800\/fixed\/art_kar-cl-561xxl_1.jpg"],"wholesale_price":18.84}}},"4977766839174":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4977766839174",false],"wholesale_price":[15.4,false],"price":[22.4,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:286110","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/bff68e00ba54584ab18b8a654dc81bcb.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cartucho de Tinta Original Brother LC521BK\/ Negro","category":"Consumibles Originales","sub_category":"Consumibles Brother","unit_price":22.4,"reference":"LC521BK","ean13":"4977766839174","weight":"0.05","quantity":2,"brand":"BROTHER","description_pt":"<p><p><h2>Cartucho de tinta negra original y de alta calidad Brother LC521BK<\/h2><p><ul><li>Cartucho de tinta negro Duraci\u00f3n estimada: hasta 500 p\u00e1ginas (seg\u00fan ISO\/IEC 24711)<\/li><li>LC521BK Imprime 500 p\u00e1ginas de acuerdo con ISO\/IEC 24711<\/li><li>Los cartuchos de tinta originales de Brother se prueban rigurosamente para imprimir a la perfecci\u00f3n en todo momento y para que puedas ahorrar tiempo y dinero<\/li><li>El uso del cartucho de tinta original Brother LC521BK protege la garant\u00eda de tu impresora<\/li><li>La gama de cartuchos de tinta LC521 est\u00e1 disponible en un pack m\u00e1s econ\u00f3mico que reduce el coste por p\u00e1gina - LC521VAL<\/li><\/ul><\/p><\/p><h2>LC521BK<\/h2><p>El cartucho de tinta cian Brother LC521BK ofrece una excepcional resistencia a la decoloraci\u00f3n, lo que garantiza impresiones uniformes y de alta calidad de principio a fin. Con nuestras tintas formuladas con precisi\u00f3n, tu impresora rendir\u00e1 al m\u00e1ximo durante toda su vida \u00fatil.<\/p><p>Brother tiene en cuenta el medio ambiente durante todo el ciclo de vida del cartucho de tinta, ayudando a reducir los residuos en los vertederos. Nuestro hardware y cartuchos de tinta est\u00e1n dise\u00f1ados pensando en la sostenibilidad, minimizando su huella medioambiental.<\/p><p><b>Cartucho de tinta original Brother LC521BK: siempre merece la pena<\/b><\/p><h2>Especificaciones<\/h2><\/p><p><ul><li><b>Compatibilidad:<\/b> DCP-J1260W,&nbsp;DCP-J1360DW,&nbsp;DCP-J1310DW<\/li><li><b>Color:<\/b> Negro<\/li><li><b>Capacidad:<\/b> 500 P\u00e1ginas<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bro-c%20lc521bk_1.jpg","wholesale_price":"15.40","unit_price_tax":22.4},"product_model":{"product_data":{"ean13":["4977766839174"],"reference":"LC521BK","name":{"1":"Cartucho de Tinta Original Brother LC521BK\/ Negro","2":"","3":"","4":""},"description":{"1":"<p><p><h2>Cartucho de tinta negra original y de alta calidad Brother LC521BK<\/h2><p><ul><li>Cartucho de tinta negro Duraci\u00f3n estimada: hasta 500 p\u00e1ginas (seg\u00fan ISO\/IEC 24711)<\/li><li>LC521BK Imprime 500 p\u00e1ginas de acuerdo con ISO\/IEC 24711<\/li><li>Los cartuchos de tinta originales de Brother se prueban rigurosamente para imprimir a la perfecci\u00f3n en todo momento y para que puedas ahorrar tiempo y dinero<\/li><li>El uso del cartucho de tinta original Brother LC521BK protege la garant\u00eda de tu impresora<\/li><li>La gama de cartuchos de tinta LC521 est\u00e1 disponible en un pack m\u00e1s econ\u00f3mico que reduce el coste por p\u00e1gina - LC521VAL<\/li><\/ul><\/p><\/p><h2>LC521BK<\/h2><p>El cartucho de tinta cian Brother LC521BK ofrece una excepcional resistencia a la decoloraci\u00f3n, lo que garantiza impresiones uniformes y de alta calidad de principio a fin. Con nuestras tintas formuladas con precisi\u00f3n, tu impresora rendir\u00e1 al m\u00e1ximo durante toda su vida \u00fatil.<\/p><p>Brother tiene en cuenta el medio ambiente durante todo el ciclo de vida del cartucho de tinta, ayudando a reducir los residuos en los vertederos. Nuestro hardware y cartuchos de tinta est\u00e1n dise\u00f1ados pensando en la sostenibilidad, minimizando su huella medioambiental.<\/p><p><b>Cartucho de tinta original Brother LC521BK: siempre merece la pena<\/b><\/p><h2>Especificaciones<\/h2><\/p><p><ul><li><b>Compatibilidad:<\/b> DCP-J1260W,&nbsp;DCP-J1360DW,&nbsp;DCP-J1310DW<\/li><li><b>Color:<\/b> Negro<\/li><li><b>Capacidad:<\/b> 500 P\u00e1ginas<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BROTHER","supplier":null,"width":null,"height":null,"depth":null,"weight":0.05,"unit_price":22.4,"unit_price_tax":22.4,"tax_rules_group":null,"category":"Consumibles Originales","sub_category":"Consumibles Brother","quantity":2,"brand":"BROTHER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bro-c%20lc521bk_1.jpg"],"wholesale_price":15.4}}},"3121040083901":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3121040083901",false],"wholesale_price":[90.59,false],"price":[97.59,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.95",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:286111","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/115b03efc4331ece2f1c9c5ab40b2a21.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Plancha para el Pelo Rowenta SF8230F0 Inimitable Ultimate Experience\/ Negra","category":"Cuidado Personal","sub_category":"Planchas de pelo","unit_price":97.59,"reference":"SF8230F0","ean13":"3121040083901","weight":"0.95","quantity":2,"brand":"ROWENTA","description_pt":"<h2>Inimitable Ultimate Experience, Plancha de pelo, Peine integrado, Deslizamiento excepcional, Alisa y moldea<\/h2><p><\/p><p><\/p><ul><li>Plancha de pelo premium con un exclusivo cabezal que incorpora un peine para reproducir el movimiento que hacen los peluqueros profesionales y conseguir sus mismos resultados de alisado<\/li><li>Revestimiento de piedra mineral para garantizar un deslizamiento excepcional y un alisado perfecto, sin tirones ni enredos<\/li><li>Consta de placas flotantes 3D que ofrecen un alto nivel de precisi\u00f3n y control en funci\u00f3n del grosor de los mechones<\/li><li>Tecnolog\u00eda Thermo Control que permite controlar con gran precisi\u00f3n la temperatura y ofrecer la m\u00e1xima difusi\u00f3n del calor, para unos resultados excepcionales de la ra\u00edz a las puntas<\/li><li>Probado cl\u00ednicamente: conserva el 100 % de la queratina, gracias a sus extraordinarias placas que evitan los tirones y la rotura del cabello, adem\u00e1s de proporcionar brillo al cabello<\/li><li>Herramienta vers\u00e1til para moldear, rizar y ondular el cabello como un profesional<\/li><li>Cable extralargo que gira 360 grados para que puedas moverte con total libertad<\/li><li>Tiempo de calentamiento de 25 segundos, ideal para retoques de \u00faltima hora<\/li><li>Pr\u00e1ctico dise\u00f1o ligero y compacto para conseguir unos resultados de calidad de peluquer\u00eda en cualquier momento y lugar<\/li><\/ul><p><\/p><h2>Plancha de pelo Ultimate Experience Inimitable de Rowenta<\/h2><p>Para peinarnos como profesionales, necesitamos contar con la t\u00e9cnica adecuada, por ello, Rowenta ha combinado las prestaciones t\u00e9cnicas de una plancha de pelo de gama alta que incorpora un cabezal exclusivo con un peine integrado para conseguir el alisado perfecto, con un dise\u00f1o elegante y compacto. Inimitable de Ultimate Experience ha transformado esta ecuaci\u00f3n imposible en una experiencia de moldeado profesional para que puedas disfrutar de unos resultados de peluquer\u00eda desde la comodidad de tu casa.&nbsp;<\/p><h2>ALISADO PERFECTO<\/h2><p>Combinando el rendimiento de una plancha de pelo de alta gama con un cabezal exclusivo, Rowenta ha conseguido reproducir el movimiento de los peluqueros profesionales para garantizar la m\u00e1xima eficiencia y los mejores resultados.&nbsp;<\/p><h2>RESULTADOS PROFESIONALES<\/h2><p>El exclusivo cabezal gu\u00eda el mech\u00f3n de pelo, de la ra\u00edz a las puntas, a trav\u00e9s de las placas flotantes 3D, que mantienen un contacto uniforme y una temperatura controlada y homog\u00e9nea. Adem\u00e1s, su tecnolog\u00eda Thermo Control permite controlar la temperatura de forma precisa y ofrecer la m\u00e1xima difusi\u00f3n del calor para conseguir unos resultados uniformes. Disfruta en casa de un alisado de calidad profesional.<\/p><h2>CUIDA Y APORTA BRILLO<\/h2><p>Gracias al perfecto deslizamiento de esta plancha de pelo y de su cabezal, disfrutar\u00e1s de una experiencia excepcional: realza la belleza natural del cabello, evita los tirones y la rotura del pelo y proporciona brillo a la vez que conserva el 100 % de la queratina. Su impecable superficie no se sobrecalienta y proporciona un brillo radiante, para unos resultados de calidad de peluquer\u00eda y completamente seguros.<\/p><h2>DESLIZAMIENTO PERFECTO<\/h2><p>Disfruta de un deslizamiento perfecto gracias a su combinaci\u00f3n de contornos redondeados, superficies completamente lisas y su exclusivo revestimiento de piedra mineral, producto de un tratamiento t\u00e9rmico a alta temperatura.<\/p><h2>AGARRE PROFESIONAL<\/h2><p>Ultimate Experience est\u00e1 dise\u00f1ado para ofrecer un control absoluto de tu peinado, as\u00ed como un alt\u00edsimo nivel de precisi\u00f3n sin necesidad de realizar mucha presi\u00f3n gracias a su s\u00f3lida estructura reforzada. Las dos placas flotantes 3D garantizan un contacto \u00f3ptimo y constante entre las placas y el mech\u00f3n de pelo, sea cual sea su grosor.&nbsp;<\/p><h2>M\u00daLTIPLES ESTILOS<\/h2><p>Gracias a su cabezal extra\u00edble, podr\u00e1s moldear tu pelo con una infinidad de estilos. La versatilidad de esta nueva herramienta de Rowenta te permite convertir r\u00e1pidamente tu plancha de pelo en un rizador. Desde un alisado impecable a unas ondas naturales o unos rizos voluminosos, su dise\u00f1o de contornos redondeados est\u00e1 pensado para moldear y embellecer tu pelo. Sus placas 3D extraplanas y su exclusivo revestimiento de piedra mineral garantizan un deslizamiento suave y unos resultados asombrosos.<\/p><h2>D\u00d3NDE Y CU\u00c1NDO QUIERAS<\/h2><p>Su tiempo de calentamiento de tan solo 25 segundos logra que est\u00e9s lista y radiante en un abrir y cerrar de ojos, y su formato ultracompacto con un cable extralargo es perfecto para los viajes y poder peinarte d\u00f3nde y cu\u00e1ndo quieras.<\/p><h2>CINCO TEMPERATURAS<\/h2><p>Disfruta de una versatilidad y una precisi\u00f3n excepcionales con sus cinco ajustes de temperatura (120, 140, 160, 180 y 200 \u00b0). Los ajustes de menor temperatura, 120 \u00b0 y 140 \u00b0, limitan el calor para que puedas retocarte entre sesi\u00f3n y sesi\u00f3n de peinado. Resultados perfectos en cualquier tipo de cabello sin exceder en ning\u00fan caso los 200 \u00b0, pero ofreciendo el mismo rendimiento que una plancha de pelo a 230 \u00b0C*. Combina la m\u00e1xima eficiencia con una protecci\u00f3n total.<\/p><h2>GARANT\u00cdA DE CALIDAD ROWENTA<\/h2><p>Rowenta pone al alcance de tu mano dispositivos de alta gama haciendo uso de toda su experiencia profesional, con 90 a\u00f1os al frente del mercado de los productos de belleza y estilismo y estrechas colaboraciones con marcas internacionales de referencia en cosm\u00e9tica capilar profesional.<\/p><h2>MOLDEADO SEGURO<\/h2><p>Disfruta de sus prestaciones de seguridad, como un tono de alerta de encendido y apagado, una funci\u00f3n de apagado autom\u00e1tico tras 45 minutos de inactividad o un capuch\u00f3n t\u00e9rmico para guardarla de forma f\u00e1cil y segura.<\/p><h2>Especificaciones<\/h2><p><\/p><ul><li><b>RESULTADO\/USO<\/b><\/li><li>Recubrimiento de placas:&nbsp;<span style='background-color: initial;'>Cer\u00e1mico<\/span><\/li><li>Funciones:&nbsp;<span style='background-color: initial;'>Totalmente liso, rizos y ondas<\/span><\/li><li>Placas flotantes:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Placas flotantes 3D:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Estado del pelo:&nbsp;<span style='background-color: initial;'>Seco<\/span><\/li><li>Dimensi\u00f3n de las placas:&nbsp;<span style='background-color: initial;'>25 x 90 mm<\/span><\/li><li>Temperatura ajustable:&nbsp;<span style='background-color: initial;'>120 \u00b0C a 200 \u00b0C<\/span><\/li><li><b>RESPETO DEL CABELLO Y ERGONOM\u00cdA<\/b><\/li><li>Punta fr\u00eda:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>ERGONOM\u00cdA\/COMODIDAD DE USO<\/b><\/li><li>Pantalla:&nbsp;<span style='background-color: initial;'>LED<\/span><\/li><li>Indicador de calentamiento:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Seguridad:&nbsp;<span style='background-color: initial;'>Capuch\u00f3n termo-resistente<\/span><\/li><li><b>ESPECIFICACIONES T\u00c9CNICAS<\/b><\/li><li>Voltaje:&nbsp;<span style='background-color: initial;'>220-240 V<\/span><\/li><li>Cable giratorio de 360\u00b0:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>TIPO DE PEINADO<\/b><\/li><li>Alisado:&nbsp;<span style='background-color: initial;'>No<\/span><\/li><li>Rizado:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>RESULTADOS DE PEINADOS<\/b><\/li><li>Alisado:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Rizos y ondas:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><\/ul><p><\/p><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_row-pae-plp%20sf8230f0_1.jpg","wholesale_price":"90.59","unit_price_tax":97.59},"product_model":{"product_data":{"ean13":["3121040083901"],"reference":"SF8230F0","name":{"1":"Plancha para el Pelo Rowenta SF8230F0 Inimitable Ultimate Experience\/ Negra","2":"","3":"","4":""},"description":{"1":"<h2>Inimitable Ultimate Experience, Plancha de pelo, Peine integrado, Deslizamiento excepcional, Alisa y moldea<\/h2><p><\/p><p><\/p><ul><li>Plancha de pelo premium con un exclusivo cabezal que incorpora un peine para reproducir el movimiento que hacen los peluqueros profesionales y conseguir sus mismos resultados de alisado<\/li><li>Revestimiento de piedra mineral para garantizar un deslizamiento excepcional y un alisado perfecto, sin tirones ni enredos<\/li><li>Consta de placas flotantes 3D que ofrecen un alto nivel de precisi\u00f3n y control en funci\u00f3n del grosor de los mechones<\/li><li>Tecnolog\u00eda Thermo Control que permite controlar con gran precisi\u00f3n la temperatura y ofrecer la m\u00e1xima difusi\u00f3n del calor, para unos resultados excepcionales de la ra\u00edz a las puntas<\/li><li>Probado cl\u00ednicamente: conserva el 100 % de la queratina, gracias a sus extraordinarias placas que evitan los tirones y la rotura del cabello, adem\u00e1s de proporcionar brillo al cabello<\/li><li>Herramienta vers\u00e1til para moldear, rizar y ondular el cabello como un profesional<\/li><li>Cable extralargo que gira 360 grados para que puedas moverte con total libertad<\/li><li>Tiempo de calentamiento de 25 segundos, ideal para retoques de \u00faltima hora<\/li><li>Pr\u00e1ctico dise\u00f1o ligero y compacto para conseguir unos resultados de calidad de peluquer\u00eda en cualquier momento y lugar<\/li><\/ul><p><\/p><h2>Plancha de pelo Ultimate Experience Inimitable de Rowenta<\/h2><p>Para peinarnos como profesionales, necesitamos contar con la t\u00e9cnica adecuada, por ello, Rowenta ha combinado las prestaciones t\u00e9cnicas de una plancha de pelo de gama alta que incorpora un cabezal exclusivo con un peine integrado para conseguir el alisado perfecto, con un dise\u00f1o elegante y compacto. Inimitable de Ultimate Experience ha transformado esta ecuaci\u00f3n imposible en una experiencia de moldeado profesional para que puedas disfrutar de unos resultados de peluquer\u00eda desde la comodidad de tu casa.&nbsp;<\/p><h2>ALISADO PERFECTO<\/h2><p>Combinando el rendimiento de una plancha de pelo de alta gama con un cabezal exclusivo, Rowenta ha conseguido reproducir el movimiento de los peluqueros profesionales para garantizar la m\u00e1xima eficiencia y los mejores resultados.&nbsp;<\/p><h2>RESULTADOS PROFESIONALES<\/h2><p>El exclusivo cabezal gu\u00eda el mech\u00f3n de pelo, de la ra\u00edz a las puntas, a trav\u00e9s de las placas flotantes 3D, que mantienen un contacto uniforme y una temperatura controlada y homog\u00e9nea. Adem\u00e1s, su tecnolog\u00eda Thermo Control permite controlar la temperatura de forma precisa y ofrecer la m\u00e1xima difusi\u00f3n del calor para conseguir unos resultados uniformes. Disfruta en casa de un alisado de calidad profesional.<\/p><h2>CUIDA Y APORTA BRILLO<\/h2><p>Gracias al perfecto deslizamiento de esta plancha de pelo y de su cabezal, disfrutar\u00e1s de una experiencia excepcional: realza la belleza natural del cabello, evita los tirones y la rotura del pelo y proporciona brillo a la vez que conserva el 100 % de la queratina. Su impecable superficie no se sobrecalienta y proporciona un brillo radiante, para unos resultados de calidad de peluquer\u00eda y completamente seguros.<\/p><h2>DESLIZAMIENTO PERFECTO<\/h2><p>Disfruta de un deslizamiento perfecto gracias a su combinaci\u00f3n de contornos redondeados, superficies completamente lisas y su exclusivo revestimiento de piedra mineral, producto de un tratamiento t\u00e9rmico a alta temperatura.<\/p><h2>AGARRE PROFESIONAL<\/h2><p>Ultimate Experience est\u00e1 dise\u00f1ado para ofrecer un control absoluto de tu peinado, as\u00ed como un alt\u00edsimo nivel de precisi\u00f3n sin necesidad de realizar mucha presi\u00f3n gracias a su s\u00f3lida estructura reforzada. Las dos placas flotantes 3D garantizan un contacto \u00f3ptimo y constante entre las placas y el mech\u00f3n de pelo, sea cual sea su grosor.&nbsp;<\/p><h2>M\u00daLTIPLES ESTILOS<\/h2><p>Gracias a su cabezal extra\u00edble, podr\u00e1s moldear tu pelo con una infinidad de estilos. La versatilidad de esta nueva herramienta de Rowenta te permite convertir r\u00e1pidamente tu plancha de pelo en un rizador. Desde un alisado impecable a unas ondas naturales o unos rizos voluminosos, su dise\u00f1o de contornos redondeados est\u00e1 pensado para moldear y embellecer tu pelo. Sus placas 3D extraplanas y su exclusivo revestimiento de piedra mineral garantizan un deslizamiento suave y unos resultados asombrosos.<\/p><h2>D\u00d3NDE Y CU\u00c1NDO QUIERAS<\/h2><p>Su tiempo de calentamiento de tan solo 25 segundos logra que est\u00e9s lista y radiante en un abrir y cerrar de ojos, y su formato ultracompacto con un cable extralargo es perfecto para los viajes y poder peinarte d\u00f3nde y cu\u00e1ndo quieras.<\/p><h2>CINCO TEMPERATURAS<\/h2><p>Disfruta de una versatilidad y una precisi\u00f3n excepcionales con sus cinco ajustes de temperatura (120, 140, 160, 180 y 200 \u00b0). Los ajustes de menor temperatura, 120 \u00b0 y 140 \u00b0, limitan el calor para que puedas retocarte entre sesi\u00f3n y sesi\u00f3n de peinado. Resultados perfectos en cualquier tipo de cabello sin exceder en ning\u00fan caso los 200 \u00b0, pero ofreciendo el mismo rendimiento que una plancha de pelo a 230 \u00b0C*. Combina la m\u00e1xima eficiencia con una protecci\u00f3n total.<\/p><h2>GARANT\u00cdA DE CALIDAD ROWENTA<\/h2><p>Rowenta pone al alcance de tu mano dispositivos de alta gama haciendo uso de toda su experiencia profesional, con 90 a\u00f1os al frente del mercado de los productos de belleza y estilismo y estrechas colaboraciones con marcas internacionales de referencia en cosm\u00e9tica capilar profesional.<\/p><h2>MOLDEADO SEGURO<\/h2><p>Disfruta de sus prestaciones de seguridad, como un tono de alerta de encendido y apagado, una funci\u00f3n de apagado autom\u00e1tico tras 45 minutos de inactividad o un capuch\u00f3n t\u00e9rmico para guardarla de forma f\u00e1cil y segura.<\/p><h2>Especificaciones<\/h2><p><\/p><ul><li><b>RESULTADO\/USO<\/b><\/li><li>Recubrimiento de placas:&nbsp;<span style='background-color: initial;'>Cer\u00e1mico<\/span><\/li><li>Funciones:&nbsp;<span style='background-color: initial;'>Totalmente liso, rizos y ondas<\/span><\/li><li>Placas flotantes:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Placas flotantes 3D:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Estado del pelo:&nbsp;<span style='background-color: initial;'>Seco<\/span><\/li><li>Dimensi\u00f3n de las placas:&nbsp;<span style='background-color: initial;'>25 x 90 mm<\/span><\/li><li>Temperatura ajustable:&nbsp;<span style='background-color: initial;'>120 \u00b0C a 200 \u00b0C<\/span><\/li><li><b>RESPETO DEL CABELLO Y ERGONOM\u00cdA<\/b><\/li><li>Punta fr\u00eda:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>ERGONOM\u00cdA\/COMODIDAD DE USO<\/b><\/li><li>Pantalla:&nbsp;<span style='background-color: initial;'>LED<\/span><\/li><li>Indicador de calentamiento:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Seguridad:&nbsp;<span style='background-color: initial;'>Capuch\u00f3n termo-resistente<\/span><\/li><li><b>ESPECIFICACIONES T\u00c9CNICAS<\/b><\/li><li>Voltaje:&nbsp;<span style='background-color: initial;'>220-240 V<\/span><\/li><li>Cable giratorio de 360\u00b0:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>TIPO DE PEINADO<\/b><\/li><li>Alisado:&nbsp;<span style='background-color: initial;'>No<\/span><\/li><li>Rizado:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>RESULTADOS DE PEINADOS<\/b><\/li><li>Alisado:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><li>Rizos y ondas:&nbsp;<span style='background-color: initial;'>S\u00ed<\/span><\/li><\/ul><p><\/p><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ROWENTA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.95,"unit_price":97.59,"unit_price_tax":97.59,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Planchas de pelo","quantity":2,"brand":"ROWENTA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_row-pae-plp%20sf8230f0_1.jpg"],"wholesale_price":90.59}}},"8435797000407":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435797000407",false],"wholesale_price":[533.81,false],"price":[540.81,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:286112","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fd61d4e962db6f3b7ed025bc44069f99.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"NAS Synology Diskstation DS225+\/ 2 Bah\u00edas 3.5'- 2.5'\/ 6GB DDR4\/ 8TB\/ Formato Torre","category":"Discos Duros Externos","sub_category":"Discos Duros de Red - NAS","unit_price":540.81,"reference":"DS225+\/6G 8TB","ean13":"8435797000407","weight":"3.1","quantity":2,"brand":"SYNOLOGY","description_pt":"                                                                                                <h2>DiskStation DS225+<\/h2><p>Almacenamiento de datos compacto para el hogar y el borde<\/p><h2>Consolidar y proteger<\/h2><p>Hasta 40 TB de almacenamiento bruto<\/p><h2>Almacenamiento capaz<\/h2><p>Puerto integrado de 2.5GbE y m\u00e1s de 282\/217 MB\/s de lectura\/escritura secuencial3<\/p><h2>Aplicaciones vers\u00e1tiles<\/h2><p>Realice copias de seguridad de m\u00faltiples puntos finales, gestione 25 c\u00e1maras IP4, o sincronice y comparta archivos de forma segura entre sitios<\/p><h2>Almacene, comparta y proteja<\/h2><p>Administre todos sus documentos, fotos y otros archivos, realice copias de seguridad de aplicaciones y dispositivos, y proteja sus activos con vigilancia profesional de video.<\/p><h2>Nube privada para un acceso fluido a los datos<\/h2> Almacene, sincronice, acceda y comparta datos desde cualquier dispositivo, est\u00e9 donde est\u00e9. Trabaje sin problemas entre diferentes plataformas y dispositivos, y acceda a sus archivos a trav\u00e9s de aplicaciones m\u00f3viles, clientes de escritorio y una interfaz basada en navegador. Restaure r\u00e1pida y f\u00e1cilmente archivos en caso de eliminaci\u00f3n accidental, errores, malware, etc., con versionado.<br><h2>Sincronizaci\u00f3n de NAS a NAS<\/h2><p>Mejore la eficiencia del flujo de trabajo y la alineaci\u00f3n del equipo en los sitios de datos con la sincronizaci\u00f3n autom\u00e1tica de sitio a sitio en una o dos direcciones. Los archivos y carpetas se mantienen actualizados en todos los sitios, para que todos est\u00e9n alineados, ya sea en casa, en la oficina o en diferentes sucursales, todo mientras mantiene el control total de sus datos.<\/p><h2>Vigilancia inteligente<\/h2> Proteger su negocio nunca ha sido m\u00e1s f\u00e1cil, con gesti\u00f3n centralizada, soporte para m\u00e1s de 8,700 modelos de c\u00e1maras IP, y monitoreo y reproducci\u00f3n remotos. El sistema de gesti\u00f3n de video escalable de Synology proporciona todas las herramientas que necesita para monitoreo en vivo, investigaci\u00f3n, gesti\u00f3n y respaldo.<h2>Especificaciones<\/h2><ul>\t<li><b>CPU:<\/b> Intel Celeron J4125, 4 n\u00facleos, 64 bits, 2.0&#8211;2.7 GHz<\/li>\t<li><b>Motor de cifrado de hardware:<\/b> S\u00ed<\/li>\t<li><b>Memoria:<\/b>\u00a06 GB DDR4 non-ECC<\/li>\t<li><b>Almacenamiento:<\/b>\u00a08TB (2x 4TB\u00a0HAT3300-4T)<\/li>\t<li><b>Bah\u00edas de unidad:<\/b> 2 (3.5' SATA HDD o 2.5' SATA SSD)<\/li>\t<li><b>Intercambio en caliente:<\/b> S\u00ed<\/li>\t<li><b>Puertos LAN:<\/b><ul>\t<li>1x RJ45 1GbE<\/li>\t<li>1x RJ45 2.5GbE<\/li><\/ul><\/li>\t<li><b>Puertos USB:<\/b> 2x USB 3.2 Gen 1<\/li>\t<li><b>Dimensiones:<\/b> 165 x 108 x 232,2 mm<\/li>\t<li><b>Peso:<\/b> 1,3 kg<\/li>\t<li><b>Ventilador:<\/b> 1x 92 mm, con modos: velocidad completa \/ fr\u00edo \/ silencioso<\/li>\t<li><b>Ruido operativo:<\/b> 19,6 dB(A)<\/li>\t<li><b>Fuente de alimentaci\u00f3n:<\/b> 60 W, entrada 100&#8211;240V AC, 50\/60 Hz<\/li>\t<li><b>Consumo energ\u00e9tico:<\/b><ul>\t<li>16,98 W (acceso)<\/li>\t<li>6,08 W (hibernaci\u00f3n del disco)<\/li><\/ul><\/li>\t<li><b>BTU:<\/b><ul>\t<li>57,90 BTU\/h (acceso)<\/li>\t<li>20,73 BTU\/h (hibernaci\u00f3n)<\/li><\/ul><\/li>\t<li><b>Temperatura operativa:<\/b> 0 \u00b0C &#8211; 40 \u00b0C<\/li>\t<li><b>Temperatura de almacenamiento:<\/b> -20 \u00b0C &#8211; 60 \u00b0C<\/li>\t<li><b>Humedad operativa:<\/b> 8 % &#8211; 80 % RH<\/li>\t<li><b>Humedad de almacenamiento:<\/b> 5 % &#8211; 95 % RH<\/li>\t<li><b>Certificaciones:<\/b> FCC, CE, BSMI, VCCI, RCM, UKCA, EAC, CCC, KC, BIS<\/li>\t<li><b>Conformidad ambiental:<\/b> RoHS<\/li>\t<li><b>Contenido del paquete:<\/b><ul>\t<li>1x Unidad principal<\/l