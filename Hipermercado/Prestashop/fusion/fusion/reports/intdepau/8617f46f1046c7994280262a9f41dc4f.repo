 estable y de alta calidad.&nbsp;<\/li><li>Soporta resoluciones de hasta 1920x1080@60Hz (1080p Full HD) incluyendo 720p, 1600x1200, 1280x1024.&nbsp;<\/li><li>Sistema Plug and Play, s\u00f3lo conectar y funciona.&nbsp;<\/li><\/ul><\/p><\/p><p><br><\/p><h2>Especificaciones<\/h2><p><p><ul><li><b>Longitud:<\/b> 1.8 m<\/li><li><b>Color<\/b>: Negro<\/li><li><b>Normativas:<\/b> RoHS<\/li><li><b>Test de Funcionamiento<\/b>: 100% testado<\/li><li><b>Contenido del paquete:<\/b><\/li><li>1 x Cable conversor VGA\/M a HDMI\/M, Negro, 1.8m&nbsp; &nbsp; &nbsp;<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NANO CABLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0.11,"unit_price":12.59,"unit_price_tax":12.59,"tax_rules_group":null,"category":"Cables","sub_category":"Cables HDMI","quantity":0,"brand":"NANO CABLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nan-cab%2010%2015%204602_1.jpg"],"wholesale_price":5.59}}},"8433281016224":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8433281016224",false],"wholesale_price":[1.85,false],"price":[8.85,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.22",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:286090","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/61fc9098090dc2f124709404e8a1d5c7.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":