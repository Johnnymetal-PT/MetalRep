ures":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:289611","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c9286006df7df34a59eeba9299853d60.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Altavoz con Bluetooth SPC Orbital Spark\/ 15W\/ 1.0","category":"Altavoces","sub_category":"Altavoces","unit_price":26.79,"reference":"4434N","ean13":"8436609913908","weight":"0","quantity":0,"brand":"SPC","description_pt":"                                                <p><\/p><h2>ORBITAL SPARK<\/h2><p>15W Y M\u00c1S DE 24 HORAS\u00a0<span style='background-color: initial;'>DE AUTONOM\u00cdA QUE\u00a0<\/span><span style='background-color: initial;'>ENCIENDEN LA CHISPA DE\u00a0<\/span><span style='background-color: initial;'>TU SONIDO<\/span><\/p><h2>SONIDO DE ALTA CALIDAD PARA\u00a0<span style='background-color: initial;'>ESPACIOS PEQUE\u00d1OS<\/span><\/h2><p>El altavoz est\u00e1 dise\u00f1ado para ofrecer\u00a0<span style='background-color: initial;'>un sonido de alta calidad en espacios\u00a0<\/span><span style='background-color: initial;'>peque\u00f1os con una portabilidad\u00a0<\/span><span style='background-color: initial;'>insuperable. A pesar de su tama\u00f1o\u00a0<\/span><span style='background-color: initial;'>compacto, sorprende con una potencia\u00a0<\/span><span style='background-color: initial;'>excepcional que llena cada rinc\u00f3n con un\u00a0<\/span><span style='background-color: initial;'>audio envolvente y n\u00edtido.<\/span><\/p><h2>ORBITAL SPARK<\/h2><p>ORBITAL SPARK, altavoz compacto\u00a0<span style='background-color: initial;'>pero potente, dise\u00f1ado para brillar en\u00a0<\/span><span style='background-color: initial;'>cualquier lugar. &#8216;Orbital&#8217; representa su\u00a0<\/span><span style='background-color: initial;'>incre\u00edble portabilidad y versatilidad,\u00a0<\/span><span style='background-color: initial;'>acompa\u00f1\u00e1ndote en cada aventura, desde\u00a0<\/span><span style='background-color: initial;'>la ciudad hasta la naturaleza. &#8216;Spark&#8217;\u00a0<\/span><span style='background-color: initial;'>simboliza la chispa que enciende cada\u00a0<\/span><span style='background-color: initial;'>momento con su impresionante sonido.<\/span><\/p><h2>UNA EXPERIENCIA ENVOLVENTE<\/h2><p>El ORBITAL SPARK combina un dise\u00f1o\u00a0<span style='background-color: initial;'>redondeado y elegante con colores\u00a0<\/span><span style='background-color: initial;'>vibrantes y detalles cuidadosamente\u00a0<\/span><span style='background-color: initial;'>seleccionados que realzan su estilo\u00a0<\/span><span style='background-color: initial;'>\u00fanico. Sus luces envolventes, que\u00a0<\/span><span style='background-color: initial;'>se sincronizan al ritmo de la m\u00fasica,\u00a0<\/span><span style='background-color: initial;'>crean una experiencia sensorial \u00fanica,\u00a0<\/span><span style='background-color: initial;'>perfecta para cualquier ambiente.<\/span><\/p><p><\/p><div>  <h2>Especificaciones<\/h2>  <ul>    <li><b>Versi\u00f3n Bluetooth:<\/b> 5.3<\/li>    <li><b>Potencia:<\/b> 15W<\/li>    <li><b>Respuesta de frecuencia:<\/b> 20Hz&#8211;20KHz<\/li>    <li><b>Distancia de transmisi\u00f3n:<\/b> 10 m<\/li>    <li><b>Bater\u00eda:<\/b> 1800mAh<\/li>    <li><b>Duraci\u00f3n de la bater\u00eda:<\/b> 24 h (volumen medio)<\/li>    <li><b>Tiempo de carga:<\/b> 2,5 h<\/li>    <li><b>Tipo de cargador:<\/b> USB tipo C<\/li>    <li><b>TWS:<\/b> S\u00ed (Est\u00e9reo Verdadero Inal\u00e1mbrico)<\/li>    <li><b>Resistencia al agua:<\/b> IPX6<\/li>    <li><b>Alto:<\/b> 110 cm<\/li>    <li><b>Ancho:<\/b> 101 cm<\/li>    <li><b>Fondo:<\/b> 101 cm<\/li>    <li><b>Peso:<\/b> 525 g<\/li>    <li><b>Contenido de la caja:<\/b> ORBITAL SPARK, gu\u00eda de usuario y cable de carga<\/li>  <\/ul><\/div>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-alt%20orbital%20spark%20bk_1.jpg","wholesale_price":"19.79","unit_price_tax":26.79},"product_model":{"product_data":{"ean13":["8436609913908"],"reference":"4434N","name":{"1":"Altavoz con Bluetooth SPC Orbital Spark\/ 15W\/ 1.0","2":"","3":"","4":""},"description":{"1":"                                                <p><\/p><h2>ORBITAL SPARK<\/h2><p>15W Y M\u00c1S DE 24 HORAS\u00a0<span style='background-color: initial;'>DE AUTONOM\u00cdA QUE\u00a0<\/span><span style='background-color: initial;'>ENCIENDEN LA CHISPA DE\u00a0<\/span><span style='background-color: initial;'>TU SONIDO<\/span><\/p><h2>SONIDO DE ALTA CALIDAD PARA\u00a0<span style='background-color: initial;'>ESPACIOS PEQUE\u00d1OS<\/span><\/h2><p>El altavoz est\u00e1 dise\u00f1ado para ofrecer\u00a0<span style='background-color: initial;'>un sonido de alta calidad en espacios\u00a0<\/span><span style='background-color: initial;'>peque\u00f1os con una portabilidad\u00a0<\/span><span style='background-color: initial;'>insuperable. A pesar de su tama\u00f1o\u00a0<\/span><span style='background-color: initial;'>compacto, sorprende con una potencia\u00a0<\/span><span style='background-color: initial;'>excepcional que llena cada rinc\u00f3n con un\u00a0<\/span><span style='background-color: initial;'>audio envolvente y n\u00edtido.<\/span><\/p><h2>ORBITAL SPARK<\/h2><p>ORBITAL SPARK, altavoz compacto\u00a0<span style='background-color: initial;'>pero potente, dise\u00f1ado para brillar en\u00a0<\/span><span style='background-color: initial;'>cualquier lugar. &#8216;Orbital&#8217; representa su\u00a0<\/span><span style='background-color: initial;'>incre\u00edble portabilidad y versatilidad,\u00a0<\/span><span style='background-color: initial;'>acompa\u00f1\u00e1ndote en cada aventura, desde\u00a0<\/span><span style='background-color: initial;'>la ciudad hasta la naturaleza. &#8216;Spark&#8217;\u00a0<\/span><span style='background-color: initial;'>simboliza la chispa que enciende cada\u00a0<\/span><span style='background-color: initial;'>momento con su impresionante sonido.<\/span><\/p><h2>UNA EXPERIENCIA ENVOLVENTE<\/h2><p>El ORBITAL SPARK combina un dise\u00f1o\u00a0<span style='background-color: initial;'>redondeado y elegante con colores\u00a0<\/span><span style='background-color: initial;'>vibrantes y detalles cuidadosamente\u00a0<\/span><span style='background-color: initial;'>seleccionados que realzan su estilo\u00a0<\/span><span style='background-color: initial;'>\u00fanico. Sus luces envolventes, que\u00a0<\/span><span style='background-color: initial;'>se sincronizan al ritmo de la m\u00fasica,\u00a0<\/span><span style='background-color: initial;'>crean una experiencia sensorial \u00fanica,\u00a0<\/span><span style='background-color: initial;'>perfecta para cualquier ambiente.<\/span><\/p><p><\/p><div>  <h2>Especificaciones<\/h2>  <ul>    <li><b>Versi\u00f3n Bluetooth:<\/b> 5.3<\/li>    <li><b>Potencia:<\/b> 15W<\/li>    <li><b>Respuesta de frecuencia:<\/b> 20Hz&#8211;20KHz<\/li>    <li><b>Distancia de transmisi\u00f3n:<\/b> 10 m<\/li>    <li><b>Bater\u00eda:<\/b> 1800mAh<\/li>    <li><b>Duraci\u00f3n de la bater\u00eda:<\/b> 24 h (volumen medio)<\/li>    <li><b>Tiempo de carga:<\/b> 2,5 h<\/li>    <li><b>Tipo de cargador:<\/b> USB tipo C<\/li>    <li><b>TWS:<\/b> S\u00ed (Est\u00e9reo Verdadero Inal\u00e1mbrico)<\/li>    <li><b>Resistencia al agua:<\/b> IPX6<\/li>    <li><b>Alto:<\/b> 110 cm<\/li>    <li><b>Ancho:<\/b> 101 cm<\/li>    <li><b>Fondo:<\/b> 101 cm<\/li>    <li><b>Peso:<\/b> 525 g<\/li>    <li><b>Contenido de la caja:<\/b> ORBITAL SPARK, gu\u00eda de usuario y cable de carga<\/li>  <\/ul><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SPC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":26.79,"unit_price_tax":26.79,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":0,"brand":"SPC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-alt%20orbital%20spark%20bk_1.jpg"],"wholesale_price":19.79}}},"8436609913939":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436609913939",false],"wholesale_price":[39.79,false],"price":[46.79,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:289612","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9e8ec7c4ef18393f2f1c319aa8ad454f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Altavoz con Bluetooth SPC Orbital Storm\/ 60W\/ 2.0","category":"Altavoces","sub_category":"Altavoces","unit_price":46.79,"reference":"4437N","ean13":"8436609913939","weight":"0","quantity":0,"brand":"SPC","description_pt":"<p><h2>SPC ORBITAL STORM<\/h2><div><p>Altavoz Bluetooth con 60 W de potencia y dos grandes diafragmas para un sonido espectacular, luces sincronizadas con la m\u00fasica opcionales, 20 horas de duraci\u00f3n de la bater\u00eda, alta resistencia al agua y asa integrada para un transporte c\u00f3modo.<\/p><p><ul><li>Perfecto para espacios abiertos y entornos ruidosos.<\/li><li>Funci\u00f3n True Wireless: sonido est\u00e9reo<\/li><li>Otras opciones de conectividad: USB, conector de 3,5 mm...<\/li><\/ul><\/p><h2>Una tormenta de vatios.<\/h2><p>El altavoz inal\u00e1mbrico Bluetooth SPC ORBITAL STORM pesa 930 g y ofrece una potencia asombrosa.<\/p><p>Su tama\u00f1o compacto resulta sorprendente, pues parece incre\u00edble que tanta potencia quepa en un cuerpo tan peque\u00f1o.<\/p><p>Sus 60 W y dos grandes diafragmas se combinan para lograr un sonido refinado e impresionante. Perfecto para animar fiestas de cumplea\u00f1os o crear la banda sonora ideal para una barbacoa en el jard\u00edn con un acompa\u00f1amiento de audio verdaderamente profesional.<\/p><h2>\u00bfQuieres un punto m\u00e1s de perfecci\u00f3n?<\/h2><p>Si hoy te sientes con ganas de darte un capricho, quieres sorprender a tu pareja o simplemente te lo mereces, combina dos altavoces ORBITAL STORM y disfruta de un sonido est\u00e9reo perfecto para una tarde de pel\u00edculas o videojuegos con un audio envolvente e impresionante.<\/p><p>Pero ten cuidado, despu\u00e9s de eso, nada volver\u00e1 a ser igual.<\/p><h2>El poder del trueno, la luz del rel\u00e1mpago<\/h2><p>Adem\u00e1s de una calidad de sonido excepcional, el SPC ORBITAL STORM incorpora iluminaci\u00f3n LED de 360\u00ba para una experiencia a\u00fan m\u00e1s extraordinaria . Las tiras de luz crean atm\u00f3sferas \u00fanicas que se adaptan a la m\u00fasica que reproducen, para que puedas personalizar tu experiencia musical seg\u00fan tu estado de \u00e1nimo y hacer que ese momento sea a\u00fan m\u00e1s especial.<\/p><p>Un ritmo potente para rock, metal o techno, y un ritmo m\u00e1s suave para jazz o reggae.<\/p><p>Y si prefieres centrarte \u00fanicamente en el sonido, puedes apagar la luz cuando quieras.<\/p><h2>\u00bfPodr\u00edas escuchar 350 canciones sin parar?<\/h2><p>1200 minutos es much\u00edsimo tiempo. Suficiente para escuchar una lista de reproducci\u00f3n de 350 canciones sin parar.<\/p><p>Si te apetece un marat\u00f3n musical, pulsa REPRODUCIR y disfruta de hasta 20 horas de m\u00fasica.<\/p><p>Su bater\u00eda de larga duraci\u00f3n te acompa\u00f1ar\u00e1 sin problemas durante todo un fin de semana, en una fiesta interminable o como m\u00fasica de fondo para estudiar o trabajar.<\/p><p>Y cuando necesite recargarse, pausa la reproducci\u00f3n y estar\u00e1 completamente cargada en un abrir y cerrar de ojos: en tan solo 2,5 horas.<\/p><h2>Dos preocupaciones innecesarias.<\/h2><p>El agua es agua y los accidentes ocurren, pero su certificaci\u00f3n IPX6 la protege contra salpicaduras, chorros de agua accidentales e incluso lluvias torrenciales. Ll\u00e9vala a donde quieras y no te preocupes si esa calurosa tarde de julio termina con una tormenta de verano.<\/p><p>Y si te quedas sin bater\u00eda o sin cobertura m\u00f3vil, tampoco te preocupes.<\/p><h2>Potente pero no grande.<\/h2><p>Sin ruedas, sin carrito, y ni siquiera necesita ser transportado por dos personas. Llevarlo contigo hasta el fin del mundo es muy f\u00e1cil.<\/p><p>Porque s\u00ed, es muy potente, pero nada grande.<\/p><p><b>Su dise\u00f1o ha sido meticulosamente elaborado, al igual que su interior .<\/b><\/p><p>Port\u00e1til, con forma tubular que facilita su manejo, una agradable textura textil, un asa integrada y dos discretas patas que le proporcionan una base firme y permiten usarlo con seguridad en posici\u00f3n horizontal.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li><b>Caracter\u00edsticas generales<\/b><\/li><li>Versi\u00f3n de Bluetooth: 5.3<\/li><li>Potencia: 60 W<\/li><li>Respuesta en frecuencia: 20 Hz - 20 kHz<\/li><li>Distancia de transmisi\u00f3n: 10 metros<\/li><li><b>Bater\u00eda<\/b><\/li><li>Bater\u00eda de 4400 mAh<\/li><li>Duraci\u00f3n de la bater\u00eda: 20 horas (volumen medio)<\/li><li>Tiempo de carga: 2,5 horas<\/li><li>Tipo de cargador: USB-C<\/li><li>TWS (True Wireless Stereo) - S\u00ed<\/li><li>Resistencia al agua - IPX6<\/li><li><b>Dimensiones y peso<\/b><\/li><li>Altura - 220 mm<\/li><li>Ancho: 98 mm<\/li><li>Profundidad: 98 mm<\/li><li>Peso: 935 g.<\/li><li><b>Contenido de la caja<\/b><\/li><li>SPC Orbital Storm, gu\u00eda del usuario y cable de carga.<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-alt%20orbital%20storm%20bk_1.jpg","wholesale_price":"39.79","unit_price_tax":46.79},"product_model":{"product_data":{"ean13":["8436609913939"],"reference":"4437N","name":{"1":"Altavoz con Bluetooth SPC Orbital Storm\/ 60W\/ 2.0","2":"","3":"","4":""},"description":{"1":"<p><h2>SPC ORBITAL STORM<\/h2><div><p>Altavoz Bluetooth con 60 W de potencia y dos grandes diafragmas para un sonido espectacular, luces sincronizadas con la m\u00fasica opcionales, 20 horas de duraci\u00f3n de la bater\u00eda, alta resistencia al agua y asa integrada para un transporte c\u00f3modo.<\/p><p><ul><li>Perfecto para espacios abiertos y entornos ruidosos.<\/li><li>Funci\u00f3n True Wireless: sonido est\u00e9reo<\/li><li>Otras opciones de conectividad: USB, conector de 3,5 mm...<\/li><\/ul><\/p><h2>Una tormenta de vatios.<\/h2><p>El altavoz inal\u00e1mbrico Bluetooth SPC ORBITAL STORM pesa 930 g y ofrece una potencia asombrosa.<\/p><p>Su tama\u00f1o compacto resulta sorprendente, pues parece incre\u00edble que tanta potencia quepa en un cuerpo tan peque\u00f1o.<\/p><p>Sus 60 W y dos grandes diafragmas se combinan para lograr un sonido refinado e impresionante. Perfecto para animar fiestas de cumplea\u00f1os o crear la banda sonora ideal para una barbacoa en el jard\u00edn con un acompa\u00f1amiento de audio verdaderamente profesional.<\/p><h2>\u00bfQuieres un punto m\u00e1s de perfecci\u00f3n?<\/h2><p>Si hoy te sientes con ganas de darte un capricho, quieres sorprender a tu pareja o simplemente te lo mereces, combina dos altavoces ORBITAL STORM y disfruta de un sonido est\u00e9reo perfecto para una tarde de pel\u00edculas o videojuegos con un audio envolvente e impresionante.<\/p><p>Pero ten cuidado, despu\u00e9s de eso, nada volver\u00e1 a ser igual.<\/p><h2>El poder del trueno, la luz del rel\u00e1mpago<\/h2><p>Adem\u00e1s de una calidad de sonido excepcional, el SPC ORBITAL STORM incorpora iluminaci\u00f3n LED de 360\u00ba para una experiencia a\u00fan m\u00e1s extraordinaria . Las tiras de luz crean atm\u00f3sferas \u00fanicas que se adaptan a la m\u00fasica que reproducen, para que puedas personalizar tu experiencia musical seg\u00fan tu estado de \u00e1nimo y hacer que ese momento sea a\u00fan m\u00e1s especial.<\/p><p>Un ritmo potente para rock, metal o techno, y un ritmo m\u00e1s suave para jazz o reggae.<\/p><p>Y si prefieres centrarte \u00fanicamente en el sonido, puedes apagar la luz cuando quieras.<\/p><h2>\u00bfPodr\u00edas escuchar 350 canciones sin parar?<\/h2><p>1200 minutos es much\u00edsimo tiempo. Suficiente para escuchar una lista de reproducci\u00f3n de 350 canciones sin parar.<\/p><p>Si te apetece un marat\u00f3n musical, pulsa REPRODUCIR y disfruta de hasta 20 horas de m\u00fasica.<\/p><p>Su bater\u00eda de larga duraci\u00f3n te acompa\u00f1ar\u00e1 sin problemas durante todo un fin de semana, en una fiesta interminable o como m\u00fasica de fondo para estudiar o trabajar.<\/p><p>Y cuando necesite recargarse, pausa la reproducci\u00f3n y estar\u00e1 completamente cargada en un abrir y cerrar de ojos: en tan solo 2,5 horas.<\/p><h2>Dos preocupaciones innecesarias.<\/h2><p>El agua es agua y los accidentes ocurren, pero su certificaci\u00f3n IPX6 la protege contra salpicaduras, chorros de agua accidentales e incluso lluvias torrenciales. Ll\u00e9vala a donde quieras y no te preocupes si esa calurosa tarde de julio termina con una tormenta de verano.<\/p><p>Y si te quedas sin bater\u00eda o sin cobertura m\u00f3vil, tampoco te preocupes.<\/p><h2>Potente pero no grande.<\/h2><p>Sin ruedas, sin carrito, y ni siquiera necesita ser transportado por dos personas. Llevarlo contigo hasta el fin del mundo es muy f\u00e1cil.<\/p><p>Porque s\u00ed, es muy potente, pero nada grande.<\/p><p><b>Su dise\u00f1o ha sido meticulosamente elaborado, al igual que su interior .<\/b><\/p><p>Port\u00e1til, con forma tubular que facilita su manejo, una agradable textura textil, un asa integrada y dos discretas patas que le proporcionan una base firme y permiten usarlo con seguridad en posici\u00f3n horizontal.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li><b>Caracter\u00edsticas generales<\/b><\/li><li>Versi\u00f3n de Bluetooth: 5.3<\/li><li>Potencia: 60 W<\/li><li>Respuesta en frecuencia: 20 Hz - 20 kHz<\/li><li>Distancia de transmisi\u00f3n: 10 metros<\/li><li><b>Bater\u00eda<\/b><\/li><li>Bater\u00eda de 4400 mAh<\/li><li>Duraci\u00f3n de la bater\u00eda: 20 horas (volumen medio)<\/li><li>Tiempo de carga: 2,5 horas<\/li><li>Tipo de cargador: USB-C<\/li><li>TWS (True Wireless Stereo) - S\u00ed<\/li><li>Resistencia al agua - IPX6<\/li><li><b>Dimensiones y peso<\/b><\/li><li>Altura - 220 mm<\/li><li>Ancho: 98 mm<\/li><li>Profundidad: 98 mm<\/li><li>Peso: 935 g.<\/li><li><b>Contenido de la caja<\/b><\/li><li>SPC Orbital Storm, gu\u00eda del usuario y cable de carga.<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SPC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":46.79,"unit_price_tax":46.79,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":0,"brand":"SPC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-alt%20orbital%20storm%20bk_1.jpg"],"wholesale_price":39.79}}},"6941948707375":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941948707375",false],"wholesale_price":[70.66,false],"price":[77.66,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:289613","Cat. IDs: 89,71","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/04f90d762e1834e942f5ca6fd6108e98.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Barra de Sonido con Bluetooth Xiaomi Soundbar Pro 2.0ch\/ 84W\/ 2.0\/ Negra","category":"Altavoces","sub_category":"Barras de sonido","unit_price":77.66,"reference":"XIA-ALT SOUNDBAR P 2 0CH","ean13":"6941948707375","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"<h2>Xiaomi Soundbar Pro 2.0ch<\/h2><div>El complemento perfecto para tu televisor, con una calidad de sonido extraordinaria<br><\/div><div><h2>Disfruta de una experiencia de cine en casa realmente espectacular<\/h2><p>Con decodificaci\u00f3n Dolby Audio, dos altavoces medio-graves y dos tweeters, esta barra de sonido abarca un rango de 50 a 20 kHz con una potencia m\u00e1xima de 84 W.<\/p><p>Emite un audio n\u00edtido para ofrecer una experiencia auditiva envolvente.<\/p><p><\/p><h2>Varios m\u00e9todos de conexi\u00f3n<\/h2><p>Compatible con una amplia variedad de dispositivos<\/p><p>Ofrece diversas opciones para proporcionar una conexi\u00f3n c\u00f3moda con televisores, ordenadores y smartphones, como conexi\u00f3n \u00f3ptica, coaxial, HDMI (ARC) y Bluetooth*, y satisfacer tus necesidades de entretenimiento.<\/p><h2>Comparte tu pasi\u00f3n por la m\u00fasica en cualquier momento<\/h2><p>Coloca el \u00e1rea NFC de tu smartphone cerca del \u00e1rea NFC de la barra de sonido para emparejarlos por Bluetooth de forma instant\u00e1nea y reproducir m\u00fasica sin problemas.<\/p><p>Disfruta de un audio incre\u00edble de forma instant\u00e1nea.<\/p><h2>Para adaptarse a todas tus necesidades<\/h2><p>Gracias a la variedad de modos de audio, disfrutar\u00e1s de una experiencia de sonido envolvente, est\u00e9s viendo pel\u00edculas, escuchando m\u00fasica, jugando, inform\u00e1ndote sobre las noticias o utiliz\u00e1ndola por la noche.<\/p><h2>Cuenta con una c\u00f3moda pantalla vinculada con un mando a distancia inteligente<\/h2><p>Cuenta con una pantalla mejorada y un mando a distancia espec\u00edfico para ajustar el volumen y cambiar la entrada de audio f\u00e1cilmente, lo que ofrece una experiencia de usuario intuitiva y sin complicaciones. Disfruta de un control total de audio a tu alcance.<\/p><h2>Combina con la est\u00e9tica de cualquier hogar<\/h2><p>El metal pulido con forma de panal demuestra una artesan\u00eda y sofisticaci\u00f3n exquisitas.<\/p><p>La barra de sonido combina un dise\u00f1o elegante con un rendimiento potente, lo que la convierte en el complemento perfecto para cualquier hogar.<\/p><p><ul><li>Con\u00e9ctala al televisor en solo 4 pasos<\/li><li>Montaje en pared o sobre un mueble<\/li><\/ul><div><br><\/div><\/p><p><\/p><\/div><h2>Especificaciones<\/h2><ul>  <li><b>Canales:<\/b> 2<\/li>  <li><b>Salida m\u00e1xima:<\/b> 84 W<\/li>  <li><b>Color:<\/b> Negro<\/li>  <li><b>Controladores de altavoz:<\/b> Barra de sonido con 4 controladores (2 altavoces medio-graves y 2 tweeters)<\/li>  <li><b>Conexi\u00f3n:<\/b> Bluetooth, entrada coaxial, entrada \u00f3ptica, HDMI (ARC)<\/li>  <li><b>Modos de audio:<\/b> Modo est\u00e1ndar, modo de juego, modo de pel\u00edcula, modo de noticias, modo de m\u00fasica, modo nocturno<\/li>  <li><b>Dimensiones de la barra de sonido (L \u00d7 A \u00d7 A):<\/b> 840 \u00d7 87 \u00d7 60 mm<\/li>  <li><b>Peso de la barra de sonido:<\/b> 2300 \u00b1 50 g<\/li>  <li><b>Contenido del paquete:<\/b> Barra de sonido, 1 mando a distancia, 1 cable de alimentaci\u00f3n, 1 cable HDMI, kit de montaje en pared, tornillos, conjunto de tornillos de expansi\u00f3n, 1 manual de usuario<\/li><\/ul>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-alt%20soundbar%20p%202%200ch_1.jpg","wholesale_price":"70.66","unit_price_tax":77.66},"product_model