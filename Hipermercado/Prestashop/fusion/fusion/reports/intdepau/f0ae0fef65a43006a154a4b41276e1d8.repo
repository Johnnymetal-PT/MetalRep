s",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:289623","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9156eecde8ff15b0f18eb724fbd945a0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Perfilador Blaupunkt BP5015\/ a Pilas","category":"Cuidado Personal","sub_category":"Cortapelos","unit_price":9.82,"reference":"BP5015","ean13":"8436533799548","weight":"0","quantity":0,"brand":"BLAUPUNKT","description_pt":"<h2>PERFILADOR ELECTRICO BLAUPUNKT&nbsp;<\/h2><p><b>CABEZAL ROTATIVO<br><\/b><\/p><p>Blaupunkt BP5015 es un naricero el\u00e9ctrico compacto con cabezal rotativo y alimentaci\u00f3n a 1 pila AA para eliminar vello de nariz, orejas y retoques en cejas con precisi\u00f3n y bajo ruido. El cabezal se lava bajo el grifo y el cuerpo est\u00e1 protegido contra salpicaduras.<br><\/p><p><p>Orientado a reposici\u00f3n retail y uso dom\u00e9stico, el BP5015 integra un cabezal rotativo de cuchillas protegidas que corta el vello de forma segura sin tirones.<\/p><p>La puesta en marcha es inmediata: inserta la pila AA, desliza el interruptor ON\/OFF y trabaja con movimientos circulares en la zona externa de la narina o del pabell\u00f3n auditivo.<\/p><p>Para higiene y rendimiento, el cabezal se desmonta y enjuaga bajo el grifo; despu\u00e9s, s\u00e9calo y aplica 1&#8211;2 gotas de aceite no \u00e1cido ocasionalmente.<\/p><p>El aparato es IPX4 (solo salpicaduras), no sumergible y de uso dom\u00e9stico; no emplear en piel irritada ni durante el ba\u00f1o. Incluye tapa protectora para almacenaje.<\/p><p><br><\/p><h2>Especificaciones<\/h2><\/p><p><p><ul><li><b>Modelo:<\/b> BP5015; naricero el\u00e9ctrico con cabezal rotativo.<\/li><li><b>Alimentaci\u00f3n<\/b>: 1\u00d7AA (1,5 V DC); pila incluida.<\/li><li><b>Protecci\u00f3n<\/b>: IPX4 (resistente a salpicaduras); cabezal lavable; cuerpo no sumergible.<\/li><li><b>Nivel sonoro<\/b>: &lt;70 dB(A) (presi\u00f3n ac\u00fastica).<\/li><li><b>Uso previsto:<\/b> nariz y orejas; apto para retoques en cejas.<\/li><li><b>Controles y accesorios<\/b>: ON\/OFF deslizante; tapa protectora.<\/li><li><b>Conformidad:<\/b> EMC 2004\/108\/EU; EN 55014-1\/-2; EN 61000-3-2\/-3-3.<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-cor%20bp5015_1.jpg","wholesale_price":"2.82","unit_price_tax":9.82},"product_model":{"product_data":{"ean13":["8436533799548"],"reference":"BP5015","name":{"1":"Perfilador Blaupunkt BP5015\/ a Pilas","2":"","3":"","4":""},"description":{"1":"<h2>PERFILADOR ELECTRICO BLAUPUNKT&nbsp;<\/h2><p><b>CABEZAL ROTATIVO<br><\/b><\/p><p>Blaupunkt BP5015 es un naricero el\u00e9ctrico compacto con cabezal rotativo y alimentaci\u00f3n a 1 pila AA para eliminar vello de nariz, orejas y retoques en cejas con precisi\u00f3n y bajo ruido. El cabezal se lava bajo el grifo y el cuerpo est\u00e1 protegido contra salpicaduras.<br><\/p><p><p>Orientado a reposici\u00f3n retail y uso dom\u00e9stico, el BP5015 integra un cabezal rotativo de cuchillas protegidas que corta el vello de forma segura sin tirones.<\/p><p>La puesta en marcha es inmediata: inserta la pila AA, desliza el interruptor ON\/OFF y trabaja con movimientos circulares en la zona externa de la narina o del pabell\u00f3n auditivo.<\/p><p>Para higiene y rendimiento, el cabezal se desmonta y enjuaga bajo el grifo; despu\u00e9s, s\u00e9calo y aplica 1&#8211;2 gotas de aceite no \u00e1cido ocasionalmente.<\/p><p>El aparato es IPX4 (solo salpicaduras), no sumergible y de uso dom\u00e9stico; no emplear en piel irritada ni durante el ba\u00f1o. Incluye tapa protectora para almacenaje.<\/p><p><br><\/p><h2>Especificaciones<\/h2><\/p><p><p><ul><li><b>Modelo:<\/b> BP5015; naricero el\u00e9ctrico con cabezal rotativo.<\/li><li><b>Alimentaci\u00f3n<\/b>: 1\u00d7AA (1,5 V DC); pila incluida.<\/li><li><b>Protecci\u00f3n<\/b>: IPX4 (resistente a salpicaduras); cabezal lavable; cuerpo no sumergible.<\/li><li><b>Nivel sonoro<\/b>: &lt;70 dB(A) (presi\u00f3n ac\u00fastica).<\/li><li><b>Uso previsto:<\/b> nariz y orejas; apto para retoques en cejas.<\/li><li><b>Controles y accesorios<\/b>: ON\/OFF deslizante; tapa protectora.<\/li><li><b>Conformidad:<\/b> EMC 2004\/108\/EU; EN 55014-1\/-2; EN 61000-3-2\/-3-3.<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BLAUPUNKT","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":9.82,"unit_price_tax":9.82,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Cortapelos","quantity":0,"brand":"BLAUPUNKT","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-cor%20bp5015_1.jpg"],"wholesale_price":2.82}}},"8436533799586":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436533799586",false],"wholesale_price":[8.94,false],"price":[15.94,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:289624","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e84dd62dfb64c0776014a171528bcb46.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Secador Blaupunkt BP5019\/ 1200W\/ Negro y Plata","category":"Cuidado Personal","sub_category":"Secadores","unit_price":15.94,"reference":"BP5019","ean13":"8436533799586","weight":"0","quantity":0,"brand":"BLAUPUNKT","description_pt":"<h2>SECADOR DE VIAJE BLAUPUNKT - 1200W<\/h2><div><p>Compacto y pensado para uso frecuente en desplazamientos, el BP5019 entrega 1.200 W para un secado r\u00e1pido con dos combinaciones de caudal y temperatura (baja\/alta) seleccionables desde el interruptor 0\/I\/II.<\/p><p>El bot\u00f3n de aire fr\u00edo ayuda a fijar el peinado con un flujo continuo de aire fresco. Para mayor seguridad incorpora protecci\u00f3n t\u00e9rmica: si se detecta sobrecalentamiento, el aparato se apaga autom\u00e1ticamente; basta con desconectarlo, dejarlo enfriar y comprobar que las rejillas no est\u00e9n obstruidas antes de volver a usarlo.<\/p><p>El difusor facilita aportar volumen y definir ondas, mientras el filtro trasero extra\u00edble simplifica el mantenimiento. El cable de 1,8 m con enchufe VDE aporta comodidad de uso y la anilla permite almacenaje colgado.<\/p><p>Alimentaci\u00f3n 220&#8211;240 V~ 50\/60 Hz, Clase II (doble aislamiento).<\/p><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li>Potencia 1200W<\/li><li>Con Difusor<\/li><li>Enchufe VDE<\/li><li>Cable 1.8m<\/li><li>Medidas\/Caja 11x7,2x17 cm<\/li><\/ul><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-sec%20bp5019_1.jpg","wholesale_price":"8.94","unit_price_tax":15.94},"product_model":{"product_data":{"ean13":["8436533799586"],"reference":"BP5019","name":{"1":"Secador Blaupunkt BP5019\/ 1200W\/ Negro y Plata","2":"","3":"","4":""},"description":{"1":"<h2>SECADOR DE VIAJE BLAUPUNKT - 1200W<\/h2><div><p>Compacto y pensado para uso frecuente en desplazamientos, el BP5019 entrega 1.200 W para un secado r\u00e1pido con dos combinaciones de caudal y temperatura (baja\/alta) seleccionables desde el interruptor 0\/I\/II.<\/p><p>El bot\u00f3n de aire fr\u00edo ayuda a fijar el peinado con un flujo continuo de aire fresco. Para mayor seguridad incorpora protecci\u00f3n t\u00e9rmica: si se detecta sobrecalentamiento, el aparato se apaga autom\u00e1ticamente; basta con desconectarlo, dejarlo enfriar y comprobar que las rejillas no est\u00e9n obstruidas antes de volver a usarlo.<\/p><p>El difusor facilita aportar volumen y definir ondas, mientras el filtro trasero extra\u00edble simplifica el mantenimiento. El cable de 1,8 m con enchufe VDE aporta comodidad de uso y la anilla permite almacenaje colgado.<\/p><p>Alimentaci\u00f3n 220&#8211;240 V~ 50\/60 Hz, Clase II (doble aislamiento).<\/p><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li>Potencia 1200W<\/li><li>Con Difusor<\/li><li>Enchufe VDE<\/li><li>Cable 1.8m<\/li><li>Medidas\/Caja 11x7,2x17 cm<\/li><\/ul><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BLAUPUNKT","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":15.94,"unit_price_tax":15.94,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Secadores","quantity":0,"brand":"BLAUPUNKT","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-sec%20bp5019_1.jpg"],"wholesale_price":8.94}}},"8422521092562":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8422521092562",false],"wholesale_price":[32,false],"price":[39,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:289625","Cat. IDs: 2","Associated Categories","Cat. Default: 1","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/