.jpg"],"wholesale_price":654.22}}},"8435739402955":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435739402955",false],"wholesale_price":[45.51,false],"price":[52.51,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.37",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:293089","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e4d3dda779f00fa35bb976abcb9aaf3f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Adidas Drive Negro 3.4 2025\/ Negra","category":"Padel","sub_category":"Padel","unit_price":52.51,"reference":"ADI-PALA PAD DRIVE BK 34 25","ean13":"8435739402955","weight":"0.37","quantity":5,"brand":"ADIDAS","description_pt":"<p><\/p><h2>Pala Adidas Drive Negro 3.4 2025<\/h2><p>La Adidas Drive Negro 3.4 2025 es una pala de p\u00e1del dise\u00f1ada para jugadores que buscan mejorar su control y comodidad en la pista.<\/p><p>Con una construcci\u00f3n robusta y tecnolog\u00edas que optimizan su rendimiento, esta pala ofrece un manejo sencillo y una gran precisi\u00f3n, siendo ideal para principiantes y jugadores de nivel intermedio.<\/p><h2>Caracter\u00edsticas Principales:<\/h2><p>Material de la superficie: La pala est\u00e1 fabricada con fibra de vidrio, un material flexible que proporciona un excelente control y una mayor salida de bola.<\/p><p>Esto facilita el golpeo sin necesidad de emplear demasiada fuerza, ideal&nbsp;<span style='background-color: initial;'>para quienes est\u00e1n perfeccionando su t\u00e9cnica.<\/span><\/p><p>Forma redonda: Su dise\u00f1o redondo y el balance bajo garantizan un punto dulce amplio, lo que facilita el golpeo preciso incluso si la bola no impacta en el centro de la pala.<\/p><p>Peso: Perfectamente equilibrada para proporcionar comodidad en los movimientos, facilitando la rapidez y manejabilidad durante el juego.<\/p><p>Goma EVA de baja densidad: El n\u00facleo de EVA Soft mejora la absorci\u00f3n de vibraciones, ofreciendo un tacto m\u00e1s suave y reduciendo la fatiga en el brazo.<\/p><p>Adem\u00e1s, permite una buena salida de bola, haciendo que los golpes sean m\u00e1s c\u00f3modos y efectivos.<\/p><p>Dise\u00f1o de agujeros SMART HOLES LINEAL: La disposici\u00f3n de los agujeros est\u00e1 optimizada para incrementar la durabilidad de la pala y mejorar su resistencia al desgaste, adem\u00e1s de favorecer un control m\u00e1s preciso y una mejor maniobrabilidad.<\/p><p>Structural Reinforcement: Refuerzos estructurales estrat\u00e9gicos que incrementan la rigidez de la pala, garantizando mayor estabilidad durante el golpeo y reduciendo las vibraciones.<\/p><p>Esto tambi\u00e9n aumenta la durabilidad y la resistencia frente a impactos.<\/p><br><p><\/p><h2>Especificaciones<\/h2><br><p><b>General<\/b><\/p><p>Marca: Adidas<\/p><p>A\u00f1o: 2025<\/p><p>Color: Negro<\/p><p>Sexo: Hombre, mujer<\/p><br><p><b>Caracter\u00edsticas de juego<\/b><\/p><p>Nivel: Iniciaci\u00f3n<\/p><p>Tipo de juego: Control<\/p><p>Balance: Bajo<\/p><p>Forma: Redonda<\/p><br><p><b>Materiales<\/b><\/p><p>N\u00facleo: EVA Soft<\/p><p>Cara: Fibra de vidrio<\/p><p>Marco: Vidrio<\/p><p>Dureza: Blanda<\/p><p>Superficie: Lisa<\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_adi-pala%20pad%20drive%20bk%2034%2025_1.jpg","wholesale_price":"45.51","unit_price_tax":52.51},"product_model":{"product_data":{"ean13":["8435739402955"],"reference":"ADI-PALA PAD DRIVE BK 34 25","name":{"1":"Pala de P\u00e1del Adidas Drive Negro 3.4 2025\/ Negra","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Pala Adidas Drive Negro 3.4 2025<\/h2><p>La Adidas Drive Negro 3.4 2025 es una pala de p\u00e1del dise\u00f1ada para jugadores que buscan mejorar su control y comodidad en la pista.<\/p><p>Con una construcci\u00f3n robusta y tecnolog\u00edas que optimizan su rendimiento, esta pala ofrece un manejo sencillo y una gran precisi\u00f3n, siendo ideal para principiantes y jugadores de nivel intermedio.<\/p><h2>Caracter\u00edsticas Principales:<\/h2><p>Material de la superficie: La pala est\u00e1 fabricada con fibra de vidrio, un material flexible que proporciona un excelente control y una mayor salida de bola.<\/p><p>Esto facilita el golpeo sin necesidad de emplear demasiada fuerza, ideal&nbsp;<span style='background-color: initial;'>para quienes est\u00e1n perfeccionando su t\u00e9cnica.<\/span><\/p><p>Forma redonda: Su dise\u00f1o redondo y el balance bajo garantizan un punto dulce amplio, lo que facilita el golpeo preciso incluso si la bola no impacta en el centro de la pala.<\/p><p>Peso: Perfectamente equilibrada para proporcionar comodidad en los movimientos, facilitando la rapidez y manejabilidad durante el juego.<\/p><p>Goma EVA de baja densidad: El n\u00facleo de EVA Soft mejora la absorci\u00f3n de vibraciones, ofreciendo un tacto m\u00e1s suave y reduciendo la fatiga en el brazo.<\/p><p>Adem\u00e1s, permite una buena salida de bola, haciendo que los golpes sean m\u00e1s c\u00f3modos y efectivos.<\/p><p>Dise\u00f1o de agujeros SMART HOLES LINEAL: La disposici\u00f3n de los agujeros est\u00e1 optimizada para incrementar la durabilidad de la pala y mejorar su resistencia al desgaste, adem\u00e1s de favorecer un control m\u00e1s preciso y una mejor maniobrabilidad.<\/p><p>Structural Reinforcement: Refuerzos estructurales estrat\u00e9gicos que incrementan la rigidez de la pala, garantizando mayor estabilidad durante el golpeo y reduciendo las vibraciones.<\/p><p>Esto tambi\u00e9n aumenta la durabilidad y la resistencia frente a impactos.<\/p><br><p><\/p><h2>Especificaciones<\/h2><br><p><b>General<\/b><\/p><p>Marca: Adidas<\/p><p>A\u00f1o: 2025<\/p><p>Color: Negro<\/p><p>Se