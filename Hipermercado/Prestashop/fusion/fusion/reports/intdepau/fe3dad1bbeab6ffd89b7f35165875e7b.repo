-Pin Fan Plug<\/li>  <li><b>Dimensiones del embalaje:<\/b> 167 \u00d7 142 \u00d7 414 mm<\/li>  <li><b>Peso embalado:<\/b> 2,465 kg<\/li><\/ul>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ARCTIC","supplier":null,"width":null,"height":null,"depth":null,"weight":2.55,"unit_price":76.99,"unit_price_tax":76.99,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ventiladores","quantity":5,"brand":"ARCTIC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_arct-ref%20acfre00180a_1.jpg"],"wholesale_price":69.99}}}}