pida<\/span><ul><\/ul><\/div><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TP-LINK","supplier":null,"width":null,"height":null,"depth":null,"weight":0.45,"unit_price":31.32,"unit_price_tax":31.32,"tax_rules_group":null,"category":"Perif\u00e9ricos","sub_category":"Hub USB","quantity":2,"brand":"TP-LINK","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tpl-hub%20uh700_1.jpg"],"wholesale_price":24.32}}},"4895265000348":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4895265000348",false],"wholesale_price":[80.23,false],"price":[87.23,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.16",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:293097","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/1879a9002e61f3e9b1c3e6276d9c98cd.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Sistema de Refrigeraci\u00f3n L\u00edquida Arctic Liquid Freezer III Pro 420\/ Negro","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ventiladores","unit_price":87.23,"reference":"ACFRE00181A","ean13":"4895265000348","weight":"3.16","quantity":5,"brand":"ARCTIC","description_pt":"<h2>Liquid Freezer III Pro 420<\/h2><div>Refrigerador de agua para CPU todo en uno multicompatible<br><\/div><div><h2>Ventilador VRM integrado<\/h2><p>El ventilador controlado por PWM reduce la temperatura del regulador de voltaje, garantizando un rendimiento estable.<\/p><h2>Montaje descentrado | Intel y AMD<\/h2><p>Desplaza la placa fr\u00eda al punto caliente de la CPU para una transferencia de calor m\u00e1s eficiente.<\/p><h2>Marco de contacto | Intel<\/h2><p>Distribuci\u00f3n optimizada de la presi\u00f3n de contacto para una mayor vida \u00fatil de la CPU y una mejor disipaci\u00f3n del calor.<\/p><h2>Gesti\u00f3n integrada de cables<\/h2><p>Los cables del ventilador integrados en la funda simplifican la instalaci\u00f3n y minimizan el desorden de cables.<\/p><h2>Radiador de clase premium<\/h2><p>El radiador de 38 mm no solo mejora la disipaci\u00f3n del calor, sino que tambi\u00e9n contiene m\u00e1s l\u00edquido que los radiadores convencionales de 27 mm. Esto reduce la acumulaci\u00f3n de calor y garantiza una gesti\u00f3n m\u00e1s eficiente de los picos de temperatura.<\/p><h2>Dos opciones de control<\/h2><p>Con el cable divisor, la bomba, el ventilador VRM y los ventiladores del radiador se pueden controlar por separado o sincronizar mediante una \u00fanica se\u00f1al PWM con el cable todo en uno.<\/p><br><\/div><h2>Especificaciones<\/h2><ul>  <li><b>TIM:<\/b> MX-6 (0,8 g)<\/li>  <li><b>Temperatura ambiente de funcionamiento:<\/b> 0&#8212;40 \u00b0C<\/li>  <li><b>Bomba:<\/b> 800&#8211;2800 rpm (controlado por PWM)<\/li>  <li><b>Corriente | Voltaje (bomba):<\/b> 0,35 A | 12 V CC<\/li>  <li><b>Placa fr\u00eda:<\/b> Cobre, aletas microdesbastadas<\/li>  <li><b>Longitud del tubo:<\/b> 500 mm<\/li>  <li><b>Di\u00e1metro del tubo:<\/b> Exterior: 12,4 mm \/ Interior: 6,0 mm<\/li>  <li><b>Peso:<\/b> 2370 g<\/li>  <li><b>Compatibilidad Intel:<\/b> LGA1851, LGA1700<\/li>  <li><b>Compatibilidad AMD:<\/b> AM5, AM4<\/li>  <li><b>PI | NNPI:<\/b> 420 | 376<\/li>  <li><b>Radiador - Material:<\/b> Aluminio<\/li>  <li><b>Radiador - Dimensiones:<\/b> 458 (L) x 138 (A) x 38 (H) mm<\/li>  <li><b>Ventilador VRM:<\/b> 400&#8211;2500 rpm (controlado por PWM)<\/li>  <li><b>Corriente | Voltaje (VRM):<\/b> 0,05 A | 12 V CC<\/li>  <li><b>Ventiladores del radiador:<\/b> 3x P14 Pro<\/li>  <li><b>Velocidad del ventilador:<\/b> 400&#8211;2500 rpm<\/li>  <li><b>Flujo de aire:<\/b> 110 cfm | 186 m\u00b3\/h<\/li>  <li><b>Presi\u00f3n est\u00e1tica:<\/b> 5,2 mmH&#8322;O<\/li>  <li><b>Cojinete:<\/b> Cojinete din\u00e1mico fluido<\/li>  <li><b>Corriente | Voltaje (ventilador):<\/b> 0,35 A | 12 V CC<\/li>  <li><b>Conector del ventilador:<\/b> Conector de ventilador de 4 pines<\/li><\/ul>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_arct-ref%20acfre00181a_1.jpg","wholesale_price":"80.23","unit_price_tax":87.23},"product_model":{"product_data":{"ean13":["4895265000348"],"reference":"ACFRE00181A","name":{"1":"Sistema de Refrigeraci\u00f3n L\u00edquida Arctic Liquid Freezer III Pro 420\/ Negro","2":"","3":"","4":""},"description":{"1":"<h2>Liquid Freezer III Pro 420<\/h2><div>Refrigerador de agua para CPU todo en uno multicompatible<br><\/div><div><h2>Ventilador VRM integrado<\/h2><p>El ventilador controlado por PWM reduce la temperatura del regulador de voltaje, garantizando un rendimiento estable.<\/p><h2>Montaje descentrado | Intel y AMD<\/h2><p>Desplaza la placa fr\u00eda al punto caliente de la CPU para una transferencia de calor m\u00e1s eficiente.<\/p><h2>Marco de contacto | Intel<\/h2><p>Distribuci\u00f3n optimizada de la presi\u00f3n de contacto para una mayor vida \u00fatil de la CPU y una mejor disipaci\u00f3n del calor.<\/p><h2>Gesti\u00f3n integrada de cables<\/h2><p>Los cables del ventilador integrados en la funda simplifican la instalaci\u00f3n y minimizan el desorden de cables.<\/p><h2>Radiador de clase premium<\/h2><p>El radiador de 38 mm no solo mejora la disipaci\u00f3n del calor, sino que tambi\u00e9n contiene m\u00e1s l\u00edquido que los radiadores convencionales de 27 mm. Esto reduce la acumulaci\u00f3n de calor y garantiza una gesti\u00f3n m\u00e1s eficiente de los picos de temperatura.<\/p><h2>Dos opciones de control<\/h2><p>Con el cable divisor, la bomba, el ventilador VRM y los ventiladores del radiador se pueden controlar por separado o sincronizar mediante una \u00fanica se\u00f1al PWM con el cable todo en uno.<\/p><br><\/div><h2>Especificaciones<\/h2><ul>  <li><b>TIM:<\/b> MX-6 (0,8 g)<\/li>  <li><b>Temperatura ambiente de funcionamiento:<\/b> 0&#8212;40 \u00b0C<\/li>  <li><b>Bomba:<\/b> 800&#8211;2800 rpm (controlado por PWM)<\/li>  <li><b>Corriente | Voltaje (bomba):<\/b> 0,35 A | 12 V CC<\/li>  <li><b>Placa fr\u00eda:<\/b> Cobre, aletas microdesbastadas<\/li>  <li><b>Longitud del tubo:<\/b> 500 mm<\/li>  <li><b>Di\u00e1metro del tubo:<\/b> Exterior: 12,4 mm \/ Interior: 6,0 mm<\/li>  <li><b>Peso:<\/b> 2370 g<\/li>  <li><b>Compatibilidad Intel:<\/b> LGA1851, LGA1700<\/li>  <li><b>Compatibilidad AMD:<\/b> AM5, AM4<\/li>  <li><b>PI | NNPI:<\/b> 420 | 376<\/li>  <li><b>Radiador - Material:<\/b> Aluminio<\/li>  <li><b>Radiador - Dimensiones:<\/b> 458 (L) x 138 (A) x 38 (H) mm<\/li>  <li><b>Ventilador VRM:<\/b> 400&#8211;2500 rpm (controlado por PWM)<\/li>  <li><b>Corriente | Voltaje (VRM):<\/b> 0,05 A | 12 V CC<\/li>  <li><b>Ventiladores del radiador:<\/b> 3x P14 Pro<\/li>  <li><b>Velocidad del ventilador:<\/b> 400&#8211;2500 rpm<\/li>  <li><b>Flujo de aire:<\/b> 110 cfm | 186 m\u00b3\/h<\/li>  <li><b>Presi\u00f3n est\u00e1tica:<\/b> 5,2 mmH&#8322;O<\/li>  <li><b>Cojinete:<\/b> Cojinete din\u00e1mico fluido<\/li>  <li><b>Corriente | Voltaje (ventilador):<\/b> 0,35 A | 12 V CC<\/li>  <li><b>Conector del ventilador:<\/b> Conector de ventilador de 4 pines<\/li><\/ul>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ARCTIC","supplier":null,"width":null,"height":null,"depth":null,"weight":3.16,"unit_price":87.23,"unit_price_tax":87