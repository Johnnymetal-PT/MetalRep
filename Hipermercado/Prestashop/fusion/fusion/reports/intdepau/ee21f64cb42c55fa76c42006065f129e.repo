9","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/7a6234538dea005492575dd348b970e8.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Barra de Sonido con Bluetooth TCL P733WE\/ 400W\/ 3.1","category":"Altavoces","sub_category":"Barras de sonido","unit_price":191.34,"reference":"P733WE","ean13":"8720568100500","weight":"10.1","quantity":2,"brand":"TCL","description_pt":"<p><h2>Barra de sonido TCL P733WE, 3.1, 400W, Subwoofer inal\u00e1mbrico<\/h2><p>Barra de sonido de Cine en casa de 3.1 canales.<\/p><p>Logrando una mejor forma para un mejor sonido.<\/p><p>La barra de sonido ha sido completamente redise\u00f1ada en apariencia, su elegante dise\u00f1o curvado y su exterior met\u00e1lico esmerilado, le hacen sentir c\u00f3modo y c\u00e1lido. P733 est\u00e1 equipada con un canal de sonido de 3.1 canales, mientras que soporta DTS Virtual X y efectos de sonido Dolby, ya sea para ver pel\u00edculas, escuchar m\u00fasica o jugar a juegos.<\/p><p>El potente subwoofer inal\u00e1mbrico lleva la experiencia de calidad de sonido a un nivel superior.<\/p><p>P733W tambi\u00e9n cuenta con una amplia gama de funciones de conectividad, HDMI ARC y tecnolog\u00eda Bluetooth 5.2 para que sientas lo \u00faltimo en experiencia tecnol\u00f3gica.<\/p><p><br><\/p><h2>ESPECIFICACIONES<\/h2><\/p><p><p><ul><li><b>GENERAL<\/b><\/li><li>Tipo Barra de sonido<\/li><li>Sistema 3.1<\/li><li>Potencia total 400 W<\/li><li><b>AMPLIFICADOR RECEPTOR AV<\/b><\/li><li>Decodificadores DTS Virtual: X<\/li><li>Conexiones 1 HDMI-ARC Entrada<\/li><li>Bluetooth<\/li><li>1 USB 2.0<\/li><li>1 \u00d3ptica<\/li><li>1 Mini Jack 3,5 mm<\/li><li><b>ALTAVOCES<\/b><\/li><li>Sistema Subwoofer Inal\u00e1mbrico<\/li><li><b>DIMENSIONES Y PESO<\/b><\/li><li>Dimensi\u00f3n altavoz central 900 x 68 x 98 mm<\/li><li>Peso altavoz central 2,3 kg<\/li><li>Dimensiones Subwoofer 365 x 248 x 220 mm<\/li><li>Peso Subwoofer 5,6 kg<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-alt%20p733we_1.jpg","wholesale_price":"186.34","unit_price_tax":191.34},"product_model":{"product_data":{"ean13":["8720568100500"],"reference":"P733WE","name":{"1":"Barra de Sonido con Bluetooth TCL P733WE\/ 400W\/ 3.1","2":"","3":"","4":""},"description":{"1":"<p><h2>Barra de sonido TCL P733WE, 3.1, 400W, Subwoofer inal\u00e1mbrico<\/h2><p>Barra de sonido de Cine en casa de 3.1 canales.<\/p><p>Logrando una mejor forma para un mejor sonido.<\/p><p>La barra de sonido ha sido completamente redise\u00f1ada en apariencia, su elegante dise\u00f1o curvado y su exterior met\u00e1lico esmerilado, le hacen sentir c\u00f3modo y c\u00e1lido. P733 est\u00e1 equipada con un canal de sonido de 3.1 canales, mientras que soporta DTS Virtual X y efectos de sonido Dolby, ya sea para ver pel\u00edculas, escuchar m\u00fasica o jugar a juegos.<\/p><p>El potente subwoofer inal\u00e1mbrico lleva la experiencia de calidad de sonido a un nivel superior.<\/p><p>P733W tambi\u00e9n cuenta con una amplia gama de funciones de conectividad, HDMI ARC y tecnolog\u00eda Bluetooth 5.2 para que sientas lo \u00faltimo en experiencia tecnol\u00f3gica.<\/p><p><br><\/p><h2>ESPECIFICACIONES<\/h2><\/p><p><p><ul><li><b>GENERAL<\/b><\/li><li>Tipo Barra de sonido<\/li><li>Sistema 3.1<\/li><li>Potencia total 400 W<\/li><li><b>AMPLIFICADOR RECEPTOR AV<\/b><\/li><li>Decodificadores DTS Virtual: X<\/li><li>Conexiones 1 HDMI-ARC Entrada<\/li><li>Bluetooth<\/li><li>1 USB 2.0<\/li><li>1 \u00d3ptica<\/li><li>1 Mini Jack 3,5 mm<\/li><li><b>ALTAVOCES<\/b><\/li><li>Sistema Subwoofer Inal\u00e1mbrico<\/li><li><b>DIMENSIONES Y PESO<\/b><\/li><li>Dimensi\u00f3n altavoz central 900 x 68 x 98 mm<\/li><li>Peso altavoz central 2,3 kg<\/li><li>Dimensiones Subwoofer 365 x 248 x 220 mm<\/li><li>Peso Subwoofer 5,6 kg<\/li><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TCL","supplier":null,"width":null,"height":null,"depth":null,"weight":10.1,"unit_price":191.34,"unit_price_tax":191.34,"tax_rules_group":null,"category":"Altavoces","sub_category":"Barras de sonido","quantity":2,"brand":"TCL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-alt%20p733we_1.jpg"],"wholesale_price":186.34}}},"8720568100524":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8720568100524",false],"wholesale_price":[66.61,false],"price":[71.61,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 4.75",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154317","Cat. IDs: 89,71","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3515062ed3dbdd4953f50583ef5f3621.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Barra de Sonido con Bluetooth TCL S522WE\/ 200W\/ 2.1","category":"Altavoces","sub_category":"Barras de sonido","unit_price":71.61,"reference":"S522WE","ean13":"8720568100524","weight":"4.75","quantity":2,"brand":"TCL","description_pt":"<p><\/p><h2>Barra de sonido TCL S522WE, 2.1, 200W, Cine en Casa<\/h2><p>Barra de sonido de Cine en Casa con 2.1 canales.<\/p><p>Sonido impresionante de forma sencilla<\/p><p>La barra de sonido ofrece un sonido impresionante gracias a un ajuste de precisi\u00f3n para ofrecer lo que el artista pretend\u00eda. Probada y ajustada en en el galardonado iLab de B\u00e9lgica, la barra de sonido ha sido desarrollada por nuestro equipo interno, que cuenta con una amplia experiencia en sonido y experiencias ac\u00fasticas. Equipada con un sistema de barra de sonido de 2.1 canales con subwoofer, la barra de sonido est\u00e1 destinada a mejorar su experiencia de entretenimiento con un sonido impresionante que llena la habitaci\u00f3n. Adem\u00e1s, nuestra barra de sonido viene con tres modos de escucha distintos: pel\u00edcula, m\u00fasica y noticias. Est\u00e1 equipada con Bluetooth para facilitar la transmisi\u00f3n inal\u00e1mbrica.<\/p><p>Puede transmitir su m\u00fasica favorita en cualquier momento conectando su dispositivo inteligente con ella. Puede elegir el montaje en la pared y en el gabinete de la TV para la colocaci\u00f3n. Puede controlarlo con un simple mando a distancia de la barra de sonido o con el mando de su televisor TCL para facilitar su uso y reducir el desorden. Disfruta de una carga y un sonido claro sonido sin distorsi\u00f3n para una experiencia auditiva verdaderamente envolvente.<\/p><br><p><\/p><h2>ESPECIFICACIONES<\/h2><p><\/p><p><\/p><ul><li><b>GENERAL<\/b><\/li><li>Tipo Barra de sonido<\/li><li>Sistema 2.1<\/li><li>Potencia total 200 W<\/li><li><b>AMPLIFICADOR RECEPTOR AV<\/b><\/li><li>Conexiones 1 HDMI-ARC Entrada<\/li><li>Bluetooth 5.1<\/li><li>1 USB 2.0<\/li><li>1 \u00d3ptica<\/li><li>1 Mini Jack 3,5 mm<\/li><li><b>ALTAVOCES<\/b><\/li><li>Sistema Subwoofer Inal\u00e1mbrico<\/li><li><b>DIMENSIONES Y PESO<\/b><\/li><li>Dimensi\u00f3n altavoz central 800 x 70 x 99 mm<\/li><li>Dimensiones Subwoofer 165 x 240 x 298 mm<\/li><li>Peso Subwoofer 2,3 kg<\/li><\/ul><p><\/p><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-alt%20s522we_1.jpg","wholesale_price":"66.61","unit_price_tax":71.61},"product_model":{"product_data":{"ean13":["8720568100524"],"reference":"S522WE","name":{"1":"Barra de Sonido con Bluetooth TCL S522WE\/ 200W\/ 2.1","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Barra de sonido TCL S522WE, 2.1, 200W, Cine en Casa<\/h2><p>Barra de sonido de Cine en Casa con 2.1 canales.<\/p><p>Sonido impresionante de forma sencilla<\/p><p>La barra de sonido ofrece un sonido impresionante gracias a un ajuste de precisi\u00f3n para ofrecer lo que el artista pretend\u00eda. Probada y ajustada en en el galardonado iLab de B\u00e9lgica, la barra de sonido ha sido desarrollada por nuestro equipo interno, que cuenta con una amplia experiencia en sonido y experiencias ac\u00fasticas. Equipada con un sistema de barra de sonido de 2.1 canales con subwoofer, la barra de sonido est\u00e1 destinada a mejorar su experiencia de entretenimiento con un sonido impresionante que llena la habitaci\u00f3n. Adem\u00e1s, nuestra barra de sonido viene con tres modos de escucha distintos: pel\u00edcula, m\u00fasica y noticias. Est\u00e1 equipada con Bluetooth para facilitar la transmisi\u00f3n inal\u00e1mbrica.<\/p><p>Puede transmitir su m\u00fasica favorita en cualquier momento conectando su dispositivo inteligente con ella. Puede elegir el montaje en la pared y en el gabinete de la TV para la colocaci\u00f3n. Puede controlarlo con un simple mando a distancia de la barra de sonido o con el mando de su televisor TCL para facilitar su uso y reducir el desorden. Disfruta de una carga y un sonido claro sonido sin distorsi\u00f3n para una experiencia auditiva verdaderamente envolvente.<\/p><br><p><\/p><h2>ESPECIFICACIONES<\/h2><p><\/p><p><\/p><ul><li><b>GENERAL<\/b><\/li><li>Tipo Barra de sonido<\/li><li>Sistema 2.1<\/li><li>Potencia total 200 W<\/li><li><b>AMPLIFICADOR RECEPTOR AV<\/b><\/li><li>Conexiones 1 HDMI-ARC Entrada<\/li><li>Bluetooth 5.1<\/li><li>1 USB 2.0<\/li><li>1 \u00d3ptica<\/li><li>1 Mini Jack 3,5 mm<\/li><li><b>ALTAVOCES<\/b><\/li><li>Sistema Subwoofer Inal\u00e1mbrico<\/li><li><b>DIMENSIONES Y PESO<\/b><\/li><li>Dimensi\u00f3n altavoz central 800 x 70 x 99 mm<\/li><li>Dimensiones Subwoofer 165 x 240 x 298 mm<\/li><li>Peso Subwoofer 2,3 kg<\/li><\/ul><p><\/p><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TCL","supplier":null,"width":null,"height":null,"depth":null,"weight":4.75,"unit_price":71.61,"unit_price_tax":71.61,"tax_rules_group":null,"category":"Altavoces","sub_category":"Barras de sonido","quantity":2,"brand":"TCL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-alt%20s522we_1.jpg"],"wholesale_price":66.61}}},"8720568102672":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8720568102672",false],"wholesale_price":[133.96,false],"price":[138.96,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 6.7",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154318","Cat. IDs: 89,71","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ee0436d5523dcc2323af245deee6e372.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Barra de Sonido con Bluetooth TCL S643WE\/ 240W\/ 2.1","category":"Altavoces","sub_category":"Barras de sonido","unit_price":138.96,"reference":"S643WE","ean13":"8720568102672","weight":"6.7","quantity":2,"brand":"TCL","description_pt":"<h2>Barra de sonido TCL, Barra de sonido TCL S643WE<\/h2><div><p><\/p><ul><li>3.1 canales<\/li><li>Dolby Audio<\/li><li>DTS Virtual:X<\/li><li>HDMI 1.4 s ARC<\/li><li>Bluetooth 5.3<\/li><li>Bass Boost<\/li><li>Ultrafino<\/li><\/ul><p><\/p><\/div><div><h2>Sonido simult\u00e1neo en tiempo real<\/h2><p>Con el canal 3.1, ahora es m\u00e1s sencillo que nunca disfrutar de un&nbsp;<span style='background-color: initial;'>sonido m\u00e1s profundo y rico con el subwoofer inal\u00e1mbrico&nbsp;<\/span><span style='background-color: initial;'>y el refuerzo de graves en el sal\u00f3n, y descubrir la&nbsp;<\/span><span style='background-color: initial;'>profundidad y el detalle del audio.<\/span><\/p><h2>Sonido est\u00e9reo envolvente<\/h2><p>DTS\u00ae Virtual:X&#8482; produce un sonido envolvente&nbsp;<span style='background-color: initial;'>que parece emerger por encima, al lado y detr\u00e1s&nbsp;<\/span><span style='background-color: initial;'>de ti, proporcionando una experiencia envolvente&nbsp;<\/span><span style='background-color: initial;'>en cualquier sala.<\/span><\/p><h2>Saca m\u00e1s partido a tu entretenimiento<\/h2><p>Aumente el impacto de su entretenimiento con el sonido mejorado de Dolby Audio. Ofrece claridad cristalina, di\u00e1logos f\u00e1ciles de escuchar, gran detalle y sonido envolvente realista para que el entretenimiento que te gusta sea a\u00fan mejor.<\/p><h2>Siente la potencia<\/h2><p>Agite su espacio con una potencia de audio de 240 W y d\u00e9jese llevar por la m\u00fasica como nunca antes.<\/p><h2>Mejor experiencia visual con los&nbsp;<span style='background-color: initial;'>modos de sonido optimizados<\/span><\/h2><p>Disfruta siempre de la mejor experiencia de sonido,&nbsp;<span style='background-color: initial;'>ya sea viendo la televisi\u00f3n, jugando o simplemente&nbsp;<\/span><span style='background-color: initial;'>sumergi\u00e9ndote en tu m\u00fasica favorita con la barra de sonido.<\/span><\/p><h2>Conexi\u00f3n sin fisuras<\/h2><p><b>Bluetooth 5.3<\/b><\/p><p>Gracias a la compatibilidad con Bluetooth 5.3, es incre\u00edblemente&nbsp;<span style='background-color: initial;'>f\u00e1cil convertir su barra de sonido en un potente equipo de m\u00fasica.<\/span><\/p><p>Haz que tu m\u00fasica llene el sal\u00f3n y comparte el disfrute con tus&nbsp;<span style='background-color: initial;'>amigos o familiares sin latencia.<\/span><\/p><p><b>HDMI with ARC<\/b><\/p><p>Una conexi\u00f3n de un solo cable con canal de retorno&nbsp;<span style='background-color: initial;'>de audio (ARC) mejorado permite que la barra de sonido&nbsp;<\/span><span style='background-color: initial;'>admita casi todos los formatos de sonido disponibles y&nbsp;<\/span><span style='background-color: initial;'>que el televisor controle la barra de sonido autom\u00e1ticamente.<\/span><\/p><h2>Comodidad al alcance de la mano<\/h2><p>TCL TV Ready est\u00e1 dise\u00f1ado para un control perfecto entre la barra de sonido y el televisor con un solo mando a distancia<\/p><h2>Dise\u00f1o est\u00e9tico que combina&nbsp;<span style='background-color: initial;'>con cualquier entorno<\/span><\/h2><p>Dise\u00f1ado para que su vida digital sea m\u00e1s flexible y est\u00e9&nbsp;<span style='background-color: initial;'>m\u00e1s conectada, integrado a la perfecci\u00f3n en la decoraci\u00f3n&nbsp;<\/span><span style='background-color: initial;'>de su hogar.<\/span><\/p><br><\/div><h2>ESPECIFICACIONES<\/h2><div><p><ul><li><b>Dise\u00f1o<\/b><\/li><li>Tama\u00f1o de la barra<\/li><li>810*62*97.6mm<\/li><li>Teclado<\/li><li>Tecla t\u00e1ctil<\/li><li>Tama\u00f1o del subwoofer<\/li><li>195*320.4*195mm<\/li><li>Pantalla de la barra de sonido<\/li><li>Iluminaci\u00f3n LED<\/li><li><b>Accesorios Incluidos<\/b><\/li><li>Pilas del mando a distancia<\/li><li>si<\/li><li>Mando a distancia<\/li><li>si<\/li><li>HDMI<\/li><li>S\u00ed, excepto la regi\u00f3n de Europa<\/li><li>Cable de alimentaci\u00f3n<\/li><li>S\u00ed, desmontable 1,5 m x 2<\/li><li>Kit de montaje en pared<\/li><li>si<\/li><li><b>Conveniencia<\/b><\/li><li>Software Update<\/li><li>S\u00ed, por USB<\/li><li><b>General<\/b><\/li><li>Procesamiento DTS<\/li><li>DTS Virtual:X<\/li><li>Subwoofer<\/li><li>Inal\u00e1mbrico<\/li><li>Tipo<\/li><li>Series S<\/li><li>Ecualizador<\/li><li>Est\u00e1ndar, Voz, M\u00fasica, Pel\u00edcula, Juego, Deportes.<\/li><li>Potencia m\u00e1xima de salida<\/li><li>240W<\/li><li>SPL (presi\u00f3n sonora)<\/li><li>90dB<\/li><li>Procesamiento Dolby<\/li><li>Dolby Digital(Dolby Audio, DD+)<\/li><li>Canales<\/li><li>3.1<\/li><li>Adaptaci\u00f3n s\u00f3nica AI<\/li><li>No<\/li><li><b>Conectividad<\/b><\/li><li>AUX<\/li><li>Yes<\/li><li>AUX-Voice Assistant<\/li><li>Yes<\/li><li>USB<\/li><li>S\u00ed, admite hasta 64 GB<\/li><li>HDMI 2.1 Features<\/li><li>\/<\/li><li>HDMI<\/li><li>S\u00ed, HDMI ARC<\/li><li>Optical Input<\/li><li>S\u00ed, con funda<\/li><li>WiFi<\/li><li>No<\/li><li>Bluetooth Version<\/li><li>5.3<\/li><li>DTS: Play-Fi<\/li><li>No<\/li><\/ul><\/p><p><\/p><p><\/p><\/div><div><br><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-alt%20s643we_1.jpg","wholesale_price":"133.96","unit_price_tax":138.96},"product_model":{"product_data":{"ean13":["8720568102672"],"reference":"S643WE","name":{"1":"Barra de Sonido con Bluetooth TCL S643WE\/ 240W\/ 2.1","2":"","3":"","4":""},"description":{"1":"<h2>Barra de sonido TCL, Barra de sonido TCL S643WE<\/h2><div><p><\/p><ul><li>3.1 canales<\/li><li>Dolby Audio<\/li><li>DTS Virtual:X<\/li><li>HDMI 1.4 s ARC<\/li><li>Bluetooth 5.3<\/li><li>Bass Boost<\/li><li>Ultrafino<\/li><\/ul><p><\/p><\/div><div><h2>Sonido simult\u00e1neo en tiempo real<\/h2><p>Con el canal 3.1, ahora es m\u00e1s sencillo que nunca disfrutar de un&nbsp;<span style='background-color: initial;'>sonido m\u00e1s profundo y rico con el subwoofer inal\u00e1mbrico&nbsp;<\/span><span style='background-color: initial;'>y el refuerzo de graves en el sal\u00f3n, y descubrir la&nbsp;<\/span><span style='background-color: initial;'>profundidad y el detalle del audio.<\/span><\/p><h2>Sonido est\u00e9reo envolvente<\/h2><p>DTS\u00ae Virtual:X&#8482; produce un sonido envolvente&nbsp;<span style='background-color: initial;'>que parece emerger por encima, al lado y detr\u00e1s&nbsp;<\/span><span style='background-color: initial;'>de ti, proporcionando una experiencia envolvente&nbsp;<\/span><span style='background-color: initial;'>en cualquier sala.<\/span><\/p><h2>Saca m\u00e1s partido a tu entretenimiento<\/h2><p>Aumente el impacto de su entretenimiento con el sonido mejorado de Dolby Audio. Ofrece claridad cristalina, di\u00e1logos f\u00e1ciles de escuchar, gran detalle y sonido envolvente realista para que el entretenimiento que te gusta sea a\u00fan mejor.<\/p><h2>Siente la potencia<\/h2><p>Agite su espacio con una potencia de audio de 240 W y d\u00e9jese llevar por la m\u00fasica como nunca antes.<\/p><h2>Mejor experiencia visual con los&nbsp;<span style='background-color: initial;'>modos de sonido optimizados<\/span><\/h2><p>Disfruta siempre de la mejor experiencia de sonido,&nbsp;<span style='background-color: initial;'>ya sea viendo la televisi\u00f3n, jugando o simplemente&nbsp;<\/span><span style='background-color: initial;'>sumergi\u00e9ndote en tu m\u00fasica favorita con la barra de sonido.<\/span><\/p><h2>Conexi\u00f3n sin fisuras<\/h2><p><b>Bluetooth 5.3<\/b><\/p><p>Gracias a la compatibilidad con Bluetooth 5.3, es incre\u00edblemente&nbsp;<span style='background-color: initial;'>f\u00e1cil convertir su barra de sonido en un potente equipo de m\u00fasica.<\/span><\/p><p>Haz que tu m\u00fasica llene el sal\u00f3n y comparte el disfrute con tus&nbsp;<span style='background-color: initial;'>amigos o familiares sin latencia.<\/span><\/p><p><b>HDMI with ARC<\/b><\/p><p>Una conexi\u00f3n de un solo cable con canal de retorno&nbsp;<span style='background-color: initial;'>de audio (ARC) mejorado permite que la barra de sonido&nbsp;<\/span><span style='background-color: initial;'>admita casi todos los formatos de sonido disponibles y&nbsp;<\/span><span style='background-color: initial;'>que el televisor controle la barra de sonido autom\u00e1ticamente.<\/span><\/p><h2>Comodidad al alcance de la mano<\/h2><p>TCL TV Ready est\u00e1 dise\u00f1ado para un control perfecto entre la barra de sonido y el televisor con un solo mando a distancia<\/p><h2>Dise\u00f1o est\u00e9tico que combina&nbsp;<span style='background-color: initial;'>con cualquier entorno<\/span><\/h2><p>Dise\u00f1ado para que su vida digital sea m\u00e1s flexible y est\u00e9&nbsp;<span style='background-color: initial;'>m\u00e1s conectada, integrado a la perfecci\u00f3n en la decoraci\u00f3n&nbsp;<\/span><span style='background-color: initial;'>de su hogar.<\/span><\/p><br><\/div><h2>ESPECIFICACIONES<\/h2><div><p><ul><li><b>Dise\u00f1o<\/b><\/li><li>Tama\u00f1o de la barra<\/li><li>810*62*97.6mm<\/li><li>Teclado<\/li><li>Tecla t\u00e1ctil<\/li><li>Tama\u00f1o del subwoofer<\/li><li>195*320.4*195mm<\/li><li>Pantalla de la barra de sonido<\/li><li>Iluminaci\u00f3n LED<\/li><li><b>Accesorios Incluidos<\/b><\/li><li>Pilas del mando a distancia<\/li><li>si<\/li><li>Mando a distancia<\/li><li>si<\/li><li>HDMI<\/li><li>S\u00ed, excepto la regi\u00f3n de Europa<\/li><li>Cable de alimentaci\u00f3n<\/li><li>S\u00ed, desmontable 1,5 m x 2<\/li><li>Kit de montaje en pared<\/li><li>si<\/li><li><b>Conveniencia<\/b><\/li><li>Software Update<\/li><li>S\u00ed, por USB<\/li><li><b>General<\/b><\/li><li>Procesamiento DTS<\/li><li>DTS Virtual:X<\/li><li>Subwoofer<\/li><li>Inal\u00e1mbrico<\/li><li>Tipo<\/li><li>Series S<\/li><li>Ecualizador<\/li><li>Est\u00e1ndar, Voz, M\u00fasica, Pel\u00edcula, Juego, Deportes.<\/li><li>Potencia m\u00e1xima de salida<\/li><li>240W<\/li><li>SPL (presi\u00f3n sonora)<\/li><li>90dB<\/li><li>Procesamiento Dolby<\/li><li>Dolby Digital(Dolby Audio, DD+)<\/li><li>Canales<\/li><li>3.1<\/li><li>Adaptaci\u00f3n s\u00f3nica AI<\/li><li>No<\/li><li><b>Conectividad<\/b><\/li><li>AUX<\/li><li>Yes<\/li><li>AUX-Voice Assistant<\/li><li>Yes<\/li><li>USB<\/li><li>S\u00ed, admite hasta 64 GB<\/li><li>HDMI 2.1 Features<\/li><li>\/<\/li><li>HDMI<\/li><li>S\u00ed, HDMI ARC<\/li><li>Optical Input<\/li><li>S\u00ed, con funda<\/li><li>WiFi<\/li><li>No<\/li><li>Bluetooth Version<\/li><li>5.3<\/li><li>DTS: Play-Fi<\/li><li>No<\/li><\/ul><\/p><p><\/p><p><\/p><\/div><div><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TCL","supplier":null,"width":null,"height":null,"depth":null,"weight":6.7,"unit_price":138.96,"unit_price_tax":138.96,"tax_rules_group":null,"category":"Altavoces","sub_category":"Barras de sonido","quantity":2,"brand":"TCL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-alt%20s643we_1.jpg"],"wholesale_price":133.96}}},"0194253826576":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253826576",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154319","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9e06e9eadb55c871cc9fa70547948935.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Ocean Naranja","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREH3TY\/A","ean13":"0194253826576","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<\/b><br>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<br><\/b>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><b>Bot\u00f3n Acci\u00f3n en naranja internacional<br><\/b>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><b>Bot\u00f3n lateral<br><\/b>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/p><p><b>Conjunto de tres micr\u00f3fonos<br><\/b>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/p><p><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/p><p><b>Digital Crown<br><\/b>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;<\/b><b>72 h<\/b><br><span>de uso normal con el modo de bajo consumo<\/span><\/p><p><b>Hasta&nbsp;<\/b><b>17 h<\/b><br><span>de uso entrenando con el modo de bajo consumo<\/span><\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.&nbsp;<\/b>Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mreh3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253826576"],"reference":"MREH3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Ocean Naranja","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<\/b><br>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<br><\/b>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><b>Bot\u00f3n Acci\u00f3n en naranja internacional<br><\/b>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><b>Bot\u00f3n lateral<br><\/b>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/p><p><b>Conjunto de tres micr\u00f3fonos<br><\/b>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/p><p><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/p><p><b>Digital Crown<br><\/b>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;<\/b><b>72 h<\/b><br><span>de uso normal con el modo de bajo consumo<\/span><\/p><p><b>Hasta&nbsp;<\/b><b>17 h<\/b><br><span>de uso entrenando con el modo de bajo consumo<\/span><\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.&nbsp;<\/b>Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mreh3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253827290":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253827290",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154320","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e4b8aaa1fcaf39a0662bdb2fa439127d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Azul S Peque\u00f1a","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREK3TY\/A","ean13":"0194253827290","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<br><\/b>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<br><\/b>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<br><\/b>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<br><\/b>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<br><\/b>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo<\/b>.&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrek3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253827290"],"reference":"MREK3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Azul S Peque\u00f1a","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<br><\/b>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<br><\/b>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<br><\/b>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<br><\/b>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<br><\/b>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo<\/b>.&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrek3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253827658":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253827658",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154321","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/f92f5ed8c8aa7ce2c90cfc1fb58d0cec.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Azul M Mediana","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREP3TY\/A","ean13":"0194253827658","weight":"0","quantity":0,"brand":"APPLE","description_pt":"                                                <p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.\u00a0El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>\u00a0El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>\u00a0Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta\u00a036 h<\/b><br>de uso normal<\/p><p><b>Hasta\u00a072 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta\u00a017 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.\u00a0Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>\u00a0El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>\u00a0El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<br><\/b>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>\u00a0La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.\u00a0Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>\u00a0Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>\u00a0Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>\u00a0Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>\u00a0Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>\u00a0Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>\u00a0Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>\u00a0Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>\u00a0Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>\u00a0En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>\u00a0Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrep3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253827658"],"reference":"MREP3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Azul M Mediana","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.\u00a0El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>\u00a0El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>\u00a0Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta\u00a036 h<\/b><br>de uso normal<\/p><p><b>Hasta\u00a072 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta\u00a017 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.\u00a0Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>\u00a0El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>\u00a0El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<br><\/b>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>\u00a0La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.\u00a0Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>\u00a0Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>\u00a0Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>\u00a0Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>\u00a0Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>\u00a0Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>\u00a0Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>\u00a0Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>\u00a0Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>\u00a0En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>\u00a0Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrep3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253828013":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253828013",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154322","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/bd2bbedf11e898511a3dfe270092505f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Azul L Grande","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREQ3TY\/A","ean13":"0194253828013","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><b><span>Bot\u00f3n Acci\u00f3n en naranja internaciona<\/span><span style='background-color: initial;'>l<\/span><\/b><\/p><p><span style='background-color: initial;'>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<\/span><\/p><p><span><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<br><\/b>de uso normal<\/p><p><b>Hasta&nbsp;72 h<br><\/b>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<br><\/b>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<br><\/b>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<br><\/b>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p>Detecci\u00f3n de ca\u00eddas.&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mreq3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253828013"],"reference":"MREQ3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Azul L Grande","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><b><span>Bot\u00f3n Acci\u00f3n en naranja internaciona<\/span><span style='background-color: initial;'>l<\/span><\/b><\/p><p><span style='background-color: initial;'>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<\/span><\/p><p><span><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<br><\/b>de uso normal<\/p><p><b>Hasta&nbsp;72 h<br><\/b>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<br><\/b>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<br><\/b>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<br><\/b>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p>Detecci\u00f3n de ca\u00eddas.&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mreq3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253828372":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253828372",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154323","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3f6ea4d2de873b68b2499db0cf8aaff0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Indigo S Peque\u00f1a","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MRER3TY\/A","ean13":"0194253828372","weight":"0","quantity":0,"brand":"APPLE","description_pt":"                                                <p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>\u00a0El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>\u00a0El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>\u00a0Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta\u00a036 h<\/b><br>de uso normal<\/p><p><b>Hasta\u00a072 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta\u00a017 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.\u00a0Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>\u00a0El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.\u00a0<\/b>El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<br><\/b>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<br><\/b>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>\u00a0La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.\u00a0Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>\u00a0Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>\u00a0Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>\u00a0Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>\u00a0Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>\u00a0Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>\u00a0Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>\u00a0Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>\u00a0Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>\u00a0En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n<\/b>.\u00a0Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrer3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253828372"],"reference":"MRER3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Indigo S Peque\u00f1a","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>\u00a0El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>\u00a0El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>\u00a0Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta\u00a036 h<\/b><br>de uso normal<\/p><p><b>Hasta\u00a072 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta\u00a017 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.\u00a0Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>\u00a0El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.\u00a0<\/b>El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<br><\/b>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<br><\/b>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>\u00a0La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.\u00a0Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>\u00a0Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>\u00a0Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>\u00a0Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>\u00a0Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>\u00a0Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>\u00a0Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>\u00a0Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>\u00a0Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>\u00a0En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n<\/b>.\u00a0Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrer3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253829096":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253829096",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154324","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/61d964ea2e00eaf01751edbe55480f38.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Indigo L Grande","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREW3TY\/A","ean13":"0194253829096","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La a<span style='font-weight: normal;'>v<\/span>entura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;<\/p><p>El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store<\/b>.&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrew3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253829096"],"reference":"MREW3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Indigo L Grande","2":"","3":"","4":""},"description":{"1":"<p><h2>La a<span style='font-weight: normal;'>v<\/span>entura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;<\/p><p>El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store<\/b>.&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrew3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253829454":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253829454",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154325","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a365bcf2ca54f6dfe80175dff601e6df.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Verde Oliva S Peque\u00f1a","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREX3TY\/A","ean13":"0194253829454","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><span>D\u00edas de autonom\u00eda.&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/span><\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo<\/b>.&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<br><\/b>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrex3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253829454"],"reference":"MREX3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Verde Oliva S Peque\u00f1a","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><span>D\u00edas de autonom\u00eda.&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/span><\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo<\/b>.&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<br><\/b>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrex3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253829812":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253829812",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154326","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fc47efc90bf6dbfeec829da70a2a9885.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Verde Oliva M Mediana","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MREY3TY\/A","ean13":"0194253829812","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital CrownTiene<\/b>&nbsp;<\/p><p>un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><span>D\u00edas de autonom\u00eda.&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/span><\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<br><\/b>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<br><\/b>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p>Llama y env\u00eda mensajes.&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrey3tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253829812"],"reference":"MREY3TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Alpine Verde Oliva M Mediana","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital CrownTiene<\/b>&nbsp;<\/p><p>un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><span>D\u00edas de autonom\u00eda.&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/span><\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<br><\/b>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<br><\/b>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p>Llama y env\u00eda mensajes.&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrey3tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253830535":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253830535",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154327","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a809a529a1b59a0ecaff7ec10825a95c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Naranja\/Beis S\/M","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MRF13TY\/A","ean13":"0194253830535","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf13tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253830535"],"reference":"MRF13TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Naranja\/Beis S\/M","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf13tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253831617":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253831617",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154328","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e031dd44a95b005040b3b3caa30cb9c9.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Verde\/Gris M\/L","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MRF43TY\/A","ean13":"0194253831617","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<\/b><br>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p>Innovaci\u00f3n a fondo.&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf43tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253831617"],"reference":"MRF43TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Verde\/Gris M\/L","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<\/b><br>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p>Innovaci\u00f3n a fondo.&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf43tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253831976":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253831976",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154329","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/42c7e31baabe6acb678d2f5acd694e48.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Azul\/Negro S\/M","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MRF53TY\/A","ean13":"0194253831976","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre<\/b>.&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf53tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253831976"],"reference":"MRF53TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Azul\/Negro S\/M","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo<\/b>.&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.<\/b>&nbsp;Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n.<\/b>&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<\/b><br>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<\/b><br>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre<\/b>.&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf53tybardera_1.jpg"],"wholesale_price":721.09}}},"0194253832331":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194253832331",false],"wholesale_price":[721.09,false],"price":[726.09,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154330","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/207a429c377412e7ee324e63e9635833.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Azul\/Negro M\/L","category":"Apple","sub_category":"Apple Watch","unit_price":726.09,"reference":"MRF63TY\/A","ean13":"0194253832331","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.&nbsp;<\/b>Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n<\/b>.&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<br><\/b>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf63tybardera_1.jpg","wholesale_price":"721.09","unit_price_tax":726.09},"product_model":{"product_data":{"ean13":["0194253832331"],"reference":"MRF63TY\/A","name":{"1":"Apple Watch Ultra 2\/ GPS\/ Cellular\/ 49mm\/ Caja de Titanio\/ Correa Loop Trail Azul\/Negro M\/L","2":"","3":"","4":""},"description":{"1":"<p><h2>La aventura contin\u00faa.<\/h2>El Apple Watch m\u00e1s duro y potente vuelve a pulverizar los l\u00edmites. Lleva el nuevo SiP S9. Estrena una forma m\u00e1gica de interactuar con el reloj sin tocarlo. Luce la pantalla m\u00e1s brillante de Apple. Y ahora viene con combinaciones de cajas y correas neutras en carbono.<br><br><h2>Dise\u00f1o Super\u00advitaminado.<\/h2><h2>Tiene la piel dura.<\/h2><p>El Apple Watch Ultra 2 est\u00e1 pensado para ofrecer un rendimiento bestial. La caja de titanio es ligera, robusta y resistente a la corrosi\u00f3n, con los bordes elevados para proteger el cristal de zafiro de impactos laterales.<\/p><ul><li>Caja de titanio de 49 mm<\/li><li>Resistencia al agua de 100 m<\/li><li>Sometido a pruebas MIL&#8209;STD 810H<\/li><li>Resistencia al polvo IP6X<\/li><\/ul><p>La pantalla m\u00e1s grande y brillante en un Apple Watch. Con la potencia del nuevo SiP S9, la pantalla Retina siempre activa alcanza los 3.000 nits de pico de brillo para que lo veas todo claro, incluso a pleno sol. Si hay poca luz, el brillo baja a 1 nit. Adem\u00e1s, ahora el modo Noche se activa autom\u00e1ticamente cuando est\u00e1 oscuro. La pantalla es tan amplia que tienes espacio para personalizarla seg\u00fan la actividad que practiques. Tambi\u00e9n hay una nueva esfera que muestra junto a los bordes informaci\u00f3n din\u00e1mica, como la altitud, la profundidad o los segundos.<\/p><p><b>Acci\u00f3n y al l\u00edo.<\/b>&nbsp;El bot\u00f3n Acci\u00f3n es personalizable para que puedas controlar r\u00e1pidamente un mont\u00f3n de funciones. Por ejemplo, puedes usarlo para empezar un entreno, marcar puntos de referencia con la Br\u00fajula o iniciar una inmersi\u00f3n. P\u00falsalo y desata todo su potencial. Y el tuyo.<\/p><p><b>Como una navaja suiza.<\/b>&nbsp;El Apple Watch Ultra 2 es una herramienta potente y vers\u00e1til que concentra un mont\u00f3n de prestaciones en un espacio a la medida de tu mu\u00f1eca. M\u00edralo bien, est\u00e1 equipado hasta los dientes.<\/p><p><b>Antena GPS<br><\/b>El GPS de doble frecuencia y alta precisi\u00f3n permite calcular distancias, ritmo y rutas con exactitud.<\/p><p><b>Doble altavoz<\/b><\/p><p>Un segundo altavoz amplifica el volumen de las llamadas y Siri.<br><br><span><b>Bot\u00f3n Acci\u00f3n en naranja internacional<\/b><\/span><\/p><p><span>Personal\u00edzalo para marcar puntos de referencia con la Br\u00fajula, usar la prestaci\u00f3n Retorno, empezar un entreno o iniciar una inmersi\u00f3n. Y mantenlo pulsado para activar la sirena.<br><br><span><b>Bot\u00f3n lateral<\/b><\/span><\/span><\/p><p><span><span>T\u00f3calo para acceder a las prestaciones de seguridad. Mantenlo pulsado para llamar a los servicios de emergencia&#8288;, consultar tus datos m\u00e9dicos o activar la sirena. Sobresale un poco de la caja para que puedas usarlo hasta con guantes.<\/span><\/span><\/p><p><span><b>Conjunto de tres micr\u00f3fonos<\/b><\/span><\/p><p><span>En entornos con mucho viento, un algoritmo adaptativo selecciona el mejor micr\u00f3fono para el audio. El aprendizaje autom\u00e1tico filtra el ruido para que las voces se oigan con la m\u00e1xima claridad.<\/span><\/p><p><span><b>Profund\u00edmetro<\/b><br>Mide la profundidad submarina en tiempo real hasta 40 metros y tambi\u00e9n la temperatura del agua.<\/span><\/p><p><b>Digital Crown<\/b><\/p><p>Tiene un mayor di\u00e1metro y ranuras m\u00e1s pronunciadas para que sea m\u00e1s f\u00e1cil de usar.<\/p><p><b>D\u00edas de autonom\u00eda.&nbsp;<\/b>Cuando llevas dos jornadas con la mochila a cuestas, afrontas la etapa final de un triatl\u00f3n o buceas alrededor de un arrecife de coral, lo \u00faltimo que quieres es quedarte sin bater\u00eda. Pero no te preocupes porque con el Apple Watch Ultra 2 puedes embarcarte en cualquier aventura. Y so\u00f1ar con la siguiente.<\/p><p><b>Hasta&nbsp;36 h<\/b><br>de uso normal<\/p><p><b>Hasta&nbsp;72 h<\/b><br>de uso normal con el modo de bajo consumo<\/p><p><b>Hasta&nbsp;17 h<\/b><br>de uso entrenando con el modo de bajo consumo<\/p><h2>Con la potencia del nuevo SiP S9.<\/h2><p>El Apple Watch Ultra 2 incorpora un chip de Apple a medida que lo hace m\u00e1s r\u00e1pido, potente y f\u00e1cil de usar. La nueva CPU de dos n\u00facleos tiene 5.600 millones de transistores, un 60 % m\u00e1s que la generaci\u00f3n anterior. Un nuevo Neural Engine de cuatro n\u00facleos procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Adem\u00e1s, ahora se pueden utilizar nuevas prestaciones como Siri en el dispositivo, B\u00fasqueda de Precisi\u00f3n para el iPhone y una forma m\u00e1gica de controlar el Apple Watch con un simple gesto de doble toque. No hay duda, nunca has visto algo as\u00ed en un reloj inteligente.<\/p><p>Magia en tus dedos.&nbsp;Controlar el Apple Watch Ultra 2 es tan sencillo que no tienes ni que tocar la pantalla. Por ejemplo, para responder una llamada o poner en pausa un temporizador y reanudarlo, basta con que toques el pulgar con el \u00edndice dos veces. M\u00e1s f\u00e1cil, imposible. Sobre todo cuando llevas la botella de agua en una mano y la barrita energ\u00e9tica en la otra.<\/p><h2>Juntos llegar\u00e9is muy lejos.<\/h2><p>Retomar el h\u00e1bito de correr, completar 10 km o prepararte para un triatl\u00f3n son metas que te ponen a prueba f\u00edsica y mentalmente. El Apple Watch Ultra 2 es tu compa\u00f1ero de entreno perfecto: viene con un mont\u00f3n de prestaciones nuevas que te dar\u00e1n el empuj\u00f3n que necesitas para conseguir tus objetivos.<\/p><h2>Los n\u00fameros ruedan a tu favor.<\/h2><p><b>M\u00e1s datos. M\u00e1s motivaci\u00f3n<\/b>.&nbsp;El Apple Watch Ultra 2 ahora se conecta a potenci\u00f3metros y otros accesorios de ciclismo por Bluetooth. Para ver mejor tu rendimiento, empieza un entreno en bici en tu reloj y al instante aparecer\u00e1 como una actividad en tiempo real en el iPhone. Puedes usar accesorios para enganchar el tel\u00e9fono al manillar y no perder detalle.<\/p><p><b>Zonas de Frecuencia Cardiaca<\/b><br>Comprueba tu nivel de intensidad de un vistazo. Las zonas de entrenamiento se calculan y personalizan de forma autom\u00e1tica a partir de tus datos de salud, o puedes crearlas manualmente.<\/p><p><b>Entreno multideporte<\/b><br>Corre, pedalea y nada en un mismo entrenamiento. La app Entreno detecta autom\u00e1ticamente el cambio de una actividad a otra para que t\u00fa puedas ir a lo tuyo.<\/p><p><b>Compatibilidad con apps de fitness<\/b><br>Como el Apple Watch Ultra 2 es compatible con algunas API de ejercicio personalizadas, apps como TrainingPeaks pueden exportar los entrenamientos que tengas programados a la app Entreno.<\/p><h2>M\u00e9tricas de carrera para exprimir cada segundo.<\/h2><p><b>Entrenos personalizados<\/b><br>Establece los objetivos de tiempo y distancia de los intervalos de un entreno. Y a\u00f1ade calentamientos, enfriamientos e intervalos de recuperaci\u00f3n.<\/p><p><b>M\u00e9tricas de carrera avanzadas<\/b><br>Mide la longitud de zancada, el tiempo de contacto con el suelo y la oscilaci\u00f3n vertical. Entrena para conseguir tiempos concretos con Ritmo Objetivo. O compite contra tus propios registros con Ruta Contrarreloj.<\/p><h2>Detecci\u00f3n de pista<\/h2><p>La app Entreno detecta cuando entras en una pista de atletismo y utiliza los datos tanto de Mapas de Apple como del GPS para calcular con precisi\u00f3n la distancia, el ritmo y la ruta.<\/p><h2>Un GPS para ir muy por delante.<\/h2><p>El rendimiento del GPS es esencial para quienes buscan las m\u00e9tricas m\u00e1s precisas. El Apple Watch Ultra 2 incluye un sistema de GPS de doble frecuencia y alta precisi\u00f3n que lo convierte en el m\u00e1s fiable en un reloj deportivo en entornos urbanos llenos de obst\u00e1culos.<\/p><h2>Un rendimiento de v\u00e9rtigo.<\/h2><p>El Apple Watch Ultra 2 aguanta altitudes, temperaturas y entornos extremos. Es un instrumento de exploraci\u00f3n esencial pensado para llevarte hasta el \u00faltimo conf\u00edn del mundo y traerte a casa de una pieza.<\/p><h2>La br\u00fajula toma una nueva direcci\u00f3n.<\/h2><p>Para adentrarse en territorio desconocido, resulta vital contar con una br\u00fajula fiable. Con las mejoras en la app Br\u00fajula tendr\u00e1s vistas y funciones de orientaci\u00f3n espectaculares en tu mu\u00f1eca.<\/p><h2>Creado para salirse del mapa.<\/h2><p>En el Apple Watch Ultra 2 los mapas ofrecen un nivel de detalle incre\u00edble para adentrarse en la naturaleza. Los nuevos mapas topogr\u00e1ficos muestran en relieve m\u00e1s de 9.000 parques nacionales y regionales de EE. UU., con caracter\u00edsticas del terreno como monta\u00f1as, valles y masas de agua, adem\u00e1s de caminos, curvas de nivel, elevaci\u00f3n y puntos de inter\u00e9s. Y puedes informarte a fondo sobre una ruta para ver su longitud, fotos y otros datos interesantes.<\/p><p><b>M\u00e1s que listo para todo.<\/b>&nbsp;El Apple Watch Ultra 2 es un todoterreno con el que podr\u00e1s desafiar las temperaturas y altitudes m\u00e1s extremas<\/p><p><b>Sirena de 86 decibelios<\/b><br>Mant\u00e9n pulsado el bot\u00f3n Acci\u00f3n para activar una sirena que se oye en un radio de 180 metros.<\/p><p><b>Una linterna con nivel ultra<\/b><br>Ahora puedes usar la linterna con el doble de intensidad de manera temporal con solo girar la Digital Crown.<\/p><p><b>De -20 a 55 \u00b0C<br><\/b>Temperatura de funcionamiento en la mu\u00f1eca, para el fr\u00edo intenso de las cumbres y el calor abrasador de los desiertos.<\/p><p><b>De -500 a 9.000 m<br><\/b>Un rango de altitudes de funcionamiento m\u00e1s amplio, desde los valles m\u00e1s profundos hasta las cumbres m\u00e1s altas.<\/p><h2>Sum\u00e9rgete en el futuro.<\/h2><p>Forjado para aguantar traves\u00edas en moto acu\u00e1tica en Es Vedr\u00e1 o sesiones de windsurf en Pozo Izquierdo, el Apple Watch Ultra 2 viene equipado con profund\u00edmetro. As\u00ed tendr\u00e1s a mano todos los datos y funciones que necesitas para practicar buceo y apnea a profundidades de hasta 40 metros.<\/p><h2>Certificaci\u00f3n EN13319<\/h2><p>Un est\u00e1ndar para accesorios de buceo reconocido internacionalmente.<\/p><h2>Todo un ordenador de buceo.<\/h2><p>Dise\u00f1ada en colaboraci\u00f3n con Huish Outdoors, una empresa puntera de equipamiento submarino, la app Oceanic+ para el Apple Watch Ultra 2 es un aut\u00e9ntico ordenador de buceo para la mu\u00f1eca.11 Podr\u00e1s hacer esn\u00f3rquel, buceo y apnea recreativos a profundidades de hasta 40 metros con todas las funciones necesarias. Pru\u00e9bala, es la mar de f\u00e1cil.<\/p><p><b>Innovaci\u00f3n a fondo.<\/b>&nbsp;La app Profundidad es ideal para registrar la actividad submarina recreativa. Se activa autom\u00e1ticamente cuando te sumerges y muestra la hora, la profundidad en ese momento, la temperatura del agua, el tiempo que has pasado bajo la superficie y la profundidad m\u00e1xima alcanzada. Tambi\u00e9n te da un resumen de toda tu actividad de buceo en el reloj y guarda un registro de cada sesi\u00f3n en la app Fitness del iPhone. As\u00ed tienes un historial completo, con un mapa que refleja la posici\u00f3n de entrada del GPS y una gr\u00e1fica de la inmersi\u00f3n.<\/p><h2>Listo para tus aventuras del d\u00eda a d\u00eda.<\/h2><p>El reloj que desaf\u00eda todos los l\u00edmites tambi\u00e9n tiene prestaciones que te ayudan a llevar una vida sana, segura y conectada.<\/p><h2>Prestaciones de salud avanzadas.<\/h2><p>Seguimiento del sue\u00f1o.&nbsp;Controla tus horas de descanso. Consulta el tiempo que has pasado en las fases de sue\u00f1o REM, esencial o profundo. Y descubre cu\u00e1ntas veces te has despertado.<\/p><p><b>Ox\u00edgeno en Sangre.<\/b>&nbsp;Comprueba cu\u00e1l es tu nivel de ox\u00edgeno en sangre, un indicador clave del estado de salud general.<\/p><h2>Prestaciones de seguridad avanzadas.<\/h2><p><b>Detecci\u00f3n de accidentes.<\/b>&nbsp;Los sensores avanzados y un algoritmo de aprendizaje autom\u00e1tico detectan los accidentes graves de coche y llaman al 112. Adem\u00e1s, el Apple Watch Ultra 2 env\u00eda tu ubicaci\u00f3n a los servicios de emergencia y avisa a los contactos que hayas definido para estos casos.<\/p><p><b>Detecci\u00f3n de ca\u00eddas.<\/b>&nbsp;Si tu reloj detecta que te caes y no respondes, llama a los servicios de emergencia autom\u00e1ticamente, est\u00e9s en casa o de excursi\u00f3n.<\/p><p><b>Emergencia SOS.<\/b>&nbsp;Mant\u00e9n pulsado el bot\u00f3n lateral para avisar r\u00e1pidamente a los servicios m\u00e9dicos y enviarles tu ubicaci\u00f3n. Durante un tiempo, tus contactos de emergencia recibir\u00e1n actualizaciones cada vez que te desplaces.<\/p><h2>Mantente cerca con la conexi\u00f3n m\u00f3vil.<\/h2><p><b>Llama y env\u00eda mensajes.<\/b>&nbsp;Todos los modelos de Apple Watch Ultra 2 vienen con conexi\u00f3n m\u00f3vil. Usa un plan de datos para conectarte pr\u00e1cticamente desde cualquier sitio, aunque no tengas el iPhone cerca. Y con la itinerancia podr\u00e1s utilizarlo tanto en el extranjero como en casa.<\/p><p><b>M\u00fasica.<\/b>&nbsp;Escucha m\u00fasica, podcasts y audiolibros en el gimnasio, en una monta\u00f1a lo bastante alta o en un valle lo bastante profundo.<\/p><p><b>Mapas.<\/b>&nbsp;Con las indicaciones h\u00e1pticas paso a paso ir\u00e1s siempre por el buen camino sin necesidad de mirar el reloj.<\/p><p><b>Apple Pay.<\/b>&nbsp;Paga casi cualquier cosa desde la mu\u00f1eca con Apple Pay y usa la app Cartera para tener siempre las llaves de casa, las del coche y hasta las tarjetas de embarque.<\/p><p><b>App Store.<\/b>&nbsp;En el App Store del Apple Watch hay aplicaciones para casi cualquier deporte o actividad que se te ocurra. Desc\u00e1rgalas en el reloj sin tener que pasar por el iPhone.<\/p><p><b>B\u00fasqueda de Precisi\u00f3n.<\/b>&nbsp;Esta prestaci\u00f3n utiliza un chip de banda ultraancha de segunda generaci\u00f3n para ayudarte a encontrar tu iPhone con indicaciones h\u00e1pticas que te indican a qu\u00e9 distancia aproximada se encuentra y en qu\u00e9 direcci\u00f3n.<\/p><h2>Usa la realidad aumentada para ver el Apple Watch Ultra 2.<\/h2><p>Abre esta p\u00e1gina con Safari en un iPhone o iPad.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":726.09,"unit_price_tax":726.09,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20ultra%20mrf63tybardera_1.jpg"],"wholesale_price":721.09}}},"0195949029820":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195949029820",false],"wholesale_price":[358.93,false],"price":[363.93,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154331","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c01c7161a1220e4379264daae7b24df6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Series 9\/ GPS\/ 41mm\/ Caja de Aluminio Medianoche\/ Correa Deportiva Medianoche S\/M","category":"Apple","sub_category":"Apple Watch","unit_price":363.93,"reference":"MR8W3QL\/A","ean13":"0195949029820","weight":"0","quantity":0,"brand":"APPLE","description_pt":"<p><h2>Una mente m\u00e1s brillante<\/h2><p>El chip m\u00e1s potente jam\u00e1s creado para el Apple Watch. Una nueva forma m\u00e1gica de interactuar con el reloj sin tocarlo. El doble de brillo en la pantalla. Y ahora combinaciones de cajas y correas neutras en carbono.<\/p><p>Nunca subestimes el poder de una mente brillante<\/p><h2>Potencia para&nbsp;ir por delante<\/h2><p>El Apple Watch Series 9 lleva un chip creado a medida por Apple para hacerlo m\u00e1s eficiente, r\u00e1pido y f\u00e1cil de usar. Estrena una CPU de doble n\u00facleo con 5.600 millones de transistores, un 60 % m\u00e1s que el S8. Tambi\u00e9n un Neural Engine de cuatro n\u00facleos, que procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Todo esto, por complicado que suene, hace posible que disfrutar de las nuevas prestaciones sea muy simple: como el gesto de doble toque.<\/p><h2>Innovaci\u00f3n deslumbrante.<\/h2><p>La pantalla avanzada del Series 9 lleva el brillo m\u00e1ximo hasta los 2.000 nits, dos veces m\u00e1s que el Series 8. No solo se ve de lujo a pleno sol, sino que baja a 1 nit cuando hace falta discreci\u00f3n. Perfecto para no dar la nota en el cine.<\/p><h2>Reimaginado.Reluciente.<\/h2><p>El nuevo sistema operativo aprovecha cada mil\u00edmetro de la pantalla del Apple Watch. Casi todas las apps se han redise\u00f1ado para mostrar m\u00e1s informaci\u00f3n de un vistazo. Desde cualquier esfera, solo tienes que girar la Digital Crown para acceder a los widgets del Grupo Inteligente y dar con lo que necesitas. Adem\u00e1s, las prestaciones de salud mental y visual te ayudan a cuidar cuerpo y mente desde la mu\u00f1eca.<\/p><h2>El primer producto Apple neutro en carbono llega puntual<\/h2><p>Gracias a los \u00faltimos avances en materiales, energ\u00eda limpia y m\u00e9todos de env\u00edo menos contaminantes, el Apple Watch ahora est\u00e1 disponible en combinaciones de cajas y correas neutras en carbono.<\/p><h2>Informaci\u00f3n importante de un vistazo<\/h2><p>El Apple Watch te ayuda a entender mejor tu salud mental y f\u00edsica. La seguridad y privacidad de tus datos est\u00e1n garantizadas. Y en el caso de que quieras compartirlos con especialistas, amigos o familiares, ser\u00e1s t\u00fa quien decida qu\u00e9 y con qui\u00e9n.<\/p><h2>Hora de mirar tu coraz\u00f3n<\/h2><p>Comprueba tus pulsaciones con la app Frecuencia Cardiaca y recibe un aviso si est\u00e1n muy por encima o por debajo de los valores normales.<\/p><h2>Mide tu ox\u00edgeno en sangre<\/h2><p>Una innovaci\u00f3n muy alentadora. El Apple Watch Series 9 incorpora una app y un sensor avanzados para que midas tu saturaci\u00f3n de ox\u00edgeno cuando quieras, o de forma autom\u00e1tica a lo largo del d\u00eda y de la noche<\/p><h2>Tiempo para so\u00f1ar<\/h2><p>La app Sue\u00f1o no solo cuenta las horas que duermes. Tambi\u00e9n te dice el tiempo que has pasado en las fases de sue\u00f1o REM, esencial y profundo, y cu\u00e1ntas veces te has despertado. Disfruta de la tierra de los sue\u00f1os.<\/p><p>Registra tu estado de \u00e1nimo<\/p><p>En la app Mindfulness del Apple Watch puedes escoger im\u00e1genes elocuentes para ayudarte a expresar emociones puntuales y tu estado de \u00e1nimo diario. Desarrolla una rutina gracias a las notificaciones y complicaciones de la esfera.<\/p><h2>El tiempo vuela, tu reloj tambi\u00e9n<\/h2><p>Con el Apple Watch en la mu\u00f1eca siempre est\u00e1s en contacto con lo que te importa. Si tienes un modelo con conexi\u00f3n m\u00f3vil, ni siquiera te hace falta llevar el iPhone encima para hacer de todo<\/p><h2>La libertad te llama<\/h2><p>Contesta una llamada desde un puerto de monta\u00f1a. Responde un mensaje mientras haces abdominales. Consulta una notificaci\u00f3n desde el parque. \u00bfY t\u00fa tel\u00e9fono? Pues tan tranquilo en casa.<\/p><p>Escucha m\u00fasica y podcasts<\/p><p>Apple Music tiene millones de canciones para ponerte las pilas.8 Adem\u00e1s, puedes disfrutar de tus podcasts favoritos o entretenerte con un audiolibro<\/p><h2>Pura&nbsp;motivaci\u00f3n.<\/h2><p>\u00bfQu\u00e9 te pide el cuerpo? Tu mu\u00f1eca es una fuente inagotable de entrenamientos. Empieza el que quieras con un toque y personaliza la vista con los datos que necesites para que nada se te haga cuesta arriba. Como resiste lo que le eches, puedes sudar la camiseta o el maillot a fondo. El Apple Watch nunca te abandona.<\/p><h2>Piernas, core o estiramientos<\/h2><p>Este reloj est\u00e1 preparado para todo. Le da lo mismo ejercicios de fuerza o intervalos de alta intensidad que pilates y meditaci\u00f3n. El Apple Watch te ofrece montones de formas de entrenar junto con la informaci\u00f3n m\u00e1s \u00fatil.<\/p><h2>Salud de hierro<\/h2><p>El grosor del vidrio delantero, la geometr\u00eda estructural y la base plana del Apple Watch son el secreto de su gran resistencia. Adem\u00e1s, puedes sumergirte con \u00e9l hasta 50 metros de profundidad.<\/p><h2>Pide ayuda. Es tan f\u00e1cil como llevar tu reloj.<\/h2><p>El Series 9 puede llamar al 112 si has tenido un accidente de coche, has sufrido una ca\u00edda grave o necesitas asistencia urgente.<\/p><h2>Detecci\u00f3n de accidentes<\/h2><p>El Apple Watch Series 9 puede detectar si has sufrido un accidente de coche grave, y autom\u00e1ticamente llama a los servicios de emergencia, les env\u00eda tu ubicaci\u00f3n y avisa a los contactos que hayas definido.<\/p><h2>Detecci\u00f3n de ca\u00eddas<\/h2><p>El Apple Watch Series 9 detecta si has sufrido una ca\u00edda brusca y llama de manera autom\u00e1tica a los servicios de emergencia si no eres capaz de moverte. Esta prestaci\u00f3n est\u00e1 optimizada para la app<\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20mr8w3qlbardera_1.jpg","wholesale_price":"358.93","unit_price_tax":363.93},"product_model":{"product_data":{"ean13":["0195949029820"],"reference":"MR8W3QL\/A","name":{"1":"Apple Watch Series 9\/ GPS\/ 41mm\/ Caja de Aluminio Medianoche\/ Correa Deportiva Medianoche S\/M","2":"","3":"","4":""},"description":{"1":"<p><h2>Una mente m\u00e1s brillante<\/h2><p>El chip m\u00e1s potente jam\u00e1s creado para el Apple Watch. Una nueva forma m\u00e1gica de interactuar con el reloj sin tocarlo. El doble de brillo en la pantalla. Y ahora combinaciones de cajas y correas neutras en carbono.<\/p><p>Nunca subestimes el poder de una mente brillante<\/p><h2>Potencia para&nbsp;ir por delante<\/h2><p>El Apple Watch Series 9 lleva un chip creado a medida por Apple para hacerlo m\u00e1s eficiente, r\u00e1pido y f\u00e1cil de usar. Estrena una CPU de doble n\u00facleo con 5.600 millones de transistores, un 60 % m\u00e1s que el S8. Tambi\u00e9n un Neural Engine de cuatro n\u00facleos, que procesa las tareas de aprendizaje autom\u00e1tico hasta el doble de r\u00e1pido. Todo esto, por complicado que suene, hace posible que disfrutar de las nuevas prestaciones sea muy simple: como el gesto de doble toque.<\/p><h2>Innovaci\u00f3n deslumbrante.<\/h2><p>La pantalla avanzada del Series 9 lleva el brillo m\u00e1ximo hasta los 2.000 nits, dos veces m\u00e1s que el Series 8. No solo se ve de lujo a pleno sol, sino que baja a 1 nit cuando hace falta discreci\u00f3n. Perfecto para no dar la nota en el cine.<\/p><h2>Reimaginado.Reluciente.<\/h2><p>El nuevo sistema operativo aprovecha cada mil\u00edmetro de la pantalla del Apple Watch. Casi todas las apps se han redise\u00f1ado para mostrar m\u00e1s informaci\u00f3n de un vistazo. Desde cualquier esfera, solo tienes que girar la Digital Crown para acceder a los widgets del Grupo Inteligente y dar con lo que necesitas. Adem\u00e1s, las prestaciones de salud mental y visual te ayudan a cuidar cuerpo y mente desde la mu\u00f1eca.<\/p><h2>El primer producto Apple neutro en carbono llega puntual<\/h2><p>Gracias a los \u00faltimos avances en materiales, energ\u00eda limpia y m\u00e9todos de env\u00edo menos contaminantes, el Apple Watch ahora est\u00e1 disponible en combinaciones de cajas y correas neutras en carbono.<\/p><h2>Informaci\u00f3n importante de un vistazo<\/h2><p>El Apple Watch te ayuda a entender mejor tu salud mental y f\u00edsica. La seguridad y privacidad de tus datos est\u00e1n garantizadas. Y en el caso de que quieras compartirlos con especialistas, amigos o familiares, ser\u00e1s t\u00fa quien decida qu\u00e9 y con qui\u00e9n.<\/p><h2>Hora de mirar tu coraz\u00f3n<\/h2><p>Comprueba tus pulsaciones con la app Frecuencia Cardiaca y recibe un aviso si est\u00e1n muy por encima o por debajo de los valores normales.<\/p><h2>Mide tu ox\u00edgeno en sangre<\/h2><p>Una innovaci\u00f3n muy alentadora. El Apple Watch Series 9 incorpora una app y un sensor avanzados para que midas tu saturaci\u00f3n de ox\u00edgeno cuando quieras, o de forma autom\u00e1tica a lo largo del d\u00eda y de la noche<\/p><h2>Tiempo para so\u00f1ar<\/h2><p>La app Sue\u00f1o no solo cuenta las horas que duermes. Tambi\u00e9n te dice el tiempo que has pasado en las fases de sue\u00f1o REM, esencial y profundo, y cu\u00e1ntas veces te has despertado. Disfruta de la tierra de los sue\u00f1os.<\/p><p>Registra tu estado de \u00e1nimo<\/p><p>En la app Mindfulness del Apple Watch puedes escoger im\u00e1genes elocuentes para ayudarte a expresar emociones puntuales y tu estado de \u00e1nimo diario. Desarrolla una rutina gracias a las notificaciones y complicaciones de la esfera.<\/p><h2>El tiempo vuela, tu reloj tambi\u00e9n<\/h2><p>Con el Apple Watch en la mu\u00f1eca siempre est\u00e1s en contacto con lo que te importa. Si tienes un modelo con conexi\u00f3n m\u00f3vil, ni siquiera te hace falta llevar el iPhone encima para hacer de todo<\/p><h2>La libertad te llama<\/h2><p>Contesta una llamada desde un puerto de monta\u00f1a. Responde un mensaje mientras haces abdominales. Consulta una notificaci\u00f3n desde el parque. \u00bfY t\u00fa tel\u00e9fono? Pues tan tranquilo en casa.<\/p><p>Escucha m\u00fasica y podcasts<\/p><p>Apple Music tiene millones de canciones para ponerte las pilas.8 Adem\u00e1s, puedes disfrutar de tus podcasts favoritos o entretenerte con un audiolibro<\/p><h2>Pura&nbsp;motivaci\u00f3n.<\/h2><p>\u00bfQu\u00e9 te pide el cuerpo? Tu mu\u00f1eca es una fuente inagotable de entrenamientos. Empieza el que quieras con un toque y personaliza la vista con los datos que necesites para que nada se te haga cuesta arriba. Como resiste lo que le eches, puedes sudar la camiseta o el maillot a fondo. El Apple Watch nunca te abandona.<\/p><h2>Piernas, core o estiramientos<\/h2><p>Este reloj est\u00e1 preparado para todo. Le da lo mismo ejercicios de fuerza o intervalos de alta intensidad que pilates y meditaci\u00f3n. El Apple Watch te ofrece montones de formas de entrenar junto con la informaci\u00f3n m\u00e1s \u00fatil.<\/p><h2>Salud de hierro<\/h2><p>El grosor del vidrio delantero, la geometr\u00eda estructural y la base plana del Apple Watch son el secreto de su gran resistencia. Adem\u00e1s, puedes sumergirte con \u00e9l hasta 50 metros de profundidad.<\/p><h2>Pide ayuda. Es tan f\u00e1cil como llevar tu reloj.<\/h2><p>El Series 9 puede llamar al 112 si has tenido un accidente de coche, has sufrido una ca\u00edda grave o necesitas asistencia urgente.<\/p><h2>Detecci\u00f3n de accidentes<\/h2><p>El Apple Watch Series 9 puede detectar si has sufrido un accidente de coche grave, y autom\u00e1ticamente llama a los servicios de emergencia, les env\u00eda tu ubicaci\u00f3n y avisa a los contactos que hayas definido.<\/p><h2>Detecci\u00f3n de ca\u00eddas<\/h2><p>El Apple Watch Series 9 detecta si has sufrido una ca\u00edda brusca y llama de manera autom\u00e1tica a los servicios de emergencia si no eres capaz de moverte. Esta prestaci\u00f3n est\u00e1 optimizada para la app<\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":363.93,"unit_price_tax":363.93,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20mr8w3qlbardera_1.jpg"],"wholesale_price":358.93}}},"0195949029936":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195949029936",false],"wholesale_price":[358.93,false],"price":[363.93,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:154332","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/546c64201a9d9b53a449f624306ec0bd.jpg; <br>---------------------