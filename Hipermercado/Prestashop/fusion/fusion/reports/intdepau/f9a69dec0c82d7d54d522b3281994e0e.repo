:"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":9.25,"unit_price":380,"unit_price_tax":380,"tax_rules_group":null,"category":"Monitores","sub_category":"Monitores","quantity":0,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-m%20s32cm703uu_1.jpg"],"wholesale_price":375}}},"0196786388484":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0196786388484",false],"wholesale_price":[351.07,false],"price":[356.07,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 21",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:192014","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/aef1a37a2e1e10ae7c43d582c7e6584d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Multifunci\u00f3n L\u00e1ser Color HP Laserjet Pro MFP 3302SDW WiFi\/ D\u00faplex\/ Blanca","category":"Multifunciones  e Impresoras","sub_category":"Multifunciones","unit_price":356.07,"reference":"499Q6F","ean13":"0196786388484","weight":"21","quantity":0,"brand":"HP","description_pt":"                                                <p><\/p><h2>Impresora multifunci\u00f3n HP Color LaserJet Pro 3302sdw (499Q6F)<\/h2>Dise\u00f1ado para equipos de trabajo empresariales que necesitan un rendimiento profesional con impresi\u00f3n en color a doble cara r\u00e1pida y de alta calidad con escaneo y copia, adem\u00e1s de una confiabilidad galardonada en un dise\u00f1o compacto.<br><br><ul>  <li>Funciones: Imprimir, copiar, escanear<\/li>  <li>Velocidad de impresi\u00f3n: Velocidad de impresi\u00f3n de hasta 25 ppm (negro) y 25 ppm (color)<\/li>  <li>Calidad de impresi\u00f3n en negro (\u00f3ptima): Hasta 600 x 600 ppp<\/li>  <li>Capacidad del alimentador autom\u00e1tico de documentos: Est\u00e1ndar, 50 hojas<\/li><\/ul><h2>Color y velocidad profesionales <\/h2><p>Impresi\u00f3n en color autom\u00e1tica a doble cara de alta velocidad con escaneo y copia.<\/p><h2>Tranquilidad con confiabilidad galardonada<\/h2><p>Rendimiento con el que puede contar p\u00e1gina tras p\u00e1gina<\/p><h2>Seguridad de nivel profesional para ayudar a proteger su negocio<\/h2><p>Proteja sus datos y documentos con HP Wolf Pro Security.<\/p><h2>Dise\u00f1o compacto y energ\u00e9ticamente eficiente<\/h2><p>Tama\u00f1o compacto con tecnolog\u00eda de ahorro de energ\u00eda para optimizar el uso de la energ\u00eda.<\/p><h2>Soluci\u00f3n de equipo empresarial<\/h2><p>Apoye a su equipo de trabajo empresarial con esta impresora l\u00e1ser compacta para impresiones, escaneos y copias en color <\/p><h2>Incre\u00edblemente r\u00e1pidos y de alta calidad.<\/h2><p>Impresi\u00f3n en color r\u00e1pida y autom\u00e1tica a dos caras en una sola pasada, adem\u00e1s de escaneo y copia<br>Experimente la impresi\u00f3n autom\u00e1tica en color a doble cara de alta velocidad de hasta 26 p\u00e1ginas por minuto, adem\u00e1s de escaneo y copia.<\/p><h2>Colores realistas<\/h2><p>D\u00e9 vida a su negocio con el t\u00f3ner HP TerraJet de \u00faltima generaci\u00f3n dise\u00f1ado para ofrecer colores m\u00e1s realistas y vibrantes.<\/p><h2>Dise\u00f1o compacto<\/h2><p>Optimice su espacio de trabajo, reduzca el desorden y ayude a aumentar la eficiencia de su equipo con una impresora l\u00e1ser compacta.<\/p><h2>Funciones de productividad avanzadas<\/h2><p>Cree una cuenta HP para maximizar la productividad con funciones avanzadas.<\/p><h2>HP Web Jetadmin<\/h2><p>Centraliza la gesti\u00f3n de tu impresora. HP Web Jetadmin agrega y actualiza f\u00e1cilmente dispositivos, soluciones y pol\u00edticas.<\/p><h2>Impresi\u00f3n confiable<\/h2><p>Mant\u00e9ngase centrado en su negocio: la confiabilidad galardonada significa menos tiempo de inactividad para el mantenimiento de la impresora. <\/p><h2>Wi-Fi\u00ae confiable<\/h2><p>Mantenga su negocio conectado con Wi-Fi\u00ae confiable que se reconecta autom\u00e1ticamente para permanecer en l\u00ednea.<\/p><p><\/p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Funciones<\/li>  <li>Imprimir, copiar, escanear<\/li>  <li>Velocidad de impresi\u00f3n en negro (ISO, carta)<\/li>  <li>Hasta 26 ppm  <\/li><li>Velocidad de impresi\u00f3n en negro (ISO, A4)<\/li>  <li>Hasta 25 ppm  <\/li><li>Velocidad de impresi\u00f3n en color (ISO)<\/li>  <li>Hasta 26 ppm  <\/li><li>Velocidad de impresi\u00f3n Color (ISO)<\/li>  <li>Hasta 25 ppm  <\/li><li>Primera p\u00e1gina impresa en negro (carta, lista)<\/li>  <li>Tan r\u00e1pido como 10,8 segundos ( Medido seg\u00fan ISO\/IEC 17629. Para obtener m\u00e1s informaci\u00f3n, consulte https:\/\/www.hp.com\/go\/printerclaims . La velocidad exacta var\u00eda seg\u00fan la configuraci\u00f3n del sistema, la aplicaci\u00f3n de software, el controlador y la complejidad del documento).<\/li>  <li>Primera p\u00e1gina impresa en negro (A4, lista)<\/li>  <li>Tan r\u00e1pido como 10,9 segundos\u00a0 ( Medido seg\u00fan ISO\/IEC 17629. Para obtener m\u00e1s informaci\u00f3n, consulte https:\/\/www.hp.com\/go\/printerclaims . La velocidad exacta var\u00eda seg\u00fan la configuraci\u00f3n del sistema, la aplicaci\u00f3n de software, el controlador y la complejidad del documento).<\/li>  <li>Color de salida de la primera p\u00e1gina (carta, listo)<\/li>  <li>Tan r\u00e1pido como 10,9 segundos ( Medido seg\u00fan ISO\/IEC 17629. Para obtener m\u00e1s informaci\u00f3n, consulte https:\/\/www.hp.com\/go\/printerclaims . La velocidad exacta var\u00eda seg\u00fan la configuraci\u00f3n del sistema, la aplicaci\u00f3n de software, el controlador y la complejidad del documento).<\/li>  <li>Color de la primera p\u00e1gina (A4, listo)<\/li>  <li>Tan r\u00e1pido como 11,0 segundos ( Medido seg\u00fan ISO\/IEC 17629. Para obtener m\u00e1s informaci\u00f3n, consulte https:\/\/www.hp.com\/go\/printerclaims . La velocidad exacta var\u00eda seg\u00fan la configuraci\u00f3n del sistema, la aplicaci\u00f3n de software, el controlador y la complejidad del documento).<\/li>  <li>Impresi\u00f3n a doble cara<\/li>  <li>Autom\u00e1tico<\/li>  <li>Ciclo de trabajo (mensual, carta)<\/li>  <li>Hasta 40.000 p\u00e1ginasHasta 40.000 p\u00e1ginas ( El ciclo de trabajo se define como el n\u00famero m\u00e1ximo de p\u00e1ginas por mes de salida de im\u00e1genes. Este valor proporciona una comparaci\u00f3n de la solidez del producto en relaci\u00f3n con otros dispositivos HP LaserJet o HP Color LaserJet y permite la implementaci\u00f3n adecuada de impresoras y MFP para satisfacer las demandas de individuos o grupos conectados).<\/li>  <li>Ciclo de trabajo (mensual, A4)<\/li>  <li>Hasta 40.000 p\u00e1ginas\u00a0 ( El ciclo de trabajo se define como el n\u00famero m\u00e1ximo de p\u00e1ginas por mes de salida de im\u00e1genes. Este valor proporciona una comparaci\u00f3n de la solidez del producto en relaci\u00f3n con otros dispositivos HP LaserJet o HP Color LaserJet y permite la implementaci\u00f3n adecuada de impresoras y MFP para satisfacer las demandas de individuos o grupos conectados).<\/li>  <li>Volumen de p\u00e1ginas mensual recomendado<\/li>  <li>150 a 2.500 4 ( 4HP recomienda que la cantidad de p\u00e1ginas por mes de salida de im\u00e1genes est\u00e9 dentro del rango indicado para un rendimiento \u00f3ptimo del dispositivo, seg\u00fan factores que incluyen los intervalos de reemplazo de consumibles y la vida \u00fatil del dispositivo durante un per\u00edodo de garant\u00eda extendido).<\/li>  <li>Calidad de impresi\u00f3n en negro (\u00f3ptima)<\/li>  <li>Hasta 600 x 600 ppp<\/li>  <li>Color de calidad de impresi\u00f3n (\u00f3ptima)<\/li>  <li>Hasta 600 x 600 ppp<\/li>  <li>Idiomas de impresi\u00f3n<\/li>  <li>HP PCL6, PostScript, HP PCL5, PDF, URF, PWG-Raster, PCLM, JPEG<\/li>  <li>Tecnolog\u00eda de impresi\u00f3n<\/li>  <li>L\u00e1ser<\/li>  <li>Conectividad, est\u00e1ndar<\/li>  <li>1 red Gigabit Ethernet 10\/100\/1000 Base-TX; 1 USB 2.0 de alta velocidad (dispositivo); 1 USB 2.0 de alta velocidad (anfitri\u00f3n); 1 Wi-Fi 802.11ac (doble banda); Ethernet de cruce autom\u00e1tico<\/li>  <li>Capacidad de impresi\u00f3n m\u00f3vil<\/li>  <li>Aplicaci\u00f3n HP Smart; Apple AirPrint&#8482;; Aplicaciones m\u00f3viles; Certificado Mopria&#8482;; Impresi\u00f3n directa Wi-Fi\u00ae<\/li>  <li>Capacidades de red<\/li>  <li>Ethernet 10\/100\/1000Base-TX integrado, Gigabit; Ethernet de cruce autom\u00e1tico; Autenticaci\u00f3n v\u00eda 802.1X<\/li>  <li>Capacidad inal\u00e1mbrica<\/li>  <li>Wi-Fi de doble banda incorporado; Autenticaci\u00f3n v\u00eda WEP, WPA\/WPA2, WPA Enterprise; Cifrado mediante AES o TKIP; WPS; Wi-Fi directo<\/li>  <li>Requisitos m\u00ednimos del sistema para Macintosh<\/li>  <li>Apple\u00ae macOS 12.0 Monterey; MacOS 13.0 Ventura; macOS v14 Sonoma; 2 GB de alta definici\u00f3n; Se requiere Internet<\/li>  <li>Requerimientos m\u00ednimos del sistema<\/li>  <li>Microsoft\u00ae Windows\u00ae 11, 10: 32 bits o 64 bits, 2 GB de espacio disponible en el disco duro, conexi\u00f3n a Internet<\/li>  <li>Funciones est\u00e1ndar de env\u00edo digital<\/li>  <li>Escanear a correo electr\u00f3nico, Escanear a carpeta de red, Escanear a Sharepoint, Escanear a USB, Escanear a computadora<\/li>  <li>Pantalla<\/li>  <li>Pantalla TFT retroiluminada en color de 4,3' en diagonal (480 x 272)<\/li>  <li>Velocidad del procesador<\/li>  <li>1,2 GHz<\/li>  <li>Memoria m\u00e1xima<\/li>  <li>512 MB  <\/li><li>Memoria<\/li>  <li>512 MB  <\/li><li>Almacenamiento<\/li>  <li>F