lse],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.38",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:265610","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/475c3c555e372ddd2405e5d9da9a429f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Bullpadel Black Dragon 4.0\/ Negro y Verde","category":"PADEL","sub_category":"Padel","unit_price":54.06,"reference":"BLK DRA 4","ean13":"8445402201440","weight":"0.38","quantity":5,"brand":"BULLPADEL","description_pt":"                                                <p><h2>\u00bfPor qu\u00e9 comprar la pala de p\u00e1del Black Dragon 4.0 unisex?<\/h2><p>Es una pala de p\u00e1del de balance bajo con un punto dulce muy amplio. Estos dos factores la hacen f\u00e1cil de manejar al buscar la ejecuci\u00f3n de efectos precisos. El agujereado se extiende a la mayor parte de las caras para otorgarle ligereza y simplificar la obtenci\u00f3n de remates bien colocados.<\/p><h2>\u00bfPara qu\u00e9 tipo de jugador es la pala de p\u00e1del Black Dragon 4.0 unisex?<\/h2><p>Es para mujeres y hombres adultos que juegan al p\u00e1del continuamente y requieren una pala ligera que les permita desplegar un estilo de control.<\/p><h2>Dise\u00f1o y colores<\/h2><p>Tiene forma redonda. El marco y las caras presentan una tonalidad negro. Sobre el centro de los planos aparece con un cromatismo la 'B' t\u00edpica de Bullpadel. Sobre el costado derecho de los dos haces aparece la leyenda 'BLACK DRAGON' con caracteres peque\u00f1os.<\/p><h2>Caracter\u00edsticas t\u00e9cnicas de la pala de p\u00e1del Black Dragon 4.0 unisex<\/h2><p><ul><li>El marco est\u00e1 compuesto de una fibra de vidrio de alta dureza. Esto le otorga una resistencia total a un uso muy brusco.<\/li><li>Las caras incluyen un terminado texturizado con estructura de panal para favorecer un enganche \u00f3ptimo de la pelota y efectuar saques muy veloces.<\/li><li>El n\u00facleo es de goma EVA ultrablanda aporta una recuperaci\u00f3n r\u00e1pida y a\u00f1ade comodidad al golpeo<\/li><li>El acabado ultrarreforzado del puente soporta sin deterioros los impactos m\u00e1s intensos contra las paredes de la pista.<\/li><li>La empu\u00f1adura de agarre s\u00f3lido incluye un grip muy absorbente que mantiene seca la mano a lo largo de cada encuentro.<\/li><\/ul><\/p><h2>Especificaciones<\/h2><div><p><ul><li><b>Marca\u00a0<\/b><\/li><li>Bullpadel<\/li><li><b>Color\u00a0<\/b><\/li><li>Negro<\/li><li><b>Color\u00a0<span style='background-color: initial;'>2\u00a0<\/span><\/b><\/li><li><span style='background-color: initial;'>Negro<\/span><\/li><li><b>Producto\u00a0<\/b><\/li><li>Palas<\/li><li><b>Balance\u00a0<\/b><\/li><li>Bajo<\/li><li><b>N\u00facleo\u00a0<\/b><\/li><li>Soft Eva<\/li><li><b>Cara\u00a0<\/b><\/li><li>Fibra De Vidrio<\/li><li><b>Formato\u00a0<\/b><\/li><li>Normal<\/li><li><b>Nivel de Juego\u00a0<\/b><\/li><li>Avanzado \/ Competici\u00f3n<\/li><li><b>Acabado\u00a0<\/b><\/li><li>Relieve 3d<\/li><li><b>Forma\u00a0<\/b><\/li><li>Redonda<\/li><li><b>Superf\u00edcie\u00a0<\/b><\/li><li>Rugosa<\/li><li><b>Jugador\u00a0<\/b><\/li><li>Hombre, Mujer<\/li><\/ul><\/p><\/div><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bup-pala%20pad%20blk%20dra%204_1.jpg","wholesale_price":"47.06","unit_price_tax":54.06},"product_model":{"product_data":{"ean13":["8445402201440"],"reference":"BLK DRA 4","name":{"1":"Pala de P\u00e1del Bullpadel Black Dragon 4.0\/ Negro y Verde","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>\u00bfPor qu\u00e9 comprar la pala de p\u00e1del Black Dragon 4.0 unisex?<\/h2><p>Es una pala de p\u00e1del de balance bajo con un punto dulce muy amplio. Estos dos factores la hacen f\u00e1cil de manejar al buscar la ejecuci\u00f3n de efectos precisos. El agujereado se extiende a la mayor parte de las caras para otorgarle ligereza y simplificar la obtenci\u00f3n de remates bien colocados.<\/p><h2>\u00bfPara qu\u00e9 tipo de jugador es la pala de p\u00e1del Black Dragon 4.0 unisex?<\/h2><p>Es para mujeres y hombres adultos que juegan al p\u00e1del continuamente y requieren una pala ligera que les permita desplegar un estilo de control.<\/p><h2>Dise\u00f1o y colores<\/h2><p>Tiene forma redonda. El marco y las caras presentan una tonalidad negro. Sobre el centro de los planos aparece con un cromatismo la 'B' t\u00edpica de Bullpadel. Sobre el costado derecho de los dos haces aparece la leyenda 'BLACK DRAGON' con caracteres peque\u00f1os.<\/p><h2>Caracter\u00edsticas t\u00e9cnicas de la pala de p\u00e1del Black Dragon 4.0 unisex<\/h2><p><ul><li>El marco est\u00e1 compuesto de una fibra de vidrio de alta dureza. Esto le otorga una resistencia total a un uso muy brusco.<\/li><li>Las caras incluyen un terminado texturizado con estructura de panal para favorecer un enganche \u00f3ptimo de la pelota y efectuar saques muy veloces.<\/li><li>El n\u00facleo es de goma EVA ultrablanda aporta una recuperaci\u00f3n r\u00e1pida y a\u00f1ade comodidad al golpeo<\/li><li>El acabado ultrarreforzado del puente soporta sin deterioros los impactos m\u00e1s intensos contra las paredes de la pista.<\/li><li>La empu\u00f1adura de agarre s\u00f3lido incluye un grip muy absorbente que mantiene seca la mano a lo largo de cada encuentro.<\/li><\/ul><\/p><h2>Especificaciones<\/h2><div><p><ul><li><b>Marca\u00a0<\/b><\/li><li>Bullpadel<\/li><li><b>Color\u00a0<\/b><\/li><li>Negro<\/li><li><b>Color\u00a0<span style='background-color: initial;'>2\u00a0<\/span><\/b><\/li><li><span style='background-color: initial;'>Negro<\/span><\/li><li><b>Producto\u00a0<\/b><\