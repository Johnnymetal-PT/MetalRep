:[152.06,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.29",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:221561","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b41d41570471d363d6879c032a3ac90a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Adidas Metalbone Carbon Control 2024\/ Negra","category":"PADEL","sub_category":"Padel","unit_price":152.06,"reference":"MTLB C CTRL 24","ean13":"8436548248949","weight":"0.29","quantity":2,"brand":"ADIDAS","description_pt":"                                                <h2>Metalbone Carbon Ctrl<\/h2><div>La precisi\u00f3n y la potencia, al m\u00e1ximo nivel. Logra los golpes que buscas, sean los que sean, con esta pala diferencial.\u00a0La METALBONE CARBON CTRL es una pala con una esencia para el juego de control. Sin embargo, sus caracter\u00edsticas la permiten brillar en cualquier situaci\u00f3n. El jugador profesional adidas Pol Hern\u00e1ndez empu\u00f1a esta pala, lo que demuestra sus altas prestaciones. Las tecnolog\u00edas Octagonal Structure y Structural Reinforcement, en el marco, ofrecen una alta rigidez. La forma redonda de la cabeza y la goma EVA Soft Performance, menos r\u00edgida, centran el punto dulce y aportan una mayor salida de bola. Los efectos se generan con facilidad gracias a las tecnolog\u00edas Spin Blade Decal y Smart Holes Curve. La superficie de la pala est\u00e1 compuesta por la fibra Carbon Fiber 6K, un material r\u00edgido id\u00f3neo para toda clase de golpes.<br><\/div><div><h2>OCTAGONAL STRUCTURE<\/h2><p>La m\u00e1xima rigidez nace del interior. Esta tecnolog\u00eda dispone una estructura tubular en secci\u00f3n octogonal en el marco de la pala que la dota de una gran consistencia. Su resistencia a la torsi\u00f3n es alt\u00edsima, con lo que los golpes m\u00e1s potentes est\u00e1n garantizados.<\/p><h2>SPIN BLADE DECAL<\/h2><p>Esta tecnolog\u00eda cubre las caras de la pala con una superficie rugosa con una alta capacidad de agarre. La fricci\u00f3n con la bola es total, con lo que los efectos nacen con una facilidad pasmosa.<\/p><h2>SMART HOLES CURVE<\/h2><p>Su disposici\u00f3n de los agujeros en forma curva est\u00e1 optimizada para que la trayectoria que sigue la pala en los golpes que buscan efectos genere una mayor fricci\u00f3n con los orificios para alcanzar resultados mucho m\u00e1s notorios.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li>Nivel: Avanzado<\/li><li>Tipo de juego: Control<\/li><li>Forma: Redonda<\/li><li>Balance: Even (265 mm)<\/li><li>Peso: 360-375gr<\/li><li>Superficie: 485 cm2<\/li><li>Longitud: 455 mm<\/li><li>Grosor: 38 mm<\/li><li>Protector: Metalbone Protector Tape<\/li><li>Goma : Eva Soft Performance<\/li><li>Fibra: Carbon 6k<\/li><li>Poder: Octagonal Structure<\/li><li>Durabilidad: Structural Reinforcement<\/li><li>Efectos: Spin Blade Decal<\/li><li>Efectos 2: Smart Holes Curve<\/li><li>Personalizaci\u00f3n: No<\/li><li>Modelo: Metalbone<\/li><li>Colecci\u00f3n: 2024<\/li><li>Punto dulce: Centro<\/li><\/ul><\/p><\/div>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_adi-pala%20pad%20mtlb%20c%20ctrl%2024_1.jpg","wholesale_price":"147.06","unit_price_tax":152.06},"product_model":{"product_data":{"ean13":["8436548248949"],"reference":"MTLB C CTRL 24","name":{"1":"Pala de P\u00e1del Adidas Metalbone Carbon Control 2024\/ Negra","2":"","3":"","4":""},"description":{"1":"                                                <h2>Metalbone Carbon Ctrl<\/h2><div>La precisi\u00f3n y la potencia, al m\u00e1ximo nivel. Logra los golpes que buscas, sean los que sean, con esta pala diferencial.\u00a0La METALBONE CARBON CTRL es una pala con una esencia para el juego de control. Sin embargo, sus caracter\u00edsticas la permiten brillar en cualquier situaci\u00f3n. El jugador profesional adidas Pol Hern\u00e1ndez empu\u00f1a esta pala, lo que demuestra sus altas prestaciones. Las tecnolog\u00edas Octagonal Structure y Structural Reinforcement, en el marco, ofrecen una alta rigidez. La forma redonda de la cabeza y la goma EVA Soft Performance, menos r\u00edgida, centran el punto dulce y aportan una mayor salida de bola. Los efectos se generan con facilidad gracias a las tecnolog\u00edas Spin Blade Decal y Smart Holes Curve. La superficie de la pala est\u00e1 compuesta por la fibra Carbon Fiber 6K, un material r\u00edgido id\u00f3neo para toda clase de golpes.<br><\/div><div><h2>OCTAGONAL STRUCTURE<\/h2><p>La m\u00e1xima rigidez nace del interior. Esta tecnolog\u00eda dispone una estructura tubular en secci\u00f3n octogonal en el marco de la pala que la dota de una gran consistencia. Su resistencia a la torsi\u00f3n es alt\u00edsima, con lo que los golpes m\u00e1s potentes est\u00e1n garantizados.<\/p><h2>SPIN BLADE DECAL<\/h2><p>Esta tecnolog\u00eda cubre las caras de la pala con una superficie rugosa con una alta capacidad de agarre. La fricci\u00f3n con la bola es total, con lo que los efectos nacen con una facilidad pasmosa.<\/p><h2>SMART HOLES CURVE<\/h2><p>Su disposici\u00f3n de los agujeros en forma curva est\u00e1 optimizada para que la trayectoria que sigue la pala en los golpes que buscan efectos genere una mayor fricci\u00f3n con los orificios para alcanzar resultados mucho m\u00e1s notorios.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li>Nivel: Avanzado<\/li><li>Tipo de juego: Control<\/li><li>Forma: Redonda<\/li><li>Balance: Even (265 mm)<\/li><li>Peso: 360-375gr<\/li><li>Superficie: 485 cm2<\/li><li>Longitud: 455 mm<\/li><li>Grosor: 38 mm<\/li><li>Protector: Metalbone Protector Tape<\/li><li>Goma : Eva Soft Performance<\/li><li>Fibra: Carbon 6k<\/li><li>Poder: Octagonal Structure<\/li><li>Durabilidad: Structural Reinforcement<\/li><li>Efectos: Spin Blade Decal<\/li><li>Efectos 2: Smart Holes Curve<\/li><li>Personalizaci\u00f3n: No<\/li><li>Modelo: Metalbone<\/li><li>Colecci\u00f3n: 2024<\/li><li>Punto dulce: Centro<\/li><\/ul><\/p><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ADIDAS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.29,"unit_price":152.06,"unit_price_tax":152.06,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":2,"brand":"ADIDAS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_adi-pala%20pad%20mtlb%20c%20ctrl%2024_1.jpg"],"wholesale_price":147.06}}},"8436548248932":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436548248932",false],"wholesale_price":[152.95,false],"price":[157.95,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.38",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:221562","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8f970b270ba0a6c2513887b71b056c39.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Adidas Metalbone Carbon 3.3 2024\/ Negra","category":"PADEL","sub_category":"Padel","unit_price":157.95,"reference":"MTLB CRB 3 3 24","ean13":"8436548248932","weight":"0.38","quantity":2,