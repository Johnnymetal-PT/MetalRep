13":"3086123589551","weight":"0.06","quantity":5,"brand":"BIC","description_pt":"                                                <p><\/p><h2>BIC Intensity Dual Tip<\/h2><p>BIC Intensity Dual Tip Rotuladores y Marcadores Pincel - Varios Colores<\/p><p>6 rotuladores de colores para adultos BIC Intensity Dual Tip que te har\u00e1n dudar sobre qu\u00e9 extremo est\u00e1 arriba. Son una combinaci\u00f3n de una punta de pincel en un extremo y un marcador fino en el otro. Utiliza la duradera punta de pincel modulable para ajustar el grosor al colorear zonas grandes o en proyectos de caligraf\u00eda. Gira estos rotuladores y prueba la punta fina para crear l\u00edneas de 0,7 mm y escribir y colorear los detalles m\u00e1s peque\u00f1os. Disfruta de una tinta con base de agua en 6 vivos y luminosos colores. Destaca las partes importantes de tus notas o decora tus libretas y diarios personales haciendo caligraf\u00eda, garabatos o esbozos.<\/p><h2>Especificaciones<\/h2><ul><li>Punto tipogr\u00e1fico &#8206;Fino y Punta de Pincel<\/li><li>Tama\u00f1o de l\u00ednea&#8206; 0.7-0.9<\/li><li>Tinta con base de agua<\/li><\/ul><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bic-rotu%20intensity%20dual%20t_1.jpg","wholesale_price":"4.43","unit_price_tax":9.43},"product_model":{"product_data":{"ean13":["3086123589551"],"reference":"989694","name":{"1":"Rotuladores Punta Fina Bic Intensity Dual Tip 989694\/ Colores Surtidos","2":"","3":"","4":""},"description":{"1":"                                                <p><\/p><h2>BIC Intensity Dual Tip<\/h2><p>BIC Intensity Dual Tip Rotuladores y Marcadores Pincel - Varios Colores<\/p><p>6 rotuladores de colores para adultos BIC Intensity Dual Tip que te har\u00e1n dudar sobre qu\u00e9 extremo est\u00e1 arriba. Son una combinaci\u00f3n de una punta de pincel en un extremo y un marcador fino en el otro. Utiliza la duradera punta de pincel modulable para ajustar el grosor al colorear zonas grandes o en proyectos de caligraf\u00eda. Gira estos rotuladores y prueba la punta fina para crear l\u00edneas de 0,7 mm y escribir y colorear los detalles m\u00e1s peque\u00f1os. Disfruta de una tinta con base de agua en 6 vivos y luminosos colores. Destaca las partes importantes de tus notas o decora tus libretas y diarios personales haciendo caligraf\u00eda, garabatos o esbozos.<\/p><h2>Especificaciones<\/h2><ul><li>Punto tipogr\u00e1fico &#8206;Fino y Punta de Pincel<\/li><li>Tama\u00f1o de l\u00ednea&#8206; 0.7-0.9<\/li><li>Tinta con base de agua<\/li><\/ul><p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BIC","supplier":null,"width":null,"height":null,"depth":null,"weight":0.06,"unit_price":9.43,"unit_price_tax":9.43,"tax_rules_group":null,"category":"Material Escolar","sub_category":"Ceras, L\u00e1pices y Rotuladores","quantity":5,"brand":"BIC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bic-rotu%20intensity%20dual%20t_1.jpg"],"wholesale_price":4.43}}},"3270220075516":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3270220075516",false],"wholesale_price":[5.35,false],"price":[10.35,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.16",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:221415","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/09033d62cecde1cf1e41f0c7