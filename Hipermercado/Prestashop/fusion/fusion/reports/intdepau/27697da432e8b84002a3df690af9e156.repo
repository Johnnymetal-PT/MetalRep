09_1.jpg"],"wholesale_price":30.12}}},"6941812795903":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812795903",false],"wholesale_price":[9.91,false],"price":[16.91,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:253499","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/de1eb79aeab5e8267b033243aee715d5.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Luz de Noche con Sensor de Movimiento Xiaomi Night Light 3 BHR8978GL\/ 2700\u00baK\/ \u00c1ngulo de apertura 120\u00ba","category":"Iluminaci\u00f3n","sub_category":"Lamparas","unit_price":16.91,"reference":"BHR8978GL","ean13":"6941812795903","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"<h2>Xiaomi Night Light 3<\/h2><div>Ilumina tu camino con una luz suave y reconfortante para las noches oscuras<br><\/div><div><p><ul><li><b>Gran autonom\u00eda<\/b><\/li><li>Desp\u00eddete de la molestia de cambiar las pilas gracias a una bater\u00eda de litio recargable<\/li><li><span style='background-color: initial;'><b>Luz ambiental suave<\/b><\/span><\/li><li>Disfruta de una c\u00f3moda compa\u00f1\u00eda con iluminaci\u00f3n difusa<\/li><li><span style='background-color: initial;'><b>Detecci\u00f3n inteligente de sensor doble<\/b><\/span><\/li><li>Se ilumina autom\u00e1ticamente cuando se detecta movimiento en un amplio rango de 120\u00b0, sin necesidad de pulsar ning\u00fan bot\u00f3n<\/li><li><span style='background-color: initial;'><b>Cambio sencillo entre dos modos<\/b><\/span><\/li><li>Cambia entre los diferentes modos para adaptarla a tus necesidades diarias con solo deslizar un interruptor<\/li><\/ul><\/p><h2>Disfruta de una carga r\u00e1pida y una bater\u00eda de larga duraci\u00f3n<\/h2><p>Con una bater\u00eda de litio integrada, desp\u00eddete de cambiar las bater\u00edas con frecuencia. La luz admite la carga tipo C y se carga por completo en unas 3 horas<\/p><p><ul><li>Brillo suave y difuso para crear un ambiente acogedor con dos niveles de brillo que se adaptan a tus necesidades<\/li><li>Modo de bajo brillo: flujo luminoso de 3 lm<\/li><li>Modo de alto brillo: flujo luminoso de 15 lm<\/li><\/ul><\/p><h2>Gracias a los sensores de movimiento humano y sensibles a la luz, la luz siempre se iluminar\u00e1 para ti<\/h2><p>La luz nocturna detecta el movimiento e ilumina r\u00e1pidamente tu espacio. Es f\u00e1cil de usar y sin complicaciones.<\/p><h2>Cambia de modo con solo deslizar el interruptor y disfruta de la luz deseada para cada momento al instante<\/h2><p>Cambia sin esfuerzo entre los modos de sensor y luz constante para disfrutar de una c\u00f3moda iluminaci\u00f3n nocturna que se adapta a ti.<\/p><h2>Adhesi\u00f3n fuerte para una mayor estabilidad y durabilidad<\/h2><p>Gracias un im\u00e1n integrado, la luz nocturna se adhiere sin esfuerzo a superficies magn\u00e9ticas como frigor\u00edficos u otros muebles. Tambi\u00e9n incluye una base para facilitar la instalaci\u00f3n. El producto incluye una base adhesiva 3M para ofrecer una sujeci\u00f3n segura, lo que garantiza un uso sin preocupaciones<\/p><h2>Una luz suave en cualquier entorno<\/h2><p>Desde al lado de la cama hasta en ba\u00f1os, habitaciones de ni\u00f1os, pasillos, entradas y escaleras, la luz se adapta a la perfecci\u00f3n a cualquier entorno. Dise\u00f1ada cuidadosamente para satisfacer todas tus necesidades de iluminaci\u00f3n, ilumina tu vida en todos los sentidos.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li><b>\u00c1mbito de aplicaci\u00f3n<\/b><\/li><li>Interiores<\/li><li><b>Temperatura de color<\/b><\/li><li>2700K<\/li><li><b>Entrada nominal<\/b><\/li><li>5 V&#9107;1 A<\/li><li><b>Potencia de entrada nominal<\/b><\/li><li>2,5 W<\/li><li><b>Capacidad de la bater\u00eda<\/b><\/li><li>600 mAh<\/li><li><b>Color del producto<\/b><\/li><li>Blanco<\/li><li><b>Peso neto<\/b><\/li><li>Aprox. 117 g<\/li><li><b>Dimensiones del producto<\/b><\/li><li>&#966; 95 x 41 mm<\/li><li><b>Contenido del paquete<\/b><\/li><li>1 Xiaomi Night Light 3<\/li><li>1 manual de usuario<\/li><li>1 base<\/li><li>1 cable de carga USB<\/li><li>1 aviso de garant\u00eda<\/li><\/ul><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sh%20night%20light%203_1.jpg","wholesale_price":"9.91","unit_price_tax":16.91},"product_model":{"product_data":{"ean13":["6941812795903"],"reference":"BHR8978GL","name":{"1":"Luz de Noche con Sensor de Movimiento Xiaomi Night Light 3 BHR8978GL\/ 2700\u00baK\/ \u00c1ngulo de apertura 120\u00ba","2":"","3":"","4":""},"description":{"1":"<h2>Xiaomi Night Light 3<\/h2><div>Ilumina tu camino con una luz suave y reconfortante para las noches oscuras<br><\/div><div><p><ul><li><b>Gran autonom\u00eda<\/b><\/li><li>Desp\u00eddete de la molestia de cambiar las pilas gracias a una bater\u00eda de litio recargable<\/li><li><span style='background-color: initial;'><b>Luz ambiental suave<\/b><\/span><\/li><li>Disfruta de una c\u00f3moda compa\u00f1\u00eda con iluminaci\u00f3n difusa<\/li><li><span style='background-color: initial;'><b>Detecci\u00f3n inteligente de sensor doble<\/b><\/span><\/li><li>Se ilumina autom\u00e1ticamente cuando se detecta movimiento en un amplio rango de 120\u00b0, sin necesidad de pulsar ning\u00fan bot\u00f3n<\/li><li><span style='background-color: initial;'><b>Cambio sencillo entre dos modos<\/b><\/span><\/li><li>Cambia entre los diferentes modos para adaptarla a tus necesidades diarias con solo deslizar un interruptor<\/li><\/ul><\/p><h2>Disfruta de una carga r\u00e1pida y una bater\u00eda de larga duraci\u00f3n<\/h2><p>Con una bater\u00eda de litio integrada, desp\u00eddete de cambiar las bater\u00edas con frecuencia. La luz admite la carga tipo C y se carga por completo en unas 3 horas<\/p><p><ul><li>Brillo suave y difuso para crear un ambiente acogedor con dos niveles de brillo que se adaptan a tus necesidades<\/li><li>Modo de bajo brillo: flujo luminoso de 3 lm<\/li><li>Modo de alto brillo: flujo luminoso de 15 lm<\/li><\/ul><\/p><h2>Gracias a los sensores de movimiento humano y sensibles a la luz, la luz siempre se iluminar\u00e1 para ti<\/h2><p>La luz nocturna detecta el movimiento e ilumina r\u00e1pidamente tu espacio. Es f\u00e1cil de usar y sin complicaciones.<\/p><h2>Cambia de modo con solo deslizar el interruptor y disfruta de la luz deseada para cada momento al instante<\/h2><p>Cambia sin esfuerzo entre los modos de sensor y luz constante para disfrutar de una c\u00f3moda iluminaci\u00f3n nocturna que se adapta a ti.<\/p><h2>Adhesi\u00f3n fuerte para una mayor estabilidad y durabilidad<\/h2><p>Gracias un im\u00e1n integrado, la luz nocturna se adhiere sin esfuerzo a superficies magn\u00e9ticas como frigor\u00edficos u otros muebles. Tambi\u00e9n incluye una base para facilitar la instalaci\u00f3n. El producto incluye una base adhesiva 3M para ofrecer una sujeci\u00f3n segura, lo que garantiza un uso sin preocupaciones<\/p><h2>Una luz suave en cualquier entorno<\/h2><p>Desde al lado de la cama hasta en ba\u00f1os, habitaciones de ni\u00f1os, pasillos, entradas y escaleras, la luz se adapta a la perfecci\u00f3n a cualquier entorno. Dise\u00f1ada cuidadosamente para satisfacer todas tus necesidades de iluminaci\u00f3n, ilumina tu vida en todos los sentidos.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li><b>\u00c1mbito de aplicaci\u00f3n<\/b><\/li><li>Interiores<\/li><li><b>Temperatura de color<\/b><\/li><li>2700K<\/li><li><b>Entrada nominal<\/b><\/li><li>5 V&#9107;1 A<\/li><li><b>Potencia de entrada nominal<\/b><\/li><li>2,5 W<\/li><li><b>Capacidad de la bater\u00eda<\/b><\/li><li>600 mAh<\/li><li><b>Color del producto<\/b><\/li><li>Blanco<\/li><li><b>Peso neto<\/b><\/li><li>Aprox. 117 g<\/li><li><b>Dimensiones del producto<\/b><\/li><li>&#966; 95 x 41 mm<\/li><li><b>Contenido del paquete<\/b><\/li><li>1 Xiaomi Night Light 3<\/li><li>1 manual de usuario<\/li><li>1 base<\/li><li>1 cable de carga USB<\/li><li>1 aviso de garant\u00eda<\/li><\/ul><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":16.91,"unit_price_tax":16.91,"tax_rules_group":null,"category":"Iluminaci\u00f3n","sub_category":"Lamparas","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sh%20night%20light%203_1.jpg"],"wholesale_price":9.91}}},"0195949705946":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195949705946",false],"wholesale_price":[1453.41,false],"price":[1460.41,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.03",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:253529","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/43a7260748518f8c29a6b3da4efa3ae0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Macbook Pro 14'\/ M4 10-Core CPU\/ 16Gb\/ 512Gb SSD\/ 10-Core GPU\/ Plata","category":"MacBook","sub_category":"MacBook PRO","unit_price":1460.41,"reference":"MW2W3Y\/A","ean13":"0195949705946","weight":"3.03","quantity":0,"brand":"APPLE","description_pt":"                                                                                                <p><h2>MacBook Pro<\/h2><p><\/p><p>El MacBook\u00a0Pro\u00a0incorpora la gama m\u00e1s avanzada de chips que se ha\u00a0creado nunca para un\u00a0port\u00e1til profesional.\u00a0El colosal rendi\u00admiento monohilo y multihilo de la CPU, la memoria unificada ultrarr\u00e1pida y los aceleradores de aprendizaje autom\u00e1tico mejorados de los chips M4 llevan la velocidad y las prestaciones al filo de lo imposible. Adem\u00e1s, su potente Neural\u00a0Engine est\u00e1 deseando lucirse en tareas de IA como el\u00a0escalado de im\u00e1genes o la\u00a0creaci\u00f3n de subt\u00edtulos.<\/p><p><\/p><h2>Dise\u00f1ado para Apple Intelligence.<\/h2><h2>Trabajar contigo es genial.<\/h2><p>Apple Intelligence es un sistema de inteligencia personal que te ayuda a redactar, expresarte y hacer tus tareas diarias sin esfuerzo. Gracias a su revolucionario sistema de privacidad, nadie m\u00e1s podr\u00e1 acceder a tus datos. Ni siquiera Apple.<\/p><h2>Un gran poder conlleva una gran privacidad.<\/h2><p>Apple Intelligence se ha dise\u00f1ado para proteger tu privacidad en todo momento y est\u00e1 completamente integrado en el Mac mediante el procesamiento en el dispositivo. En otras palabras, conoce tu informaci\u00f3n personal, pero jam\u00e1s la recopila.<\/p><p>Y con la revolucionaria Computaci\u00f3n Privada en la Nube, Apple Intelligence puede valerse de modelos de mayor tama\u00f1o basados en servidores, y que funcionan con chips de Apple, para procesar peticiones m\u00e1s complejas con total privacidad.<\/p><h2>Abierto hasta el amanecer. Y un rato m\u00e1s.<\/h2><p>El MacBook Pro ofrece la mayor autonom\u00eda que ha tenido nunca un Mac: hasta 24 horas. Y es compatible con la carga r\u00e1pida, de manera que puede cargarse un 50 % en solo 30 minutos.50 Todos los modelos rinden igual est\u00e9n o no conectados a la corriente, as\u00ed que t\u00fa deja de preocuparte por los cables y c\u00e9ntrate de lleno en tu universo.<\/p><p><\/p><h2>List\u00edsimo para\u00a0la\u00a0acci\u00f3n.<\/h2><p>Hay miles de apps optimizadas\u00a0para aprovechar el potencial de macOS, desde las que usas a\u00a0diario y en el trabajo hasta las m\u00e1s profesionales y tus juegos favoritos. Ni\u00a0te imaginas hasta d\u00f3nde pueden llegar con los chips\u00a0M4.<\/p><h2>Juntos es mejor.<\/h2><p><\/p><p><\/p><p>Recibe llamadas y mensajes. Llegan tambi\u00e9n a tu port\u00e1til, de modo que puedes responder sin cambiar de dispositivo.<\/p><p>Portapapeles Universal. Pega texto, im\u00e1genes, fotos o v\u00eddeos de tu iPhone al Mac y viceversa.<\/p><p>Env\u00eda fotos, archivos grandes y otros contenidos de forma inal\u00e1mbrica entre tu iPhone, Mac y otros dispositivos Apple cercanos. Sin conexi\u00f3n wifi.<\/p><h2>Un brillo con muchas luces.<\/h2><p><\/p><p><\/p><p>Pasa sin problema de la terraza m\u00e1s luminosa a la oscuridad de un estudio. La sensacional pantalla Liquid Retina XDR con 1.600 nits de pico de brillo HDR ahora ofrece hasta 1.000 nits de brillo para contenido SDR, por eso todo se ve de maravilla incluso a pleno sol. Adem\u00e1s, el brillo baja hasta 1 nit en entornos oscuros, para que tus ojos no trabajen de m\u00e1s aunque te pille la noche delante del ordenador.<\/p><h2>Domina la escena.<\/h2><p>Con la c\u00e1mara 12MP Center Stage, la luz siempre te favorece. Si a eso le sumas los micros y los altavoces avanzados, ser\u00e1s la estrella de todas las videollamadas.<\/p><h2>El poder est\u00e1 en las conexiones.<\/h2><p>El MacBook Pro viene con una gran variedad de puertos para usar perif\u00e9ricos avanzados, monitores de alta resoluci\u00f3n y tarjetas SDXC. Los modelos con chip M4 Pro y M4 Max ahora incluyen Thunderbolt 5, que alcanza velocidades de transferencia de hasta 120 Gb\/s.<\/p><p>El MacBook Pro tambi\u00e9n incorpora Wi&#8209;Fi 6E y Bluetooth 5.3 para que lo conectes f\u00e1cilmente a internet y dispositivos inal\u00e1mbricos.<\/p><h2>Sin brechas.<\/h2>La seguridad de los chips de Apple se extiende a toda la arquitectura de macOS. La perfecta sinton\u00eda entre el hardware y el software, as\u00ed como las actualizaciones autom\u00e1ticas, velan por la estabilidad y la protecci\u00f3n del MacBook Pro a medida que pasan los a\u00f1os. La arquitectura de seguridad tambi\u00e9n est\u00e1 detr\u00e1s de prestaciones como Touch ID, Buscar y los mecanismos avanzados que mantienen a raya los virus y el malware.<p><\/p><p><\/p><h2>Dise\u00f1ado para cambiar las cosas.<\/h2><p>Si es importante para ti, tambi\u00e9n lo es para Apple. Por eso empleamos materiales reciclados que reducen el impacto ambiental. Protegemos la privacidad para darte m\u00e1s control sobre tus datos. Y ofrecemos prestaciones de accesibilidad de serie para que todas las personas puedan usar el Mac.<\/p><p><\/p><h2>Especificaciones<\/h2><p><\/p><ul><li><strong>Chip<\/strong><\/li><li>Chip M4 de Apple<\/li><li>CPU de 10 n\u00facleos (4 de rendimiento y 6 de eficiencia)<\/li><li>GPU de 10 n\u00facleos<\/li><li>Trazado de rayos por aceleraci\u00f3n de hardware<\/li><li>Neural Engine de 16 n\u00facleos<\/li><li>120 GB\/s de ancho de banda de memoria<\/li><li>Motor\u00a0multimedia<\/li><li>Aceleraci\u00f3n de hardware para H.264, HEVC, ProRes y ProRes RAW<\/li><li>Motor de decodificaci\u00f3n de v\u00eddeo<\/li><li>Motor de codificaci\u00f3n de v\u00eddeo<\/li><li>Motor de codificaci\u00f3n y decodificaci\u00f3n ProRes<\/li><li>Decodificaci\u00f3n AV1<\/li><li><strong>Apple Intelligence<\/strong><\/li><li>Apple Intelligence es un sistema de inteligencia personal que te ayuda a redactar, expresarte y hacer tus tareas diarias sin esfuerzo. Cuenta con revolucionarias prestaciones de privacidad para que nadie m\u00e1s pueda acceder a tus datos. Ni siquiera Apple.<\/li><li><strong>Pantalla<\/strong><\/li><li>Pantalla Liquid Retina XDR<\/li><li>Pantalla Liquid Retina XDR de 14,2 pulgadas (35,97 cm) en diagonal; resoluci\u00f3n nativa de 3.024 por 1.964 a 254 p\u00edxeles por pulgada<\/li><li>XDR (rango din\u00e1mico extremo)<\/li><li>Contraste de 1.000.000:1<\/li><li>Brillo XDR: 1.000 nits de brillo sostenido (a pantalla completa) y 1.600 nits de pico de brillo3 (solo HDR)<\/li><li>Brillo SDR de hasta 1.000 nits (en exteriores)<\/li><li>Color<\/li><li>1.000 millones de colores<\/li><li>Gama crom\u00e1tica amplia (P3)<\/li><li>Tecnolog\u00eda True Tone<\/li><li>Frecuencias de actualizaci\u00f3n<\/li><li>Tecnolog\u00eda ProMotion con frecuencia de actualizaci\u00f3n adaptativa de hasta 120 Hz<\/li><li>Frecuencias de actualizaci\u00f3n fijas: 47,95 Hz, 48 Hz, 50 Hz, 59,94 Hz y 60 Hz<\/li><li><strong>Carga y ampliaci\u00f3n<\/strong><\/li><li>Ranura para tarjetas SDXC<\/li><li>Puerto HDMI<\/li><li>Toma para auriculares de 3,5 mm<\/li><li>Puerto MagSafe 3<\/li><li>Chip M4\u00a0<\/li><li>Tres puertos Thunderbolt 4 (USB&#8209;C) compatibles con:<\/li><li>Carga<\/li><li>DisplayPort<\/li><li>Thunderbolt 4 (hasta 40 Gb\/s)<\/li><li>USB 4 (hasta 40 Gb\/s)<\/li><li><strong>Compati\u00adbilidad con monitores<\/strong><\/li><li>M4 y M4 Pro<\/li><li>Admite simult\u00e1neamente la resoluci\u00f3n nativa completa en la pantalla integrada compatible con mil millones de colores y:<\/li><li>Hasta dos monitores externos con resoluci\u00f3n hasta 6K a 60 Hz por Thunderbolt, o un monitor externo con resoluci\u00f3n hasta 6K a 60 Hz por Thunderbolt y un monitor externo con resoluci\u00f3n hasta 4K a 144 Hz por HDMI<\/li><li>Un monitor externo con resoluci\u00f3n 8K a 60 Hz o un monitor externo con resoluci\u00f3n 4K a 240 Hz por HDMI<\/li><li><strong>Conexi\u00f3n inal\u00e1mbrica<\/strong><\/li><li>Wi&#8209;Fi<\/li><li>Wi&#8209;Fi 6E (802.11ax)<\/li><li>Bluetooth\u00a0<\/li><li>Bluetooth 5.3<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara 12MP Center Stage y Vista Cenital<\/li><li>V\u00eddeo en 1080p HD<\/li><li>Procesador de se\u00f1al de imagen avanzado con v\u00eddeo computacional<\/li><li><strong>Audio<\/strong><\/li><li>Sistema de seis altavoces de alta fidelidad con cancelaci\u00f3n de fuerza en los woofers<\/li><li>Sonido est\u00e9reo amplio<\/li><li>Compati\u00adbilidad con audio espacial al reproducir m\u00fasica o v\u00eddeo con Dolby Atmos en los altavoces integrados<\/li><li>Audio espacial con seguimiento din\u00e1mico de la cabeza al usar los AirPods (3.\u00aa generaci\u00f3n), AirPods 4, AirPods Pro, AirPods Pro 2 y AirPods Max<\/li><li>Conjunto de tres micr\u00f3fonos con calidad de estudio, alta relaci\u00f3n se\u00f1al\/ruido y tecnolog\u00eda beamforming direccional<\/li><li>Toma para auriculares de 3,5 mm y compati\u00adbilidad avanzada con auriculares de alta impedancia<\/li><li>Puerto HDMI compatible con salida de audio multicanal<\/li><li><strong>Requisitos de funciona\u00admiento<\/strong><\/li><li>Tensi\u00f3n: de 100 a 240 V de CA<\/li><li>Frecuencia: de 50 a 60 Hz<\/li><li>Temperatura de funciona\u00admiento: de 10 a 35 \u00b0C<\/li><li>Temperatura de almacena\u00admiento: de -25 a 45 \u00b0C<\/li><li>Humedad relativa: del 0 al 90 % sin condensaci\u00f3n<\/li><li>Altitud m\u00e1xima de funciona\u00admiento: probado hasta 3.000 m<\/li><li>Altitud m\u00e1xima de almacena\u00admiento: 4.500 m<\/li><li>Altitud m\u00e1xima de transporte: 10.500 m<\/li><li><strong>Tama\u00f1o y peso<\/strong><\/li><li>Alto: 1,55 cm<\/li><li>Ancho: 31,26 cm<\/li><li>Fondo: 22,12 cm<\/li><li>Peso (M4): 1,55 kg<\/li><li>Peso (M4 Pro): 1,6 kg<\/li><li>Peso (M4 Max): 1,62 kg<\/li><li><strong>Sistema operativo<\/strong><\/li><li>macOS<\/li><li>macOS es el sistema operativo de ordenador m\u00e1s avanzado del mundo. macOS Sequoia multiplica tu producti\u00advidad y creatividad con las ventanas en mosaico, actualizaciones de Safari, compati\u00adbilidad con Apple Intelligence y mucho m\u00e1s<\/li><li><strong>Accesibilidad<\/strong><\/li><li>Las prestaciones de accesibilidad del MacBook Pro ayudan a las personas con diversidad funcional a sacarle el m\u00e1ximo partido. Gracias a sus funciones para usuarios con problemas de visi\u00f3n, audici\u00f3n, motricidad y aprendizaje, hacer cosas incre\u00edbles est\u00e1 al alcance de todo el mundo.<\/li><li><strong>Contenido de la caja<\/strong><\/li><li>MacBook Pro de 14 pulgadas<\/li><li>Adaptador de corriente USB&#8209;C de 70 W (M4 o M4 Pro con CPU de 12 n\u00facleos)<\/li><li>Cable de USB&#8209;C a MagSafe 3 (2 m)<\/li><\/ul><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-book%20pro%20mw2w3ybardera_1.jpg","wholesale_price":"1453.41","unit_price_tax":1460.41},"product_model":{"product_data":{"ean13":["0195949705946"],"reference":"MW2W3Y\/A","name":{"1":"Apple Macbook Pro 14'\/ M4 10-Core CPU\/ 16Gb\/ 512Gb SSD\/ 10-Core GPU\/ Plata","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><h2>MacBook Pro<\/h2><p><\/p><p>El MacBook\u00a0Pro\u00a0incorpora la gama m\u00e1s avanzada de chips que se ha\u00a0creado nunca para un\u00a0port\u00e1til profesional.\u00a0El colosal rendi\u00admiento monohilo y multihilo de la CPU, la memoria unificada ultrarr\u00e1pida y los aceleradores de aprendizaje autom\u00e1tico mejorados de los chips M4 llevan la velocidad y las prestaciones al filo de lo imposible. Adem\u00e1s, su potente Neural\u00a0Engine est\u00e1 deseando lucirse en tareas de IA como el\u00a0escalado de im\u00e1genes o la\u00a0creaci\u00f3n de subt\u00edtulos.<\/p><p><\/p><h2>Dise\u00f1ado para Apple Intelligence.<\/h2><h2>Trabajar contigo es genial.<\/h2><p>Apple Intelligence es un sistema de inteligencia personal que te ayuda a redactar, expresarte y hacer tus tareas diarias sin esfuerzo. Gracias a su revolucionario sistema de privacidad, nadie m\u00e1s podr\u00e1 acceder a tus datos. Ni siquiera Apple.<\/p><h2>Un gran poder conlleva una gran privacidad.<\/h2><p>Apple Intelligence se ha dise\u00f1ado para proteger tu privacidad en todo momento y est\u00e1 completamente integrado en el Mac mediante el procesamiento en el dispositivo. En otras palabras, conoce tu informaci\u00f3n personal, pero jam\u00e1s la recopila.<\/p><p>Y con la revolucionaria Computaci\u00f3n Privada en la Nube, Apple Intelligence puede valerse de modelos de mayor tama\u00f1o basados en servidores, y que funcionan con chips de Apple, para procesar peticiones m\u00e1s complejas con total privacidad.<\/p><h2>Abierto hasta el amanecer. Y un rato m\u00e1s.<\/h2><p>El MacBook Pro ofrece la mayor autonom\u00eda que ha tenido nunca un Mac: hasta 24 horas. Y es compatible con la carga r\u00e1pida, de manera que puede cargarse un 50 % en solo 30 minutos.50 Todos los modelos rinden igual est\u00e9n o no conectados a la corriente, as\u00ed que t\u00fa deja de preocuparte por los cables y c\u00e9ntrate de lleno en tu universo.<\/p><p><\/p><h2>List\u00edsimo para\u00a0la\u00a0acci\u00f3n.<\/h2><p>Hay miles de apps optimizadas\u00a0para aprovechar el potencial de macOS, desde las que usas a\u00a0diario y en el trabajo hasta las m\u00e1s profesionales y tus juegos favoritos. Ni\u00a0te imaginas hasta d\u00f3nde pueden llegar con los chips\u00a0M4.<\/p><h2>Juntos es mejor.<\/h2><p><\/p><p><\/p><p>Recibe llamadas y mensajes. Llegan tambi\u00e9n a tu port\u00e1til, de modo que puedes responder sin cambiar de dispositivo.<\/p><p>Portapapeles Universal. Pega texto, im\u00e1genes, fotos o v\u00eddeos de tu iPhone al Mac y viceversa.<\/p><p>Env\u00eda fotos, archivos grandes y otros contenidos de forma inal\u00e1mbrica entre tu iPhone, Mac y otros dispositivos Apple cercanos. Sin conexi\u00f3n wifi.<\/p><h2>Un brillo con muchas luces.<\/h2><p><\/p><p><\/p><p>Pasa sin problema de la terraza m\u00e1s luminosa a la oscuridad de un estudio. La sensacional pantalla Liquid Retina XDR con 1.600 nits de pico de brillo HDR ahora ofrece hasta 1.000 nits de brillo para contenido SDR, por eso todo se ve de maravilla incluso a pleno sol. Adem\u00e1s, el brillo baja hasta 1 nit en entornos oscuros, para que tus ojos no trabajen de m\u00e1s aunque te pille la noche delante del ordenador.<\/p><h2>Domina la escena.<\/h2><p>Con la c\u00e1mara 12MP Center Stage, la luz siempre te favorece. Si a eso le sumas los micros y los altavoces avanzados, ser\u00e1s la estrella de todas las videollamadas.<\/p><h2>El poder est\u00e1 en las conexiones.<\/h2><p>El MacBook Pro viene con una gran variedad de puertos para usar perif\u00e9ricos avanzados, monitores de alta resoluci\u00f3n y tarjetas SDXC. Los modelos con chip M4 Pro y M4 Max ahora incluyen Thunderbolt 5, que alcanza velocidades de transferencia de hasta 120 Gb\/s.<\/p><p>El MacBook Pro tambi\u00e9n incorpora Wi&#8209;Fi 6E y Bluetooth 5.3 para que lo conectes f\u00e1cilmente a internet y dispositivos inal\u00e1mbricos.<\/p><h2>Sin brechas.<\/h2>La seguridad de los chips de Apple se extiende a toda la arquitectura de macOS. La perfecta sinton\u00eda entre el hardware y el software, as\u00ed como las actualizaciones autom\u00e1ticas, velan por la estabilidad y la protecci\u00f3n del MacBook Pro a medida que pasan los a\u00f1os. La arquitectura de seguridad tambi\u00e9n est\u00e1 detr\u00e1s de prestaciones como Touch ID, Buscar y los mecanismos avanzados que mantienen a raya los virus y el malware.<p><\/p><p><\/p><h2>Dise\u00f1ado para cambiar las cosas.<\/h2><p>Si es importante para ti, tambi\u00e9n lo es para Apple. Por eso empleamos materiales reciclados que reducen el impacto ambiental. Protegemos la privacidad para darte m\u00e1s control sobre tus datos. Y ofrecemos prestaciones de accesibilidad de serie para que todas las personas puedan usar el Mac.<\/p><p><\/p><h2>Especificaciones<\/h2><p><\/p><ul><li><strong>Chip<\/strong><\/li><li>Chip M4 de Apple<\/li><li>CPU de 10 n\u00facleos (4 de rendimiento y 6 de eficiencia)<\/li><li>GPU de 10 n\u00facleos<\/li><li>Trazado de rayos por aceleraci\u00f3n de hardware<\/li><li>Neural Engine de 16 n\u00facleos<\/li><li>120 GB\/s de ancho de banda de memoria<\/li><li>Motor\u00a0multimedia<\/li><li>Aceleraci\u00f3n de hardware para H.264, HEVC, ProRes y ProRes RAW<\/li><li>Motor de decodificaci\u00f3n de v\u00eddeo<\/li><li>Motor de codificaci\u00f3n de v\u00eddeo<\/li><li>Motor de codificaci\u00f3n y decodificaci\u00f3n ProRes<\/li><li>Decodificaci\u00f3n AV1<\/li><li><strong>Apple Intelligence<\/strong><\/li><li>Apple Intelligence es un sistema de inteligencia personal que te ayuda a redactar, expresarte y hacer tus tareas diarias sin esfuerzo. Cuenta con revolucionarias prestaciones de privacidad para que nadie m\u00e1s pueda acceder a tus datos. Ni siquiera Apple.<\/li><li><strong>Pantalla<\/strong><\/li><li>Pantalla Liquid Retina XDR<\/li><li>Pantalla Liquid Retina XDR de 14,2 pulgadas (35,97 cm) en diagonal; resoluci\u00f3n nativa de 3.024 por 1.964 a 254 p\u00edxeles por pulgada<\/li><li>XDR (rango din\u00e1mico extremo)<\/li><li>Contraste de 1.000.000:1<\/li><li>Brillo XDR: 1.000 nits de brillo sostenido (a pantalla completa) y 1.600 nits de pico de brillo3 (solo HDR)<\/li><li>Brillo SDR de hasta 1.000 nits (en exteriores)<\/li><li>Color<\/li><li>1.000 millones de colores<\/li><li>Gama crom\u00e1tica amplia (P3)<\/li><li>Tecnolog\u00eda True Tone<\/li><li>Frecuencias de actualizaci\u00f3n<\/li><li>Tecnolog\u00eda ProMotion con frecuencia de actualizaci\u00f3n adaptativa de hasta 120 Hz<\/li><li>Frecuencias de actualizaci\u00f3n fijas: 47,95 Hz, 48 Hz, 50 Hz, 59,94 Hz y 60 Hz<\/li><li><strong>Carga y ampliaci\u00f3n<\/strong><\/li><li>Ranura para tarjetas SDXC<\/li><li>Puerto HDMI<\/li><li>Toma para auriculares de 3,5 mm<\/li><li>Puerto MagSafe 3<\/li><li>Chip M4\u00a0<\/li><li>Tres puertos Thunderbolt 4 (USB&#8209;C) compatibles con:<\/li><li>Carga<\/li><li>DisplayPort<\/li><li>Thunderbolt 4 (hasta 40 Gb\/s)<\/li><li>USB 4 (hasta 40 Gb\/s)<\/li><li><strong>Compati\u00adbilidad con monitores<\/strong><\/li><li>M4 y M4 Pro<\/li><li>Admite simult\u00e1neamente la resoluci\u00f3n nativa completa en la pantalla integrada compatible con mil millones de colores y:<\/li><li>Hasta dos monitores externos con resoluci\u00f3n hasta 6K a 60 Hz por Thunderbolt, o un monitor externo con resoluci\u00f3n hasta 6K a 60 Hz por Thunderbolt y un monitor externo con resoluci\u00f3n hasta 4K a 144 Hz por HDMI<\/li><li>Un monitor externo con resoluci\u00f3n 8K a 60 Hz o un monitor externo con resoluci\u00f3n 4K a 240 Hz por HDMI<\/li><li><strong>Conexi\u00f3n inal\u00e1mbrica<\/strong><\/li><li>Wi&#8209;Fi<\/li><li>Wi&#8209;Fi 6E (802.11ax)<\/li><li>Bluetooth\u00a0<\/li><li>Bluetooth 5.3<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara 12MP Center Stage y Vista Cenital<\/li><li>V\u00eddeo en 1080p HD<\/li><li>Procesador de se\u00f1al de imagen avanzado con v\u00eddeo computacional<\/li><li><strong>Audio<\/strong><\/li><li>Sistema de seis altavoces de alta fidelidad con cancelaci\u00f3n de fuerza en los woofers<\/li><li>Sonido est\u00e9reo amplio<\/li><li>Compati\u00adbilidad con audio espacial al reproducir m\u00fasica o v\u00eddeo con Dolby Atmos en los altavoces integrados<\/li><li>Audio espacial con seguimiento din\u00e1mico de la cabeza al usar los AirPods (3.\u00aa generaci\u00f3n), AirPods 4, AirPods Pro, AirPods Pro 2 y AirPods Max<\/li><li>Conjunto de tres micr\u00f3fonos con calidad de estudio, alta relaci\u00f3n se\u00f1al\/ruido y tecnolog\u00eda beamforming direccional<\/li><li>Toma para auriculares de 3,5 mm y compati\u00adbilidad avanzada con auriculares de alta impedancia<\/li><li>Puerto HDMI compatible con salida de audio multicanal<\/li><li><strong>Requisitos de funciona\u00admiento<\/strong><\/li><li>Tensi\u00f3n: de 100 a 240 V de CA<\/li><li>Frecuencia: de 50 a 60 Hz<\/li><li>Temperatura de funciona\u00admiento: de 10 a 35 \u00b0C<\/li><li>Temperatura de almacena\u00admiento: de -25 a 45 \u00b0C<\/li><li>Humedad relativa: del 0 al 90 % sin condensaci\u00f3n<\/li><li>Altitud m\u00e1xima de funciona\u00admiento: probado hasta 3.000 m<\/li><li>Altitud m\u00e1xima de almacena\u00admiento: 4.500 m<\/li><li>Altitud m\u00e1xima de transporte: 10.500 m<\/li><li><strong>Tama\u00f1o y peso<\/strong><\/li><li>Alto: 1,55 cm<\/li><li>Ancho: 31,26 cm<\/li><li>Fondo: 22,12 cm<\/li><li>Peso (M4): 1,55 kg<\/li><li>Peso (M4 Pro): 1,6 kg<\/li><li>Peso (M4 Max): 1,62 kg<\/li><li><strong>Sistema operativo<\/strong><\/li><li>macOS<\/li><li>macOS es el sistema operativo de ordenador m\u00e1s avanzado del mundo. macOS Sequoia multiplica tu producti\u00advidad y creatividad con las ventanas en mosaico, actualizaciones de Safari, compati\u00adbilidad con Apple Intelligence y mucho m\u00e1s<\/li><li><strong>Accesibilidad<\/strong><\/li><li>Las prestaciones de accesibilidad del MacBook Pro ayudan a las personas con diversidad funcional a sacarle el m\u00e1ximo partido. Gracias a sus funciones para usuarios con problemas de visi\u00f3n, audici\u00f3n, motricidad y aprendizaje, hacer cosas incre\u00edbles est\u00e1 al alcance de todo el mundo.<\/li><li><strong>Contenido de la caja<\/strong><\/li><li>MacBook Pro de 14 pulgadas<\/li><li>Adaptador de corriente USB&#8209;C de 70 W (M4 o M4 Pro con CPU de 12 n\u00facleos)<\/li><li>Cable de USB&#8209;C a MagSafe 3 (2 m)<\/li><\/ul><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":3.03,"unit_price":1460.41,"unit_price_tax":1460.41,"tax_rules_group":null,"category":"MacBook","sub_category":"MacBook PRO","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/ar