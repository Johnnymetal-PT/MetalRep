":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HP","supplier":null,"width":null,"height":null,"depth":null,"weight":2.5,"unit_price":498.64,"unit_price_tax":498.64,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":2,"brand":"HP","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hpp-pro%209y6v2at_1.jpg"],"wholesale_price":491.64}}},"4712856274363":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4712856274363",false],"wholesale_price":[42.23,false],"price":[49.23,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.14",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:253685","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/4e6ff111527d07bc4cc57222e75220b3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tarjeta Gesti\u00f3n Remota Cyberpower RCCARD100\/ RJ45","category":"S.A.I.","sub_category":"Accesorios SAIS","unit_price":49.23,"reference":"RCCARD100","ean13":"4712856274363","weight":"0.14","quantity":2,"brand":"CYBERPOWER","description_pt":"<p><\/p><h2>Tarjeta Gesti\u00f3n Remota Cyberpower RCCARD100<\/h2><p>CyberPower RCCARD100 es un complemento de administraci\u00f3n opcional para la serie espec\u00edfica de UPS CyberPower. Al insertar la tarjeta en la ranura de expansi\u00f3n en el UPS, los usuarios pueden agregarlo al sistema PowerPanel Cloud, permitiendo as\u00ed la supervisi\u00f3n y administraci\u00f3n remota del UPS, a trav\u00e9s de un portal web seguro o aplicaci\u00f3n m\u00f3vil.<\/p><p>La tarjeta tiene un dise\u00f1o plug-and-play y puede cambiarse en caliente, lo que permite una instalaci\u00f3n r\u00e1pida y f\u00e1cil sin interrumpir el funcionamiento del UPS. Adem\u00e1s, la tarjeta admite firmware actualizable por el usuario, por lo que los usuarios pueden mantener la funcionalidad actualizada con facilidad .<\/p><p><\/p><h2>Caracter\u00edsticas<\/h2><p><\/p><ul><li>UPS Management Through Cloud<\/li><li>Instalaci\u00f3n Plug-and-play<\/li><li>RoHS<\/li><li>C\u00f3digo QR para configuraci\u00f3n r\u00e1pida<\/li><li>Firmware actualizable por el usuario<\/li><\/ul><p><\/p><p><\/p><h2>Especificaciones<\/h2><p><\/p><ul><li><b style='background-color: initial;'>Qu\u00e9 hay en la caja<\/b><\/li><li><span style='background-color: initial;'>RCCARD100<\/span><\/li><li><span style='background-color: initial;'>Gu\u00eda de Inicio R\u00e1pido<\/span><\/li><li><span style='background-color: initial;'>Spare Jumper<\/span><\/li><li><b>Gesti\u00f3n y comunicaciones<\/b><\/li><li>Indicadores LED<\/li><li>Tx\/Rx, Enlace<\/li><li>Puerto de conectividad<\/li><li>RJ45<\/li><li>Soporte Plug-and-play de Instalaci\u00f3n<\/li><li>S\u00ed<\/li><li>Firmware actualizable por el usuario<\/li><li>S\u00ed<\/li><li><b>Gesti\u00f3n remota<\/b><\/li><li>PowerPanel App (Servicio gratuito de 3 a\u00f1os), PowerPanel Cloud (Servicio gratuito de 3 a\u00f1os)<\/li><li><b>F\u00edsico<\/b><\/li><li>Color<\/li><li>Verde<\/li><li>Dimensiones (AnxAlxP) (pulgadas)<\/li><li>2.13 x 1.42 x 3<\/li><li>Dimensiones (AnxAlxP) (mm)<\/li><li>54 x 36.1 x 76.5<\/li><li>Peso (libras)<\/li><li>0.07<\/li><li>Peso (g)<\/li><li>31<\/li><li><b>Medioambiental<\/b><\/li><li>Temperatura de funcionamiento (\u00baF)<\/li><li>32 ~ 104<\/li><li>Temperatura de funcionamiento (\u00baC)<\/li><li>0 ~ 40<\/li><li>Humedad relativa de funcionamiento (sin condensaci\u00f3n) ( % )<\/li><li>0 ~ 90<\/li><li>Elevaci\u00f3n de funcionamiento ( pies\/metros )<\/li><li>0-10.000 pies (0-3.000 metros)<\/li><li>Temperatura de almacenamiento (\u00baF)<\/li><li>14 ~ 122<\/li><li>Temperatura de almacenamiento (\u00baC)<\/li><li>-10 ~ 50<\/li><li>Humedad relativa de almacenamiento (sin condensaci\u00f3n) ( % )<\/li><li>0 ~ 95<\/li><li>Elevaci\u00f3n de almacenamiento ( pies\/metros )<\/li><li>0-50.000 pies (0-15.000 metros)<\/li><li><b>Certificaciones<\/b><\/li><li>Certificaciones<\/li><li>CE, FCC Class B<\/li><li>RoHS<\/li><li>S\u00ed<\/li><\/ul><p><\/p><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cyb-tarjeta%20rccard100_1.jpg","wholesale_price":"42.23","unit_price_tax":49.23},"product_model":{"product_data":{"ean13":["4712856274363"],"reference":"RCCARD100","name":{"1":"Tarjeta Gesti\u00f3n Remota Cyberpower RCCARD100\/ RJ45","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Tarjeta Gesti\u00f3n Remota Cyberpower RCCARD100<\/h2><p>CyberPower RCCARD100 es un complemento de administraci\u00f3n opcional para la serie espec\u00edfica de UPS CyberPower. Al insertar la tarjeta en la ranura de expansi\u00f3n en el UPS, los usuarios pueden agregarlo al sistema PowerPanel Cloud, permitiendo as\u00ed la supervisi\u00f3n y administraci\u00f3n remota del UPS, a trav\u00e9s de un portal web seguro o aplicaci\u00f3n m\u00f3vil.<\/p><p>La tarjeta tiene un dise\u00f1o plug-and-play y puede cambiarse en caliente, lo que permite una instalaci\u00f3n r\u00e1pida y f\u00e1cil sin interrumpir el funcionamiento del UPS. Adem\u00e1s, la tarjeta admite firmware actualizable por el usuario, por lo que los usuarios pueden mantener la funcionalidad actualizada con facilidad .<\/p><p><\/p><h2>Caracter\u00edsticas<\/h2><p><\/p><ul><li>UPS Management Through Cloud<\/li><li>Instalaci\u00f3n Plug-and-play<\/li><li>RoHS<\/li><li>C\u00f3digo QR para configuraci\u00f3n r\u00e1pida<\/li><li>Firmware actualizable por el usuario<\/li><\/ul><p><\/p><p><\/p><h2>Especificaciones<\/h2><p><\/p><ul><li><b style='background-color: initial;'>Qu\u00e9 hay en la caja<\/b><\/li><li><span style='background-color: initial;'>RCCARD100<\/span><\/li><li><span style='background-color: initial;'>Gu\u00eda de Inicio R\u00e1pido<\/span><\/li><li><span style='background-color: initial;'>Spare Jumper<\/span><\/li><li><b>Gesti\u00f3n y comunicaciones<\/b><\/li><li>Indicadores LED<\/li><li>Tx\/Rx, Enlace<\/li><li>Puerto de conectividad<\/li><li>RJ45<\/li><li>Soporte Plug-and-play de Instalaci\u00f3n<\/li><li>S\u00ed<\/li><li>Firmware actualizable por el usuario<\/li><li>S\u00ed<\/li><li><b>Gesti\u00f3n remota<\/b><\/li><li>PowerPanel App (Servicio gratuito de 3 a\u00f1os), PowerPanel Cloud (Servicio gratuito de 3 a\u00f1os)<\/li><li><b>F\u00edsico<\/b><\/li><li>Color<\/li><li>Verde<\/li><li>Dimensiones (AnxAlxP) (pulgadas)<\/li><li>2.13 x 1.42 x 3<\/li><li>Dimensiones (AnxAlxP) (mm)<\/li><li>54 x 36.1 x 76.5<\/li><li>Peso (libras)<\/li><li>0.07<\/li><li>Peso (g)<\/li><li>31<\/li><li><b>Medioambiental<\/b><\/li><li>Temperatura de funcionamiento (\u00baF)<\/li><li>32 ~ 104<\/li><li>Temperatura de funcionamiento (\u00baC)<\/li><li>0 ~ 40<\/li><li>Humedad relativa de funcionamiento (sin condensaci\u00f3n) ( % )<\/li><li>0 ~ 90<\/li><li>Elevaci\u00f3n de funcionamiento ( pies\/metros )<\/li><li>0-10.000 pies (0-3.000 metros)<\/li><li>Temperatura de almacenamiento (\u00baF)<\/li><li>14 ~ 122<\/li><li>Temperatura de almacenamiento (\u00baC)<\/li><li>-10 ~ 50<\/li><li>Humedad relativa de almacenamiento (sin condensaci\u00f3n) ( % )<\/li><li>0 ~ 95<\/li><li>Elevaci\u00f3n de almacenamiento ( pies\/metros )<\/li><li>0-50.000 pies (0-15.000 metros)<\/li><li><b>Certificaciones<\/b><\/li><li>Certificaciones<\/li><li>CE, FCC Class B<\/li><li>RoHS<\/li><li>S\u00ed<\/li><\/ul><p><\/p><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"",