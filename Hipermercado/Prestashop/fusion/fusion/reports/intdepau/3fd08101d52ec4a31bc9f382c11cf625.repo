Latvian, Lithuanian, Macedonian, Norwegian, Polish, Portuguese, Romanian, Russian, Serbian, Slovak, Slovenian, Spanish, Swedish, Turkish, Ukrainian<\/span><\/li>  <li>Convergence<\/li>  <li><span style='font-weight: normal;'>Compartir Wi-Fi<\/span><\/li>  <li><span style='font-weight: normal;'>Chromecast &amp; T-cast<\/span><\/li>  <li><span style='font-weight: normal;'>perfil bluetooth<\/span><\/li>  <li><span style='font-weight: normal;'>A2DP, HID<\/span><\/li>  <li><span style='font-weight: normal;'>DLNA 1.5<\/span><\/li>  <li><span style='font-weight: normal;'>S\u00ed<\/span><\/li>  <li><span style='font-weight: normal;'>Soporte USB HID<\/span><\/li>  <li><span style='font-weight: normal;'>S\u00ed<\/span><\/li>  <li>Control<\/li>  <li><span style='font-weight: normal;'>Bater\u00edas de control remoto<\/span><\/li>  <li><span style='font-weight: normal;'>S\u00ed<\/span><\/li>  <li><span style='font-weight: normal;'>Control remoto<\/span><\/li>  <li><span style='font-weight: normal;'>RC833<\/span><\/li>  <li>Tuner\/Broadcasting<\/li>  <li><span style='font-weight: normal;'>DTV Tuner<\/span><\/li>  <li><span style='font-weight: normal;'>DVB-T2\/C\/S2<\/span><\/li>  <li><span style='font-weight: normal;'>Decodificaci\u00f3n de v\u00eddeo<\/span><\/li>  <li><span style='font-weight: normal;'>H.265 UHD, H.264, MPEG-2<\/span><\/li>  <li><span style='font-weight: normal;'>Sintonizador anal\u00f3gico<\/span><\/li>  <li><span style='font-weight: normal;'>S\u00ed<\/span><\/li>  <li><span style='font-weight: normal;'>Sistemas de sintonizadores anal\u00f3gicos<\/span><\/li>  <li><span style='font-weight: normal;'>PAL\/SECAM\/NTSC (AV) BG\/DK\/I\/LL'<\/span><\/li>  <li><span style='font-weight: normal;'>CI+<\/span><\/li>  <li><span style='font-weight: normal;'>S\u00ed (1.4, ECP)<\/span><\/li>  <li><span style='font-weight: normal;'>EPG (DVB EIT\/SI)<\/span><\/li>  <li><span style='font-weight: normal;'>Hasta 8 d\u00edas<\/span><\/li>  <li><span style='font-weight: normal;'>B\