depau.es\/articulos\/800\/800\/fixed\/art_prm-visor%20kt20002x20lcd_1.jpg"],"wholesale_price":26.78}}},"6941812744307":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812744307",false],"wholesale_price":[52.86,false],"price":[57.86,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:173848","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/7dcc04e4d033d3b8643f51e84f14eaa4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara de Videovigilancia Xiaomi Outdoor Camera CW400\/ 113\u00ba\/ Visi\u00f3n Nocturna\/ Control desde APP","category":"Videovigilancia","sub_category":"Camaras Videovigilancia","unit_price":57.86,"reference":"OUT CAM CW400","ean13":"6941812744307","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"<p><h2>Calidad de imagen ultra clara de 2.5K, seguridad inteligente para condiciones clim\u00e1ticas adversas<\/h2>Visi\u00f3n nocturna inteligente a todo color | Resistencia al agua IP66 | Red de doble antena | Soporte de voz bidireccional | Detecci\u00f3n humana por IA | Sistemas de aviso ac\u00fastico y visual | Fotograf\u00eda a intervalos<br><br><h2>4 MP con gran apertura Calidad de imagen ultra clara de 2,5 K<\/h2>Im\u00e1genes ultra claras de 4 MP y 2,5 K con una lente de gran apertura f\/1,6 con un sensor de imagen de alto rendimiento. Obtenga detalles m\u00e1s brillantes y claros con im\u00e1genes de mayor calidad.<br><br><h2>Visi\u00f3n nocturna inteligente a todo color con cuatro luces Im\u00e1genes verdaderamente claras, incluso en las noches oscuras<\/h2>Capture im\u00e1genes coloridas incluso en entornos con poca luz. Las luces blancas incorporadas se encienden autom\u00e1ticamente cuando se reconoce a un ser humano por la noche.<br><br><h2>Dise\u00f1o profesional con resistencia al agua IP66 Listo para condiciones clim\u00e1ticas adversas<\/h2>El dise\u00f1o profesional resistente al agua IP66 para exteriores garantiza un uso confiable en exteriores y se adapta f\u00e1cilmente a entornos exteriores complejos.<br><br><h2>Gimbals duales horizontales y verticales M\u00e1s flexibles y confiables<\/h2>Dise\u00f1o de card\u00e1n dual con vista horizontal de 360\u00b0 y vista vertical de 160\u00b0 para brindar una soluci\u00f3n de seguridad completa.<br><br><h2>Dise\u00f1o de antena dual de alta ganancia Se\u00f1al Wi-Fi mejorada y m\u00e1s clara<\/h2>El dise\u00f1o integrado de antena dual de alta ganancia garantiza la estabilidad a larga distancia de la red de c\u00e1maras, aumentando la distancia de transmisi\u00f3n.<br><br><h2>Llamadas de voz bidireccionales para facilitar la conversaci\u00f3n Cancelaci\u00f3n de ruido inteligente para cualquier entorno al aire libre<\/h2>Con un micr\u00f3fono incorporado de alta sensibilidad y un altavoz de alta potencia y alta calidad. Capta f\u00e1cilmente el sonido desde largas distancias para que tus di\u00e1logos sean tan claros como si te estuvieras comunicando cara a cara.<br><br><h2>Detecci\u00f3n humana por IA para filtrar eficazmente falsas alarmas <\/h2><h2>Advertirle solo cuando se detecta una persona<\/h2>Cuando se detecta a un humano en el campo de visi\u00f3n, el algoritmo de detecci\u00f3n humana de IA de nueva generaci\u00f3n comienza autom\u00e1ticamente a grabar alarmas de video y env\u00eda un recordatorio a su tel\u00e9fono inteligente.<br><br><h2>Advertencia sonora y visual, defensa activa Alarmas instant\u00e1neas enviadas a su tel\u00e9fono inteligente<\/h2>Cuando la c\u00e1mara detecta a alguien en el \u00e1rea de monitoreo, activar\u00e1 autom\u00e1ticamente una alarma audible con luces intermitentes, ahuyentando a posibles intrusos. Tambi\u00e9n enviar\u00e1 simult\u00e1neamente un mensaje de alarma a la aplicaci\u00f3n Mi Home\/aplicaci\u00f3n Xiaomi Home.<br><br><h2>Fotograf\u00eda a intervalos <\/h2><h2>Graba tus maravillosos recuerdos<\/h2>Active la funci\u00f3n de fotograf\u00eda a intervalos y deje que la c\u00e1mara condense y presente los detalles. Crea algo grandioso a partir del esplendor al aire libre.<br><br><h2>Chip de seguridad MJA1 M\u00e1xima privacidad y seguridad<\/h2>Cada chip de seguridad MJA1 tiene su propia clave privada y certificado para garantizar la seguridad de las comunicaciones y el almacenamiento.<br><br><h2>Almacenamiento dual local y en la nube <\/h2><h2>Doble protecci\u00f3n de la informaci\u00f3n cr\u00edtica<\/h2>Almacene grabaciones de video a trav\u00e9s de varios m\u00e9todos de almacenamiento, incluida la tarjeta microSD local* y la grabaci\u00f3n en bucle autom\u00e1tica. Los v\u00eddeos tambi\u00e9n se pueden almacenar a trav\u00e9s de un servicio de almacenamiento en la nube. Una vez que se activa el servicio, los videos se cargan autom\u00e1ticamente en la nube y se habilitan simult\u00e1neamente funciones de monitoreo como el reconocimiento facial con IA y la grabaci\u00f3n din\u00e1mica de video en tiempo real.<br><br><h2>Montaje en techo, lateral y en poste Instalaci\u00f3n flexible para cualquier entorno al aire libre<\/h2>Hay tres m\u00e9todos de instalaci\u00f3n disponibles: montaje en techo, lateral o en poste. Los usuarios pueden elegir el m\u00e9todo de instalaci\u00f3n que requieran.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Resoluci\u00f3n<\/li>  <li>2560 x 1440<\/li>  <li>Abertura<\/li>  <li>F1.6<\/li>  <li>\u00c1ngulo de la lente<\/li>  <li>113\u00b0<\/li>  <li>Codificaci\u00f3n de v\u00eddeo<\/li>  <li>H.265<\/li>  <li>Conectividad inal\u00e1mbrica<\/li>  <li>Wi-Fi IEEE 802.11b\/g\/n 2,4 GHz<\/li>  <li>Modo de almacenamiento<\/li>  <li>Tarjeta MicroSD (admite hasta 256 GB)<\/li>  <li>Compatible con<\/li>  <li>Android 8.0 o iOS 12.0 y superior<\/li>  <li>Entrada nominal<\/li>  <li>12V\/1A<\/li>  <li>Clasificaci\u00f3n de resistencia al agua<\/li>  <li>IP66<\/li>  <li>Temperatura de trabajo del producto<\/li>  <li>-30\u00b0C&#8211;60\u00b0C<\/li>  <li>Temperatura de trabajo del adaptador<\/li>  <li>-30\u00b0C&#8211;45\u00b0C<\/li>  <li><b>Contenido del paquete<\/b>  <\/li><li>C\u00e1mara x1<\/li>  <li>Adaptador de corriente x1<\/li>  <li>Soporte de montaje en pared x1<\/li>  <li>Tira de goma impermeable para cable de alimentaci\u00f3n x1<\/li>  <li>1 pegatina de plantilla para montaje en pared o techo.<\/li>  <li>Paquete de accesorios de tornillo x1<\/li>  <li>Manual de usuario x1<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-cam%20out%20cam%20cw400_1.jpg","wholesale_price":"52.86","unit_price_tax":57.86},"product_model":{"product_data":{"ean13":["6941812744307"],"reference":"OUT CAM CW400","name":{"1":"C\u00e1mara de Videovigilancia Xiaomi Outdoor Camera CW400\/ 113\u00ba\/ Visi\u00f3n Nocturna\/ Control desde APP","2":"","3":"","4":""},"description":{"1":"<p><h2>Calidad de imagen ultra clara de 2.5K, seguridad inteligente para condiciones clim\u00e1ticas adversas<\/h2>Visi\u00f3n nocturna inteligente a todo color | Resistencia al agua IP66 | Red de doble antena | Soporte de voz bidireccional | Detecci\u00f3n humana por IA | Sistemas de aviso ac\u00fastico y visual | Fotograf\u00eda a intervalos<br><br><h2>4 MP con gran apertura Calidad de imagen ultra clara de 2,5 K<\/h2>Im\u00e1genes ultra claras de 4 MP y 2,5 K con una lente de gran apertura f\/1,6 con un sensor de imagen de alto rendimiento. Obtenga detalles m\u00e1s brillantes y claros con im\u00e1genes de mayor calidad.<br><br><h2>Visi\u00f3n nocturna inteligente a todo color con cuatro luces Im\u00e1genes verdaderamente claras, incluso en las noches oscuras<\/h2>Capture im\u00e1genes coloridas incluso en entornos con poca luz. Las luces blancas incorporadas se encienden autom\u00e1ticamente cuando se reconoce a un ser humano por la noche.<br><br><h2>Dise\u00f1o profesional con resistencia al agua IP66 Listo para condiciones clim\u00e1ticas adversas<\/h2>El dise\u00f1o profesional resistente al agua IP66 para exteriores garantiza un uso confiable en exteriores y se adapta f\u00e1cilmente a entornos exteriores complejos.<br><br><h2>Gimbals duales horizontales y verticales M\u00e1s flexibles y confiables<\/h2>Dise\u00f1o de card\u00e1n dual con vista horizontal de 360\u00b0 y vista vertical de 160\u00b0 para brindar una soluci\u00f3n de seguridad completa.<br><br><h2>Dise\u00f1o de antena dual de alta ganancia Se\u00f1al Wi-Fi mejorada y m\u00e1s clara<\/h2>El dise\u00f1o integrado de antena dual de alta ganancia garantiza la estabilidad a larga distancia de la red de c\u00e1maras, aumentando la distancia de transmisi\u00f3n.<br><br><h2>Llamadas de voz bidireccionales para facilitar la conversaci\u00f3n Cancelaci\u00f3n de ruido inteligente para cualquier entorno al aire libre<\/h2>Con un micr\u00f3fono incorporado de alta sensibilidad y un altavoz de alta potencia y alta calidad. Capta f\u00e1cilmente el sonido desde largas distancias para que tus di\u00e1logos sean tan claros como si te estuvieras comunicando cara a cara.<br><br><h2>Detecci\u00f3n humana por IA para filtrar eficazmente falsas alarmas <\/h2><h2>Advertirle solo cuando se detecta una persona<\/h2>Cuando se detecta a un humano en el campo de visi\u00f3n, el algoritmo de detecci\u00f3n humana de IA de nueva generaci\u00f3n comienza autom\u00e1ticamente a grabar alarmas de video y env\u00eda un recordatorio a su tel\u00e9fono inteligente.<br><br><h2>Advertencia sonora y visual, defensa activa Alarmas instant\u00e1neas enviadas a su tel\u00e9fono inteligente<\/h2>Cuando la c\u00e1mara detecta a alguien en el \u00e1rea de monitoreo, activar\u00e1 autom\u00e1ticamente una alarma audible con luces intermitentes, ahuyentando a posibles intrusos. Tambi\u00e9n enviar\u00e1 simult\u00e1neamente un mensaje de alarma a la aplicaci\u00f3n Mi Home\/aplicaci\u00f3n Xiaomi Home.<br><br><h2>Fotograf\u00eda a intervalos <\/h2><h2>Graba tus maravillosos recuerdos<\/h2>Active la funci\u00f3n de fotograf\u00eda a intervalos y deje que la c\u00e1mara condense y presente los detalles. Crea algo grandioso a partir del esplendor al aire libre.<br><br><h2>Chip de seguridad MJA1 M\u00e1xima privacidad y seguridad<\/h2>Cada chip de seguridad MJA1 tiene su propia clave privada y certificado para garantizar la seguridad de las comunicaciones y el almacenamiento.<br><br><h2>Almacenamiento dual local y en la nube <\/h2><h2>Doble protecci\u00f3n de la informaci\u00f3n cr\u00edtica<\/h2>Almacene grabaciones de video a trav\u00e9s de varios m\u00e9todos de almacenamiento, incluida la tarjeta microSD local* y la grabaci\u00f3n en bucle autom\u00e1tica. Los v\u00eddeos tambi\u00e9n se pueden almacenar a trav\u00e9s de un servicio de almacenamiento en la nube. Una vez que se activa el servicio, los videos se cargan autom\u00e1ticamente en la nube y se habilitan simult\u00e1neamente funciones de monitoreo como el reconocimiento facial con IA y la grabaci\u00f3n din\u00e1mica de video en tiempo real.<br><br><h2>Montaje en techo, lateral y en poste Instalaci\u00f3n flexible para cualquier entorno al aire libre<\/h2>Hay tres m\u00e9todos de instalaci\u00f3n disponibles: montaje en techo, lateral o en poste. Los usuarios pueden elegir el m\u00e9todo de instalaci\u00f3n que requieran.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Resoluci\u00f3n<\/li>  <li>2560 x 1440<\/li>  <li>Abertura<\/li>  <li>F1.6<\/li>  <li>\u00c1ngulo de la lente<\/li>  <li>113\u00b0<\/li>  <li>Codificaci\u00f3n de v\u00eddeo<\/li>  <li>H.265<\/li>  <li>Conectividad inal\u00e1mbrica<\/li>  <li>Wi-Fi IEEE 802.11b\/g\/n 2,4 GHz<\/li>  <li>Modo de almacenamiento<\/li>  <li>Tarjeta MicroSD (admite hasta 256 GB)<\/li>  <li>Compatible con<\/li>  <li>Android 8.0 o iOS 12.0 y superior<\/li>  <li>Entrada nominal<\/li>  <li>12V\/1A<\/li>  <li>Clasificaci\u00f3n de resistencia al agua<\/li>  <li>IP66<\/li>  <li>Temperatura de trabajo del producto<\/li>  <li>-30\u00b0C&#8211;60\u00b0C<\/li>  <li>Temperatura de trabajo del adaptador<\/li>  <li>-30\u00b0C&#8211;45\u00b0C<\/li>  <li><b>Contenido del paquete<\/b>  <\/li><li>C\u00e1mara x1<\/li>  <li>Adaptador de corriente x1<\/li>  <li>Soporte de montaje en pared x1<\/li>  <li>Tira de goma impermeable para cable de alimentaci\u00f3n x1<\/li>  <li>1 pegatina de plantilla para montaje en pared o techo.<\/li>  <li>Paquete de accesorios de tornillo x1<\/li>  <li>Manual de usuario x1<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":57.86,"unit_price_tax":57.86,"tax_rules_group":null,"category":"Videovigilancia","sub_category":"Camaras Videovigilancia","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-cam%20out%20cam%20cw400_1.jpg"],"wholesale_price":52.86}}}}