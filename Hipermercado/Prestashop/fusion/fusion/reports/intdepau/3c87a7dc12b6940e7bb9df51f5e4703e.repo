a: .MPG\/ .AV\/ .MOV\/ .MKV\/ .MP4<\/li><li>Formato de Audio: .MP3\/ .AMM\/ .AAC\/ .M4a&nbsp;<\/li><li>Formato de imagen: .JPG\/ .JPEG\/ .BMP\/ .GIF \/.PNG\/ .GIF<\/li><li><b>Altavoz:<\/b><\/li><li>3W<\/li><li><b>Bajo ruido<\/b><\/li><li><b>Funciones:<\/b><\/li><li>Modos de proyecci\u00f3n: frontal, trasera y en techo<\/li><li>Protecci\u00f3n de vista difusa<\/li><li>Conexi\u00f3n OSD (iOS)<\/li><li>Dise\u00f1o antipolvo<\/li><li>Ventiladores dobles<\/li><li>Conexi\u00f3n WiFi 2.4G, compatible con Android e iOS<\/li><li><b>Interfaz<\/b><\/li><li>1 x USB 2.0<\/li><li>1 x HDMI 1.4<\/li><li>1 x Puerto A\/V anal\u00f3gico<\/li><li>1 x Jack 3.5 mm de audio<\/li><li>1 x Conexi\u00f3n el\u00e9ctrica<\/li><li><b>Potencia<\/b><\/li><li>Entrada de alimentaci\u00f3n DC<\/li><li><b>Vida \u00fatil de la lampara<\/b><\/li><li>M\u00e1s de 20 000 horas de vida \u00fatil de la l\u00e1mpara<\/li><li><b>Voltaje:&nbsp;<\/b><\/li><li>100~240V, 50-60 Hz<\/li><li><b>Dimensiones:<\/b>&nbsp;<\/li><li>22 x 18.5 x 8 cm<\/li><li><b>Peso:&nbsp;<\/b><\/li><li>1.23 Kg<\/li><li><b>Color:&nbsp;<\/b><\/li><li>Blanco<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"WANBO","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":84.18,"unit_price_tax":84.18,"tax_rules_group":null,"category":"Proyectores","sub_category":"Proyectores","quantity":0,"brand":"WANBO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wan-proy%20x1%20max_1.jpg"],"wholesale_price":77.18}}},"6944762700324":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6944762700324",false],"wholesale_price":[25.9,false],"price":[32.9,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false