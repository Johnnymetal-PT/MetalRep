d mental y visual te ayudan a cuidar cuerpo y mente desde la mu\u00f1eca.<\/p><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0.26,"unit_price":225.84,"unit_price_tax":225.84,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":2,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20mxej3qlbardera_1.jpg"],"wholesale_price":220.84}}},"8436533798237":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436533798237",false],"wholesale_price":[18.07,false],"price":[23.07,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.34",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:224675","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0f8791a23cfe47ffb95c1eab436d165a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Inal\u00e1mbricos Daewoo DW2010\/ con Micr\u00f3fono\/ Bluetooth\/ Blancos","category":"Auriculares","sub_category":"Auriculares","unit_price":23.07,"reference":"DW2010","ean13":"8436533798237","weight":"0.34","quantity":5,"brand":"DAEWOO","description_pt":"<p><\/p><h2>Auriculares Inal\u00e1mbricos Daewoo DW2010<\/h2><h2>Especificaiones<\/h2><ul><li>Micr\u00f3fono&nbsp;integrado<\/li><li>Asistente&nbsp;virtual<\/li><li>Bluetooth