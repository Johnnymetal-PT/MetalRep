:<\/b> 93 x 296 x 309 mm<\/li><li><b>Peso:<\/b> 5.06 kg<\/li><\/ul><\/div>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ASUS","supplier":null,"width":null,"height":null,"depth":null,"weight":5.9,"unit_price":506,"unit_price_tax":506,"tax_rules_group":null,"category":"Ordenadores","sub_category":"Ordenadores Sobremesa","quantity":5,"brand":"ASUS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_asu-d%20p500sv-13420h032x_1.jpg"],"wholesale_price":499}}},"4711636211666":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4711636211666",false],"wholesale_price":[319,false],"price":[326,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 6",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:290155","Cat. IDs: 187","Associated Categories","Cat. Default: 187","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2ab15a44ceecf992b8ef7c211b68ff15.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"PC Asus ExpertCenter P500SV-31315U0210 Intel Core i3-1315U\/ 16GB\/ 512GB SSD\/ Sin Sistema Operativo","category":"Ordenadores","sub_category":"Ordenadores Sobremesa","unit_price":326,"reference":"90PF05A1-M00AN0","ean13":"4711636211666","weight":"6","quantity":5,"brand":"ASUS","description_pt":"<h2>ASUS ExpertCenter P500<\/h2><h2>Valor y rendimiento excepcionales para las empresas<\/h2><p>El ASUS ExpertCenter P