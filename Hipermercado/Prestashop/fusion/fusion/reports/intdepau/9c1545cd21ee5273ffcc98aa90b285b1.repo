Rendimiento de trazado de rayos de hasta 2x<\/p><\/div><div><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li><b>Procesamiento de gr\u00e1ficos<\/b><\/li><li>GeForce RTX&#8482; 4060<\/li><li><b>Reloj de n\u00facleo<\/b><\/li><li>2475 MHz (Tarjeta de referencia: 2460 MHz)<\/li><li><b>N\u00facleos CUDA\u00ae<\/b><\/li><li>3072<\/li><li><b>Reloj de la memoria<\/b><\/li><li>17 Gb\/s<\/li><li><b>Tama\u00f1o de la memoria<\/b><\/li><li>8GB<\/li><li><b>Tipo de memoria<\/b><\/li><li>GDDR6<\/li><li><b>Bus de memoria<\/b><\/li><li>128 bits<\/li><li><b>Tarjeta de autob\u00fas<\/b><\/li><li>PCI-E 4.0<\/li><li><b>Resoluci\u00f3n m\u00e1xima digital<\/b><\/li><li>7680x4320<\/li><li><b>Vista m\u00faltiple<\/b><\/li><li>4<\/li><li><b>Tama\u00f1o de la tarjeta<\/b><\/li><li>Largo=192 Ancho=120 Alto=41 mm<\/li><li><b>Forma de placa de circuito impreso<\/b><\/li><li>ATX<\/li><li><b>DirectX<\/b><\/li><li>12 \u00faltimo<\/li><li><b>OpenGL<\/b><\/li><li>4.6<\/li><li><b>Fuente de alimentaci\u00f3n recomendada<\/b><\/li><li>450W<\/li><li><b>Conectores de alimentaci\u00f3n<\/b><\/li><li>8 pines * 1<\/li><li><b>Producci\u00f3n<\/b><\/li><li>DisplayPort 1.4a*2<\/li><li>HDMI 2.1a*2<\/li><li><b>Accesorios<\/b><\/li><li>Gu\u00eda r\u00e1pida<\/li><\/ul><\/p><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GIGABYTE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":272.95,"unit_price_tax":272.95,"tax_rules_group":null,"category":"Componentes","sub_category":"Tarjetas Graficas","quantity":0,"brand":"GIGABYTE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_gig-gf%20rtx4060%20winf%20oc%208g_1.jpg"],"wholesale_price":267.95}}},"4719331313661":{"result":true,"need_alert":true,"report":{"notes"