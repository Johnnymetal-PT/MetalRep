d\/art_tru-malet%20sydney%2016%20bk_1.jpg"],"wholesale_price":17.27}}},"8713439241921":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8713439241921",false],"wholesale_price":[38.5,false],"price":[43.5,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Suporte de resfriamento Trust Gaming GXT 1126 Aura para laptops de at\u00e9 17&#39;"],"result":false},"feed_data":{"name_pt":"Soporte Refrigerante Trust Gaming GXT 1126 Aura para Port\u00e1tiles hasta 17'","category":"Accesorios de Portatiles","sub_category":"Dockstation Bases Refrigeradoras","unit_price":43.5,"reference":"24192","ean13":"8713439241921","weight":"1.25","quantity":2,"brand":"TRUST GAMING","description_pt":"                                                <p><h2>Fr\u00edo\u00a0y\u00a0sereno<\/h2><p>Mant\u00e9n el port\u00e1til refrigerado durante acaloradas sesiones de juego y adopta una postura ergon\u00f3mica para reducir la tensi\u00f3n en el cuello y la espalda, sin olvidar la presencia imponente que proyectas gracias a la iluminaci\u00f3n multicolor. Completa tu look de gamer y proclama tu victoria a los cuatro vientos.<\/p><h2>Flujo\u00a0de\u00a0aire<\/h2><p>El Aura de Trust utiliza un ventilador de 200\u00a0mm para mantener el port\u00e1til refrigerado en los momentos m\u00e1s \u00e1lgidos del juego. El gaming puede exigir mucho a un port\u00e1til. Y puesto que el hardware se esfuerza para ofrecerte una gran experiencia de gaming, este ventilador garantiza que el port\u00e1til est\u00e9 refrigerado y funcione sin problemas. En los casos en que la partida no exija tantos recursos, cambia al modo silencioso para disfrutar de una relajante y refrescante brisa.<\/p><h2>Ergonom\u00eda<\/h2><p>Este pedestal de refrigeraci\u00f3n es adecuado para ordenadores port\u00e1tiles de hasta 17,3 pulgadas. Por lo general, el uso del port\u00e1til puede causar tensi\u00f3n en el cuello o la espalda debido a un mal \u00e1ngulo de visi\u00f3n. Pero esto no sucede con el Aura de Trust. El \u00e1ngulo del Aura se ajusta en 4 pasos diferentes, hasta 210\u00a0mm de altura, para crear un \u00e1ngulo de visi\u00f3n ergon\u00f3mico que se adapte mejor al usuario.<\/p><h2>La\u00a0imagen\u00a0tambi\u00e9n\u00a0importa<\/h2><p>La malla met\u00e1lica no solo existe para ofrecer un buen flujo de aire, sino que tambi\u00e9n puede aportar un look atrevido al equipo de gaming. Y puesto que en el gaming hay que destacar, la iluminaci\u00f3n multicolor ajustable aporta una imagen muy especial. Elige entre 5 modos de color diferentes (ne\u00f3n, arco iris, respiraci\u00f3n, s\u00f3lido, parpadeo, apagado) y consigue un equipo de gaming que sea solo tuyo.<\/p><p><br><\/p><ul><li><b>Especificaciones<\/b><\/li><li>General<\/li><li>m\u00e1x. tama\u00f1o del port\u00e1til<\/li><li>17 '<\/li><li>m\u00e1x. peso<\/li><li>10 kg<\/li><li>m\u00e1x. altura de elevaci\u00f3n<\/li><li>20 cent\u00edmetros<\/li><li>Ventilador incluido<\/li><li>200 mm<\/li><li>Altura del producto principal (en mm)<\/li><li>26mm<\/li><li>Ancho del producto principal (en mm)<\/li><li>421mm<\/li><li>Profundidad del producto principal (en mm)<\/li><li>312mm<\/li><li>Peso total<\/li><li>1000 gramos<\/li><li>Caracter\u00edsticas<\/li><li>Antideslizante<\/li><li>s\u00ed<\/li><li>N\u00famero de fan\u00e1ticos<\/li><li>1<\/li><li>Tama\u00f1o del ventilador<\/li><li>200mm<\/li><li>Nivel de ruido (rango)<\/li><li>25 dBA - 30 dBA<\/li><li>Velocidad de rotaci\u00f3n<\/li><li>450 RPM - 700 RPM<\/li><li>Flujo de aire<\/li><li>13 CFM - 68 CFM<\/li><li>Tipo de rodamiento<\/li><li>Manga<\/li><li>Control<\/li><li>Bot\u00f3n de encendido \/ apagado<\/li><li>s\u00ed<\/li><li>Conectividad<\/li><li>cables incluidos<\/li><li>Cable USB a CC de 80 cm<\/li><li>Encendido<\/li><li>Luces<\/li><li>s\u00ed<\/li><li>Colores LED<\/li><li>RGB completo<\/li><li>Ajustabilidad<\/li><li>Ajuste de altura (pasos)<\/li><li>5 pasos<\/li><li>Altura ajustable<\/li><li>s\u00ed<\/li><li>Aporte<\/li><li>Fuente de alimentaci\u00f3n<\/li><li>USB<\/li><li>Compatibilidad<\/li><li>Tipos de dispositivos compatibles<\/li><li>ordenador port\u00e1til<\/li><\/ul><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-ref%20gxt%201126%20aura_1.jpg","wholesale_price":"38.50","unit_price_tax":43.5},"product_model":{"product_data":{"ean13":["8713439241921"],"reference":"24192","name":{"1":"Soporte Refrigerante Trust Gaming GXT 1126 Aura para Port\u00e1tiles hasta 17'","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Fr\u00edo\u00a0y\u00a0sereno<\/h2><p>Mant\u00e9n el port\u00e1til refrigerado durante acaloradas sesiones de juego y adopta una postura ergon\u00f3mica para reducir la tensi\u00f3n en el cuello y la espalda, sin olvidar la presencia imponente que proyectas gracias a la iluminaci\u00f3n multicolor. Completa tu look de gamer y proclama tu victoria a los cuatro vientos.<\/p><h2>Flujo\u00a0de\u00a0aire<\/h2><p>El Aura de Trust utiliza un ventilador de 200\u00a0mm para mantener el port\u00e1til refrigerado en los momentos m\u00e1s \u00e1lgidos del juego. El gaming puede exigir mucho a un port\u00e1til. Y puesto que el hardware se esfuerza para ofrecerte una gran experiencia de gaming, este ventilador garantiza que el port\u00e1til est\u00e9 refrigerado y funcione sin problemas. En los casos en que la partida no exija tantos recursos, cambia al modo silencioso para disfrutar de una relajante y refrescante brisa.<\/p><h2>Ergonom\u00eda<\/h2><p>Este pedestal de refrigeraci\u00f3n es adecuado para ordenadores port\u00e1tiles de hasta 17,3 pulgadas. Por lo general, el uso del port\u00e1til puede causar tensi\u00f3n en el cuello o la espalda debido a un mal \u00e1ngulo de visi\u00f3n. Pero esto no sucede con el Aura de Trust. El \u00e1ngulo del Aura se ajusta en 4 pasos diferentes, hasta 210\u00a0mm de altura, para crear un \u00e1ngulo de visi\u00f3n ergon\u00f3mico que se adapte mejor al usuario.<\/p><h2>La\u00a0imagen\u00a0tambi\u00e9n\u00a0importa<\/h2><p>La malla met\u00e1lica no solo existe para ofrecer un buen flujo de aire, sino que tambi\u00e9n puede aportar un look atrevido al equipo de gaming. Y puesto que en el gaming hay que destacar, la iluminaci\u00f3n multicolor ajustable aporta una imagen muy especial. Elige entre 5 modos de color diferentes (ne\u00f3n, arco iris, respiraci\u00f3n, s\u00f3lido, parpadeo, apagado) y consigue un equipo de gaming que sea solo tuyo.<\/p><p><br><\/p><ul><li><b>Especificaciones<\/b><\/li><li>General<\/li><li>m\u00e1x. tama\u00f1o del port\u00e1til<\/li><li>17 '<\/li><li>m\u00e1x. peso<\/li><li>10 kg<\/li><li>m\u00e1x. altura de elevaci\u00f3n<\/li><li>20 cent\u00edmetros<\/li><li>Ventilador incluido<\/li><li>200 mm<\/li><li>Altura del producto principal (en mm)<\/li><li>26mm<\/li><li>Ancho del producto principal (en mm)<\/li><li>421mm<\/li><li>Profundidad del producto principal (en mm)<\/li><li>312mm<\/li><li>Peso total<\/li><li>1000 gramos<\/li><li>Caracter\u00edsticas<\/li><li>Antideslizante<\/li><li>s\u00ed<\/li><li>N\u00famero de fan\u00e1ticos<\/li><li>1<\/li><li>Tama\u00f1o del ventilador<\/li><li>200mm<\/li><li>Nivel de ruido (rango)<\/li><li>25 dBA - 30 dBA<\/li><li>Velocidad de rotaci\u00f3n<\/li><li>450 RPM - 700 RPM<\/li><li>Flujo de aire<\/li><li>13 CFM - 68 CFM<\/li><li>Tipo de rodamiento<\/li><li>Manga<\/li><li>Control<\/li><li>Bot\u00f3n de encendido \/ apagado<\/li><li>s\u00ed<\/li><li>Conectividad<\/li><li>cables incluidos<\/li><li>Cable USB a CC de 80 cm<\/li><li>Encendido<\/li><li>Luces<\/li><li>s\u00ed<\/li><li>Colores LED<\/li><li>RGB completo<\/li><li>Ajustabilidad<\/li><li>Ajuste de altura (pasos)<\/li><li>5 pasos<\/li><li>Altura ajustable<\/li><li>s\u00ed<\/li><li>Aporte<\/li><li>Fuente de alimentaci\u00f3n<\/li><li>USB<\/li><li>Compatibilidad<\/li><li>Tipos de dispositivos compatibles<\/li><li>ordenador port\u00e1til<\/li><\/ul><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRUST GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":1.25,"unit_price":43.5,"unit_price_tax":43.5,"tax_rules_group":null,"category":"Accesorios de Portatiles","sub_category":"Dockstation Bases Refrigeradoras","quantity":2,"brand":"TRUST GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-ref%20gxt%201126%20aura_1.jpg"],"wholesale_price":38.5}}},"8435089016543":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8435089016543",false],"wholesale_price":[12.96,false],"price":[17.96,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Suporte de resfriamento de notebook Woxter 1560R para laptops de at\u00e9 17&#39;\/ilumina\u00e7\u00e3o LED"],"result":false},"feed_data":{"name_pt":"Soporte Refrigerante Woxter Notebook Cooling Pad 1560R para Port\u00e1tiles hasta 17'\/ Iluminaci\u00f3n LED","category":"Accesorios de Portatiles","sub_category":"Dockstation Bases Refrigeradoras","unit_price":17.96,"reference":"PE26-078","ean13":"8435089016543","weight":"0.95","quantity":5,"brand":"WOXTER","description_pt":"<p><h2>Base refrigeradora para port\u00e1tiles, 5 ventiladores desconectables, luz led azul y 2 puertos USB especialmente dise\u00f1ado para gamers<\/h2>Woxter Notebook Cooling Pad 1560R es un silencioso ventilador dise\u00f1ado especialmente para refrigerar port\u00e1tiles de 10 a 17\u0094. Con este ventilador podr\u00e1s reducir la temperatura de tu port\u00e1til de manera eficaz. Esta base ofrece un dise\u00f1o totalmente ergon\u00f3mico y cuenta con dos puertos USB 2.0 (uno para alimentarlo y otro para conectar dispositivos externos). Adem\u00e1s de soportes antideslizantes de goma anti-ara\u00f1azos, este ventilador es compatible con la mayor\u00eda de los port\u00e1tiles del mercado.<br><br>La luz led y el funcionamiento de los ventiladores se pueden regular seg\u00fan tus necesidades.<br><h2>Caracter\u00edsticas del ventilador para port\u00e1tiles Woxter Cooling Pad 1560R<\/h2><ul>  <li>Integra un gran ventilador de 16 cm y 4 peque\u00f1os ventiladores perif\u00e9ricos que permiten reducir eficazmente la temperatura de su ordenador port\u00e1til, llegando a una temperatura m\u00e1xima de 22\u00ba C.<\/li>  <li>Los 5 ventiladores integran LEDs azules consiguiendo una luz ambiental de trabajo muy relajante.<\/li>  <li>Botones de control de luz y ventiladores.<\/li>  <li>Velocidad del ventilador: 900-2800 rpm.<\/li>  <li>Flujo m\u00e1ximo de aire: 74.35 CFM.<\/li>  <li>Soporte con altura regulable y ergon\u00f3mico dise\u00f1o lo que ofrece la m\u00e1xima comodidad, estabilidad y productividad a la hora de utilizar su ordenador. Consigue minimizar cualquier molestia o dolor que pueda suponer el uso de un ordenador port\u00e1til para cuello, mu\u00f1ecas, etc.<\/li>  <li>Super silencioso: 30 dBa.<\/li>  <li>Consumo directo desde el ordenador port\u00e1til.<\/li>  <li>4 soportes antideslizantes de goma anti-ara\u00f1azos.<\/li>  <li>1 puerto USB HUB para poder conectar tambi\u00e9n unidades externas.<\/li>  <li>Compatible con la mayor\u00eda de ordenadores port\u00e1tiles del mercado.<\/li>  <li>Dimensiones: 385x290x42 mm. Peso: 630 g.<\/li>  <li>    <h2>Especificaciones y uso<\/h2>  <\/li>  <ul>    <li>Base refrigeradora para port\u00e1tiles, 5 ventiladores desconectables, luz led azul y 2 puertos USB especialmente dise\u00f1ado para gamers. Woxter Notebook Cooling Pad 1560R es un silencioso ventilador dise\u00f1ado especialmente para port\u00e1tiles de 10 a 17\u0094<\/li>    <li>Cooling pad realizado en ABS de m\u00e1xima calidad. Refrigera tu ordenador aportando una vida \u00fatil mucho mayor en sus componentes. Est\u00e1 especialmente dise\u00f1ado para Gamers, mejora notablemente la refrigeraci\u00f3n<\/li>    <li>Integra un gran ventilador de 16 cm y 4 peque\u00f1os ventiladores perif\u00e9ricos \/ LEDs azules \/ Botones de control de luz y ventiladores \/ Dos puertos USB HUB para poder conectar tambi\u00e9n unidades externas<\/li>    <li>Base led iluminada: Sus 5 ventiladores est\u00e1n iluminados mediante una agradable luz led azul ajustable creando una atm\u00f3sfera gaming perfecta<\/li>    <li>COMPATIBLE CON LA MAYOR\u00cdA DE ORDENADORES PORT\u00c1TILES \/ Powered By Woxter<\/li>  <\/ul><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wox-ref%20pe26-078_1.jpg","wholesale_price":"12.96","unit_price_tax":17.96},"product_model":{"product_data":{"ean13":["8435089016543"],"reference":"PE26-078","name":{"1":"Soporte Refrigerante Woxter Notebook Cooling Pad 1560R para Port\u00e1tiles hasta 17'\/ Iluminaci\u00f3n LED","2":"","3":"","4":""},"description":{"1":"<p><h2>Base refrigeradora para port\u00e1tiles, 5 ventiladores desconectables, luz led azul y 2 puertos USB especialmente dise\u00f1ado para gamers<\/h2>Woxter Notebook Cooling Pad 1560R es un silencioso ventilador dise\u00f1ado especialmente para refrigerar port\u00e1tiles de 10 a 17\u0094. Con este ventilador podr\u00e1s reducir la temperatura de tu port\u00e1til de manera eficaz. Esta base ofrece un dise\u00f1o totalmente ergon\u00f3mico y cuenta con dos puertos USB 2.0 (uno para alimentarlo y otro para conectar dispositivos externos). Adem\u00e1s de soportes antideslizantes de goma anti-ara\u00f1azos, este ventilador es compatible con la mayor\u00eda de los port\u00e1tiles del mercado.<br><br>La luz led y el funcionamiento de los ventiladores se pueden regular seg\u00fan tus necesidades.<br><h2>Caracter\u00edsticas del ventilador para port\u00e1tiles Woxter Cooling Pad 1560R<\/h2><ul>  <li>Integra un gran ventilador de 16 cm y 4 peque\u00f1os ventiladores perif\u00e9ricos que permiten reducir eficazmente la temperatura de su ordenador port\u00e1til, llegando a una temperatura m\u00e1xima de 22\u00ba C.<\/li>  <li>Los 5 ventiladores integran LEDs azules consiguiendo una luz ambiental de trabajo muy relajante.<\/li>  <li>Botones de control de luz y ventiladores.<\/li>  <li>Velocidad del ventilador: 900-2800 rpm.<\/li>  <li>Flujo m\u00e1ximo de aire: 74.35 CFM.<\/li>  <li>Soporte con altura regulable y ergon\u00f3mico dise\u00f1o lo que ofrece la m\u00e1xima comodidad, estabilidad y productividad a la hora de utilizar su ordenador. Consigue minimizar cualquier molestia o dolor que pueda suponer el uso de un ordenador port\u00e1til para cuello, mu\u00f1ecas, etc.<\/li>  <li>Super silencioso: 30 dBa.<\/li>  <li>Consumo directo desde el ordenador port\u00e1til.<\/li>  <li>4 soportes antideslizantes de goma anti-ara\u00f1azos.<\/li>  <li>1 puerto USB HUB para poder conectar tambi\u00e9n unidades externas.<\/li>  <li>Compatible con la mayor\u00eda de ordenadores port\u00e1tiles del mercado.<\/li>  <li>Dimensiones: 385x290x42 mm. Peso: 630 g.<\/li>  <li>    <h2>Especificaciones y uso<\/h2>  <\/li>  <ul>    <li>Base refrigeradora para port\u00e1tiles, 5 ventiladores desconectables, luz led azul y 2 puertos USB especialmente dise\u00f1ado para gamers. Woxter Notebook Cooling Pad 1560R es un silencioso ventilador dise\u00f1ado especialmente para port\u00e1tiles de 10 a 17\u0094<\/li>    <li>Cooling pad realizado en ABS de m\u00e1xima calidad. Refrigera tu ordenador aportando una vida \u00fatil mucho mayor en sus componentes. Est\u00e1 especialmente dise\u00f1ado para Gamers, mejora notablemente la refrigeraci\u00f3n<\/li>    <li>Integra un gran ventilador de 16 cm y 4 peque\u00f1os ventiladores perif\u00e9ricos \/ LEDs azules \/ Botones de control de luz y ventiladores \/ Dos puertos USB HUB para poder conectar tambi\u00e9n unidades externas<\/li>    <li>Base led iluminada: Sus 5 ventiladores est\u00e1n iluminados mediante una agradable luz led azul ajustable creando una atm\u00f3sfera gaming perfecta<\/li>    <li>COMPATIBLE CON LA MAYOR\u00cdA DE ORDENADORES PORT\u00c1TILES \/ Powered By Woxter<\/li>  <\/ul><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"WOXTER","supplier":null,"width":null,"height":null,"depth":null,"weight":0.95,"unit_price":17.96,"unit_price_tax":17.96,"tax_rules_group":null,"category":"Accesorios de Portatiles","sub_category":"Dockstation Bases Refrigeradoras","quantity":5,"brand":"WOXTER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wox-ref%20pe26-078_1.jpg"],"wholesale_price":12.96}}},"8436531559823":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436531559823",false],"wholesale_price":[8.49,false],"price":[13.49,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.06",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:72068","Cat. IDs: 77,77","Associated Categories","Cat. Default: 77","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/8f6c497473cbb222b4e15daae61a7d14.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auricular Bluetooth\/ Manos Libres 3GO HBT3\/ Negro","category":"Accesorios de SmartPhones","sub_category":"Auriculares SmartPhones","unit_price":13.49,"reference":"HBT3","ean13":"8436531559823","weight":"0.06","quantity":5,"brand":"3GO","description_pt":"<p>HBT es el Earphone Bluetooth de 3GO, un manos libre al alcance de todos los bolsillos.<\/p><p>Con el nuevo HBT3 podr\u00e1s hablar y rechazar llamadas con un solo click, rellamar al \u00faltimo n\u00famero, dispone de marcador por voz y reproductor de m\u00fasica, as\u00ed como recordatorio de llamada entrante.<\/p><p>Para una mayor libertad de movimiento, el HBT3 te da hasta 10 metros de alcance. Se reconecta a tu dispositivo autom\u00e1ticamente y puede hacerlo a dos dispositivos.<\/p><p>Gracias a su bater\u00eda de pol\u00edmeros de Litio, puedes tener hasta 4 horas de conversaci\u00f3n. \u00c9ste te avisar\u00e1 cuando su bater\u00eda est\u00e9 baja. Totalmente compatible con Smartphones, AIO, port\u00e1tiles, etc&#8230;<br><\/p><p><br><\/p><p><p><ul><li><b>Especificaciones<\/b><\/li><li>Bluetooth 5.0+EDR<\/li><li>Chipset WS9623<\/li><li>Frecuencia 2.402~2.483GHz<\/li><li>Alcance 10 Metros<\/li><li>Bater\u00eda 55mAh<\/li><li>Tiempo de conversaci\u00f3n 4 horas<\/li><li>Tiempo en standby 120 horas<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_3go-aur%20hbt3_1.jpg","wholesale_price":"8.49","unit_price_tax":13.49},"product_model":{"product_data":{"ean13":["8436531559823"],"reference":"HBT3","name":{"1":"Auricular Bluetooth\/ Manos Libres 3GO HBT3\/ Negro","2":"","3":"","4":""},"description":{"1":"<p>HBT es el Earphone Bluetooth de 3GO, un manos libre al alcance de todos los bolsillos.<\/p><p>Con el nuevo HBT3 podr\u00e1s hablar y rechazar llamadas con un solo click, rellamar al \u00faltimo n\u00famero, dispone de marcador por voz y reproductor de m\u00fasica, as\u00ed como recordatorio de llamada entrante.<\/p><p>Para una mayor libertad de movim