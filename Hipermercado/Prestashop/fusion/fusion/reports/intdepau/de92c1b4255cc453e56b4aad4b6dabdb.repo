t":["",false],"ean13":["5707055057809",false],"wholesale_price":[35.12,false],"price":[40.12,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.09",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:72101","Cat. IDs: 77,77","Associated Categories","Cat. Default: 77","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/59e947e02e0b519a7c5c069035777253.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auricular Bluetooth para Smartphone Jabra Talk 25 SE\/ Negro","category":"Accesorios de SmartPhones","sub_category":"Auriculares SmartPhones","unit_price":40.12,"reference":"JATALK25SE","ean13":"5707055057809","weight":"0.09","quantity":5,"brand":"JABRA","description_pt":"<p><h2>Talk 25 SE<\/h2>Dise\u00f1ado para que hablar sea m\u00e1s f\u00e1cil.<br><br><h2>Llamadas HD. Conversaciones cristalinas<\/h2>Disfrute de llamadas en alta definici\u00f3n con un micr\u00f3fono omnidireccional y un altavoz din\u00e1mico de 11 mm optimizados para mantener conversaciones cristalinas de gran calidad.<br><br><h2>Notificaciones. Transmisi\u00f3n de GPS y multimedia<\/h2>Talk 25 SE saca el m\u00e1ximo partido a su reproducci\u00f3n multimedia para que pueda transmitir de forma inal\u00e1mbrica indicaciones de GPS, m\u00fasica y podcasts desde su tel\u00e9fono m\u00f3vil. Tambi\u00e9n incluye gu\u00eda de voz que le indica cu\u00e1ndo tiene que recargar el dispositivo y ofrece actualizaciones sobre el estado de la conexi\u00f3n.<br><br><h2>Gran autonom\u00eda para llamadas. Tecnolog\u00eda de ahorro de energ\u00eda<\/h2>Con hasta 9 horas de llamadas y 10 d\u00edas de tiempo en espera, puede hablar sin cables utilizando la conexi\u00f3n Bluetooth durante todo el d\u00eda sin volver a cargar. Gracias a la funci\u00f3n Power Nap, Talk 25 SE se apaga cuando lleva una hora sin conexi\u00f3n para aumentar la autonom\u00eda de la bater\u00eda.<br><br><ul>  <li><b>Audio<\/b><\/li>  <li>Tipo de micr\u00f3fono<\/li>  <li>1 ECM omnidireccional<\/li>  <li>Altavoz<\/li>  <li>Altavoz din\u00e1mico de 11 mm<\/li>  <li>Sensibilidad del micr\u00f3fono<\/li>  <li>-42 dBV\/Pa<\/li>  <li>Rango de frecuencia del altavoz<\/li>  <li>De 100 Hz a 10 kHz<\/li>  <li><b>Facilidad de uso<\/b><\/li>  <li>Dispositivos sincronizados<\/li>  <li>Hasta 8, con dos conectados al mismo tiempo (Multiuse&#8482;)<\/li>  <li>Estilo de sujeci\u00f3n<\/li>  <li>Estilo de sujeci\u00f3n intraauricular (con o sin gancho para la oreja)<\/li>  <li><b>Bater\u00eda<\/b><\/li>  <li>Tiempo de conversaci\u00f3n<\/li>  <li>Hasta 9 horas<\/li>  <li>Tiempo de carga<\/li>  <li>Aproximadamente 2 horas<\/li>  <li>Tiempo de espera<\/li>  <li>Hasta 10 d\u00edas<\/li>  <li><b>Conectividad<\/b><\/li>  <li>Compatibilidad Bluetooth\u00ae<\/li>  <li>Bluetooth\u00ae 5.0<\/li>  <li>Alcance inal\u00e1mbrico<\/li>  <li>Hasta 10 metros<\/li>  <li>Lista de sincronizaci\u00f3n Bluetooth<\/li>  <li>Hasta 8 dispositivos<\/li>  <li><b>General<\/b><\/li>  <li>Dimensiones del auricular (W \u00d7 H \u00d7 D)<\/li>  <li>16.6 x 21.6 x 47.1 mm<\/li>  <li>Contenido del embalaje<\/li>  <li>Auricular Jabra Talk 25 SE - Cable micro USB - 3 EarGels - 2 ganchos para la oreja - Gu\u00eda de inicio r\u00e1pido - Folletos de garant\u00eda y advertencia<\/li>  <li>Peso del auricular<\/li>  <li>8,6 gramos (0,3 oz)<\/li>  <li>Temperatura de funcionamiento<\/li>  <li>De -15 \u00b0C a 55 \u00b0C<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_jab-aur%20talk%2025%20se_1.jpg","wholesale_price":"35.12","unit_price_tax":40.12},"product_model":{"product_data":{"ean13":["5707055057809"],"reference":"JATALK25SE","name":{"1":"Auricular Bluetooth para Smartphone Jabra Talk 25 SE\/ Negro","2":"","3":"","4":