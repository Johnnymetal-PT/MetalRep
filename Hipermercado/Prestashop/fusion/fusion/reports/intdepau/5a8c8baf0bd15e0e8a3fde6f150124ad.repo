0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:136839","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9b157889af5dd8b49be54b47289ef269.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Robot Aspirador Cecotec Conga Flash Connected Titanium\/ Friegasuelos\/ Autonom\u00eda 160 Min\/ control por WiFi","category":"Limpieza de Hogar","sub_category":"Robots Aspirador","unit_price":117.69,"reference":"05794","ean13":"8435484057943","weight":"0","quantity":0,"brand":"CECOTEC","description_pt":"<p><ul>  <li>    <h2>Descripci\u00f3n<\/h2>  <\/li>  <li>Robot aspirador Conga Flash Connected Titanium con tecnolog\u00eda random. 160 minutos de autonom\u00eda. Potencia de succi\u00f3n de 2100 Pa. 3 niveles de potencia y de fregado. Cepillo silicona BestFriend Care. 6 programas. APP. Asistente Virtual Alexa. Programaci\u00f3n.<\/li>  <li>4 in 1: aspira, barre, pasa la mopa y friega.<\/li>  <li>APP Control: aplicaci\u00f3n para smartphone con la que podr\u00e1s controlar tu robot seleccionando los modos de limpieza, programando la limpieza, seleccionando el nivel de potencia de succi\u00f3n y de fregado y observar el historial de limpiezas.<\/li>  <li>Conecta el robot al&nbsp; asistente virtual de control por voz Alexa. Podr\u00e1s realizar varios controles por voz, tales como, empezar la limpieza, parar de limpiar, mandar el robot a su base de carga o incluso localizar el robot por medio de emisiones auditivas. <\/li>  <li>BestFriend Care: cepillo de silicona intercambiable ideal para mascotas y pelo largo.<\/li>  <li>Fregado inteligente con la tecnolog\u00eda iWater. Experimenta un control absoluto con los 3 niveles de fregado apto para todo tipo de superficies.<\/li>  <li>\u00a1Friega por ti! Su sistema Wash4You pasa la mopa y friega con solo ponerle el dep\u00f3sito de l\u00edquidos. Limpia de forma inteligente los m\u00e1ximos metros mediante su avanzado sistema de control electr\u00f3nico que dosifica y distribuye el agua de forma homog\u00e9nea por la mopa.<\/li>  <li>Sistema Turbo Clean Carpet especial para alfombras, para limpiarlas de la forma m\u00e1s eficaz.<\/li>  <li>Sistema ForceClean: potente turbina que maximiza la gran potencia de succi\u00f3n hasta 2100 Pa. Recoge todo tipo de suciedad y garantiza un suelo siempre limpio.<\/li>  <li>3 niveles de potencia: modo Eco para limpiezas superficiales con el m\u00ednimo consumo, modo Normal para limpiezas diarias y modo Turbo para limpiezas en profundidad.<\/li>  <li>6 modos de limpieza seleccionables: Auto, Bordes, Manual, Habitaci\u00f3n, Espiral y Vuelta a casa.<\/li>  <li>Tecnolog\u00eda iTech Smart 2.0 para una navegaci\u00f3n inteligente y con sensores de proximidad, antichoque y antica\u00edda.<\/li>  <li>Mopa Twin Floor de dos materiales para realizar una limpieza profesional en todo tipo de superficies.<\/li>  <li>Tecnolog\u00eda OnlySilence para una limpieza silenciosa con un nivel sonoro de &lt; 64 dB.<\/li>  <li>All-TimeTable Pro: programable 24 horas al d\u00eda durante los 7 d\u00edas de la semana.<\/li>  <li>El robot aspirador vuelve autom\u00e1ticamente a la base de carga al finalizar la bater\u00eda gracias a su sistema GPS Home.<\/li>  <li>Bater\u00eda de Ion-Litio de 14,4 V y 2600 mAh. Disfruta de una autonom\u00eda de hasta 160 minutos.<\/li>  <li>Purifica el aire con el filtro de alta eficiencia capaz de retener al\u00e9rgenos y polvo.<\/li>  <li>Dep\u00f3sito mixto para s\u00f3lidos y l\u00edquidos de gran capacidad<\/li>  <li>Se adapta totalmente a tu hogar, limpia debajo de los muebles, detecta obst\u00e1culos y evita caerse por las escaleras.<\/li>  <li>Llega a todos los rincones con sus 2 cepillos laterales que ayudan a empujar toda la suciedad hasta la boquilla.<\/li>  <li>    <h2>Composici\u00f3n<\/h2>  <\/li>  <li>Robot aspirador<\/li>  <li>Cepillo silicona BestFriend Care<\/li>  <li>Dep\u00f3sito mixto (s\u00f3lidos y l\u00edquidos)<\/li>  <li>2 mopas<\/li>  <li>4 cepillos laterales<\/li>  <li>filtro de alta eficiencia<\/li>  <li>Cepillo de autolimpieza<\/li>  <li>Base de carga y adaptador de corriente<\/li>  <li>Manual de instrucciones<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-robot%20conga%20flash%20co%20tit_1.jpg","wholesale_price":"112.69","unit_price_tax":117.69},"product_model":{"product_data":{"ean13":["8435484057943"],"reference":"05794","name":{"1":"Robot Aspirador Cecotec Conga Flash Connected Titanium\/ Friegasuelos\/ Autonom\u00eda 160 Min\/ control por WiFi","2":"","3":"","4":""},"description":{"1":"<p><ul>  <li>    <h2>Descripci\u00f3n<\/h2>  <\/li>  <li>Robot aspirador Conga Flash Connected Titanium con tecnolog\u00eda random. 160 minutos de autonom\u00eda. Potencia de succi\u00f3n de 2100 Pa. 3 niveles de potencia y de fregado. Cepillo silicona BestFriend Care. 6 programas. APP. Asistente Virtual Alexa. Programaci\u00f3n.<\/li>  <li>4 in 1: aspira, barre, pasa la mopa y friega.<\/li>  <li>APP Control: aplicaci\u00f3n para smartphone con la que podr\u00e1s controlar tu robot seleccionando los modos de limpieza, programando la limpieza, seleccionando el nivel de potencia de succi\u00f3n y de fregado y observar el historial de limpiezas.<\/li>  <li>Conecta el robot al&nbsp; asistente virtual de control por voz Alexa. Podr\u00e1s realizar varios controles por voz, tales como, empezar la limpieza, parar de limpiar, mandar el robot a su base de carga o incluso localizar el robot por medio de emisiones auditivas. <\/li>  <li>BestFriend Care: cepillo de silicona intercambiable ideal para mascotas y pelo largo.<\/li>  <li>Fregado inteligente con la tecnolog\u00eda iWater. Experimenta un control absoluto con los 3 niveles de fregado apto para todo tipo de superficies.<\/li>  <li>\u00a1Friega por ti! Su sistema Wash4You pasa la mopa y friega con solo ponerle el dep\u00f3sito de l\u00edquidos. Limpia de forma inteligente los m\u00e1ximos metros mediante su avanzado sistema de control electr\u00f3nico que dosifica y distribuye el agua de forma homog\u00e9nea por la mopa.<\/li>  <li>Sistema Turbo Clean Carpet especial para alfombras, para limpiarlas de la forma m\u00e1s eficaz.<\/li>  <li>Sistema ForceClean: potente turbina que maximiza la gran potencia de succi\u00f3n hasta 2100 Pa. Recoge todo tipo de suciedad y garantiza un suelo siempre limpio.<\/li>  <li>3 niveles de potencia: modo Eco para limpiezas superficiales con el m\u00ednimo consumo, modo Normal para limpiezas diarias y modo Turbo para limpiezas en profundidad.<\/li>  <li>6 modos de limpieza seleccionables: Auto, Bordes, Manual, Habitaci\u00f3n, Espiral y Vuelta a casa.<\/li>  <li>Tecnolog\u00eda iTech Smart 2.0 para una navegaci\u00f3n inteligente y con sensores de proximidad, antichoque y antica\u00edda.<\/li>  <li>Mopa Twin Floor de dos materiales para realizar una limpieza profesional en todo tipo de superficies.<\/li>  <li>Tecnolog\u00eda OnlySilence para una limpieza silenciosa con un nivel sonoro de &lt; 64 dB.<\/li>  <li>All-TimeTable Pro: programable 24 horas al d\u00eda durante los 7 d\u00edas de la semana.<\/li>  <li>El robot aspirador vuelve autom\u00e1ticamente a la base de carga al finalizar la bater\u00eda gracias a su sistema GPS Home.<\/li>  <li>Bater\u00eda de Ion-Litio de 14,4 V y 2600 mAh. Disfruta de una autonom\u00eda de hasta 160 minutos.<\/li>  <li>Purifica el aire con el filtro de alta eficiencia capaz de retener al\u00e9rgenos y polvo.<\/li>  <li>Dep\u00f3sito mixto para s\u00f3lidos y l\u00edquidos de gran capacidad<\/li>  <li>Se adapta totalmente a tu hogar, limpia debajo de los muebles, detecta obst\u00e1culos y evita caerse por las escaleras.<\/li>  <li>Llega a todos los rincones con sus 2 cepillos laterales que ayudan a empujar toda la suciedad hasta la boquilla.<\/li>  <li>    <h2>Composici\u00f3n<\/h2>  <\/li>  <li>Robot aspirador<\/li>  <li>Cepillo silicona BestFriend Care<\/li>  <li>Dep\u00f3sito mixto (s\u00f3lidos y l\u00edquidos)<\/li>  <li>2 mopas<\/li>  <li>4 cepillos laterales<\/li>  <li>filtro de alta eficiencia<\/li>  <li>Cepillo de autolimpieza<\/li>  <li>Base de carga y adaptador de corriente<\/li>  <li>Manual de instrucciones<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CECOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":117.69,"unit_price_tax":117.69,"tax_rules_group":null,"category":"Limpieza de Hogar","sub_category":"Robots Aspirador","quantity":0,"brand":"CECOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-robot%20conga%20flash%20co%20tit_1.jpg"],"wholesale_price":112.69}}},"6934177775345":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6934177775345",false],"wholesale_price":[63.05,false],"price":[68.05,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:136840","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/68c490cf31f574a11c31f8e5f5bb5a8f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Purificador de Aire Xiaomi Smart Air Purifier 4 Compact \/ Filtro Alta Eficiencia\/ WiFi\/ Hasta 27m2\/ 20dB","category":"Limpieza de Hogar","sub_category":"Purificadores de Aire & Aroma","unit_price":68.05,"reference":"BHR5860EU","ean13":"6934177775345","weight":"3.1","quantity":0,"brand":"XIAOMI","description_pt":"                                                <p><\/p><h2>Smart Air Purifier 4 Compact<\/h2><p>El aire que quieres en el purificador que necesitas<\/p><p>Eliminaci\u00f3n de al\u00e9rgenos | Control inteligente | Control de la calidad del aire en tiempo real<\/p><p><\/p><h2>Peque\u00f1o pero potente\u00a0<span style='background-color: initial;'>Con su tama\u00f1o compacto, ocupa poco espacio y se adec\u00faa a toda la casa<\/span><\/h2><p>Dise\u00f1o de doble uso para mesa y suelo, compacto y f\u00e1cil de mover. Rendimiento potente y una salida constante de aire limpio.<\/p><h2>Atrapa el 99,97 % de part\u00edculas de hasta 0,3 micr\u00f3metros<\/h2><h2>Filtraci\u00f3n 3 en 1 para una purificaci\u00f3n completa<\/h2><p>Elimina con eficacia los contaminantes comunes del aire en interiores con la filtraci\u00f3n capa a capa<\/p><p><\/p><h2>Certificaci\u00f3n T\u00dcV Rheinland Allergy Care<\/h2><h2>Estricta filtraci\u00f3n de al\u00e9rgenos garantizada<\/h2><p>Certificado por la autorizada T\u00dcV Rheinland, el Xiaomi Smart Air Purifier 4 Compact ha demostrado que filtra con eficacia los al\u00e9rgenos en el aire<\/p><h2>Control remoto inteligenteAire limpio donde lo necesites<\/h2><p>Activa a distancia tu purificador de aire con la aplicaci\u00f3n Mi Home\/Xiaomi Home y disfruta de aire limpio y fresco al llegar a casa.<\/p><h2>Compatibilidad con control por voz<\/h2><p>Aire de buena calidad a distancia\u00a0<\/p><h2>Modo autom\u00e1tico de un solo toque.\u00a0<span style='background-color: initial;'>Monitorizaci\u00f3n en tiempo real, purificaci\u00f3n de alta eficiencia<\/span><\/h2><p>Gracias a la configuraci\u00f3n del sensor de part\u00edculas, el control sensible de la calidad del aire y el ajuste autom\u00e1tico de la velocidad de purificaci\u00f3n, podr\u00e1s disfrutar de aire limpio en todo momento.<\/p><h2>Sensor de part\u00edculas<\/h2><p>Detecci\u00f3n en tiempo real de cambios en la calidad del aire<\/p><h2>Monitorizaci\u00f3n de la calidad del aire en tiempo real.\u00a0<span style='background-color: initial;'>Vigila los cambios para mejorar la purificaci\u00f3n<\/span><\/h2><p>Datos intuitivos sobre la calidad del aire en interiores a partir de un indicador luminoso de cuatro colores.<\/p><p>Ajusta la purificaci\u00f3n con los sencillos botones de control t\u00e1ctil, con un solo toque para satisfacer tus necesidades de calidad del aire.<\/p><h2>\u00c1rea de purificaci\u00f3n personalizada.\u00a0<span style='background-color: initial;'>Elige la velocidad \u00f3ptima en un solo paso<\/span><\/h2><p>En el modo manual, puedes ajustar el \u00e1rea de cobertura y personalizar la velocidad a tu gusto.<\/p><h2>Modo de suspensi\u00f3n ultrasilencioso.\u00a0<span style='background-color: initial;'>Que no interrumpan tu sue\u00f1o<\/span><\/h2><p>En el modo de suspensi\u00f3n, se reduce el ruido a 20 dB* y se puede apagar la luz de la pantalla. Disfruta de una noche tranquila de sue\u00f1o sin interrupciones.<\/p><h2>Purificaci\u00f3n de bajo consumo, protecci\u00f3n eficaz<\/h2><p>El consumo puede reducirse hasta 27 W, incluso con la m\u00e1xima salida.\u00a0<\/p><p>Solo se necesitan 0,7 kWh para 24 horas de purificaci\u00f3n*.<\/p><h2>Motor de CC sin cepillo eficiente<\/h2><p>No hay fricci\u00f3n con el cepillo de carb\u00f3n, por lo que es m\u00e1s silencioso y eficiente en t\u00e9rminos energ\u00e9ticos.<\/p><h2>Sustituci\u00f3n del filtro en un solo paso y sin esfuerzo<\/h2><p>Gira y tira desde la parte inferior<\/p><h2>Recordatorios de sustituci\u00f3n del filtro<\/h2><p>Solo tienes que cambiar el filtro en el momento recomendado<\/p><h2>Aspecto con estilo<\/h2><p>Textura mate y l\u00edneas elegantes<\/p><h2>La diferencia entre el filtro de alta eficiencia de Xiaomi y un filtro HEPA convencional<\/h2><p>Combinaci\u00f3n de dos tecnolog\u00edas de filtro: filtraci\u00f3n electrost\u00e1tica y mec\u00e1nica. El material filtrante de alta eficiencia de Xiaomi puede eliminar un 99,97 % de part\u00edculas del aire de tan solo 0,1 micr\u00f3metros y atrapa polvo, part\u00edculas PM 2,5, polen, caspa de mascotas y humo, incluso los micropl\u00e1sticos m\u00e1s peque\u00f1os. La tasa de filtraci\u00f3n del material filtrante de alta eficiencia de Xiaomi es del 99,97 % para part\u00edculas peque\u00f1as de hasta 0,3 micr\u00f3metros, y puede llegar hasta el 99,99 % para part\u00edculas peque\u00f1as de tan solo 0,1 micr\u00f3metros.<\/p><br><p><\/p><p><h2>Especificaciones<\/h2><p><ul><li><b>Nombre del producto<\/b><\/li><li>Xiaomi Smart Air Purifier 4 Compact<\/li><li><b>Dimensiones del producto<\/b><\/li><li>&#934;220 x 355 mm<\/li><li><b>Peso neto del producto<\/b><\/li><li>Aprox. 2,2 kg<\/li><li><b>\u00c1rea de cobertura efectiva<\/b><\/li><li>16-27 m\u00b2<\/li><li><b>Ruido<\/b><\/li><li>&#8804; 60 dB(A)<\/li><li>CADR de part\u00edculas<\/li><li>230 m\u00b3\/h<\/li><li><b>Eficiencia de la purificaci\u00f3n de part\u00edculas<\/b><\/li><li>Alta<\/li><\/ul><\/p><\/p><br><p><\/p><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-pur%20sm%20air%20pur%204%20com_1.jpg","wholesale_price":"63.05","unit_price_tax":68.05},"product_model":{"product_data":{"ean13":["6934177775345"],"reference":"BHR5860EU","name":{"1":"Purificador de Aire Xiaomi Smart Air Purifier 4 Compact \/ Filtro Alta Eficiencia\/ WiFi\/ Hasta 27m2\/ 20dB","2":"","3":"","4":""},"description":{"1":"                                                <p><\/p><h2>Smart Air Purifier 4 Compact<\/h2><p>El aire que quieres en el purificador que necesitas<\/p><p>Eliminaci\u00f3n de al\u00e9rgenos | Control inteligente | Control de la calidad del aire en tiempo real<\/p><p><\/p><h2>Peque\u00f1o pero potente\u00a0<span style='background-color: initial;'>Con s