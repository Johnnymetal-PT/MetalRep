raci\u00f3n l\u00edquida<\/li>  <li>240mm, 120mm superior \/ 360mm, 280mm, 240mm, 140mm, 120mm frontal \/ 120mm trasero<\/li>  <li>Capacidad de ventiladores<\/li>  <li>Hasta 6x 120mm<\/li>  <li>Ventiladores incluidos<\/li>  <li>3x ARGB 120mm frontal + 1x ARGB 120mm trasero<\/li>  <li>Medidas internas<\/li>  <li>Ancho-20.4cm Alto-44.5cm (suelo a techo) Largo 33cm<\/li>  <li>Conectores de alimentaci\u00f3n<\/li>  <li>SATA (ventiladores) \/ Addressable RGB 3 pin (iluminaci\u00f3n)<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":55.93,"unit_price_tax":55.93,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","quantity":0,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20mc-f%20wh_1.jpg"],"wholesale_price":50.93}}},"4711387059609":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["4711387059609",false],"wholesale_price":[488,false],"price":[493,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Asus VivoBook Go E1504FA-BQ204W Ryzen 5 7520U\/ 8 GB\/ 512 GB SSD\/ 15,6&#39;\/ Win11 S Laptop"],"result":false},"feed_data":{"name_pt":"Port\u00e1til Asus VivoBook Go E1504FA-BQ204W Ryzen 5 7520U\/ 8GB\/ 512GB SSD\/ 15.6'\/ Win11 S","category":"Portatiles","sub_category":"Portatiles","unit_price":493,"reference":"90NB0ZR2-M008U0","ean13":"4711387059609","weight":"2.5","quantity":5,"brand":"ASUS",