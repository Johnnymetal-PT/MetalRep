RRIENTE DE ENTRADA (CA)\u00a0 100-240 V<\/li><li>CORRIENTE DE ENTRADA\u00a0 10-5 A<\/li><li>FRECUENCIA\u00a0 47~63 Hz<\/li><li>Carga m\u00e1xima\/ Salida m\u00e1xima<\/li><li>+3,3 V\u00a0 20 A\u00a0 150 W<\/li><li>+5 V\u00a0 20 A<\/li><li>+12 V\u00a0 70,8 A\u00a0 850 W<\/li><li>-12 V\u00a0 0,3 A\u00a0 3,6 W<\/li><li>+5 VSB\u00a0 3 A\u00a0 15 W<\/li><li>POTENCIA TOTAL\u00a0 850 W<\/li><\/ul><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CORSAIR","supplier":null,"width":null,"height":null,"depth":null,"weight":3.17,"unit_price":127.82,"unit_price_tax":127.82,"tax_rules_group":null,"category":"Componentes","sub_category":"Fuentes de alimentacion","quantity":0,"brand":"CORSAIR","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cor-fuente%20850w%20rm850%20gd%20wh_1.jpg"],"wholesale_price":122.82}}},"4250812442178":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4250812442178",false],"wholesale_price":[140.95,false],"price":[145.95,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.66",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:136812","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c1a9366cd504cfecf566a8f0ea3b6231.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Fuente de Alimentaci\u00f3n EVGA 1000 GT Supernova\/ 1000W\/ Ventilador 13.5cm\/ 80 Plus Gold","ca