:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-iphone%20mu1d3qlbardera_1.jpg"],"wholesale_price":1004.05}}},"4894461975276":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["4894461975276",false],"wholesale_price":[144.98,false],"price":[149.98,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone TCL 40 NXTPAPER 8GB\/ 256GB\/ 6,78&#39;\/ Azul meia-noite"],"result":false},"feed_data":{"name_pt":"Smartphone TCL 40 NXTPAPER 8GB\/ 256GB\/ 6.78'\/ Azul Medianoche","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":149.98,"reference":"T612B-2ALCA112","ean13":"4894461975276","weight":"0.47","quantity":5,"brand":"TCL","description_pt":"                                                <h2>TCL 40 NXTPAPER<\/h2><p><\/p><p>Pantalla NXTPAPER FHD+ de 6,78' y 90 Hz<\/p><p><\/p><p><\/p><h2>Redefiniendo tu experiencia visual.<\/h2><p>Experimente la novedad de la \u00faltima tecnolog\u00eda visual NXTPAPER impulsada por la innovaci\u00f3n.\u00a0<\/p><p>Con una claridad emocionante FHD+, disfrutar\u00e1s de im\u00e1genes que cobran vida en la amplia pantalla de 6,78' con una suavidad sedosa de 90 Hz.<\/p><h2>M\u00e1ximo confort.<\/h2><p><b>Sensaci\u00f3n de papel.<\/b><\/p><p>Las m\u00faltiples capas integradas de dise\u00f1o innovador brindan beneficios interesantes al proporcionar funciones vers\u00e1tiles de protecci\u00f3n ocular.\u00a0<\/p><h2>Toque similar al papel<\/h2><p>La textura de pantalla antihuellas con acabado mate mejora una experiencia t\u00e1ctil similar al papel.<\/p><h2>Luz azul baja<\/h2><p>Reduce de forma inteligente la da\u00f1ina luz azul a nivel de hardware sin dejar ning\u00fan color amarillento desagradable y conservando al mismo tiempo una tonalidad de color natural.<\/p><h2>Anti reflejante\u00a0<\/h2><p>La pantalla, certificada para visualizaci\u00f3n sin reflejos, siempre es lo suficientemente brillante, clara y agradable a la vista mientras se mira al aire libre y mientras se viaja.<\/p><h2>A todo color<\/h2><p>A diferencia de las pantallas de los lectores electr\u00f3nicos con colores limitados, la pantalla NXTPAPER ofrece una explosi\u00f3n de colores vivos, ya sea que est\u00e9 leyendo novelas gr\u00e1ficas, atendiendo videollamadas o navegando por la web.<\/p><h2>Inmersi\u00f3n mejorada con 3D Boom Sound<\/h2><p>Disfrute de una verdadera inmersi\u00f3n con un sistema de efectos envolventes DTS que brinda vibraciones de sonido armoniosas para el disfrute que desea.<\/p><h2>Alcanza el 200 % de volumen con Sound Booster<\/h2><p>Responda llamadas con parlantes claros y potentes, y escuche sin esfuerzo audiolibros y programas de televisi\u00f3n mientras realiza tareas dom\u00e9sticas o ejercicios.<\/p><h2>Selfies de nivel insignia de 32MP.<\/h2><p><span style='background-color: initial;'>Toma cada selfie con un aspecto brillante y n\u00edtido, con colores tan enriquecidos que querr\u00e1s compartirlos de inmediato.<\/span><br><\/p><h2>Enci\u00e9ndelo en poco tiempo.<\/h2><p>Respalda tus rutinas de alto rendimiento durante todo el d\u00eda y entretenimiento en l\u00ednea con una sola carga.<\/p><h2>8GB + 8GB de RAM Expansi\u00f3n\u00a0<\/h2><p>La RAM virtual de 8 GB brinda un impulso adicional para ejecutar sin problemas todas sus aplicaciones favoritas simult\u00e1neamente en AndroidTM 13, lo que garantiza una transmisi\u00f3n o navegaci\u00f3n web sin demoras.<\/p><h2>Memoria masiva de 256 GB<\/h2><p>Con capacidad para almacenar m\u00e1s de 110 pel\u00edculas o 55 000 fotograf\u00edas, nunca necesitar\u00e1s sacrificar lo que deseas almacenar.<\/p><h2>Rendimiento visual mejorado con NXTURBO<\/h2><p><\/p><p>Aumente instant\u00e1neamente la representaci\u00f3n de im\u00e1genes hasta en un 30%, brindando una experiencia visual m\u00e1s fluida mientras juega juegos con muchos recursos y navega por hilos de redes sociales y canales de video.<br><\/p><p><\/p><h2>UI de NXTPAPER que alivia los ojos<\/h2><p>Experimente modos de interfaz de usuario de NXTPAPER reflexivos y relajantes abrazados por una est\u00e9tica con temas de la naturaleza, que brindan una visualizaci\u00f3n relajada d\u00eda y noche.<\/p><br><p><\/p><h2>ESPECIFICACIONES<\/h2><p><\/p><ul><li><b>Dise\u00f1o<\/b><\/li><li>Dimensiones (Al x An x Pr, mm)<\/li><li>168,16 x 75,53 x 7,89<\/li><li>Peso<\/li><li>195g<\/li><li>Teclas laterales<\/li><li>Encendido (sensor de huellas dactilares), volumen<\/li><li><b>Pantalla<\/b><\/li><li>Tama\u00f1o<\/li><li>6,78'<\/li><li>Resoluci\u00f3n<\/li><li>FHD+ (1080 x 2460 p\u00edxeles), 369 PPI<\/li><li>Frecuencia de actualizaci\u00f3n<\/li><li>90Hz<\/li><li>Brillo<\/li><li>450 liendres (t\u00edpico)<\/li><li>Relaci\u00f3n de visualizaci\u00f3n<\/li><li>20.5:9<\/li><li>Relaci\u00f3n pantalla-cuerpo<\/li><li>91%*<\/li><li>Relaci\u00f3n de contraste<\/li><li>1500: 1 (t\u00edpico)<\/li><li>Gama de colores<\/li><li>NTSC 96% (t\u00edpico)<\/li><li>*Relaci\u00f3n pantalla-cuerpo calculada con el m\u00e9todo VA\/TP<\/li><li><b>Bater\u00eda<\/b><\/li><li>Bater\u00eda<\/li><li>5010 mAh (t\u00edpico)<\/li><li>Cargador<\/li><li>USB tipo C 2.0<\/li><li>Carga admitida<\/li><li>Carga r\u00e1pida de 33W<\/li><li>Tiempo de carga (horas)<\/li><li>100 minutos* (50 % de carga en 30 minutos)<\/li><li><b>Caracter\u00edsticas<\/b><\/li><li>SO<\/li><li>Interfaz de usuario TCL 5.0, Android&#8482;13<\/li><li>Conjunto de chips<\/li><li>Mediatek Helio G88 (MT6769)<\/li><li>CPU<\/li><li>2 Cortex-A75 de 2,0 GHz y 6 Cortex-A55 de 1,8 GHz<\/li><li>GPU<\/li><li>Mal\u00ed-G52 MC2<\/li><li><b>C\u00e1mara<\/b><\/li><li>C\u00e1mara principal de 50MP<\/li><li>PDAF, tama\u00f1o del sensor 1\/2,76&#8221;, tama\u00f1o de p\u00edxel 0,64 &#956;m, apertura F1.8, campo de visi\u00f3n 74,2\u00b0, lente 5P 76,7\u00b0, lente 4P<\/li><li>C\u00e1mara 