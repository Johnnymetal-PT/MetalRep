\u00f3n de ca\u00eddas<\/h2><p>El Apple Watch Series 9 detecta si has sufrido una ca\u00edda brusca y llama de manera autom\u00e1tica a los servicios de emergencia si no eres capaz de moverte. Esta prestaci\u00f3n est\u00e1 optimizada para la app<\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0.29,"unit_price":460.51,"unit_price_tax":460.51,"tax_rules_group":null,"category":"Apple","sub_category":"Apple Watch","quantity":2,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-watch%20mrht3qlbardera_1.jpg"],"wholesale_price":455.51}}},"0195949022845":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195949022845",false],"wholesale_price":[640.08,false],"price":[645.08,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.31",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:160384","Cat. IDs: 75,76","Associated Categories","Cat. Default: 75","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/11182bcdc1a18bdf5d0691ea6703d6a7.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Apple Watch Series 9\/ Gps\/ Cellular\/ 41 mm\/ Caja de Acero Plata\/ Correa deportiva Azul Tempestad S\/M","category":"Apple","sub_category":"Apple Watch","unit_price":645.08,"reference":"MRJ23QL\/A","ean13":"0195949022845","weight":"0.31","quantity":2,"brand":"APPLE","description_pt":"<p><h2>Una mente m\u00