un flujo de aire de 43.96 cfm, es uno de los ventiladores m\u00e1s silencioso, gracias a sus rodamientos Hydraumatic, que s\u00f3lo dan un nivel de ruido de 16dBA\u00b110%<\/p><p><br><\/p><p><ul><li><b>Especificaciones<\/b><\/li><li>Conectores de Alimentaci\u00f3n Dual de 3 &amp; 4Pins<\/li><li>F\u00e1cil montaje.<\/li><li>Anti-vibraci\u00f3n<\/li><li>Vida \u00fatil : 40,000 hours<\/li><li>Intensidad : 0.10\u00b10.02 Amp<\/li><li>1200 RPM<\/li><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"3GO","supplier":null,"width":null,"height":null,"depth":null,"weight":0.16,"unit_price":9.5,"unit_price_tax":9.5,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ventiladores","quantity":5,"brand":"3GO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_3go-ref%20fan12%20argb%20bk_1.jpg"],"wholesale_price":4.5}}},"4710562751192":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4710562751192",false],"wholesale_price":[158.04,false],"price":[163.04,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 23",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:160574","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/f4d8f0cd8c61b7190aca6cc405ebdbde.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Silla Gaming Aerocool Baron Hunter Green\/ Verde","category":"Perif\u00e9ricos Gaming","sub_c