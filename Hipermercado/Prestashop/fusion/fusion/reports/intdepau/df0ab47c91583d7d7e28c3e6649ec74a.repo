aciones<\/strong><\/h2><ul><li>Marca NESCAF\u00c9\u00ae Dolce Gusto\u00ae<\/li><li>Fabricante De&#8217;Longhi<\/li><li>Presi\u00f3n Hasta 15 bares<\/li><li>M\u00e1quina multi-bebida S\u00ed<\/li><li>Capacidad del tanque de agua 0.8 l<\/li><li>Funci\u00f3n bebida XL S\u00ed<\/li><li>Dimensiones 14 x 28 x 27 cm<\/li><li>Peso~2.7 kg<\/li><li>Potencia 1500 W<\/li><li>Alimentaci\u00f3n 230 V, 50 Hz<\/li><li>Ahorro energ\u00e9tico S\u00ed<\/li><li>Aviso de descalcificaci\u00f3n No<\/li><li>Dep\u00f3sito de c\u00e1psulas No<\/li><li>Tipo de m\u00e1quina Manual<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"DELONGHI","supplier":null,"width":null,"height":null,"depth":null,"weight":2.7,"unit_price":46.9,"unit_price_tax":46.9,"tax_rules_group":null,"category":"Cocina","sub_category":"Cafeteras","quantity":5,"brand":"DELONGHI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_dlon-pae-caf%20pi%20xs%20bk_1.jpg"],"wholesale_price":39.9}}},"6941812798041":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812798041",false],"wholesale_price":[57.04,false],"price":[64.04,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:271890","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/536aece1d2b93aeeb48a3306693e4908.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"