,false],"price":[8.05,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:249518","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cbc3fac8584f03af1fa71144086b3704.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pack de 4 Pilas AA Philips LR6E4B\/10\/ 1.5V\/ Alcalina","category":"Electronica","sub_category":"Pilas de consumo","unit_price":8.05,"reference":"LR6E4B\/10","ean13":"8712581550387","weight":"0.1","quantity":5,"brand":"PHILIPS","description_pt":"<p><h2>Potencia ultraelevada para dispositivos con consumo ultraelevado<\/h2><p>Si quieres lo mejor, exige pilas Ultra Alkaline. Duran un 30 % m\u00e1s que las pilas alcalinas normales y son perfectas para tus dispositivos con alto consumo.<\/p><h2>Las pilas alcalinas Philips contienen 0 % de cadmio, mercurio y plomo<\/h2><p>Se garantiza que estas pilas Philips no contienen metales pesados perjudiciales como cadmio, mercurio o plomo.<\/p><h2>Los colores facilitan el reconocimiento de los tama\u00f1os de pila<\/h2><p>Usamos una clasificaci\u00f3n por colores para los tama\u00f1os de pila seg\u00fan los est\u00e1ndares del sector para facilitar la identificaci\u00f3n de los tama\u00f1os de pila m\u00e1s comunes.<\/p><h2>Instrucciones al usuario sin palabras, f\u00e1ciles de entender<\/h2><p>Los s\u00edmbolos universales sin palabras del paquete explican c\u00f3mo y d\u00f3nde se puede o debe utilizar la pila.<\/p><h2>Una gama completa con una pila para cada necesidad<\/h2><p>Philips ofrece una completa gama con las pilas que se utilizan con m\u00e1s frecuencia (AA, AAA, C, D, 9V) en diferentes opciones de embalaje con el fin de cubrir todas las necesidades.<\/p><h2>132% m\u00e1s de potencia que las est\u00e1ndar del sector<\/h2><p>Las pilas AA ultra alcalinas de Philips tienen un 132 % m\u00e1s de potencia que las est\u00e1ndar del sector<\/p><h2>Mantiene la potencia hasta 10 a\u00f1os<\/h2><p>Toda pila sufre p\u00e9rdidas de energ\u00eda cuando no se utiliza. Nosotros garantizamos que la pila contiene como m\u00ednimo el 80 % de su energ\u00eda inicial durante la fecha preferente de utilizaci\u00f3n.<\/p><h2>La pila conserva sus prestaciones durante 10 a\u00f1os<\/h2><p>Toda pila sufre p\u00e9rdidas de energ\u00eda cuando no se utiliza. Nosotros garantizamos que la pila contiene como m\u00ednimo el 80 % de su energ\u00eda inicial durante la fecha preferente de utilizaci\u00f3n.<\/p><h2>Especificaciones<\/h2><ul><li><strong>Especificaciones medioambientales<\/strong><\/li><li>Composici\u00f3n qu\u00edmica<\/li><li>Ultra alcalina<\/li><li>Metales pesados<\/li><li>Sin cadmio<\/li><li>Sin mercurio<\/li><li>Sin plomo<\/li><li>Material de embalaje<\/li><li>Cart\u00f3n<\/li><li>PET<\/li><li>Tipo de embalaje<\/li><li>Bl\u00edster de PET<\/li><li><strong>Potencia<\/strong><\/li><li>Tipo de bater\u00eda<\/li><li>AA\/LR6 alcalina<\/li><li>Voltaje de la pila<\/li><li>1.5&nbsp; V<\/li><li><strong>Especificaciones t\u00e9cnicas<\/strong><\/li><li>Autonom\u00eda<\/li><li>10 a\u00f1os<\/li><li>Intercambiable por<\/li><li>AA, LR6, AM3, 15A, MN1500<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-pila%20lr6e4b%2010_1.jpg","wholesale_price":"1.05","unit_price_tax":8.05},"product_model":{"product_data":{"ean13":["8712581550387"],"reference":"LR6E4B\/10","name":{"1":"Pack de 4 Pilas AA Philips LR6E4B\/10\/ 1.5V\/ Alcalina","2":"","3":"","4":""},"description":{"1":"<p><h2>Potencia ultraelevada para dispositivos con consumo ultraelevado<\/h2><p>Si quieres lo mejor, exige pilas Ultra Alkaline. Duran un 30 % m\u00e1s que las pilas alcalinas normales y son perfectas para tus dispositivos con alto consumo.<\/p><h2>Las pilas alcalinas Philips contienen 0 % de cadmio, mercurio y plomo<\/h2><p>Se garantiza que estas pilas Philips no contienen metales pesados perjudiciales como cadmio, mercurio o plomo.<\/p><h2>Los colores facilitan el reconocimiento de los tama\u00f1os de pila<\/h2><p>Usamos una clasificaci\u00f3n por colores para los tama\u00f1os de pila seg\u00fan los est\u00e1ndares del sector para facilitar la identificaci\u00f3n de los tama\u00f1os de pila m\u00e1s comunes.<\/p><h2>Instrucciones al usuario sin palabras, f\u00e1ciles de entender<\/h2><p>Los s\u00edmbolos universales sin palabras del paquete explican c\u00f3mo y d\u00f3nde se puede o debe utilizar la pila.<\/p><h2>Una gama completa con una pila para cada necesidad<\/h2><p>Philips ofrece una completa gama con las pilas que se utilizan con m\u00e1s frecuencia (AA, AAA, C, D, 9V) en diferentes opciones de embalaje con el fin de cubrir todas las necesidades.<\/p><h2>132% m\u00e1s de potencia que las est\u00e1ndar del sector<\/h2><p>Las pilas AA ultra alcalinas de Philips tienen un 132 % m\u00e1s de potencia que las est\u00e1ndar del sector<\/p><h2>Mantiene la potencia hasta 10 a\u00f1os<\/h2><p>Toda pila sufre p\u00e9rdidas de energ\u00eda cuando no se utiliza. Nosotros garantizamos que la pila contiene como m\u00ednimo el 80 % de su energ\u00eda inicial durante la fecha preferente de utilizaci\u00f3n.<\/p><h2>La pila conserva sus prestaciones durante 10 a\u00f1os<\/h2><p>Toda pila sufre p\u00e9rdidas de energ\u00eda cuando no se utiliza. Nosotros garantizamos que la pila contiene como m\u00ednimo el 80 % de su energ\u00eda inicial durante la fecha preferente de utilizaci\u00f3n.<\/p><h2>Especificaciones<\/h2><ul><li><strong>Especificaciones medioambientales<\/strong><\/li><li>Composici\u00f3n qu\u00edmica<\/li><li>Ultra alcalina<\/li><li>Metales pesados<\/li><li>Sin cadmio<\/li><li>Sin mercurio<\/li><li>Sin plomo<\/li><li>Material de embalaje<\/li><li>Cart\u00f3n<\/li><li>PET<\/li><li>Tipo de embalaje<\/li><li>Bl\u00edster de PET<\/li><li><strong>Potencia<\/strong><\/li><li>Tipo de bater\u00eda<\/li><li>AA\/LR6 alcalina<\/li><li>Voltaje de la pila<\/li><li>1.5&nbsp; V<\/li><li><strong>Especificaciones t\u00e9cnicas<\/strong><\/li><li>Autonom\u00eda<\/li><li>10 a\u00f1os<\/li><li>Intercambiable por<\/li><li>AA, LR6, AM3, 15A, MN1500<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHILIPS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.1,"unit_price":8.05,"unit_price_tax":8.05,"tax_rules_group":null,"category":"Electronica","sub_category":"Pilas de consumo","quantity":5,"brand":"PHILIPS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-pila%20lr6e4b%2010_1.jpg"],"wholesale_price":1.05}}},"3086123734678":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3086123734678",false],"wholesale_price":[1.92,false],"price":[8.92,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:249519","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/31ceae7d441f7d1328894d533d4db94d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Caja de Bol\u00edgrafos de Tinta de Aceite Bic Cristal Original 516345\/ 5 unidades\/ Negros","category":"Escritura","sub_category":"Bol\u00edgrafos","unit_price":8.92,"referenc