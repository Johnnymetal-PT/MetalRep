initial;'>Di\u00e1metro de hilo<\/span><\/li><li><span style='background-color: initial;'>26AWG<\/span><\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-cab%20ibkbk_1.jpg","wholesale_price":"3.58","unit_price_tax":8.58},"product_model":{"product_data":{"ean13":["6922794745810"],"reference":"IBKBK","name":{"1":"Cable de Red RJ45 26AWG UTP Vention IBKBK Cat.6A\/ 8m\/ Negro","2":"","3":"","4":""},"description":{"1":"<h2><span style='background-color: initial;'>Especificaciones<\/span><\/h2><p><ul><li><span style='background-color: initial;'>Tipo de conector: Cable RJ45<\/span><\/li><li><span style='background-color: initial;'>Clase de cable: UTP<\/span><\/li><li><span style='background-color: initial;'>Categor\u00eda: 6A<\/span><\/li><li><span style='background-color: initial;'>Longitud: 8m<\/span><\/li><li><span style='background-color: initial;'>Material de aislamiento del cable<\/span><\/li><li><span style='background-color: initial;'>PVC<\/span><\/li><li><span style='background-color: initial;'>OD: 5.7mm<\/span><\/li><li><span style='background-color: initial;'>Velocidad de transferencia<\/span><\/li><li><span style='background-color: initial;'>1000Mbps<\/span><\/li><li><span style='background-color: initial;'>Velocidad de banda<\/span><\/li><li><span style='background-color: initial;'>250MHz<\/span><\/li><li><span style='background-color: initial;'>Color de aislamiento<\/span><\/li><li><span style='background-color: initial;'>negro<\/span><\/li><li><span style='background-color: initial;'>Di\u00e1metro de hilo<\/span><\/li><li><span style='background-color: initial;'>26AWG<\/span><\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":8.58,"unit_price_tax":8.58,"tax_rules_group":null,"category":"Cables de Red","sub_category":"Cables de Red + 5 mt","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-cab%20ibkbk_1.jpg"],"wholesale_price":3.58}}},"8712836985674":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8712836985674",false],"wholesale_price":[99.61,false],"price":[104.61,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:231735","Cat. IDs: 36,2","Associated Categories","Cat. Default: 36","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/6acd4daefa5de624d74b770e6c847a80.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Panel Calefactor Radiante Princess 348235\/ 350W","category":"Calefaccion y Clima","sub_category":"Paneles Calefactores","unit_price":104.61,"reference":"01.348235.01.001","ean13":"8712836985674","weight":"0","quantity":0,"brand":"PRINCESS","description_pt":"<p><h2>Princess 348235 Calentador de panel infrarrojo<\/h2><p>Presentamos el Calefactor de Panel Infrarrojo Inteligente Princess 348235, la combinaci\u00f3n perfecta de estilo y funcionalidad. Este calefactor no solo ofrece calefacci\u00f3n sostenible, r\u00e1pida y eficiente, sino que tambi\u00e9n est\u00e1 repleto de caracter\u00edsticas avanzadas. Con su dise\u00f1o elegante, se integra perfectamente en cualquier habitaci\u00f3n, a\u00f1adiendo un toque de elegancia. Gracias a su tecnolog\u00eda infrarroja avanzada, proporciona una distribuci\u00f3n de calor c\u00f3moda y uniforme sin resecar el aire ni generar ruido.<\/p><p><h2>Calefacci\u00f3n por infrarrojos<\/h2>Utilizando la potencia de la tecnolog\u00eda infrarroja, este Smart Infrared Panel Heater 350EL proporciona calefacci\u00f3n eficiente y efectiva con una potencia de 350 vatios. Al utilizar la tecnolog\u00eda infrarroja, calienta de manera eficiente objetos y personas directamente, en lugar de desperdiciar energ\u00eda calentando el aire. Este m\u00e9todo de calefacci\u00f3n dirigida no solo garantiza una distribuci\u00f3n r\u00e1pida y uniforme del calor, sino que tambi\u00e9n reduce el consumo de energ\u00eda. Mientras que los calentadores de convecci\u00f3n regulares gastar\u00e1n mucha energ\u00eda calentando y secando el aire, este panel calefactor solo calienta las superficies que necesitan ser calentadas. El panel calefactor tiene un elemento calefactor de cristal de carbono. La calidad del cristal de carbono es muy estable y tiene temperaturas de calentamiento precisas y configuraciones de potencia. El cristal de carbono tiene una distribuci\u00f3n de calor muy uniforme en todo el producto y, por lo tanto, con la misma unidad de tama\u00f1o, se necesita menos cristal de carbono, lo que significa un menor consumo de energ\u00eda.<\/p><p><h2>Dise\u00f1o vers\u00e1til<\/h2>El panel calefactor infrarrojo est\u00e1 dise\u00f1ado para integrarse perfectamente en la decoraci\u00f3n de tu hogar. Con la opci\u00f3n de montarlo en la pared o utilizarlo como unidad independiente, tienes la flexibilidad de colocarlo exactamente como desees. Con la funci\u00f3n de temporizador integrada de hasta 24 horas, este calefactor te permite programar f\u00e1cilmente horarios de calefacci\u00f3n seg\u00fan tu rutina diaria. Config\u00faralo para que se encienda autom\u00e1ticamente por la ma\u00f1ana, asegurando un ambiente acogedor y c\u00e1lido al despertar. Del mismo modo, puedes programarlo para que se apague cuando salgas al trabajo, ahorrando energ\u00eda durante el d\u00eda. La funci\u00f3n del temporizador te ofrece la flexibilidad de personalizar tus preferencias de calefacci\u00f3n, convirti\u00e9ndola en una caracter\u00edstica conveniente y que ahorra energ\u00eda. La carcasa es resistente a salpicaduras (IP44) y se puede usar tanto en interiores como en exteriores.<\/p><p><h2>Control total est\u00e9s donde est\u00e9s<\/h2>Toma el control de tu calefacci\u00f3n desde cualquier lugar con el Smart Infrared Panel Heater 350EL. Este innovador calentador se puede conectar f\u00e1cilmente a tu smartphone o tableta a trav\u00e9s de una aplicaci\u00f3n, lo que te permite ajustar la temperatura, programar temporizadores y supervisar el consumo de energ\u00eda de forma remota. Adem\u00e1s, este panel calefactor viene con un control remoto. Ya sea que est\u00e9s en el sof\u00e1 o en movimiento, tienes un control total sobre tu sistema de calefacci\u00f3n, asegurando m\u00e1ximo confort y eficiencia energ\u00e9tica. Controla tu panel calefactor con tu smartphone, tu asistente de voz preferido, de forma remota o manualmente.<\/p><p><h2>Contenido:<\/h2>Calentador de Panel Infrarrojo Inteligente, pies, soporte de pared y manual de instrucciones<\/p><h2>Motivos para elegir el Calentador de Panel Infrarrojo Inteligente Princess 348235:<\/h2><ul><li>Calefacci\u00f3n eficiente y sostenible<\/li><li>Monitoreo de energ\u00eda para un uso inteligente de la energ\u00eda<\/li><li>Conveniente funci\u00f3n de temporizador con un rango de 24 horas para programar la calefacci\u00f3n de manera personalizada<\/li><li>Compatibilidad con la aplicaci\u00f3n para control remoto<\/li><li>Dise\u00f1o elegante y montable en la pared para una instalaci\u00f3n que ahorra espacio<\/li><\/ul><br><\/p><h2>Especificaciones<\/h2><p><p><ul><li>Bot\u00f3n On\/Off S\u00ed<\/li><li>Item necesita bater\u00edas Si<\/li><li>Resistencia oculta S\u00ed<\/li><li>Ajustes S\u00ed<\/li><li>Frecuencia(Hz) 50\/60<\/li><li>Apagado autom\u00e1tico S\u00ed<\/li><li>N\u00famero de posiciones 1<\/li><li>Fijo o port\u00e1til Construido en \/Port\u00e1til<\/li><li>Potencia el\u00e9ctrica m\u00e1xima(W) 350<\/li><li>Panel de control Pantalla con botones<\/li><li>Impermeable S\u00ed<\/li><li>Potencia calor\u00edfica nominal(kW) 0,35<\/li><li>Funciona con electricidad S\u00ed<\/li><li>Control electr\u00f3nico de temperatura interior y temporizador semanal S\u00ed<\/li><li>N\u00famero de productos en el paquete 1<\/li><li>Potencia(W) 350<\/li><li>Voltaje(V) 240<\/li><li>Alcance(m\u00b3) 24<\/li><li>Colocaci\u00f3n En pared de pie<\/li><li>Modo libre de congelado S\u00ed<\/li><li>Tipo de calefactor Calefactor est\u00e1ndar<\/li><li>Luz(ces) indicadora(s) de funcionamiento S\u00ed<\/li><li>Funci\u00f3n de temporizador S\u00ed<\/li><li>Color Blanco<\/li><li>Longitud de cable(m) 1,52<\/li><li>Termostato regulable S\u00ed<\/li><li>Wifi S\u00ed<\/li><li>Pantalla LCD S\u00ed<\/li><li>N\u00famero de velocidades 1<\/li><li>Cantidad de elementos calefactores 1<\/li><li>Rango de calor(m\u00b2) 8<\/li><li>Tipo de conexi\u00f3n wifi Banda individual (2,4 GHz)<\/li><li>Temperatura m\u00e1xima(\u00b0C)0<\/li><li>Tipo de enchufe F - CEE 7\/4 (Schuko)<\/li><li>Salida de calor continuo m\u00e1ximo(kW) 0,35<\/li><li>Di\u00e1metro de ventilador(cm) 0<\/li><li>Grado de protecci\u00f3n IP IP44<\/li><li>Ajustes de velocidad 1<\/li><li>Mando a distancia S\u00ed<\/li><li>Con opci\u00f3n de control a distancia S\u00ed<\/li><li>Consumo auxiliar de electricidad en modo reposo(kW) 0,001<\/li><li>Adecuado para espacios h\u00famedos S\u00ed<\/li><li>Material principal Hierro<\/li><li>Fuente de alimentaci\u00f3n Tensi\u00f3n de red<\/li><li>Longitud del cable de alimentaci\u00f3n(m) 1,5<\/li><li>App disponible S\u00ed<\/li><li>Dimensiones(cm) 60 x 60 x 2<\/li><li>Protecci\u00f3n de sobrecalentamiento S\u00ed<\/li><li>Tipo de calentado Infrarrojos<\/li><li>M\u00e9todo de instalaci\u00f3n Montaje en pared<\/li><li>Potencia(W) 350<\/li><li>Con limitaci\u00f3n de tiempo de funcionamiento S\u00ed<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800