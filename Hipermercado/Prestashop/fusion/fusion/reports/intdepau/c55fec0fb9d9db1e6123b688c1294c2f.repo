","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHILIPS","supplier":null,"width":null,"height":null,"depth":null,"weight":9.6,"unit_price":285.63,"unit_price_tax":285.63,"tax_rules_group":null,"category":"Monitores","sub_category":"Monitores","quantity":5,"brand":"PHILIPS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-m%2034m2c3500l_1.jpg"],"wholesale_price":280.63}}},"8806096228166":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806096228166",false],"wholesale_price":[73.69,false],"price":[78.69,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:231915","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/beb83b0d8f0c4d0545939dd5c8298221.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Monitor LG 25MS550-B 24.5'\/ Full HD\/ Regulable en altura\/ Negro","category":"Monitores","sub_category":"Monitores","unit_price":78.69,"reference":"25MS550-B","ean13":"8806096228166","weight":"0","quantity":0,"brand":"LG","description_pt":"                                                <p><\/p><h2>Color aut\u00e9ntico en gran angular<\/h2><p>El monitor LG con tecnolog\u00eda IPS destaca el rendimiento de las pantallas de cristal l\u00edquido. Ofrece una reproducci\u00f3n n\u00edtida del color y ayuda a los usuarios a ver la pantalla con un gran angular de 178\u00b0.<\/p><h2>Visuales fluidos.\u00a0<span style='background-color: initial;'>Flujo de trabajo sin fisuras.<\/span><\/h2><p>Los r\u00e1pidos 100 Hz proporcionan una carga de fotogramas fluida en varios programas. Adem\u00e1s, puedes disfrutar de una experiencia de juego realista con menos vibraciones y desenfoque de movimiento.<\/p><h2>Modo lector<\/h2><p>El modo Lector ajusta la temperatura del color y la luminancia, lo que favorece una experiencia de visualizaci\u00f3n adecuada para leer en un monitor.<\/p><h2>Parpadeo seguro<\/h2><p>Flicker Safe reduce el parpadeo invisible en la pantalla, proporcionando una visi\u00f3n c\u00f3moda.<\/p><h2>Sum\u00e9rgete en el juego con im\u00e1genes n\u00edtidas<\/h2><p>Gracias a los 5 ms, que reducen el efecto fantasma inverso y proporcionan un tiempo de respuesta r\u00e1pido, podr\u00e1s disfrutar de juegos m\u00e1s envolventes con un rendimiento avanzado.<\/p><h2>Dynamic Action Sync<\/h2><p>Al reducir el retardo de entrada con Dynamic Action Sync, los jugadores pueden captar los momentos cr\u00edticos en tiempo real y responder con rapidez.<\/p><h2>Black Stabilizer<\/h2><p>El Black Stabilizer ayuda a los jugadores a detectar a los francotiradores que acechan en los rincones m\u00e1s oscuros and swiftly navigate flash explosions.<\/p><h2>Crosshair<\/h2><p>El punto de mira se fija en el centro para mejorar la precisi\u00f3n de tiro.\u00a0<\/p><h2>Streamlined control<\/h2><p>Controle f\u00e1cilmente la configuraci\u00f3n de la pantalla con unos pocos clics mediante el software OnScreen Control. Tambi\u00e9n puede dividir f\u00e1cilmente toda el \u00e1rea de visualizaci\u00f3n con Screen Split.<\/p><h2>Escritorio compacto<\/h2><p>Nuestro monitor admite altavoces integrados que ayudan a ahorrar espacio en el escritorio y ofrecen una experiencia de sonido envolvente.<\/p><h2>Soluci\u00f3n f\u00e1cil y c\u00f3moda<\/h2><p>Esta pantalla tiene un bisel delgado en tres lados, lo que le permite crear un entorno de trabajo adecuado mediante un c\u00f3modo ajuste de altura e inclinaci\u00f3n.<\/p><h2><br><\/h2><h2>Especificaciones<\/h2><p><ul><li><b>DIMENSION\/PESO<\/b><\/li><li>Dimensiones con peana (Ancho x Alto x Profundo) [mm]<\/li><li>557.5 x 475.2 x 219.4(UP)<\/li><li>Dimensiones sin peana (Ancho x Alto x Profundo) [mm]<\/li><li>557.5 x 328.3 x 58.8<\/li><li>Dimensiones empaquetado (Ancho x Alto x Profundo) [mm]<\/li><li>633 x 413 x 182<\/li><li>Peso con Peana [kg]<\/li><li>3.2<\/li><li>Peso sin Peana [kg]<\/li><li>2.4<\/li><li>Peso empaquetado [kg]<\/li><li>4.8<\/li><li><b>CARACTERISTICAS<\/b><\/li><li>Proteccion anti-parpadeo<\/li><li>Si<\/li><li>Modo de lectura<\/li><li>Si<\/li><li>Debilidad de Color<\/li><li>Si<\/li><li>Super Resolution+<\/li><li>Si<\/li><li>Estabilizador de Negros<\/li><li>Si<\/li><li>Dynamic Action Sync<\/li><li>Si<\/li><li>Cruceta<\/li><li>Si<\/li><li>Auto Input Switch<\/li><li>Si<\/li><li>Ahorro inteligente de energia<\/li><li>Si<\/li><li><b>POTENCIA<\/b><\/li><li>Tipo<\/li><li>External Power(Adapter)<\/li><li>Entrada CA<\/li><li>100~240V (50\/60Hz)<\/li><li>Consumo de potencia (Tip)<\/li><li>19W<\/li><li>Consumo de potencia (Estrella energetica)<\/li><li>15W<\/li><li>Consumo de potencia (Modo suspension)<\/li><li>Less than 0.5W<\/li><li>Consumo de potencia (DC apagado)<\/li><li>Less than 0.3W<\/li><li><b>INFO<\/b><\/li><li>Nombre del producto<\/li><li>PC Monitor<\/li><li>Ano<\/li><li>Y24<\/li><li><b>CONECTIVIDAD<\/b><\/li><li>HDMI<\/li><li>Si(2ea)<\/li><li>Salida para Auriculares<\/li><li>3-pole (Sound Only)<\/li><li>PANTALLA<\/li><li>Tamano [Pulgada]<\/li><li>24.5<\/li><li>Tamano [cm]<\/li><li>62.23<\/li><li>Resolucion<\/li><li>1920 x 1080<\/li><li>Tipo de Panel<\/li><li>IPS<\/li><li>Ratio de Aspecto<\/li><li>16:9<\/li><li>Tamano del pixel [mm]<\/li><li>0.0944 x 0.2802<\/li><li>Brillo (Min.)[cd\/m\u00b2]<\/li><li>200<\/li><li>Brillo (Tip.)[cd\/m\u00b2]<\/li><li>250<\/li><li>Gama de Color (Min.)<\/li><li>NTSC 68% (CIE1931)<\/li><li>Gama de Color (Tip.)<\/li><li>NTSC 72% (CIE1931)<\/li><li>Prof