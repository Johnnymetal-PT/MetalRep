 m\u00e1x.<\/b><\/li><li>273mm<\/li><li><b>Anchura VGA m\u00e1x.<\/b><\/li><li>152mm<\/li><li><b>Altura disipador m\u00e1x.<\/b><\/li><li>162mm<\/li><li><b>Soporte refrigeraci\u00f3n l\u00edquida<\/b><\/li><li>120mm trasero<\/li><li><b>Capacidad de ventiladores<\/b><\/li><li>Hasta 7x 120mm<\/li><li><b>Componentes incluidos<\/b><\/li><li>2x 120mm FRGB frontal + 1x 120mm FRGB trasero<\/li><li><b>Medidas internas<\/b><\/li><li>Ancho-18.5 Alto-37 (suelo a techo) Largo 31cm<\/li><li><b>Conectores de alimentaci\u00f3n<\/b><\/li><li>MOLEX (ventiladores)<\/li><li><b>Contenido de la caja<\/b><\/li><li>Caja, set de torniller\u00eda y manual<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":33.91,"unit_price_tax":33.91,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","quantity":0,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20mc-vortex_1.jpg"],"wholesale_price":28.91}}},"8435693107934":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693107934",false],"wholesale_price":[29.63,false],"price":[34.63,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:231973","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a6603c836a5