><li>Frecuencia (Bat.) 50 Hz \/ 60 Hz \u00b1 1%<\/li><li>Forma de onda (Bat.) Sinosuidal modificada<\/li><li>Tiempo de transferencia 2 - 6 ms<\/li><li>Protecci\u00f3n de sobrecarga Disyuntor o protecci\u00f3n interna fusible<\/li><li><b>Bater\u00eda<\/b><\/li><li>Cantidad \/ Tipo \/ N\u00ba 1x 12V\/ 5 Ah<\/li><li>Tiempo de carga (90%) 8 h<\/li><li><b>Indicadores<\/b><\/li><li>Display LCD<\/li><li>Alarmas Bater\u00eda encendida \/ Bater\u00eda baja\/ Sobrecarga \/ Fallo<\/li><li><b>Caracter\u00edsticas<\/b><\/li><li>Dimensiones (WxHxD) 305 x 158.5 x 95<\/li><li>Peso (Kg) 2.9<\/li><li>Humedad de funcionamiento 0 &#8211; 90 % sin condensaci\u00f3n<\/li><li>Temperatura de funcionamiento 0 - 40\u00baC<\/li><\/ul><\/div><div><br><\/div><\/p><\/div><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHASAK","supplier":null,"width":null,"height":null,"depth":null,"weight":3.6,"unit_price":67.77,"unit_price_tax":67.77,"tax_rules_group":null,"category":"S.A.I.","sub_category":"SAIS","quantity":5,"brand":"PHASAK","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phk-sai%20kryptos%20800%20va%20usb_1.jpg"],"wholesale_price":62.77}}},"4015672113572":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4015672113572",false],"wholesale_price":[7.68,false],"price":[12.68,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.06",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:170148","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New 