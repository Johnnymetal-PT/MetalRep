h":null,"height":null,"depth":null,"weight":0,"unit_price":63.29,"unit_price_tax":63.29,"tax_rules_group":null,"category":"Accesorios para C\u00e1maras","sub_category":"Accesorios Camaras de Accion","quantity":0,"brand":"INSTA360","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-kit%20bullet%20time_1.jpg"],"wholesale_price":58.29}}},"6970357854042":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6970357854042",false],"wholesale_price":[14.2,false],"price":[19.2,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:159331","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a398f26f2fc80ad8a76b8e75b47497d8.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Protector de Pantalla para C\u00e1mara Insta360 X3","category":"Accesorios para C\u00e1maras","sub_category":"Accesorios Camaras de Accion","unit_price":19.2,"reference":"CINSBAQD","ean13":"6970357854042","weight":"0","quantity":0,"brand":"INSTA360","description_pt":"<h2>Protector de Pantalla para Insta360 X3<\/h2><div><p>Dise\u00f1o curvo personalizado para un ajuste preciso. Ninguna parte sin cubrir.<\/p><p>Cristal templado significa protecci\u00f3n resistente y fuerte para tu X3.<\/p><p>Alta definici\u00f3n y transparencia cristalina.<\/p><p>Incluye un Kit de Instalaci\u00f3n de Protector.<\/p>Dise\u00f1ado para X3<\/div><div><h2>Protector de pantalla<\/h2><p>Alta protecci\u00f3n, alta transparencia.<\/p><h2>Cobertura impecable.<\/h2><p>Gracias a la superficie curvada personalizada, este es el \u00fanico protector de pantalla completamente compatible con X3.<\/p><p>Consigue un tacto suave y fluido.<\/p><h2>No te preocupes por nada.<\/h2><p>\u00bfDedos torpes? El cristal templado es resistente a los golpes y ara\u00f1azos, garantizando la m\u00e1xima resistencia.<\/p><h2>Cristalino.<\/h2><p>Con una transmisi\u00f3n de luz de m\u00e1s del 90%, obtendr\u00e1s la misma claridad y brillo que esperas de tu X3.<\/p><p>Ni siquiera notar\u00e1s que est\u00e1 ah\u00ed.<\/p><h2>Instalaci\u00f3n sencilla.<\/h2><p>Viene con todo lo necesario para una f\u00e1cil instalaci\u00f3n en casa.<\/p><br><\/div><div><p><ul><li><b>En la caja<\/b><\/li><li>1x Protector de Pantalla<\/li><li>1x Herramienta de Alineaci\u00f3n<\/li><li>1x Toallita Limpiadora de Pantalla<\/li><li>1x Varilla Retiradora de Pel\u00edcula<\/li><li>1x Kit de Instalaci\u00f3n de Protector<\/li><li>*El Kit de Instalaci\u00f3n de Protector contiene: pa\u00f1o para pantalla, adhesivo para auitar el aolvo, rascador.<\/li><li><b>Especificaciones<\/b><\/li><li>Tama\u00f1o:<\/li><li>55x40 mm<\/li><li>Grosor:<\/li><li>1.3 mm<\/li><li>C\u00f3mo utilizarlo<\/li><li><b>Instalaci\u00f3n<\/b><\/li><li>1. Limpia la pantalla: Limpia la pantalla con el pa\u00f1o de limpieza y el pa\u00f1o para pantalla. Utiliza el adhesivo para quitar el polvo para asegurarte de que la pantalla est\u00e1 libre de suciedad.<\/li><li>2. Alineaci\u00f3n: Coloca la herramienta de alineaci\u00f3n en l\u00ednea con la pantalla de la c\u00e1mara.<\/li><li>3. Coloca el protector de pantalla: Retira la pel\u00edcula del protector de pantalla. Posiciona el protector de pantalla sobre la pantalla utilizando la herramienta de alineaci\u00f3n. Mueve lentamente la pantalla hacia el protector hasta que quede cubierta y retira la herramienta de alineaci\u00f3n.<\/li><li>4. Elimina las burbujas de aire: Elimina las burbujas de aire con el rascador. Rasca primero las burbujas de aire del centro de la pantalla y, a continuaci\u00f3n, presiona con fuerza a ambos lados hasta eliminarlas por completo.<\/li><li><b>*Notas:<\/b><\/li><li>1. No vuelvas a instalar el mismo protector de pantalla. Cualquier mota de suciedad que pueda tener el protector de pantalla puede causar burbujas de aire y reducir la adhesividad.<\/li><li>2. Si el protector de pantalla se mueve durante la instalaci\u00f3n, utiliza la varilla extractora de pel\u00edcula para retirar el protector de pantalla y repite los pasos anteriores. No retires completamente el protector de pantalla instalado.<\/li><\/ul><\/p><\/div><div><br><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-protec%20screen%20prot%20x3_1.jpg","wholesale_price":"14.20","unit_price_tax":19.2},"product_model":{"product_data":{"ean13":["6970357854042"],"reference":"CINSBAQD","name":{"1":"Protector de Pantalla para C\u00e1mara Insta360 X3","2":"","3":"","4":""},"description":{"1":"<h2>Protector de Pantalla para Insta360 X3<\/h2><div><p>Dise\u00f1o curvo personalizado para un ajuste preciso. Ninguna parte sin cubrir.<\/p><p>Cristal templado significa protecci\u00f3n resistente y fuerte para tu X3.<\/p><p>Alta definici\u00f3n y transparencia cristalina.<\/p><p>Incluye un Kit de Instalaci\u00f3n de Protector.<\/p>Dise\u00f1ado para X3<\/div><div><h2>Protector de pantalla<\/h2><p>Alta protecci\u00f3n, alta transparencia.<\/p><h2>Cobertura impecable.<\/h2><p>Gracias a la superficie curvada personalizada, este es el \u00fanico protector de pantalla completamente compatible con X3.<\/p><p>Consigue un tacto suave y fluido.<\/p><h2>No te preocupes por nada.<\/h2><p>\u00bfDedos torpes? El cristal templado es resistente a los golpes y ara\u00f1azos, garantizando la m\u00e1xima resistencia.<\/p><h2>Cristalino.<\/h2><p>Con una transmisi\u00f3n de luz de m\u00e1s del 90%, obtendr\u00e1s la misma claridad y brillo que esperas de tu X3.<\/p><p>Ni siquiera notar\u00e1s que est\u00e1 ah\u00ed.<\/p><h2>Instalaci\u00f3n sencilla.<\/h2><p>Viene con todo lo necesario para una f\u00e1cil instalaci\u00f3n en casa.<\/p><br><\/div><div><p><ul><li><b>En la caja<\/b><\/li><li>1x Protector de Pantalla<\/li><li>1x Herramienta de Alineaci\u00f3n<\/li><li>1x Toallita Limpiadora de Pantalla<\/li><li>1x Varilla Retiradora de Pel\u00edcula<\/li><li>1x Kit de Instalaci\u00f3n de Protector<\/li><li>*El Kit de Instalaci\u00f3n de Protector contiene: pa\u00f1o para pantalla, adhesivo para auitar el aolvo, rascador.<\/li><li><b>Especificaciones<\/b><\/li><li>Tama\u00f1o:<\/li><li>55x40 mm<\/li><li>Grosor:<\/li><li>1.3 mm<\/li><li>C\u00f3mo utilizarlo<\/li><li><b>Instalaci\u00f3n<\/b><\/li><li>1. Limpia la pantalla: Limpia la pantalla con el pa\u00f1o de limpieza y el pa\u00f1o para pantalla. Utiliza el adhesivo para quitar el polvo para asegurarte de que la pantalla est\u00e1 libre de suciedad.<\/li><li>2. Alineaci\u00f3n: Coloca la herramienta de alineaci\u00f3n en l\u00ednea con la pantalla de la c\u00e1mara.<\/li><li>3. Coloca el protector de pantalla: Retira la pel\u00edcula del protector de pantalla. Posiciona el protector de pantalla sobre la pantalla utilizando la herramienta de alineaci\u00f3n. Mueve lentamente la pantalla hacia el protector hasta que quede cubierta y retira la herramienta de alineaci\u00f3n.<\/li><li>4. Elimina las burbujas de aire: Elimina las burbujas de aire con el rascador. Rasca primero las burbujas de aire del centro de la pantalla y, a continuaci\u00f3n, presiona con fuerza a ambos lados hasta eliminarlas por completo.<\/li><li><b>*Notas:<\/b><\/li><li>1. No vuelvas a instalar el mismo protector de pantalla. Cualquier mota de suciedad que pueda tener el protector de pantalla puede causar burbujas de aire y reducir la adhesividad.<\/li><li>2. Si el protector de pantalla se mueve durante la instalaci\u00f3n, utiliza la varilla extractora de pel\u00edcula para retirar el protector de pantalla y repite los pasos anteriores. No retires completamente el protector de pantalla instalado.<\/li><\/ul><\/p><\/div><div><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"