","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0.03,"unit_price":5.66,"unit_price_tax":5.66,"tax_rules_group":null,"category":"Cables de Red","sub_category":"Cables de Red hasta 1 mt","quantity":5,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-cab%20ibabe_1.jpg"],"wholesale_price":0.66}}},"6970357855117":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6970357855117",false],"wholesale_price":[366.19,false],"price":[371.19,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:159356","Cat. IDs: 72","Associated Categories","Cat. Default: 72","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/64e94d807fcaaa2da297fe45db49d5c6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara Digital Deportiva Insta360 GO 3 + Kit de Acci\u00f3n\/ 2.7K\/ \u00c1ngulo de visi\u00f3n 180\u00ba\/ Blanca","category":"C\u00e1maras","sub_category":"Camaras Digitales","unit_price":371.19,"reference":"GO303","ean13":"6970357855117","weight":"0","quantity":0,"brand":"INSTA360","description_pt":"<h2>Insta360 GO 3 Kit de Acci\u00f3n 64GB<\/h2><div><p><ul><li>Ligera y port\u00e1til.<\/li><li>POVs en manos libres \u00fanicos.<\/li><li>Sistema de montaje magn\u00e9tico para \u00e1ngulos creativos.<\/li><li>Action Pod con control remoto y previsualizaci\u00f3n en directo.<\/li><li>Resistente al agua hasta 5 m. Action Pod con protecci\u00f3n IPX4 a prueba de salpicaduras.<\/li><\/ul><\/p><p><b>El kit imprescindible para los deportes de acci\u00f3n.<\/b><\/p><p>El Kit de Acci\u00f3n incluye: 1x GO 3 (64 GB), 1x Action Pod, 1x Protector de Lente (preinstalado en la lente por defecto), 1x Colgante Magn\u00e9tico, 1x Soporte Pivotante, 1x Easy Clip y 1x Montura de Liberaci\u00f3n R\u00e1pida.<\/p><p>Nota: Si usas marcapasos, no uses GO 3 cerca del pecho ni utilices el Colgante Magn\u00e9tico debido a su magnetismo.<\/p><\/div><p><\/p><h2>PEQUE\u00d1A POTENCIA<\/h2><p>35 g de puro potencial.<br>Es la c\u00e1mara de acci\u00f3n m\u00e1s peque\u00f1a del mundo. \u00a1M\u00f3ntala y ll\u00e9vatela a cualquier parte! <\/p><h2>CAPTURAS POV<\/h2><h2>Realmente no necesitas utilizar las manos.<\/h2><p>\u00a1Totalmente manos libres! S\u00f3lo tienes que configurarla y olvidarte de ella para conseguir f\u00e1cilmente tomas POV en ultra gran angular en 2.7K. <\/p><h2>ESTABILIZACI\u00d3N FLOWSTATE<\/h2><h2>Desp\u00eddete de los baches.<\/h2><p>Nuestra Estabilizaci\u00f3n FlowState se traduce en grabaciones incre\u00edblemente estables. Se eliminan las sacudidas, los golpes o los balanceos, \u00a1perfecta para cuando la acci\u00f3n comienza! <\/p><h2>HORIZON LOCK 360<\/h2><h2>Horizontes perfectamente nivelados.<\/h2><p>\u00a1Haz una voltereta! A GO 3 no le importa. \u00a1Tecnolog\u00eda insuperable para que el v\u00eddeo se mantenga perfectamente nivelado pase lo que pase! <\/p><h2>MONTAJE EN CUALQUIER LUGAR<\/h2><h2>Limitado s\u00f3lo por tu imaginaci\u00f3n.<\/h2><p>\u00a1Una c\u00e1mara diminuta significa montaje f\u00e1cil! Con su dise\u00f1o magn\u00e9tico y sus accesorios, GO 3 te ofrece infinitas posibilidades creativas, con \u00e1ngulos que ninguna otra c\u00e1mara puede igualar. \u00a1Piensa en mascotas, cascos o cualquier toma que se te ocurra! <\/p><h2>Grabaciones f\u00e1ciles.<\/h2><h2>QuickCapture<\/h2><h2>Control por voz 2.0<\/h2><p>\u00a1Se acabaron los problemas con los ajustes de la c\u00e1mara mientras se te escapa la toma perfecta! Incluso cuando la GO 3 est\u00e1 apagada, basta con pulsar el bot\u00f3n de la parte frontal de la c\u00e1mara para empezar a grabar al instante.\u00a1Libera el poder del Control por voz 2.0 con GO 3! Captura momentos memorables en un instante con un solo comando y mant\u00e9nte totalmente con las manos libres. <\/p><h2>ACCESORIOS INCLUIDOS<\/h2><p><strong>Colgante Magn\u00e9tico<\/strong><br>P\u00f3ntelo para tomas f\u00e1ciles en primera persona.<br><strong>Easy Clip<\/strong><br>Col\u00f3calo en tu gorra para conseguir \u00e1ngulos incre\u00edbles.<br><strong>Soporte Pivotante<\/strong><br>P\u00e9galo en cualquier sitio y captura \u00e1ngulos \u00fanicos. Adem\u00e1s, \u00a1es reutilizable!<br>*El Soporte Pivotante s\u00f3lo se puede pegar a superficies planas que est\u00e9n secas y limpias, por favor, no lo utilices en escenarios de acci\u00f3n.<br><strong>Protector de Lentes<\/strong><br>Gira y \u00a1vete! Protector de lentes extra\u00edble para capturar sin preocupaciones. <\/p><h2>BATER\u00cdA DE LARGA DURACI\u00d3N<\/h2><p><strong>Un d\u00fao supercargado.<\/strong><br>La bater\u00eda m\u00e1s grande de la GO 3 dura un 50% m\u00e1s que la de GO 2. \u00a1Une fuerzas con el Action Pod para grabar durante 170 minutos! Eso s\u00ed que es una mejora. <\/p><h2>PANTALLA T\u00c1CTIL ABATIBLE<\/h2><h2>\u00a1Dale la vuelta, te ves muy bien!<\/h2><p>Captura con GO 3 en el Action Pod para conseguir selfies perfectamente encuadrados, vlogging impecable o capturas a pulso precisas. <\/p><h2>VISTA PREVIA Y CONTROL REMOTOS<\/h2><h2>Tomas perfectas donde quiera que la montes.<\/h2><p>\u00bfTienes la GO 3 montada en otro sitio? Utiliza el Action Pod para previsualizar tus tomas y capturar como un profesional. <\/p><h2>MEN\u00da R\u00c1PIDO<\/h2><h2>Dame la configuraci\u00f3n \u00a1ya!<\/h2><p>\u00a1Accede a las opciones de captura preestablecidas y a los ajustes directamente desde la pantalla t\u00e1ctil! Basta con pulsar el bot\u00f3n Q para buscar y seleccionar. <\/p><h2>MONTAJE MAGN\u00c9TICO<\/h2><h2>Monta la GO 3 o el Action Pod.<\/h2><p>Tanto la c\u00e1mara GO 3 como el Action Pod se adaptan al mismo Soporte Pivotante y a la Montura de Liberaci\u00f3n R\u00e1pida, con un pestillo y un im\u00e1n para fijarlos en su sitio. <\/p><h2>ACTION POD ROBUSTO<\/h2><h2>Resistente a salpicaduras IPX4.<\/h2><p>\u00bfLas nubes parecen un poco grises? No hay necesidad de esconderse dentro. El Action Pod es resistente al agua IPX4 contra la lluvia y las salpicaduras. <\/p><h2>C\u00c1MARA RESISTENTE AL AGUA<\/h2><h2>Resistente al agua IPX8 hasta 5 metros.<\/h2><p>\u00a1A coger esas olas! Saca tu GO 3 del Action Pod y sum\u00e9rgela hasta 5 m sin preocuparte. <\/p><h2>AUDIO MEJORADO<\/h2><h2>Doble diversi\u00f3n.<\/h2><p>Graba audio con los 2 micr\u00f3fonos integrados. GO 3 captura audio listo para vlog de todo lo que te rodea. N\u00edtido, claro y envolvente. <\/p><h2>TimeShift<\/h2><p>Acelera el tiempo y el espacio. O al menos haz que lo parezca. <\/p><h2>C\u00e1mara lenta<\/h2><p>Si la vida te est\u00e1 viniendo demasiado r\u00e1pido, ralentiza las cosas x4 hasta 120fps.Dale un extra especial a tus fotos. Activa PureShot para obtener un rango din\u00e1mico m\u00e1s alto impulsado por IA.Mira el mundo pasar. Graba incre\u00edbles timelapses, incluso de noche. <\/p><h2>PureShot HDR<\/h2><p>Si la vida te est\u00e1 viniendo demasiado r\u00e1pido, ralentiza las cosas x4 hasta 120fps.Dale un extra especial a tus fotos. Activa PureShot para obtener un rango din\u00e1mico m\u00e1s alto impulsado por IA.<\/p><h2>Timelapse<\/h2><p>Mira el mundo pasar. Graba incre\u00edbles timelapses, incluso de noche.<\/p><h2>Deja que la IA haga el trabajo por ti.<\/h2><p>La edici\u00f3n autom\u00e1tica encuentra los momentos m\u00e1s destacados y los edita juntos al ritmo de la m\u00fasica. S\u00f3lo tienes que elegir tus clips y dejar que lo haga por ti. Definitivamente no es hacer trampa...<\/p><h2>EXPORTA EN CUALQUIER RELACI\u00d3N<\/h2><h2>Una toma, cualquier perspectiva.<\/h2><p>De cuadrado a pantalla panor\u00e1mica, elige tu relaci\u00f3n de aspecto despu\u00e9s de grabar con el modo FreeFrame. \u00bfListo para volverte viral? Elige 9:16 y la GO 3 no perder\u00e1 ning\u00fan detalle donde otras c\u00e1maras de acci\u00f3n recortan. <\/p><h2>MODO WEBCAM<\/h2><h2>\u00a1Conferencias sobre la marcha!<\/h2><p>\u00a1Se acabaron las webcams para port\u00e1tiles! Recibe llamadas sobre la marcha con una resoluci\u00f3n de 1080p y seguimiento autom\u00e1tico. <\/p><p><br><\/p><h2>Especificaciones<\/h2><ul>\t<li><strong>Apertura<\/strong><\/li>\t<li>F2.2<\/li>\t<li><strong>Distancia focal equivalente a 35 mm<\/strong><\/li>\t<li>11,24 mm<\/li>\t<li><strong>Resoluci\u00f3n de fotos<\/strong><\/li>\t<li>2560x1440 (16:9)<\/li>\t<li>2560x2560 (1:1)<\/li>\t<li>1440x2560 (9:16)<\/li>\t<li>2936x1088 (2.7:1)<\/li>\t<li><strong>Resoluci\u00f3n de v\u00eddeo<\/strong><\/li>\t<li>V\u00eddeo<\/li>\t<li>2.7K: 2720x1536@24\/25\/30fps<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li>V\u00eddeo FreeFrame<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li>Timelapse<\/li>\t<li>1440P: 2560x1440@30fps<\/li>\t<li>TimeShift<\/li>\t<li>1440P: 2560x1440@15\/30fps<\/li>\t<li>C\u00e1mara lenta<\/li>\t<li>1080P: 1920x1080@120fps<\/li>\t<li>Pre-grabaci\u00f3n<\/li>\t<li>2.7K&#65306;2720x1536@24\/25\/30fps<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li>Grabaci\u00f3n en Loop<\/li>\t<li>2.7K&#65306;2720x1536@24\/25\/30fps<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li><strong>Formato de fotos<\/strong><\/li>\t<li>INSP (puede exportarse a trav\u00e9s de la App o Insta360 Studio)<\/li>\t<li>DNG (puede exportarse a trav\u00e9s de la App o Studio)<\/li>\t<li><strong>Formato de v\u00eddeo<\/strong><\/li>\t<li>MP4<\/li>\t<li><strong>Modos de fotos<\/strong><\/li>\t<li>Fotos, Fotos HDR, Intervalo, Starlapse<\/li>\t<li><strong>Modos de v\u00eddeo<\/strong><\/li>\t<li>V\u00eddeo, V\u00eddeo FreeFrame, Timelapse, TimeShift, C\u00e1mara lenta, Pre-grabaci\u00f3n, Grabaci\u00f3n en Loop<\/li>\t<li><strong>Perfiles de color<\/strong><\/li>\t<li>Est\u00e1ndar, Vivid, Plano<\/li>\t<li><strong>Codificaci\u00f3n del v\u00eddeo<\/strong><\/li>\t<li>H.264<\/li>\t<li><strong>Tasa de bits m\u00e1xima<\/strong><\/li>\t<li>80 Mbps<\/li>\t<li><strong>Tiempo de exposici\u00f3n<\/strong><\/li>\t<li>\u00b14EV<\/li>\t<li><strong>Rango ISO<\/strong><\/li>\t<li>100-3200<\/li>\t<li><strong>Velocidad de obturaci\u00f3n<\/strong><\/li>\t<li>Fotos: 1\/8000 - 120 s<\/li>\t<li>V\u00eddeo: 1\/8000 - hasta l\u00edmite de fotogramas por segundo<\/li>\t<li><strong>Balance de blancos<\/strong><\/li>\t<li>Auto, 2000 - 10000K<\/li>\t<li><strong>Modos de audio<\/strong><\/li>\t<li>Reducci\u00f3n de viento, Est\u00e9reo, Mejora Direccional<\/li>\t<li><strong>Formato de audio<\/strong><\/li>\t<li>48 KHz, 24 bits, AAC<\/li>\t<li><strong>Peso<\/strong><\/li>\t<li>GO 3: 35,5 g<\/li>\t<li>Action Pod: 96,3 g<\/li>\t<li><strong>Dimensiones (An x Al x L)<\/strong><\/li>\t<li>GO 3: 25,6x54,4x23,2 mm<\/li>\t<li>Action Pod:<\/li>\t<li>Pantalla plegada: 63,5x47,6x29,5 mm<\/li>\t<li>Pantalla desplegada: 63,5x86,6x29,9 mm<\/li>\t<li><strong>Color<\/strong><\/li>\t<li>Blanco<\/li>\t<li><strong>Almacenamiento<\/strong><\/li>\t<li>64 GB<\/li>\t<li><strong>Capacidad de la bater\u00eda<\/strong><\/li>\t<li>GO 3: 310 mAh<\/li>\t<li>Action Pod: 1270 mAh<\/li>\t<li><strong>Modo de carga<\/strong><\/li>\t<li>GO 3: Action Pod<\/li>\t<li>Action Pod: Tipo-C<\/li>\t<li><strong>Tiempo de carga<\/strong><\/li>\t<li>C\u00e1mara: 23 minutos al 80%, 35 minutos al 100%<\/li>\t<li>Action Pod: 47 minutos al 80%, 65 minutos al 100%<\/li>\t<li><strong>Duraci\u00f3n de la bater\u00eda<\/strong><\/li>\t<li>GO 3: 45 mins<\/li>\t<li>GO 3 + Action Pod: 170 mins<\/li>\t<li>*Testeado a 25 \u00b0C en condiciones de laboratorio a 1080p@30fps en &#8220;Modo V\u00eddeo&#8221;, con la pantalla y el Wi-Fi apagados. El tiempo de uso puede variar en diferentes condiciones.<\/li>\t<li><strong>Temperatura \u00f3ptima de funcionamiento<\/strong><\/li>\t<li>GO 3: -20&#8451; a 40&#8451;<\/li>\t<li>Action Pod: -20&#8451; a 40&#8451;<\/li>\t<li><strong>Bluetooth<\/strong><\/li>\t<li>BLE 5.0<\/li>\t<li><strong>Wi-Fi<\/strong><\/li>\t<li>5GHz<\/li>\t<li>802.11a\/n\/ac<\/li>\t<li><strong>USB<\/strong><\/li>\t<li>Tipo-C<\/li>\t<li><strong>Giroscopio<\/strong><\/li>\t<li>Giroscopio de 6 ejes<\/li>\t<li><strong>Dispositivos compatibles<\/strong><\/li>\t<li>Dispositivos iOS:<\/li>\t<li>Compatible con dispositivos m\u00f3viles iOS con chips A11 o superiores y versi\u00f3n iOS 11.0 o superior, incluyendo iPhone SE 2, iPhone 8, iPhone 8 Plus, iPhone XR, iPhone XS, iPhone XS Max, iPhone X, iPhone 11, iPhone 11 Pro, iPhone 11 Pro Max, iPhone 12, iPhone 12 Pro, iPhone 12 Pro Max, iPhone 12 mini, iPhone 13, iPhone 13 Pro, iPhone 13 Pro Max, iPhone 13 mini, iPhone 14, iPhone 14 Pro, iPhone 14 Pro Max, iPad Air (2020), iPad Pro y nuevos modelos de iPad.<\/li>\t<li>Dispositivos Android:<\/li>\t<li>Compatible con dispositivos Android que cumplen con las siguientes caracter\u00edsticas, incluyendo:<\/li>\t<li>Dispositivos Android con Kirin 980 y chips superiores, incluyendo Huawei Mate 20, P30 o modelos m\u00e1s recientes.<\/li>\t<li>&#8226; Dispositivos Android con Snapdragon 845 y chips superiores, incluyendo Samsung Galaxy S9, Xiaomi Mi 8 o modelos m\u00e1s recientes.<\/li>\t<li>&#8226; Dispositivos Android con Exynos 9810 y chips superiores, incluyengo Samsung Galaxy S9, S9+, Note9 y modelos m\u00e1s recientes.<\/li>\t<li>&#8226; Dispositivos Android con chips Tensor, incluyendo Google Pixel 6.<\/li>\t<li>Nota:<\/li>\t<li>1. Los dispositivos que no cumplen estas caracter\u00edsticas todav\u00eda pueden ser compatibles con la app que controla la c\u00e1mara, sin embargo, el rendimiento de algunas funciones que requieran de mayor procesador o de ser impulsadas por IA puede no ser \u00f3ptimo.<\/li>\t<li>2. Tras las pruebas, los dispositivos equipados con chips Qualcomm SDM765 5G tienen bajas capacidades de decodificaci\u00f3n de hardware y no son compatibles con su uso, como OPPO Reno 3 5G.<\/li>\t<li>3. La instalaci\u00f3n de la app requiere un tel\u00e9fono m\u00f3vil con un sistema de 64 bits. Un sistema de 32 bits no soporta la instalaci\u00f3n de la app.<\/li><\/ul><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-cam%20go%203%2064gb%20action%20k_1.jpg","wholesale_price":"366.19","unit_price_tax":371.19},"product_model":{"product_data":{"ean13":["6970357855117"],"reference":"GO303","name":{"1":"C\u00e1mara Digital Deportiva Insta360 GO 3 + Kit de Acci\u00f3n\/ 2.7K\/ \u00c1ngulo de visi\u00f3n 180\u00ba\/ Blanca","2":"","3":"","4":""},"description":{"1":"<h2>Insta360 GO 3 Kit de Acci\u00f3n 64GB<\/h2><div><p><ul><li>Ligera y port\u00e1til.<\/li><li>POVs en manos libres \u00fanicos.<\/li><li>Sistema de montaje magn\u00e9tico para \u00e1ngulos creativos.<\/li><li>Action Pod con control remoto y previsualizaci\u00f3n en directo.<\/li><li>Resistente al agua hasta 5 m. Action Pod con protecci\u00f3n IPX4 a prueba de salpicaduras.<\/li><\/ul><\/p><p><b>El kit imprescindible para los deportes de acci\u00f3n.<\/b><\/p><p>El Kit de Acci\u00f3n incluye: 1x GO 3 (64 GB), 1x Action Pod, 1x Protector de Lente (preinstalado en la lente por defecto), 1x Colgante Magn\u00e9tico, 1x Soporte Pivotante, 1x Easy Clip y 1x Montura de Liberaci\u00f3n R\u00e1pida.<\/p><p>Nota: Si usas marcapasos, no uses GO 3 cerca del pecho ni utilices el Colgante Magn\u00e9tico debido a su magnetismo.<\/p><\/div><p><\/p><h2>PEQUE\u00d1A POTENCIA<\/h2><p>35 g de puro potencial.<br>Es la c\u00e1mara de acci\u00f3n m\u00e1s peque\u00f1a del mundo. \u00a1M\u00f3ntala y ll\u00e9vatela a cualquier parte! <\/p><h2>CAPTURAS POV<\/h2><h2>Realmente no necesitas utilizar las manos.<\/h2><p>\u00a1Totalmente manos libres! S\u00f3lo tienes que configurarla y olvidarte de ella para conseguir f\u00e1cilmente tomas POV en ultra gran angular en 2.7K. <\/p><h2>ESTABILIZACI\u00d3N FLOWSTATE<\/h2><h2>Desp\u00eddete de los baches.<\/h2><p>Nuestra Estabilizaci\u00f3n FlowState se traduce en grabaciones incre\u00edblemente estables. Se eliminan las sacudidas, los golpes o los balanceos, \u00a1perfecta para cuando la acci\u00f3n comienza! <\/p><h2>HORIZON LOCK 360<\/h2><h2>Horizontes perfectamente nivelados.<\/h2><p>\u00a1Haz una voltereta! A GO 3 no le importa. \u00a1Tecnolog\u00eda insuperable para que el v\u00eddeo se mantenga perfectamente nivelado pase lo que pase! <\/p><h2>MONTAJE EN CUALQUIER LUGAR<\/h2><h2>Limitado s\u00f3lo por tu imaginaci\u00f3n.<\/h2><p>\u00a1Una c\u00e1mara diminuta significa montaje f\u00e1cil! Con su dise\u00f1o magn\u00e9tico y sus accesorios, GO 3 te ofrece infinitas posibilidades creativas, con \u00e1ngulos que ninguna otra c\u00e1mara puede igualar. \u00a1Piensa en mascotas, cascos o cualquier toma que se te ocurra! <\/p><h2>Grabaciones f\u00e1ciles.<\/h2><h2>QuickCapture<\/h2><h2>Control por voz 2.0<\/h2><p>\u00a1Se acabaron los problemas con los ajustes de la c\u00e1mara mientras se te escapa la toma perfecta! Incluso cuando la GO 3 est\u00e1 apagada, basta con pulsar el bot\u00f3n de la parte frontal de la c\u00e1mara para empezar a grabar al instante.\u00a1Libera el poder del Control por voz 2.0 con GO 3! Captura momentos memorables en un instante con un solo comando y mant\u00e9nte totalmente con las manos libres. <\/p><h2>ACCESORIOS INCLUIDOS<\/h2><p><strong>Colgante Magn\u00e9tico<\/strong><br>P\u00f3ntelo para tomas f\u00e1ciles en primera persona.<br><strong>Easy Clip<\/strong><br>Col\u00f3calo en tu gorra para conseguir \u00e1ngulos incre\u00edbles.<br><strong>Soporte Pivotante<\/strong><br>P\u00e9galo en cualquier sitio y captura \u00e1ngulos \u00fanicos. Adem\u00e1s, \u00a1es reutilizable!<br>*El Soporte Pivotante s\u00f3lo se puede pegar a superficies planas que est\u00e9n secas y limpias, por favor, no lo utilices en escenarios de acci\u00f3n.<br><strong>Protector de Lentes<\/strong><br>Gira y \u00a1vete! Protector de lentes extra\u00edble para capturar sin preocupaciones. <\/p><h2>BATER\u00cdA DE LARGA DURACI\u00d3N<\/h2><p><strong>Un d\u00fao supercargado.<\/strong><br>La bater\u00eda m\u00e1s grande de la GO 3 dura un 50% m\u00e1s que la de GO 2. \u00a1Une fuerzas con el Action Pod para grabar durante 170 minutos! Eso s\u00ed que es una mejora. <\/p><h2>PANTALLA T\u00c1CTIL ABATIBLE<\/h2><h2>\u00a1Dale la vuelta, te ves muy bien!<\/h2><p>Captura con GO 3 en el Action Pod para conseguir selfies perfectamente encuadrados, vlogging impecable o capturas a pulso precisas. <\/p><h2>VISTA PREVIA Y CONTROL REMOTOS<\/h2><h2>Tomas perfectas donde quiera que la montes.<\/h2><p>\u00bfTienes la GO 3 montada en otro sitio? Utiliza el Action Pod para previsualizar tus tomas y capturar como un profesional. <\/p><h2>MEN\u00da R\u00c1PIDO<\/h2><h2>Dame la configuraci\u00f3n \u00a1ya!<\/h2><p>\u00a1Accede a las opciones de captura preestablecidas y a los ajustes directamente desde la pantalla t\u00e1ctil! Basta con pulsar el bot\u00f3n Q para buscar y seleccionar. <\/p><h2>MONTAJE MAGN\u00c9TICO<\/h2><h2>Monta la GO 3 o el Action Pod.<\/h2><p>Tanto la c\u00e1mara GO 3 como el Action Pod se adaptan al mismo Soporte Pivotante y a la Montura de Liberaci\u00f3n R\u00e1pida, con un pestillo y un im\u00e1n para fijarlos en su sitio. <\/p><h2>ACTION POD ROBUSTO<\/h2><h2>Resistente a salpicaduras IPX4.<\/h2><p>\u00bfLas nubes parecen un poco grises? No hay necesidad de esconderse dentro. El Action Pod es resistente al agua IPX4 contra la lluvia y las salpicaduras. <\/p><h2>C\u00c1MARA RESISTENTE AL AGUA<\/h2><h2>Resistente al agua IPX8 hasta 5 metros.<\/h2><p>\u00a1A coger esas olas! Saca tu GO 3 del Action Pod y sum\u00e9rgela hasta 5 m sin preocuparte. <\/p><h2>AUDIO MEJORADO<\/h2><h2>Doble diversi\u00f3n.<\/h2><p>Graba audio con los 2 micr\u00f3fonos integrados. GO 3 captura audio listo para vlog de todo lo que te rodea. N\u00edtido, claro y envolvente. <\/p><h2>TimeShift<\/h2><p>Acelera el tiempo y el espacio. O al menos haz que lo parezca. <\/p><h2>C\u00e1mara lenta<\/h2><p>Si la vida te est\u00e1 viniendo demasiado r\u00e1pido, ralentiza las cosas x4 hasta 120fps.Dale un extra especial a tus fotos. Activa PureShot para obtener un rango din\u00e1mico m\u00e1s alto impulsado por IA.Mira el mundo pasar. Graba incre\u00edbles timelapses, incluso de noche. <\/p><h2>PureShot HDR<\/h2><p>Si la vida te est\u00e1 viniendo demasiado r\u00e1pido, ralentiza las cosas x4 hasta 120fps.Dale un extra especial a tus fotos. Activa PureShot para obtener un rango din\u00e1mico m\u00e1s alto impulsado por IA.<\/p><h2>Timelapse<\/h2><p>Mira el mundo pasar. Graba incre\u00edbles timelapses, incluso de noche.<\/p><h2>Deja que la IA haga el trabajo por ti.<\/h2><p>La edici\u00f3n autom\u00e1tica encuentra los momentos m\u00e1s destacados y los edita juntos al ritmo de la m\u00fasica. S\u00f3lo tienes que elegir tus clips y dejar que lo haga por ti. Definitivamente no es hacer trampa...<\/p><h2>EXPORTA EN CUALQUIER RELACI\u00d3N<\/h2><h2>Una toma, cualquier perspectiva.<\/h2><p>De cuadrado a pantalla panor\u00e1mica, elige tu relaci\u00f3n de aspecto despu\u00e9s de grabar con el modo FreeFrame. \u00bfListo para volverte viral? Elige 9:16 y la GO 3 no perder\u00e1 ning\u00fan detalle donde otras c\u00e1maras de acci\u00f3n recortan. <\/p><h2>MODO WEBCAM<\/h2><h2>\u00a1Conferencias sobre la marcha!<\/h2><p>\u00a1Se acabaron las webcams para port\u00e1tiles! Recibe llamadas sobre la marcha con una resoluci\u00f3n de 1080p y seguimiento autom\u00e1tico. <\/p><p><br><\/p><h2>Especificaciones<\/h2><ul>\t<li><strong>Apertura<\/strong><\/li>\t<li>F2.2<\/li>\t<li><strong>Distancia focal equivalente a 35 mm<\/strong><\/li>\t<li>11,24 mm<\/li>\t<li><strong>Resoluci\u00f3n de fotos<\/strong><\/li>\t<li>2560x1440 (16:9)<\/li>\t<li>2560x2560 (1:1)<\/li>\t<li>1440x2560 (9:16)<\/li>\t<li>2936x1088 (2.7:1)<\/li>\t<li><strong>Resoluci\u00f3n de v\u00eddeo<\/strong><\/li>\t<li>V\u00eddeo<\/li>\t<li>2.7K: 2720x1536@24\/25\/30fps<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li>V\u00eddeo FreeFrame<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li>Timelapse<\/li>\t<li>1440P: 2560x1440@30fps<\/li>\t<li>TimeShift<\/li>\t<li>1440P: 2560x1440@15\/30fps<\/li>\t<li>C\u00e1mara lenta<\/li>\t<li>1080P: 1920x1080@120fps<\/li>\t<li>Pre-grabaci\u00f3n<\/li>\t<li>2.7K&#65306;2720x1536@24\/25\/30fps<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li>Grabaci\u00f3n en Loop<\/li>\t<li>2.7K&#65306;2720x1536@24\/25\/30fps<\/li>\t<li>1440p: 2560x1440@24\/25\/30\/50fps<\/li>\t<li>1080p: 1920x1080@24\/25\/30\/50fps<\/li>\t<li><strong>Formato de fotos<\/strong><\/li>\t<li>INSP (puede exportarse a trav\u00e9s de la App o Insta360 Studio)<\/li>\t<li>DNG (puede exportarse a trav\u00e9s de la App o Studio)<\/li>\t<li><strong>Formato de v\u00eddeo<\/strong><\/li>\t<li>MP4<\/li>\t<li><strong>Modos de fotos<\/strong><\/li>\t<li>Fotos, Fotos HDR, Intervalo, Starlapse<\/li>\t<li><strong>Modos de v\u00eddeo<\/strong><\/li>\t<li>V\u00eddeo, V\u00eddeo FreeFrame, Timelapse, TimeShift, C\u00e1mara lenta, Pre-grabaci\u00f3n, Grabaci\u00f3n en Loop<\/li>\t<li><strong>Perfiles de color<\/strong><\/li>\t<li>Est\u00e1ndar, Vivid, Plano<\/li>\t<li><strong>Codificaci\u00f3n del v\u00eddeo<\/strong><\/li>\t<li>H.264<\/li>\t<li><strong>Tasa de bits m\u00e1xima<\/strong><\/li>\t<li>80 Mbps<\/li>\t<li><strong>Tiempo de exposici\u00f3n<\/strong><\/li>\t<li>\u00b14EV<\/li>\t<li><strong>Rango ISO<\/strong><\/li>\t<li>100-3200<\/li>\t<li><strong>Velocidad de obturaci\u00f3n<\/strong><\/li>\t<li>Fotos: 1\/8000 - 120 s<\/li>\t<li>V\u00eddeo: 1\/8000 - hasta l\u00edmite de fotogramas por segundo<\/li>\t<li><strong>Balance de blancos<\/strong><\/li>\t<li>Auto, 2000 - 10000K<\/li>\t<li><strong>Modos de audio<\/strong><\/li>\t<li>Reducci\u00f3n de viento, Est\u00e9reo, Mejora Direccional<\/li>\t<li><strong>Formato de audio<\/strong><\/li>\t<li>48 KHz, 24 bits, AAC<\/li>\t<li><strong>Peso<\/strong><\/li>\t<li>GO 3: 35,5 g<\/li>\t<li>Action Pod: 96,3 g<\/li>\t<li><strong>Dimensiones (An x Al x L)<\/strong><\/li>\t<li>GO 3: 25,6x54,4x23,2 mm<\/li>\t<li>Action Pod:<\/li>\t<li>Pantalla plegada: 63,5x47,6x29,5 mm<\/li>\t<li>Pantalla desplegada: 63,5x86,6x29,9 mm<\/li>\t<li><strong>Color<\/strong><\/li>\t<li>Blanco<\/li>\t<li><strong>Almacenamiento<\/strong><\/li>\t<li>64 GB<\/li>\t<li><strong>Capacidad de la bater\u00eda<\/strong><\/li>\t<li>GO 3: 310 mAh<\/li>\t<li>Action Pod: 1270 mAh<\/li>\t<li><strong>Modo de carga<\/strong><\/li>\t<li>GO 3: Action Pod<\/li>\t<li>Action Pod: Tipo-C<\/li>\t<li><strong>Tiempo de carga<\/strong><\/li>\t<li>C\u00e1mara: 23 minutos al 80%, 35 minutos al 100%<\/li>\t<li>Action Pod: 47 minutos al 80%, 65 minutos al 100%<\/li>\t<li><strong>Duraci\u00f3n de la bater\u00eda<\/strong><\/li>\t<li>GO 3: 45 mins<\/li>\t<li>GO 3 + Action Pod: 170 mins<\/li>\t<li>*Testeado a 25 \u00b0C en condiciones de laboratorio a 1080p@30fps en &#8220;Modo V\u00eddeo&#8221;, con la pantalla y el Wi-Fi apagados. El tiempo de uso puede variar en diferentes condiciones.<\/li>\t<li><strong>Temperatura \u00f3ptima de funcionamiento<\/strong><\/li>\t<li>GO 3: -20&#8451; a 40&#8451;<\/li>\t<li>Action Pod: -20&#8451; a 40&#8451;<\/li>\t<li><strong>Bluetooth<\/strong><\/li>\t<li>BLE 5.0<\/li>\t<li><strong>Wi-Fi<\/strong><\/li>\t<li>5GHz<\/li>\t<li>802.11a\/n\/ac<\/li>\t<li><strong>USB<\/strong><\/li>\t<li>Tipo-C<\/li>\t<li><strong>Giroscopio<\/strong><\/li>\t<li>Giroscopio de 6 ejes<\/li>\t<li><strong>Dispositivos compatibles<\/strong><\/li>\t<li>Dispositivos iOS:<\/li>\t<li>Compatible con dispositivos m\u00f3viles iOS con chips A11 o superiores y versi\u00f3n iOS 11.0 o superior, incluyendo iPhone SE 2, iPhone 8, iPhone 8 Plus, iPhone XR, iPhone XS, iPhone XS Max, iPhone X, iPhone 11, iPhone 11 Pro, iPhone 11 Pro Max, iPhone 12, iPhone 12 Pro, iPhone 12 Pro Max, iPhone 12 mini, iPhone 13, iPhone 13 Pro, iPhone 13 Pro Max, iPhone 13 mini, iPhone 14, iPhone 14 Pro, iPhone 14 Pro Max, iPad Air (2020), iPad Pro y nuevos modelos de iPad.<\/li>\t<li>Dispositivos Android:<\/li>\t<li>Compatible con dispositivos Android que cumplen con las siguientes caracter\u00edsticas, incluyendo:<\/li>\t<li>Dispositivos Android con Kirin 980 y chips superiores, incluyendo Huawei Mate 20, P30 o modelos m\u00e1s recientes.<\/li>\t<li>&#8226; Dispositivos Android con Snapdragon 845 y chips superiores, incluyendo Samsung Galaxy S9, Xiaomi Mi 8 o modelos m\u00e1s recientes.<\/li>\t<li>&#8226; Dispositivos Android con Exynos 9810 y chips superiores, incluyengo Samsung Galaxy S9, S9+, Note9 y modelos m\u00e1s recientes.<\/li>\t<li>&#8226; Dispositivos Android con chips Tensor, incluyendo Google Pixel 6.<\/li>\t<li>Nota:<\/li>\t<li>1. Los dispositivos que no cumplen estas caracter\u00edsticas todav\u00eda pueden ser compatibles con la app que controla la c\u00e1mara, sin embargo, el rendimiento de algunas funciones que requieran de mayor procesador o de ser impulsadas por IA puede no ser \u00f3ptimo.<\/li>\t<li>2. Tras las pruebas, los dispositivos equipados con chips Qualcomm SDM765 5G tienen bajas capacidades de decodificaci\u00f3n de hardware y no son compatibles con su uso, como OPPO Reno 3 5G.<\/li>\t<li>3. La instalaci\u00f3n de la app requiere un tel\u00e9fono m\u00f3vil con un sistema de 64 bits. Un sistema de 32 bits no soporta la instalaci\u00f3n de la app.<\/li><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"INSTA360","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":371.19,"unit_price_tax":371.19,"tax_rules_group":null,"category":"C\u00e1maras","sub_category":"Camaras Digitales","quantity":0,"brand":"INSTA360","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-cam%20go%203%2064gb%20action%20k_1.jpg"],"wholesale_price":366.19}}},"6970357852949":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6970357852949",false],"wholesale_price":[425.97,false],"price":[430.97,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:159357","Cat. IDs: 72","Associated Categories","Cat. Default: 72","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/12629061201fa6d111d59c0e54513981.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara Digital Deportiva Insta360 One RS Twin Edition\/ 5.7K\/ \u00c1ngulo de visi\u00f3n 360\u00ba\/ Negra y Roja","category":"C\u00e1maras","sub_category":"Camaras Digitales","unit_price":430.97,"reference":"CINRSGP\/A","ean13":"6970357852949","weight":"0","quantity":0,"brand":"INSTA360","description_pt":"<p><h2>Insta360 ONE RS<\/h2>Flexibilidad total. Sin compromisos. La \u00fanica c\u00e1mara de acci\u00f3n que captura alucinantes tomas de acci\u00f3n en 360\u00b0 y gran angular con solo cambiar una lente.<br><br><h2>Lentes intercambiables<\/h2>Versatilidad inigualable. Ten siempre la lente adecuada para cada escenario.<br><br><h2>Acci\u00f3n n\u00edtida<\/h2>Graba como una c\u00e1mara de acci\u00f3n tradicional con v\u00eddeo detallado en 4K 60fps + fotos de 48 MP.<br><br><h2>5.7K 360 imposible<\/h2>No vuelvas a perder una toma con la captura 360 + reencuadre.<br><br><h2>Robusta y resistente al agua<\/h2>S\u00e9 valiente y sum\u00e9rgela hasta los 5 metros sin preocuparse.<br><br><h2>HDR Activo<\/h2>Tomas de acci\u00f3n n\u00edtidas y vibrantes.<br><br><h2>Estabilizaci\u00f3n sin esfuerzo<\/h2>360 Horizon Lock + estabilizaci\u00f3n FlowState incorporada.<br><br><h2>Selfie Stick Invisible<\/h2>Vistas m\u00e1gicas en tercera persona y \u00e1ngulos tipo dron.<br><br><h2>Potente suite de edici\u00f3n<\/h2>Deja que la IA edite por ti en la aplicaci\u00f3n Insta360.<br><br><h2>Lente 4K Boost<\/h2>Conc\u00e9ntrate en la acci\u00f3n con la lente 4K Boost. Robusta y duradera, con un nuevo sensor de imagen de 48 MP de 1\/2' para v\u00eddeos 4K a 60 fps m\u00e1s detallados y fotos de 48 MP.<br><br><h2>Fotos de 48MP<\/h2>4x m\u00e1s megap\u00edxeles. Captura el detalle adicional que merecen esos momentos perfectos, con mejores colores e iluminaci\u00f3n.<br><br><h2>Modo de pantalla panor\u00e1mica 6K<\/h2>Graba metraje ultradetallado en 6K que se ver\u00eda como una pel\u00edcula de Hollywood en casa, con una relaci\u00f3n cl\u00e1sica de 2.35:1 para visualizaci\u00f3n en pantalla panor\u00e1mica.<br><br><h2>Lente 5.7K 360<\/h2>Captura primero, apunta despu\u00e9s. Captura la acci\u00f3n desde todos los \u00e1ngulos, elige en qu\u00e9 quieres enfocarte despu\u00e9s con el reencuadre 360. \u00dasalo con el Selfie Stick Invisible para tomas imposibles en tercera persona.<br><br><h2>La c\u00e1mara de acci\u00f3n todo en uno.<\/h2>Selfie Stick Invisible. \u00a1No arruines la vista con un selfie stick feo! La lente 360 hace que el Selfie Stick Invisible desaparezca por completo de tus tomas para obtener un metraje imposible similar al de un dron. \u00a1Magia!<br><br>Vista en tercera persona. \u00bfEst\u00e1s haciendo algo \u00e9pico pero no hay nadie cerca para ayudarte a tomar la foto? Captura perspectivas de locura en tercera persona con el Selfie Stick Invisible. Garantizado para que la gente pregunte '\u00bfc\u00f3mo grabaste eso?'<br><br>Estabilizaci\u00f3n FlowState Estabilizaci\u00f3n de imagen incre\u00edblemente suave, sin importar qu\u00e9 lente uses. El potente n\u00facleo RS ahora ofrece una estabilizaci\u00f3n FlowState en c\u00e1mara cuando se combina con la lente gran angular. No se necesita edici\u00f3n.<br><br>Horizon Lock. Capturas perfectamente niveladas, sin importar cu\u00e1nto inclines la c\u00e1mara. Las tres lentes admiten nivelaci\u00f3n de horizonte de 360\u00b0.<br><br>HDR Activo. Un nuevo e innovador modo de v\u00eddeo HDR para deportes de acci\u00f3n. El HDR Activo en la lente 4K Boost mantiene tu v\u00eddeo estabilizado mientras te mueves, al tiempo que mantiene los detalles de las luces y sombras para obtener im\u00e1genes m\u00e1s vibrantes.<br><br><h2>Resistente al agua hasta 5 metros<\/h2><br>Sumerge tu c\u00e1mara de acci\u00f3n hasta 5 metros bajo el agua sin preocupaciones.<br><h2>Dise\u00f1o resistente<\/h2>Los conectores de alto rendimiento y un dise\u00f1o estructural \u00fanico permiten una conexi\u00f3n estable entre los m\u00f3dulos, incluso en el punto \u00e1lgido de la acci\u00f3n.<br><h2>Formato cl\u00e1sico<\/h2>Consigue el formato cl\u00e1sico de c\u00e1mara de acci\u00f3n tradicional compatible con tus accesorios favoritos. Crea tu equipo ideal.<br><br><h2>M\u00e1s r\u00e1pido, m\u00e1s f\u00e1cil, mejor.<\/h2>Wi-Fi m\u00e1s r\u00e1pido. Transfiere y edita tus archivos m\u00e1s r\u00e1pido en la aplicaci\u00f3n Insta360, gracias al nuevo hardware del n\u00facleo.<br><br><b>Audio m\u00e1s n\u00edtido.<\/b> El n\u00facleo RS ahora tiene tres micr\u00f3fonos para capturar el audio que deseas y un algoritmo de reducci\u00f3n de ruido del viento para eliminar el ruido que no deseas.<br><br><b>Zoom instant\u00e1neo<\/b>. Haz zoom digitalmente hasta 2,7x en un sujeto mientras grabas, sin necesidad de configurar tu toma con anticipaci\u00f3n.<br><br><b>Menu r\u00e1pido.<\/b> Accede a todos tus ajustes preestablecidos de captura favoritos en un solo lugar con un solo toque. Cambia de modo sobre la marcha para seguir el ritmo de la acci\u00f3n.<br><br><h2>No hay necesidad de Wi-Fi<\/h2>Edita m\u00e1s r\u00e1pido en tu tel\u00e9fono y ahorra la bater\u00eda de tu c\u00e1mara en las transferencias WiFi. Simplemente conecta el Quick Reader en ONE RS para guardar archivos en la tarjeta SD interna, luego con\u00e9ctalo a tu tel\u00e9fono para comenzar a editar.<br><br><h2>Liberaci\u00f3n r\u00e1pida<\/h2>Simplemente presiona el bot\u00f3n para abrir el soporte, desliza la c\u00e1mara desde el costado y cambia las lentes sobre la marcha.<br><br><h2>Dise\u00f1o disipador de calor<\/h2>El soporte de montaje ayuda a mantener fr\u00eda la c\u00e1mara de acci\u00f3n para que pueda grabar durante m\u00e1s tiempo.<br><br><h2>Cubierta de micr\u00f3fono a prueba de viento<\/h2>Una cubierta de espuma especial a prueba de viento ayuda a bloquear los vientos fuertes y evita el ruido no deseado en tus v\u00eddeos.<br><br><h2>La aplicaci\u00f3n Insta360.<\/h2>Potentes herramientas de edici\u00f3n a tu alcance. Deja que la IA haga el trabajo con herramientas y plantillas de edici\u00f3n autom\u00e1tica, o marca tu edici\u00f3n con una gran cantidad de controles manuales.<br><br><b>Asistente de Snap.<\/b> La forma m\u00e1s f\u00e1cil y r\u00e1pida de editar v\u00eddeos 360.Reencuadra tus v\u00eddeos con solo girar tu tel\u00e9fono o deslizar un dedo. Todas tus ediciones se guardan al instante. Exporta y comparte con solo un toque.<br><br><b>FlashCut.<\/b> Plantillas f\u00e1ciles de edici\u00f3n autom\u00e1tica para tus v\u00eddeos de gran angular. Elige un tema y deja que la IA cree un v\u00eddeo pulido, editado al ritmo de la m\u00fasica.<br><br><b>Deep Track 2.0.<\/b> Toca una persona, un animal u otro objeto en movimiento. La IA har\u00e1 el resto, rastreando tu objetivo para mantenerlo en el centro del marco.<br><br><b>Encuadre autom\u00e1tico.<\/b> Toma las riendas y reencuadra con total control. Toca para agregar un fotograma clave y cambiar la perspectiva a tu gusto.<br><br><b>Shot Lab.<\/b> Cloning, hyperlapses, barrel rols, stop motion... Shot Lab lo tiene todo. Captura efectos asombrosos con la ayuda de la IA. \u00a1Simplemente importa tu metraje 360, elige un efecto y listo!<br><br><b>Edita como un profesional en el escritorio.<\/b> La nueva apariencia de Insta360 Studio facilita la edici\u00f3n en el escritorio. O salta directamente a la edici\u00f3n con el flujo de trabajo sin costuras del complemento de Adobe Premiere Pro.<br><br><b>Live Streaming.<\/b> Comparte tus aventuras mientras las experimentas con la lente 360. Reencuadra para controlar la perspectiva tu mismo o sumerge a tu audiencia con transmisi\u00f3n en vivo de 360\u00b0.<br><br><b>Webcam.<\/b> Ya sea que trabajes desde tu casa o en la oficina, conecta la lente 4K Boost o la lente 360 a tu ordenador para realizar videollamadas ultra-anchas y de alta resoluci\u00f3n.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Apertura<\/li>  <li>F2.4<\/li>  <li>Distancia focal equivalente a 35mm<\/li>  <li>16mm<\/li>  <li>Resoluci\u00f3n de fotos<\/li>  <li>8000x6000&#65288;4:3&#65289;<\/li>  <li>8000x4500 &#65288;16:9&#65289;<\/li>  <li>4000 x 3000&#65288;4:3&#65289;<\/li>  <li>4000 x 2250&#65288;16:9&#65289;<\/li>  <li>Resoluci\u00f3n de v\u00eddeo<\/li>  <li>6016x2560@25\/24 fps (en modo de pantalla panor\u00e1mica de 6K)<\/li>  <li>4000x3000@24\/25\/30fps,<\/li>  <li>3840x2160@24\/25\/30\/50\/60fps,<\/li>  <li>2720x1530@24\/25\/30\/60\/100fps,<\/li>  <li>1920x1080@24\/25\/30\/60\/120\/200fps<\/li>  <li>Formato de fotos<\/li>  <li>\u00b7 jpg<\/li>  <li>\u00b7 RAW (dng) (los archivos RAW requieren software en PC\/Mac para exportar).<\/li>  <li>Formato de v\u00eddeo<\/li>  <li>\u00b7 mp4 (para archivos con el prefijo 'PRO_', imp\u00f3rtalos en la aplicaci\u00f3n\/Studio para ajustar la relaci\u00f3n de aspecto y aplicar la estabilizaci\u00f3n Post FlowState)<\/li>  <li>Modos de fotograf\u00eda<\/li>  <li>Est\u00e1ndar, HDR, Intervalo, Night Shot, Starlapse, Burst, PureShot<\/li>  <li>Modos de v\u00eddeo<\/li>  <li>V\u00eddeo est\u00e1ndar, Slow Motion, HDR Activo, Timelapse, TimeShift, Grabaci\u00f3n en loop, pantalla panor\u00e1mica 6K<\/li>  <li>FlowState (estabilizaci\u00f3n en c\u00e1mara)<\/li>  <li>Post FlowState (estabilizaci\u00f3n en la aplicaci\u00f3n)<\/li>  <li>Color Profiles<\/li>  <li>V\u00edvido, Est\u00e1ndar, LOG<\/li>  <li>Peso<\/li>  <li>125.3g<\/li>  <li>Dimensiones (An x Al x Pr)<\/li>  <li>70.1x49.1x32.6mm<\/li>  <li>Autonom\u00eda<\/li>  <li>75 minutos<\/li>  <li>&nbsp;*Probado en un entorno de laboratorio en modo FlowState 4K@60fps<\/li>  <li>Tasa de bits de V\u00eddeo<\/li>  <li>100Mbps<\/li>  <li>Giroscopio<\/li>  <li>Giroscopio de 6 ejes<\/li>  <li>Dispositivos Compatibles<\/li>  <li>Dispositivos iOS:<\/li>  <li>Compatible con dispositivos m\u00f3viles iOS con chips A11 o superior e iOS versi\u00f3n&nbsp; 11.0 o superior, incluidos iPhone SE 2, iPhone 8, iPhone 8 Plus, iPhone XR, iPhone XS, iPhone XS Max, iPhone X, iPhone 11, iPhone 11 Pro, iPhone 11 Pro Max, iPhone 12, iPhone 12 Pro, iPhone 12 Pro Max, iPhone 12 mini,iPhone 13, iPhone 13 Pro, iPhone 13 Pro Max, iPhone 13 mini,&nbsp; iPad Air (2020), iPad Pro y modelos de iPad m\u00e1s nuevos.<\/li>  <li>Dispositivos Android<\/li>  <li>Compatible con dispositivos m\u00f3viles Android que cumplan con las siguientes caracter\u00edsticas, que incluyen:<\/li>  <li>Dispositivos Android con chips Kirin 980 y superiores, incluyendo Huawei Mate 20, P30 o modelos m\u00e1s nuevos.<\/li>  <li>&nbsp;&#8226;Dispositivos Android con chips Snapdragon 845 y superiores, incluyendo Samsung Galaxy S9, Xiaomi Mi 8 o modelos m\u00e1s recientes.<\/li>  <li>&nbsp;&#8226;Dispositivos Android con chips Exynos 9810 y superiores, incluyendo Samsung Galaxy S9, S9+, Note9 y modelos m\u00e1s recientes.<\/li>  <li>&nbsp;&#8226;Dipositivos Android con chips Tensor, incluyendo Google Pixel 6.<\/li>    <li>Nota:<\/li>  <li>1. Es posible que los dispositivos que no cumplan con los requisitos anteriores a\u00fan puedan usar la aplicaci\u00f3n para controlar la c\u00e1mara; sin embargo, el rendimiento de algunas funciones que requieren un uso intensivo del procesador y que funcionan con inteligencia artificial puede no ser \u00f3ptimo.<\/li>  <li>2. Despu\u00e9s de la prueba, los tel\u00e9fonos equipados con chips Qualcomm SDM765 5G tienen capacidades de decodificaci\u00f3n de hardware deficientes y no son compatibles para su uso, como OPPO Reno 3 5G.<\/li>  <li>3. La instalaci\u00f3n de la aplicaci\u00f3n requiere un tel\u00e9fono m\u00f3vil con un sistema de 64 bits. Un sistema de 32 bits no admite la instalaci\u00f3n de aplicaciones.<\/li>  <li>Valor de exposici\u00f3n<\/li>  <li>\u00b14EV<\/li>  <li>Rango ISO<\/li>  <li>Foto: 100-6400<\/li>  <li>V\u00eddeo: 100-6400<\/li>  <li>Velocidad de obturaci\u00f3n<\/li>  <li>Foto: 1\/8000 - 120s<\/li>  <li>V\u00eddeo: 1\/8000 - hasta el l\u00edmite de fotogramas por segundo<\/li>  <li>Balance de blancos<\/li>  <li>2000K~10000K<\/li>  <li>Modos de audio<\/li>  <li>Reducci\u00f3n de viento<\/li>  <li>Mejora direccional<\/li>  <li>Est\u00e9reo<\/li>  <li>Formato de audio<\/li>  <li>48KHz&#65292;AAC<\/li>  <li>Bluetooth<\/li>  <li>BLE5.0<\/li>  <li>Wi-Fi<\/li>  <li>5GHz, 802.11a\/n\/ac<\/li>  <li>*alcance est\u00e1ndar de aproximadamente 20 metros, velocidad m\u00e1xima de transmisi\u00f3n de 20 MB\/s<\/li>  <li>USB<\/li>  <li>Tipo C<\/li>  <li>*Nota: esta c\u00e1mara solo admite conexi\u00f3n por cable a dispositivos Android (a trav\u00e9s de Micro-USB o Type-C). No es compatible con la conexi\u00f3n por cable a dispositivos iOS. El soporte inal\u00e1mbrico completo est\u00e1 disponible para iOS y Android<\/li>  <li>Tarjeta MicroSD<\/li>  <li>Se recomiendan tarjetas microSD con formato exFAT con interfaz de bus UHS-I y clasificaci\u00f3n de velocidad de v\u00eddeo V30 (exactamente esta clase, ni superior ni inferior) con un almacenamiento m\u00e1ximo de 1 TB.<\/li>  <li>Capacidad de la bater\u00eda<\/li>  <li>1445mAh<\/li>  <li>Modo de carga<\/li>  <li>Type-C USB<\/li>  <li>Tiempo de carga<\/li>  <li>70 minutos (apagada)<\/li>  <li>Temperatura de funcionamiento<\/li>  <li>-20\u00b0C a 40\u00b0C<\/li>  <li>Incluye: 1x Lente 4K Boost, 1x Lente 360, 1x N\u00facleo ONE RS, 1x Bater\u00eda ONE RS, 1x Capuch\u00f3n de lentes para la lente 360 y 1x Soporte de montaje ONE RS.<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-cam%20one%20rs%20twin_1.jpg","wholesale_price":"425.97","unit_price_tax":430.97},"product_model":{"product_data":{"ean13":["6970357852949"],"reference":"CINRSGP\/A","name":{"1":"C\u00e1mara Digital Deportiva Insta360 One RS Twin Edition\/ 5.7K\/ \u00c1ngulo de visi\u00f3n 360\u00ba\/ Negra y Roja","2":"","3":"","4":""},"description":{"1":"<p><h2>Insta360 ONE RS<\/h2>Flexibilidad total. Sin compromisos. La \u00fanica c\u00e1mara de acci\u00f3n que captura alucinantes tomas de acci\u00f3n en 360\u00b0 y gran angular con solo cambiar una lente.<br><br><h2>Lentes intercambiables<\/h2>Versatilidad inigualable. Ten siempre la lente adecuada para cada escenario.<br><br><h2>Acci\u00f3n n\u00edtida<\/h2>Graba como una c\u00e1mara de acci\u00f3n tradicional con v\u00eddeo detallado en 4K 60fps + fotos de 48 MP.<br><br><h2>5.7K 360 imposible<\/h2>No vuelvas a perder una toma con la captura 360 + reencuadre.<br><br><h2>Robusta y resistente al agua<\/h2>S\u00e9 valiente y sum\u00e9rgela hasta los 5 metros sin preocuparse.<br><br><h2>HDR Activo<\/h2>Tomas de acci\u00f3n n\u00edtidas y vibrantes.<br><br><h2>Estabilizaci\u00f3n sin esfuerzo<\/h2>360 Horizon Lock + estabilizaci\u00f3n FlowState incorporada.<br><br><h2>Selfie Stick Invisible<\/h2>Vistas m\u00e1gicas en tercera persona y \u00e1ngulos tipo dron.<br><br><h2>Potente suite de edici\u00f3n<\/h2>Deja que la IA edite por ti en la aplicaci\u00f3n Insta360.<br><br><h2>Lente 4K Boost<\/h2>Conc\u00e9ntrate en la acci\u00f3n con la lente 4K Boost. Robusta y duradera, con un nuevo sensor de imagen de 48 MP de 1\/2' para v\u00eddeos 4K a 60 fps m\u00e1s detallados y fotos de 48 MP.<br><br><h2>Fotos de 48MP<\/h2>4x m\u00e1s megap\u00edxeles. Captura el detalle adicional que merecen esos momentos perfectos, con mejores colores e iluminaci\u00f3n.<br><br><h2>Modo de pantalla panor\u00e1mica 6K<\/h2>Graba metraje ultradetallado en 6K que se ver\u00eda como una pel\u00edcula de Hollywood en casa, con una relaci\u00f3n cl\u00e1sica de 2.35:1 para visualizaci\u00f3n en pantalla panor\u00e1mica.<br><br><h2>Lente 5.7K 360<\/h2>Captura primero, apunta despu\u00e9s. Captura la acci\u00f3n desde todos los \u00e1ngulos, elige en qu\u00e9 quieres enfocarte despu\u00e9s con el reencuadre 360. \u00dasalo con el Selfie Stick Invisible para tomas imposibles en tercera persona.<br><br><h2>La c\u00e1mara de acci\u00f3n todo en uno.<\/h2>Selfie Stick Invisible. \u00a1No arruines la vista con un selfie stick feo! La lente 360 hace que el Selfie Stick Invisible desaparezca por completo de tus tomas para obtener un metraje imposible similar al de un dron. \u00a1Magia!<br><br>Vista en tercera persona. \u00bfEst\u00e1s haciendo algo \u00e9pico pero no hay nadie cerca para ayudarte a tomar la foto? Captura perspectivas de locura en tercera persona con el Selfie Stick Invisible. Garantizado para que la gente pregunte '\u00bfc\u00f3mo grabaste eso?'<br><br>Estabilizaci\u00f3n FlowState Estabilizaci\u00f3n de imagen incre\u00edblemente suave, sin importar qu\u00e9 lente uses. El potente n\u00facleo RS ahora ofrece una estabilizaci\u00f3n FlowState en c\u00e1mara cuando se combina con la lente gran angular. No se necesita edici\u00f3n.<br><br>Horizon Lock. Capturas perfectamente niveladas, sin importar cu\u00e1nto inclines la c\u00e1mara. Las tres lentes admiten nivelaci\u00f3n de horizonte de 360\u00b0.<br><br>HDR Activo. Un nuevo e innovador modo de v\u00eddeo HDR para deportes de acci\u00f3n. El HDR Activo en la lente 4K Boost mantiene tu v\u00eddeo estabilizado mientras te mueves, al tiempo que mantiene los detalles de las luces y sombras para obtener im\u00e1genes m\u00e1s vibrantes.<br><br><h2>Resistente al agua hasta 5 metros<\/h2><br>Sumerge tu c\u00e1mara de acci\u00f3n hasta 5 metros bajo el agua sin preocupaciones.<br><h2>Dise\u00f1o resistente<\/h2>Los conectores de alto rendimiento y un dise\u00f1o estructural \u00fanico permiten una conexi\u00f3n estable entre los m\u00f3dulos, incluso en el punto \u00e1lgido de la acci\u00f3n.<br><h2>Formato cl\u00e1sico<\/h2>Consigue el formato cl\u00e1sico de c\u00e1mara de acci\u00f3n tradicional compatible con tus accesorios favoritos. Crea tu equipo ideal.<br><br><h2>M\u00e1s r\u00e1pido, m\u00e1s f\u00e1cil, mejor.<\/h2>Wi-Fi m\u00e1s r\u00e1pido. Transfiere y edita tus archivos m\u00e1s r\u00e1pido en la aplicaci\u00f3n Insta360, gracias al nuevo hardware del n\u00facleo.<br><br><b>Audio m\u00e1s n\u00edtido.<\/b> El n\u00facleo RS ahora tiene tres micr\u00f3fonos para capturar el audio que deseas y un algoritmo de reducci\u00f3n de ruido del viento para eliminar el ruido que no deseas.<br><br><b>Zoom instant\u00e1neo<\/b>. Haz zoom digitalmente hasta 2,7x en un sujeto mientras grabas, sin necesidad de configurar tu toma con anticipaci\u00f3n.<br><br><b>Menu r\u00e1pido.<\/b> Accede a todos tus ajustes preestablecidos de captura favoritos en un solo lugar con un solo toque. Cambia de modo sobre la marcha para seguir el ritmo de la acci\u00f3n.<br><br><h2>No hay necesidad de Wi-Fi<\/h2>Edita m\u00e1s r\u00e1pido en tu tel\u00e9fono y ahorra la bater\u00eda de tu c\u00e1mara en las transferencias WiFi. Simplemente conecta el Quick Reader en ONE RS para guardar archivos en la tarjeta SD interna, luego con\u00e9ctalo a tu tel\u00e9fono para comenzar a editar.<br><br><h2>Liberaci\u00f3n r\u00e1pida<\/h2>Simplemente presiona el bot\u00f3n para abrir el soporte, desliza la c\u00e1mara desde el costado y cambia las lentes sobre la marcha.<br><br><h2>Dise\u00f1o disipador de calor<\/h2>El soporte de montaje ayuda a mantener fr\u00eda la c\u00e1mara de acci\u00f3n para que pueda grabar durante m\u00e1s tiempo.<br><br><h2>Cubierta de micr\u00f3fono a prueba de viento<\/h2>Una cubierta de espuma especial a prueba de viento ayuda a bloquear los vientos fuertes y evita el ruido no deseado en tus v\u00eddeos.<br><br><h2>La aplicaci\u00f3n Insta360.<\/h2>Potentes herramientas de edici\u00f3n a tu alcance. Deja que la IA haga el trabajo con herramientas y plantillas de edici\u00f3n autom\u00e1tica, o marca tu edici\u00f3n con una gran cantidad de controles manuales.<br><br><b>Asistente de Snap.<\/b> La forma m\u00e1s f\u00e1cil y r\u00e1pida de editar v\u00eddeos 360.Reencuadra tus v\u00eddeos con solo girar tu tel\u00e9fono o deslizar un dedo. Todas tus ediciones se guardan al instante. Exporta y comparte con solo un toque.<br><br><b>FlashCut.<\/b> Plantillas f\u00e1ciles de edici\u00f3n autom\u00e1tica para tus v\u00eddeos de gran angular. Elige un tema y deja que la IA cree un v\u00eddeo pulido, editado al ritmo de la m\u00fasica.<br><br><b>Deep Track 2.0.<\/b> Toca una persona, un animal u otro objeto en movimiento. La IA har\u00e1 el resto, rastreando tu objetivo para mantenerlo en el centro del marco.<br><br><b>Encuadre autom\u00e1tico.<\/b> Toma las riendas y reencuadra con total control. Toca para agregar un fotograma clave y cambiar la perspectiva a tu gusto.<br><br><b>Shot Lab.<\/b> Cloning, hyperlapses, barrel rols, stop motion... Shot Lab lo tiene todo. Captura efectos asombrosos con la ayuda de la IA. \u00a1Simplemente importa tu metraje 360, elige un efecto y listo!<br><br><b>Edita como un profesional en el escritorio.<\/b> La nueva apariencia de Insta360 Studio facilita la edici\u00f3n en el escritorio. O salta directamente a la edici\u00f3n con el flujo de trabajo sin costuras del complemento de Adobe Premiere Pro.<br><br><b>Live Streaming.<\/b> Comparte tus aventuras mientras las experimentas con la lente 360. Reencuadra para controlar la perspectiva tu mismo o sumerge a tu audiencia con transmisi\u00f3n en vivo de 360\u00b0.<br><br><b>Webcam.<\/b> Ya sea que trabajes desde tu casa o en la oficina, conecta la lente 4K Boost o la lente 360 a tu ordenador para realizar videollamadas ultra-anchas y de alta resoluci\u00f3n.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Apertura<\/li>  <li>F2.4<\/li>  <li>Distancia focal equivalente a 35mm<\/li>  <li>16mm<\/li>  <li>Resoluci\u00f3n de fotos<\/li>  <li>8000x6000&#65288;4:3&#65289;<\/li>  <li>8000x4500 &#65288;16:9&#65289;<\/li>  <li>4000 x 3000&#65288;4:3&#65289;<\/li>  <li>4000 x 2250&#65288;16:9&#65289;<\/li>  <li>Resoluci\u00f3n de v\u00eddeo<\/li>  <li>6016x2560@25\/24 fps (en modo de pantalla panor\u00e1mica de 6K)<\/li>  <li>4000x3000@24\/25\/30fps,<\/li>  <li>3840x2160@24\/25\/30\/50\/60fps,<\/li>  <li>2720x1530@24\/25\/30\/60\/100fps,<\/li>  <li>1920x1080@24\/25\/30\/60\/120\/200fps<\/li>  <li>Formato de fotos<\/li>  <li>\u00b7 jpg<\/li>  <li>\u00b7 RAW (dng) (los archivos RAW requieren software en PC\/Mac para exportar).<\/li>  <li>Formato de v\u00eddeo<\/li>  <li>\u00b7 mp4 (para archivos con el prefijo 'PRO_', imp\u00f3rtalos en la aplicaci\u00f3n\/Studio para ajustar la relaci\u00f3n de aspecto y aplicar la estabilizaci\u00f3n Post FlowState)<\/li>  <li>Modos de fotograf\u00eda<\/li>  <li>Est\u00e1ndar, HDR, Intervalo, Night Shot, Starlapse, Burst, PureShot<\/li>  <li>Modos de v\u00eddeo<\/li>  <li>V\u00eddeo est\u00e1ndar, Slow Motion, HDR Activo, Timelapse, TimeShift, Grabaci\u00f3n en loop, pantalla panor\u00e1mica 6K<\/li>  <li>FlowState (estabilizaci\u00f3n en c\u00e1mara)<\/li>  <li>Post FlowState (estabilizaci\u00f3n en la aplicaci\u00f3n)<\/li>  <li>Color Profiles<\/li>  <li>V\u00edvido, Est\u00e1ndar, LOG<\/li>  <li>Peso<\/li>  <li>125.3g<\/li>  <li>Dimensiones (An x Al x Pr)<\/li>  <li>70.1x49.1x32.6mm<\/li>  <li>Autonom\u00eda<\/li>  <li>75 minutos<\/li>  <li>&nbsp;*Probado en un entorno de laboratorio en modo FlowState 4K@60fps<\/li>  <li>Tasa de bits de V\u00eddeo<\/li>  <li>100Mbps<\/li>  <li>Giroscopio<\/li>  <li>Giroscopio de 6 ejes<\/li>  <li>Dispositivos Compatibles<\/li>  <li>Dispositivos iOS:<\/li>  <li>Compatible con dispositivos m\u00f3viles iOS con chips A11 o superior e iOS versi\u00f3n&nbsp; 11.0 o superior, incluidos iPhone SE 2, iPhone 8, iPhone 8 Plus, iPhone XR, iPhone XS, iPhone XS Max, iPhone X, iPhone 11, iPhone 11 Pro, iPhone 11 Pro Max, iPhone 12, iPhone 12 Pro, iPhone 12 Pro Max, iPhone 12 mini,iPhone 13, iPhone 13 Pro, iPhone 13 Pro Max, iPhone 13 mini,&nbsp; iPad Air (2020), iPad Pro y modelos de iPad m\u00e1s nuevos.<\/li>  <li>Dispositivos Android<\/li>  <li>Compatible con dispositivos m\u00f3viles Android que cumplan con las siguientes caracter\u00edsticas, que incluyen:<\/li>  <li>Dispositivos Android con chips Kirin 980 y superiores, incluyendo Huawei Mate 20, P30 o modelos m\u00e1s nuevos.<\/li>  <li>&nbsp;&#8226;Dispositivos Android con chips Snapdragon 845 y superiores, incluyendo Samsung Galaxy S9, Xiaomi Mi 8 o modelos m\u00e1s recientes.<\/li>  <li>&nbsp;&#8226;Dispositivos Android con chips Exynos 9810 y superiores, incluyendo Samsung Galaxy S9, S9+, Note9 y modelos m\u00e1s recientes.<\/li>  <li>&nbsp;&#8226;Dipositivos Android con chips Tensor, incluyendo Google Pixel 6.<\/li>    <li>Nota:<\/li>  <li>1. Es posible que los dispositivos que no cumplan con los requisitos anteriores a\u00fan puedan usar la aplicaci\u00f3n para controlar la c\u00e1mara; sin embargo, el rendimiento de algunas funciones que requieren un uso intensivo del procesador y que funcionan con inteligencia artificial puede no ser \u00f3ptimo.<\/li>  <li>2. Despu\u00e9s de la prueba, los tel\u00e9fonos equipados con chips Qualcomm SDM765 5G tienen capacidades de decodificaci\u00f3n de hardware deficientes y no son compatibles para su uso, como OPPO Reno 3 5G.<\/li>  <li>3. La instalaci\u00f3n de la aplicaci\u00f3n requiere un tel\u00e9fono m\u00f3vil con un sistema de 64 bits. Un sistema de 32 bits no admite la instalaci\u00f3n de aplicaciones.<\/li>  <li>Valor de exposici\u00f3n<\/li>  <li>\u00b14EV<\/li>  <li>Rango ISO<\/li>  <li>Foto: 100-6400<\/li>  <li>V\u00eddeo: 100-6400<\/li>  <li>Velocidad de obturaci\u00f3n<\/li>  <li>Foto: 1\/8000 - 120s<\/li>  <li>V\u00eddeo: 1\/8000 - hasta el l\u00edmite de fotogramas por segundo<\/li>  <li>Balance de blancos<\/li>  <li>2000K~10000K<\/li>  <li>Modos de audio<\/li>  <li>Reducci\u00f3n de viento<\/li>  <li>Mejora direccional<\/li>  <li>Est\u00e9reo<\/li>  <li>Formato de audio<\/li>  <li>48KHz&#65292;AAC<\/li>  <li>Bluetooth<\/li>  <li>BLE5.0<\/li>  <li>Wi-Fi<\/li>  <li>5GHz, 802.11a\/n\/ac<\/li>  <li>*alcance est\u00e1ndar de aproximadamente 20 metros, velocidad m\u00e1xima de transmisi\u00f3n de 20 MB\/s<\/li>  <li>USB<\/li>  <li>Tipo C<\/li>  <li>*Nota: esta c\u00e1mara solo admite conexi\u00f3n por cable a dispositivos Android (a trav\u00e9s de Micro-USB o Type-C). No es compatible con la conexi\u00f3n por cable a dispositivos iOS. El soporte inal\u00e1mbrico completo est\u00e1 disponible para iOS y Android<\/li>  <li>Tarjeta MicroSD<\/li>  <li>Se recomiendan tarjetas microSD con formato exFAT con interfaz de bus UHS-I y clasificaci\u00f3n de velocidad de v\u00eddeo V30 (exactamente esta clase, ni superior ni inferior) con un almacenamiento m\u00e1ximo de 1 TB.<\/li>  <li>Capacidad de la bater\u00eda<\/li>  <li>1445mAh<\/li>  <li>Modo de carga<\/li>  <li>Type-C USB<\/li>  <li>Tiempo de carga<\/li>  <li>70 minutos (apagada)<\/li>  <li>Temperatura de funcionamiento<\/li>  <li>-20\u00b0C a 40\u00b0C<\/li>  <li>Incluye: 1x Lente 4K Boost, 1x Lente 360, 1x N\u00facleo ONE RS, 1x Bater\u00eda ONE RS, 1x Capuch\u00f3n de lentes para la lente 360 y 1x Soporte de montaje ONE RS.<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"INSTA360","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":430.97,"unit_price_tax":430.97,"tax_rules_group":null,"category":"C\u00e1maras","sub_category":"Camaras Digitales","quantity":0,"brand":"INSTA360","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-cam%20one%20rs%20twin_1.jpg"],"wholesale_price":425.97}}},"0819900013948":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0819900013948",false],"wholesale_price":[129.92,false],"price":[134.92,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:159358","Cat. IDs: 72","Associated Categories","Cat. Default: 72","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d9f770c91b519e32825b454f3816980a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara Digital Deportiva Kodak Pixpro WPZ2\/ 16MP\/ Zoom \u00d3ptico 4x\/ Amarilla","category":"C\u00e1maras","sub_category":"Camaras Digitales","unit_price":134.92,"reference":"WPZ2Y","ean13":"0819900013948","weight":"0","quantity":0,"brand":"KODAK","description_pt":"<p><h2>C\u00e1mara resistente<\/h2><p>La c\u00e1mara digital KODAK PIXPRO WPZ2 es la compa\u00f1era perfecta para mojarse. A prueba de golpes, a prueba de polvo y listo para la aventura, el WPZ2 fue dise\u00f1ado para llevarlo en movimiento y usarse dentro, sobre y debajo del agua, hasta 15 m. Con una gran cantidad de modos de escena para ayudarlo a capturar la mejor toma, as\u00ed como video HD, el WPZ2 no perder\u00e1 el ritmo.<\/p><ul><li>Zoom \u00f3ptico 4x<\/li><li>Sensor CMOS BSI de 16MP<\/li><li>V\u00eddeo de alta definici\u00f3n de 1080p<\/li><li>Estabilizaci\u00f3n de imagen digital<\/li><li>15 m resistente al agua<\/li><li>2m a prueba de golpes<\/li><li>Pantalla LCD de 2,7' y 230K<\/li><li>Bater\u00eda recargable de iones de litio<\/li><\/ul><h2>ZOOM \u00d3PTICO 4X<\/h2><p>El WPZ2 es lo suficientemente resistente como para llevarlo a donde est\u00e1 la acci\u00f3n, pero a veces necesita una toma que est\u00e9 justo en el centro de todo. Con el zoom \u00f3ptico 4X, puede obtener un primer plano sin terminar en la zona de impacto.<\/p><h2>IMPERMEABLE 15M<\/h2><p>\u00bfA veces te sientes m\u00e1s c\u00f3modo en el agua que en tierra? Lo mismo ocurre con esta c\u00e1mara. Es f\u00e1cil de agarrar, simple de disparar y herm\u00e9tico. Nunca tendr\u00e1s que preocuparte por recibir la inyecci\u00f3n.<\/p><h2>2M A PRUEBA DE CHOQUE<\/h2><p>Las actividades rigurosas requieren accesorios resistentes. Si su equipo necesita poder recibir una paliza, est\u00e1 de suerte con el WPZ2. Con una clasificaci\u00f3n a prueba de golpes de hasta 2 metros (6,56 pies), los golpes y contusiones de los dispositivos no son un problema.<\/p><h2>A PRUEBA DE POLVO<\/h2><p>Los mejores lugares de vacaciones y aventuras consisten en algo m\u00e1s que agua. Tambi\u00e9n hay mucha sal, arena y gravilla que pueden llegar a todas partes. En todas partes excepto en el interior del WPZ2, eso es.<\/p><h2>CMOS BSI de 16MP<\/h2><p>Los 16 megap\u00edxeles le permiten capturar una claridad realista en im\u00e1genes bien definidas y detalladas, sin perder calidad a medida que las modifica m\u00e1s adelante. \u00a1Recorta, ampl\u00eda y libera al fot\u00f3grafo que llevas dentro!<\/p><h2>V\u00cdDEO DE ALTA DEFINICI\u00d3N DE 1080p<\/h2><p>Te gusta estar donde est\u00e1 la acci\u00f3n. Su resistente WPZ2 no solo puede hacer el viaje con usted, sino tambi\u00e9n capturar sus aventuras en video de alta definici\u00f3n para ayudarlo a contar mejor su historia.<\/p><h2>F\u00c1CIL CONECTIVIDAD Wi-Fi\u00ae<\/h2><p>\u00a1Que nadie se pierda la acci\u00f3n! La c\u00e1mara resistente KODAK PIXPRO WPZ2 se puede conectar f\u00e1cilmente de forma inal\u00e1mbrica a su dispositivo inteligente para que pueda cargar y compartir sus mejores fotograf\u00edas con amigos, familiares y el mundo mientras viaja. Ahora que hace la vida m\u00e1s f\u00e1cil, \u00bfno?<\/p><h2>EMPEZANDO<\/h2><p>\u00a1Mira nuestro video de desempaquetado! Adem\u00e1s de la c\u00e1mara digital KODAK PIXPRO WPZ2, tambi\u00e9n recibe: una bater\u00eda recargable de iones de litio, un cable USB, un adaptador de CA, una mu\u00f1equera, una gu\u00eda de inicio r\u00e1pido, una tarjeta de garant\u00eda y una tarjeta de servicio.<\/p><h2>\u00a1COMPARTE EN LA COMUNIDAD!<\/h2><p>Sea parte de nuestra familia de fot\u00f3grafos dedicados desde hace mucho tiempo. La comunidad de c\u00e1maras KODAK PIXPRO es para los entusiastas de las im\u00e1genes que desean aprender, experimentar y compartir.<\/p><h2>Especificaciones<\/h2><ul><li><strong>SENSOR DE IMAGEN EFECTIVA P\u00cdXELES<\/strong>&nbsp;16,35 Megap\u00edxeles<\/li><li><strong>P\u00cdXELES TOTALES DEL SENSOR DE IMAGEN<\/strong>&nbsp;16,76 megap\u00edxeles [1\/2,3' BSI CMOS]<\/li><li><strong>LENTE<\/strong>&nbsp;Distancia focal 4,9 mm (Gran angular) - 19,6 mm (Teleobjetivo) [equivalente en pel\u00edcula de 35 mm] [27 mm (Gran angular) - 108 mm (Teleobjetivo)] N\u00famero F F3,0 (Gran angular) - F6,6 (Teleobjetivo) Construcci\u00f3n del objetivo 7 grupos 7 elementos Zoom \u00f3ptico 4x Rango de enfoque Normal: (Gran angular) 60 cm - &#8734; (Teleobjetivo) 100 cm - &#8734;<\/li><li>Macro: 5 cm - &#8734; (solo ancho)<\/li><li><strong>SISTEMA DE ENFOQUE AUTOM\u00c1TICO TTL<\/strong>&nbsp;Autoenfoque<\/li><li>Estabilizaci\u00f3n de imagen digital ANTI-HANDSHAKE<\/li><li><strong>ZOOM DIGITAL<\/strong>&nbsp;Zoom digital 6x (zoom combinado: 24x)<\/li><li><strong>N\u00daMERO DE P\u00cdXELES DE GRABACI\u00d3N<\/strong>&nbsp;Imagen fija (4:3) 16 MP: 4608 x 3456, 10 MP: 3648 x 2736, 5 MP: 2592 x 1944, 3 MP: 2048 x 1536, 0,3 MP: 640 x 480, (3:2) 14 MP: 4608 x 3072, (16:9: 4608, 222 MP) 2MP: 1920x1080 Pel\u00edcula 1920x1080 (30fps), 1280x720 (60fps\/30fps), 640x480 (30fps), Pel\u00edcula de alta velocidad 640x480 (120fps)<\/li><li><strong>COMPRESI\u00d3N DE IMAGEN<\/strong>&nbsp;\u00d3ptima, Fina, Normal<\/li><li><strong>SOPORTE DCF, DPOF<\/strong>&nbsp;(VER 1.1) S\u00ed<\/li><li><strong>FORMATO DE ARCHIVO<\/strong>&nbsp;Imagen fija Exif 2.3 (JPEG) Pel\u00edcula MOV (H.264), Audio: PCM lineal (monoaural)<\/li><li><strong>MODOS DE DISPARO<\/strong>&nbsp;Autom\u00e1tico, P, M, Wi-Fi, SCN, Pel\u00edcula, Submarino<\/li><li><strong>MODOS SCN<\/strong>&nbsp;Panor\u00e1mica, Ni\u00f1os, Retrato, Retrato nocturno, Paisaje, Deporte, Puesta de sol, Fuegos artificiales, Nieve, Fiesta, Playa, Paisaje nocturno, Vidrio, Toma panor\u00e1mica, Interior, Hoja, Museo, Estabilizaci\u00f3n de imagen<\/li><li><strong>CARACTER\u00cdSTICAS DE DETECCI\u00d3N<\/strong>&nbsp;Rostro, Sonrisa, Parpadeo<\/li><li><strong>IMPERMEABLE<\/strong>&nbsp;Hasta 49 pies \/ 15 m<\/li><li><strong>A PRUEBA DE GOLPES<\/strong>&nbsp;Hasta 6 pies \/ 2 m<\/li><li><strong>A PRUEBA DE POLVO<\/strong>&nbsp;Equivalente a JIS\/IEC (IP6X)<\/li><li><strong>ELIMINACI\u00d3N DE OJOS ROJOS<\/strong>&nbsp;S\u00ed<\/li><li><strong>HDR (ALTO RANGO DIN\u00c1MICO)<\/strong>&nbsp;S\u00ed (Posprocesamiento)<\/li><li><strong>ESCANEAR PANORAMA<\/strong>&nbsp;Hasta 360\u00b0<\/li><li><strong>PANTALLA LCD<\/strong>&nbsp;2.7 pulgadas (230K P\u00edxeles)<\/li><li><strong>SENSIBILIDAD<\/strong>&nbsp;ISO Auto, ISO 100\/200\/400\/800\/1600\/3200<\/li><li><strong>M\u00c9TODO AF<\/strong>&nbsp;AF \u00fanico, AF m\u00faltiple (TTL de 25 puntos), detecci\u00f3n de rostros<\/li><li><strong>M\u00c9TODO DE MEDICI\u00d3N DE LA EXPOSICI\u00d3N<\/strong>&nbsp;Inteligencia artificial AE (AiAE), promedio ponderado al centro, punto (fijo al centro del encuadre), AE facial<\/li><li><strong>M\u00c9TODO DE CONTROL DE EXPOSICI\u00d3N<\/strong>&nbsp;Programa AE (Bloqueo AE disponible)<\/li><li><strong>COMPENSACI\u00d3N DE EXPOSICI\u00d3N<\/strong>&nbsp;+\/- 3EV en incrementos de 1\/3 de paso<\/li><li><strong>VELOCIDAD DE OBTURACI\u00d3N<\/strong>&nbsp;1\/2000 - 4 Segundos (Manual: 30 Segundos)<\/li><li><strong>MODO R\u00c1FAGA<\/strong>&nbsp;Aprox. 6 fps (resoluci\u00f3n completa)<\/li><li><strong>MODOS DE REPRODUCCI\u00d3N<\/strong>&nbsp;Foto \u00fanica, \u00cdndice (9\/16 miniaturas), Presentaci\u00f3n de diapositivas, Fecha, Disparos en r\u00e1faga, Zoom (Aprox. x2 - x8)<\/li><li><strong>CONTROL DE BALANCE DE BLANCOS<\/strong>&nbsp;Autom\u00e1tico (AWB), Luz del d\u00eda, Nublado, Fluorescente, Fluorescente CWF, Incandescente, Manual, Bajo el agua, Configuraci\u00f3n de temperatura de color (1900K - 10000K)<\/li><li><strong>FLASH<\/strong>&nbsp;M\u00e9todo de flash Modos de flash internos Autom\u00e1tico, Reducci\u00f3n de ojos rojos, Flash de relleno, Sincronizaci\u00f3n lenta, Reducci\u00f3n de ojos rojos + Sincronizaci\u00f3n lenta, Forzar desconexi\u00f3n Rango de disparo (amplio) Aprox. 0,3 m - 5,2 m (ISO800); (Teleobjetivo) Aprox. 1,0 m - 2,4 m (ISO800) Tiempo de reciclaje 6 segundos o menos<\/li><li><strong>MEDIOS DE GRABACI\u00d3N<\/strong>&nbsp;Memoria interna: Aprox. Tarjeta micro SD\/micro SDHC de 8 MB (hasta 32 GB compatible\/clase 4 o superior) [Tarjeta MMC no compatible]<\/li><li><strong>OTRAS CARACTER\u00cdSTICAS<\/strong>&nbsp;Wi-Fi (802.11 b\/g\/n), control remoto (a trav\u00e9s del dispositivo iOS&#8482;\/ANDROID&#8482;), compatibilidad con varios idiomas (26 idiomas)<\/li><li><strong>TOMAS<\/strong>&nbsp;USB 2.0 (Micro USB de 5 pines)<\/li><li><strong>ALIMENTACI\u00d3N<\/strong>&nbsp;Bater\u00eda recargable de iones de litio (LB-015), 3,7 V 700 mAh, carga en la c\u00e1mara<\/li><li><strong>CAPACIDADES DE DISPARO<\/strong>&nbsp;Aprox. 2000 disparos (basado en los est\u00e1ndares CIPA), aprox. 1 hora y 10 minutos para video (@1080p\/30fps) (Rendimiento de la bater\u00eda)<\/li><li><strong>ENTORNO DE FUNCIONAMIENTO<\/strong>&#8203;&#8203;&#8203;&#8203;&#8203;&#8203;&#8203; Temperatura: 14\u00b0 - 104\u00b0F \/ -10\u00b0 - 40\u00b0C, Humedad: 0 - 90%<\/li><li><strong>DIMENSIONES<\/strong>&nbsp;(An. x Al. x Pr.) Aprox. 103,2 \u00d7 66,7 \u00d7 52,4 mm \/ 4,06 x 2,62 x 2,06 pulgadas (basado en los est\u00e1ndares CIPA)<\/li><li>Peso aproximado. 6.21 onzas \/ 176 g (solo cuerpo)<\/li><li><strong>ACCESORIOS SUMINISTRADOS<\/strong>&nbsp;Bater\u00eda recargable de iones de litio, correa para la mu\u00f1eca, gu\u00eda de inicio r\u00e1pido, cable USB, adaptador de CA, tarjeta de garant\u00eda y tarjeta de servicio<\/li><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_kod-camara%20pixpro%20wpz2%20yee_1.jpg","wholesale_price":"129.92","unit_price_tax":134.92},"product_model":{"product_data":{"ean13":["0819900013948"],"reference":"WPZ2Y","name":{"1":"C\u00e1mara Digital Deportiva Kodak Pixpro WPZ2\/ 16MP\/ Zoom \u00d3ptico 4x\/ Amarilla","2":"","3":"","4":""},"description":{"1":"<p><h2>C\u00e1mara resistente<\/h2><p>La c\u00e1mara digital KODAK PIXPRO WPZ2 es la compa\u00f1era perfecta para mojarse. A prueba de golpes, a prueba de polvo y listo para la aventura, el WPZ2 fue dise\u00f1ado para llevarlo en movimiento y usarse dentro, sobre y debajo del agua, hasta 15 m. Con una gran cantidad de modos de escena para ayudarlo a capturar la mejor toma, as\u00ed como video HD, el WPZ2 no perder\u00e1 el ritmo.<\/p><ul><li>Zoom \u00f3ptico 4x<\/li><li>Sensor CMOS BSI de 16MP<\/li><li>V\u00eddeo de alta definici\u00f3n de 1080p<\/li><li>Estabilizaci\u00f3n de imagen digital<\/li><li>15 m resistente al agua<\/li><li>2m a prueba de golpes<\/li><li>Pantalla LCD de 2,7' y 230K<\/li><li>Bater\u00eda recargable de iones de litio<\/li><\/ul><h2>ZOOM \u00d3PTICO 4X<\/h2><p>El WPZ2 es lo suficientemente resistente como para llevarlo a donde est\u00e1 la acci\u00f3n, pero a veces necesita una toma que est\u00e9 justo en el centro de todo. Con el zoom \u00f3ptico 4X, puede obtener un primer plano sin terminar en la zona de impacto.<\/p><h2>IMPERMEABLE 15M<\/h2><p>\u00bfA veces te sientes m\u00e1s c\u00f3modo en el agua que en tierra? Lo mismo ocurre con esta c\u00e1mara. Es f\u00e1cil de agarrar, simple de disparar y herm\u00e9tico. Nunca tendr\u00e1s que preocuparte por recibir la inyecci\u00f3n.<\/p><h2>2M A PRUEBA DE CHOQUE<\/h2><p>Las actividades rigurosas requieren accesorios resistentes. Si su equipo necesita poder recibir una paliza, est\u00e1 de suerte con el WPZ2. Con una clasificaci\u00f3n a prueba de golpes de hasta 2 metros (6,56 pies), los golpes y contusiones de los dispositivos no son un problema.<\/p><h2>A PRUEBA DE POLVO<\/h2><p>Los mejores lugares de vacaciones y aventuras consisten en algo m\u00e1s que agua. Tambi\u00e9n hay mucha sal, arena y gravilla que pueden llegar a todas partes. En todas partes excepto en el interior del WPZ2, eso es.<\/p><h2>CMOS BSI de 16MP<\/h2><p>Los 16 megap\u00edxeles le permiten capturar una claridad realista en im\u00e1genes bien definidas y detalladas, sin perder calidad a medida que las modifica m\u00e1s adelante. \u00a1Recorta, ampl\u00eda y libera al fot\u00f3grafo que llevas dentro!<\/p><h2>V\u00cdDEO DE ALTA DEFINICI\u00d3N DE 1080p<\/h2><p>Te gusta estar donde est\u00e1 la acci\u00f3n. Su resistente WPZ2 no solo puede hacer el viaje con usted, sino tambi\u00e9n capturar sus aventuras en video de alta definici\u00f3n para ayudarlo a contar mejor su historia.<\/p><h2>F\u00c1CIL CONECTIVIDAD Wi-Fi\u00ae<\/h2><p>\u00a1Que nadie se pierda la acci\u00f3n! La c\u00e1mara resistente KODAK PIXPRO WPZ2 se puede conectar f\u00e1cilmente de forma inal\u00e1mbrica a su dispositivo inteligente para que pueda cargar y compartir sus mejores fotograf\u00edas con amigos, familiares y el mundo mientras viaja. Ahora que hace la vida m\u00e1s f\u00e1cil, \u00bfno?<\/p><h2>EMPEZANDO<\/h2><p>\u00a1Mira nuestro video de desempaquetado! Adem\u00e1s de la c\u00e1mara digital KODAK PIXPRO WPZ2, tambi\u00e9n recibe: una bater\u00eda recargable de iones de litio, un cable USB, un adaptador de CA, una mu\u00f1equera, una gu\u00eda de inicio r\u00e1pido, una tarjeta de garant\u00eda y una tarjeta de servicio.<\/p><h2>\u00a1COMPARTE EN LA COMUNIDAD!<\/h2><p>Sea parte de nuestra familia de fot\u00f3grafos dedicados desde hace mucho tiempo. La comunidad de c\u00e1maras KODAK PIXPRO es para los entusiastas de las im\u00e1genes que desean aprender, experimentar y compartir.<\/p><h2>Especificaciones<\/h2><ul><li><strong>SENSOR DE IMAGEN EFECTIVA P\u00cdXELES<\/strong>&nbsp;16,35 Megap\u00edxeles<\/li><li><strong>P\u00cdXELES TOTALES DEL SENSOR DE IMAGEN<\/strong>&nbsp;16,76 megap\u00edxeles [1\/2,3' BSI CMOS]<\/li><li><strong>LENTE<\/strong>&nbsp;Distancia focal 4,9 mm (Gran angular) - 19,6 mm (Teleobjetivo) [equivalente en pel\u00edcula de 35 mm] [27 mm (Gran angular) - 108 mm (Teleobjetivo)] N\u00famero F F3,0 (Gran angular) - F6,6 (Teleobjetivo) Construcci\u00f3n del objetivo 7 grupos 7 elementos Zoom \u00f3ptico 4x Rango de enfoque Normal: (Gran angular) 60 cm - &#8734; (Teleobjetivo) 100 cm - &#8734;<\/li><li>Macro: 5 cm - &#8734; (solo ancho)<\/li><li><strong>SISTEMA DE ENFOQUE AUTOM\u00c1TICO TTL<\/strong>&nbsp;Autoenfoque<\/li><li>Estabilizaci\u00f3n de imagen digital ANTI-HANDSHAKE<\/li><li><strong>ZOOM DIGITAL<\/strong>&nbsp;Zoom digital 6x (zoom combinado: 24x)<\/li><li><strong>N\u00daMERO DE P\u00cdXELES DE GRABACI\u00d3N<\/strong>&nbsp;Imagen fija (4:3) 16 MP: 4608 x 3456, 10 MP: 3648 x 2736, 5 MP: 2592 x 1944, 3 MP: 2048 x 1536, 0,3 MP: 640 x 480, (3:2) 14 MP: 4608 x 3072, (16:9: 4608, 222 MP) 2MP: 1920x1080 Pel\u00edcula 1920x1080 (30fps), 1280x720 (60fps\/30fps), 640x480 (30f