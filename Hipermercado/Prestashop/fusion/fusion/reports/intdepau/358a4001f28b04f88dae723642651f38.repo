ecado. Dise\u00f1o ligero y ergon\u00f3mico para facilitar el peinado. Funci\u00f3n i\u00f3nica que realza el brillo y acaba con el encrespamiento. 3 niveles de temperatura y 2 flujos de aire.<br><div><br><\/div><br><h2>Especificaciones<\/h2><ul>\t<li>Peso y dimensiones<\/li>\t<li>Peso: 762 g<\/li>\t<li>Control de energ\u00eda<\/li>\t<li>Potencia: 2500 W<\/li>\t<li>Boquilla concentradora<\/li>\t<li>Color del producto: Blanco<\/li>\t<li>Para colgar<\/li>\t<li>Tipo de colgador: Con agujero en la empu\u00f1adura para colgar<\/li>\t<li>Longitud del cable: 1,8 m<\/li>\t<li>Desempe\u00f1o<\/li>\t<li>Funci\u00f3n de disparo fr\u00edo<\/li>\t<li>Funci\u00f3n i\u00f3nica<\/li>\t<li>N\u00famero de velocidades: 2<\/li>\t<li>Ajuste de calefacci\u00f3n: 3<\/li><\/ul><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BRAUN","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":38.56,"unit_price_tax":38.56,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Secadores","quantity":0,"brand":"BRAUN","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-pae-sec%20brhd585e_1.jpg"],"wholesale_price":33.56}}},"3030050182231":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3030050182231",false],"wholesale_price":[58.32,false],"price":[63.32,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:159382","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old im