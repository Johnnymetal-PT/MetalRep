ca\/ Control del volumen...<\/li><li>Configuraci\u00f3n: Espa\u00f1ol (\u00d1)<\/li><li>Material: Policarbonato<\/li><li>Tratamiento: Anti-desgaste<\/li><li>Compatibilidad: Win95 hasta Win10 \/ Mac<\/li><li>Dimensiones: 458 x 148 x 20mm<\/li><li><b>Rat\u00f3n<\/b><\/li><li>Tipo: \u00d3ptico<\/li><li>Conectividad: USB2.0<\/li><li>Resoluci\u00f3n: 1000dpi<\/li><li>N\u00ba de botones: 3 botones<\/li><li>Longitud de cable: 150cm<\/li><li>Material: Pl\u00e1stico textura goma<\/li><li>Dimensiones: 113 x 67 x 38mm<\/li><li><b>Auriculares<\/b><\/li><li>Micr\u00f3fono: Incorporado<\/li><li>Longitud cable: 2 metros<\/li><li>Conectividad: 2x Jack 3.5<\/li><li>Material: Pl\u00e1stico + Poliuretano<\/li><li>Dimensiones: 200 x 175 x 82mm<\/li><\/ul><p><\/p><br><p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"3GO","supplier":null,"width":null,"height":null,"depth":null,"weight":1.16,"unit_price":17.9,"unit_price_tax":17.9,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Kits Completos","quantity":0,"brand":"3GO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_3go-pack%20combodrileh2_1.jpg"],"wholesale_price":12.9}}},"8806094979688":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806094979688",false],"wholesale_price":[760.99,false],"price":[765.99,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Samsung Galaxy Book 3 Laptop Intel Core i7-1355U\/ 16GB\/ 512GB SSD\/ 15,6&#39;\/ Win11 Pro"