1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LENOVO","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":172.71,"unit_price_tax":172.71,"tax_rules_group":null,"category":"Tablets","sub_category":"Tablets","quantity":0,"brand":"LENOVO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_len-tab%20m11%204-128%20gy%20p_1.jpg"],"wholesale_price":167.71}}},"8806095361581":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806095361581",false],"wholesale_price":[129.79,false],"price":[134.79,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Tablet Samsung Galaxy Tab A9 8.7&#39;\/ 4GB\/ 64GB\/ Octacore\/ Prateado"],"result":false},"feed_data":{"name_pt":"Tablet Samsung Galaxy Tab A9 8.7'\/ 4GB\/ 64GB\/ Octacore\/ Plata","category":"Tablets","sub_category":"Tablets","unit_price":134.79,"reference":"SM-X110NZSAEUB","ean13":"8806095361581","weight":"0.48","quantity":2,"brand":"SAMSUNG","description_pt":"<p><h2>Cl\u00e1sica y contempor\u00e1nea<\/h2><p>Elegante y con un toque muy especial, Galaxy Tab A9 | Tab A9+ presentan un dise\u00f1o estilizado con un cuerpo en metal, \u00a1y est\u00e1n disponibles en muchos colores que resaltan su encanto!<\/p><h2>Im\u00e1genes m\u00e1s brillantes y movimientos m\u00e1s fluidos<\/h2><p>\u00bfBuscas entretenimiento? \u00a1Esta es tu tablet! Su tasa de refresco te permite meterte de lleno en todos los efectos visuales que est\u00e1n a tu alcance para que puedas apreciarlos gracias a movimientos suaves y fluidos. Incluso a plena luz del d\u00eda, cuando est\u00e1s al sol.<\/p><h2>Guarda todo lo que te gusta<\/h2><p>Galaxy Tab A9 | Tab A9+ cuentan con hasta 8 GB de memoria RAM, lo que asegura menos lag para que puedas seguir haciendo varias tareas a la vez. Adem\u00e1s, gracias a sus 128 GB de memoria interna puedes guardar todos tus v\u00eddeos, fotos y archivos de alta resoluci\u00f3n sin problemas. Y si lo prefieres, puedes usar una tarjeta microSD de hasta 1 TB para ampliar la memoria. \u00a1Deja de borrar!<\/p><h2>Divide la pantalla en tres y multiplica tu productividad<\/h2><p>\u00a1Haz varias tareas a la vez! Con Galaxy Tab A9+ puedes hacer bocetos de planos de arquitectura, elegir diferentes efectos visuales, hacer videollamadas... Y algo mucho mejor: usar tres aplicaciones en una sola pantalla sin necesidad de cerrar ninguna ventana.<\/p><h2>Un sonido con m\u00e1s matices<\/h2><p>Sum\u00e9rgete en un rico paisaje sonoro con altavoces que proporcionan una experiencia de audio envolvente. Ya sea que est\u00e9s disfrutando de una pel\u00edcula o de la m\u00fasica, Galaxy Tab A9+ te permite disfrutar completamente del sonido 3D con una claridad y profundidad asombrosas.<\/p><h2>Todos tus datos a buen recaudo<\/h2><p>Almacena tu informaci\u00f3n en la Carpeta Segura y controla el estado de seguridad de tu dispositivo en el Panel de privacidad, \u00a1todo estar\u00e1 protegido para que puedas sacar el m\u00e1ximo partido a tu Galaxy sin preocuparte por nada!<\/p><p><br><\/p><h2>Especificaciones<\/h2><ul><li><strong>Tama\u00f1o<\/strong><\/li><li>8.7' (220.5mm)<\/li><li><strong>C\u00e1mara principal - Resoluci\u00f3n<\/strong><\/li><li>8.0 MP<\/li><li><strong>Peso (g)<\/strong><\/li><li>332<\/li><li><strong>Velocidad CPU<\/strong><\/li><li>2.2GHz, 2GHz<\/li><li><strong>Procesador<\/strong><\/li><li>Velocidad CPU<\/li><li>2.2GHz, 2GHz<\/li><li>Tipo CPU<\/li><li>Octa-Core<\/li><li><strong>Pantalla<\/strong><\/li><li>Tama\u00f1o<\/li><li>8.7' (220.5mm)<\/li><li>Resoluci\u00f3n<\/li><li>1340 x 800 (WXGA+)<\/li><li>Tecnolog\u00eda<\/li><li>TFT<\/li><li>N\u00famero de colores<\/li><li>16M<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara principal - Resoluci\u00f3n<\/li><li>8.0 MP<\/li><li>C\u00e1mara principal - Autofocus<\/li><li>S\u00ed<\/li><li>C\u00e1mara frontal - Resoluci\u00f3n<\/li><li>2.0 MP<\/li><li>C\u00e1mara principal - Flash<\/li><li>No<\/li><li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li><li>FHD (1920 x 1080)@30fps<\/li><li><strong>Almacenamiento\/Memoria<\/strong><\/li><li>Memoria_(GB)<\/li><li>4<\/li><li><strong>Almacenamiento (GB)<\/strong><\/li><li>64<\/li><li>Almacenamiento disponible (GB)<\/li><li>45.0<\/li><li>Soporte de almacenamiento externo<\/li><li>MicroSD (hasta 1TB)<\/li><li><strong>Conectividad<\/strong><\/li><li>Versi\u00f3n USB<\/li><li>USB 2.0<\/li><li><strong>Localizaci\u00f3n<\/strong><\/li><li>GPS, Glonass, Beidou, Galileo, QZSS<\/li><li>Auriculares<\/li><li>3.5mm Stereo<\/li><li>MHL<\/li><li>No<\/li><li><strong>Wi-Fi<\/strong><\/li><li>802.11 a\/b\/g\/n\/ac 2.4G+5GHz, VHT80<\/li><li>Wi-Fi Direct<\/li><li>S\u00ed<\/li><li>Versi\u00f3n Bluetooth<\/li><li>Bluetooth v5.3<\/li><li>NFC<\/li><li>No<\/li><li>Perfiles Bluetooth<\/li><li>A2DP, AVRCP, DI, HID, HOGP, OPP, PAN<\/li><li>PC Sync.<\/li><li>Smart Switch (PC version)<\/li><li><strong>Sistema Operativo<\/strong><\/li><li>Android<\/li><li><strong>Informaci\u00f3n general<\/strong><\/li><li>Formato<\/li><li>Tablet<\/li><li><strong>Sensores<\/strong><\/li><li>Aceler\u00f3metro, Geomagn\u00e9tico, Luminosidad, Sensor de Proximidad<\/li><li><strong>Especificaciones f\u00edsicas<\/strong><\/li><li>Dimensiones (AlxAnxProf, mm)<\/li><li>211.0 x 124.7 x 8.0<\/li><li>Peso (g)<\/li><li>332<\/li><li><strong>Bater\u00eda<\/strong><\/li><li>Capacidad de bater\u00eda (mAh, t\u00edpico)<\/li><li>5100<\/li><li>Extra\u00edble<\/li><li>No<\/li><li><strong>Audio y V\u00eddeo<\/strong><\/li><li>Formatos de reproducci\u00f3n de V\u00eddeo<\/li><li>MP4, M4V, 3GP, 3G2, AVI, FLV, MKV, WEBM<\/li><li><strong>Resoluci\u00f3n de reproducci\u00f3n de V\u00