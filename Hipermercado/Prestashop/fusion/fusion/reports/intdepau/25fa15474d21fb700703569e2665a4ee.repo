s":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-aur%20tat1138wt_1.jpg"],"wholesale_price":15.56}}},"8435568405073":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435568405073",false],"wholesale_price":[50.9,false],"price":[55.9,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 4.6",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:163764","Cat. IDs: 36","Associated Categories","Cat. Default: 36","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8943229308f559a18e1d92c755f2fcb3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Radiador Orbegozo RMN 1500\/ 3 Potencias\/ 500-1000-1500W","category":"Calefaccion y Clima","sub_category":"Radiadores","unit_price":55.9,"reference":"18008","ean13":"8435568405073","weight":"4.6","quantity":5,"brand":"ORBEGOZO","description_pt":"                                                <p><h2>RADIADOR DE MICA RMN 1500<\/h2><div><p>El radiador de mica RMN 1500 de Orbegozo, est\u00e1 pensado para quienes deciden tener un dispositivo atractivo para su hogar adem\u00e1s de poderoso en cuanto a prestaciones y rendimiento. Tiene una potencia m\u00e1xima de 1500 W y cuenta con una r\u00e1pida convecci\u00f3n y difusi\u00f3n del calor lo que permite calentar estancias un corto periodo de tiempo.<\/p><p>Esta gama de radiadores obtiene su m\u00e1ximo rendimiento en un minuto y puede controlarse f\u00e1cilmente gracias a sus tres potencias de calor (500, 1000 y 1500W) y su termostato de temperatura ambiente. Ademas, gracias a las cuatro ruedas pivotantes multidireccionales, puedes mover tu radiador por casa sin apenas esfuerzo. Incluye un c\u00f3modo recogecables para recoger el aparato de forma sencilla.<\/p><p>En Orbegozo nos preocupamos por tu bienestar, por eso nuestros radiadores est\u00e1n dise\u00f1ados para funcionar de un modo silencioso, para que tu descanso nunca se vea afectado por ruidos indeseables. Igualmente, tu seguridad es primordial para nosotros: todos nuestros radiadores cuentan con un sistema de protecci\u00f3n contra sobrecalentamiento que desconecta el aparato autom\u00e1ticamente en caso de que su temperatura se exceda por encima de lo habitual.<\/p><p>Adem\u00e1s, el radiador de mica RMN 1500 cuenta con un sistema de protecci\u00f3n antivuelco que apaga el aparato autom\u00e1ticamente en caso de vuelco del mismo. El radiador de mica RMN 1500 de Orbegozo est\u00e1 dise\u00f1ado para alcanzar un grado de rendimiento \u00f3ptimo en muy poco tiempo con las ventajas de un funcionamiento eficiente.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li>Potencia: 1500 W.<\/li><li>3 potencias de calor: 500 &#8211; 1000 &#8211; 1500 W.<\/li><li>R\u00e1pida convecci\u00f3n y difusi\u00f3n del calor.<\/li><li>M\u00e1ximo rendimiento en 1 minuto.<\/li><li>No consume ox\u00edgeno.<\/li><li>Sistema de protecci\u00f3n contra sobrecalentamiento.<\/li><li>Sistema de protecci\u00f3n antivuelco.<\/li><li>Termostato de temperatura ambiente regulable.<\/li><li>Asa para transporte en la parte trasera.<\/li><li>Incorpora recogecables.<\/li><li>Piloto luminoso LED.<\/li><li>Sin fluido.<\/li><li>Ruedas pivotantes.<\/li><li>Conexi\u00f3n: 230 V ~ 50 Hz.<\/li><\/ul><\/p><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_orb-pae-rad%20rmn%201500_1.jpg","wholesale_price":"50.90","unit_price_tax":55.9},"product_model":{"product_data":{"ean13":["8435568405073"],"reference":"18008","name":{"1":"Radiador Orbegozo RMN 1500\/ 3 Potencias\/ 500-1000-1500W","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>RADIADOR DE MICA RMN 1500<\/h2><div><p>El radiador de mica RMN 1500 de Orbegozo, est\u00e1 pensado para quienes deciden tener un dispositivo atractivo para su hogar adem\u00e1s de poderoso en cuanto a prestaciones y rendimiento. Tiene una potencia m\u00e1xima de 1500 W y cuenta con una r\u00e1pida convecci\u00f3n y difusi\u00f3n del calor lo que permite calentar estancias un corto periodo de tiempo.<\/p><p>Esta gama de radiadores obtiene su m\u00e1ximo rendimiento en un minuto y puede controlarse f\u00e1cilmente gracias a sus tres potencias de calor (500, 1000 y 1500W) y su termostato de temperatura ambiente. Ademas, gracias a las cuatro ruedas pivotantes multidireccionales, puedes mover tu radiador por casa sin apenas esfuerzo. Incluye un c\u00f3modo recogecables para recoger el aparato de forma sencilla.<\/p><p>En Orbegozo nos preocupamos por tu bienestar, por eso nuestros radiadores est\u00e1n dise\u00f1ados para funcionar de un modo silencioso, para que tu descanso nunca se vea afectado por ruidos indeseables. Igualmente, tu seguridad es primordial para nosotros: todos nuestros radiadores cuentan con un sistema de protecci\u00f3n contra sobrecalentamiento que desconecta el aparato autom\u00e1ticamente en caso de que su temperatura se exceda por encima de lo habitual.<\/p><p>Adem\u00e1s, el radiador de mica RMN 1500 cuenta con un sistema de protecci\u00f3n antivuelco que apaga el aparato autom\u00e1ticamente en caso de vuelco del mismo. El radiador de mica RMN 1500 de Orbegozo est\u00e1 dise\u00f1ado para alcanzar un grado de rendimiento \u00f3ptimo en muy poco tiempo con las ventajas de un funcionamiento eficiente.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li>Potencia: 1500 W.<\/li><li>3 potencias de calor: 500 &#8211; 1000 &#8211; 1500 W.<\/li><li>R\u00e1pida convecci\u00f3n y difusi\u00f3n del calor.<\/li><li>M\u00e1ximo rendimiento en 1 minuto.<\/li><li>No consume ox\u00edgeno.<\/li><li>Sistema de protecci\u00f3n contra sobrecalentamiento.<\/li><li>Sistema de protecci\u00f3n antivuelco.<\/li><li>Termostato de temperatura ambiente regulable.<\/li><li>Asa para transporte en la parte trasera.<\/li><li>Incorpora recogecables.<\/li><li>Piloto luminoso LED.<\/li><li>Sin fluido.<\/li><li>Ruedas pivotantes.<\/li><li>Conexi\u00f3n: 230 V ~ 50 Hz.<\/li><\/ul><\/p><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ORBEGOZO","supplier":null,"width":null,"height":null,"depth":null,"weight":4.6,"unit_price":55.9,"unit_price_tax":55.9,"tax_rules_group":null,"category":"Calefaccion y Clima","sub_category":"Radiadores","quantity":5,"brand":"ORBEGOZO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_orb-pae-rad%20rmn%201500_1.jpg"],"wholesale_price":50.9}}},"8435568405080":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435568405080",false],"wholesale_price":[53.21,false],"price":[58.21,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 5.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:163765","Cat. IDs: 36","Associated Categories","Cat. Default: 36","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d4908376bb92c07cb5339d4e22b31f8c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Radiador Orbegozo RMN 2000\/ 2 Potencias\/ 1000-2000W","category":"Calefaccion y Clima","sub_category":"Radiadores","unit_price":58.21,"reference":"18009","ean13":"8435568405080","weight":"5.1","quantity":5,"brand":"ORBEGOZO","description_pt":"          