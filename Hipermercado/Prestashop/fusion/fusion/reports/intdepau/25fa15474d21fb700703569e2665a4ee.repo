n alto rendimiento constante gracias al flujo de aire y los sellos entre piezas mejorados. Esto significa que el dep\u00f3sito de polvo y el filtro requieren una limpieza menos frecuente.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li><b>General<\/b><\/li><li>Modelo<\/li><li>2 en 1<\/li><li>Color<\/li><li>Azul<\/li><li>Dimensiones (AltoxAnchoxFondo)<\/li><li>1150 x 265 x 180 mm<\/li><li>Peso neto<\/li><li>3,3 kg<\/li><li><b>Rendimiento<\/b><\/li><li>2en1: Aspirador escoba y de mano en un solo dispositivo<\/li><li>Si<\/li><li>Niveles de aspiraci\u00f3n<\/li><li>2<\/li><li>Autonom\u00eda (max)<\/li><li>55 min<\/li><li>Tipo de bater\u00eda<\/li><li>Litio<\/li><li>Tiempo de carga<\/li><li>5 h<\/li><li>Nominal voltage battery pack<\/li><li>25,2 V<\/li><li>Potencia de la bateria<\/li><li>2,00 Ah<\/li><li>Nivel de ruido<\/li><li>82 dB(A) re 1 pW<\/li><li>Sistema de filtrado<\/li><li>Sin bolsa<\/li><li><span style='background-color: initial;'>Contenedor 0,4 l<\/span><br><\/li><li>Cepillo para alfombra, moqueta<\/li><li>El\u00e9ctrico<\/li><\/ul><\/p><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BOSCH","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":166.61,"unit_price_tax":166.61,"tax_rules_group":null,"category":"Limpieza de Hogar","sub_category":"Aspiradores","quantity":0,"brand":"BOSCH","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bosch-pae-asp%20s4%20flexxo%20gen2_1.jpg"],"wholesale_price":161.61}}},"8435092433474":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435092433474",false],"wholesale_price":[19.24,false],"price":[24.24,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Pro