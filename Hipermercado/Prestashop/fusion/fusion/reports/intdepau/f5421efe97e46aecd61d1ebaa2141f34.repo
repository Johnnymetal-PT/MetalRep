/fixed\/art_phpae-afe%20bg3015_1.jpg"],"wholesale_price":26.86}}},"3121040085806":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3121040085806",false],"wholesale_price":[46.33,false],"price":[51.33,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:95001","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d7552a2efca05f931855e07acc3c65d3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Plancha para el Pelo Rowenta SF466LF0 K\/ PRO STYLIST\/ Negra","category":"Cuidado Personal","sub_category":"Planchas de pelo","unit_price":51.33,"reference":"SF466LF0","ean13":"3121040085806","weight":"0","quantity":0,"brand":"ROWENTA","description_pt":"<p><\/p><h2>K\/ PRO STYLIST<\/h2><h2>Moldeado profesional con un 41 %* m\u00e1s de brillo<\/h2><p><\/p><ul>\t<li>Plancha de pelo profesional: esta plancha de pelo tiene un cepillo integrado para garantizar un rendimiento excepcional y unos resultados suaves y luminosos<\/li>\t<li>Brillo radiante: la tecnolog\u00eda i\u00f3nica junto con nuestro exclusivo revestimiento Keratin &amp; Glow, que combina la pro keratina con la turmalina, proporcionan un cabello suave con un 41 %* m\u00e1s de brillo<\/li>\t<li>R\u00e1pida y eficiente: esta herramienta de moldeado se adapta a todo tipo de cabellos y ofrece un rendimiento eficaz en una sola pasada, para sesiones de moldeado m\u00e1s r\u00e1pidas y sencillas<\/li>\t<li>Estilos 2 en 1: el sistema Liss &amp; Curl pone a tu alcance una gran variedad de looks, puedes alisar tu cabello o darle unos rizos con volumen en un abrir y cerrar de ojos<\/li>\t<li>Control de la temperatura: 8 ajustes de temperatura (de 140\u00ba a 210 \u00baC) con un ajuste de cuidado del cabello de 170 \u00baC, que asegura un cabello cuidado y protegido, y un modo boost a 210 \u00baC para acabados r\u00e1pidos<\/li>\t<li>Eficacia en una sola pasada: el sistema de placas flotantes ajusta la presi\u00f3n de las placas seg\u00fan el grosor de cada mech\u00f3n de pelo, garantizando eficacia en una sola pasada<\/li>\t<li>F\u00e1cil de usar: la pantalla LCD te permite una sesi\u00f3n de moldeado sin esfuerzo, con un dise\u00f1o pr\u00e1ctico e intuitivo para ajustar la temperatura deseada con total facilidad<\/li>\t<li>Dise\u00f1o elegante: plancha de pelo de dise\u00f1o vanguardista con acabados sofisticados y modernos inspirados en el dise\u00f1ador Karl Lagerfeld, adem\u00e1s de incluir un neceser resistente a la temperatura<\/li><\/ul><p><\/p><h2>La plancha de pelo que ofrece resultados con un 41 % m\u00e1s de brillo<\/h2><p>Con un cepillo integrado y nuestro exclusivo revestimiento Keratin &amp; Glow, la plancha de pelo K\/Pro Stylist de Rowenta x Karl Lagerfeld permite conseguir una gran variedad de estilos con resultados de peluquer\u00eda. Consigue el look deseado en una sola pasada gracias al sistema de placas flotantes, y l\u00edbrate del encrespamiento con la combinaci\u00f3n de nuestra tecnolog\u00eda i\u00f3nica con el revestimiento Keratin &amp; Glow. Todo esto en una herramienta de moldeado intuitiva y f\u00e1cil de usar gracias a la pantalla LCD y a los pr\u00e1cticos ajustes de temperatura, para conseguir un alisado o rizado profesional de la forma m\u00e1s sencilla.&nbsp; &nbsp;*% promedio, prueba en laboratorio independiente en comparaci\u00f3n con el cabello natural, Francia 2021<\/p><p><br><\/p><p><\/p><h2>Caracter\u00edsticas<\/h2><p><\/p><ul><li><b style='background-color: initial;'>RESULTADO\/USO<\/b><\/li><li><span style='background-color: initial;'>Recubrimiento de placas<\/span><\/li><li><span style='background-color: initial;'>Cer\u00e1mico<\/span><\/li><li><b style='background-color: initial;'>Funciones<\/b><\/li><li><span style='background-color: initial;'>Totalmente liso, rizos y ondas<\/span><\/li><li><span style='background-color: initial;'>Placas flotantes<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><span style='background-color: initial;'>Estado del pelo<\/span><\/li><li><span style='background-color: initial;'>Seco<\/span><\/li><li><b style='background-color: initial;'>RESPETO DEL CABELLO Y ERGONOM\u00cdA<\/b><\/li><li><span style='background-color: initial;'>Generador de iones<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><span style='background-color: initial;'>Punta fr\u00eda<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b style='background-color: initial;'>ERGONOM\u00cdA\/COMODIDAD DE USO<\/b><\/li><li><span style='background-color: initial;'>Asa para colgar<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><span style='background-color: initial;'>Neceser<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b style='background-color: initial;'>ESPECIFICACIONES T\u00c9CNICAS<\/b><\/li><li><span style='background-color: initial;'>Voltaje<\/span><\/li><li><span style='background-color: initial;'>110-240<\/span><\/li><li><b style='background-color: initial;'>TIPO DE PEINADO<\/b><\/li><li><span style='background-color: initial;'>Alisado<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><span style='background-color: initial;'>Rizado<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><b>RESULTADOS DE PEINADOS :<\/b><\/li><li>&nbsp;Alisado, Rizos y ondas<\/li><\/ul><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_row-pae-plp%20sf466lf0_1.jpg","wholesale_price":"46.33","unit_price_tax":51.33},"product_model":{"produc