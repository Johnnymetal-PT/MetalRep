namiento.<\/li>  <li>Bandeja recogemigas amplia y de f\u00e1cil extracci\u00f3n.<\/li>  <li>Hueco recogecables y base antideslizante.<\/li><\/ul><div><br><\/div><ul><li><b>Especificaciones<\/b><\/li><li>Marca Cecotec<\/li><li>Modelo Turbo EasyToast Inox<\/li><li>Descripci\u00f3n Tostador plano horizontal<\/li><li>Voltaje 220-240 V\/50-60 Hz<\/li><li>Medidas 21 x 35,5 x 6,5 cm<\/li><li>Peso 1,30 kg<\/li><li>Potencia 900 W<\/li><li><b>CONTENIDO<\/b><\/li><li>Tostador.<\/li><li>Manual de instrucciones.<\/li><\/ul><p><\/p><div><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CECOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":1.58,"unit_price":23.36,"unit_price_tax":23.36,"tax_rules_group":null,"category":"Cocina","sub_category":"Tostadores","quantity":5,"brand":"CECOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-tos%20t%20etoast%20in%20gry_1.jpg"],"wholesale_price":18.36}}},"8435484032100":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8435484032100",false],"wholesale_price":[32.84,false],"price":[37.84,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Cecotec Toast&amp;Taste 800 Vintage Light Torradeira\/ 850 W\/ Amarelo Claro"],"result":false},"feed_data":{"name_pt":"Tostador Cecotec Toast&Taste 800 Vintage Light\/ 850W\/ Amarillo Claro","category":"Cocina","sub_category":"Tostadores","unit_price":37.84,"reference":"03210","ean13":"8435484032100","weight":"0","quantity":0,"brand":"CECOTEC","description_pt":"<p><h2