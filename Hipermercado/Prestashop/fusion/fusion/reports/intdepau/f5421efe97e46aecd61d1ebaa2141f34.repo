de apertura<\/li><\/ul><li>Sistema de cierre deslizante, con apertura y cierre mediante encajado de tapa y cuerpo.<\/li><li>V\u00e1lvula de funcionamiento de acero inoxidable 18\/10.<\/li><li>Cuerpo apto para lavavajillas.<\/li><\/ul><div><h2>Medidas<\/h2><p><ul><li>Capacidad: 9L<\/li><li>Di\u00e1metro superior: 24cm<\/li><li>Di\u00e1metro inferior: 19,5cm<\/li><li>Altura: 21,1cm<\/li><\/ul><\/p><br><\/div><p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BRA","supplier":null,"width":null,"height":null,"depth":null,"weight":3.6,"unit_price":61.62,"unit_price_tax":61.62,"tax_rules_group":null,"category":"Menaje de Hogar","sub_category":"Ollas Express","quantity":2,"brand":"BRA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-olla%20a185104_1.jpg"],"wholesale_price":56.62}}},"8435092408625":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435092408625",false],"wholesale_price":[41.8,false],"price":[46.8,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.45",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:95136","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/691d5cfb9843427720b182ecf5efc694.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Olla a Presi\u00f3n R\u00e1pida Monix Quick M560003\/ \u00d822cm\/ 7L\/ Acero Inoxidable","category":"Menaje de Hogar","su