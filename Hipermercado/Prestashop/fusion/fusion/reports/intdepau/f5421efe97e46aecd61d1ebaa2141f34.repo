:{"product":["",false],"ean13":["5030917236761",false],"wholesale_price":[19.42,false],"price":[24.42,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:95043","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a02ce2393f34011aefbc315a9dc11ed6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Juego para Consola Nintendo Crash Bandicoot N. Sane Trilogy","category":"Juegos y Accesorios","sub_category":"Juegos Nintendo Switch","unit_price":24.42,"reference":"CBNST","ean13":"5030917236761","weight":"0.05","quantity":0,"brand":"NINTENDO","description_pt":"                                                <p><h2>\u00a1Juega a Crash Bandicoot&#8482; donde quieras!<\/h2><p>\u00a1Vuelve Crash Bandicoot&#8482;, tu marsupial favorito! Mejorado, embelesado y listo para bailar con la colecci\u00f3n de juegos N. Sane Trilogy. Ahora puedes disfrutar de Crash Bandicoot como nunca antes. Gira, salta, rompe, enfr\u00e9ntate a los \u00e9picos desaf\u00edos y vive las aventuras de los tres juegos con los que empez\u00f3 todo: Crash Bandicoot&#8482;, Crash Bandicoot&#8482; 2: Cortex Strikes Back y Crash Bandicoot&#8482; 3: Warped. \u00a1Vuelve a vivir tus momentos favoritos de Crash con gr\u00e1ficos remasterizados y prep\u00e1rate para disfrutar a tope!<\/p><h2>Crash Bandicoot&#8482; N. Sane Trilogy - Nivel Stormy Ascent<\/h2><p>Juega al famoso nivel Stormy Ascent del juego original Crash Bandicoot. Este nivel, que no lleg\u00f3 a terminarse y nunca hab\u00eda estado disponible anteriormente, pondr\u00e1 a prueba hasta a los fans m\u00e1s curtidos de Crash. \u00bfTe atreves a enfrentarte a los escalones que se retraen r\u00e1pidamente, los ayudantes de laboratorio que arrojan recipientes, los p\u00e1jaros voladores, las plataformas m\u00f3viles y las p\u00faas de hierro?<\/p><h2><b>Crash Bandicoot&#8482; N. Sane Trilogy - Nivel Future Tense<\/b><\/h2><p>Juega al primer nivel NUEVO que se ha creado para el sistema de juego de la trilog\u00eda original en casi 20 a\u00f1os. 'Future Tense' se inspira en el nivel de demostraci\u00f3n 'Waterfall' del primer Crash Bandicoot, e incluye varios puzles del nivel original en el entorno futurista de Crash Bandicoot 3: Warped. Descubre todo un nuevo nivel de dificultad para Crash Bandicoot: La trilog\u00eda mientras esquivas cohetes, destruyes robots y saltas l\u00e1seres seg\u00fan asciendes por un inmenso rascacielos futurista.<\/p><br><\/p><div><p><\/p><p><\/p><\/div>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nin-ns-j%20cbnst_1.jpg","wholesale_price":"19.42","unit_price_tax":24.42},"product_model":{"product_data":{"ean13":["5030917236761"],"reference":"CBNST","name":{"1":"Juego para Consola Nintendo Crash Bandicoot N. Sane Trilogy","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>\u00a1Juega a Crash Bandicoot&#8482; donde quieras!<\/h2><p>\u00a1Vuelve Crash Bandicoot&#8482;, tu marsupial favorito! Mejorado, embelesado y listo para bailar con la colecci\u00f3n de juegos N. Sane Trilogy. Ahora puedes disfrutar de Crash Bandicoot como nunca antes. Gira, salta, rompe, enfr\u00e9ntate a los \u00e9picos desaf\u00edos y vive las aventuras de los tres juegos con los que empez\u00f3 todo: Crash Bandicoot&#8482;, Crash Bandicoot&#8482; 2: Cortex Strikes Back y Crash Bandicoot&#8482; 3: Warped. \u00a1Vuelve a vivir tus momentos favoritos de Crash con gr\u00e1ficos remasterizados y prep\u00e1rate para disfrutar a tope!<\/p><h2>Crash Bandicoot&#8482; N. Sane Trilogy - Nivel Stormy Ascent<\/h2><p>Juega al famoso nivel Stormy Ascent del juego original Crash Bandicoot. Este nivel, que no lleg\u00f3 a terminarse y nunca hab\u00eda estado disponible anteriormente, pondr\u00e1 a prueba hasta a los fans m\u00e1s curtidos de Crash. \u00bfTe atreves a enfrentarte a los escalones que se retraen r\u00e1pidamente, los ayudantes de laboratorio que arrojan recipientes, los p\u00e1jaros voladores, las plataformas m\u00f3viles y las p\u00faas de hierro?<\/p><h2><b>Crash Bandicoot&#8482; N. Sane Trilogy - Nivel Future Tense<\/b><\/h2><p>Juega al primer nivel NUEVO que se ha creado para el sistema de juego de la trilog\u00eda original en casi 20 a\u00f1os. 'Future Tense' se inspira en el nivel de demostraci\u00f3n 'Waterfall' del primer Crash Bandicoot, e incluye varios puzles del nivel original en el entorno futurista de Crash Bandicoot 3: Warped. Descubre todo un nuevo nivel de dificultad para Crash Bandicoot: La trilog\u00eda mientras esquivas cohetes, destruyes robots y saltas l\u00e1seres seg\u00fan asciendes por un inmenso rascacielos futurista.<\/p><br><\/p><div><p><\/p><p><\/p><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NINTENDO","supplier":null,"width":null,"height":null,"depth":null,"weight":0.05,"unit_price":24.42,"unit_price_tax":24.42,"tax_rules_group":null,"category":"Juegos y Accesorios","sub_category":"Juegos Nintendo Switch","quantity":0,"brand":"NINTENDO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nin-ns-j%20cbnst_1.jpg"],"wholesale_price":19.42}}},"5030917284601":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5030917284601",false],"wholesale_price":[18.26,false],"price":[23.26,false],"id_tax_rules_grou