%20sub%20bk%20gy_1.jpg"],"wholesale_price":45.46}}},"8720389000126":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8720389000126",false],"wholesale_price":[36.37,false],"price":[41.37,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: M\u00e1quina de Caf\u00e9 Philips L&#39;Or Barista Capsule LM8012\/ Compat\u00edvel Nespresso e L&#39;OR c\u00e1psulas\/ Ruby Red"],"result":false},"feed_data":{"name_pt":"Cafetera de C\u00e1psulas Philips L'Or Barista LM8012\/ Compatible c\u00e1psulas Nespresso y L'OR\/ Rojo Rub\u00ed","category":"Cocina","sub_category":"Cafeteras","unit_price":41.37,"reference":"LM8012\/51","ean13":"8720389000126","weight":"4.9","quantity":0,"brand":"PHILIPS","description_pt":"<p><\/p><h2>Doble espresso, doble de placer.<\/h2>La primera cafetera de c\u00e1psulas de dos cargas.<br><ul><li>Doble espresso, doble de placer.<\/li><li>Rojo Rub\u00ed<\/li><\/ul><p><br><\/p><b>Nueva y exclusiva cafetera L'OR Barista<\/b><p>La cafetera L'OR Barista est\u00e1 dise\u00f1ada para funcionar con las exclusivas c\u00e1psulas doble espresso L'OR Barista y las c\u00e1psulas individuales L'OR Espresso.<br><br><\/p><p><b>Prepara 2 caf\u00e9s a la vez o 1 caf\u00e9 doble en una taza<\/b><\/p><p><\/p><p><\/p><div>El sistema L'OR Barista te permite preparar dos tazas de espreso o un espresso doble en una taza gracias a las exclusivas c\u00e1psulas de doble espresso L'OR Barista. Disfruta de un cortado para dos o de un espresso doble solo para ti.<br><br><b>Hasta 19 bares de presi\u00f3n para un espresso perfecto<\/b><div><b><br><\/b><div>Disfruta del sabor del verdadero espresso. El sistema L'OR Barista prepara el caf\u00e9 a una alta presi\u00f3n de hasta 19 bares para garantizar la verdadera calidad del espresso.<p><\/p><p><b>Vol\u00famenes de caf\u00e9 ajustables de 25 ml a 220 ml<\/b><\/p><p>Prepara tus caf\u00e9s favoritos con el sistema L'OR Barista - Disfruta de tu cortado, espreso, largo y mucho m\u00e1s con las c\u00e1psulas individuales L'OR Espresso o duplica el placer con las exclusivas c\u00e1psulas doble espresso L'OR Barista.<br><br><b>Crea y personaliza tu caf\u00e9 favorito<\/b><br>La bandeja de goteo se puede ajustar f\u00e1cilmente para adaptarse a una taza grande o a un vaso de leche manchada. Solo tienes que retirar la bandeja de goteo grande y disfrutar de tu taza de caf\u00e9 largo.<br><br><b>El reconocimiento de c\u00e1psula doble detecta autom\u00e1ticamente el tama\u00f1o de la c\u00e1psula<\/b><br>La tecnolog\u00eda de reconocimiento inteligente de c\u00e1psula doble de L'OR Barista detecta autom\u00e1ticamente el tama\u00f1o de la c\u00e1psula y encuentra el ajuste de caf\u00e9 \u00f3ptimo.<br><br><b>Surtido de 9 c\u00e1psulas incluidas en la caja<\/b><br>Todos los aparatos incluyen un surtido de c\u00e1psulas: 4 c\u00e1psulas de una carga L'OR Espresso y 5 c\u00e1psulas de dos cargas L'OR Barista.<br><br><b>Tambi\u00e9n compatible con c\u00e1psulas Nespresso\u00ae*<\/b><br>La cafetera L'OR Barista tambi\u00e9n es compatible con las c\u00e1psulas Nespresso\u00ae*.<br><br><b>Compatible con c\u00e1psulas L'OR Espresso y L'OR Barista<\/b><br>Prepara las nuevas y exclusivas c\u00e1psulas L'OR Barista.<br><br><b>Men\u00fa completo de caf\u00e9s: cortado, espresso, largo y m\u00e1s<\/b><br>Cortado para 2 o espresso doble para ti<\/p><p><br><br><\/p><ul><li><h2>Especificaciones t\u00e9cnicas<\/h2><\/li><li><b>Longitud del cable<\/b><\/li><li>0,8 m<\/li><li><b>Tensi\u00f3n<\/b><\/li><li>220-240 V<\/li><li><b>Frecuencia<\/b><\/li><li>50-60 Hz<\/li><li><b>Tiempo de preparaci\u00f3n de una taza<\/b><\/li><li>30 sec<\/li><li><b>Capacidad del dep\u00f3sito de agua<\/b><\/li><li>1 l<\/li><li><b>Capacidad del dep\u00f3sito de agua<\/b><\/li><li>up to 8 cups<\/li><li><b>Altura m\u00e1xima de la taza<\/b><\/li><li>120 mm<\/li><li><b>Calderas de agua<\/b><\/li><li>1<\/li><li><b>Presi\u00f3n de la bomba<\/b><\/li><li>19 bar<\/li><li><b>Tiempo de preparaci\u00f3n de 2 tazas<\/b><\/li><li>&lt;60 sec<\/li><li><b>Sostenibilidad<\/b><\/li><li>Manual del usuario<\/li><li>Papel 100 % reciclado<\/li><li><b>Consumo de energ\u00eda de preparaci\u00f3n<\/b><\/li><li>1450 W<\/li><li><b>Modo en espera<\/b><\/li><li>&lt;0,5 W<\/li><li><b>Acabado<\/b><\/li><li>Material de la bandeja de goteo<\/li><li><b>Brillante<\/b><\/li><li>Material de la boquilla<\/li><li>pl\u00e1stico<\/li><li><b>Especificaciones generales<\/b><\/li><li>Tazas al mismo tiempo<\/li><li>1 or 2<\/li><li>Facilidad de limpieza y mantenimiento<\/li><li>Piezas aptas para el lavavajillas<\/li><li>Indicador de eliminaci\u00f3n de cal<\/li><li>Facilidad de uso y comodidad<\/li><li>Bandeja de goteo desmontable<\/li><li>Boquilla desmontable<\/li><li>Desconexi\u00f3n autom\u00e1tica<\/li><li>Detenci\u00f3n de preparaci\u00f3n del caf\u00e9<\/li><li>Dep\u00f3sito de agua extra\u00edble<\/li><li><b>Dise\u00f1o<\/b><\/li><li>Color<\/li><li>Rojo Rub\u00ed<\/li><li><b>Servicios<\/b><\/li><li>2 a\u00f1os de garant\u00eda<\/li><li>S\u00ed<\/li><li><b>Peso y dimensiones<\/b><\/li><li>Dimensiones del embalaje (An. x Prof. x Al.)<\/li><li>224 x 468 x 345 mm<\/li><li>Peso del producto<\/li><li>3,560 kg<\/li><li>Dimensiones del producto (An. x Pr. x Al.)<\/li><li>180 x 400 x 280 mm<\/li><li>Peso incluido embalaje<\/li><\/ul><p><\/p><p><\/p><p><\/p><p><\/p><\/div><\/div><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phpae-caf%20lor%20barista%20rd_1.jpg","wholesale_price":"36.37","unit_price_tax":41.37},"product_model":{"product_data":{"ean13":["8720389000126"],"reference":"LM8012\/51","name":{"1":"Cafetera de C\u00e1psulas Philips L'Or Barista LM8012\/ Compatible c\u00e1psulas Nespresso y L'OR\/ Rojo Rub\u00ed","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Doble espresso, dob