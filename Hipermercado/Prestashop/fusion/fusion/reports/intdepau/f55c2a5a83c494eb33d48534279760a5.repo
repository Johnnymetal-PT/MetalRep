ue},"feed_data":{"name_pt":"Cable USB 3.1 Tipo-C Aisens A107-0860\/ USB Tipo-C Macho - USB Macho\/ 10Gbps\/ 2m\/ Negro","category":"Cables","sub_category":"Cable USB","unit_price":8.43,"reference":"A107-0860","ean13":"8435739901144","weight":"0","quantity":0,"brand":"AISENS","description_pt":"<h2>AISENS - CABLE USB 3.1 GEN2 10GBPS 3A, TIPO USB-C\/M-A\/M, NEGRO, 2.0M<\/h2><p><br><\/p><p><h2>Especificaciones<\/h2><ul><li>Cable USB 3.1 GEN2 10Gbps con conector tipo USB-C macho en un extremo y tipo A macho en el otro.<\/li><li>Ideal para conectar su nuevo dispositivo m\u00f3vil\/tablet USB-C a un ordenador con un puerto USB-A convencional.<\/li><li>El cable ofrece hasta 3 amperios de carga, con lo cual se puede usar para cargar su dispositivo m\u00f3vil, tablet, port\u00e1til etc.<\/li><li>Velocidad de transferencia de datos de hasta 10Gbps.<\/li><li>Retrocompatible con USB 2.0 y 1.1<\/li><li>Compatible con puertos con Thunderbolt<\/li><li>El conector USB Type-C es m\u00e1s f\u00e1cil de usar que los conectores USB de generaci\u00f3n anterior. Su dise\u00f1o reversible le permite conectar dispositivos con cualquiera de sus caras hacia arriba. Inserte el cable siempre de forma correcta, de lo contrario puede causar da\u00f1os al puerto.<\/li><li>Este cable USB-C tiene certificaci\u00f3n USB-IF, lo cual significa que cumple con todas las especificaciones sobre USB 3.1.<\/li><li>Longitud: 2.0 Metros<\/li><li>Color: Negro<\/li><li>Normativas: RoHS<\/li><li>Test de funcionamiento: 100% testeado<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-cab%20a107-0860_1.jpg","wholesale_price":"3.43","unit_price_tax":8.43},"product_model":{"product_data":{"ean13":["8435739901144"],"reference":"A107-0860","name":{"1":"Cable USB 3.1 Tipo-C Aisens A107-0860\/ USB Tipo-C Macho - USB Macho\/ 10Gbps\/ 2m\/ Negro","2":"","3":"","4":""},"description":{"1":"<h2>AISENS - CABLE USB 3.1 GEN2 10GBPS 3A, TIPO USB-C\/M-A\/M, NEGRO, 2.0M<\/h2><p><br><\/p><p><h2>Especificaciones<\/h2><ul><li>Cable USB 3.1 GEN2 10Gbps con conector tipo USB-C macho en un extremo y tipo A macho en el otro.<\/li><li>Ideal para conectar su nuevo dispositivo m\u00f3vil\/tablet USB-C a un ordenador con un puerto USB-A convencional.<\/li><li>El cable ofrece hasta 3 amperios de carga, con lo cual se puede usar para cargar su dispositivo m\u00f3vil, tablet, port\u00e1til etc.<\/li><li>Velocidad de transferencia de datos de hasta 10Gbps.<\/li><li>Retrocompatible con USB 2.0 y 1.1<\/li><li>Compatible con puertos con Thunderbolt<\/li><li>El conector USB Type-C es m\u00e1s f\u00e1cil de usar que los conectores USB de generaci\u00f3n anterior. Su dise\u00f1o reversible le permite conectar dispositivos con cualquiera de sus caras hacia arriba. Inserte el cable siempre de forma correcta, de lo contrario puede causar da\u00f1os al puerto.<\/li><li>Este cable USB-C tiene certificaci\u00f3n USB-IF, lo cual significa que cumple con todas las especificaciones sobre USB 3.1.<\/li><li>Longitud: 2.0 Metros<\/li><li>Color: Negro<\/li><li>Normativas: RoHS<\/li><li>Test de funcionamiento: 100% testeado<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AISENS","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":8.43,"unit_price_tax":8.43,"tax_rules_group":null,"category":"Cables","sub_category":"Cable USB","quantity":0,"brand":"AISENS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-cab%20a107-0860_1.jpg"],"wholesale_price":3.43}}},"8435739901175":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435739901175",false],"wholesale_price":[12.86,false],"price":[17.86,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys