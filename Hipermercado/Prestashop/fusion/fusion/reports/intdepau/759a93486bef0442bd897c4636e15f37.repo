%20msrgb%20wh_1.jpg"],"wholesale_price":18.91}}},"4713105966596":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4713105966596",false],"wholesale_price":[5.89,false],"price":[10.89,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.26",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88810","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/cf8de92067a5ac0ca095101e2b2593bf.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Gaming con Micr\u00f3fono Mars Gaming MRH0\/ Jack 3.5\/ Rojos","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Auriculares y Microfonos","unit_price":10.89,"reference":"MRH0","ean13":"4713105966596","weight":"0.26","quantity":5,"brand":"MARS GAMING","description_pt":"                                                                                                                                                                                                <html><head><meta http-equiv='content-type' content='text\/html; charset=UTF-8'><title><\/title><\/head><body>Los MRH0 proporcionan un rendimiento Premium de graves y una calidad de sonido inigualable gracias a sus drivers de 40mm con neodimio. Accede a una experiencia gaming totalcon estos auriculares<br><br><h2>AURICULARES GAMING<\/h2>Su dise\u00f1o ergon\u00f3mico inteligente con diadema totalmente ajustable garantiza una gran adaptabilidad. Adem\u00e1s, los MRH0 vienen equipados con almohadillas blandas de alta calidad para ofrecer la m\u00e1xima comodidad en las largas sesiones de juego<br><br><h2>SONIDO PREMIUM<\/h2>Los MRH0 ofrecen un sonido inigualable gracias a sus drivers de 40mm con neodimio y el rendimiento Premium de graves ecualizado espec\u00edficamente para Gaming. Cuentan, adem\u00e1s, con una rueda de control de volument y con un micr\u00f3fono plegable con cancelaci\u00f3n de ruido y captaci\u00f3n omnidireccional.<br><br><h2>CALIDAD, DISE\u00d1O Y COMODIDAD<\/h2>Los auriculares MRH0 son un producto dise\u00f1ado espec\u00edficamente para jugadores. Pensados para resistir y ofrecer la m\u00e1xima comodidad, estos auriculares fusionan dise\u00f1o y tecnolog\u00eda. \u00a1Los MRH0 son el complemento ideal de todo gamer!<br><br><ul><li>Dimensiones: 177x188x75mm<\/li><li>Peso: 160g<\/li><li>Acabado: Mate<\/li><li>Materiales: Almohadillas cuero sint\u00e9tico + ABS<\/li><li>Color: Negro y Rojo<\/li><li>Tipo de cable: Recubrimiento de goma<\/li><li>Diadema: Ajustable<\/li><li>Sonido: Est\u00e9reo<\/li><li>Compatibilidad: Windows XP \/ Vista \/ 7 \/ 8 \/ 10<\/li><li>Longitud del cable: 150cm<\/li><li>Conector: Jack 3.5mm<\/li><li>Control de volumen: S\u00ed<\/li><li>Dimensiones (driver): 40mm neodimio<\/li><li>Rango de frecuencia (driver): 20Hz to 20kHz<\/li><li>Sensibilidad (driver): 110dB \u00b1 3dB<\/li><li>Impedancia (driver): 32O<\/li><li>Direccionalidad (micr\u00f3fono): Omnidireccional<\/li><li>Impedancia (micr\u00f3fono): 2.2kO \u00b1 30% at 1kHz<\/li><li>Sensibilidad (micr\u00f3fono): 42dB \u00b1 3dB (0dB=1V\/Pa, 1kHz)<\/li><li>Retr\u00e1ctil (micr\u00f3fono): Plegable<\/li><\/ul><\/body><\/html>                                                                                                                                                                                ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-aur%20mrh0_1.jpg","wholesale_price":"5.89","unit_price_tax":10.89},"product_model":{"product_data":{"ean13":["4713105966596"],"reference":"MRH0","name":{"1":"Auriculares Gaming con Micr\u00f3fono Mars Gaming MRH0\/ Jack 3.5\/ Rojos","2":"","3":"","4":""},"description":{"1":"