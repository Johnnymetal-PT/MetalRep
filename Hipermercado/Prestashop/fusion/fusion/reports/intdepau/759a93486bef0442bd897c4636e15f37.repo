etecta y elimina cualquier aumento grande y repentino en el nivel de se\u00f1al; el Tiempo promedio ponderado evita que la exposici\u00f3n diaria promedio al sonido supere los 85&nbsp;dBA<\/li><li><b>B825-M:<\/b> certificado para Skype for Business y optimizado para Microsoft\u00ae Lync\u00ae<br><\/li><\/ul><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PLANTRONICS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.67,"unit_price":120.45,"unit_price_tax":120.45,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":2,"brand":"PLANTRONICS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_plan-aur%20voy%20f%20uc%20micro%20spt_1.jpg"],"wholesale_price":115.45}}},"5033588053576":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5033588053576",false],"wholesale_price":[144.34,false],"price":[149.34,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.54",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84947","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/bdc5eca329a579db200cfad93b9a87b4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auricular Inal\u00e1mbrico Plantronics Voyager 5200 Office\/ con Micr\u00f3fono\/ Bluetooth\/ RJ\/ Negro","category":"Auriculares","sub_category":"Auriculares","unit_price":149.34,"reference":"212722-05","ean13":