 r\u00e1pida<\/li><li>Adaptador AC externo<\/li><li>Tarjeta de garant\u00eda<\/li><li>Manual de usuario<\/li><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MEDION","supplier":null,"width":null,"height":null,"depth":null,"weight":3,"unit_price":294,"unit_price_tax":294,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":5,"brand":"MEDION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_med-p%20md62008%20w11_1.jpg"],"wholesale_price":289}}},"4061275191431":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["4061275191431",false],"wholesale_price":[259,false],"price":[264,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Medion Classmate Pro E14409 Laptop Intel Core i3-1005G1\/ 8 GB\/ 256 GB SSD\/ 14&#39;\/ Win11"],"result":false},"feed_data":{"name_pt":"Port\u00e1til Medion Classmate Pro E14409 Intel Core i3-1005G1\/ 8GB\/ 256GB SSD\/ 14'\/ Win11","category":"Portatiles","sub_category":"Portatiles","unit_price":264,"reference":"30033663","ean13":"4061275191431","weight":"2.5","quantity":5,"brand":"MEDION","description_pt":"<p><\/p><h2><span style='background-color: initial;'>Procesador Intel\u00ae Core&#8482; de d\u00e9cima generaci\u00f3n<\/span><br><\/h2>Un procesador Intel\u00ae Core&#8482; de d\u00e9cima generaci\u00f3n garantiza que tus programas se ejecuten con el m\u00e1ximo rendimiento. Incluso con aplicaciones exigentes, tu port\u00e1til<br>funciona con la mayor eficiencia debido a la arquitectura mejora