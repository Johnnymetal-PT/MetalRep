,"3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BEURER","supplier":null,"width":null,"height":null,"depth":null,"weight":0.25,"unit_price":28.39,"unit_price_tax":28.39,"tax_rules_group":null,"category":"Salud","sub_category":"Termometros","quantity":2,"brand":"BEURER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_beu-pae-ter%20digital%20ft-85%20v2_1.jpg"],"wholesale_price":23.39}}},"8435253571137":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435253571137",false],"wholesale_price":[21.43,false],"price":[26.43,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.89",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:89199","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/a55e949ce29b5411a89425d93372d321.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Masajeador Pistola Jocca 1587","category":"Salud","sub_category":"Masajeadores","unit_price":26.43,"reference":"1587","ean13":"8435253571137","weight":"0.89","quantity":0,"brand":"JOCCA","description_pt":"<p><h2>PISTOLA DE MASAJE<\/h2>\u00a1Hazte con la pistola de masaje Jocca y finalmente desestr\u00e9sate! Vibraciones de hasta 3000RMP y 4 cabezales diferentes con el que reducir la tensi\u00f3n muscular, eliminar la rigidez y el dolor.<br>Se carga f\u00e1cilmente en cualquier lugar con el cable USB, que viene incluido en la caja. Por lo que podr\u00e1s usarlo en el trabajo, gimnasio y tras cualquier actividad deportiva para recuperarte m\u00e1s r\u00e1pido.<br>Masajea tu cuello, espalda, cintura, brazos o piernas. Es ideal para relajar los hombros tensos ras trabajar muchas horas detr\u00e1s de un escritorio y como rehabilitaci\u00f3n para personas mayores. Es una terapia fan\u00e1tica para dormir mejor si te lo haces en modo relajante cada noche. \u00a1El regalo perfecto para familiares y amigos!<br><br><ul><li>Vibraci\u00f3n de alta frecuencia, disipaci\u00f3n de la fatiga, masaje profundo, relajaci\u00f3n de los m\u00fasculos, alivia el dolor.<\/li><li>El agarre ergon\u00f3mico ayuda a minimizar la fuerza externa.<\/li><li>Dise\u00f1o pr\u00e1ctico y compacto.<\/li><li>6 niveles de velocidad:<\/li><li>Velocidad 1: 2000RMP<\/li><li>Velocidad 2: 2200RMP<\/li><li>Velocidad 3: 2400RMP<\/li><li>Velocidad 4: 2600RMP<\/li><li>Velocidad 5: 2800RMP<\/li><li>Velocidad 6: 3000RMP<\/li><li>Incluye 4 cabezales de masaje:<\/li><li>La cabeza redonda est\u00e1 indicada para las zonas: brazos, espalda, gl\u00fateos y piernas.<\/li><li>La cabeza plana est\u00e1 indicada para relajar y dar forma a todos los m\u00fasculos.<\/li><li>Taper Head est\u00e1 indicado para tejidos profundos como articulaciones, palma de la mano o zona plantar.<\/li><li>La cabeza en forma de U est\u00e1 indicada para la zona del cuello, la columna y el tend\u00f3n de Aquiles.<\/li><li>Incluye cable USB<\/li><li>5V= 1A (por USB)<\/li><li>7,4 V= (bater\u00eda de litio)<\/li><li>Capacidad 1200 mAh<\/li><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_joc-pae-masajeador%201587_1.jpg","wholesale_price":"21.43","unit_price_tax":26.43},"product_model":{"product_data":{"ean13":["8435253571137"],"reference":"1587","name":{"1":"Masajeador Pistola Jocca 1587","2":"","3":"","4":""},"description":{"1":"<p><h2>PISTOLA DE MASAJE<\/h2>\u00a1Hazte con la pistola de masaje Jocca y finalmente desestr\u00e9sate! Vibraciones de hasta 3000RMP y 4 cabezales diferentes con el que reducir la tensi\u00f3n muscular, eliminar la rigidez y el dolor.<br>Se carga f\u00e1cilmente en cualquier lugar con el cable USB, que viene incluido en la caja. Por lo que podr\u00e1s usarlo en el trabajo, gimnasio y tras cualquier actividad deportiva para recuperarte m\u00e1s r\u00e1pido.<br>Masajea tu cuello, espalda, cintura, brazos o piernas. Es ideal para relajar los hombros tensos ras trabajar muchas horas detr\u00e1s de un escritorio y como rehabilitaci\u00f3n para personas mayores. Es una terapia fan\u00e1tica para dormir mejor si te lo haces en modo relajante cada noche. \u00a1El regalo perfecto para familiares y amigos!<br><br><ul><li>Vibraci\u00f3n de alta frecuencia, disipaci\u00f3n de la fatiga, masaje profundo, relajaci\u00f3n de los m\u00fasculos, alivia el dolor.<\/li><li>El agarre ergon\u00f3mico ayuda a minimizar la fuerza externa.<\/li><li>Dise\u00f1o pr\u00e1ctico y compacto.<\/li><li>6 niveles de velocidad:<\/li><li>Velocidad 1: 2000RMP<\/li><li>Velocidad 2: 2200RMP<\/li><li>Velocidad 3: 2400RMP<\/li><li>Velocidad 4: 2600RMP<\/li><li>Velocidad 5: 2800RMP<\/li><li>Velocidad 6: 3000RMP<\/li><li>Incluye 4 cabezales de masaje:<\/li><li>La cabeza redonda est\u00e1 indicada para las zonas: brazos, espalda, gl\u00fateos y piernas.<\/li><li>La cabeza plana est\u00e1 indicada para relajar y dar forma a todos los m\u00fasculos.<\/li><li>Taper Head est\u00e1 indicado para tejidos profundos como articulaciones, palma de la mano o zona plantar.<\/li><li>La cabeza en forma de U est\u00e1 indicada para la zona del cuello, la columna y el tend\u00f3n de Aquiles.<\/li><li>Incluye cable USB<\/li><li>5V= 1A (por USB)<\/li><li>7,4 V= (bater\u00eda de litio)<\/li><li>Capacidad 1200 mAh<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","ma