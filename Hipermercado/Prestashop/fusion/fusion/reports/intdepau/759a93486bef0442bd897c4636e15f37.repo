i>  <li>Peso<\/li>  <li>150 g<\/li>  <li><b>EMPAQUETADO<\/b><\/li>  <li>Cables incluidos<\/li>  <li>USB Tipo C<\/li><\/ul><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"UBIQUITI","supplier":null,"width":null,"height":null,"depth":null,"weight":0.24,"unit_price":32.44,"unit_price_tax":32.44,"tax_rules_group":null,"category":"Conectividad Profesional","sub_category":"Ubiquiti Productos","quantity":2,"brand":"UBIQUITI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ubi-switch%20usw-flex-mini_1.jpg"],"wholesale_price":27.44}}},"0817882028554":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0817882028554",false],"wholesale_price":[350.32,false],"price":[355.32,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 4.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86931","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/62dfd01a49070cd7f2f2b000f12bcf6f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Switch Ubiquiti USW-24-POE 24 Puertos\/ RJ45 10\/100\/1000 POE","category":"Conectividad Profesional","sub_category":"Ubiquiti Productos","unit_price":355.32,"reference":"USW-24-POE","ean13":"0817882028554","weight":"4.1","quantity":0,"brand":"UBIQUITI","description_pt":"Switch PoE administrado de 24 puertos con (16) puertos PoE + 802.3at, (8) puertos Gigabit Ethernet y (2) puertos SFP. Potente conmutaci\u00f3n UniFi de segunda generaci\u00f3n.<div><br><p>El USW-24-POE es un conmutador Gigabit Layer 2 configurable con veinticuatro puertos Gigabit Ethernet, incluidos diecis\u00e9is puertos 802.3at PoE + de detecci\u00f3n autom\u00e1tica y dos puertos SFP. Proporciona enlaces Gigabit PoE a sus dispositivos Ethernet RJ45 y opciones de enlace ascendente de fibra Gigabit a su red empresarial. El USW-24-POE cuenta con un LCM t\u00e1ctil de 1.3 'para proporcionar informaci\u00f3n de estado. Con una profundidad de 7.9', el dise\u00f1o compacto sin ventilador se puede instalar f\u00e1cilmente en un gabinete de rack SOHO.<\/p><p><br><\/p><p><ul><li><b>Especificaciones<\/b><\/li><ul><li>Caracter\u00edsticas de administraci\u00f3n<\/li><ul><li>Tipo de interruptor: Gestionado<\/li><li>Capa del interruptor: L2\/L3<\/li><\/ul><\/ul><\/ul><ul><ul><li>Puertos e Interfaces<\/li><ul><li>Cantidad de puertos b\u00e1sicos de conmutaci\u00f3n RJ-45 Ethernet: 24<\/li><li>Puertos tipo b\u00e1sico de conmutaci\u00f3n RJ-45 Ethernet: Gigabit Ethernet (10\/100\/1000)<\/li><li>N\u00famero de m\u00f3dulos SFP instalados: 2<\/li><\/ul><\/ul><\/ul><ul><ul><li>Conexi\u00f3n<\/li><ul><li>Est\u00e1ndares de red: IEEE 802.3af, IEEE 802.3at<\/li><li>Espejeo de puertos: Si<\/li><li>Bidireccional completo (Full d\u00faplex): Si<\/li><li>Soporte de control de flujo: Si<\/li><li>Auto MDI \/ MDI-X: Si<\/li><li>Protocolo de \u00e1rbol de expansi\u00f3n: Si<\/li><li>Soporte VLAN: Si<\/li><\/ul><\/ul><\/ul><ul><ul><li>Transmisi\u00f3n de datos<\/li><ul><li>Capacidad de conmutaci\u00f3n: 52 Gbit\/s<\/li><li>Rendimiento: 26000 Mpps<\/li><li>Tasa de reenv\u00edo: 38,69 Mpps<\/li><li>Ruta est\u00e1tica: Si<\/li><li>Jumbo Frames, soporte: Si<\/li><\/ul><\/ul><\/ul><ul><ul><li>Seguridad<\/li><ul><li>Tipo de autenticaci\u00f3n: IEEE 802.1x,RADIUS<\/li><\/ul><\/ul><\/ul><ul><ul><li>Dise\u00f1o<\/li><ul><li>Montaje en rack: Si<\/li><li>Factor de forma: 1U<\/li><li>Color del producto: Plata<\/li><li>Indicadores LED: Actividad, Enlace, PoE, Velocidad, Sistema<\/li><li>Certificaci\u00f3n: CE, FCC, IC<\/li><\/ul><\/ul><\/ul><ul><ul><li>Control de energ\u00eda<\/li><ul><li>Fuente de alimentaci\u00f3n incluida: Si<\/li><li>Voltaje de entrada AC: 100 - 240 V<\/li><li>Frecuencia de entrada AC: 50\/60 Hz<\/li><li>Voltaje de entrada DC: 44 - 57 V<\/li><\/ul><\/ul><\/ul><ul><ul><li>Alimentaci\u00f3n a trav\u00e9s de Ethernet (PoE)<\/li><ul><li>Energ\u00eda sobre Ethernet (PoE): Si<\/li><li>Alimentaci\u00f3n mediante Ethernet Plus (PoE +) Cantidad de puertos: 16<\/li><li>Potencia por puerto de alimentaci\u00f3n a trav\u00e9s de Ethernet (PoE): 32 W<\/li><li>Potencia a trav\u00e9s de Ethernet (PoE) Presupuesto: 92 W<\/li><\/ul><\/ul><\/ul><ul><ul><li>Condiciones ambientales<\/li><ul><li>Intervalo de temperatura operativa: -5 - 40 \u00b0C<\/li><li>Intervalo de humedad relativa para funcionamiento: 10 - 90%<\/li><\/ul><\/ul><\/ul><ul><ul><li>Peso y dimensiones<\/li><ul><li>Ancho: 442,4 mm<\/li><li>Profundidad: 200 mm<\/li><li>Altura: 43,7 mm<\/li><li>Peso: 3 kg<\/li><\/ul><\/ul><\/ul><br><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ubi-switch%20usw-24-poe_1.jpg","wholesale_price":"350.32","unit_price_tax":355.32},"product_model":{"product_data":{"ean13":["0817882028554"],"reference":"USW-24-POE","name":{"1":"Switch Ubiquiti USW-24-POE 24 Puertos\/ RJ45 10\/100\/1000 POE","2":"","3":"","4":""},"description":{"1":"Switch PoE administrado de 24 puertos con (16) puertos PoE + 802.3at, (8) puertos Gigabit Ethernet y (2) puertos SFP. Potente conmutaci\u00f3n UniFi de segunda generaci\u00f3n.<div><br><p>El USW-24-POE es un conmutador Gigabit Layer 2 configurable con veinticuatro puertos Gigabit Ethernet, incluidos diecis\u00e9is puertos 802.3at PoE + de detecci\u00f3n autom\u00e1tica y dos puertos SFP. Proporciona enlaces Gigabit PoE a sus dispositivos Ethernet RJ45 y opciones de enlace ascendente de fibra Gigabit a su red empresarial. El USW-24-POE cuenta con un LCM t\u00e1ctil de 1.3 'para proporcionar informaci\u00f3n de estado. Con una profundidad de 7.9', el dise\u00f1o compacto sin ventilador se puede instalar f\u00e1cilmente en un gabinete de rack SOHO.<\/p><p><br><\/p><p><ul><li><b>Especificaciones<\/b><\/li><ul><li>Caracter\u00edsticas de administraci\u00f3n<\/li><ul><li>Tipo de interruptor: Gestionado<\/li><li>Capa del interruptor: L2\/L3<\/li><\/ul><\/ul><\/ul><ul><ul><li>Puertos e Interfaces<\/li><ul><li>Cantidad de puertos b\u00e1sicos de conmutaci\u00f3n RJ-45 Ethernet: 24<\/li><li>Puertos tipo b\u00e1sico de conmutaci\u00f3n RJ-45 Ethernet: Gigabit Ethernet (10\/100\/1000)<\/li><li>N\u00famero de m\u00f3dulos SFP instalados: 2<\/li><\/ul><\/ul><\/ul><ul><ul><li>Conexi\u00f3n<\/li><ul><li>Est\u00e1ndares de red: IEEE 802.3af, IEEE 802.3at<\/li><li>Espejeo de puertos: Si<\/li><li>Bidireccional completo (Full d\u00faplex): Si<\/li><li>Soporte de control de flujo: Si<\/li><li>Auto MDI \/ MDI-X: Si<\/li><li>Protocolo de \u00e1rbol de expansi\u00f3n: Si<\/li><li>Soporte VLAN: Si<\/li><\/ul><\/ul><\/ul><ul><ul><li>Transmisi\u00f3n de datos<\/li><ul><li>Capacidad de conmutaci\u00f3n: 52 Gbit\/s<\/li><li>Rendimiento: 26000 Mpps<\/li><li>Tasa de reenv\u00edo: 38,69 Mpps<\/li><li>Ruta est\u00e1tica: Si<\/li><li>Jumbo Frames, soporte: Si<\/li><\/ul><\/ul><\/ul><ul><ul><li>Seguridad<\/li><ul><li>Tipo de autenticaci\u00f3n: IEEE 802.1x,RADIUS<\/li><\/ul><\/ul><\/ul><ul><ul><li>Dise\u00f1o<\/li><ul><li>Montaje en rack: Si<\/li><li>Factor de forma: 1U<\/li><li>Color del producto: Plata<\/li><li>Indicadores LED: Actividad, Enlace, PoE, Velocidad, Sistema<\/li><li>Certificaci\u00f3n: CE, FCC, IC<\/li><\/ul><\/ul><\/ul><ul><ul><li>Control de energ\u00eda<\/li><ul><li>Fuente de alimentaci\u00f3n incluida: Si<\/li><li>Voltaje de entrada AC: 100 - 240 V<\/li><li>Frecuencia de entrada AC: 50\/60 Hz<\/li><li>Voltaje de entrada DC: 44 - 57 V<\/li><\/ul><\/ul><\/ul><ul><ul><li>Alimentaci\u00f3n a trav\u00e9s de Ethernet (PoE)<\/li><ul><li>Energ\u00eda sobre Ethernet (PoE): Si<\/li><li>Alimentaci\u00f3n mediante Ethernet Plus (PoE +) Cantidad de puertos: 16<\/li><li>Potencia por puerto de alimentaci\u00f3n a trav\u00e9s de Ethernet (PoE): 32 W<\/li><li>Potencia a trav\u00e9s de Ethernet (PoE) Presupuesto: 92 W<\/li><\/ul><\/ul><\/ul><ul><ul><li>Condiciones ambientales<\/li><ul><li>Intervalo de temperatura operativa: -5 - 40 \u00b0C<\/li><li>Intervalo de humedad relativa para funcionamiento: 10 - 90%<\/li><\/ul><\/ul><\/ul><ul><ul><li>Peso y dimensiones<\/li><ul><li>Ancho: 442,4 mm<\/li><li>Profundidad: 200 mm<\/li><li>Altura: 43,7 mm<\/li><li>Peso: 3 kg<\/li><\/ul><\/ul><\/ul><br><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"UBIQUITI","supplier":null,"width":null,"height":null,"depth":null,"weight":4.1,"unit_price":355.32,"unit_price_tax":355.32,"tax_rules_group":null,"category":"Conectividad Profesional","sub_category":"Ubiquiti Productos","quantity":0,"brand":"UBIQUITI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ubi-switch%20usw-24-poe_1.jpg"],"wholesale_price":350.32}}},"0810010075864":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0810010075864",false],"wholesale_price":[275.55,false],"price":[280.55,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.62",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86932","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images creat