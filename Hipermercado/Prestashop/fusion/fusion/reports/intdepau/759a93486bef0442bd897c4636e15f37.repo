ps:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-aur%20mhaxp_1.jpg"],"wholesale_price":25.49}}},"8435693101956":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693101956",false],"wholesale_price":[35.87,false],"price":[40.87,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.85",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88833","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/2b553799317ca6cd6b24044fe3de047c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Caja Gaming Semitorre Mars Gaming MC-X2\/ Blanca","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","unit_price":40.87,"reference":"MCX2W","ean13":"8435693101956","weight":"3.85","quantity":0,"brand":"MARS GAMING","description_pt":"                                                <p><h2>SEMITORRE GAMING MC-X2<\/h2>Imponente frontal en acero y dos ventiladores FRGB incluidos para una refrigeraci\u00f3n excelente de serie. Espacio para l\u00edquidas hasta 240mm y gr\u00e1ficas extragrandes de 3 ventiladores.<br><br><h2>FRONTAL EN ACERO \/ ILUMINACI\u00d3N FRGB<\/h2>El frente de la MC-X2 cuenta con un imponente frontal en acero y una espectacular iluminaci\u00f3n FRGB en sus dos ventiladores incluidos.<br><br><h2>REFRIGERACI\u00d3N AVANZADA<\/h2>Un flujo de aire constante es la clave para extender la vida \u00fatil de tus componentes y hacer que tu sistema funcione a pleno rendimiento. La MC-X2, elimina todo problema de temperatura manteniendo el silencio gracias a un flujo de aire constante que pueden ofrecer hasta 6 ventiladores de 120 mm instalables (2 preinstalados) y su soporte de refrigeraciones l\u00edquidas hasta 240mm.<br><br><h2>VENTANA LATERAL<\/h2>Dotada de una ventana completa, la caja MC-X2 permite mostrar tu PC en todo su esplendor.<br><br><h2>GRAN CAPACIDAD<\/h2>MC-X2 te ofrece un gran espacio interno para la instalaci\u00f3n de componentes de alto rendimiento, ofreciendo soporte para placas ATX, microATX y mini-ITX, soporte para refrigeraciones l\u00edquidas hasta 240mm, gr\u00e1ficas de 3 ventiladores de hasta 317mm, 3 discos SSD de 2.5' y 2 discos HDD de 3.5', y una gesti\u00f3n de cableado interno totalmente eficiente.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Dimensiones<\/li>  <li>422x192x363mm<\/li>  <li>Peso<\/li>  <li>3180g<\/li>  <li>Tama\u00f1o<\/li>  <li>Semitorre<\/li>  <li>Ventana<\/li>  <li>Ventana lateral completa acr\u00edlica<\/li>  <li>Iluminaci\u00f3n<\/li>  <li>Iluminaci\u00f3n RGB Fija<\/li>  <li>Extras<\/li>  <li>Sistema de gesti\u00f3n de cableado interno<\/li>  <li>Compatibilidad con placas base<\/li>  <li>ATX \/ MicroATX \/ Mini-ITX<\/li>  <li>Filtros antipolvo<\/li>  <li>1x filtro superior magn\u00e9tico<\/li>  <li>Puertos<\/li>  <li>USB3.0 x1 \/ USB2.0 x2 \/ HD Audio + Mic<\/li>  <li>Tipo de fuente<\/li>  <li>ATX<\/li>  <li>Bah\u00edas internas<\/li>  <li>2x 3.5' HDD \/ 3x 2.5' SSD<\/li>  <li>Longitud VGA m\u00e1x.<\/li>  <li>317mm<\/li>  <li>Anchura VGA m\u00e1x.<\/li>  <li>154mm<\/li>  <li>Altura disipador m\u00e1x.<\/li>  <li>158mm<\/li>  <li>Slots de expansi\u00f3n<\/li>  <li>7<\/li>  <li>Soporte refrigeraci\u00f3n l\u00edquida<\/li>  <li>*240mm, 120mm frontal (compatible con refrigeraciones l\u00edquidas 240mm con radiadores hasta 275mm de largo)<\/li>  <li>Capacidad de ventiladores<\/li>  <li>Hasta 6x 120mm<\/li>  <li>Ventiladores incluidos<\/li>  <li>1x trasero 120mm + 1x frontal 120mm FRGB<\/li>  <li>Medidas internas<\/li>  <li>Ancho-17.5 Alto-40.5 (suelo a techo) Largo 32cm<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/