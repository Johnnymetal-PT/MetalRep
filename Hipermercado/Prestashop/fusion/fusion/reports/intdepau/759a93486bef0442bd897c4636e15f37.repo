":["8436586740085",false],"wholesale_price":[19.82,false],"price":[24.82,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.44",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:89666","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/63a389f985685f4a672c0fb8c035d1b8.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Teclado Compacto Inal\u00e1mbrico por Bluetooth Subblim Advance Compact\/ Gris","category":"Teclados","sub_category":"Teclados","unit_price":24.82,"reference":"SUB-KB-3ADC201","ean13":"8436586740085","weight":"0.44","quantity":5,"brand":"SUBBLIM","description_pt":"                                                <p><ul>  <li>    <h2>Caracter\u00edsticas: <\/h2>  <\/li>  <li>Dise\u00f1o Aluminio: Disfruta de sensaciones Premium con un excelente acabado en Aluminio, m\u00e1xima precisi\u00f3n en tus movimientos y una cuidada est\u00e9tica vanguardista con los bordes biselados. M\u00e1xima elegancia y resistencia.<\/li>  <li>Conecta 3 dispositivos BT: Para escribir en la Tablet, Smartphone u Ordenador, presiona el bot\u00f3n Bluetooth asignado al dispositivo espec\u00edfico , en segundos el teclado est\u00e1 conectado y listo para usar de forma sencilla.<\/li>  <li>Bater\u00eda Li-ion Recargable: Cuando el indicador LED te indique que el nivel de bater\u00eda es bajo, conecta\u00a0 tu dispositivo por USB a una fuente de corriente y sigue usando tu teclado mientras se recarga gracias a su Bater\u00eda de Li-ion.<\/li>  <li>Compatibilidad: Se adaptan autom\u00e1ticamente tanto a los dispositivos Apple, Windows o Android.<\/li>  <li>Ahorro de Energ\u00eda: Despu\u00e9s de 10 min de inactividad, el teclado pasar\u00e1 autom\u00e1ticamente al modo suspensi\u00f3n para conservar las bater\u00edas. Simplemente presione cualquier tecla y espere 2-3 segundos para volver a activarlo. <\/li>  <li>    <h2>Especificaciones Subblim Advance Compact Silver:<\/h2>  <\/li>  <li>Tipo de teclado: membrana<\/li>  <li>Dise\u00f1o: slim<\/li>  <li>Superficie: Soft touch<\/li>  <li>Bater\u00eda Li-Ion 350 mAh<\/li>  <li>N\u00famero de teclas: 78<\/li>  <li>Vida \u00fatil de las teclas: 5 millones de presiones<\/li>  <li>Tiempo de trabajo: 90 horas<\/li>  <li>Tiempo en espera: 120 d\u00edas<\/li>  <li>Bluetooth: 3.0<\/li>  <li>Bater\u00eda LI-ION 350 mAh<\/li>  <li>Voltaje de funcionamiento: 3.0v-5.0v<\/li>  <li>Corriente de trabajo: < 5.0mA<\/li>  <li>Corriente en espera: <2.5mA<\/li>  <li>Corriente de apagado: >200uA<\/li>  <li>Compatible con dispositivos Apple, Android y Windows<\/li>  <li>Incluye bater\u00eda de litio y carga por USB<\/li><\/ul><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sub-tec%203adc201_1.jpg","wholesale_price":"19.82","unit_price_tax":24.82},"product_model":{"product_data":{"ean13":["8436586740085"],"reference":"SUB-KB-3ADC201","name":{"1":"Teclado Compacto Inal\u00e1mbrico por Bluetooth Subblim Advance Compact\/ Gris","2":"","3":"","4":""},"description":{"1":"                                                <p><ul>  <li>    <h2>Caracter\u00edsticas: <\/h2>  <\/li>  <li>Dise\u00f1o Aluminio: Disfruta de sensaciones Premium con un excelente acabado en Aluminio, m\u00e1xima precisi\u00f3n en tus movimientos y una cuidada est\u00e9tica vanguardista con los bordes biselados. M\u00e1xima elegancia y resistencia.<\/li>  <li>Conecta 3 dispositivos BT: Para escribir en la Tablet, Smartphone u Ordenador, presiona el bot\u00f3n Bluetooth asignado al dispositivo espec\u00edfico , en segundos el teclado est\u00e1 conectado y listo para usar de forma sencilla.<\/li>  <li>Bater\u00eda Li-