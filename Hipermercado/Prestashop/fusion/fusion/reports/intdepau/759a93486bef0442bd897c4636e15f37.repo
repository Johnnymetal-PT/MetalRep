bk_1.jpg"],"wholesale_price":16.72}}},"8435693100089":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693100089",false],"wholesale_price":[9.84,false],"price":[14.84,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.28",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84698","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/bbfce198a32872e6eda07e206fca2fde.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Altavoz con Bluetooth Mars Gaming MSECO\/ 8W\/ 1.0\/ Bamb\u00fa y Gris","category":"Altavoces","sub_category":"Altavoces","unit_price":14.84,"reference":"MSECO","ean13":"8435693100089","weight":"0.28","quantity":2,"brand":"MARS GAMING","description_pt":"                                                                                                <p><h2>ALTAVOZ BLUETOOTH ECOL\u00d3GICO MS-ECO<\/h2>Nueva generaci\u00f3n de productos tecnol\u00f3gicos ECO. Fabricados con sustitutivos del pl\u00e1stico: wheat straw y bamb\u00fa, membranas biol\u00f3gicas y empaquetados ECO. Colabora para salvar el planeta con el proyecto be plastic smart. Altavoz ecol\u00f3gico de \u00faltima generaci\u00f3n.<\/p><p><br><h2>Altavoz ecol\u00f3gico de \u00faltima generaci\u00f3n<\/h2><ul>  <ul><li>ECO WHEAT STRAW<\/li><li>ECO BAMB\u00da<\/li><li>ECO MEMBRANA BIOL\u00d3GICA<\/li><li>BLUETOOTH 5.1<\/li><\/ul>      <\/ul><h2>MATERIAL ECO WHEAT STRAW<\/h2>El material sustitutivo del pl\u00e1stico m\u00e1s innovador. El wheat straw es un subproducto del trigo obtenido del aprovechamiento de los residuos de las cosechas. Material compostable y biodegradable, permite sustituir de forma efectiva el pl\u00e1stico con la dureza y durabilidad requeridas en los productos comerciales.<br><br><h2>MATERIAL ECO BAMB\u00da<\/h2>De bosques sostenibles, el bamb\u00fa es la madera m\u00e1s ecol\u00f3gica de todas gracias a su enorme capacidad de crecimiento utilizando los m\u00ednimos recursos. El bamb\u00fa aporta belleza y naturalidad al MS-ECO, adem\u00e1s de sustituir la necesidad del uso de pl\u00e1stico u otros materiales contaminantes.<br><br><h2>MATERIAL ECO MEMBRANA BIOL\u00d3GICA<\/h2>Un sonido limpio, equilibrado y potente gracias al uso de membrana biol\u00f3gica en el driver de sonido. Disfruta de una calidad de sonido excelente mientras cuidas el medio ambiente.<br><br><h2>EMPAQUETADO ECOLOGICO<\/h2>Fabricado con materiales reciclados y reducido al m\u00ednimo tama\u00f1o posible. Adem\u00e1s, eliminamos todo material que genera residuos de forma innecesaria imprimiendo el manual en el propio empaquetado. Reduce al m\u00e1ximo la huella de CO2.<br><br><h2>BLUETOOTH 5.1<\/h2>Incorporamos el avanzado Bluetooth 5.1 para un m\u00e1ximo ahorro energ\u00e9tico, una estabilidad de la conexi\u00f3n inal\u00e1mbrica ante cualquier circunstancia, una latencia s\u00faper baja y una calidad de sonido de alta fidelidad con codecs avanzados. Adem\u00e1s, su conexi\u00f3n es ultra sencilla y autom\u00e1tica una vez emparejado.<br><br><h2>COMPACTO CON GRAN AUTONOM\u00cdA<\/h2>Tama\u00f1o super compacto y con una bater\u00eda de peque\u00f1o tama\u00f1o para minimizar el impacto medioambiental. Gracias al Bluetooth 5.1 y a avanzados sistemas de ahorro de energ\u00eda, obtendr\u00e1s hasta 5 horas de uso. Para que lo disfrutes en cualquier parte.<br><br><h2>PROYECTO BE PLASTIC SMART<\/h2>Es una realidad que los mares y oc\u00e9anos son los grandes receptores de basuras y pl\u00e1sticos y que reciben entre 8 y 10 millones de toneladas de basura al a\u00f1o lo que ha provocado la formaci\u00f3n de 5 islas de basura y micro pl\u00e1sticos en los oc\u00e9anos Pac\u00edfico, Atl\u00e1ntico e \u00cdndico, y que resulta en, adem\u00e1s de la propia contaminaci\u00f3n y liberaci\u00f3n de qu\u00edmicos o enredos de los animales marinos entre otros, la presencia de micro pl\u00e1sticos en los alimentos de origen marino y, en consecuencia, en la propia cadena alimentaria.<br><br>Por ello, para colaborar en el cuidado del planeta, en el fomento de la concienciaci\u00f3n de esta realidad y participar en las actividades de limpieza de nuestras costas, Mars Gaming destinar\u00e1 el 10% de los beneficios por la venta del MS-ECO a entidades sin \u00e1nimo de lucro que generen acciones inmediatas y duraderas en este objetivo medioambiental como es la Fundaci\u00f3n Ecomar.<br><br><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><ul>  <li>Dimensiones: 91x91x43mm<\/li>  <li>Peso: 222g<\/li>  <li>Tama\u00f1o: Compacto<\/li>  <li>Materiales: Paja de trigo, Bamb\u00fa y materiales reciclados<\/li>  <li>Color: Gris<\/li>  <li>Potencia: 8W<\/li>  <li>Conector: Micro-USB (Alimentaci\u00f3n)<\/li>  <li>Drivers: 1 Activo<\/li>  <li>Rango de frecuencia: 20Hz-20KHz<\/li>  <li>Impedancia: 4&#937;<\/li>  <li>Longitud del cable: 30cm<\/li>  <li>Compatibilidad: Dispositivos Bluetooth<\/li>  <li>Capacidad bater\u00eda: 600mAh<\/li>  <li>Tiempo de funcionamiento: 4-5 horas *El tiempo de uso puede variar dependiendo del volumen, contenido a reproducir y dispositivo<\/li>  <li>Versi\u00f3n Bluetooth: 5.1<\/li>  <li>Distancia de conexi\u00f3n: 10 Metros<\/li>  <li><b>CONTENIDO DE LA CAJA<\/b><\/li>  <li>Altavoz, cable USB-A\/Micro-USB, manual de usuario<\/li><\/ul><br><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-alt%20mseco_1.jpg","wholesale_price":"9.84","unit_price_tax":14.84},"product_model":{"product_data":{"ean13":["8435693100089"],"reference":"MSECO","name":{"1":"Altavoz con Bluetooth Mars Gaming MSECO\/ 8W\/ 1.0\/ Bamb\u00fa y Gris","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><h2>ALTAVOZ BLUETOOTH ECOL\u00d3GICO MS-ECO<\/h2>Nueva generaci\u00f3n de productos tecnol\u00f3gicos ECO. Fabricados con sustitutivos del pl\u00e1stico: wheat straw y bamb\u00fa, membranas biol\u00f3gicas y empaquetados ECO. Colabora para salvar el planeta con el proyecto be plastic smart. Altavoz ecol\u00f3gico de \u00faltima generaci\u00f3n.<\/p><p><br><h2>Altavoz ecol\u00f3gico de \u00faltima generaci\u00f3n<\/h2><ul>  <ul><li>ECO WHEAT STRAW<\/li><li>ECO BAMB\u00da<\/li><li>ECO MEMBRANA BIOL\u00d3GICA<\/li><li>BLUETOOTH 5.1<\/li><\/ul>      <\/ul><h2>MATERIAL ECO WHEAT STRAW<\/h2>El material sustitutivo del pl\u00e1stico m\u00e1s innovador. El wheat straw es un subproducto del trigo obtenido del aprovechamiento de los residuos de las cosechas. Material compostable y biodegradable, permite sustituir de forma efectiva el pl\u00e1stico con la dureza y durabilidad requeridas en los productos comerciales.<br><br><h2>MATERIAL ECO BAMB\u00da<\/h2>De bosques sostenibles, el bamb\u00fa es la madera m\u00e1s ecol\u00f3gica de todas gracias a su enorme capacidad de crecimiento utilizando los m\u00ednimos recursos. El bamb\u00fa aporta belleza y naturalidad al MS-ECO, adem\u00e1s de sustituir la necesidad del uso de pl\u00e1stico u otros materiales contaminantes.<br><br><h2>MATERIAL ECO MEMBRANA BIOL\u00d3GICA<\/h2>Un sonido limpio, equilibrado y potente gracias al uso de membrana biol\u00f3gica en el driver de sonido. Disfruta de una calidad de sonido excelente mientras cuidas el medio ambiente.<br><br><h2>EMPAQUETADO ECOLOGICO<\/h2>Fabricado con materiales reciclados y reducido al m\u00ednimo tama\u00f1o posible. Adem\u00e1s, eliminamos todo material que genera residuos de forma innecesaria imprimiendo el manual en el propio empaquetado. Reduce al m\u00e1ximo la huella de CO2.<br><br><h2>BLUETOOTH 5.1<\/h2>Incorporamos el avanzado Bluetooth 5.1 para un m\u00e1ximo ahorro energ\u00e9tico, una estabilidad de la conexi\u00f3n inal\u00e1mbrica ante cualquier circunstancia, una latencia s\u00faper baja y una calidad de sonido de alta fidelidad con codecs avanzados. Adem\u00e1s, su conexi\u00f3n es ultra sencilla y autom\u00e1tica una vez emparejado.<br><br><h2>COMPACTO CON GRAN AUTONOM\u00cdA<\/h2>Tama\u00f1o super compacto y con una bater\u00eda de peque\u00f1o tama\u00f1o para minimizar el impacto medioambiental. Gracias al Bluetooth 5.1 y a avanzados sistemas de ahorro de energ\u00eda, obtendr\u00e1s hasta 5 horas de uso. Para que lo disfrutes en cualquier parte.<br><br><h2>PROYECTO BE PLASTIC SMART<\/h2>Es una realidad que los mares y oc\u00e9anos son los grandes receptores de basuras y pl\u00e1sticos y que reciben entre 8 y 10 millones de toneladas de basura al a\u00f1o lo que ha provocado la formaci\u00f3n de 5 islas de basura y micro pl\u00e1sticos en los oc\u00e9anos Pac\u00edfico, Atl\u00e1ntico e \u00cdndico, y que resulta en, adem\u00e1s de la propia contaminaci\u00f3n y liberaci\u00f3n de qu\u00edmicos o enredos de los animales marinos entre otros, la presencia de micro pl\u00e1sticos en los alimentos de origen marino y, en consecuencia, en la propia cadena alimentaria.<br><br>Por ello, para colaborar en el cuidado del planeta, en el fomento de la concienciaci\u00f3n de esta realidad y participar en las actividades de limpieza de nuestras costas, Mars Gaming destinar\u00e1 el 10% de los beneficios por la venta del MS-ECO a entidades sin \u00e1nimo de lucro que generen acciones inmediatas y duraderas en este objetivo medioambiental como es la Fundaci\u00f3n Ecomar.<br><br><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><ul>  <li>Dimensiones: 91x91x43mm<\/li>  <li>Peso: 222g<\/li>  <li>Tama\u00f1o: Compacto<\/li>  <li>Materiales: Paja de trigo, Bamb\u00fa y materiales reciclados<\/li>  <li>Color: Gris<\/li>  <li>Potencia: 8W<\/li>  <li>Conector: Micro-USB (Alimentaci\u00f3n)<\/li>  <li>Drivers: 1 Activo<\/li>  <li>Rango de frecuencia: 20Hz-20KHz<\/li>  <li>Impedancia: 4&#937;<\/li>  <li>Longitud del cable: 30cm<\/li>  <li>Compatibilidad: Dispositivos Bluetooth<\/li>  <li>Capacidad bater\u00eda: 600mAh<\/li>  <li>Tiempo de funcionamiento: 4-5 horas *El tiempo de uso puede variar dependiendo del volumen, contenido a reproducir y dispositivo<\/li>  <li>Versi\u00f3n Bluetooth: 5.1<\/li>  <li>Distancia de conexi\u00f3n: 10 Metros<\/li>  <li><b>CONTENIDO DE LA CAJA<\/b><\/li>  <li>Altavoz, cable USB-A\/Micro-USB, manual de usuario<\/li><\/ul><br><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0.28,"unit_price":14.84,"unit_price_tax":14.84,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":2,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-alt%20mseco_1.jpg"],"wholesale_price":9.84}}},"8720568100043":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8720568100043",false],"wholesale_price":[39.94,false],"price":[44.94,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 2.3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84700","Cat. IDs: 89,71","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/4d1e53b3ec5facd47fbb66bda4