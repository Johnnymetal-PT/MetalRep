.1,"unit_price":40.33,"unit_price_tax":40.33,"tax_rules_group":null,"category":"Componentes","sub_category":"Fuentes de alimentacion","quantity":0,"brand":"EVGA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_evg-fuente%20100-w1-0600-k2_1.jpg"],"wholesale_price":35.33}}},"4719331305895":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4719331305895",false],"wholesale_price":[156.14,false],"price":[161.14,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.62",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86268","Cat. IDs: 190,99","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/8f10e37c1cb0361cdd22985fb213fc8a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tarjeta Gr\u00e1fica Gigabyte GeForce GTX 1650 OC LP 4G\/ 4GB GDDR5\/ Compatible con Perfil bajo","category":"Componentes","sub_category":"Tarjetas Graficas","unit_price":161.14,"reference":"GV-N1650OC-4GL","ean13":"4719331305895","weight":"0.62","quantity":0,"brand":"GIGABYTE","description_pt":"                                                <p><\/p><h2>GeForce\u00ae GTX 1650 OC de perfil bajo 4G<\/h2><b>SISTEMA DE REFRIGERACI\u00d3N PERSONALIZADO DE GIGABYTE<\/b><br>El sistema de enfriamiento de dise\u00f1o personalizado de GIGABYTE ofrece una capacidad de disipaci\u00f3n de calor efectiva para un mayor rendimiento a temperaturas m\u00e1s bajas.<br><b>DISE\u00d1O DE BAJO PERFIL<\/b><br>El dise\u00f1o de perfil bajo con una longitud de tarjeta de 167 mm ahorra m\u00e1s espacio y se adapta a un sistema delgado o m\u00e1s peque\u00f1o.<br><b>CONECTIVIDAD FLEXIBLE<\/b><br>Equipado con un puerto DVI-D de doble enlace, un puerto DP y un puerto HDMI y admite hasta 3 pantallas.<br><b>EN COMANDO TOTAL<\/b><br>La interfaz de usuario y las funcionalidades reales del software dependen de cada modelo de dispositivo<br><b>MOTOR AORUS<\/b><br>La interfaz intuitiva de vanguardia le permite ajustar la velocidad del reloj, el voltaje, el rendimiento del ventilador y el objetivo de potencia en tiempo real de acuerdo con los requisitos de su juego.<div><br><h2>CONSTRUIDO FUERTE<\/h2><b>ULTRA ENFRIAMIENTO<\/b><br>Los MOSFET de RDS (activado) m\u00e1s bajos est\u00e1n especialmente dise\u00f1ados para producir una resistencia de conmutaci\u00f3n m\u00e1s baja para una carga y descarga de corriente el\u00e9ctrica m\u00e1s r\u00e1pida a temperaturas extremadamente bajas.<br><br><b>P\u00c9RDIDA DE ENERG\u00cdA BAJA<\/b><br>Los estranguladores met\u00e1licos retienen la energ\u00eda mucho m\u00e1s tiempo que los estranguladores de n\u00facleo de hierro comunes a alta frecuencia, por lo que reducen eficazmente la p\u00e9rdida de energ\u00eda del n\u00facleo y la interferencia EMI.<br><br><b>VIDA M\u00c1S LARGA<\/b><br>Los capacitores s\u00f3lidos de ESR m\u00e1s bajos garantizan una mejor conductividad electr\u00f3nica para un excelente rendimiento del sistema y una vida \u00fatil m\u00e1s larga.<p><\/p><p><br><\/p><ul>  <li>    <h2>Especificaciones<\/h2>  <\/li>  <li>Procesamiento de gr\u00e1ficos<\/li>  <li>GeForce\u00ae GTX 1650<\/li>  <li>Reloj de n\u00facleo<\/li>  <li>1695 MHz (tarjeta de referencia: 1665 MHz)<\/li>  <li>N\u00facleos CUDA\u00ae<\/li>  <li>896<\/li>  <li>Reloj de la memoria<\/li>  <li>8002 MHz<\/li>  <li>Tama\u00f1o de la memoria<\/li>  <li>4 GB<\/li>  <li>Tipo de memoria<\/li>  <li>GDDR5<\/li>  <li>Bus de memoria<\/li>  <li>128 bits<\/li>  <li>Ancho de banda de memoria (GB \/ seg)<\/li>  <li>128 GB \/ s<\/li>  <li>Bus de tarjeta<\/li>  <li>PCI-E 3.0 x 16<\/li>  <li>Resoluci\u00f3n m\u00e1xima digital<\/li>  <li>7680x4320 a 60 Hz<\/li>  <li>Vista m\u00faltiple<