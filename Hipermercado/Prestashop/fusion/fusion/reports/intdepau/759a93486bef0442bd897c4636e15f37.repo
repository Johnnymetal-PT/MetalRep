rmeable y resistente a los golpes<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SMARTGYRO","supplier":null,"width":null,"height":null,"depth":null,"weight":0.24,"unit_price":20.65,"unit_price_tax":20.65,"tax_rules_group":null,"category":"Patinetes - Hoverboards","sub_category":"Accesorios para Patinetes","quantity":2,"brand":"SMARTGYRO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_srg-bolsa%20sg27-344_1.jpg"],"wholesale_price":15.65}}},"8435089035223":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435089035223",false],"wholesale_price":[11.74,false],"price":[16.74,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88569","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/4707baffff10314976d603d1c8640528.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Mini Bomba Manual SmartGyro SG27-349","category":"Patinetes - Hoverboards","sub_category":"Accesorios para Patinetes","unit_price":16.740000000000002,"reference":"SG27-349","ean13":"8435089035223","weight":"0.1","quantity":5,"brand":"SMARTGYRO","description_pt":"<p>La mini bomba de aire de smartgyro, es un accesorio imprescindible para tu patinete el\u00e9ctrico o bicicleta. Es ligera, c\u00f3moda y fabricada en aluminio, lo que dar\u00e1 m\u00e1s resistencia al desgaste, humed