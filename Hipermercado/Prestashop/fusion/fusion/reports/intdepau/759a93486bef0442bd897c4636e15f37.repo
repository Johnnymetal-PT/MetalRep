0.27,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Altavoces","quantity":5,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-alt%20msx_1.jpg"],"wholesale_price":15.27}}},"8435693103042":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693103042",false],"wholesale_price":[18.91,false],"price":[23.91,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.45",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88814","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/3c65b7b40974a25db4333a5490722e5e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Gaming con Micr\u00f3fono Mars Gaming MH-GLOW\/ Jack 3.5\/ Rosas","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Auriculares y Microfonos","unit_price":23.91,"reference":"MHGLOWP","ean13":"8435693103042","weight":"0.45","quantity":5,"brand":"MARS GAMING","description_pt":"<h2>AURICULARES GAMING MH-GLOW<\/h2>Iluminaci\u00f3n 360\u00ba CHROMA en la diadema y los laterales del auricular completo, sonido espacial Ultra-BASS 3D y micr\u00f3fono con cancelaci\u00f3n de ruido. Adem\u00e1s son ultraligeros, con cancelaci\u00f3n de ruido pasiva y compatibilidad total multiplataforma.<div><br><div><h2>Auriculares Gaming 360\u00ba CHROMA<\/h2><p>Iluminaci\u00f3n 360\u00ba CHROMA<br>Sonido espacial Ultra-BASS 3D<br>Micr\u00f3fono profesional con cancelaci\u00f3n de ruido<br>PC, Mac, PS4, PS5, Xbox One, Xbox Series X-S, Switch y m\u00e1s<\/p><h2>ILUMINACI\u00d3N 360\u00ba CHROMA<\/h2><p>Espectacular sistema de iluminaci\u00f3n 360\