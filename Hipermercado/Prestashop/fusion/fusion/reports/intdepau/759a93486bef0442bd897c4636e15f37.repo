19",false],"wholesale_price":[34.23,false],"price":[39.23,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.59",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86073","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/98547a2c6aa3ed2564a168063da0c5b8.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Batidora de mano Moulinex Quickchef  2 en 1 DD6578\/ 1000W\/ 10 Velocidades","category":"Cocina","sub_category":"Batidoras","unit_price":39.23,"reference":"DD6578CE","ean13":"8432322492119","weight":"1.59","quantity":0,"brand":"MOULINEX","description_pt":"<p><\/p><h2>Quickchef 2 en 1 DD6578<\/h2><b>\u00a1 Gran potencia, m\u00ednimo esfuerzo !<\/b><br><br><ul>  <li>F\u00c1CIL DE USAR: dial intuitivo con 10 velocidades variables, lo que le permite ajustar la velocidad de manera intuitiva sin detenerse<\/li>  <li>COMODIDAD: un protector antisalpicaduras integrado hace que cocinar sea muy f\u00e1cil con esta batidora de mano<\/li>  <li>CONTROL MEJORADO: el mango suave y antideslizante aumenta la comodidad y el control, incluso cuando las manos est\u00e1n mojadas<\/li>  <li>LIMPIEZA F\u00c1CIL: piezas aptas para lavavajillas para una limpieza sin esfuerzo<\/li>  <li>ACCESORIOS: Mejore su experiencia de licuado con el picador de 500 ml y el vaso de precipitados de 800 ml<\/li><\/ul><h2>Una potente batidora en tus manos<\/h2>Con la batidora Quickchef de Moulinex disfrutar\u00e1s de una potencia \u00f3ptima sin ning\u00fan esfuerzo. Prepara f\u00e1cilmente una gran variedad de platos en un instante gracias al motor de alto rendimiento de 1000 W, y mant\u00e9n siempre el control con las 10 velocidades que pueden regularse con un selector intuitivo y f\u00e1cil de usar sin necesidad de parar la batidora. La protecci\u00f3n antisalpicaduras y el mango antideslizante proporcionan comodidad durante su uso, mientras que las piezas aptas para el lavavajillas facilitan la limpieza. Y por si fuera poco, incluye un vaso medidor de 800 ml, una picadora de 500 ml para picar sin dificultad un amplia variedad de ingredientes y unas varillas para batir sin esfuerzo.<br><br><h2>Caracter\u00edsticas<\/h2><div><p><ul><li>Material del pie Acero inoxidable<\/li><li>N\u00famero de velocidades 10<\/li><li>Funciones Pulse<\/li><li>Funci\u00f3n Turbo<\/li><li>Accesorios&nbsp;<\/li><li>Vaso medidor<\/li><li>Picadora<\/li><li>Dimensiones 14,4 x 25,8 x 25,4 cm<\/li><li>Alimentaci\u00f3n Red<\/li><li>Potencia 1000 W<\/li><\/ul><\/p><br><\/div><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_mou-pae-bat%20dd657810_1.jpg","wholesale_price":"34.23","unit_price_tax":39.23},"product_model":{"product_data":{"ean13":["8432322492119"],"reference":"DD6578CE","name":{"1":"Batidora de mano Moulinex Quickchef  2 en 1 DD6578\/ 1000W\/ 10 Velocidades","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Quickchef 2 en 1 DD6578<\/h2><b>\u00a1 Gran potencia, m\u00ednimo esfuerzo !<\/b><br><br><ul>  <li>F\u00c1CIL DE USAR: dial intuitivo con 10 velocidades variables, lo que le permite ajustar la velocidad de manera intuitiva sin detenerse<\/li>  <li>COMODIDAD: un protector antisalpicaduras integrado hace que cocinar sea muy f\u00e1cil con esta batidora de mano<\/li>  <li>CONTROL MEJORADO: el mango suave y antideslizante aumenta la comodidad y el control, incluso cuando las manos est\u00e1n mojadas<\/li>  <li>LIMPIEZA F\u00c1CIL: piezas aptas para lavavajillas para una limpieza sin esfuerzo<\/li>  <li>ACCESORIOS: Mejore su experiencia de licuado con el picador de 500 ml y el vaso de precipitados de 800 ml<\/li><\/ul><h2>Una potente batidora en tus manos<\/h2>Con la batidora Quickchef 