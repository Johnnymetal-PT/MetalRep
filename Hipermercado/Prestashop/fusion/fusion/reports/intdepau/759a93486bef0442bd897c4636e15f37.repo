gente que permite grabar im\u00e1genes de forma continua en resoluci\u00f3n FHD 1920x1080p a la vez que cuenta con dos LEDS de posici\u00f3n en carretera de alta visibilidad gracias a su lente de 2Mpx y \u00e1ngulo de visi\u00f3n de 80\u00ba.<br><br>Permite tomar fotograf\u00edas, grabar audiio y cuenta con altavoz externo. Memoria de 2Mb interna ampliable mediante tarjetas de memoria (microSD) de hasta 32Gb.<br><br>Bater\u00eda interna de larga duracion de 500mAh recargable mediante conexi\u00f3n USB.<br><br>Incorpora carcasa protectora y accesorios de sujeci\u00f3n a la barra del sill\u00edn de la bici.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Lente 2Mpx<\/li>  <li>Video: 1920x1080p<\/li>  <li>Toma de Fotograf\u00edas<\/li>  <li>Admite microSD<\/li>  <li>Bateria: 500mah<\/li><\/ul><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LEOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":0.12,"unit_price":21.9,"unit_price_tax":21.9,"tax_rules_group":null,"category":"C\u00e1maras","sub_category":"Camaras Digitales","quantity":0,"brand":"LEOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_leo-cam%20bikecam_1.jpg"],"wholesale_price":16.9}}},"7340103401612":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["7340103401612",false],"wholesale_price":[95.62,false],"price":[100.62,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.86",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create 