4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":18,"unit_price":97.66,"unit_price_tax":97.66,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Sillas y Mesas Gaming","quantity":2,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-silla%20mgcxonebr_1.jpg"],"wholesale_price":92.66}}},"8437023094587":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8437023094587",false],"wholesale_price":[14.53,false],"price":[19.53,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.18",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88867","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/77ac3cda6a8e69783388e38aedce1d3c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rat\u00f3n Gaming Mars Gaming MMGLOW\/ Hasta 12800DPI\/ Negro","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ratones","unit_price":19.53,"reference":"MMGLOW","ean13":"8437023094587","weight":"0.18","quantity":5,"brand":"MARS GAMING","description_pt":"                                                <p><\/p><h2>RAT\u00d3N PARA JUEGOS MMGLOW<\/h2>El rat\u00f3n gaming ultraligero m\u00e1s espectacular gracias a su iluminaci\u00f3n CHROMA-GLOW y su cuerpo con acabado espejo. Tambi\u00e9n cuenta con \u00f3ptica avanzada de 12800 DPI, cable Paracord ultraligero, interruptores mec\u00e1nicos Huano y un potente software de control.<br><ul>  <li>Iluminaci\u00f3n CHROMA-GLOW<\/li>  <li>Estructura ultraligera<\/li>  <li>Sensor \u00f3ptico de 12800 ppp<\/li>  <li>cable de paraca\u00eddas<\/li><\/ul><h2>DISE\u00d1O ULTRALIGERO<\/h2><p>La estructura del MMGLOW se aligera al m\u00e1ximo para conseguir un peso de tan solo 75gr, tan r\u00e1pido y ligero que parece flotar sobre la alfombrilla de tu rat\u00f3n pero sin agujeros externos, manteniendo una est\u00e9tica elegante y aerodin\u00e1mica.<\/p><h2>CHROMA-GLOW CON 16,8 MILLONES DE COLORES<\/h2><p>La luz pasa a trav\u00e9s del cuerpo del MMGLOW a trav\u00e9s de su cubierta con acabado de espejo para lograr un efecto asombroso. El avanzado sistema de iluminaci\u00f3n CHROMA-GLOW RGB de MMGLOW presenta hasta 16,8 millones de colores para que elija el estilo que mejor se adapte a su configuraci\u00f3n. A trav\u00e9s de su software descargable, puedes dise\u00f1ar completamente la luz con un completo panel de control que te permite seleccionar tonos, efectos y modos de iluminaci\u00f3n.<\/p><h2>SENSOR \u00d3PTICO 12800 DPI<\/h2><p>Con un sensor \u00f3ptico personalizado A825PRO listo para garantizar una acci\u00f3n extrema y un control excepcional: hasta 12800 DPI para juegos ilimitados. Pero m\u00e1s all\u00e1 de los altos DPI, esta \u00f3ptica ofrece una precisi\u00f3n absoluta en configuraciones bajas de DPI y una tasa de sondeo de hasta 1000 Hz, un rendimiento incomparable con \u00f3pticas m\u00e1s simples.<\/p><h2>INTERRUPTORES MEC\u00c1NICOS HUANO PROGRAMABLES<\/h2><p>El mouse MMGLOW est\u00e1 equipado con interruptores mec\u00e1nicos HUANO de alto rendimiento para garantizar una velocidad total de acci\u00f3n cuando se juega, brindando un control absoluto de cada movimiento en el juego y extendiendo la vida \u00fatil de su dispositivo al m\u00e1ximo. Adem\u00e1s, tienes 2 botones inferiores para adaptar el MMGLOW a tu estilo de juego con facilidad y un interruptor extra para activar o desactivar la iluminaci\u00f3n.<\/p><h2>CABLE CON DISE\u00d1O DE PLUMA PARACORD<\/h2><p>El cable MMGLOW presenta un dise\u00f1o especial de Feather Paracord, dise\u00f1ado para limitar el peso del mouse tanto como sea posible. Gracias a una construcci\u00f3n que ofrece flexibilidad, durabilidad y ligereza, reduce al m\u00ednimo la resistencia para una sensaci\u00f3n de rat\u00f3n inal\u00e1mbrico.<\/p><h2>PERSONALIZA TU EXPERIENCIA<\/h2><p>El software descargable de Mars Gaming le permite personalizar f\u00e1cilmente cada aspecto de su mouse, desde la iluminaci\u00f3n y los efectos LED RGB Chroma hasta diferentes macros programables, as\u00ed como funciones de botones individuales y par\u00e1metros de rendimiento. Dise\u00f1a tu MMGLOW como m\u00e1s te guste, ad\u00e1ptalo a tus necesidades y obt\u00e9n una herramienta profesional a la medida de tus necesidades.<\/p><p><br><\/p><ul>  <li>    <h2>ESPECIFICACIONES T\u00c9CNICAS<\/h2>  <\/li>  <li>Interruptores<\/li>  <li>HUANO<\/li>  <li>Peso<\/li>  <li>75\u00b15g<\/li>  <li>Dimensiones<\/li>  <li>122x67x38mm<\/li>  <li>Ergonom\u00eda<\/li>  <li>Correcto<\/li>  <li>Botones<\/li>  <li>7<\/li>  <li>Encendiendo<\/li>  <li>Resplandor crom\u00e1tico RGB<\/li>  <li>Terminar<\/li>  <li>Brillante<\/li>  <li>Extras<\/li>  <li>Cable ultraflexible<\/li>  <li>Sensor<\/li>  <li>Instant\u00e1nea \u00f3ptica A825<\/li>  <li>ppp<\/li>  <li>12800<\/li>  <li>Tasa de sondeo<\/li>  <li>1000 Hz<\/li>  <li>m\u00e1x. velocidad<\/li>  <li>60 IPS<\/li>  <li>m\u00e1x. aceleraci\u00f3n<\/li>  <li>20G<\/li>  <li>Tipo de alambre<\/li>  <li>Cable trenzado ultraflexible<\/li>  <li>Longitud de cable<\/li>  <li>1,7 m<\/li>  <li>Conectores<\/li>  <li>USB chapado en oro<\/li>  <li>Software<\/li>  <li>Control de funciones, macros, iluminaci\u00f3n y rendimiento (solo Windows)<\/li>  <li>Compatibilidad<\/li>  <li>Windows, Linux, Mac, PS4, PS5, XBOX ONE, XBOX SERIE XS<\/li>  <li>AC\/DC<\/li>  <li>100mA<\/li>  <li>Voltaje<\/li>  <li>CC 5V<\/li><\/ul><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-mou%20mmglow%20bk_1.jpg","wholesale_price":"14.53","unit_price_tax":19.53},"product_model":{"product_data":{"ean13":["8437023094587"],"reference":"MMGLOW","name":{"1":"Rat\u00f3n Gaming Mars Gaming MMGLOW\/ Hasta 12800DPI\/ Negro","2":"","3":"","4":""},"description":{"1":"                                                <p><\/p><h2>RAT\u00d3N PARA JUEGOS MMGLOW<\/h2>El rat\u00f3n gaming ultraligero m\u00e1s espectacular gracias a su iluminaci\u00f3n CHROMA-GLOW y su cuerpo con acabado espejo. Tambi\u00e9n cuenta con \u00f3ptica avanzada de 12800 DPI, cable Paracord ultraligero, interruptores mec\u00e1nicos Huano y un potente software de control.<br><ul>  <li>Iluminaci\u00f3n CHROMA-GLOW<\/li>  <li>Estructura ultraligera<\/li>  <li>Sensor \u00f3ptico de 12800 ppp<\/li>  <li>cable de paraca\u00eddas<\/li><\/ul><h2>DISE\u00d1O ULTRALIGERO<\/h2><p>La estructura del MMGLOW se aligera al m\u00e1ximo para conseguir un peso de tan solo 75gr, tan r\u00e1pido y ligero que parece flotar sobre la alfombrilla de tu rat\u00f3n pero sin agujeros externos, manteniendo una est\u00e9tica elegante y aerodin\u00e1mica.<\/p><h2>CHROMA-GLOW CON 16,8 MILLONES DE COLORES<\/h2><p>La luz pasa a trav\u00e9s del cuerpo del MMGLOW a trav\u00e9s de su cubierta con acabado de espejo para lograr un efecto asombroso. El avanzado sistema de iluminaci\u00f3n CHROMA-GLOW RGB de MMGLOW presenta hasta 16,8 millones de colores para que elija el estilo que mejor se adapte a su configuraci\u00f3n. A trav\u00e9s de su software descargable, puedes dise\u00f1ar completamente la luz con un completo panel de control que te permite seleccionar tonos, efectos y modos de iluminaci\u00f3n.<\/p><h2>SENSOR \u00d3PTICO 12800 DPI<\/h2><p>Con un sensor \u00f3ptico personalizado A825PRO listo para garantizar una acci\u00f3n extrema y un control excepcional: hasta 12800 DPI para juegos ilimitados. Pero m\u00e1s all\u00e1 de los altos DPI, esta \u00f3ptica ofrece una precisi\u00f3n absoluta en configuraciones bajas de DPI y una tasa de sondeo de hasta 1000 Hz, un rendimiento incomparable con \u00f3pticas m\u00e1s simples.<\/p><h2>INTERRUPTORES MEC\u00c1NICOS HUANO PROGRAMABLES<\/h2><p>El mouse MMGLOW est\u00e1 equipado con interruptores mec\u00e1nicos HUANO de alto rendimiento para garantizar una velocidad total de acci\u00f3n cuando se juega, brindando un control absoluto de cada movimiento en el juego y extendiendo la vida \u00fatil de su dispositivo al m\u00e1ximo. Adem\u00e1s, tienes 2 botones inferiores para adaptar el MMGLOW a tu estilo de juego con facilidad y un interruptor extra para activar o desactivar la iluminaci\u00f3n.<\/p><h2>CABLE CON DISE\u00d1O DE PLUMA PARACORD<\/h2><p>El cable MMGLOW presenta un dise\u00f1o especial de Feather Paracord, dise\u00f1ado para limitar el peso del mouse tanto como sea posible. Gracias a una construcci\u00f3n que ofrece flexibilidad, durabilidad y ligereza, reduce al m\u00ednimo la resistencia para una sensaci\u00f3n de rat\u00f3n inal\u00e1mbrico.<\/p><h2>PERSONALIZA TU EXPERIENCIA<\/h2><p>El software descargable de Mars Gaming le permite personalizar f\u00e1cilmente cada aspecto de su mouse, desde la iluminaci\u00f3n y los efectos LED RGB Chroma hasta diferentes macros programables, as\u00ed como funciones de botones individuales y par\u00e1metros de rendimiento. Dise\u00f1a tu MMGLOW como m\u00e1s te guste, ad\u00e1ptalo a tus necesidades y obt\u00e9n una herramienta profesional a la medida de tus necesidades.<\/p><p><br><\/p><ul>  <li>    <h2>ESPECIFICACIONES T\u00c9CNICAS<\/h2>  <\/li>  <li>Interruptores<\/li>  <li>HUANO<\/li>  <li>Peso<\/li>  <li>75\u00b15g<\/li>  <li>Dimensiones<\/li>  <li>122x67x38mm<\/li>  <li>Ergonom\u00eda<\/li>  <li>Correcto<\/li>  <li>Botones<\/li>  <li>7<\/li>  <li>Encendiendo<\/li>  <li>Resplandor crom\u00e1tico RGB<\/li>  <li>Terminar<\/li>  <li>Brillan