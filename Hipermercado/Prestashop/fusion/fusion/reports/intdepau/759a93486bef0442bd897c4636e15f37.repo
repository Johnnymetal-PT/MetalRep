":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHILIPS","supplier":null,"width":null,"height":null,"depth":null,"weight":17.2,"unit_price":480.39,"unit_price_tax":480.39,"tax_rules_group":null,"category":"Television","sub_category":"Televisor hasta 50 pulgadas","quantity":2,"brand":"PHILIPS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-tv%2050pus8507_1.jpg"],"wholesale_price":475.39}}},"8718863033920":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8718863033920",false],"wholesale_price":[410.55,false],"price":[415.55,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Philips TV 55PUS8007 55&#39;\/ Ultra HD 4K\/ Ambilight\/ Smart TV\/ WiFi"],"result":false},"feed_data":{"name_pt":"Televisor Philips 55PUS8007 55'\/ Ultra HD 4K\/ Ambilight\/ Smart TV\/ WiFi","category":"Television","sub_category":"Televisor hasta 55 pulgadas","unit_price":415.55,"reference":"55PUS8007\/12","ean13":"8718863033920","weight":"17.9","quantity":2,"brand":"PHILIPS","description_pt":"<p><\/p><h2>Sencillo. Inteligente. Atractivo.<\/h2>Disfruta de una imagen n\u00edtida y viva, adem\u00e1s del sonido Dolby Atmos y juegos fluidos. Este Android TV es la soluci\u00f3n perfecta cuando quieres que todo se vea y suene bien. Ambilight hace que todo lo que veas o juegues sea a\u00fan m\u00e1s envolvente.<br><br><h2>Ambilight m\u00e1gico. Solo con Philips.<\/h2>Gracias a Philips Ambilight, la incre\u00edble experiencia de ver un televisor Philips es a\u00fan mayor. Las luces LED alrededor del borde del televisor brillan y cambian de color en perfecta sincron\u00eda con los colores de la acci\u00f3n en pantalla o de la m\u00fasica. Es tan c\u00e1lido y envolvente que te preguntar\u00e1s c\u00f3mo has podido disfrutar de la televisi\u00f3n sin \u00e9l.<br><br><h2>Visualizaci\u00f3n vibrante. TV LED 4K UHD de Philips.<\/h2>Te encantar\u00e1 todo lo que veas en este TV LED 4K UHD. El motor Pixel Precise Ultra HD de Philips optimiza la calidad de imagen para ofrecer im\u00e1genes n\u00edtidas, colores ricos y movimientos suaves. Siempre disfrutar\u00e1s de la mejor experiencia visual posible.<br><br><h2>Visi\u00f3n y sonido cinematogr\u00e1ficos. Dolby Vision y Dolby Atmos.<\/h2>Gracias a la incorporaci\u00f3n de Dolby Vision y Dolby Atmos, tus pel\u00edculas, programas y juegos se ven y suenan incre\u00edbles. Ver\u00e1s la imagen que el director quer\u00eda que vieras: \u00a1se acabaron las escenas decepcionantes demasiado oscuras para distinguirlas! Escucha cada palabra con claridad y disfruta de los efectos de sonido como si realmente estuvieran ocurriendo a tu alrededor.<br><br><h2>Sencillamente inteligente. Android TV.<\/h2>Tu Android TV de Philips te ofrece el contenido que quieres cuando lo quieres. Puedes personalizar la pantalla de inicio para mostrar tus aplicaciones favoritas, lo que te facilitar\u00e1 la reproducci\u00f3n de las pel\u00edculas y los programas que te encantan. Tambi\u00e9n puedes reproducirlos desde donde los dejaste.<br><br><h2>Control por voz. Compatible con el Asistente de Google.<\/h2>Puedes utilizar tu voz para controlar tu Android TV de Philips a trav\u00e9s de cualquier altavoz que incorpore el Asistente de Google o mediante una aplicaci\u00f3n de mando a distancia para Android TV. \u00bfQuieres buscar aplicaciones, transmitir contenido o jugar a juegos? Solo tienes que pedirlo.<br><br><h2>Televisor elegante preparado para el futuro.<\/h2>\u00bfBuscas un televisor que se adapte a tu sala? La pantalla pr\u00e1cticamente sin bisel de este Smart TV 4K es perfecta para todo tipo de interiores, y la base compacta en color negro mate hace que parezca que la pantalla est\u00e1 flotando. Nuestros embalajes y folletos adjuntos utilizan papel y cart\u00f3n reciclado.<br><br><h2>Ideal para jugar. Tiempo de latencia bajo en cualquier consola.<\/h2>Tu televisor Philips te permite sacar el m\u00e1ximo partido a tu consola, con una experiencia de juego r\u00e1pida y unos gr\u00e1ficos fluidos. La conectividad HDMI compatible con VRR y el ajuste de baja latencia se activan autom\u00e1ticamente al encender la consola. El modo de juego de Ambilight te sumerge a\u00fan m\u00e1s en la acci\u00f3n.<br><br><ul>  <li><b>Ambilight<\/b><\/li>  <li>Versi\u00f3n Ambilight<\/li>  <li>3 lados<\/li>  <li>Funciones Ambilight<\/li>  <li>Ambilight integrado<\/li>  <li>Modo de juego<\/li>  <li>Modo Lounge light<\/li>  <li>Adaptable al color de la pared<\/li>  <li><b>Imagen\/Pantalla<\/b><\/li>  <li>Pantalla<\/li>  <li>LED 4K Ultra HD<\/li>  <li>Tama\u00f1o diagonal de pantalla (m\u00e9trico)<\/li>  <li>139&nbsp; cm<\/li>  <li>Resoluci\u00f3n de pantalla<\/li>  <li>3840 x 2160<\/li>  <li>Frecuencia de actualizaci\u00f3n nativa<\/li>  <li>60&nbsp; Hz<\/li>  <li>Motor Pixel<\/li>  <li>Pixel Precise Ultra HD<\/li>  <li>Mejora de la imagen<\/li>  <li>Dolby Vision<\/li>  <li>HLG (Hybrid Log Gamma)<\/li>  <li>Compatible con HDR10+<\/li>  <li>Relaci\u00f3n de aspecto<\/li>  <li>16:9<\/li>  <li><b>Resoluci\u00f3n de pantalla compatible<\/b><\/li>  <li>Entradas de ordenador en todas las conexiones HDMI<\/li>  <li>4K UHD de hasta 3840 x 2160 a 60 Hz<\/li>  <li>Compatible con HDR, HDR10\/HLG<\/li>  <li>Entradas de v\u00eddeo en todas las conexiones HDMI<\/li>  <li>Hasta 4K UHD de 3840 x 2160 a 60 Hz<\/li>  <li>Compatible con HDR<\/li>  <li>HDR10\/HLG (Hybrid Log Gamma)<\/li>  <li><b>Android TV<\/b><\/li>  <li>Sistema operativo<\/li>  <li>Android TV&#8482; 11 (R)<\/li>  <li>Tama\u00f1o de la memoria (Flash)<\/li>  <li>16 GB*<\/l