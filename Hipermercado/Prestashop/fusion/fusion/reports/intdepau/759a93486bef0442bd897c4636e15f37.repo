rt_sog-aur%20pro-nh5_1.jpg"],"wholesale_price":8.89}}},"3700104445338":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3700104445338",false],"wholesale_price":[12.36,false],"price":[17.36,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.26",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88797","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/4cb8887c626176aa51c51f865a8891dd.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rat\u00f3n Gaming Spirit of Gamer PRO-M7\/ Hasta 4800 DPI","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ratones","unit_price":17.36,"reference":"S-PM7","ean13":"3700104445338","weight":"0.26","quantity":5,"brand":"SPIRIT","description_pt":"<h2><span style='background-color: initial;'>PERSONALIZA TU PRO-M7 A TU ESTILO DE JUEGO&nbsp;<\/span><\/h2><div><span style='background-color: initial;'>Sus 7 botones programables te permiten ajustar tus teclas seg\u00fan el estilo de juego. Recarga, regresa, cambia armas ... El software PRO-M7 (descargable en l\u00ednea) le permitir\u00e1 configurar los botones del mouse.<\/span><\/div><h2><span style='background-color: initial;'>DISE\u00d1O<\/span><\/h2><div><span style='background-color: initial;'>La comodidad realizada en SPIRIT OF GAMER y su doble GripControl le garantizar\u00e1n la m\u00e1xima comodidad. La luz de fondo RGB con 11 modos (RAINBOW, WAVE ...) te permitir\u00e1 jugar d\u00eda y noche. Sus almohadillas de tefl\u00f3n antideslizantes permitir\u00e1n un deslizamiento perfecto de su mouse.<\/span><br><\/div><h2><span style='background-color: initial;'>R\u00c1PIDO Y EFICIENTE<\/span><\/h2><div><span style='background-color: initial;'>Gracias a su bot\u00f3n central, puede personalizar su DPI (hasta 4800 DPI). Ajuste la velocidad de su mouse a su gusto. Estar en medio de una batalla donde la velocidad est\u00e1 a la orden del d\u00eda o en modo francotirador con una sensibilidad m\u00e1s precisa y efectiva para garantizar KILL y SKILL!<\/span><\/div><h2><span style='background-color: initial;'>ENCHUFE Y JUEGA<\/span><\/h2><div><span style='background-color: initial;'>Gracias a su cable anti-enredo trenzado de nylon de 1.70m y al conector USB, \u00a1conecte su mouse y juegue durante horas!<\/span><\/div><div><br><\/div><ul>\t<li><h2>INTERFACE: <\/h2><\/li>\t<li>USB 2.0 Plug and Fight<\/li>\t<li><h2>ERGONOM\u00cdA: <\/h2><\/li>\t<li>7 botones \/ Rueda desplazamiento \/ almohadillas antideslizantes<\/li>\t<li><h2>GAMING ARENA<\/h2><\/li>\t<li>Bot\u00f3n programable hasta 3 perfiles<\/li>\t<li>Retroiluminaci\u00f3n LED RGB personalizable<\/li>\t<li>11 efectos preestablecidos<\/li>\t<li>Cambio de resoluci\u00f3n hasta 4800DPI<\/li>\t<li>Macro Configuraci\u00f3n avanzada de software, caracter\u00edsticas, controles ...<\/li>\t<li>Sensor \u00f3ptico alta definici\u00f3n<\/li>\t<li><h2>DISE\u00d1O<\/h2><\/li>\t<li>Dimensiones 12.9 x 7.3 x 4.4 cm<\/li>\t<li>peso 120g<\/li>\t<li>Material (es) Pl\u00e1stico ABS de alta densidad<\/li>\t<li>patr\u00f3n de cr\u00e1neo<\/li>\t<li>Color principal negro<\/li>\t<li>Longitud del cable 1.70<\/li>\t<li><h2>COMPATIBILIDAD E INSTALACI\u00d3N<\/h2><\/li>\t<li>Sistema operativo (s) compatibles con Windows XP a Windows 10<\/li><\/ul>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sog-mou%20pro-m7_1.jpg","wholesale_price":"12.36","unit_price_tax":17.36},"product_model":{"product_data":{"ean13":["3700104445338"],"reference":"S-PM7","name":{"1":"Rat\u00f3n Gaming Spirit of Gamer PRO-M7\/ Hasta 4800 DPI","2":"","3":"","4":""},"description":{"1":"<h2><span style='background-color: initial;'>PERSONALIZA TU PRO-M7 A TU ESTILO DE JUEGO&nbsp;<\/span><\/h2><div><span style='background-color: initial;'>Sus 7 botones programables te permiten ajustar tus teclas seg\u00fan el estilo de juego. Recarga, regresa, cambia armas ... El software PRO-M7 (descargable en l\u00ednea) le permitir\u00e1 configurar los botones del mouse.<\/span><\/div><h2><span style='background-color: initial;'>DISE\u00d1O<\/span><\/h2><div><span style='background-color: initial;'>La comodidad realizada en SPIRIT OF GAMER y su doble GripControl le garantizar\u00e1n la m\u00e1xima comodidad. La luz de fondo RGB con 11 modos (RAINBOW, WAVE ...) te permitir\u00e1 jugar d\u00eda y noche. Sus almohadillas de tefl\u00f3n antideslizantes permitir\u00e1n un deslizamiento perfecto de su mouse.<\/span><br><\/div><h2><span style='background-color: initial;'>R\u00c1PIDO Y EFICIENTE<\/span><\/h2><div><span style='background-color: initial;'>Gracias a su bot\u00f3n central, puede personalizar su DPI (hasta 4800 DPI). Ajuste la velocidad de su mouse a su gusto. Estar en medio de una batalla donde la velocidad est\u00e1 a la orden del d\u00eda o en modo francotirador con una sensibilidad m\u00e1s precisa y efectiva para garantizar KILL y SKILL!<\/span><\/div><h2><span style='background-color: initial;'>ENCHUFE Y JUEGA<\/span><\/h2><div><span style='background-color: initial;'>Gracias a su cable anti-enredo trenzado de nylon de 1.70m y al conector USB, \u00a1conecte su mouse y juegue durante horas!<\/span><\/div><div><br><\/div><ul>\t<li><h2>INTERFACE: <\/h2><\/li>\t<li>USB 2.0 Plug and Fight<\/li>\t<li><h2>ERGONOM\u00cdA: <\/h2><\/li>\t<li>7 botones \/ Rueda desplazamiento \/ almohadillas antideslizantes<\/li>\t<li><h2>GAMING ARENA<\/h2><\/li>\t<li>Bot\u00f3n programable hasta 3 perfiles<\/li>\t<li>Retroiluminaci\u00f3n LED RGB personalizable<\/li>\t<li>11 efectos preestablecidos<\/li>\t<li>Cambio de resoluci\u00f3n hasta 4800DPI<\/li>\t<li>Macro Configuraci\u00f3n avanzada de software, caracter\u00edsticas, controles ...<\/li>\t<li>Sensor \u00f3ptico alta definici\u00f3n<\/li>\t<li><h2>DISE\u00d1O<\/h2><\/li>\t<li>Dimensiones 12.9 x 7.3 x 4.4 cm<\/li>\t<li>peso 120g<\/li>\t<li>Material (es) Pl\u00e1stico ABS de alta densidad<\/li>\t<li>patr\u00f3n de cr\u00e1neo<\/li>\t<li>Color principal negro<\/li>\t<li>Longitud del cable 1.70<\/li>\t<li><h2>COMPATIBILIDAD E INSTALACI\u00d3N<\/h2><\/li>\t<li>Sistema operativo (s) compatibles con Windows XP a Windows 10<\/li><\/ul>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SPIRIT","supplier":null,"width":null,"height":null,"depth":null,"weight":0.26,"unit_price":17.36,"unit_price_tax":17.36,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ratones","quantity":5,"brand":"SPIRIT","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sog-mou%20pro-m7_1.jpg"],"wholesale_price":12.36}}},"3700104445963":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3700104445963",false],"wholesale_price":[16.46,false],"price":[21.46,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.29",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88798","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/65079e6892d156762a692dec76713a50.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rat\u00f3n Gaming Inal\u00e1mbrico Spirit of Gamer ELITE M70\/ Bater\u00eda Recargable\/ Hasta 4800 DPI","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ratones","unit_price":21.46,"reference":"S-EM70RF","ean13":"3700104445963","weight":"0.29","quantity":5,"brand":"SPIRIT","description_pt":"<p><h2>Rat\u00f3n ELITE M70<\/h2><b>LUCHEMOS JUNTOS <\/b><br>Rat\u00f3n inal\u00e1mbrico equipado con un sensor PixArt 3312, ELITE M70 ofrece una resoluci\u00f3n de hasta 4800 DPI, una aceleraci\u00f3n de 10G, una velocidad de movimiento de hasta 30 ips, una tasa de sondeo personalizable de 1000 Hz... Con sus interruptores Huano, el ELITE El mouse inal\u00e1mbrico M70 brinda la precisi\u00f3n que necesita, ideal para cualquier estilo de juego.<br><br><b>\u00a1LIBERTAD! ELITE M70 es inal\u00e1mbrico. <\/b><br>Enchufe el nano receptor USB para uso gratuito. Con su bater\u00eda de litio de 600 mAh de capacidad, ELITE M70 ofrece una c\u00f3moda autonom\u00eda y se recarga en tan solo 4 horas. ELITE M70 es h\u00edbrido y tambi\u00e9n ofrece la posibilidad de conexi\u00f3n por cable con el cable incluido.<br><br><b>FLARE GUN: ELITE M70 <\/b><br>ofrece no menos de 8 botones programables, incluido un bot\u00f3n RapidFire para aumentar su potencia de fuego o un bot\u00f3n Sniper para reducir el nivel de resoluci\u00f3n al m\u00ednimo. <br><br><b>SOFTWARE COMPLETO E INTUITIVO <\/b><br>Los botones son programables a trav\u00e9s del software descargable en l\u00ednea. As\u00ed podr\u00e1s gestionar hasta 4 perfiles diferentes, crear tus macros gracias a su potente editor, personalizar DPI y retroiluminaci\u00f3n... <br><br><b>DEDICADO A LA LUZ <\/b><br>Elija uno de los 5 efectos preestablecidos para darle a su configuraci\u00f3n un estilo \u00fanico. Y desde el software tambi\u00e9n ajusta el brillo, la velocidad, los efectos: depende de ti jugar y personalizar todo de forma r\u00e1pida y sencilla. <br><br><h2>CARACTER\u00cdSTICAS<\/h2><ul>  <li>Ergon\u00f3mico: agarre ideal<\/li>  <li><b>INTERFAZ<\/b><\/li>  <li>Modelo inal\u00e1mbrico&nbsp; <\/li>  <li>Distancia de funcionamiento: 6 a 10 metros<\/li>  <li>Bater\u00eda recargable 600 mAh<\/li>  <li>Tiempo de carga: 3 a 4 horas<\/li>  <li><b>SENSOR<\/b><\/li>  <li>Tipo de sensor&nbsp; <\/li>  <li>PixArt PAW3312 \u00d3ptica HD<\/li>  <li>Resoluci\u00f3n M\u00e1xima&nbsp; <\/li>  <li>Resoluci\u00f3n m\u00e1xima 4800<\/li>  <li>DPI DPI personalizable: 4 niveles<\/li>  <li><b>GAMING<\/b><\/li>  <li>Bot\u00f3n programable&nbsp; <\/li>  <li>8 botones, incluyendo 1 fuego especial<\/li>  <li>Aceleraci\u00f3n&nbsp; 10G<\/li>  <li>Ilumina desde el fondo&nbsp; <\/li>  <li>Efectos preestablecidos RGB 5<\/li>  <li><b>DISE\u00d1O<\/b><\/li>  <li>Dimensiones&nbsp; <\/li>  <li>12,9x8x4,1 cm<\/li>  <li>Peso&nbsp; <\/li>  <li>118g<\/li>  <li><b>COMPATIBILIDAD E INSTALACI\u00d3N<\/b><\/li>  <li>PC equipado con un puerto USB<\/li>  <li>Sistemas operativos compatibles&nbsp; <\/li>  <li>Windows\u00ae XP a Windows\u00ae 10<\/li>  <li><b>Contenidos del paquete&nbsp; <\/b><\/li>  <li>ELITE M70<\/li>  <li>Nano Mouse Receptor<\/li>  <li>Cable de carga<\/li>  <li>Gu\u00eda de instalaci\u00f3n r\u00e1pida<\/li>  <li>Software descargable<\/li><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sog-mou%20elite%20m70_1.jpg","wholesale_price":"16.46","unit_price_tax":21.46},"product_model":{"product_data":{"ean13":["3700104445963"],"reference":"S-EM70RF","name":{"1":"Rat\u00f3n Gaming Inal\u00e1mbrico Spirit of Gamer ELITE M70\/ Bater\u00eda Recargable\/ Hasta 4800 DPI","2":"","3":"","4":""},"description":{"1":"<p><h2>Rat\u00f3n ELITE M70<\/h2><b>LUCHEMOS JUNTOS <\/b><br>Rat\u00f3n inal\u00e1mbrico equipado con un sensor PixArt 3312, ELITE M70 ofrece una resoluci\u00f3n de hasta 4800 DPI, una aceleraci\u00f3n de 10G, una velocidad de movimiento de hasta 30 ips, una tasa de sondeo personalizable de 1000 Hz... Con sus interruptores Huano, el ELITE El mouse inal\u00e1mbrico M70 brinda la precisi\u00f3n que necesita, ideal para cualquier estilo de juego.<br><br><b>\u00a1LIBER