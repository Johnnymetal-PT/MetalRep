te de 64 bytes)<\/li>  <li>Tramas gigantes: 12 KB<\/li>  <li>Caracter\u00edsticas especiales&nbsp; <\/li>  <li>Montable en la pared<\/li>  <li><b>Potencia<\/b> &nbsp; <\/li>  <li>Entrada: 100 - 240 V CA, 50\/60 Hz, 0,5 A<\/li>  <li>Salida: adaptador de alimentaci\u00f3n externo de 12 V CC, 1 A<\/li>  <li>Max. Consumo: 9.5<\/li>  <li><b>MTBF<\/b>&nbsp; <\/li>  <li>674,176 horas<\/li>  <li><b>Temperatura de funcionamiento<\/b>&nbsp; <\/li>  <li>0 \u00b0 - 40 \u00b0 C (32 \u00b0 - 104 \u00b0 F)<\/li>  <li><b>Humedad de funcionamiento<\/b>&nbsp; <\/li>  <li>Max. 90% sin condensaci\u00f3n<\/li>  <li><b>Dimensiones (L x An x Al)<\/b>&nbsp; <\/li>  <li>160 x 25 x 109 mm  <\/li><li><b>Peso&nbsp;<\/b>&nbsp; <\/li>  <li>414 g  <\/li><li><b>Certificaciones<\/b>&nbsp; <\/li>  <li>FCC<\/li>  <li>CE<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRENDNET","supplier":null,"width":null,"height":null,"depth":null,"weight":0.74,"unit_price":107.08,"unit_price_tax":107.08,"tax_rules_group":null,"category":"Conectividad","sub_category":"Switchs","quantity":2,"brand":"TRENDNET","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_trn-switch%20teg-s350_1.jpg"],"wholesale_price":102.08}}},"0710931140774":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0710931140774",false],"wholesale_price":[12.82,false],"price":[17.82,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.82",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86804","Cat. IDs: 195,193","Asso