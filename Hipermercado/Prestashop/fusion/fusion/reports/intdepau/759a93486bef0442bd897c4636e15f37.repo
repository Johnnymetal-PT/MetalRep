"3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BRAUN","supplier":null,"width":null,"height":null,"depth":null,"weight":0.47,"unit_price":29.42,"unit_price_tax":29.42,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Afeitadoras","quantity":5,"brand":"BRAUN","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-pae-afe%20mgk%205255_1.jpg"],"wholesale_price":24.42}}},"4210201649946":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4210201649946",false],"wholesale_price":[18.03,false],"price":[23.03,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.19",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:87502","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/a29b27ce857669f423c0d53f4693e0b0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Afeitadora Braun MobileShave M90\/ a Pilas","category":"Cuidado Personal","sub_category":"Afeitadoras","unit_price":23.03,"reference":"M90","ean13":"4210201649946","weight":"0.19","quantity":5,"brand":"BRAUN","description_pt":"<p><h2>Afeitadora Braun MobileShave M-90 con tapa giratoria<\/h2>Braun MobileShave. Afeitarse sobre la marcha. Ya no le temes a la sombra de las cinco en punto. El Braun MobileShave cuenta con un recortador de cabello largo deslizable, f\u00e1cil para cabello m\u00e1s largo, para que pueda mantener el bigote y las patillas en buen estado, donde quiera que est\u00e9. Braun MobileShave es completamente lavable con agua corriente. As\u00ed que la limpieza f\u00e1cil sigue al afeitado f\u00e1cil.<\/p><p><h2>Piel suave en cualquier momento y lugar.<\/h2>En el trabajo, en el coche o incluso en una escapada:<br>con la Braun MobileShave conseguir un look fresco y reci\u00e9n afeitado es f\u00e1cil y c\u00f3modo, cu\u00e1ndo y d\u00f3nde desees.<br><b>Recortadora de precisi\u00f3n<\/b><br>Para dar forma al bigote y las patillas<br><b>SmartFoil<\/b><br>El patr\u00f3n \u00fanico de la l\u00e1mina captura los pelos que crecen en diferentes direcciones.<br><b>Twist cap<\/b><br>Protecci\u00f3n eficiente con un simple giro.<\/p><p><h2>SmartFoil flexible: muy suave con la piel.<\/h2>La l\u00e1mina flexible extraancha y extrafina se adapta a los contornos del rostro para ofrecerte una afeitada al ras y c\u00f3moda.<\/p><p><h2>Totalmente lavable.<\/h2>La Braun MobileShave es totalmente lavable debajo del grifo. As\u00ed, al afeitado f\u00e1cil le sigue una limpieza f\u00e1cil.<\/p><p><h2>Deslice hacia fuera para recortar.<\/h2>El Braun MobileShave cuenta con un cortador de cabello largo deslizable para un cabello m\u00e1s largo, para que pueda mantener el bigote y las patillas en buen estado, donde sea que est\u00e9 (solo M-90).<\/p><p><h2>No necesita enchufes.<\/h2>Alimentado con bater\u00edas f\u00e1cilmente reemplazables, Braun MobileShave est\u00e1 listo para afeitarse donde sea que est\u00e9s.<\/p><p><h2>Caracteristicas<\/h2><ul>  <li>Afeitadora funcionamiento con 2 pilas AA. 60 minutos de carga<\/li>  <li>L\u00e1mina extra ancha y flexible para un afeitado apurado y c\u00f3modo.<\/li>  <li>MobileShave es completamente lavable bajo agua corriente.<\/li>  <li>Apta para afeitado en seco en viajes y en movimiento.<\/li>  <li>Recortadora de precisi\u00f3n.<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-pae-afe%20mobileshave%20m90_1.jpg","wholesale_price":"18.03","unit_price_tax":23.03},"product_model":{"product_data":{"ea