 certificadas garantizan estabilidad y comodidad.<\/p><ul>  <li><b>Dise\u00f1o y conectividad<\/b><\/li>  <li>Estilo de uso<\/li>  <li>Intraauriculares con cable<\/li>  <li>Tipo de conectividad<\/li>  <li>Solo Bluetooth<\/li>  <li>Versi\u00f3n de Bluetooth<\/li>  <li>5.0<\/li>  <li>Alcance de recepci\u00f3n<\/li>  <li>10M<\/li>  <li><b>Sonido<\/b><\/li>  <li>Respuesta en frecuencia (Hz)<\/li>  <li>10 - 22K<\/li>  <li>Sensibilidad (dB)<\/li>  <li>100dB<\/li>  <li>Tama\u00f1o del altavoz (mm)<\/li>  <li>6mm<\/li>  <li><b>Comodidad<\/b><\/li>  <li>Tipo de control<\/li>  <li>Control integrado<\/li>  <li>Funcionalidad de control<\/li>  <li>Responder\/rechazar llamadas, reproducir\/pausar m\u00fasica, cambiar de pista, cambiar entre la m\u00fasica y las llamadas<\/li>  <li>Carga inal\u00e1mbrica<\/li>  <li>S\u00ed<\/li>  <li>Cancelaci\u00f3n de eco, llamadas n\u00edtidas<\/li>  <li>S\u00ed<\/li>  <li><b>Potencia<\/b><\/li>  <li>Tiempo de reproducci\u00f3n de m\u00fasica<\/li>  <li>6.5 horas en el auricular, 4 cargas adicionales (26.5 horas) en el estuche = 26 horas<\/li>  <li>Tiempo de carga r\u00e1pida<\/li>  <li>15 min para 1 hora de escucha<\/li>  <li>Tiempo hasta carga completa<\/li>  <li>2 horas<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TCL","supplier":null,"width":null,"height":null,"depth":null,"weight":0.15,"unit_price":30.99,"unit_price_tax":30.99,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares Bluetooth con estuche de carga","quantity":5,"brand":"TCL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tcl-aur%20actv500tws%20gy_1.jpg"],"wholesale_price":25.99}}},"4894461903866":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"e