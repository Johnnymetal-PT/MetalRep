":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRUST","supplier":null,"width":null,"height":null,"depth":null,"weight":0.22,"unit_price":33.78,"unit_price_tax":33.78,"tax_rules_group":null,"category":"Ratones","sub_category":"Ratones","quantity":5,"brand":"TRUST","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-mou%2023507_1.jpg"],"wholesale_price":28.78}}},"8713439236507":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8713439236507",false],"wholesale_price":[8.31,false],"price":[13.31,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.16",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:89108","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/879c480842b1dea53416a9f9ccec52e3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rat\u00f3n Trust Voca\/ Hasta 2400 DPI","category":"Ratones","sub_category":"Ratones","unit_price":13.31,"reference":"23650","ean13":"8713439236507","weight":"0.16","quantity":5,"brand":"TRUST","description_pt":"                                                <p><\/p><h2>Comodidad y personalizaci\u00f3n<\/h2>Con un dise\u00f1o c\u00f3modo y cuatro ajustes de velocidad diferentes, el rat\u00f3n Voca Comfortable de Trust combina facilidad de uso con personalizaci\u00f3n. Gracias a una sencilla instalaci\u00f3n plug-and-play, el rat\u00f3n estar\u00e1 operativo de inmediato.<br><h2>R\u00e1pido y preciso<\/h2>El rat\u00f3n tiene cuatro ajustes de ppp, que van desde 800 a 2400. Con una pulsaci\u00f3n r\u00e1pida del bot\u00f3n puedes ajustar la velocidad de movimiento para que coincida con tus preferencias personales. De r\u00e1pido a preciso: el rat\u00f3n se adapta a cualquier situaci\u00f3n.<br><h2>Un agarre relajado<\/h2>La forma del rat\u00f3n Voca hace que sea muy c\u00f3modo de usar, incluso durante largas sesiones de gaming. Tanto en el trabajo como en el juego, el rat\u00f3n ayuda a que tu experiencia digital sea lo m\u00e1s fluida posible.<br><h2>Conectar y hacer clic<\/h2>Puedes empezar a utilizar el rat\u00f3n de inmediato. Instalarlo es tan f\u00e1cil como colocar el conector USB, y ya est\u00e1 listo para usar.<br><ul>  <li>Rat\u00f3n con cable, con un dise\u00f1o c\u00f3modo para trabajar con facilidad<\/li>  <li>Elige tu velocidad favorita entre 800\/1200\/1600\/2400 ppp<\/li>  <li>Configuraci\u00f3n sencilla: solo hay que conectar el conector USB y listo<\/li>  <li>2 botones para pulgar: para navegar avanzando o retrocediendo<\/li>  <li>Forma c\u00f3moda para un agarre relajado<\/li>  <li>Cable de 160 cm de longitud<\/li><\/ul><p><br><\/p><p><br><\/p><ul><li><b>General<\/b><\/li><li>Factor de forma est\u00e1ndar<\/li><li>Altura del producto principal (en mm)<\/li><li>115 mm<\/li><li>Ancho del producto principal (en mm)<\/li><li>69 mm<\/li><li>Profundidad del producto principal (en mm)<\/li><li>37 mm<\/li><li>Peso total<\/li><li>100 gramos<\/li><li>Peso de la unidad principal<\/li><li>80 g<\/li><li><b>Caracter\u00edsticas<\/b><\/li><li>DPI ajustable<\/li><li>s\u00ed<\/li><li>Almohadillas deslizantes<\/li><li>tefl\u00f3n<\/li><li><b>Sensor<\/b><\/li><li>DPI<\/li><li>800, 1200, 1600, 2400<\/li><li>Rango de DPI<\/li><li>800 ppp - 2400 ppp<\/li><li>Max. DPI<\/li><li>2400 ppp<\/li><li>Tecnolog\u00eda de sensores<\/li><li>\u00f3ptico<\/li><li>Control<\/li><li>Uso para zurdos<\/li><li>diestro<\/li><li>Rueda de desplazamiento<\/li><li>s\u00e