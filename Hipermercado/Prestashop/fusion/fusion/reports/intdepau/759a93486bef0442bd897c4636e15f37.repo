00\/fixed\/art_sam-m%20ls49ag950np_1.jpg"],"wholesale_price":1428}}},"8806094769197":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806094769197",false],"wholesale_price":[107.37,false],"price":[112.37,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Monitor Samsung S24C310EAU 24&#39;\/ Full HD\/ Preto"],"result":false},"feed_data":{"name_pt":"Monitor Samsung S24C310EAU 24'\/ Full HD\/ Negro","category":"Monitores","sub_category":"Monitores","unit_price":112.37,"reference":"LS24C310EAUXEN","ean13":"8806094769197","weight":"4","quantity":5,"brand":"SAMSUNG","description_pt":"<p><h2>Dise\u00f1o sin marco<\/h2>Un dise\u00f1o minimalista para la m\u00e1xima concentraci\u00f3n. La pantalla sin bisel de 3 lados brinda una est\u00e9tica limpia y moderna a cualquier espacio de trabajo. En la configuraci\u00f3n de pantallas m\u00faltiples, los monitores parecen fusionarse entre s\u00ed, para una visualizaci\u00f3n continua y sin distracciones.<br><br><h2>Panel IPS<\/h2>Se mire como se mire, la experiencia visual no cambia. Gracias al panel IPS, cada cent\u00edmetro de la pantalla conserva todo el brillo y la nitidez de los colores. Incluso en una pantalla tan grande, las sombras y los tonos aparecen con toda su precisi\u00f3n desde cualquier punto de vista, sin manchas de ning\u00fan tipo.<br><br><h2>AMD FreeSync<\/h2>Para disfrutar de la experiencia de entretenimiento m\u00e1s fluida, la tecnolog\u00eda AMD FreeSync mantiene el monitor y la tarjeta gr\u00e1fica sincronizados, lo que reduce el desgarro de im\u00e1genes para juegos y pel\u00edculas ininterrumpidos. Incluso las escenas de acci\u00f3n m\u00e1s din\u00e1micas siguen siendo n\u00edtidas y fluidas.<br><br><h2>Frecuencia de actualizaci\u00f3n de 75 Hz<\/h2>Cada escena din\u00e1mica es impecable. La frecuencia de actualizaci\u00f3n de 75 Hz ofrece im\u00e1genes ultra suaves. Pel\u00edculas, v\u00eddeos, juegos: sea cual sea tu pasi\u00f3n, vivir\u00e1s una experiencia inmersiva sin lag ni efectos fantasma.<br><br><h2>Modo de juego<\/h2>Ajuste la configuraci\u00f3n de su juego para mantenerse un paso por delante de sus oponentes. Con mejoras de color y contraste, las im\u00e1genes v\u00edvidas y realistas te permiten identificar a los enemigos que se esconden en la oscuridad. Adem\u00e1s, el Modo Juego se adapta a cada sesi\u00f3n resaltando hasta el m\u00e1s m\u00ednimo detalle.<br><br><h2>Modos Eye Saver y Flicker Free<\/h2>Ojos en la seguridad. La avanzada tecnolog\u00eda de reducci\u00f3n de la fatiga ocular certificada por TUV limita la emisi\u00f3n de luz azul y elimina el molesto parpadeo, para ver la pantalla incluso durante horas con el m\u00e1ximo confort visual.<br><br><h2>Eco Ahorro Plus<\/h2>Certificados mundialmente por su eficiencia energ\u00e9tica, los monitores Samsung est\u00e1n equipados con el modo especial Eco Saving Plus, que ahorra hasta un 10 % m\u00e1s de energ\u00eda.<br><br><h2>HDMI y D-sub<\/h2>Conexiones sin fronteras. Gracias a los puertos HDMI y D-sub, puedes conectar m\u00faltiples dispositivos al monitor, con la m\u00e1xima flexibilidad, para que tu estaci\u00f3n de trabajo sea a\u00fan m\u00e1s pr\u00e1ctica.<br><br><ul>  <li><b>Pantalla<\/b><\/li>  <li>Tama\u00f1o de pantalla (clase)<\/li>  <li>24<\/li>  <li>Plano \/ Curvo<\/li>  <li>Plano<\/li>  <li>Tama\u00f1o de pantalla activa (HxV) (mm)<\/li>  <li>527,04 x 296,46 mm<\/li>  <li>relaci\u00f3n de aspecto<\/li>  <li>16:9<\/li>  <li>Tipo de panel<\/li>  <li>IPS<\/li>  <li>Brillo (t\u00edpico)<\/li>  <li>250 cd\/&#13217;<\/li>  <li>Brillo (m\u00edn.)<\/li>  <li>200cd\/&#13217;<\/li>  <li>Relaci\u00f3n de contraste est\u00e1tico<\/li>  <li>1000:1 (t\u00edpico)<\/li>  <li>Resoluci\u00f3n<\/li>  <li>1.920x1.080<\/li>  <li>Tiempo de respuesta<\/li>  <li>5 (GTG)<\/li>  <li>\u00c1ngulo de visi\u00f3n (horizontal\/vertical)<\/li>  <li>178\u00b0\/178\u00b0<\/li>  <li>Colores admitidos<\/li>  <li>M\u00e1x. 16,7 M<\/li>  <li>Gama de colores (NTSC 1976)<\/li>  <li>72% (CIE 1931)<\/li>  <li>Frecuencia de actualizaci\u00f3n<\/li>  <li>75 Hz m\u00e1x.<\/li>  <li><b>Caracter\u00edsticas generales<\/b><\/li>  <li>Eco Ahorro Plus<\/li>  <li>S\u00ed<\/li>  <li>Modo protector de ojos<\/li>  <li>S\u00ed<\/li>  <li>Sin destellos<\/li>  <li>S\u00ed<\/li>  <li>Modo de juego<\/li>  <li>S\u00ed<\/li>  <li>Tama\u00f1o de la imagen<\/li>  <li>S\u00ed<\/li>  <li>Certificaci\u00f3n de Windows<\/li>  <li>Windows 10<\/li>  <li>FreeSync<\/li>  <li>S\u00ed<\/li>  <li><b>Interfaz<\/b>  <\/li><li>D-Sub<\/li>  <li>1  <\/li><li>HDMI<\/li>  <li>1  <\/li><li>Versi\u00f3n HDMI<\/li>  <li>1.4<\/li>  <li>Versi\u00f3n HDCP (HDMI)<\/li>  <li>1.2<\/li>  <li><b>Condiciones de operaci\u00f3n<\/b><\/li>  <li>Temperatura<\/li>  <li>10~40&#8451;<\/li>  <li>Humedad<\/li>  <li>10~80, sin condensaci\u00f3n<\/li>  <li><b>Dise\u00f1o<\/b><\/li>  <li>Color del marco<\/li>  <li>NEGRO<\/li>  <li>Color trasero<\/li>  <li>NEGRO<\/li>  <li>Color del soporte<\/li>  <li>Negro<\/li>  <li>Tipo b\u00e1sico<\/li>  <li>SIMPLE<\/li>  <li>inclinable<\/li>  <li>-2,0\u00b0(-1,0\u00b0\/+2,0\u00b0)~20,0\u00b0(\u00b12,0\u00b0)<\/li>  <li>Montaje en pared<\/li>  <li>100,0 \u00d7 100,0<\/li>  <li><b>Eco<\/b><\/li>  <li>Clase de eficiencia energ\u00e9tica<\/li>  <li>Y<\/li>  <li>Pl\u00e1stico Reciclado<\/li>  <li>20,6%<\/li>  <li><b>Alimentaci\u00f3n<\/b><\/li>  <li>Fuente de alimentaci\u00f3n<\/li>  <li>CA 100 ~ 240 V<\/li>  <li>Consumo (M\u00e1x.)<\/li>  <li>25W<\/li>  <li>Consumo de energ\u00eda (t\u00edpico)<\/li>  <li>15W<\/li>  <li>Consumo de energ\u00eda (DPMS)<\/li>  <li>0.30W<\/li>  <li>Consumo de energ\u00eda (apagado)<\/li>  <li>0.30W<\/li>  <li>Consumo de energ\u00eda (anual)<\/li>  <li>22kWh\/a\u00f1o<\/li>  <li>Tipolog\u00eda<\/li>  <li>Adaptador externo<\/li>  <li><b>Dimensiones<\/b><\/li>  <li>Dimensiones unidad con base (AnxAlxPr)<\/li>  <li>539,5 x 422,8 x 217,4 mm<\/li>  <li>Dimensiones de la unidad sin base (An. x Al. x Pr.)<\/li>  <li>539,5 x 322,8 x 41,2 mm<\/li>  <li>Dimensiones totales con embalaje (An. x Al. x Pr.)<\/li>  <li>607,0 x 147,0 x 380,0 mm<\/li>  <li><b>Peso<\/b><\/li>  <li>Peso con base<\/li>  <li>2,8 kg<\/li>  <li>Peso sin base<\/li>  <li>2,4 kg<\/li>  <li>Peso total con embalaje<\/li>  <li>4,3 kg<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-m%20s24c310eau_1.jpg","wholesale_price":"107.37","unit_price_tax":112.37},"product_model":{"product_data":{"ean13":["8806094769197"],"reference":"LS24C310EAUXEN","name":{"1":"Monitor Samsung S24C310EAU 24'\/ Full HD\/ Negro","2":"","3":"","4":""},"description":{"1":"<p><h2>Dise\u00f1o sin marco<\/h2>Un dise\u00f1o minimalista para la m\u00e1xima concentraci\u00f3n. La pantalla sin bisel de 3 lados brinda una est\u00e9tica limpia y moderna a cualquier espacio de trabajo. En la configuraci\u00f3n de pantallas m\u00faltiples, los monitores parecen fusionarse entre s\u00ed, para una visualizaci\u00f3n continua y sin distracciones.<br><br><h2>Panel IPS<\/h2>Se mire como se mire, la experiencia visual no cambia. Gracias al panel IPS, cada cent\u00edmetro de la pantalla conserva todo el brillo y la nitidez de los colores. Incluso en una pantalla tan grande, las sombras y los tonos aparecen con toda su precisi\u00f3n desde cualquier punto de vista, sin manchas de ning\u00fan tipo.<br><br><h2>AMD FreeSync<\/h2>Para disfrutar de la experiencia de entretenimiento m\u00e1s fluida, la tecnolog\u00eda AMD FreeSync mantiene el monitor y la tarjeta gr\u00e1fica sincronizados, lo que reduce el desgarro de im\u00e1genes para juegos y pel\u00edculas ininterrumpidos. Incluso las escenas de acci\u00f3n m\u00e1s din\u00e1micas siguen siendo n\u00edtidas y fluidas.<br><br><h2>Frecuencia de actualizaci\u00f3n de 75 Hz<\/h2>Cada escena din\u00e1mica es impecable. La frecuencia de actualizaci\u00f3n de 75 Hz ofrece im\u00e1genes ultra suaves. Pel\u00edculas, v\u00eddeos, juegos: sea cual sea tu pasi\u00f3n, vivir\u00e1s una experiencia inmersiva sin lag ni efectos fantasma.<br><br><h2>Modo de juego<\/h2>Ajuste la configuraci\u00f3n de su juego para mantenerse un paso por delante de sus oponentes. Con mejoras de color y contraste, las im\u00e1genes v\u00edvidas y realistas te permiten identificar a los enemigos que se esconden en la oscuridad. Adem\u00e1s, el Modo Juego se adapta a cada sesi\u00f3n resaltando hasta el m\u00e1s m\u00ednimo detalle.<br><br><h2>Modos Eye Saver y Flicker Free<\/h2>Ojos en la seguridad. La avanzada tecnolog\u00eda de reducci\u00f3n de la fatiga ocular certificada por TUV limita la emisi\u00f3n de luz azul y elimina el molesto parpadeo, para ver la pantalla incluso durante horas con el m\u00e1ximo confort visual.<br><br><h2>Eco Ahorro Plus<\/h2>Certificados mundialmente por su eficiencia energ\u00e9tica, los monitores Samsung est\u00e1n equipados con el modo especial Eco Saving Plus, que ahorra hasta un 10 % m\u00e1s de energ\u00eda.<br><br><h2>HDMI y D-sub<\/h2>Conexiones sin fronteras. Gracias a los puertos HDMI y D-sub, puedes conectar m\u00faltiples dispositivos al monitor, con la m\u00e1xima flexibilidad, para que tu estaci\u00f3n de trabajo sea a\u00fan m\u00e1s pr\u00e1ctica.<br><br><ul>  <li><b>Pantalla<\/b><\/li>  <li>Tama\u00f1o de pantalla (clase)<\/li>  <li>24<\/li>  <li>Plano \/ Curvo<\/li>  <li>Plano<\/li>  <li>Tama\u00f1o de pantalla activa (HxV) (mm)<\/li>  <li>527,04 x 296,46 mm<\/li>  <li>relaci\u00f3n de aspecto<\/li>  <li>16:9<\/li>  <li>Tipo de panel<\/li>  <li>IPS<\/li>  <li>Brillo (t\u00edpico)<\/li>  <li>250 cd\/&#13217;<\/li>  <li>Brillo (m\u00edn.)<\/li>  <li>200cd\/&#13217;<\/li>  <li>Relaci\u00f3n de contraste est\u00e1tico<\/li>  <li>1000:1 (t\u00edpico)<\/li>  <li>Resoluci\u00f3n<\/li>  <li>1.920x1.080<\/li>  <li>Tiempo de respuesta<\/li>  <li>5 (GTG)<\/li>  <li>\u00c1ngulo de visi\u00f3n (horizontal\/vertical)<\/li>  <li>178\u00b0\/178\u00b0<\/li>  <li>Colores admitidos<\/li>  <li>M\u00e1x. 16,7 M<\/li>  <li>Gama de colores (NTSC 1976)<\/li>  <li>72% (CIE 1931)<\/li>  <li>Frecuencia de actualizaci\u00f3n<\/li>  <li>75 Hz m\u00e1x.<\/li>  <li><b>Caracter\u00edsticas generales<\/b><\/li>  <li>Eco Ahorro Plus<\/li>  <li>S\u00ed<\/li>  <li>Modo protector de ojos<\/li>  <li>S\u00ed<\/li>  <li>Sin destellos<\/li>  <li>S\u00ed<\/li>  <li>Modo de juego<\/li>  <li>S\u00ed<\/li>  <li>Tama\u00f1o de la imagen<\/li>  <li>S\u00ed<\/li>  <li>Certificaci\u00f3n de Windows<\/li>  <li>Windows 10<\/li>  <li>FreeSync<\/li>  <li>S\u00ed<\/li>  <li><b>Interfaz<\/b>  <\/li><li>D-Sub<\/li>  <li>1  <\/li><li>HDMI<\/li>  <li>1  <\/li><li>Versi\u00f3n HDMI<\/li>  <li>1.4<\/li>  <li>Versi\u00f3n HDCP (HDMI)<\/li>  <li>1.2<\/li>  <li><b>Condiciones de operaci\u00f3n<\/b><\/li>  <li>Temperatura<\/li>  <li>10~40&#8451;<\/li>  <li>Humedad<\/li>  <li>10~80, sin condensaci\u00f3n<\/li>  <li><b>Dise\u00f1o<\/b><\/li>  <li>Color del marco<\/li>  <li>NEGRO<\/li>  <li>Color trasero<\/li>  <li>NEGRO<\/li>  <li>Color del soporte<\/li>  <li>Negro<\/li>  <li>Tipo b\u00e1sico<\/li>  <li>SIMPLE<\/li>  <li>inclinable<\/li>  <li>-2,0\u00b0(-1,0\u00b0\/+2,0\u00b0)~20,0\u00b0(\u00b12,0\u00b0)<\/li>  <li>Montaje en pared<\/li>  <li>100,0 \u00d7 100,0<\/li>  <li><b>Eco<\/b><\/li>  <li>Clase de eficiencia energ\u00e9tica<\/li>  <li>Y<\/li>  <li>Pl\u00e1stico Reciclado<\/li>  <li>20,6%<\/li>  <li><b>Alimentaci\u00f3n<\/b><\/li>  <li>Fuente de alimentaci\u00f3n<\/li>  <li>CA 100 ~ 240 V<\/li>  <li>Consumo (M\u00e1x.)<\/li>  <li>25W<\/li>  <li>Consumo de energ\u00eda (t\u00edpico)<\/li>  <li>15W<\/li>  <li>Consumo de energ\u00eda (DPMS)<\/li>  <li>0.30W<\/li>  <li>Consumo de energ\u00eda (apagado)<\/li>  <li>0.30W<\/li>  <li>Consumo de energ\u00eda (anual)<\/li>  <li>22kWh\/a\u00f1o<\/li>  <li>Tipolog\u00eda<\/li>  <li>Adaptador externo<\/li>  <li><b>Dimensiones<\/b><\/li>  <li>Dimensiones unidad con base (AnxAlxPr)<\/li>  <li>539,5 x 422,8 x 217,4 mm<\/li>  <li>Dimensiones de la unidad sin base (An. x Al. x Pr.)<\/li>  <li>539,5 x 322,8 x 41,2 mm<\/li>  <li>Dimensiones totales con embalaje (An. x Al. x Pr.)<\/li>  <li>607,0 x 147,0 x 380,0 mm<\/li>  <li><b>Peso<\/b><\/li>  <li>Peso con base<\/li>  <li>2,8 kg<\/li>  <li>Peso sin base<\/li>  <li>2,4 kg<\/li>  <li>Peso total con embalaje<\/li>  <li>4,3 kg<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":4,"unit_price":112.37,"unit_price_tax":112.37,"tax_rules_group":null,"category":"Monitores","sub_category":"Monitores","quantity":5,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-m%20s24c310eau_1.jpg"],"wholesale_price":107.37}}},"8806090952623":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806090952623",false],"wholesale_price":[220.66,false],"price":[225.66,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Monitor Samsung S27A600NWU 27&#39;\/ QHD\/ Preto"],"result":false},"feed_data":{"name_pt":"Monitor Samsung S27A600NWU 27'\/ QHD\/ Negro","category":"Monitores","sub_category":"Monitores","unit_price":225.66,"reference":"LS27A600NWUXEN","ean13":"8806090952623","weight":"8.3","quantity":2,"brand":"SAMSUNG","description_pt":"<p><\/p><h2>Una pantalla innovadora que potencia tu rendimiento<\/h2><h2>Descubre todos los detalles<\/h2><b>Resoluci\u00f3n QHD<\/b><div><b><br><\/b><div>Experimenta detalles que nunca antes hab\u00edas visto. Cuando veas tu pel\u00edcula preferida o trabajes en tu \u00faltimo proyecto, disfruta de nuevos niveles de precisi\u00f3n con hasta 1.7 veces la densidad de p\u00edxeles del Full HD. QHD ofrece m\u00e1s espacio para la multitarea o para visualizar v\u00eddeos e im\u00e1genes con todo detalle.<br><h2>Grandeza desde todos los \u00e1ngulos<\/h2><b><div><b>Panel IPS<\/b><\/div><\/b><div>Optimizado para entornos de trabajo profesionales. Los monitores Samsung de alta resoluci\u00f3n incluyen un panel IPS, ofreciendo una calidad de color n\u00edtida y un amplio \u00e1ngulo de visi\u00f3n de 178\u00ba. Todos los usuarios podr\u00e1n disfrutar de una incre\u00edble experiencia de visualizaci\u00f3n desde cualquier \u00e1ngulo, con colores v\u00edvidos y vibrantes, sin difuminaci\u00f3n.<p><br><\/p><h2>Mil millones de colores con una profundidad incre\u00edble<\/h2><b>Mil millones de colores con HDR 10<\/b><div><b><br><\/b>Disfruta de cualquier contenido con una precisi\u00f3n y detalle de color impresionantes. Con un amplio rango de colores, tonalidades casi ilimitadas y HDR10, que hace que los tonos negros sean m\u00e1s oscuros y los tonos claros m\u00e1s brillantes, cada pieza de contenido se convierte en un placer a la vista. Todo podr\u00e1 experimentarse tal y como el creador pretend\u00eda.<p><\/p><p><\/p><h2>Maximiza la comodidad, minimiza las distracciones<\/h2>Coloca tu monitor c\u00f3mo te sea m\u00e1s c\u00f3modo. Su dise\u00f1o sin bordes, compatibilidad con montaje VESA y una variedad de posiciones de inclinaci\u00f3n, giro y pivote te permiten montar tu monitor en cualquier entorno. Adem\u00e1s, su soporte de metal delgado y su poca profundidad ocupan menos espacio en el escritorio para una configuraci\u00f3n de trabajo ordenada y perfecta.<p><\/p><p><\/p><h2>Mantente sincronizado con la acci\u00f3n<\/h2>Tu experiencia de entretenimiento, m\u00e1s fluida que nunca. AMD FreeSync&#8482; mantiene la frecuencia de actualizaci\u00f3n del monitor y la tarjeta gr\u00e1fica sincronizados para reducir los rasgados y tirones. Olv\u00eddate de interrupciones en pel\u00edculas y videojuegos, ya que incluso las escenas r\u00e1pidas de acci\u00f3n son ultrarr\u00e1pidas y fluidas.<p><br><br><\/p><ul>  <li>    <h2>Especificaciones<\/h2><\/li><li>Relaci\u00f3n de aspecto<\/li>  <li>16:9<\/li>  <li>Brillo (Normal)<\/li>  <li>300 cd\/&#13217;<\/li>  <li>Relaci\u00f3n de contraste est\u00e1tico<\/li>  <li>1000:1(Typ), 700:1(Min)<\/li>  <li>Resoluci\u00f3n<\/li>  <li>2,560 x 1,440<\/li>  <li>Tiempo de Respuesta<\/li>  <li>5ms<\/li>  <li>\u00c1ngulo de Visi\u00f3n (H\/V)<\/li>  <li>178\u00b0\/178\u00b0<\/li>  <li>Detalle de especificaciones<\/li>  <li>Pantalla<\/li>  <li>Clase de pantalla<\/li>  <li>27<\/li>  <li>Active Display Size (HxV) (mm)<\/li>  <li>596.736 \u00d7 335.664 mm<\/li>  <li>Relaci\u00f3n de aspecto<\/li>  <li>16:9<\/li>  <li>Panel<\/li>  <li>IPS<\/li>  <li>Brillo (Normal)<\/li>  <li>300 cd\/&#13217;<\/li>  <li>Brillo (Min)<\/li>  <li>250 cd\/&#13217;<\/li>  <li>Relaci\u00f3n de contraste est\u00e1tico<\/li>  <li>1000:1(Typ), 700:1(Min)<\/li>  <li>Ratio de Contraste Din\u00e1mico<\/li>  <li>Mega<\/li>  <li>HDR(High Dynamic Range)<\/li>  <li>HDR10<\/li>  <li>Resoluci\u00f3n<\/li>  <li>2,560 x 1,440<\/li>  <li>Tiempo de Respuesta<\/li>  <li>5ms<\/li>  <li>\u00c1ngulo de Visi\u00f3n (H\/V)<\/li>  <li>178\u00b0\/178\u00b0<\/li>  <li>Color<\/li>  <li>M\u00e1x 1.07B<\/li>  <li>Refresco<\/li>  <li>M\u00e1x 75Hz<\/li>  <li>Caracter\u00edsticas generales<\/li>  <li>Modo Eco Saving Plus<\/li>  <li>S\u00ed<\/li>  <li>Eco Light Sensor<\/li>  <li>S\u00ed<\/li>  <li>Modo Eye Saver<\/li>  <li>S\u00ed<\/li>  <li>Flicker Free<\/li>  <li>S\u00ed<\/li>  <li>PIP<\/li>  <li>S\u00ed<\/li>  <li>Picture-By-Picture<\/li>  <li>S\u00ed<\/li>  <li>Modo gaming<\/li>  <li>S\u00ed<\/li>  <li>Tama\u00f1o de imagen<\/li>  <li>S\u00ed<\/li>  <li>Certificado Windows<\/li>  <li>Windows10<\/li