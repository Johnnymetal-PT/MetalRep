au.es\/articulos\/800\/800\/fixed\/art_can-mult%20pixma%20ts7450a%20bk_1.jpg"],"wholesale_price":63}}},"4549292198621":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4549292198621",false],"wholesale_price":[63.55,false],"price":[68.55,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 10.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88442","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/771b27eff179597dd829d441acc9eae9.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Multifunci\u00f3n Fotogr\u00e1fica Canon PIXMA TS7451A WiFi\/ D\u00faplex\/ Blanca","category":"Multifunciones  e Impresoras","sub_category":"Multifunciones","unit_price":68.55,"reference":"4460C076AA","ean13":"4549292198621","weight":"10.1","quantity":5,"brand":"CANON","description_pt":"<p><h2>Impresora multifunci\u00f3n fotogr\u00e1fica color e inal\u00e1mbrica Canon PIXMA Ts7451a, en blanco<\/h2>La PIXMA TS7451a de Canon es la opci\u00f3n perfecta para un uso vers\u00e1til en el hogar y para trabajar eficazmente en casa: imprime, escanea y copia desde cualquier dispositivo. Es muy f\u00e1cil de conectar y utilizar con la aplicaci\u00f3n Canon PRINT: esta impresora multifunci\u00f3n ofrece una impresi\u00f3n m\u00f3vil \u00f3ptima. Elegante, asequible y f\u00e1cil de usar, con la PIXMA TS7451a podr\u00e1s imprimir en todo tipo de soportes desde tu ordenador, tablet o smartphone: imprime en papel fotogr\u00e1fico, papel de trasferencia t\u00e9rmica, papel magn\u00e9tico o papel adhesivo removible. Con la tecnolog\u00eda ADF, podr\u00e1s escanear y copiar varias hojas r\u00e1pidamente, lo que acelera y facilita el trabajo desde casa. Al finalizar el trabajo, la PIXMA TS7451a ser\u00e1 todo lo ingeniosa que t\u00fa quieras; perfecta para creaciones art\u00edsticas con ni\u00f1os, pero tambi\u00e9n para el ni\u00f1o que hay en ti.<br><h2>Ventajas<\/h2><ul>  <li>Con su nuevo y atractivo dise\u00f1o, la PIXMA TS7451a es un dispositivo multifunci\u00f3n compacto y est\u00e9ticamente agradable<\/li>  <li>Copia o escanea varias hojas sin tener que retirar y ponerlas una a una, con la tecnolog\u00eda del alimentador autom\u00e1tico de documentos (ADF)<\/li>  <li>La PIXMA TS7451a es sumamente f\u00e1cil de usar: conecta directamente desde tu ordenador o desde tu smartphone e imprime desde una c\u00e1mara usando la tecnolog\u00eda Wi-Fi<\/li>  <li>El tiempo de configuraci\u00f3n de la PIXMA TS7451a se ha reducido enormemente. Solo tienes que escanear el c\u00f3digo QR con tu tel\u00e9fono y la tecnolog\u00eda inteligente se encargar\u00e1 del resto<\/li>  <li>Utiliza las pr\u00e1cticas aplicaciones para imprimir desde tel\u00e9fonos y tablets, conectar a los servicios en la nube, descubrir la inspiraci\u00f3n art\u00edstica y mucho m\u00e1s<\/li>  <li>La PIXMA TS7451a es tan creativa como t\u00fa: imprime en papel fotogr\u00e1fico, papel de trasferencia t\u00e9rmica, papel magn\u00e9tico o papel adhesivo removible<\/li>  <li>Con su impresi\u00f3n de fotograf\u00edas sin bordes, podr\u00e1s imprimir una foto sin bordes de 10 x 15 cm en aproximadamente 43 segundos<\/li>  <li>Gracias a su conexi\u00f3n directa mediante c\u00f3digo QR, puedes conectarte a la PIXMA TS7451a simplemente escaneando el c\u00f3digo QR en la pantalla LCD<\/li>  <li>Ahorra papel y dinero con la impresi\u00f3n y copia a doble cara autom\u00e1tica<\/li>  <li>Compatible con Windows y Mac OS\u00b2<\/li><\/ul><h2>Contenido del embalaje<\/h2><ul>  <li>Impresora de inyecci\u00f3n de tinta PIXMA TS7451a<\/li>  <li>Cartuchos de tinta de configuraci\u00f3n (pensados para la configuraci\u00f3n inicia