s_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.33",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84969","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/d1975df75db6c7008732633e1bebd33f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Inal\u00e1mbricos Mars Gaming MHW-ECO\/ con Micr\u00f3fono\/ Bluetooth\/ Jack 3.5\/ Gris","category":"Auriculares","sub_category":"Auriculares","unit_price":19.53,"reference":"MHWECO","ean13":"8435693100447","weight":"0.33","quantity":5,"brand":"MARS GAMING","description_pt":"<p><h2>MHW-ECO ECOLOGICAL WIRELESS HEADPHONES<\/h2>New generation of ECO technological products. Made with plastic substitutes: wheat straw, biological membranes and ECO packaging. Collaborate to save the planet with the be plastic smart project<br><br><h2>MATERIAL ECO WHEAT STRAW<\/h2>El material sustitutivo del pl\u00e1stico m\u00e1s innovador. El wheat straw es un subproducto del trigo obtenido del aprovechamiento de los residuos de las cosechas. Material compostable y biodegradable, permite sustituir de forma efectiva el pl\u00e1stico con la dureza y durabilidad requeridas en los productos comerciales.<br><br><h2>MATERIAL ECO MEMBRANA BIOL\u00d3GICA<\/h2>Un sonido limpio, equilibrado y potente gracias al uso de membranas biol\u00f3gicas en los drivers de sonido. Disfruta de una calidad de sonido excelente mientras cuidas el medio ambiente.<br><br><h2>EMPAQUETADO ECOL\u00d3GICO<\/h2>Fabricado con materiales reciclados y reducido al m\u00ednimo tama\u00f1o posible. Adem\u00e1s, eliminamos todo material que genera residuos de forma innecesaria imprimiendo el manual en el propio empaquetado. Reduce al m\u00e1ximo la huella de CO2.<br><br><h2>BLUETOOTH 5.1 + JACK<\/h2>Incorporamos el avanzado Bluetooth 5.1 para un m\u00e1ximo ahorro energ\u00e9tico, una estabilidad de la conexi\u00f3n inal\u00e1mbrica ante cualquier circunstancia, una latencia s\u00faper baja y una calidad de sonido de alta fidelidad con codecs avanzados. Adem\u00e1s, dispone de conexi\u00f3n adicional jack de audio standard para que tambi\u00e9n puedas utilizarlos con dispositivos sin bluetooth.<br><br><h2>10 HORAS DE AUTONOM\u00cdA<\/h2>Gracias al Bluetooth 5.1 y a avanzados sistemas de ahorro de energ\u00eda, obtendr\u00e1s hasta 10 horas de uso. Para disfrutarlos sin limitaciones<br><br><h2>MICR\u00d3FONO ANTI-RUIDO<\/h2>Incorpora un micr\u00f3fono que proporciona un sonido claro y n\u00edtido a la hora de comunicarte gracias a su filtrado de ruido y su c\u00e1psula de alta calidad.<br><br><h2>COMPATIBILIDAD UNIVERSAL<\/h2>Utiliza la conexi\u00f3n Bluetooth para conectarlo con cualquier dispositivo compatible. Adem\u00e1s, puedes maximizar la compatibilidad utilizando el cable de conexi\u00f3n incluido para poder usarlos de manera universal, tanto en PC y Mac como en PS4, PS5, XBOX ONE, XBOX SERIES X-S, Switch, Smartphone, Tablet y m\u00e1s.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Dimensiones<\/li>  <li>195x175x75mm<\/li>  <li>Peso<\/li>  <li>150g<\/li>  <li>Materiales<\/li>  <li>Paja de trigo, Bamb\u00fa y materiales reciclados<\/li>  <li>Color<\/li>  <li>Gris<\/li>  <li>Extras<\/li>  <li>Micr\u00f3fono Anti-ruido<\/li>  <li>Compatibilidad<\/li>  <li>PC, Mac, Smartphone, Tablets<\/li>  <li>Conector<\/li>  <li>Micro-USB (Alimentaci\u00f3n)<\/li>  <li>Control de volumen<\/li>  <li>S\u00ed<\/li>  <li>Impedancia (micr\u00f3fono)<\/li>  <li>32&#937;<\/li>  <li>Rango de frecuencia (micr\u00f3fono)<\/li>  <li>15Hz-20KHz<\/li>  <li>Capacidad bater\u00eda<\/li>  <li>400mAh<\/li>  <li>Tiempo de funcionamiento<\/li>  <li>10 horas<\/li>  <li>Versi\u00f3n Bluetooth<\/li>  <li>5.1<\/li>  <li>Perfiles Bluetooth<\/li>  <li>HFP, HSP, AVRC, A2DP<\/li>  <li>Tiempo en standby<\/li>  <li>24 horas<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-aur%20mhweco_1.jpg","wholesale_price":"14.53","unit_price_tax":19.53},"product_model":{"product_data":{"ean13":["8435693100447"],"reference":"MHWECO","name":{"1":"Auriculares Inal\u00e1mbricos Mars Gaming MHW-ECO\/ con Micr\u00f3fono\/ Bluetooth\/ Jack 3.5\/ Gris","2":"","3":"","4":""},"description":{"1":"<p><h2>MHW-ECO ECOLOGICAL WIRELESS HEADPHONES<\/h2>New generation of ECO technological products. Made with plastic substitutes: wheat straw, biological membranes and ECO packaging. Collaborate to save the planet with the be plastic smart project<br><br><h2>MATERIAL ECO WHEAT STRAW<\/h2>El material sustitutivo del pl\u00e1stico m\u00e1s innovador. El wheat straw es un subproducto del trigo obtenido del aprovechamiento de los residuos de las cosechas. Material compostable y biodegradable, permite sustituir de forma efectiva el pl\u00e1stico con la dureza y durabilidad requeridas en los productos comerciales.<br><br><h2>MATERIAL ECO MEMBRANA BIOL\u00d3GICA<\/h2>Un sonido limpio, equilibrado y potente gracias al uso de membranas biol\u00f3gicas en los drivers de sonido. Disfruta de una calidad de sonido excelente mientras cuidas el medio ambiente.<br><br><h2>EMPAQUETADO ECOL\u00d3GICO<\/h2>Fabricado con materiales reciclados y reducido al m\u00ednimo tama\u00f1o posible. Adem\u00e1s, eliminamos todo material que genera residuos de forma innecesaria imprimiendo el manual en el propio empaquetado. Reduce al m\u00e1ximo la huella de CO2.<br><br><h2>BLUETOOTH 5.1 + JACK<\/h2>Incorporamos el avanzado Bluetooth 5.1 para un m\u00e1ximo ahorro energ\u00e9tico, una estabilidad de la conexi\u00f3n inal\u00e1mbrica ante cualquier circunstancia, una latencia s\u00faper baja y una calidad de sonido de alta fidelidad con codecs avanzados. Adem\u00e1s, dispone de conexi\u00f3n adicional jack de audio standard para que tambi\u00e9n puedas utilizarlos con dispositivos sin bluetooth.<br><br><h2>10 HORAS DE AUTONOM\u00cdA<\/h2>Gracias al Bluetooth 5.1 y a avanzados sistemas de ahorro de energ\u00eda, obtendr\u00e1s hasta 10 horas de uso. Para disfrutarlos sin limitaciones<br><br><h2>MICR\u00d3FONO ANTI-RUIDO<\/h2>Incorpora un micr\u00f3fono que proporciona un sonido claro y n\u00edtido a la hora de comunicarte gracias a su filtrado de ruido y su c\u00e1psula de alta calidad.<br><br><h2>COMPATIBILIDAD UNIVERSAL<\/h2>Utiliza la conexi\u00f3n Bluetooth para conectarlo con cualquier dispositivo compatible. Adem\u00e1s, puedes maximizar la compatibilidad utilizando el cable de conexi\u00f3n incluido para poder usarlos de manera universal, tanto en PC y Mac como en PS4, PS5, XBOX ONE, XBOX SERIES X-S, Switch, Smartphone, Tablet y m\u00e1s.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Dimensiones<\/li>  <li>195x175x75mm<\/li>  <li>Peso<\/li>  <li>150g<\/li>  <li>Materiales<\/li>  <li>Paja de trigo, Bamb\u00fa y materiales reciclados<\/li>  <li>Color<\/li>  <li>Gris<\/li>  <li>Extras<\/li>  <li>Micr\u00f3fono Anti-ruido<\/li>  <li>Compatibilidad<\/li>  <li>PC, Mac, Smartphone, Tablets<\/li>  <li>Conector<\/li>  <li>Micro-USB (Alimentaci\u00f3n)<\/li>  <li>Control de volumen<\/li>  <li>S\u00ed<\/li>  <li>Impedancia (micr\u00f3fono)<\/li>  <li>32&#937;<\/li>  <li>Rango de frecuencia (micr\u00f3fono)<\/li>  <li>15Hz-20KHz<\/li>  <li>Capacidad bater\u00eda<\/li>  <li>400mAh<\/li>  <li>Tiempo de funcionamiento<\/li>  <li>10 horas<\/li>  <li>Versi\u00f3n Bluetooth<\/li>  <li>5.1<\/li>  <li>Perfiles Bluetooth<\/li>  <li>HFP, HSP, AVRC, A2DP<\/li>  <li>Tiempo en standby<\/li>  <li>24 horas<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"vi