f3n)<\/li>  <li>Peso: 1,69 kg<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HP","supplier":null,"width":null,"height":null,"depth":null,"weight":2.35,"unit_price":450.63,"unit_price_tax":450.63,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":2,"brand":"HP","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hpp-pre%2015s-fq5089ns_1.jpg"],"wholesale_price":445.63}}},"0196548972791":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["0196548972791",false],"wholesale_price":[498.23,false],"price":[503.23,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: HP 15S-FQ5099NS Laptop Intel Core i7-1255U\/ 16 GB\/ 512 GB SSD\/ 15,6&#39;\/ Sem sistema operacional"],"result":false},"feed_data":{"name_pt":"Port\u00e1til HP 15S-FQ5099NS Intel Core i7-1255U\/ 16GB\/ 512GB SSD\/ 15.6'\/ Sin Sistema Operativo","category":"Portatiles","sub_category":"Portatiles","unit_price":503.23,"reference":"6H6E1EA","ean13":"0196548972791","weight":"2.32","quantity":5,"brand":"HP","description_pt":"<p><h2>Un port\u00e1til ligero para trabajar o jugar, siempre que lo necesites<\/h2>Haz tus cosas, durante todo el d\u00eda, o cuando prefieras, gracias a un ordenador port\u00e1til HP de 15,6' con un dise\u00f1o ligero y una bater\u00eda de larga duraci\u00f3n. Disfruta de una inform\u00e1tica c\u00f3moda gracias a una pantalla con tecnolog\u00eda antiparpadeo2 y experimenta el rendimiento fiable gracias a un procesador Intel\u00ae Core&#8482;. Adem\u00e1s, se ha fabricado pensando en el planeta, cuenta con registro EPEAT\u00ae Silver y la certificaci\u00f3n ENERGY STAR\u00ae.<br><br>T\u00fa decides: trabajo o entretenimiento est\u00e9s donde est\u00e9s gracias a su gran duraci\u00f3n de la bater\u00eda y pantalla con microborde.<br><br><h2>Fino y ligero con una pantalla con microborde<\/h2>Superport\u00e1til con un dise\u00f1o ligero y una visualizaci\u00f3n m\u00e1s c\u00f3moda gracias a una pantalla con microborde y tecnolog\u00eda antiparpadeo.<br><br><h2>Rendimiento fiable para el d\u00eda a d\u00eda<\/h2>Realiza tus tareas diarias con facilidad gracias al procesador Intel\u00ae Core&#8482; de tu port\u00e1til y a su abundante almacenamiento.<br><br><h2>Sigue conectado gracias a una bater\u00eda de larga duraci\u00f3n<\/h2>La bater\u00eda de larga duraci\u00f3n y la tecnolog\u00eda de Carga r\u00e1pida HP te permiten trabajar, visualizar tu contenido o estar conectado todo el d\u00eda.<br><br><h2>Pantalla Full HD<\/h2>Si\u00e9ntate y disfruta de im\u00e1genes y efectos visuales de gran nitidez con una calidad de 2 millones de p\u00edxeles. La resoluci\u00f3n de 1920 x 1080 ofrece a todo tu contenido digital una nueva dimensi\u00f3n.<br><br><h2>Panel antirreflectante<\/h2>Disfrute del sol y de su contenido favorito con este panel antirreflectante. Que sea antirreflectante y de bajo brillo significa que gozar\u00e1 de menos reflejos cuando est\u00e9 al aire libre.<br><br><h2>Las teclas vienen recubiertas con pl\u00e1stico reciclado posconsumo<\/h2>Dise\u00f1amos nuestros port\u00e1tiles de forma m\u00e1s sostenible recubriendo las teclas con pl\u00e1stico reciclado posconsumo.<br><br><h2>Almacenamiento PCIe SSD<\/h2>Se inicia en cuesti\u00f3n de segundos, con velocidad de v\u00e9rtigo y hasta 512 GB de almacenamiento PCIe SSD.<br><br><h2>Wi-Fi 5 (2x2) y Bluetooth\u00ae 5.0 (802.11a\/b\/g\/n\/ac)<\/h2>No vuelvas a preocuparte jam\u00e1s por Internet y por conexiones d\u00e9biles. Permanece conectado a los accesorios Wi-Fi y Bluetooth\u00ae con el \u00faltimo adaptador WLAN Wi-Fi 5 (2x2) y Bluetooth\u00ae 5.0.<br><br><h2>Compatible con MU-MIMO<\/h2>Si tiene varios dispositivos de MU-MIMO en su casa, MU-MIMO funciona en combinaci\u00f3n con un enrutador MU-MIMO para maximizar el tr\u00e1fico de red para una experiencia en l\u00ednea m\u00e1s fluida.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Sistema operativo: FreeDOS<\/li>  <li>Familia de procesadores: Procesador Intel\u00ae Core&#8482; i7 de 12.\u00aa generaci\u00f3n<\/li>  <li>Procesador: Intel\u00ae Core&#8482; i7-1255U (hasta 4,7 GHz con tecnolog\u00eda Intel\u00ae Turbo Boost, 12 MB de cach\u00e9 L3, 10 n\u00facleos, 12 subprocesos)<\/li>  <li>Conjunto de chips: Intel\u00ae SoC integrado<\/li>  <li>Especificaciones de impacto sostenible: Teclas del teclado realizadas con pl\u00e1stico reciclado postconsumo<\/li>  <li>Gesti\u00f3n de la seguridad: Compatible con el m\u00f3dulo de plataforma de confianza (firmware TPM)<\/li>  <li>Memoria: RAM DDR4-3200 MHz 16 GB (2 x 8 GB)<\/li>  <li>Dise\u00f1o de la memoria (ranuras y tama\u00f1o): 2 x 8 GB<\/li>  <li>Almacenamiento interno: SSD de 512 GB PCIe\u00ae NVMe&#8482; M.2<\/li>  <li>Unidad \u00f3ptica: Unidad \u00f3ptica no incluida<\/li>  <li>Pantalla: FHD de 15,6' (39,6 cm) en diagonal, bisel micro-edge, antirreflectante, 250 nits, 45 % NTSC (1920 x 1080)<\/li>  <li>Tama\u00f1o de la pantalla (diagonal): 39,6 cm (15,6 pulg.)<\/li>  <li>Gr\u00e1ficos: Integrada<\/li>  <li>Gr\u00e1ficos (integrados): Gr\u00e1ficos Intel\u00ae Iris\u00ae X&#7497;<\/li>  <li>Puertos: 1 USB Type-C\u00ae con velocidad de se\u00f1al de 5 Gbps; 2 USB Type-A con velocidad de se\u00f1al de 5 Gbps; 1 smart pin de CA; 1 HDMI 1.4b; 1 combo de auriculares\/micr\u00f3fono<\/li>  <li>Ranuras de expansi\u00f3n: Lector de tarjetas SD multiformato HP<\/li>  <li>Webcam: C\u00e1mara HP True Vision 720p HD con reducci\u00f3n de ruido temporal y micr\u00f3fonos digitales de matriz dual integrados<\/li>  <li>Sonido: Altavoces dobles<\/li>  <li>Dispositivo se\u00f1alador: HP Imagepad compatible con funci\u00f3n gestual multit\u00e1ctil; Compatibilidad con Precision Touchpad<\/li>  <li>Teclado: Teclado de tama\u00f1o completo de color plata natural y con teclado num\u00e9rico<\/li>  <li>Inal\u00e1mbrico: Tarjeta inal\u00e1mbrica Realtek RTL8822CE 802.11a\/b\/g\/n\/ac (2x2) Wi-Fi\u00ae y Bluetooth\u00ae 5141<\/li>  <li>Tipo de fuente de alimentaci\u00f3n: Adaptador de alimentaci\u00f3n Smart AC de 45 W<\/li>  <li>Tipo de bater\u00eda: Bater\u00eda de ion-litio de 3 celdas 41 Wh<\/li>  <li>Dise\u00f1o de productos: Base y cubierta con acabado pintado, marco del teclado con patr\u00f3n de cepillado vertical y funda de silicona<\/li>  <li>Color del producto: Plata natural<\/li>  <li>Dimensiones m\u00ednimas (ancho x fondo x alto): 35,85 x 24,2 x 1,79 cm (Las dimensiones var\u00edan seg\u00fan la configuraci\u00f3n)<\/li>  <li>Peso: 1,69 kg<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hpp-pre%2015s-fq5099ns_1.jpg","wholesale_price":"498.23","unit_price_tax":503.23},"product_model":{"product_data":{"ean13":["0196548972791"],"reference":"6H6E1EA","name":{"1":"Port\u00e1til HP 15S-FQ5099NS Intel Core i7-1255U\/ 16GB\/ 512GB SSD\/ 15.6'\/ Sin Sistema Operativo","2":"","3":"","4":""},"description":{"1":"<p><h2>Un port\u00e1til ligero para trabajar o jugar, siempre que lo necesites<\/h2>Haz tus cosas, durante todo el d\u00eda, o cuando prefieras, gracias a un ordenador port\u00e1til HP de 15,6' con un dise\u00f1o ligero y una bater\u00eda de larga duraci\u00f3n. Disfruta de una inform\u00e1tica c\u00f3moda gracias a una pantalla con tecnolog\u00eda antiparpadeo2 y experimenta el rendimiento fiable gracias a un procesador Intel\u00ae Core&#8482;. Adem\u00e1s, se ha fabricado pensando en el planeta, cuenta con registro EPEAT\u00ae Silver y la certificaci\u00f3n ENERGY STAR\u00ae.<br><br>T\u00fa decides: trabajo o entretenimiento est\u00