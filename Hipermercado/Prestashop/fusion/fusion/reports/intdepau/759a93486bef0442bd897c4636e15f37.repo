 de litio para una aplicaci\u00f3n de hasta 5&nbsp;h<\/li><li>Incl. malet\u00edn para una pr\u00e1ctica conservaci\u00f3n<\/li><\/ul><div><br><\/div><div><ul><li><b>Especificaciones<\/b><\/li><li>Denominaci\u00f3n del producto Aparato de masaje muscular<\/li><li>Autonom\u00eda de la bater\u00eda Aprox. 5 horas<\/li><li>Intensidad en U\/min 1800 - 3000<\/li><li>Peso del producto ca. 620 g (sin accesorios, sin adaptador)<\/li><li>Dimensiones del producto (la. x an. x al.)aprox. 16,4 x 5,8 x 18,4 cm (sin accesorios)<\/li><li>CE S\u00ed<\/li><\/ul><\/div><div><br><\/div><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BEURER","supplier":null,"width":null,"height":null,"depth":null,"weight":1.2,"unit_price":70.89,"unit_price_tax":70.89,"tax_rules_group":null,"category":"Salud","sub_category":"Masajeadores","quantity":2,"brand":"BEURER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_beu-pae-masajeador%20mg-99_1.jpg"],"wholesale_price":65.89}}},"4211125952600":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4211125952600",false],"wholesale_price":[40.6,false],"price":[45.6,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.38",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:89192","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/c332edadbe96d56f364a033ba3131b93.jpg; <br>-------------------------------"],"result":true},"feed_da