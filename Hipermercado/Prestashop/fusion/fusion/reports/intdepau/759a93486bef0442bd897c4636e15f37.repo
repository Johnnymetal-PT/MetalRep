ory":"Cocina","sub_category":"Tostadores","unit_price":21.88,"reference":"BP4001","ean13":"8436533796660","weight":"1.5","quantity":5,"brand":"BLAUPUNKT","description_pt":"<p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Tostador Ranura Larga 1000W BP-4001 Blaupunkt<\/li>  <li>Bot\u00f3n de parada<\/li>  <li>Termostato regulable con 6 niveles<\/li>  <li>Funci\u00f3n de descongelaci\u00f3n<\/li>  <li>Funci\u00f3n de recalentar<\/li>  <li>Bandeja recogemigas<\/li>  <li>Dise\u00f1o elegante<\/li>  <li>Color blanco<\/li>  <li>220 V - 1000W<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-tos%20bp-4001_1.jpg","wholesale_price":"16.88","unit_price_tax":21.88},"product_model":{"product_data":{"ean13":["8436533796660"],"reference":"BP4001","name":{"1":"Tostador Blaupunkt BP4001\/ 1000W\/ Blanco","2":"","3":"","4":""},"description":{"1":"<p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Tostador Ranura Larga 1000W BP-4001 Blaupunkt<\/li>  <li>Bot\u00f3n de parada<\/li>  <li>Termostato regulable con 6 niveles<\/li>  <li>Funci\u00f3n de descongelaci\u00f3n<\/li>  <li>Funci\u00f3n de recalentar<\/li>  <li>Bandeja recogemigas<\/li>  <li>Dise\u00f1o elegante<\/li>  <li>Color blanco<\/li>  <li>220 V - 1000W<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BLAUPUNKT","supplier":null,"width":null,"height":null,"depth":null,"weight":1.5,"unit_price":21.88,"unit_price_tax":21.88,"tax_rules_group":null,"category":"Cocina","sub_category":"Tostadores","quantity":5,"brand":"BLAUPUNKT","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-tos%20bp-4001_1.jpg"],"wholesale_price":16.88}}},"8436533796677":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436533796677",false],"wholesale_price":[28.63,false],"price":[33.63,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:85947","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/9fd222efa80b3a1c4a00ac3917c35cf3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Batidora de vaso Blaupunkt BP4002\/ 1000W\/ 3 Velocidades\/ Capacidad 1.5L","category":"Cocina","sub_category":"Batidoras","unit_price":33.629999999999995,"reference":"BP4002","ean13":"8436533796677","weight":"3.3","quantity":2,"brand":"BLAUPUNKT","description_pt":"<p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Batidora de Vaso Cristal 1500ml 1000w BP-4002<\/li>  <li>Potencia 1000W<\/li>  <li>Cuchillas de Acero Inoxidable<\/li>  <li>2 Velocidades + turbo<\/li>  <li>Vaso de cristal con capacidad de 1500 ml<\/li>  <li>Pies antideslizantes<\/li>  <li>220-240V<\/li>  <li>50 - 60 Hz<\/li>  <li>De f\u00e1cil limpieza, apto para lavavajillas<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-bat%20bp-4002_1.jpg","wholesale_price":"28.63","unit_price_tax":33.629999999999995},"product_model":{"product_data":{"ean13":["8436533796677"],"reference":"BP4002","name":{"1":"Batidora de vaso Blaupunkt BP4002\/ 1000W\/ 3 Velocidades\/ Capacidad 1.5L","2":"","3":"","4":""},"description":{"1":"<p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Batidora de Vaso Cristal 1500ml 1000w BP-4002<\/li>  <li>Potencia 1000W<\/li>  <li>Cuchillas de Acero Inoxidable<\/li>  <li>2 Velocidades + turbo<\/li>  <li>Vaso de cristal con capacidad de 1500 ml<\/li>  <li>Pies antideslizantes<\/li>  <li>220-240V<\/li>  <li>50 - 60 Hz<\/li>  <li>De f\u00e1cil limpieza, apto para lavavajillas<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BLAUPUNKT","supplier":null,"width":null,"height":null,"depth":null,"weight":3.3,"unit_price":33.63,"unit_price_tax":33.63,"tax_rules_group":null,"category":"Cocina","sub_category":"Batidoras","quantity":2,"brand":"BLAUPUNKT","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_blp-pae-bat%20bp-4002_1.jpg"],"wholesale_price":28.63}}},"8435484041331":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484041331",false],"wholesale_price":[237.91,false],"price":[242.91,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 12.5",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:85949","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/f140c057458f2021098efbfa18aa361f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Robot de Cocina Cecotec Mambo 10090\/ 1700W\/ Capacidad 3.3L","category":"Cocina","sub_category":"Robots de Cocina","unit_price":242.91,"reference":"6214133","ean13":"8435484041331","weight":"12.5","quantity":0,"brand":"CECOTEC","description_pt":"                                                                                                <p><br><h2>MAMBO 10090, UNA AUT\u00c9NTICA REVOLUCI\u00d3N CULINARIA<\/h2>Mambo, el robot que cocina con cuchara, ha echado toda la carne a su jarra y vuelve con un objetivo revolucionario muy claro, que en cualquier hogar del mundo se pueda disfrutar de la alta cocina sin apenas mover un dedo. \u00bfTe parece imposible? El modelo Mambo 10090 incluye una intuitiva App con la que podr\u00e1s cocinar un universo de recetas de forma f\u00e1cil y con gu\u00eda paso a paso. Adem\u00e1s, cuenta con la jarra Habana con revestimiento cer\u00e1mico extremadamente antiadherente dise\u00f1ada para lograr la excelencia en aquellas elaboraciones m\u00e1s delicadas y una b\u00e1scula incorporada para trabajar con cantidades exactas y no dejar nada a la improvisaci\u00f3n.<br><br><ul>  <li>Robot de cocina multifunci\u00f3n con 30 funciones: trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo.<\/li>  <li>Disfruta de la App Mambo para smartphone con recetas ilimitadas guiadas paso a paso, modos predefinidos para facilitar su uso y sistema manual DIY.<\/li>  <li>Jarra independiente de acero inoxidable con revestimiento cer\u00e1mico con elevada antiadherencia para lograr resultados excelentes en las elaboraciones m\u00e1s delicadas.<\/li>  <li>Incorpora b\u00e1scula para pesar con gran precisi\u00f3n los alimentos depositados en la jarra con el fin de trabajar con cantidades exactas y obtener resultados excelentes.<\/li>  <li>Jarra de acero inoxidable de alta calidad apta para una limpieza r\u00e1pida y f\u00e1cil en el lavavajillas.<\/li>  <li>Su velocidad cero permite cocer y sofre\u00edr sin necesidad de poner velocidad, como si de una cazuela o una sart\u00e9n se tratase. Y, adem\u00e1s, con la ventaja de cocinar sin tapa.<\/li>  <li>La innovadora funci\u00f3n Sofrito a una temperatura superior cuando desees utilizarla para dorar los alimentos, se consigue con la mayor temperatura y la m\u00e1xima potencia.<\/li>  <li>Exclusiva cuchara MamboMix para amasar. Al no cortar la masa logra que sean m\u00e1s homog\u00e9neas y tengan un mayor volumen.<\/li>  <li>La jarra cuenta con una gran capacidad m\u00e1xima de hasta 3,3 litros para que no se tengan que repetir las elaboraciones cuando hay invitados en casa.<\/li>  <li>Cestillo de hervir para poder preparar hasta 4 elaboraciones al mismo tiempo. Cocinar en la jarra, en el cestillo y en la vaporera a dos niveles es ideal para ahorrar tiempo en la cocina.<\/li>  <li>Incluye un completo recetario y acceso a la comunidad social interactiva y a todas las recetas nuevas semanales de Cecotec.<\/li>  <li>El sistema inteligente de potencia calor\u00edfica oscila de 0 a 10 niveles simulando un fuego tradicional con llama suave, media o fuerte. Evita sobrecalentamiento e impide que los alimentos se peguen o se quemen.<\/li>  <li>Motor con doble engranaje que aprovecha, sin esfuerzo, su rendimiento tanto en altas como en bajas velocidades.<\/li>  <li>Movimiento SlowMambo que permite cocinar a baja temperatura lentamente mientras remueve constantemente con la cuchara MamboMix de forma tradicional. Consigue los sabores m\u00e1s intensos.<\/li>  <li>El tap\u00f3n dosificador cuenta con un cierre de seguridad espec\u00edfico para triturar o dar golpes de turbo sin riesgo de salpicaduras.<\/li>  <li>Completamente personalizable en todos los par\u00e1metros para ofrecer infinidad de posibilidades en la cocina diaria. Es posible programar tiempo, velocidad, temperatura, potencia de calor y turbo como se desee.<\/li>  <li>La mariposa dispone de un refuerzo de silicona en la parte final para reba\u00f1ar mejor la base de la jarra y ofrecer un mejor resultado.<\/li>  <li>Incorpora una vaporera de dos niveles con gran capacidad para poder cocinar al vapor sin l\u00edmites. El accesorio se ensambla sin la tapa de la jarra para poder cocer al vapor una mayor superficie.<\/li>  <li>Cuenta con Security Check System uno de los sistemas de seguridad m\u00e1s avanzados para poner y quitar las cuchillas f\u00e1cilmente sin riesgo.<\/li>  <li>Gran pantalla digital altamente intuitiva con panel de control t\u00e1ctil para una mejor usabilidad.<\/li>  <li>Dispone de 10 velocidades y temporizador ajustable desde 1 segundo hasta 12 horas. La temperatura es ajustable grado a grado desde 37 \u00baC hasta 120 \u00baC.<\/li>  <li>Esp\u00e1tula recubierta de silicona para ayudar a extraer f\u00e1cilmente toda la elaboraci\u00f3n de la jarra o remover si es necesario.<\/li><\/ul><h2>COCINA TODO TIPO DE RECETAS CON 30 FUNCIONES<\/h2><p>Mambo es la combinaci\u00f3n de 11 dispositivos de cocina. Gracias a sus 30 funciones puedes cocinar todo tipo de recetas, de forma f\u00e1cil para sorprender a tus invitados con unas elaboraciones dignas de chef: trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo<\/p><h2>CONECTA CON TU CHEF INTERIOR<\/h2><p>Con Mambo 10090 podr\u00e1s convertirte en una gran chef desde el sof\u00e1 mientras ves tu serie favorita. Cuenta con la intuitiva App Mambo, una nueva experiencia de uso comod\u00edsima con la que podr\u00e1s cocinar un universo de recetas f\u00e1cilmente e interactuar con el robot en tiempo real. Navega e insp\u00edrate con m\u00e1s de 200 suculentas recetas, gu\u00e1rdalas y gestiona todo tu cocinado desde el m\u00f3vil cuando t\u00fa quieras. Sigue las recetas paso a paso, recibe alertas push durante la elaboraci\u00f3n y prepara deliciosos platos incluso sin saber nada de cocina. Adem\u00e1s, cuenta con un sistema manual DIY para que los m\u00e1s expertos configuren la receta a su gusto y permite guardar las recetas que m\u00e1s te gusten y compartirlas con los que m\u00e1s quieres, ya que desde la App Mambo tambi\u00e9n puedes conectarte e interactuar con el robot de tu madre, de tu t\u00edo, amigos...<\/p><h2>JARRA HABANA PARA TUS ELABORACIONES M\u00c1S DELICADAS<\/h2><p>Ciertos alimentos requieren de una delicadeza especial y esta es la jarra perfecta para ellos. Es independiente, de acero inoxidable y con revestimiento cer\u00e1mico de elevada antiadherencia, lo que consigue resultados excelentes en tus elaboraciones m\u00e1s delicadas. La especialista en risottos, chocolates, natillas, guisos, masas...<\/p><h2>M\u00c1XIMA PRECISI\u00d3N EN TUS RECETAS<\/h2><p>Mambo 10090 tiene incorporada una b\u00e1scula de gran precisi\u00f3n que pesa los alimentos que depositas en la jarra. Ahorrando espacio, tiempo de limpieza y ganando en comodidad al no tener que usar aparatos adicionales para ello. Podr\u00e1s trabajar f&#180;acilmente con cantidades exactas y obtener resultados excelentes, especialmente en las recetas de reposter\u00eda m\u00e1s delicadas.<\/p><h2>JARRA DE ACERO INOXIDABLE APTA PARA LAVAVAJILLAS<\/h2><p>Mambo te lo hace todo c\u00f3modo. Su jarra de acero inoxidable es de alta calidad y resistente al agua, por lo que cuando acabes tus recetas el lavavajillas trabajar\u00e1 por ti, ya que esta jarra es apta para una limpieza r\u00e1pida y f\u00e1cil en el lavavajillas, retirando siempre previamente las cuchillas. Es la jarra que puede con todo, perfecta para emulsionar, triturar, montar, pulverizar e incluso hasta picar hielo. Cuenta con una gran capacidad m\u00e1xima de hasta 3,3 litros para que no tengas que preocuparte de repetir las elaboraciones cuando hay invitados en casa.<\/p><h2>COCINA SIN TAPA COMO EN UNA OLLA O SART\u00c9N TRADICIONAL<\/h2><p>Una de las funciones m\u00e1s destacables de Mambo 10090, es la llamada &#8220;Velocidad cero&#8221;. Cuece, hierve o sofr\u00ede sin necesidad de poner velocidad, como har\u00edas con una olla o sart\u00e9n. Adem\u00e1s, con la ventaja de cocinar sin tapa para controlar la elaboraci\u00f3n en todo momento. Podr\u00e1s preparar c\u00f3modamente unos jugosos espaguetis o sabrosos sofritos.<\/p><h2>COCINA CON CUCHARA: AMASA Y REMUEVE SIN CORTAR<\/h2><p>Mambo es el \u00fanico robot de cocina multifunci\u00f3n que cuenta con la exclusiva cuchara MamboMix, cuchara dise\u00f1ada por Mambo, que junto con el motor superpotente que aprovecha el rendimiento tanto en altas como en bajas velocidades, forman la mejor combinaci\u00f3n entre potencia y delicadeza. Gracias a ello, Mambo es capaz tanto de remover lentamente tus guisos, risottos, cremas y pastas, como de amasar masas grandes sin cortarlas, logrando masas perfectas y m\u00e1s homog\u00e9neas. Adem\u00e1s, Mambo cuenta con el movimiento SlowMambo que aprovecha la cuchara MamboMix para remover constantemente las elaboraciones a baja temperatura, consiguiendo unos sabores m\u00e1s intensos en los platos m\u00e1s tradicionales. El robot de cocina que mima tus elaboraciones.<\/p><h2>PREPARA HASTA 4 ELABORACIONES A LA VEZ<\/h2><p>El modelo Mambo 10090 incluye un cestillo de hervir. Con \u00e9l, son 4 las elaboraciones simult\u00e1neas que puedes preparar. Podr\u00e1s cocinar en la jarra, a la vez que en el cestillo y en la vaporera a dos niveles. Esta es otra de las cosas incre\u00edbles que puedes hacer con este robot, ahorrando tiempo y esfuerzo para que disfrutes de todas tus elaboraciones reci\u00e9n hechas y a la vez.<\/p><h2>UNIVERSO DE RECETAS Y FANT\u00c1STICA COMUNIDAD ONLINE<\/h2><p>Adem\u00e1s del completo recetario que incluye, Cecotec prepara cada semana nuevas recetas que puedes seguir en la plataforma online (YouTube, blog, App&#8230;) No pierdas de vista la comunidad social interactiva, es una gran fuente donde amantes de la cocina comparten y descubren infinidad de recetas.<\/p><ul>  <li>    <h2>FICHA T\u00c9CNICA<\/h2>  <\/li>  <li>Marca: Cecotec<\/li>  <li>Modelo: Mambo 10090<\/li>  <li>Descripci\u00f3n: Robot de cocina con App, 30 funciones, jarra Habana con revestimiento cer\u00e1mico, b\u00e1scula y jarra de acero inoxidable apta para lavavajillas.<\/li>  <li>Temperatura: 37\u00aa - 120\u00baC<\/li>  <li>Capacidad: 3,3 litros<\/li>  <li>Material de la jarra: Acero Inoxidable<\/li>  <li>Material del revestimiento de la jarra Habana: Cer\u00e1mica<\/li>  <li>Peso: 5,2 kg<\/li>  <li>Medidas: 39,5 x 25 x 33 cm<\/li>  <li>Voltaje: 220-240 V<\/li>  <li>Potencia: 1700 W<\/li>  <li>App: S\u00ed<\/li>  <li>Recetario: S\u00ed<\/li>  <li>Accesorios: Robot de cocina Mambo, Cuchara MamboMix, Jarra Habana con revestimiento cer\u00e1mico, Cestillo de hervir, Mariposa, Vaporera de dos niveles, Esp\u00e1tula, Recetario y Manual de instrucciones<\/li>  <li><b>CONTENIDO<\/b><\/li>  <li>Robot de cocina Mambo<\/li>  <li>Cuchara MamboMix<\/li>  <li>Jarra Habana con revestimiento cer\u00e1mico<\/li>  <li>Cestillo de hervir<\/li>  <li>Mariposa<\/li>  <li>Vaporera de dos niveles<\/li>  <li>Esp\u00e1tula<\/li>  <li>Recetario<\/li>  <li>Manual de instrucciones<\/li><\/ul><br><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-robot%20mambo%2010090_1.jpg","wholesale_price":"237.91","unit_price_tax":242.91},"product_model":{"product_data":{"ean13":["8435484041331"],"reference":"6214133","name":{"1":"Robot de Cocina Cecotec Mambo 10090\/ 1700W\/ Capacidad 3.3L","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><br><h2>MAMBO 10090, UNA AUT\u00c9NTICA REVOLUCI\u00d3N CULINARIA<\/h2>Mambo, el robot que cocina con cuchara, ha echado toda la carne a su jarra y vuelve con un objetivo revolucionario muy claro, que en cualquier hogar del mundo se pueda disfrutar de la alta cocina sin apenas mover un dedo. \u00bfTe parece imposible? El modelo Mambo 10090 incluye una intuitiva App con la que podr\u00e1s cocinar un universo de recetas de forma f\u00e1cil y con gu\u00eda paso a paso. Adem\u00e1s, cuenta con la jarra Habana con revestimiento cer\u00e1mico extremadamente antiadherente dise\u00f1ada para lograr la excelencia en aquellas elaboraciones m\u00e1s delicadas y una b\u00e1scula incorporada para trabajar con cantidades exactas y no dejar nada a la improvisaci\u00f3n.<br><br><ul>  <li>Robot de cocina multifunci\u00f3n con 30 funciones: trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo.<\/li>  <li>Disfruta de la App Mambo para smartphone con recetas ilimitadas guiadas paso a paso, modos predefinidos para facilitar su uso y sistema manual DIY.<\/li>  <li>Jarra independiente de acero inoxidable con revestimiento cer\u00e1mico con elevada antiadherencia para lograr resultados excelentes en las elaboraciones m\u00e1s delicadas.<\/li>  <li>Incorpora b\u00e1scula para pesar con gran precisi\u00f3n los alimentos depositados en la jarra con el fin de trabajar con cantidades exactas y obtener resultados excelentes.<\/li>  <li>Jarra de acero inoxidable de alta calidad apta para una limpieza r\u00e1pida y f\u00e1cil en el lavavajillas.<\/li>  <li>Su velocidad cero permite cocer y sofre\u00edr sin necesidad de poner velocidad, como si de una cazuela o una sart\u00e9n se tratase. Y, adem\u00e1s, con la ventaja de cocinar sin tapa.<\/li>  <li>La innovadora funci\u00f3n Sofrito a una temperatura superior cuando desees utilizarla para dorar los alimentos, se consigue con la mayor temperatura y la m\u00e1xima potencia.<\/li>  <li>Exclusiva cuchara MamboMix para amasar. Al no cortar la masa logra que sean m\u00e1s homog\u00e9neas y tengan un mayor volumen.<\/li>  <li>La jarra cuenta con una gran capacidad m\u00e1xima de hasta 3,3 litros para que no se tengan que repetir las elaboraciones cuando hay invitados en casa.<\/li>  <li>Cestillo de hervir para poder preparar hasta 4 elaboraciones al mismo tiempo. Cocinar en la jarra, en el cestillo y en la vaporera a dos niveles es ideal para ahorrar tiempo en la cocina.<\/li>  <li>Incluye un completo recetario y acceso a la comunidad social interactiva y a todas las recetas nuevas semanales de Cecotec.<\/li>  <li>El sistema inteligente de potencia calor\u00edfica oscila de 0 a 10 niveles simulando un fuego tradicional con llama suave, media o fuerte. Evita sobrecalentamiento e impide que los alimentos se peguen o se quemen.<\/li>  <li>Motor con doble engranaje que aprovecha, sin esfuerzo, su rendimiento tanto en altas como en bajas velocidades.<\/li>  <li>Movimiento SlowMambo que permite cocinar a baja temperatura lentamente mientras remueve constantemente con la cuchara MamboMix de forma tradicional. Consigue los sabores m\u00e1s intensos.<\/li>  <li>El tap\u00f3n dosificador cuenta con un cierre de seguridad espec\u00edfico para triturar o dar golpes de turbo sin riesgo de salpicaduras.<\/li>  <li>Completamente personalizable en todos los par\u00e1metros para ofrecer infinidad de posibilidades en la cocina diaria. Es posible programar tiempo, velocidad, temperatura, potencia de calor y turbo como se desee.<\/li>  <li>La mariposa dispone de un refuerzo de silicona en la parte final para reba\u00f1ar mejor la base de la jarra y ofrecer un mejor resultado.<\/li>  <li>Incorpora una vaporera de dos niveles con gran capacidad para poder cocinar al vapor sin l\u00edmites. El accesorio se ensambla sin la tapa de la jarra para poder cocer al vapor una mayor superficie.<\/li>  <li>Cuenta con Security Check System uno de los sistemas de seguridad m\u00e1s avanzados para poner y quitar las cuchillas f\u00e1cilmente sin riesgo.<\/li>  <li>Gran pantalla digital altamente intuitiva con panel de control t\u00e1ctil para una mejor usabilidad.<\/li>  <li>Dispone de 10 velocidades y temporizador ajustable desde 1 segundo hasta 12 horas. La temperatura es ajustable grado a grado desde 37 \u00baC hasta 120 \u00baC.<\/li>  <li>Esp\u00e1tula recubierta de silicona para ayudar a extraer f\u00e1cilmente toda la elaboraci\u00f3n de la jarra o remover si es necesario.<\/li><\/ul><h2>COCINA TODO TIPO DE RECETAS CON 30 FUNCIONES<\/h2><p>Mambo es la combinaci\u00f3n de 11 dispositivos de cocina. Gracias a sus 30 funciones puedes cocinar todo tipo de recetas, de forma f\u00e1cil para sorprender a tus invitados con unas elaboraciones dignas de chef: trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo<\/p><h2>CONECTA CON TU CHEF INTERIOR<\/h2><p>Con Mambo 10090 podr\u00e1s convertirte en una gran chef desde el sof\u00e1 mientras ves tu serie favorita. Cuenta con la intuitiva App Mambo, una nueva experiencia de uso comod\u00edsima con la que podr\u00e1s cocinar un universo de recetas f\u00e1cilmente e interactuar con el robot en tiempo real. Navega e insp\u00edrate con m\u00e1s de 200 suculentas recetas, gu\u00e1rdalas y gestiona todo tu cocinado desde el m\u00f3vil cuando t\u00fa quieras. Sigue las recetas paso a paso, recibe alertas push durante la elaboraci\u00f3n y prepara deliciosos platos incluso sin saber nada de cocina. Adem\u00e1s, cuenta con un sistema manual DIY para que los m\u00e1s expertos configuren la receta a su gusto y permite guardar las recetas que m\u00e1s te gusten y compartirlas con los que m\u00e1s quieres, ya que desde la App Mambo tambi\u00e9n puedes conectarte e interactuar con el robot de tu madre, de tu t\u00edo, amigos...<\/p><h2>JARRA HABANA PARA TUS ELABORACIONES M\u00c1S DELICADAS<\/h2><p>Ciertos alimentos requieren de una delicadeza especial y esta es la jarra perfecta para ellos. Es independiente, de acero inoxidable y con revestimiento cer\u00e1mico de elevada antiadherencia, lo que consigue resultados excelentes en tus elaboraciones m\u00e1s delicadas. La especialista en risottos, chocolates, natillas, guisos, masas...<\/p><h2>M\u00c1XIMA PRECISI\u00d3N EN TUS RECETAS<\/h2><p>Mambo 10090 tiene incorporada una b\u00e1scula de gran precisi\u00f3n que pesa los alimentos que depositas en la jarra. Ahorrando espacio, tiempo de limpieza y ganando en comodidad al no tener que usar aparatos adicionales para ello. Podr\u00e1s trabajar f&#180;acilmente con cantidades exactas y obtener resultados excelentes, especialmente en las recetas de reposter\u00eda m\u00e1s delicadas.<\/p><h2>JARRA DE ACERO INOXIDABLE APTA PARA LAVAVAJILLAS<\/h2><p>Mambo te lo hace todo c\u00f3modo. Su jarra de acero inoxidable es de alta calidad y resistente al agua, por lo que cuando acabes tus recetas el lavavajillas trabajar\u00e1 por ti, ya que esta jarra es apta para una limpieza r\u00e1pida y f\u00e1cil en el lavavajillas, retirando siempre previamente las cuchillas. Es la jarra que puede con todo, perfecta para emulsionar, triturar, montar, pulverizar e incluso hasta picar hielo. Cuenta con una gran capacidad m\u00e1xima de hasta 3,3 litros para que no tengas que preocuparte de repetir las elaboraciones cuando hay invitados en casa.<\/p><h2>COCINA SIN TAPA COMO EN UNA OLLA O SART\u00c9N TRADICIONAL<\/h2><p>Una de las funciones m\u00e1s destacables de Mambo 10090, es la llamada &#8220;Velocidad cero&#8221;. Cuece, hierve o sofr\u00ede sin necesidad de poner velocidad, como har\u00edas con una olla o sart\u00e9n. Adem\u00e1s, con la ventaja de cocinar sin tapa para controlar la elaboraci\u00f3n en todo momento. Podr\u00e1s preparar c\u00f3modamente unos jugosos espaguetis o sabrosos sofritos.<\/p><h2>COCINA CON CUCHARA: AMASA Y REMUEVE SIN CORTAR<\/h2><p>Mambo es el \u00fanico robot de cocina multifunci\u00f3n que cuenta con la exclusiva cuchara MamboMix, cuchara dise\u00f1ada por Mambo, que junto con el motor superpotente que aprovecha el rendimiento tanto en altas como en bajas velocidades, forman la mejor combinaci\u00f3n entre potencia y delicadeza. Gracias a ello, Mambo es capaz tanto de remover lentamente tus guisos, risottos, cremas y pastas, como de amasar masas grandes sin cortarlas, logrando masas perfectas y m\u00e1s homog\u00e9neas. Adem\u00e1s, Mambo cuenta con el movimiento SlowMambo que aprovecha la cuchara MamboMix para remover constantemente las elaboraciones a baja temperatura, consiguiendo unos sabores m\u00e1s intensos en los platos m\u00e1s tradicionales. El robot de cocina que mima tus elaboraciones.<\/p><h2>PREPARA HASTA 4 ELABORACIONES A LA VEZ<\/h2><p>El modelo Mambo 10090 incluye un cestillo de hervir. Con \u00e9l, son 4 las elaboraciones simult\u00e1neas que puedes preparar. Podr\u00e1s cocinar en la jarra, a la vez que en el cestillo y en la vaporera a dos niveles. Esta es otra de las cosas incre\u00edbles que puedes hacer con este robot, ahorrando tiempo y esfuerzo para que disfrutes de todas tus elaboraciones reci\u00e9n hechas y a la vez.<\/p><h2>UNIVERSO DE RECETAS Y FANT\u00c1STICA COMUNIDAD ONLINE<\/h2><p>Adem\u00e1s del completo recetario que incluye, Cecotec prepara cada semana nuevas recetas que puedes seguir en la plataforma online (YouTube, blog, App&#8230;) No pierdas de vista la comunidad social interactiva, es una gran fuente donde amantes de la cocina comparten y descubren infinidad de recetas.<\/p><ul>  <li>    <h2>FICHA T\u00c9CNICA<\/h2>  <\/li>  <li>Marca: Cecotec<\/li>  <li>Modelo: Mambo 10090<\/li>  <li>Descripci\u00f3n: Robot de cocina con App, 30 funciones, jarra Habana con revestimiento cer\u00e1mico, b\u00e1scula y jarra de acero inoxidable apta para lavavajillas.<\/li>  <li>Temperatura: 37\u00aa - 120\u00baC<\/li>  <li>Capacidad: 3,3 litros<\/li>  <li>Material de la jarra: Acero Inoxidable<\/li>  <li>Material del revestimiento de la jarra Habana: Cer\u00e1mica<\/li>  <li>Peso: 5,2 kg<\/li>  <li>Medidas: 39,5 x 25 x 33 cm<\/li>  <li>Voltaje: 220-240 V<\/li>  <li>Potencia: 1700 W<\/li>  <li>App: S\u00ed<\/li>  <li>Recetario: S\u00ed<\/li>  <li>Accesorios: Robot de cocina Mambo, Cuchara MamboMix, Jarra Habana con revestimiento cer\u00e1mico, Cestillo de hervir, Mariposa, Vaporera de dos niveles, Esp\u00e1tula, Recetario y Manual de instrucciones<\/li>  <li><b>CONTENIDO<\/b><\/li>  <li>Robot de cocina Mambo<\/li>  <li>Cuchara MamboMix<\/li>  <li>Jarra Habana con revestimiento cer\u00e1mico<\/li>  <li>Cestillo de hervir<\/li>  <li>Mariposa<\/li>  <li>Vaporera de dos niveles<\/li>  <li>Esp\u00e1tula<\/li>  <li>Recetario<\/li>  <li>Manual de instrucciones<\/li><\/ul><br><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CECOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":12.5,"unit_price":242.91,"unit_price_tax":242.91,"tax_rules_group":null,"category":"Cocina","sub_category":"Robots de Cocina","quantity":0,"brand":"CECOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-robot%20mambo%2010090_1.jpg"],"wholesale_price":237.91}}},"8435484041508":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484041508",false],"wholesale_price":[174.27,false],"price":[179.27,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 12.75",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:85950","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/396817179fa52cf4b33f18ae82875447.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Robot de Cocina Cecotec Mambo 9590\/ 1700W\/ Capacidad 3.3L","category":"Cocina","sub_category":"Robots de Cocina","unit_price":179.27,"reference":"6214150","ean13":"8435484041508","weight":"12.75","quantity":2,"brand":"CECOTEC","description_pt":"<p>Prep\u00e1rate para disfrutar con tu familia y amigos de exquisitos men\u00fas de la manera m\u00e1s r\u00e1pida y sencilla. Incluye la jarra Habana con revestimiento cer\u00e1mico extremadamente antiadherente dise\u00f1ada para lograr la excelencia en aquellas elaboraciones m\u00e1s delicadas. Adem\u00e1s, cuenta con b\u00e1scula incorporada para trabajar con cantidades exactas y no dejar nada a la improvisaci\u00f3n. El \u00fanico robot de cocina con la exclusiva cuchara MamboMix que remueve y amasa para conseguir resultados excelentes en las elaboraciones. Gracias a su 30 funciones no habr\u00e1 receta que se te resista. La jarra de acero inoxidable de 3,3 litros de capacidad apta para la limpieza en el lavavajillas, la velocidad cero, el cestillo de hervir para cocinar a 4 niveles y el completo recetario son algunas de las ventajas que hacen el robot de cocina multifunci\u00f3n Mambo 9590 \u00fanico.<br><\/p><h2>MIMA TUS ELABORACIONES CON MAMBO<\/h2>Descubre una nueva forma de disfrutar de tu cocina. Mambo te lo pone f\u00e1cil y te abre las puertas a todo un mundo de recetas donde hasta la elaboraci\u00f3n m\u00e1s delicada, ser\u00e1 todo un \u00e9xito. Cocina con cuchara y mima tus elaboraciones con MamboMix y su jarra con revestimiento cer\u00e1mico extremadamente antiadherente.<br><h2>COCINA CON CUCHARA<\/h2>Mambo cocina con la exclusiva cuchara MamboMix, cuchara dise\u00f1ada por Mambo, que junto con el motor superpotente que aprovecha el rendimiento tanto en altas como en bajas velocidades, forman la mejor combinaci\u00f3n entre potencia y delicadeza. Gracias a ello, Mambo es capaz tanto de remover lentamente tus guisos, risottos, cremas y pastas, como de amasar masas grandes sin cortarlas, logrando masas perfectas y m\u00e1s homog\u00e9neas.<br><h2>EL ROBOT DE COCINA CON M\u00c1S FUNCIONES DEL MERCADO<\/h2>Con sus 30 funciones no habr\u00e1 receta que se te resista. Trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo.<br><h2>JARRA HABANA PARA TUS ELABORACIONES M\u00c1S DELICADAS<\/h2>Risottos, natillas, guisos, masas&#8230; Ciertos alimentos requieren de una delicadeza especial y esta es la jarra perfecta para ellos. Es independiente, de acero inoxidable y con revestimiento cer\u00e1mico de elevada antiadherencia, lo que consigue resultados excelentes en tus elaboraciones m\u00e1s delicadas.<br><h2>EL SABOR DE LA PRECISI\u00d3N<\/h2>Mambo 9590 tiene incorporada una b\u00e1scula de gran precisi\u00f3n que pesa los alimentos que depositas en la jarra. Adem\u00e1s de las ventajas de espacio, limpieza y comodidad que supone el no tener que usar aparatos adicionales para ello, podr\u00e1s trabajar con cantidades exactas y obtener resultados excelentes.<br><h2>JARRA DE ACERO INOXIDABLE APTA PARA LAVAVAJILLAS<\/h2>Mambo te lo hace todo c\u00f3modo. Su jarra de acero inoxidable es de alta calidad y resistente al agua. Cuando acabes tus recetas solo tendr\u00e1s que preocuparte de saborearlas y disfrutarlas con tu familia y amigos, el lavavajillas trabajar\u00e1 por ti y dejar\u00e1 la jarra como nueva para el siguiente uso.<br><h2>COCINA SIN TAPA<\/h2>Una de las funciones a destacar de Mambo 9590, es la llamada velocidad cero. Con esta funci\u00f3n, podr\u00e1s cocer, hervir o sofre\u00edr sin necesidad de poner velocidad, como har\u00edas con una olla o sart\u00e9n. Y, adem\u00e1s, con la ventaja de cocinar sin tapa.<br><h2>M\u00c1XIMO SABOR EN TUS SOFRITOS<\/h2>Si eres un amante de ese punto dorado tan apetecible en los sofritos, la funci\u00f3n sofrito est\u00e1 hecha para ti. \u00danicamente emplea una temperatura superior cuando desees utilizarla, ese punto se consigue con la mayor temperatura y m\u00e1xima potencia.<br><h2>JARRA DE 3,3 L DE CAPACIDAD M\u00c1XIMA<\/h2>Su jarra de acero inoxidable de alta calidad tiene una capacidad m\u00e1xima de 3,3 litros, para que no tengas que preocuparte de repetir elaboraciones cuando hay invitados en casa.<br><h2>HASTA 4 ELABORACIONES A LA VEZ<\/h2>Mambo 9590 incluye un cestillo de hervir. Con \u00e9l, son 4 las elaboraciones simult\u00e1neas que puedes preparar. Podr\u00e1s cocinar en la jarra, a la vez que en el cestillo y en la vaporera a dos niveles. Ahorrar\u00e1s tiempo, esfuerzo, y disfrutar\u00e1s de todas tus elaboraciones reci\u00e9n hechas.<br><h2>UN SINF\u00cdN DE RECETAS Y FANT\u00c1STICA COMUNIDAD ONLINE<\/h2>Adem\u00e1s del completo recetario que incluye, Cecotec prepara cada semana nuevas recetas que puedes seguir en la plataforma online. No pierdas de vista la comunidad social interactiva, es una gran fuente donde amantes de la cocina comparten y descubren infinidad de recetas.<br><h2>POTENCIA CALOR\u00cdFICA INTELIGENTE<\/h2>El sistema inteligente de potencia calor\u00edfica oscila de 0 a 10 niveles. Gracias a este sistema se consiguen estupendos resultados, simula un fuego tradicional con llama suave, media o fuerte, lo que evita el sobrecalentamiento e impide que los alimentos se peguen o quemen. La Mambo 9590 logra la excelencia en todas sus elaboraciones.<br><br><p><h2>Mambo 9590<\/h2>Cecotec robot de cocina multifunci\u00f3n Mambo 9590 con exclusiva cuchara MamboMix, Jarra Habana con revestimiento cer\u00e1mico, 30 funciones, b\u00e1scula incorporada, jarra de acero inoxidable de 3,3 litros apta para lavavajillas, velocidad cero, cestillo de hervir para cocinar a 4 niveles y completo recetario.<\/p><ul><li>Robot de cocina multifunci\u00f3n con 30 funciones: trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo.<\/li><li>Jarra Habana independiente de acero inoxidable con revestimiento cer\u00e1mico con elevada antiadherencia para lograr resultados excelentes en las elaboraciones m\u00e1s delicadas.<\/li><li>Incorpora b\u00e1scula para pesar con gran precisi\u00f3n los alimentos depositados en la jarra con el fin de trabajar con cantidades exactas y obtener resultados excelentes.<\/li><li>Jarra de acero inoxidable de alta calidad apta para una limpieza r\u00e1pida y f\u00e1cil en el lavavajillas.<\/li><li>Su velocidad cero permite cocer y sofre\u00edr sin necesidad de poner velocidad, como si de una cazuela o una sart\u00e9n se tratase. Y, adem\u00e1s, con la ventaja de cocinar sin tapa.<\/li><li>La innovadora funci\u00f3n sofrito a una temperatura superior cuando desees utilizarla para dorar los alimentos, se consigue con la mayor temperatura y la m\u00e1xima potencia.<\/li><li>Exclusiva cuchara MamboMix para amasar. Al no cortar la masa logra que sean m\u00e1s homog\u00e9neas y tengan un mayor volumen.<\/li><li>La jarra cuenta con una gran capacidad m\u00e1xima de hasta 3,3 litros para que no se tengan que repetir las elaboraciones cuando hay invitados en casa.<\/li><li>Cestillo de hervir para poder preparar hasta 4 elaboraciones al mismo tiempo. Cocinar en la jarra, en el cestillo y en la vaporera a dos niveles es ideal para ahorrar tiempo en la cocina.<\/li><li>Incluye un completo recetario y acceso a la comunidad social interactiva y a todas las recetas nuevas semanales de Cecotec.<\/li><li>El sistema inteligente de potencia calor\u00edfica oscila de 0 a 10 niveles simulando un fuego tradicional con llama suave, media o fuerte. Evita sobrecalentamiento e impide que los alimentos se peguen o se quemen.<\/li><li>Motor con doble engranaje que aprovecha, sin esfuerzo, su rendimiento tanto en altas como en bajas velocidades.<\/li><li>Movimiento SlowMambo que permite cocinar a baja temperatura lentamente mientras remueve constantemente con la cuchara MamboMix de forma tradicional. Consigue los sabores m\u00e1s intensos.<\/li><li>El tap\u00f3n dosificador cuenta con un cierre de seguridad espec\u00edfico para triturar o dar golpes de Turbo sin riesgo de salpicaduras.<\/li><li>Completamente personalizable en todos los par\u00e1metros para ofrecer infinidad de posibilidades en la cocina diaria. Es posible programar tiempo, velocidad, temperatura, potencia de calor y Turbo como se desee.<\/li><li>La mariposa dispone de un refuerzo de silicona en la parte final para reba\u00f1ar mejor la base de la jarra y ofrecer un mejor resultado.<\/li><li>Incorpora una vaporera de dos niveles con gran capacidad para poder cocinar al vapor sin l\u00edmites. El accesorio se ensambla sin la tapa de la jarra para poder cocer al vapor una mayor superficie.<\/li><li>Cuenta con Security Check System, uno de los sistemas de seguridad m\u00e1s avanzados para poner y quitar las cuchillas f\u00e1cilmente sin riesgo.<\/li><li>Gran pantalla digital altamente intuitiva con panel de control t\u00e1ctil para una mejor usabilidad.<\/li><li>Dispone de 10 velocidades y temporizador ajustable desde 1 segundo hasta 12 horas. La temperatura es ajustable grado a grado desde 37\u00baC hasta 120\u00baC.<\/li><li>Esp\u00e1tula recubierta de silicona para ayudar a extraer f\u00e1cilmente toda la elaboraci\u00f3n de la jarra o remover si es necesario.<\/li><li>Potencia&nbsp; 1700 W<\/li><\/ul><h2>Composici\u00f3n<\/h2><ul><li>Robot de cocina Mambo<\/li><li>Cuchara MamboMix<\/li><li>Jarra Habana con revestimiento cer\u00e1mico<\/li><li>Cestillo de hervir<\/li><li>Mariposa<\/li><li>Vaporera de dos niveles<\/li><li>Esp\u00e1tula<\/li><li>Recetario<\/li><li>Manual de instrucciones&nbsp;<\/li><\/ul><br><p><\/p><ul><\/ul><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-robot%20mambo%209590_1.jpg","wholesale_price":"174.27","unit_price_tax":179.27},"product_model":{"product_data":{"ean13":["8435484041508"],"reference":"6214150","name":{"1":"Robot de Cocina Cecotec Mambo 9590\/ 1700W\/ Capacidad 3.3L","2":"","3":"","4":""},"description":{"1":"<p>Prep\u00e1rate para disfrutar con tu familia y amigos de exquisitos men\u00fas de la manera m\u00e1s r\u00e1pida y sencilla. Incluye la jarra Habana con revestimiento cer\u00e1mico extremadamente antiadherente dise\u00f1ada para lograr la excelencia en aquellas elaboraciones m\u00e1s delicadas. Adem\u00e1s, cuenta con b\u00e1scula incorporada para trabajar con cantidades exactas y no dejar nada a la improvisaci\u00f3n. El \u00fanico robot de cocina con la exclusiva cuchara MamboMix que remueve y amasa para conseguir resultados excelentes en las elaboraciones. Gracias a su 30 funciones no habr\u00e1 receta que se te resista. La jarra de acero inoxidable de 3,3 litros de capacidad apta para la limpieza en el lavavajillas, la velocidad cero, el cestillo de hervir para cocinar a 4 niveles y el completo recetario son algunas de las ventajas que hacen el robot de cocina multifunci\u00f3n Mambo 9590 \u00fanico.<br><\/p><h2>MIMA TUS ELABORACIONES CON MAMBO<\/h2>Descubre una nueva forma de disfrutar de tu cocina. Mambo te lo pone f\u00e1cil y te abre las puertas a todo un mundo de recetas donde hasta la elaboraci\u00f3n m\u00e1s delicada, ser\u00e1 todo un \u00e9xito. Cocina con cuchara y mima tus elaboraciones con MamboMix y su jarra con revestimiento cer\u00e1mico extremadamente antiadherente.<br><h2>COCINA CON CUCHARA<\/h2>Mambo cocina con la exclusiva cuchara MamboMix, cuchara dise\u00f1ada por Mambo, que junto con el motor superpotente que aprovecha el rendimiento tanto en altas como en bajas velocidades, forman la mejor combinaci\u00f3n entre potencia y delicadeza. Gracias a ello, Mambo es capaz tanto de remover lentamente tus guisos, risottos, cremas y pastas, como de amasar masas grandes sin cortarlas, logrando masas perfectas y m\u00e1s homog\u00e9neas.<br><h2>EL ROBOT DE COCINA CON M\u00c1S FUNCIONES DEL MERCADO<\/h2>Con sus 30 funciones no habr\u00e1 receta que se te resista. Trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo.<br><h2>JARRA HABANA PARA TUS ELABORACIONES M\u00c1S DELICADAS<\/h2>Risottos, natillas, guisos, masas&#8230; Ciertos alimentos requieren de una delicadeza especial y esta es la jarra perfecta para ellos. Es independiente, de acero inoxidable y con revestimiento cer\u00e1mico de elevada antiadherencia, lo que consigue resultados excelentes en tus elaboraciones m\u00e1s delicadas.<br><h2>EL SABOR DE LA PRECISI\u00d3N<\/h2>Mambo 9590 tiene incorporada una b\u00e1scula de gran precisi\u00f3n que pesa los alimentos que depositas en la jarra. Adem\u00e1s de las ventajas de espacio, limpieza y comodidad que supone el no tener que usar aparatos adicionales para ello, podr\u00e1s trabajar con cantidades exactas y obtener resultados excelentes.<br><h2>JARRA DE ACERO INOXIDABLE APTA PARA LAVAVAJILLAS<\/h2>Mambo te lo hace todo c\u00f3modo. Su jarra de acero inoxidable es de alta calidad y resistente al agua. Cuando acabes tus recetas solo tendr\u00e1s que preocuparte de saborearlas y disfrutarlas con tu familia y amigos, el lavavajillas trabajar\u00e1 por ti y dejar\u00e1 la jarra como nueva para el siguiente uso.<br><h2>COCINA SIN TAPA<\/h2>Una de las funciones a destacar de Mambo 9590, es la llamada velocidad cero. Con esta funci\u00f3n, podr\u00e1s cocer, hervir o sofre\u00edr sin necesidad de poner velocidad, como har\u00edas con una olla o sart\u00e9n. Y, adem\u00e1s, con la ventaja de cocinar sin tapa.<br><h2>M\u00c1XIMO SABOR EN TUS SOFRITOS<\/h2>Si eres un amante de ese punto dorado tan apetecible en los sofritos, la funci\u00f3n sofrito est\u00e1 hecha para ti. \u00danicamente emplea una temperatura superior cuando desees utilizarla, ese punto se consigue con la mayor temperatura y m\u00e1xima potencia.<br><h2>JARRA DE 3,3 L DE CAPACIDAD M\u00c1XIMA<\/h2>Su jarra de acero inoxidable de alta calidad tiene una capacidad m\u00e1xima de 3,3 litros, para que no tengas que preocuparte de repetir elaboraciones cuando hay invitados en casa.<br><h2>HASTA 4 ELABORACIONES A LA VEZ<\/h2>Mambo 9590 incluye un cestillo de hervir. Con \u00e9l, son 4 las elaboraciones simult\u00e1neas que puedes preparar. Podr\u00e1s cocinar en la jarra, a la vez que en el cestillo y en la vaporera a dos niveles. Ahorrar\u00e1s tiempo, esfuerzo, y disfrutar\u00e1s de todas tus elaboraciones reci\u00e9n hechas.<br><h2>UN SINF\u00cdN DE RECETAS Y FANT\u00c1STICA COMUNIDAD ONLINE<\/h2>Adem\u00e1s del completo recetario que incluye, Cecotec prepara cada semana nuevas recetas que puedes seguir en la plataforma online. No pierdas de vista la comunidad social interactiva, es una gran fuente donde amantes de la cocina comparten y descubren infinidad de recetas.<br><h2>POTENCIA CALOR\u00cdFICA INTELIGENTE<\/h2>El sistema inteligente de potencia calor\u00edfica oscila de 0 a 10 niveles. Gracias a este sistema se consiguen estupendos resultados, simula un fuego tradicional con llama suave, media o fuerte, lo que evita el sobrecalentamiento e impide que los alimentos se peguen o quemen. La Mambo 9590 logra la excelencia en todas sus elaboraciones.<br><br><p><h2>Mambo 9590<\/h2>Cecotec robot de cocina multifunci\u00f3n Mambo 9590 con exclusiva cuchara MamboMix, Jarra Habana con revestimiento cer\u00e1mico, 30 funciones, b\u00e1scula incorporada, jarra de acero inoxidable de 3,3 litros apta para lavavajillas, velocidad cero, cestillo de hervir para cocinar a 4 niveles y completo recetario.<\/p><ul><li>Robot de cocina multifunci\u00f3n con 30 funciones: trocea, pica, licua, tritura, sofr\u00ede, muele, pulveriza, ralla, recalienta, bate, yogurtera, monta, emulsiona, mezcla, cocina, remueve, cocina al vapor, escalfa, confita, amasa, cocina a baja temperatura, hierve, mantiene caliente, fermenta, SlowMambo, cocina con precisi\u00f3n grado a grado, cocina al ba\u00f1o mar\u00eda, cocci\u00f3n lenta, velocidad cero y dispone de funci\u00f3n Turbo.<\/li><li>Jarra Habana independiente de acero inoxidable con revestimiento cer\u00e1mico con elevada antiadherencia para lograr resultados excelentes en las elaboraciones m\u00e1s delicadas.<\/li><li>Incorpora b\u00e1scula para pesar con gran precisi\u00f3n los alimentos depositados en la jarra con el fin de trabajar con cantidades exactas y obtener resultados excelentes.<\/li><li>Jarra de acero inoxidable de alta calidad apta para una limpieza r\u00e1pida y f\u00e1cil en el lavavajillas.<\/li><li>Su velocidad cero permite cocer y sofre\u00edr sin necesidad de poner velocidad, como si de una cazuela o una sart\u00e9n se tratase. Y, adem\u00e1s, con la ventaja de cocinar sin tapa.<\/li><li>La innovadora funci\u00f3n sofrito a una temperatura superior cuando desees utilizarla para dorar los alimentos, se consigue con la mayor temperatura y la m\u00e1xima potencia.<\/li><li>Exclusiva cuchara MamboMix para amasar. Al no cortar la masa logra que sean m\u00e1s homog\u00e9neas y tengan un mayor volumen.<\/li><li>La jarra cuenta con una gran capacidad m\u00e1xima de hasta 3,3 litros para que no se tengan que repetir las elaboraciones cuando hay invitados en casa.<\/li><li>Cestillo de hervir para poder preparar hasta 4 elaboraciones al mismo tiempo. Cocinar en la jarra, en el cestillo y en la vaporera a dos niveles es ideal para ahorrar tiempo en la cocina.<\/li><li>Incluye un completo recetario y acceso a la comunidad social interactiva y a todas las recetas nuevas semanales de Cecotec.<\/li><li>El sistema inteligente de potencia calor\u00edfica oscila de 0 a 10 niveles simulando un fuego tradicional con llama suave, media o fuerte. Evita sobrecalentamiento e impide que los alimentos se peguen o se quemen.<\/li><li>Motor con doble engranaje que aprovecha, sin esfuerzo, su rendimiento tanto en altas como en bajas velocidades.<\/li><li>Movimiento SlowMambo que permite cocinar a baja temperatura lentamente mientras remueve constantemente con la cuchara MamboMix de forma tradicional. Consigue los sabores m\u00e1s intensos.<\/li><li>El tap\u00f3n dosificador cuenta con un cierre de seguridad espec\u00edfico para triturar o dar golpes de Turbo sin riesgo de salpicaduras.<\/li><li>Completamente personalizable en todos los par\u00e1metros para ofrecer infinidad de posibilidades en la cocina diaria. Es posible programar tiempo, velocidad, temperatura, potencia de calor y Turbo como se desee.<\/li><li>La mariposa dispone de un refuerzo de silicona en la parte final para reba\u00f1ar mejor la base de la jarra y ofrecer un mejor resultado.<\/li><li>Incorpora una vaporera de dos niveles con gran capacidad para poder cocinar al vapor sin l\u00edmites. El accesorio se ensambla sin la tapa de la jarra para poder cocer al vapor una mayor superficie.<\/li><li>Cuenta con Security Check System, uno de los sistemas de seguridad m\u00e1s avanzados para poner y quitar las cuchillas f\u00e1cilmente sin riesgo.<\/li><li>Gran pantalla digital altamente intuitiva con panel de control t\u00e1ctil para una mejor usabilidad.<\/li><li>Dispone de 10 velocidades y temporizador ajustable desde 1 segundo hasta 12 horas. La temperatura es ajustable grado a grado desde 37\u00baC hasta 120\u00baC.<\/li><li>Esp\u00e1tula recubierta de silicona para ayudar a extraer f\u00e1cilmente toda la elaboraci\u00f3n de la jarra o remover si es necesario.<\/li><li>Potencia&nbsp; 1700 W<\/li><\/ul><h2>Composici\u00f3n<\/h2><ul><li>Robot de cocina Mambo<\/li><li>Cuchara MamboMix<\/li><li>Jarra Habana con revestimiento cer\u00e1mico<\/li><li>Cestillo de hervir<\/li><li>Mariposa<\/li><li>Vaporera de dos niveles<\/li><li>Esp\u00e1tula<\/li><li>Recetario<\/li><li>Manual de instrucciones&nbsp;<\/li><\/ul><br><p><\/p><ul><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CECOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":12.75,"unit_price":179.27,"unit_price_tax":179.27,"tax_rules_group":null,"category":"Cocina","sub_category":"Robots de Cocina","quantity":2,"brand":"CECOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-robot%20mambo%209590_1.jpg"],"wholesale_price":174.27}}},"5601082038889":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5601082038889",false],"wholesale_price":[3.43,false],"price":[8.43,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.2",false],"images":