ado.pt\/img\/tmp\/ba79b06c3a9480e989519840f0609e62.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rat\u00f3n Mini Inal\u00e1mbrico Logitech M187\/ Hasta 1000 DPI\/ Rojo","category":"Ratones","sub_category":"Ratones","unit_price":17.48,"reference":"910-002732","ean13":"5099206032194","weight":"0.1","quantity":5,"brand":"LOGITECH","description_pt":"                                                <p>El rat\u00f3n de bolsillo fiable gracias a su dise\u00f1o extrapeque\u00f1o, conexi\u00f3n fiable y nano receptor inal\u00e1mbrico.<br \/><br \/><h2>Funciones<\/h2><\/p><ul>    <li><h2>Tama\u00f1o extrapeque\u00f1o: <\/h2>Mini Mouse es tan peque\u00f1o que cabe f\u00e1cilmente en la bolsa, el bolso o el bolsillo de los pantalones para ser realmente port\u00e1til.<\/li>    <li><h2>Min\u00fasculo nano receptor: <\/h2>El nano receptor es tan peque\u00f1o  que permanece en el puerto USB, sin preocupaciones por p\u00e9rdidas o  roturas. Y si necesita retirarlo, se guarda dentro del rat\u00f3n. Disfrutar\u00e1  de la libertad de un dispositivo inal\u00e1mbrico con m\u00e1s precisi\u00f3n y  control que con el touchpad del port\u00e1til.<\/li>    <li><h2>Tecnolog\u00eda inal\u00e1mbrica avanzada de 2,4 GHz de Logitech: <\/h2>Desp\u00eddase  de los cables y disfrute de la libertad inal\u00e1mbrica (a una distancia de  hasta 10 metros). Puede usar f\u00e1cilmente el rat\u00f3n en el sof\u00e1 con el  port\u00e1til, o cuando conecta este \u00faltimo al televisor.<\/li>    <li><h2>Fiabilidad de Logitech: <\/h2>Obtendr\u00e1 la calidad y fiabilidad  que han hecho de Logitech el l\u00edder mundial en ratones, con tres a\u00f1os de  garant\u00eda de hardware limitada.<\/li><\/ul><p><h2>Requisitos del sistema<\/h2><\/p><ul>    <li>Windows\u00ae XP, Windows Vista\u00ae o Windows\u00ae 7<\/li>    <li>Mac OS\u00ae X 10.5 posterior<\/li>    <li>Linux\u00ae kernel 2.6+<\/li>    <li>Puerto USB<\/li><\/ul><p><h2>Informaci\u00f3n de garant\u00eda<\/h2><\/p><ul>    <li>Tres a\u00f1os de garant\u00eda de hardware limitada<\/li><\/ul><p><h2>Contenido de la caja<\/h2><\/p><ul>    <li>Rat\u00f3n<\/li>    <li>Receptor<\/li>    <li>Una pila AAA (preinstalada)<\/li>    <li>Documentaci\u00f3n del usuario<\/li><\/ul><p>\u00a0<\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_log-mou%20m187%20rojo_1.jpg","wholesale_price":"12.48","unit_price_tax":17.48},"product_model":{"product_data":{"ean13":["5099206032194"],"reference":"910-002732","name":{"1":"Rat\u00f3n Mini Inal\u00e1mbrico Logitech M187\/ Hasta 1000 DPI\/ Rojo","2":"","3":"","4":""},"description":{"1":"                                                <p>El rat\u00f3n de bolsillo fiable gracias a su dise\u00f1o extrapeque\u00f1o, conexi\u00f3n fiable y nano receptor inal\u00e1mbrico.<br \/><br \/><h2>Funciones<\/h2><\/p><ul>    <li><h2>Tama\u00f1o extrapeque\u00f1o: <\/h2>Mini Mouse es tan peque\u00f1o que cabe f\u00e1cilmente en la bolsa, el bolso o el bolsillo de los pantalones para ser realmente port\u00e1til.<\/li>    <li><h2>Min\u00fasculo nano receptor: <\/h2>El nano receptor es tan peque\u00f1o  que permanece en el puerto USB, sin preocupaciones por p\u00e9rdidas o  roturas. Y si necesita retirarlo, se guarda dentro del rat\u00f3n. Disfrutar\u00e1  de la libertad de un dispositivo inal\u00e1mbrico con m\u00e1s precisi\u00f3n y  control que con el touchpad del port\u00e1til.<\/li>    <li><h2>Tecnolog\u00eda inal\u00e1mbrica avanzada de 2,4 GHz de Logitech: <\/h2>Desp\u00eddase  de los cables y disfrute de la libertad inal\u00e1mbrica (a una distancia de  hasta 10 metros). Puede usar f\u00e1cilmente el rat\u00f3n en el sof\u00e1 con el  port\u00e1til, o cuando conecta este \u00faltimo al televisor.<\/li>    <li><h2>Fiabilidad de Logitech: <\/h2>Obtendr\u00e1 la calidad y fiabilidad  que han hecho de Logitech el l\u00edder mundial en ratones, con tres a\u00f1os de  garant\u00eda de hardware limitada.<\/li><\