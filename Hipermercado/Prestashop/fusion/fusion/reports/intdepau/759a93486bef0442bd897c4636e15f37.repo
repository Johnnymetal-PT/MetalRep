group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.4",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86680","Cat. IDs: 195,193","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/ab082775f7b4b3b3f3327bf038049720.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Switch D-Link DIS-100E-5W 5 Puertos\/ RJ-45 10\/100","category":"Conectividad","sub_category":"Switchs","unit_price":123.95,"reference":"DIS-100E-5W","ean13":"0790069441271","weight":"0.4","quantity":2,"brand":"DLINK","description_pt":"                                                <p><\/p><h2>Plug and play sin gesti\u00f3n<\/h2>Enchufar y listo. DIS-100E-5W transmite de forma fiable los datos Ethernet.<br><br><h2>Conectividad Fast Ethernet<\/h2>Dise\u00f1ado con 5 x puertos 10\/100Base T(X) para adaptarse a la disposici\u00f3n de su red.<br><br><h2>Certificaciones oficiales para entorno Industrial<\/h2>Certificaciones de entorno IEC (vibraci\u00f3n, choque, ca\u00edda libre) compatibilidad electromagn\u00e9tica (EMC), Seguridad (UL, IEC) para maximizar el tiempo de funcionamiento de la red en una variedad de entornos de despliegue de alta exigencia, incluyendo vigilancia urbana inteligente, automatizaci\u00f3n de f\u00e1bricas y redes WiFi externas.<br><br><h2>Resiste temperaturas extremas<\/h2>Alta fiabilidad y rendimiento en un rango de ambientes industriales y agresivos en temperaturas desde -40\u00b0C hasta +75\u00b0C, y puede arrancar en fr\u00edo desde -40\u00b0C.<br><br><h2>Estructura Alta Resistencia<\/h2>La carcasa ha sido creada para asegurar alta resistencia a impactos y condiciones extremas de temperatura, cumpliendo con la normativa IP-30. Por esta raz\u00f3n, cada switch DIS viene con una garant\u00eda de 5 a\u00f1os de D-Link.<br><br><br><h2>Despliegue r\u00e1pido DIN-Rail o pared<\/h2>Para la instalaci\u00f3n instant\u00e1nea cuenta con un clip de ra\u00edl DIN de ajuste r\u00e1pido, y tambi\u00e9n admite el montaje en la pared.<br><br><br><h2>Dise\u00f1o sin ventilador<\/h2>Sin piezas m\u00f3viles en el interior para reducir los tiempos de inactividad y las llamadas de mantenimiento, la robusta carcasa ha sido optimizada para la transferencia de calor.<br><br><br><h2>Tama\u00f1o compacto<\/h2>Peque\u00f1o pero vers\u00e1til y resistente. Para aprovechar al m\u00e1ximo el espacio del bastidor, mide: 109,2 x 29,1 x 89,4 mm.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Puertos e Interfaces<\/li>  <li>Cantidad de puertos b\u00e1sicos de conmutaci\u00f3n RJ-45 Ethernet: 5<\/li>  <li>Puertos tipo b\u00e1sico de conmutaci\u00f3n RJ-45 Ethernet: Fast Ethernet (10\/100)<\/li>  <li>Salidas de rel\u00e9: 1<\/li>  <li>Peso y dimensiones<\/li>  <li>Ancho: 29,1 mm<\/li>  <li>Profundidad: 89,4 mm<\/li>  <li>Altura: 109,2 mm<\/li>  <li>Peso: 320 g<\/li>  <li>Control de energ\u00eda<\/li>  <li>Voltaje de entrada DC: 12 - 58 V<\/li>  <li>Consumo energ\u00e9tico: 0,95 W<\/li>  <li>Consumo de energ\u00eda (max): 1,56 W<\/li>  <li>Condiciones ambientales<\/li>  <li>Intervalo de temperatura operativa: -40 - 75 \u00b0C<\/li>  <li>Intervalo de temperatura de almacenaje: -40 - 85 \u00b0C<\/li>  <li>Intervalo de humedad relativa para funcionamiento: 5 - 95%<\/li>  <li>Conexi\u00f3n<\/li>  <li>Est\u00e1ndares de red: IEEE 802.3x<\/li>  <li>Soporte 10G: No<\/li>  <li>Tecnolog\u00eda de cableado ethernet de cobre: 10BASE-T,100BASE-TX,100BASE-T<\/li>  <li>Bidireccional completo (Full duplex): Si<\/li>  <li>Soporte de control de flujo: Si<\/li>  <li>Control de transmisi\u00f3n de tormentas: Si<\/li>  <li>Auto MDI \/ MDI-X: Si<\/li>  <li>Auto-negociaci\u00f3n: Si<\/li>  <li>Transmisi\u00f3n de datos<\/li>  <li>Tabla de direcciones MAC: 1