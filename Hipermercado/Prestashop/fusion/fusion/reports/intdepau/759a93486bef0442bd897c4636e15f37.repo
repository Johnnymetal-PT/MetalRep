es de masaje rotatorios (2 en<\/li>  <li>sentido a las agujas del reloj \/ 2 en sentido contrario a las agujas del reloj, con funci\u00f3n calor.<\/li>  <li>Ideal para: nuca, espalda, piernas&#8230;<\/li>  <li>Extra suave y confortable.<\/li>  <li>Funci\u00f3n luz y calor.<\/li>  <li>Forma de la almohada universal.<\/li>  <li>Funda extra\u00edble y lavable.<\/li>  <li>Potencia: 12 W.<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BEURER","supplier":null,"width":null,"height":null,"depth":null,"weight":1.68,"unit_price":39.29,"unit_price_tax":39.29,"tax_rules_group":null,"category":"Salud","sub_category":"Masajeadores","quantity":2,"brand":"BEURER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_beu-pae-masajeador%20mg-145_1.jpg"],"wholesale_price":34.29}}},"4211125648114":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4211125648114",false],"wholesale_price":[15.65,false],"price":[20.65,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.6",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:89190","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/baf226d03dc8e7a9d5125d14f22281c0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Masajeador por Infrarrojos Beurer MG-21","category":"Salud","sub_category":"Masajeadores","unit_price":20.65,"reference":"MG-21","ean13":"4211125648114","w