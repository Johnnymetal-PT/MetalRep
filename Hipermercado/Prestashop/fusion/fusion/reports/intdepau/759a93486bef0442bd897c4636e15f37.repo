8<\/li><\/ul><\/p><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CORSAIR","supplier":null,"width":null,"height":null,"depth":null,"weight":0.07,"unit_price":74.98,"unit_price_tax":74.98,"tax_rules_group":null,"category":"Componentes","sub_category":"Memoria RAM","quantity":0,"brand":"CORSAIR","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cor-32gb%20cmk32gx4m1d3000c16_1.jpg"],"wholesale_price":69.98}}},"4250812407689":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4250812407689",false],"wholesale_price":[35.33,false],"price":[40.33,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 2.1",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86265","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/8142090fc3fabc48f1a2b1a796bd0714.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Fuente de alimentaci\u00f3n EVGA 600W\/ 600W\/ Ventilador 12cm\/ 80 Plus","category":"Componentes","sub_category":"Fuentes de alimentacion","unit_price":40.33,"reference":"100-W1-0600-K2","ean13":"4250812407689","weight":"2.1","quantity":0,"brand":"EVGA","description_pt":"                                                                                                                                                                                                                                                <p><ul>