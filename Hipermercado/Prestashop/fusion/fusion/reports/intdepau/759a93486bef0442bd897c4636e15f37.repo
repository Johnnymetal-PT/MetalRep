sibilidad (driver): 110dB \u00b1 3dB<\/li><li>Impedancia (driver): 32O<\/li><li>Direccionalidad (micr\u00f3fono): Omnidireccional<\/li><li>Impedancia (micr\u00f3fono): 2.2kO \u00b1 30% at 1kHz<\/li><li>Sensibilidad (micr\u00f3fono): 42dB \u00b1 3dB (0dB=1V\/Pa, 1kHz)<\/li><li>Retr\u00e1ctil (micr\u00f3fono): Plegable<\/li><\/ul><\/body><\/html>                                                                                                                                                                                ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0.26,"unit_price":10.89,"unit_price_tax":10.89,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Auriculares y Microfonos","quantity":5,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-aur%20mrh0_1.jpg"],"wholesale_price":5.89}}},"8435693103080":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693103080",false],"wholesale_price":[18.22,false],"price":[23.22,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:88811","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/1fd5702ebe8423f9abc3579e88e9ab16.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cable Ex