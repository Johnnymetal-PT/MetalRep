uminio<\/li><li>Composici\u00f3n del blindaje:&nbsp; l\u00e1mina de aluminio, trenzado de metal, conexi\u00f3n a tierra<\/li><li>Material de la cubierta:&nbsp; TPE con trenzado de nailon<\/li><li>Calibre del cable (AWG):&nbsp; 21+30 AWG<\/li><li>Di\u00e1metro exterior (OD):&nbsp; 3,4 mm<\/li><li>Clasificaci\u00f3n de la fuente de alimentaci\u00f3n:&nbsp; 3 A<\/li><li>Potencia m\u00e1xima de salida:&nbsp; PD60W (20 V\/3 A)<\/li><\/ul><\/p><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":7.3,"unit_price_tax":7.3,"tax_rules_group":null,"category":"Cables","sub_category":"Cable USB","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-cab%20tadhg_1.jpg"],"wholesale_price":2.3}}},"6922794752535":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6922794752535",false],"wholesale_price":[3.93,false],"price":[8.93,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:234956","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0d89b5d285cd5994c6b2b313a0b3210a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cable USB 2.0 Tipo-C 90\u00ba Vention TAKHF\/ USB Tipo-C Macho - USB Tipo-C Macho\/ Hasta 100W\/ 480Mbps\/ 1m\/ Gris","category":"Cables","sub_cate