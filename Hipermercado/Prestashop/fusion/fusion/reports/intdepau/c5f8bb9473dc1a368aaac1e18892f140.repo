l\u00edmero de Litio de 72&nbsp;<span style='background-color: initial;'>Wh (9360 mAh)<\/span><\/li><li><b>Dimensiones<\/b><\/li><li>313.4 x 215.2 x 16.8 mm (999g).<\/li><\/ul><\/p><\/div><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":957.64,"unit_price_tax":957.64,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":0,"brand":"LG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lgp-14z90r-q%20ap75b_1.jpg"],"wholesale_price":952.64}}},"0198122703241":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0198122703241",false],"wholesale_price":[833.34,false],"price":[838.34,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 2.71",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:235211","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2071f3f56e4f41cd873cd6a091e8d967.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Port\u00e1til Convertible HP Envy X360 14-FA0005NS Ryzen 7 8840HS\/ 16GB\/ 1TB SSD\/ 14' T\u00e1ctil\/ Win11","category":"Portatiles","sub_category":"Convertibles 2 en 1","unit_price":838.34,"reference":"A13G7EA","ean13":"0198122703241","weight":"2.71","quantity":2,"brand":"HP","description_pt":"<p><h2>HP Envy x360 2-in-1 Laptop 14-fa0005ns<\/h2>Aumenta tu productividad con el ordenador por