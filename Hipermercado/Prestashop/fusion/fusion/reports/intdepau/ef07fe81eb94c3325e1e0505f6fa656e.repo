:"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AISENS","supplier":null,"width":null,"height":null,"depth":null,"weight":2.25,"unit_price":13.6,"unit_price_tax":13.6,"tax_rules_group":null,"category":"Soportes para TV","sub_category":"Soportes TV","quantity":0,"brand":"AISENS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-soporte%20dt80f-305_1.jpg"],"wholesale_price":8.6}}},"8435739902356":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435739902356",false],"wholesale_price":[67.56,false],"price":[72.56,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 12.4",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:238153","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d9fed1ec9c5bc0644a678c7f552a031d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Soporte de Suelo con Ruedas Aisens FT86FE-329 para TV de 37-86'\/ hasta 80kg","category":"Soportes para TV","sub_category":"Soportes TV","unit_price":72.56,"reference":"FT86FE-329","ean13":"8435739902356","weight":"12.4","quantity":2,"brand":"AISENS","description_pt":"<p><p><h2>AISENS - SOPORTE DE SUELO ECO CON RUEDA, 1 BANDEJA PARA PANTALLA INTERACTIVA\/TV 80KG DE 37-86, NEGRO<\/h2><div><br><\/div><\/p><p><h2>Especificaciones:<\/h2><ul><li>Soporte de suelo eco con rueda, bandeja para pantalla interactiva\/TV de 37&#8221;-86&#8221;<\/li><li>Fabricado con acero de alta resistencia y pintado con pintura electrost\u00e1tica para un acabado perfecto.<\/li><li>El soporte del suelo con bandeja para pantalla interactiva es una excelente opci\u00f3n para presentaciones, conferencias y aulas en las que se utiliza una pantalla interactiva de gran tama\u00f1o. Con su capacidad de almacenamiento, estabilidad y flexibilidad, este soporte ofrece una soluci\u00f3n pr\u00e1ctica y eficiente para mejorar la experiencia de visualizaci\u00f3n y colaboraci\u00f3n.<\/li><li>Mayor flexibilidad y adaptabilidad: este soporte puede ser movido f\u00e1cilmente. Adem\u00e1s, es posible girar la pantalla en diferentes \u00e1ngulos, lo que permite una mejor visualizaci\u00f3n para una audiencia m\u00e1s amplia.<\/li><li>M\u00e1xima estabilidad y seguridad: debido a su dise\u00f1o robusto, este soporte es capaz de soportar el peso de pantallas interactivas de gran tama\u00f1o sin comprometer su estabilidad.<\/li><li>Mayor capacidad de almacenamiento: la bandeja grande integrada en el soporte permite al usuario guardar y tener a mano los equipos y materiales necesarios para una presentaci\u00f3n o clase.<\/li><li>VESA M\u00e1ximo: 600x400mm (Compatible con VESA de 200x200, 300x200, 400x200, 300x300, 400x300, 400x400, 600x400mm)<\/li><li>Carga M\u00e1xima: 80kg<\/li><li>Altura m\u00e1xima del soporte: 1615mm<\/li><li>Rango de ajuste para la altura del soporte TV: 1250\/1280\/1310\/1340\/1370\/1400 mm<\/li><li>Tama\u00f1o de bandeja DVD: 320 x 652mm<\/li><li>Tama\u00f1o de base de soporte: 635 x 725mm<\/li><li>Color: Negro<\/li><li><b>Contenido:<\/b><\/li><li>1 x Soporte de suelo para monitor\/TV<\/li><li>1 x Kit de montaje (No incluye herramientas)<\/li><li>1 x Manual de instrucciones multi idiomas<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-soporte%20ft86fe-329_1.jpg","wholesale_price":"67.56","unit_price_tax":72.56},"product_model":{"product_data":{"ean13":["8435739902356"],"reference":"FT86FE-329","name":{"1":"Soporte de Suelo con Ruedas Aisens FT86FE-32