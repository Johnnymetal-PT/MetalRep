 consola. De esta manera, \u00a1no perder\u00e1s ni un minuto para volver al gaming!<\/p><br><\/div><h2>Especificaciones<\/h2><div><p><ul><li><b>Sostenibilidad<\/b><\/li><li>Material pl\u00e1stico<\/li><li>ABS<\/li><li><b>Tama\u00f1o y peso<\/b><\/li><li>Peso de la unidad principal<\/li><li>187 gramos<\/li><li>Peso total<\/li><li>202 gramos<\/li><li>Altura del producto principal (en mm)<\/li><li>20 mil\u00edmetros<\/li><li>Profundidad del producto principal (en mm)<\/li><li>150 mil\u00edmetros<\/li><li>Ancho del producto principal (en mm)<\/li><li>144 mil\u00edmetros<\/li><li><b>Contenido del paquete<\/b><\/li><li>Soporte vertical<\/li><li>Adaptador original de PS5<\/li><li>Tornillo de palometa<\/li><li>Cable USB-CA<\/li><li>Manual del usuario<\/li><li>Requisitos del sistema<\/li><li>Puerto USB-A<\/li><\/ul><\/p><\/div><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRUST GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":20.38,"unit_price_tax":20.38,"tax_rules_group":null,"category":"Juegos y Accesorios","sub_category":"Accesorios PS5","quantity":0,"brand":"TRUST GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-stand%20gxt%20229%20wh_1.jpg"],"wholesale_price":13.38}}},"8426156018577":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8426156018577",false],"wholesale_price":[18.43,false],"price":[25.43,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create pro