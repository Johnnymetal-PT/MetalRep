d_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.27",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:72751","Cat. IDs: 68,68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/d5f1a79e75c28458909561b233667a47.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Android TV Xiaomi TV Stick 4K 8GB\/ 4K","category":"Accesorios TV","sub_category":"Android TV - Miracast","unit_price":45.81,"reference":"PFJ4122EU","ean13":"6971408155620","weight":"0.27","quantity":5,"brand":"XIAOMI","description_pt":"<h2>Una nueva era de conectividad inteligente<\/h2><p>Con el sistema inteligente Android TV&#8482;, Xiaomi TV Stick 4K te ofrece una nueva experiencia multimedia en cualquier momento y en cualquier lugar. Compacto y port\u00e1til, le da una vida m\u00e1s inteligente a sus pantallas*.<br><\/p><h2>Experimente la maravilla de Android TV&#8482; 11*<\/h2><p>El Xiaomi TV Stick 4K viene equipado con Android TV 11, lo que brinda una experiencia simple pero inmersiva. Descubre m\u00e1s de 400 000 pel\u00edculas y programas de tus aplicaciones favoritas. Obt\u00e9n m\u00e1s de 7000 aplicaciones de Google Play*. Reproduzca m\u00fasica y juegos, transmita desde cualquier dispositivo y m\u00e1s*.<br><\/p><h2>La mejor experiencia visual<\/h2><p>La salida de ultra alta resoluci\u00f3n 4K * combinada con la tecnolog\u00eda Dolby Vision\u00ae lleva la calidad del video a otro nivel. Participe en una experiencia visual v\u00edvida e inmersiva.<br><\/p><h2>Sonido envolvente* para una experiencia de audio superior<\/h2><p>Ya sea que le guste la m\u00fasica, los juegos, las pel\u00edculas o los dramas de televisi\u00f3n, la incorporaci\u00f3n de la tecnolog\u00eda Dolby Atmos\u00ae y DTS HD brinda mayor riqueza y realismo a los sonidos que nunca.<br><\/p><h2>Haz que tu televisor sea m\u00e1s inteligente con el Asistente de Google*<\/h2><p>Con el Asistente de Google*, puede disfrutar de acceso r\u00e1pido a toneladas de entretenimiento, buscar informaci\u00f3n y controlar sus dispositivos dom\u00e9sticos inteligentes. Tambi\u00e9n brinda la comodidad del reconocimiento de voz a los televisores no inteligentes.<br><\/p><h2>Peque\u00f1o pero poderoso<\/h2><p>El factor de forma compacto de Xiaomi TV Stick 4K cuenta con un procesador de cuatro n\u00facleos que ofrece un rendimiento potente. Ya sea que est\u00e9 viendo una pel\u00edcula de alta resoluci\u00f3n, escuchando m\u00fasica de alta calidad o jugando juegos, lo que puede esperar es velocidad y estabilidad.<br><\/p><h2>Pon tu peque\u00f1a pantalla en la pantalla grande<\/h2><p>Transmita el entretenimiento que ama desde su tel\u00e9fono, tableta o computadora port\u00e1til a su televisor con Chromecast integrado*.<br><\/p><h2>Control remoto bluetooth 360\u00b0<\/h2><p>El dise\u00f1o de botones f\u00e1cil de usar combinado con Bluetooth y soporte de control de voz significa que puede disfrutar de un control de 360\u00b0 desde cualquier \u00e1ngulo. Se trata de conveniencia, comodidad y control de las cosas a tu manera.<br><\/p><h2>Dise\u00f1o ligero y port\u00e1til<\/h2><p>\u00daselo donde lo necesite: el factor de forma liviano y compacto de Xiaomi TV Stick 4K lo hace f\u00e1cil de usar y transportar. Mire su contenido de video favorito en cualquier momento y en cualquier lugar, ya sea que est\u00e9 en casa o fuera.<br><\/p><p><p><ul><li>1. Conecta el Xiaomi TV Stick 4K a tu televisor<\/li><li>2. Con\u00e9ctese a Wi-Fi<\/li><li>3. Empieza a mirar<\/li><\/ul><div><br><\/div><\/p><p><ul><li><b>Dimensiones<\/b><\/li><li>Longitud<\/li><li>106,8 mm<\/li><li>Ancho<\/li><li>29,4 mm<\/li><li>Grosor<\/li><li>15,4 mm<\/li><li>Peso<\/li><li>42,8g<\/li><li>Color<\/li><li>Negro<\/li><li><b>Especificaciones<\/b><\/li><li>Resoluci\u00f3n de salida<\/li><li>4K<\/li><li>CPU<\/li><li>Cortex-A35 de cuatro n\u00facleos<\/li><li>GPU<\/li><li>Mal\u00ed-G31 MP2<\/li><li>RAM<\/li><li>2GB<\/li><li>Almacenamiento<\/li><li>8 GB<\/li><li>Sistema operativo<\/li><li>Android TV&#8482; 11<\/li><li>Contenido<\/li><li>Netflix, Amazon Prime Video y Youtube preinstalados<\/li><li><b>Conectividad inal\u00e1mbrica<\/b><\/li><li>Wifi 2,4 GHz\/5 GHz<\/li><li>Bluetooth 5.0<\/li><li><b>Descifrador<\/b><\/li><li>Decodificador de v\u00eddeo<\/li><li>AV1, VP9, &#8203;&#8203;H.265, H.264, MPEG-2, MPEG-1<\/li><li>Formato de video<\/li><li>MKV, MPG, MPEG, DAT, AVI, MOV, ISO, MP4, RM<\/li><li>Decodificador de audio<\/li><li>DTS HD Dolby Atmos<\/li><li>Formato de audio<\/li><li>MP3, AAC, RM, FLAC<\/li><li>Decodificador de imagen<\/li><li>JPG, BMP, GIF, PNG<\/li><li>Puertos<\/li><li>HDMI x 1<\/li><li>1 micro USB<\/li><li><b>En el cuadro<\/b><\/li><li>Xiaomi TV Stick 4K&nbsp;x 1<\/li><li>Mando a distancia x 1<\/li><li>Adaptador de corriente x 1<\/li><li>Manual de usuario x 1<\/li><li>Cable extensor HDMI x 1<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-android%20tv%20stick%204k%20eu_1.jpg","wholesale_price":"40.81","unit_price_tax":45.81},"product_model":{"product_data":{"ean13":["6971408155620"],"reference":"PFJ4122EU","name":{"1":"Android TV Xiaomi TV Stick 4K 8GB\/ 4K","2":"","3":"","4":""},"description":{"1":"<h2>Una nueva era de conectividad inteligente<\/h2><p>Con el sistema inteligente Android TV&#8482;, Xiaomi TV Stick 4K te ofrece una nueva experiencia multimedia en cualquier momento y en cualquier lugar. Compacto y port\u00e1til, le da una vida m\u00e1s inteligente a sus pantallas*.<br><\/p><h2>Experimente la maravilla de Android TV&#8482; 11*<\/h2><p>El Xiaomi TV Stick 4K viene equipado con Android TV 11, lo que brinda una experiencia simple pero inmersiva. Descubre m\u00e1s de 400 000 pel\u00edculas y programas de tus aplicaciones favoritas. Obt\u00e9n m\u00e1s de 7000 aplicaciones de Google Play*. Reproduzca m\u00fasica y juegos, transmita desde cualquier dispositivo y m\u00e1s*.<br><\/p><h2>La mejor experiencia visual<\/h2><p>La salida de ultra alta resoluci\u00f3n 4K * combinada con la tecnolog\u00eda Dolby Vision\u00ae lleva la calidad del video a otro nivel. Participe en una experiencia visual v\u00edvida e inmersiva.<br><\/p><h2>Sonido envolvente* para una experiencia de audio superior<\/h2><p>Ya sea que le guste la m\u00fasica, los juegos, las pel\u00edculas o los dramas de televisi\u00f3n, la incorporaci\u00f3n de la tecnolog\u00eda Dolby Atmos\u00ae y DTS HD brinda mayor riqueza y realismo a los sonidos que nunca.<br><\/p><h2>Haz que tu televisor sea m\u00e1s inteligente con el Asistente de Google*<\/h2><p>Con el Asistente de Google*, puede disfrutar de acceso r\u00e1pido a toneladas de entretenimiento, buscar informaci\u00f3n y controlar sus dispositivos dom\u00e9sticos inteligentes. Tambi\u00e9n brinda la comodidad del reconocimiento de voz a los televisores no inteligentes.<br><\/p><h2>Peque\u00f1o pero poderoso<\/h2><p>El factor de forma compacto de Xiaomi TV Stick 4K cuenta con un procesador de cuatro n\u00facleos que ofrece un rendimiento potente. Ya sea que est\u00e9 viendo una pel\u00edcula de alta resoluci\u00f3n, escuchando m\u00fasica de alta calidad o jugando juegos, lo que puede esperar es velocidad y estabilidad.<br><\/p><h2>Pon tu peque\u00f1a pantalla en la pantalla grande<\/h2><p>Transmita el entretenimiento que ama desde su tel\u00e9fono, tableta o computadora port\u00e1til a su televisor con Chromecast integrado*.<br><\/p><h2>Control remoto bluetooth 360\u00b0<\/h2><p>El dise\u00f1o de botones f\u00e1cil de usar combinado con Bluetooth y soporte de control de voz significa que puede disfrutar de un control de 360\u00b0 desde cualquier \u00e1ngulo. Se trata de conveniencia, comodidad y control de las cosas a tu manera.<br><\/p><h2>Dise\u00f1o ligero y port\u00e1til<\/h2><p>\u00daselo donde lo necesite: el factor de forma liviano y compacto de Xiaomi TV Stick 4K lo hace f\u00e1cil de usar y transportar. Mire su contenido de video favorito en cualquier momento y en cualquier lugar, ya sea que est\u00e9 en casa o fuera.<br><\/p><p><p><ul><li>1. Conecta el Xiaomi TV Stick 4K a tu televisor<\/li><li>2. Con\u00e9ctese a Wi-Fi<\/li><li>3. Empieza a mirar<\/li><\/ul><div><br><\/div><\/p><p><ul><li><b>Dimensiones<\/b><\/li><li>Longitud<\/li><li>106,8 mm<\/li><li>Ancho<\/li><li>29,4 mm<\/li><li>Grosor<\/li><li>15,4 mm<\/li><li>Peso<\/li><li>42,8g<\/li><li>Color<\/li><li>Negro<\/li><li><b>Especificaciones<\/b><\/li><li>Resoluci\u00f3n de salida<\/li><li>4K<\/li><li>CPU<\/li><li>Cortex-A35 de cuatro n\u00facleos<\/li><li>GPU<\/li><li>Mal\u00ed-G31 MP2<\/li><li>RAM<\/li><li>2GB<\/li><li>Almacenamiento<\/li><li>8 GB<\/li><li>Sistema operativo<\/li><li>Android TV&#8482; 11<\/li><li>Contenido<\/li><li>Netflix, Amazon Prime Video y Youtube preinstalados<\/li><li><b>Conectividad inal\u00e1mbrica<\/b><\/li><li>Wifi 2,4 GHz\/5 GHz<\/li><li>Bluetooth 5.0<\/li><li><b>Descifrador<\/b><\/li><li>Decodificador de v\u00eddeo<\/li><li>AV1, VP9, &#8203;&#8203;H.265, H.264, MPEG-2, MPEG-1<\/li><li>Formato de video<\/li><li>MKV, MPG, MPEG, DAT, AVI, MOV, ISO, MP4, RM<\/li><li>Decodificador de audio<\/li><li>DTS HD Dolby Atmos<\/li><li>Formato de audio<\/li><li>MP3, AAC, RM, FLAC<\/li><li>Decodificador de imagen<\/li><li>JPG, BMP, GIF, PNG<\/li><li>Puertos<\/li><li>HDMI x 1<\/li><li>1 micro USB<\/li><li><b>En el cuadro<\/b><\/li><li>Xiaomi TV Stick 4K&nbsp;x 1<\/li><li>Mando a distancia x 1<\/li><li>Adaptador de corriente x 1<\/li><li>Manual de usuario x 1<\/li><li>Cable extensor HDMI x 1<\/li><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite"