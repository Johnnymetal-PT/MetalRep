erior<\/li><li>Tirante para hombro Si<\/li><li>Cintur\u00f3n retenedor de carrito Si<\/li><li>Agarradera(s) Si<\/li><li>Tipo de cierre Cremallera<\/li><li>Resistente al agua Si<\/li><ul><li>Ancho 290 mm<\/li><li>Profundidad 120 mm<\/li><li>Altura 420 mm<\/li><li>Peso 610 g<\/li><\/ul><\/ul><br><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SUBBLIM","supplier":null,"width":null,"height":null,"depth":null,"weight":0.15,"unit_price":17.39,"unit_price_tax":17.39,"tax_rules_group":null,"category":"Accesorios de Portatiles","sub_category":"Mochilas para Portatil","quantity":5,"brand":"SUBBLIM","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sub-mochi%20bp-2bl2002_1.jpg"],"wholesale_price":12.39}}},"8436586742126":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8436586742126",false],"wholesale_price":[18.59,false],"price":[23.59,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["Property Product->name is not valid Name: "],"result":false},"feed_data":{"name_pt":"Mochila Subblim Business V2 AP Backpack para Port\u00e1tiles hasta 15.6'\/ Puerto USB\/ Negra","category":"Accesorios de Portatiles","sub_category":"Mochilas para Portatil","unit_price":23.59,"reference":"SUBBP-2BL1015","ean13":"8436586742126","weight":"0.68","quantity":5,"brand":"SUBBLIM","description_pt":"<p>Mochila especialmente dise\u00f1ada para el mundo laboral y de los negocios. Gracias a su alt\u00edsima calidad y comodidad, se convierte en tu mejor aliado de movilidad 