an style='background-color: initial;'>cinta regulable<\/span><\/li><li>Asa de mano superior acolchada para un confortable transporte<\/li><li>Espalda reforzada mediante malla de ventilaci\u00f3n para una mayor&nbsp;<span style='background-color: initial;'>comodidad y que evita la sudoraci\u00f3n con sistema Airflow de tres capas<\/span><\/li><li>Sistema integrado de correa para Trolley<\/li><li>Puerto USB para carga de dispositivos<\/li><li>Medidas 46x30,5x17cm<\/li><\/ul><\/p><br><\/p><p><p><ul><li><b>Especificaciones<\/b><\/li><li>Material Oxford<\/li><li>Color del producto Negro<\/li><li>Estilo Ciudad<\/li><li>Densidad de masa lineal 600 D<\/li><li>G\u00e9nero recomendado Unisex<\/li><li>Compartimento del port\u00e1til Si<\/li><li>Tama\u00f1o m\u00ednimo de pantalla 33,8 cm (13.3')<\/li><li>Tama\u00f1o m\u00e1ximo de pantalla 40,64 cm (16')<\/li><li>N\u00famero de compartimentos 3<\/li><li>Bolsas exteriores<\/li><li>Bolsillo frontal, Bolsillos laterales,<\/li><li>Bolsillo Lumbar oculto<\/li><li>Bolsillos con cremallera Si<\/li><li>Puerto USB Si<\/li><li>Tipo de puerto USB USB tipo A<\/li><li>Posici\u00f3n de los puertos USB Exterior<\/li><li>Tirante para hombro Si<\/li><li>Cintur\u00f3n retenedor de carrito Si<\/li><li>Agarradera(s) Si<\/li><li>Tipo de cierre Cremallera<\/li><li>Resistente al agua Si<\/li><li>Ancho 305 mm<\/li><li>Profundidad 170 mm<\/li><li>Altura 460 mm<\/li><li>Peso 783 g<\/li><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SUBBLIM","supplier":null,"width":null,"height":null,"depth":null,"weight":0.89,"unit_price":29.78,"unit_price_tax":29.78,"tax_rules_group":null,"category":"Accesorios de Portatiles","sub_category":"Mochilas para Portatil","quantity":5,"brand":"SUBBLIM","image