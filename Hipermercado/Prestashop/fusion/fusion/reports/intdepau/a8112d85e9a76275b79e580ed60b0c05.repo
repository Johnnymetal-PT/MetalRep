1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:139223","Cat. IDs: 120","Associated Categories","Cat. Default: 120","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/50ce617742a2cafccb587af946eb6453.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Hidrolimpiadora Cecotec HydroBoost 1400 EasyGo","category":"Bricolaje","sub_category":"Herramientas de Limpieza","unit_price":57.58,"reference":"08136","ean13":"8435484081368","weight":"0","quantity":0,"brand":"CECOTEC","description_pt":"<p><h2>Potencia arrasadora<\/h2>Limpia m\u00e1s en menos tiempo gracias a su potencia de 1400 W y sus 105 bares de presi\u00f3n que pueden hasta con la suciedad m\u00e1s dif\u00edcil sin esfuerzo.<br><br><h2>Dise\u00f1o ligero y f\u00e1cil transporte<\/h2>Su reducido peso y su dise\u00f1o con ruedas y asa permiten limpiar c\u00f3modamente hasta el \u00faltimo rinc\u00f3n de tu jard\u00edn, terraza o coche.<br><br><h2>Limpieza total con espuma a presi\u00f3n<\/h2>Consigue resultados brillantes de la forma m\u00e1s sencilla gracias a su botella de jab\u00f3n que genera espuma a presi\u00f3n para una limpieza superior.<br><br><h2>Todo listo en segundos<\/h2>Ahorra tiempo y gana comodidad gracias al sistema iClick. Conecta y desconecta la manguera de alta presi\u00f3n o la lanza a la pistola de forma r\u00e1pida y sencilla.<br><br><h2>M\u00e1xima eficiencia en cada uso<\/h2>La hidrolimpiadora cuenta con una bomba de aluminio para ofrecer el m\u00e1ximo rendimiento. Adem\u00e1s, dispone del sistema Auto Start-Stop que alarga la vida \u00fatil del motor y ahorra agua en cada uso.<br><br><h2>Gran radio de acci\u00f3n<\/h2>Sus 11 metros de radio de acci\u00f3n permiten acabar con la suciedad de forma precisa y sin necesidad de que te acerques a ella.<br><br><h2>Manguera de alta presi\u00f3n<\/h2>Limpia sin obst\u00e1culos gracias a su manguera de alta presi\u00f3n de 3 metros que permite una gran libertad de moviento para acabar con la suciedad con total comodidad.<br><br><h2>Limpieza detallada<\/h2>La hidrolimpiadora cuenta con un kit de accesorios para limpiar todo tipo de superficies de la forma m\u00e1s eficiente.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Gran potencia de 1400W para limpiar de manera r\u00e1pida y eficiente.<\/li>  <li>M\u00e1xima presi\u00f3n admitida de 105 bares.<\/li>  <li>M\u00e1ximo caudal de 408 litros \/ hora para limpiar una mayor superficie en menos tiempo.<\/li>  <li>Botella regulable para jab\u00f3n.<\/li>  <li>Bomba HardPump de aluminio de gran fiabilidad que permite un elevado tiempo de uso.<\/li>  <li>Facilidad de transporte gracias a su asa de transporte y su reducido peso.<\/li>  <li>Pistola reguladora de presi\u00f3n.<\/li>  <li>Pistola ergon\u00f3mica para limpiar de manera c\u00f3moda y segura gracias a su sistema de bloqueo de gatillo BS. block.<\/li>  <li>Facilidad de transporte con su asa y ruedas.<\/li>  <li><b>Composici\u00f3n<\/b><\/li>  <li>Hidrolimpiadora<\/li>  <li>Manguera de alta presi\u00f3n 3 metros<\/li>  <li>Lanza pl\u00e1stica<\/li>  <li>Pistola de alta presi\u00f3n<\/li>  <li>Boquilla normal<\/li>  <li>Boquilla 3DTurboFlip<\/li>  <li>Filtro anti impurezas<\/li>  <li>Botella regulable para el jab\u00f3n<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-hid%20hb%201400%20ego_1.jpg","wholesale_price":"52.58","unit_price_tax":57.58},"product_model":{"product_data":{"ean13":["8435484081368"],"reference":"08136","name":{"1":"Hidrolimpiadora Cecotec HydroBoost 1400 EasyGo","2":"","3":"","4":""},"description":{"1":"<p><h2>Potencia arrasadora<\/h2>Limpia m\u00e1s en menos tiempo gracias a su potencia de 1400 W y sus 105 bares de presi\u00f3n que pueden hasta con la suciedad m\u00e1s dif\u00edcil sin esfuerzo.<br><br><h2>Dise\u00f1o ligero y f\u00e1cil transporte<\/h2>Su reducido peso y su dise\u00f1o con ruedas y asa permiten limpiar c\u00f3modamente hasta el \u00faltimo rinc\u00f3n de tu jard\u00edn, terraza o coche.<br><br><h2>Limpieza total con espuma a presi\u00f3n<\/h2>Consigue resultados brillantes de la forma m\u00e1s sencilla gracias a su botella de jab\u00f3n que genera espuma a presi\u00f3n para una limpieza superior.<br><br><h2>Todo listo en segundos<\/h2>Ahorra tiempo y gana comodidad gracias al sistema iClick. Conecta y desconecta la manguera de alta presi\u00f3n o la lanza a la pistola de forma r\u00e1pida y sencilla.<br><br><h2>M\u00e1xima eficiencia en cada uso<\/h2>La hidrolimpiadora cuenta con una bomba de aluminio para ofrecer el m\u00e1ximo rendimiento. Adem\u00e1s, dispone del sistema Auto Start-Stop que alarga la vida \u00fatil del motor y ahorra agua en cada uso.<br><br><h2>Gran radio de acci\u00f3n<\/h2>Sus 11 metros de radio de acci\u00f3n permiten acabar con la suciedad de forma precisa y sin necesidad de que te acerques a ella.<br><br><h2>Manguera de alta presi\u00f3n<\/h2>Limpia sin obst\u00e1culos gracias a su manguera de alta presi\u00f3n de 3 metros que permite una gran libertad de moviento para acabar con la suciedad con total comodidad.<br><br><h2>Limpieza detallada<\/h2>La hidrolimpiadora cuenta con un kit de accesorios para limpiar todo tipo de superficies de la forma m\u00e1s eficiente.<br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Gran potencia de 1400W para limpiar de manera r\u00e1pida y eficiente.<\/li>  <li>M\u00e1xima presi\u00f3n admitida de 105 bares.<\/li>  <li>M\u00e1ximo caudal de 408 litros \/ hora para limpiar una mayor superficie en menos tiempo.<\/li>  <li>Botella regulable para jab\u00f3n.<\/li>  <li>Bomba HardPump de aluminio de gran fiabilidad que permite un elevado tiempo de uso.<\/li>  <li>Facilidad de transporte gracias a su asa de transporte y su reducido peso.<\/li>  <li>Pistola reguladora de presi\u00f3n.<\/li>  <li>Pistola ergon\u00f3mica para limpiar de manera c\u00f3moda y segura gracias a su sistema de bloqueo de gatillo BS. block.<\/li>  <li>Facilidad de transporte con su asa y ruedas.<\/li>  <li><b>Composici\u00f3n<\/b><\/li>  <li>Hidrolimpiadora<\/li>  <li>Manguera de alta presi\u00f3n 3 metros<\/li>  <li>Lanza pl\u00e1stica<\/li>  <li>Pistola de alta presi\u00f3n<\/li>  <li>Boquilla normal<\/li>  <li>Boquilla 3DTurboFlip<\/li>  <li>Filtro anti impurezas<\/li>  <li>Botella regulable para el jab\u00f3n<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CECOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":57.58,"unit_price_tax":57.58,"tax_rules_group":null,"category":"Bricolaje","sub_category":"Herramientas de Limpieza","quantity":0,"brand":"CECOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-hid%20hb%201400%20ego_1.jpg"],"wholesale_price":52.58}}},"8435484081122":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8435484081122",false],"wholesale_price":[29.42,false],"price":[34.42,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Aspirador El\u00e9trico Cecotec Conga Rockstar Wet &amp; Dry Compact Plus\/ 1200 W\/ Tanque 16L"],"result":false},"feed_data":{"name_pt":"Aspirador El\u00e9ctrico Cecotec Conga Rockstar Wet & Dry Compact Plus\/ 1200 W\/ Dep\u00f3sito 16L","category":"Bricolaje","sub_category":"Herramientas de Limpieza","unit_price":34.42,"reference":"08112","ean13":"8435484081122","weight":"0","quantity":0,"brand":"CECOTEC","description_pt":"<h2>Conga Rockstar Wet &amp; Dry Compact Plus<\/h2><p>Conga Rockstar Wet &amp; Dry Compact Plus Aspirador de s\u00f3lidos y l\u00edquidos de 16 L y 1200 W que permite un f\u00e1cil transporte gracias a su reducido peso y a su formato compacto, doble funci\u00f3n de succi\u00f3n y soplado<br><\/p><p><h2>Ultrapotencia dise\u00f1ada para durar.<\/h2><p>Con una potencia de hasta 1200W permite una succi\u00f3n extrema y eficiente para una limpieza profunda. Ultiliza un motor DC de ulta eficiencia para un mejor rendimeinto.<\/p><h2>Filtro de part\u00edculas<\/h2><p>Sus sistema de m\u00faltiple filtrado de particulas permite un mayor rendimiento y alargar la vida \u00fatil del aspirador. Garantiza la m\u00e1xima eficiencia con el sistema Multiphasic Filter.<\/p><h2>Compact<\/h2><p>Con sus 16L de capacidad lo convierten en un producto ultraligero, compacto y vers\u00e1til, con una maniobrabilidad perfecta.<\/p><h2>Filtro HEPA<\/h2><p>Su filtro de alta eficiencia filtra incluso lo que no ves a trav\u00e9s de de su red de fibras microsc\u00f3picas.<\/p><h2><b>Aspira s\u00f3lidos y l\u00edquidos<\/b><\/h2><p>Aspirador de s\u00f3lidos y l\u00edquidos tanto para interiores como para exteriores. Incluye un dep\u00f3sito de 16 L e incluye tecnolog\u00eda sin bolsas para una limpieza perfecta y un f\u00e1cil mantenimiento.<\/p><h2>Incluye funci\u00f3n sopladora<\/h2><p>Incluye funci\u00f3n sopladora Blowing System \u00fatil para soplar hojas del jard\u00edn o secar zonas donde se haya aspirado l\u00edquido para lograr un acabado perfecto de la limpieza.<\/p><h2>Descripci\u00f3n<\/h2><p><ul><li>Aspirador de s\u00f3lidos y l\u00edquidos utraligero y compacto con carcasa de pl\u00e1stico que permite una mejor maniobrabilidad para dejar impecable todas las zonas sin esfuerzo.<\/li><li>Contiene dos filtros para poder ser utilizado tanto en s\u00f3lidos como l\u00edquidos permitiendo as\u00ed una mayor durabilidad del producto y una mayor eficacia.<\/li><li>Con su potente funci\u00f3n de soplado ser\u00e1s capaz de limpiar en los lugares m\u00e1s dif\u00edciles sin esfuerzo y con su multitud de accesorios podr\u00e1s acabar con la suciedad de la forma m\u00e1s eficaz.<\/li><li>Facilidad de transporte gracias a su dise\u00f1o compacto y ergon\u00f3mico.<\/li><li>El aspirador cuenta con 4 ruedas de goma que proporcionan un f\u00e1cil desplazamiento y movilidad para evitar tirones y giros dif\u00edciles, adem\u00e1s de evitar riesgos de rayar los suelos. Con un cable de 5 metros de longitud, un tubo flexible y tubos r\u00edgidos para facilitar la limpieza de cualquier rinc\u00f3n, incluso los m\u00e1s complicados, gracias a un radio de acci\u00f3n 5 metros.<\/li><li>Su pr\u00e1ctico dise\u00f1o est\u00e1 concebido para que puedas guardar todos los accesorios en el propio cuerpo del aspirador, ahorrando espacio y facilitando su c\u00f3modo uso, transporte y almacenaje.<\/li><li><b>Composici\u00f3n<\/b><\/li><li>Accesorio 2 en 1<\/li><li>Tubo flexible<\/li><li>Accesorio para esquinas<\/li><li>Cepillo para el suelo<\/li><li>Tubo r\u00edgido<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-asp%20rock%20wet-dry%20cp_1.jpg","wholesale_price":"29.42","unit_price_tax":34.42},"product_model":{"product_data":{"ean13":["8435484081122"],"reference":"08112","name":{"1":"Aspirador El\u00e9ctrico Cecotec Conga Rockstar Wet & Dry Compact Plus\/ 1200 W\/ Dep\u00f3sito 16L","2":"","3":"","4":""},"description":{"1":"<h2>Conga Rockstar Wet &amp; Dry Compact Plus<\/h2><p>Conga Rockstar Wet &amp; Dry Compact Plus Aspirador de s\u00f3lidos y l\u00edquidos de 16 L y 1200 W que permite un f\u00e1cil transporte gracias a su reducido peso y a su formato compacto, doble funci\u00f3n de succi\u00f3n y soplado<br><\/p><p><h2>Ultrapotencia dise\u00f1ada para durar.<\/h2><p>Con una potencia de hasta 1200W permite una succi\u00f3n extrema y eficiente para una limpieza profunda. Ultiliza un motor DC de ulta eficiencia para un mejor rendimeinto.<\/p><h2>Filtro de part\u00edculas<\/h2><p>Sus sistema de m\u00faltiple filtrado de particulas permite un mayor rendimiento y alargar la vida \u00fatil del aspirador. Garantiza la m\u00e1xima eficiencia con el sistema Multiphasic Filter.<\/p><h2>Compact<\/h2><p>Con sus 16L de capacidad lo convierten en un producto ultraligero, compacto y vers\u00e1til, con una maniobrabilidad perfecta.<\/p><h2>Filtro HEPA<\/h2><p>Su filtro de alta eficiencia filtra incluso lo que no ves a trav\u00e9s de de su red de fibras microsc\u00f3picas.<\/p><h2><b>Aspira s\u00f3lidos y l\u00edquidos<\/b><\/h2><p>Aspirador de s\u00f3lidos y l\u00edquidos tanto para interiores como para exteriores. Incluye un dep\u00f3sito de 16 L e incluye tecnolog\u00eda sin bolsas para una limpieza perfecta y un f\u00e1cil mantenimiento.<\/p><h2>Incluye funci\u00f3n sopladora<\/h2><p>Incluye funci\u00f3n sopladora Blowing System \u00fatil para soplar hojas del jard\u00edn o secar zonas donde se haya aspirado l\u00edquido para lograr un acabado perfecto de la limpieza.<\/p><h2>Descripci\u00f3n<\/h2><p><ul><li>Aspirador de s\u00f3lidos y l\u00edquidos utraligero y compacto con carcasa de pl\u00e1stico que permite una mejor maniobrabilidad para dejar impecable todas las zonas sin esfuerzo.<\/li><li>Contiene dos filtros para poder ser utilizado tanto en s\u00f3lidos como l\u00edquidos permitiendo as\u00ed una mayor durabilidad del producto y una mayor eficacia.<\/li><li>Con su potente funci\u00f3n de soplado ser\u00e1s capaz de limpiar en los lugares m\u00e1s dif\u00edciles sin esfuerzo y con su multitud de accesorios podr\u00e1s acabar con la suciedad de la forma m\u00e1s eficaz.<\/li><li>Facilidad de transporte gracias a su dise\u00f1o compacto y ergon\u00f3mico.<\/li><li>El aspirador cuenta con 4 ruedas de goma que proporcionan un f\u00e1cil desplazamiento y movilidad para evitar tirones y giros dif\u00edciles, adem\u00e1s de evitar riesgos de rayar los suelos. Con un cable de 5 metros de longitud, un tubo flexible y tubos r\u00edgidos para facilitar la limpieza de cualquier rinc\u00f3n, incluso los m\u00e1s complicados, gracias a un radio de acci\u00f3n 5 metros.<\/li><li>Su pr\u00e1ctico dise\u00f1o est\u00e1 concebido para que puedas guardar todos los accesorios en el propio cuerpo del aspirador, ahorrando espacio y facilitando su c\u00f3modo uso, transporte y almacenaje.<\/li><li><b>Composici\u00f3n<\/b><\/li><li>Accesorio 2 en 1<\/li><li>Tubo flexible<\/li><li>Accesorio para esquinas<\/li><li>Cepillo para el suelo<\/li><li>Tubo r\u00edgido<\/li><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CECOTEC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":34.42,"unit_price_tax":34.42,"tax_rules_group":null,"category":"Bricolaje","sub_category":"Herramientas de Limpieza","quantity":0,"brand":"CECOTEC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-asp%20rock%20wet-dry%20cp_1.jpg"],"wholesale_price":29.42}}},"8435484081146":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8435484081146",false],"wholesale_price":[45.3,false],"price":[50.3,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Aspirador El\u00e9trico Cecotec Conga Rockstar Wet &amp; Dry Steel Max\/ 1400 W\/ 20L Dep\u00f3sito"],"result":false},"feed_data":{"name_pt":"Aspirador El\u00e9ctrico Cecotec Conga Rockstar Wet & Dry Steel Max\/ 1400 W\/ Dep\u00f3sito 20L","category":"Bricolaje","sub_category":"Herramientas de Limpieza","unit_price":50.3,"reference":"08114","ean13":"8435484081146","weight":"0","quantity":0,"brand":"CECOTEC","description_pt":"<h2>Conga Rockstar Wet &amp; Dry Steel Max<\/h2><p>Conga Rockstar Wet &amp; Dry Steel Max Aspirador de s\u00f3lidos y l\u00edquidos de metal que permite una mayor durabilidad y resistencia con capacidad de 20 L y 1400 W de potencia para acabados perfectos.<br><\/p><p><\/p><h2>Ultrapotencia dise\u00f1ada para durar.<\/h2><p>Con una potencia de hasta 1400W permite una succi\u00f3n extrema y eficiente para una limpieza profunda. Ultiliza un motor DC de ulta eficiencia para un mejor rendimiento.<\/p><h2>Filtro de part\u00edculas<\/h2><p>Su sistema de m\u00faltiple filtrado de part\u00edculas permite un mayor rendimiento y alargar la vida \u00fatil del aspirador. Garantiza la m\u00e1xima eficiencia con el sistema Multiphasic Filter.<\/p><h2>Tanque de gran capacidad<\/h2><p>Con sus 20 L de capacidad lo convierten en un producto de gran capacidad, con una maniobralidad perfecta.<\/p><h2>Filtro HEPA<\/h2><p>Su filtro de alta eficiencia filtra incluso lo que no ves a trav\u00e9s de de su red de fibras microsc\u00f3picas<\/p><h2>Aspira s\u00f3lidos y l\u00edquidos<\/h2><p>Aspirador de s\u00f3lidos y l\u00edquidos tanto para interiores como para exteriores. Incluye un dep\u00f3sito de 20 L e incluye tecnolog\u00eda sin bolsas para una limpieza perfecta y un f\u00e1cil mantenimiento.<\/p><h2>Incluye funci\u00f3n sopladora<\/h2><p>Incluye funci\u00f3n sopladora Blowing System \u00fatil para soplar hojas del jard\u00edn o secar zonas donde se haya aspirado l\u00edquido para lograr un acabado perfecto de la limpieza.<\/p><h2>Tanque de metal<\/h2><p>Su gran tanque de metal lo convierte en un producto ultraresistente que permite utilizar el producto con total comodidad y confianza sin preocuparte por su mantenimiento<\/p><h2>Sistema de f\u00e1cil vaciado<\/h2><p>Sistema de f\u00e1cil vaciado para limpiar y vaciar el producto sin esfuerzo<\/p><p><h2>Descripci\u00f3n<\/h2><p><ul><li>Aspirador de s\u00f3lidos y l\u00edquidos utraresistente y compacto con carcasa de metal que permite una mayor durabilidad.<\/li><li>Contiene dos filtros para poder ser utilizado tanto en s\u00f3lidos como l\u00edquidos permitiendo as\u00ed una mayor durabilidad del producto y una mayor eficacia.<\/li><li>Con su potente funci\u00f3n de soplado ser\u00e1s capaz de limpiar en los lugares m\u00e1s dif\u00edciles sin esfuerzo y con su multitud de accesorios podr\u00e1s acabar con la suciedad de la forma m\u00e1s eficaz.<\/li><li>Facilidad de transporte gracias a su dise\u00f1o compacto y ergon\u00f3mico.<\/li><li>El aspirador cuenta con 4 ruedas de goma que proporcionan un f\u00e1cil desplazamiento y movilidad para evitar tirones y giros dif\u00edciles, adem\u00e1s de evitar riesgos de rayar los suelos. Con un cable de 5 metros de longitud, un tubo flexible y tubos r\u00edgidos para facilitar la limpieza de cualquier rinc\u00f3n, incluso los m\u00e1s complicados, gracias a un radio de acci\u00f3n 5 metros.<\/li><li>Su pr\u00e1ctico dise\u00f1o est\u00e1 concebido para que puedas guardar todos los accesorios en el propio cuerpo del aspirador, ahorrando espacio y facilitando su c\u00f3modo uso, transporte y almacenaje.<\/li><li>Sistema de drenaje para vaciar el aspirador en su totalidad con una mayor facilidad de uso y una eficiencia extrema de limpieza del producto con la m\u00e1xima comodidad.<\/li><li><b>Composici\u00f3n<\/b><\/li><li>Accesorio 2 en 1<\/li><li>Tubo flexible<\/li><li>Accesorio para esquinas<\/li><li>Cepillo para el suelo<\/li><li>Tubo extensible<\/li><\/ul><\/p><br><\/p><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-asp%20rock%20wet-dry%20st_1.jpg","wholesale_price":"45.30","unit_price_tax":50.3},"product_model":{"product_data":{"ean13":["8435484081146"],"reference":"08114","name":{"1":"Aspirador El\u00e9ctrico Cecotec Conga Rockstar Wet & Dry Steel Max\/ 1400 W\/ Dep\u00f3sito