ages":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-car%2067w%20hypc%20com%20usba_1.jpg"],"wholesale_price":15.11}}},"8422521004947":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8422521004947",false],"wholesale_price":[101.64,false],"price":[106.64,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 9.35",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:227568","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/93a8f6856f0d0125aa1fb8370524198d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Altavoces Fonestar BLOCK-5\/ 90W\/ 2.0","category":"Altavoces","sub_category":"Altavoces","unit_price":106.64,"reference":"BLOCK-5","ean13":"8422521004947","weight":"9.35","quantity":0,"brand":"FONESTAR","description_pt":"<p><h2>Alta fidelidad Hi-Fi Altavoces BLOCK-5<\/h2><div><p>Pareja de altavoces Hi-Fi 5''<\/p><p><p>Dise\u00f1ado \u00edntegramente por FONESTAR con componentes de alta calidad, una construcci\u00f3n robusta en madera MDF recubierta de PVC negro y una est\u00e9tica ideal para integrar en cualquier mobiliario.<\/p><p>Ofrece un potente sonido sin distorsi\u00f3n con caja bass-reflex, para un refuerzo en frecuencias graves, que proporciona una gran calidad de sonido.<\/p><p>Sistema sencillo de instalaci\u00f3n en pared, que permite su instalaci\u00f3n tanto en vertical como en horizontal y minimiza el tiempo de configuraci\u00f3n en funci\u00f3n del uso.<\/p><p>Para uso dom\u00e9stico o aulas, oficinas, presentaciones y peque\u00f1as sonorizaciones.<\/p><\/p><p><ul><li>Gran calidad de sonido<\/li><li>Dise\u00f1o elegante con un acabado excepcional<\/li><li>Construcci\u00f3n robusta con componentes de alta calidad<\/li><li>Caja tipo bass-reflex, para un refuerzo en frecuencias graves<\/li><li>Sistema sencillo de instalaci\u00f3n en pared<\/li><\/ul><div><br><\/div><\/p><h2>Especificaciones<\/h2><p><ul><li><b>CARACTER\u00cdSTICAS<\/b>: Pareja de altavoces Hi-Fi compactos.<\/li><li>Gran calidad de sonido.<\/li><li>Construcci\u00f3n en madera MDF recubierta de PVC negro.<\/li><li>Caja tipo bass-reflex.<\/li><li><b>POTENCIA<\/b>: 90 + 90 W m\u00e1ximo, 60 + 60 W RMS<\/li><li><b>ALTAVOCES<\/b>: 1 woofer 5' de alta resistencia con im\u00e1n de ferrita<\/li><li>1 tweeter c\u00fapula de seda 1' con im\u00e1n neodimio<\/li><li><b>RESPUESTA<\/b>: 65-20.000 Hz \u00b13 dB<\/li><li><b>IMPEDANCIA<\/b>: 8 &#937;<\/li><li><b>SENSIBILIDAD<\/b>: 85 dB \u00b12 dB a 1 W\/1 m<\/li><li><b>CONECTORES<\/b>: Terminales roscados o bananas dorados<\/li><li><b>RED DE CRUCE<\/b>: 2 v\u00edas<\/li><li>Frecuencia de cruce a 3.000 Hz<\/li><li><b>COLOR<\/b>: Negro<\/li><li><b>MEDIDAS<\/b>: 183 x 296 x 198 mm fondo<\/li><li><b>PESO<\/b>: 2 x 4'1 kg<\/li><li><b>ACCESORIOS<\/b>: Patas de goma<\/li><\/ul><\/p><\/div><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_fone-alt%20block-5%20bk_1.jpg","wholesale_price":"101.64","unit_price_tax":106.64},"product_model":{"product_data":{"ean13":["8422521004947"],"reference":"BLOCK-5","name":{"1":"Altavoces Fonestar BLOCK-5\/ 90W\/ 2.0","2":"","3":"","4":""},"description":{"1":"<p><h2>Alta fidelidad Hi-Fi Altavoces BLOCK-5<\/h2><div><p>Pareja de altavoces Hi-Fi 5''<\/p><p><p>Dise\u00f1ado \u00edntegramente por FONESTAR con componentes de alta calidad, una construcci\u00f3n robusta en madera MDF recubierta de PVC negro y una est\u00e9tica ideal para integrar en cualquier mobiliario.<\/p><p>Ofrece un potente sonido sin distorsi\u00f3n con caja bass-reflex, para un refuerzo en frecuencias graves, que proporciona una gran calidad de sonido.<\/p><p>Sistema sencillo de instalaci\u00f3n en pared, que permite su instalaci\u00f3n tanto en vertical como en horizontal y minimiza el tiempo de configuraci\u00f3n en funci\u00f3n del uso.<\/p><p>Para uso dom\u00e9stico o aulas, oficinas, presentaciones y peque\u00f1as sonorizaciones.<\/p><\/p><p><ul><li>Gran calidad de sonido<\/li><li>Dise\u00f1o elegante con un acabado excepcional<\/li><li>Construcci\u00f3n robusta con componentes de alta calidad<\/li><li>Caja tipo bass-reflex, para un refuerzo en frecuencias graves<\/li><li>Sistema sencillo de instalaci\u00f3n en pared<\/li><\/ul><div><br><\/div><\/p><h2>Especificaciones<\/h2><p><ul><li><b>CARACTER\u00cdSTICAS<\/b>: Pareja de altavoces Hi-Fi compactos.<\/li><li>Gran calidad de sonido.<\/li><li>Construcci\u00f3n en madera MDF recubierta de PVC negro.<\/li><li>Caja tipo bass-reflex.<\/li><li><b>POTENCIA<\/b>: 90 + 90 W m\u00e1ximo, 60 + 60 W RMS<\/li><li><b>ALTAVOCES<\/b>: 1 woofer 5' de alta resistencia con im\u00e1n de ferrita<\/li><li>1 tweeter c\u00fapula de seda 1' con im\u00e1n neodimio<\/li><li><b>RESPUESTA<\/b>: 65-20.000 Hz \u00b13 dB<\/li><li><b>IMPEDANCIA<\/b>: 8 &#937;<\/li><li><b>SENSIBILIDAD<\/b>: 85 dB \u00b12 dB a 1 W\/1 m<\/li><li><b>CONECTORES<\/b>: Terminales roscados o bananas dorados<\/li><li><b>RED DE CRUCE<\/b>: 2 v\u00edas<\/li><li>Frecuencia de cruce a 3.000 Hz<\/li><li><b>COLOR<\/b>: Negro<\/li><li><b>MEDIDAS<\/b>: 183 x 296 x 198 mm fondo<\/li><li><b>PESO<\/b>: 2 x 4'1 kg<\/li><li><b>ACCESORIOS<\/b>: Patas de goma<\/li><\/ul><\/p><\/div><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"FONESTAR","supplier":null,"width":null,"height":null,"depth":null,"weight":9.35,"unit_price":106.64,"unit_price_tax":106.64,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":0,"