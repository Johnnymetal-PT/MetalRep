ini (M1, 2020)<\/li>    <li>Mac Pro (finales de 2013-2019)<\/li>  <\/ul>  <li>Modelos de iPod<\/li>  <ul>    <li>iPod touch (7.\u00aa generaci\u00f3n)<\/li>  <\/ul>  <li>    <h2>Los AirPods Max y el medio ambiente<\/h2>  <\/li>  <li>Para evaluar su impacto medioambiental, Apple tiene en cuenta todo el ciclo de vida de los productos. <\/li>  <li>Los AirPods Max se han dise\u00f1ado con estas caracter\u00edsticas para reducir su impacto medioambiental:<\/li>  <li>Sin retardantes de llama bromados<\/li>  <li>Sin PVC<\/li>  <li>Sin berilio<\/li><\/ul><br><\/p>                                                                                        ","2":""},"description_short":{"1":"","2":""},"meta_description":{"1":"","2":""},"meta_keywords":{"1":"","2":""},"meta_title":{"1":"","2":""},"link_rewrite":{"1":"","2":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":1.44,"unit_price":389.71,"unit_price_tax":389.71,"tax_rules_group":null,"category":"Accesorios Apple","sub_category":"Accesorios y Perif\u00e9ricos Apple","quantity":0,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-aur%20mgym3tybardera_1.jpg"],"wholesale_price":384.71}}},"0194252085806":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194252085806",false],"wholesale_price":[411.81,false],"price":[416.81,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 1.46",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:71524","Cat. IDs: 2,2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/c008454f429f4da570aa23e4ed0fc8c9.jpg; <br>-------------------------------"