u00f3n : GPS, AGPS, Glonass, Beidou, Galileo<\/li><li>Bluetooth : v5.3<\/li><li>WiFi : WiFi 5<\/li><li>Redmi A3<\/li><li>WiFi<\/li><li>Protocolo : 802.11 a\/b\/g\/n\/ac, 2,4GHz\/5GHz<\/li><\/ul><\/p><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0.32,"unit_price":73.93,"unit_price_tax":73.93,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":5,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20redmi%20a3%203-64%20bl_1.jpg"],"wholesale_price":68.93}}},"8006023114580":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8006023114580",false],"wholesale_price":[16.25,false],"price":[21.25,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Suporte Fixo de Parede Meliconi ES400 para TV 37-50&#39;\/ at\u00e9 30kg"],"result":false},"feed_data":{"name_pt":"Soporte de Pared Fijo Meliconi ES400 para TV de 37-50'\/ hasta 30kg","category":"Soportes para TV","sub_category":"Soportes TV","unit_price":21.25,"reference":"580402","ean13":"8006023114580","weight":"0","quantity":0,"brand":"MELICONI","description_pt":"<p><h2>Especificaciones<\/h2><p><ul><li>Dimensi\u00f3n TV: 37' - 50'&nbsp;<\/li><li>Capacidad m\u00e1x.: 30 kg&nbsp;<\/li><li>VESA: 200 - 300 - 400 mm&nbsp;<\/li><li>Distancia de la pared: 11 mm&nbsp;<\/li><li>TUV: certificado el peso indicado x 3 veces&nbsp;<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es