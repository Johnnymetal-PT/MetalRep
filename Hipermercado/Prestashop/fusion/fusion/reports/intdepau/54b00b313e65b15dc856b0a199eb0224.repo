cription_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":0.3,"unit_price":115.64,"unit_price_tax":115.64,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":2,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-sp%20a057g%204-64%20sv%20v2_1.jpg"],"wholesale_price":110.64}}},"8806094968446":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806094968446",false],"wholesale_price":[269,false],"price":[274,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Samsung Galaxy A54 8GB\/ 128GB\/ 6,4&#39;\/ 5G\/ Preto Grafite"],"result":false},"feed_data":{"name_pt":"Smartphone Samsung Galaxy A54 8GB\/ 128GB\/ 6.4'\/ 5G\/ Negro Grafito","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":274,"reference":"SM-A546BZKCEEB","ean13":"8806094968446","weight":"0.33","quantity":5,"brand":"SAMSUNG","description_pt":"<p><h2>Captura tus momentos m\u00e1s Awesome con sus m\u00faltiples c\u00e1maras<\/h2><h2>C\u00e1mara para selfies<\/h2><p>32MP (f\/2.2)<\/p><h2>C\u00e1mara ultra gran angular<\/h2><p>12MP (F\/2.2)<\/p><h2>C\u00e1mara principal<\/h2><p>50MP (F\/1.8) IOS<\/p><h2>C\u00e1mara macro<\/h2><p>5MP (F\/2.4)<\/p><h2>Revive tus noches m\u00e1s m\u00e1gicas con Nightography<\/h2><h2>Nightography Awesome<\/h2><p>Haz fotos sin pensar. Galaxy A54 5G captura fotograf\u00edas v\u00edvidas con su sensor de imagen avanzado. En la oscuridad, la c\u00e1mara se pone autom\u00e1ticamente en modo noche.<\/p><h2>M\u00e1s de 2 d\u00edas de bater\u00eda<\/h2><p>La bater\u00eda de Galaxy A54 5G de 5.000mAh te da energ\u00eda para m\u00e1s de 2 d\u00edas<\/p><h2>Velocidad que te llevar\u00e1 lejos<\/h2><h2>5G<\/h2><p>Descubre a d\u00f3nde puedes llegar con la m\u00e1xima velocidad. Desata tu potencial en 5G con redes ultrar\u00e1pidas que rompen cualquier l\u00edmitey te permiten hacerlo todo.<\/p><h2>Potencia sin l\u00edmites<\/h2><h2>Procesador<\/h2><p>Su alt\u00edsimo rendimiento desata todo su potencial. El potente procesador octa-core abre un mundo de posibilidades gracias a su capacidad y rendimiento mejorados.<\/p><h2>Creado para aguantarlo todo<\/h2><h2>Durabilidad<\/h2><p>LL\u00e9vatelo a todas tus aventuras. Con certificaci\u00f3n IP67 de resistencia al polvo y al agua, Galaxy A54 5G est\u00e1 preparado para acompa\u00f1arte tanto en aguas tranquilos como en caminos salvajes.<\/p><h2>Inspirado en la sencillez<\/h2><p>Con un acabado premium en cristal, un m\u00f3dulo de c\u00e1mara con un dise\u00f1o elegante y colores que transmiten energ\u00eda, Galaxy A54 5G lleva inscrita su identidad Awesome en su aspecto conseguido y minimalista.<\/p><h2>Graba v\u00eddeos muy Awesome sin despeinarte<\/h2><p>Con VDIS y un OIS gran angular, Galaxy A54 5G te ayuda a conseguir v\u00eddeos de alta calidad f\u00e1cilmente mediante el enfoque y el reencuadre autom\u00e1ticos.<\/p><h2>N\u00edtida y luminosa incluso bajo la luz del sol<\/h2><p>Todo lo que veas te encantar\u00e1. Su pantalla FHD+ Infinity-O de 6,4 pulgadas ofrece una imagen vibrante y visibilidad completa en exteriores y suave como la seda, con tasas de refresco de hasta 120Hz.<\/p><ul><li>Procesador<\/li><li>Velocidad CPU<\/li><li>2.4GHz, 2GHz<\/li><li>Tipo CPU<\/li><li>Octa-Core<\/li><li>Pantalla<\/li><li>Tama\u00f1o<\/li><li>163.1mm (6.4' full rectangle) \/ 158.9mm (6.3' rounded corners)<\/li><li>Resoluci\u00f3n<\/li><li>1080 x 2340 (FHD+)<\/li><li>Tecnolog\u00eda<\/li><li>Super AMOLED<\/li><li>N\u00famero de colores<\/li><li>16M<\/li><li>Tasa de refresco m\u00e1x<\/li><li>120 Hz<\/li><li>C\u00e1mara<\/li><li>C\u00e1mara principal - Resoluci\u00f3n (M\u00faltiple)<\/li><li>50.0 MP + 12.0 MP + 5.0 MP<\/li><li>C\u00e1mara principal - Apertura (M\u00faltiple)<\/li><li>F1.8 , F2.2 , F2.4<\/li><li>C\u00e1mara principal - Autofocus<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal - OIS<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal Zoom<\/li><li>Zoom digital hasta 10x<\/li><li>C\u00e1mara frontal - Resoluci\u00f3n<\/li><li>32.0 MP<\/li><li>C\u00e1mara frontal - Apertura<\/li><li>F2.2<\/li><li>C\u00e1mara frontal - Autoenfoque<\/li><li>No<\/li><li>C\u00e1mara frontal - OIS<\/li><li>No<\/li><li>C\u00e1mara principal - Flash<\/li><li>S\u00ed<\/li><li>C\u00e1mara frontal - Flash<\/li><li>No<\/li><li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li><li>UHD 4K (3840 x 2160)@30fps<\/li><li>Slow Motion<\/li><li>240fps @HD<\/li><li>Almacenamiento\/Memoria<\/li><li>Memoria_(GB)<\/li><li>8<\/li><li>Almacenamiento (GB)<\/li><li>128<\/li><li>Soporte de almacenamiento externo<\/li><li>MicroSD (hasta 1TB)<\/li><li>Redes\/Bandas<\/li><li>N\u00famero de SIM<\/li><li>Dual-SIM<\/li><li>Tipo de SIM<\/li><li>Nano-SIM (4FF), SIM embebida<\/li><li>Tipo de bandeja de SIM<\/li><li>SIM 1 + Hybrid (SIM or MicroSD) or Embedded SIM<\/li><li>Infra<\/li><li>2G GSM, 3G WCDMA, 4G LTE FDD, 4G LTE TDD, 5G Sub6 FDD, 5G Sub6 TDD<\/li><li>2G GSM<\/li><li>GSM850, GSM900, DCS1800, PCS190<\/li><li>3G UMTS<\/li><li>B1(2100), B2(1900), B4(AWS), B5(850), B8(900)<\/li><li>4G FDD LTE<\/li><li>B1(2100), B2(1900), B3(1800), B4(AWS), B5(850), B7(2600), B8(900), B12(700), B17(700), B20(800), B26(850), B28(700), B32(1500), B66(AWS-3)<\/li><li>4G TDD LTE<\/li><li>B38(2600), B40(2300), B41(2500)<\/li><li>5G FDD Sub6<\/li><li>N1(2100), N3(1800), N7(2600), N8(900), N20(800), N28(700)<\/li><li>5G TDD Sub6<\/li><li>N38(2600), N40(2300), N41(2500), N77(3700), N78(3500)<\/li><li>Conectiv