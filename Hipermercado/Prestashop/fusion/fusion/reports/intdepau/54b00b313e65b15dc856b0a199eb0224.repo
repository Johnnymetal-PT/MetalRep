0note13%208-128%20gree_1.jpg"],"wholesale_price":145.75}}},"8806095268378":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806095268378",false],"wholesale_price":[110.64,false],"price":[115.64,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Samsung Galaxy A05s 4GB\/ 64GB\/ 6,7&#39;\/ Preto"],"result":false},"feed_data":{"name_pt":"Smartphone Samsung Galaxy A05s 4GB\/ 64GB\/ 6.7'\/ Negro","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":115.64,"reference":"SM-A057GZKUEUE","ean13":"8806095268378","weight":"0.29","quantity":0,"brand":"SAMSUNG","description_pt":"<p><h2>Sum\u00e9rgete en una experiencia inmersiva<\/h2><p>Disfr\u00fatalo todo con una claridad sorprendente. La pantalla FHD+ de 6,7' se encarga de que tus juegos y contenidos favoritos sean totalmente inmersivos y alcancen la m\u00e1xima calidad de imagen.<\/p><h2>Captura m\u00e1s con varias c\u00e1maras<\/h2><p><strong>13MP<\/strong><br>C\u00e1mara frontal<\/p><p><strong>2MP<\/strong><br>C\u00e1mara Macro<\/p><p><strong>50MP<\/strong><br>C\u00e1mara Ultra gran angular<\/p><p><strong>2MP<\/strong><br>C\u00e1mara de profundidad<\/p><h2>Momentos para saborear y compartir<\/h2><p>Vuelve a los paisajes que capturaste con la C\u00e1mara Principal de 50 MP, a los detalles inmortalizados con la C\u00e1mara Macro de 2MP, a los retratos perfectos tomados con la C\u00e1mara de Profundidad de 2 MP o a aquellos selfies magn\u00edficos que te hiciste con la C\u00e1mara Frontal de 13 MP.<\/p><h2>Equipado para rendir m\u00e1s y mejor<\/h2><p>No dejes de hacer lo que m\u00e1s te gusta. Con un potente procesador Snapdragon\u00ae 680, 4\/6 GB de memoria y 64\/128 GB de almacenamiento, Galaxy A05s est\u00e1 equipado para rendir al m\u00e1ximo cuando juegues, veas contenido o lo compartas en redes sociales.<\/p><h2>Bater\u00eda para todo el d\u00eda<\/h2><p>Con la bater\u00eda (t\u00edpica) de 5.000 mAh** te da tiempo de sobra para hacer todo lo que te gusta: jugar, ver series, ver tus redes sociales y mucho m\u00e1s. Y con hasta 25 W de Carga S\u00faper R\u00e1pida, puedes tenerla llena de nuevo r\u00e1pidamente.<\/p><h2>Sensor lateral de huella dactilar<\/h2><p>A\u00f1ade una capa extra de seguridad gracias al sensor lateral de huella dactilar que solo reconoce tu huella.<\/p><h2>Ench\u00fafalo y&#8230; \u00a1A seguir!<\/h2><p>Nos gustan las soluciones \u00fatiles, r\u00e1pidas y sencillas como el jack de 3,5 mm, siempre a punto para que enchufes tus auriculares de toda la vida.<\/p><ul><li><strong>Procesador<\/strong><\/li><li>Velocidad CPU<\/li><li>2.4GHz, 1.9GHz<\/li><li>Tipo CPU<\/li><li>Octa-Core<\/li><li><strong>Pantalla<\/strong><\/li><li>Tama\u00f1o<\/li><li>170.8mm (6.7' full rectangle) \/ 166.4mm (6.6' rounded corners)<\/li><li>Resoluci\u00f3n<\/li><li>1080 x 2400 (FHD+)<\/li><li>Tecnolog\u00eda<\/li><li>PLS LCD<\/li><li>N\u00famero de colores<\/li><li>16M<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara principal - Resoluci\u00f3n (M\u00faltiple)<\/li><li>50.0 MP + 2.0 MP + 2.0 MP<\/li><li>C\u00e1mara principal - Apertura (M\u00faltiple)<\/li><li>F1.8 , F2.4 , F2.4<\/li><li>C\u00e1mara principal - Autofocus<\/li><li>S\u00ed<\/li><li>C\u00e1mara principal - OIS<\/li><li>No<\/li><li>C\u00e1mara principal Zoom<\/li><li>Zoom digital hasta 10x<\/li><li>C\u00e1mara frontal - Resoluci\u00f3n<\/li><li>13.0 MP<\/li><li>C\u00e1mara frontal - Apertura<\/li><li>F2.0<\/li><li>C\u00e1mara frontal - Autoenfoque<\/li><li>No<\/li><li>C\u00e1mara frontal - OIS<\/li><li>No<\/li><li>C\u00e1mara principal - Flash<\/li><li>S\u00ed<\/li><li>C\u00e1mara frontal - Flash<\/li><li>No<\/li><li>Resoluci\u00f3n de grabaci\u00f3n de v\u00eddeo<\/li><li>FHD (1920 x 1080)@60fps<\/li><li>Slow Motion<\/li><li>120fps @HD<\/li><li><strong>Almacenamiento\/Memoria<\/strong><\/li><li>Memoria_(GB)<\/li><li>4<\/li><li>Almacenamiento (GB)<\/li><li>64<\/li><li>Soporte de almacenamiento externo<\/li><li>MicroSD (hasta 1TB)<\/li><li><strong>Redes\/Bandas<\/strong><\/li><li>N\u00famero de SIM<\/li><li>Dual-SIM<\/li><li>Tipo de SIM<\/li><li>Nano-SIM (4FF)<\/li><li>Tipo de bandeja de SIM<\/li><li>SIM 1 + SIM 2 + MicroSD<\/li><li>Infra<\/li><li>2G GSM, 3G WCDMA, 4G LTE FDD, 4G LTE TDD<\/li><li>2G GSM<\/li><li>GSM850, GSM900, DCS1800<\/li><li>3G UMTS<\/li><li>B1(2100), B5(850), B8(900)<\/li><li>4G FDD LTE<\/li><li>B1(2100), B3(1800), B5(850), B7(2600), B8(900), B20(800), B28(700)<\/li><li>4G TDD LTE<\/li><li>B38(2600), B40(2300), B41(2500)<\/li><li><strong>Conectividad<\/strong><\/li><li>Interfaz USB<\/li><li>USB Tipo C<\/li><li>Versi\u00f3n USB<\/li><li>USB 2.0<\/li><li>Localizaci\u00f3n<\/li><li>GPS, Glonass, Beidou, Galileo, QZSS<\/li><li>Auriculares<\/li><li>3.5mm Stereo<\/li><li>MHL<\/li><li>No<\/li><li>Wi-Fi<\/li><li>802.11 a\/b\/g\/n\/ac 2.4G+5GHz, VHT80<\/li><li>Wi-Fi Direct<\/li><li>S\u00ed<\/li><li>Versi\u00f3n Bluetooth<\/li><li>Bluetooth v5.1<\/li><li>NFC<\/li><li>S\u00ed<\/li><li>PC Sync.<\/li><li>Smart Switch (PC version)<\/li><li><strong>Sistema Operativo<\/strong><\/li><li>Android<\/li><li><strong>Informaci\u00f3n general<\/strong><\/li><li>Color<\/li><li>Black<\/li><li>Formato<\/li><li>T\u00e1ctil<\/li><li><strong>Sensores<\/strong><\/li><li>Aceler\u00f3metro, Sensor de huella dactilar, Luminosidad, Sensor de Proximidad<\/li><li><strong>Especificaciones f\u00edsicas<\/strong><\/li><li>Dimensiones (AlxAnxProf, mm)<\/li><li>168.0 x 77.8 x 8.8<\/li><li>Peso (g)<\/li><li>195<\/li><li><strong>Bater\u00eda<\/strong><\/li><li>Capacidad de bater\u00eda (mAh, t\u00edpico)<\/li><li>5000<\/li><li>Extra\u00edble<\/li><li>No<\/li><li><strong>Audio y V\u00eddeo<\/strong><\/li><li>Formatos de reproducci\u00f3n de V\u00eddeo<\/li><li>MP4, M4V, 3GP, 3G2, AVI, FLV, MKV, WEBM<\/li><li>Resoluci\u