a\u00fan m\u00e1s sorprendentes a los juegos para PC basados &#8203;&#8203;en Microsoft Windows. Las tarjetas gr\u00e1ficas GeForce RTX ofrecen funciones DX12 avanzadas como trazado de rayos y sombreado de velocidad variable, lo que da vida a los juegos con efectos visuales ultrarrealistas y velocidades de cuadro m\u00e1s r\u00e1pidas.<\/p><br><\/p><p><h2>Especificaciones<\/h2><p><ul><li><b>Procesamiento de gr\u00e1ficos<\/b><\/li><li>GeForce RTX 3050<\/li><li><b>Reloj de n\u00facleo<\/b><\/li><li>1477 MHz (tarjeta de referencia: 1470 MHz)<\/li><li><b>N\u00facleos CUDA<\/b><\/li><li>2304<\/li><li><b>Reloj de memoria<\/b><\/li><li>14000 MHz<\/li><li><b>Tama\u00f1o de la memoria<\/b><\/li><li>6 GB<\/li><li><b>Tipo de memoria<\/b><\/li><li>GDDR6<\/li><li><b>Bus de memoria<\/b><\/li><li>96 bit<\/li><li><b>Bus de la tarjeta<\/b><\/li><li>PCI-E 4.0<\/li><li><b>Resoluci\u00f3n m\u00e1xima digital<\/b><\/li><li>7680x4320<\/li><li><b>Vista m\u00faltiple<\/b><\/li><li>4<\/li><li><b>Tama\u00f1o de la tarjeta<\/b><\/li><li>L=191 W=111 H=36 mm<\/li><li><b>Formato de PCB<\/b><\/li><li>ATX<\/li><li>DirectX<\/li><li><b>12 Ultimate<\/b><\/li><li>OpenGL<\/li><li>4.6<\/li><li><b>Fuente de alimentaci\u00f3n recomendada<\/b><\/li><li>300 W<\/li><li><b>Conectores de alimentaci\u00f3n<\/b><\/li><li>N\/D<\/li><li><b>Salida<\/b><\/li><li>DP1.4a*2<\/li><li>HDMI 2.1*2<\/li><li><b>Accesorios<\/b><\/li><li>Gu\u00eda r\u00e1pida<\/li><\/ul><\/p><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GIGABYTE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":180.74,"unit_price_tax":180.74,"tax_rules_group":null,"category":"Componentes","sub_category":"Tarjetas Graficas","quantity":0,"brand":"GIGABYTE","images":["http