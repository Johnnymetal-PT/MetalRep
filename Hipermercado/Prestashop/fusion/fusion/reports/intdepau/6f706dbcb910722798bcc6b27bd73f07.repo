a_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":241.44,"unit_price_tax":241.44,"tax_rules_group":null,"category":"Tablets","sub_category":"Tablets","quantity":0,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-tab%20x216%208-128%20sv%20sp_1.jpg"],"wholesale_price":236.44}}},"6941812756553":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941812756553",false],"wholesale_price":[169.57,false],"price":[174.57,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Tablet Xiaomi Redmi Pad SE 11&#39;\/ 8GB\/ 256GB\/ Octacore\/ Verde Menta"],"result":false},"feed_data":{"name_pt":"Tablet Xiaomi Redmi Pad SE 11'\/ 8GB\/ 256GB\/ Octacore\/ Verde Menta","category":"Tablets","sub_category":"Tablets","unit_price":174.57,"reference":"RED PADSE 8-256 GREE","ean13":"6941812756553","weight":"0.85","quantity":5,"brand":"XIAOMI","description_pt":"<p><h2>Redmi Pad Se<\/h2><p>Diversi\u00f3n en estado puro<\/p><h2>Pantalla FHD+ de 11' inmersiva<\/h2><h2>Tasa de refresco fluida de 90 Hz con AdaptiveSync<\/h2><p>La gran pantalla FHD+ de 11' con 16,7 millones de colores y una tasa de refresco fluida de 90 Hz con AdaptiveSync, garantiza una experiencia visual n\u00edtida y fluida para tu entretenimiento del d\u00eda a d\u00eda.<\/p><h2>Certificaci\u00f3n profesional low blue light para la protecci\u00f3n de tu vista<\/h2><h2>Pantalla LCD con atenuaci\u00f3n de CC<\/h2><p>Gracias a las certificaciones&nbsp; low blue light&nbsp; y tecnolog\u00eda sin parpadeos Flicker Free Certification de T\u00dcV Rheinland, no tendr\u00e1s que preocuparte por el da\u00f1o que el tiempo de uso prolongado pueda causar a tus ojos o a los de tus hijos.<\/p><h2>Cuatro altavoces est\u00e9reo compatibles con Dolby Atmos\u00ae<\/h2><p>Los cuatro altavoces te ofrecen un sonido envolvente extraordinario para disfrutar de una experiencia tan inmersiva como la de un sistema de cine en casa.<\/p><h2>Dise\u00f1o port\u00e1til, compacto y ligero<\/h2><p>Ll\u00e9vate tu Redmi Pad SE a todas partes.<\/p><h2>C\u00e1mara principal n\u00edtida de 8 MP<\/h2><p>Mejora tu experiencia de videollamada con la c\u00e1mara frontal centrada de 5 MP. Haz fotos de alta resoluci\u00f3n con la n\u00edtida c\u00e1mara principal de 8 MP.<\/p><h2>Excepcional capacidad de 8000 mAh (typ)<\/h2><p>Gracias a la bater\u00eda de larga duraci\u00f3n, no tendr\u00e1s que preocuparte por la carga mientras viajas, ves v\u00eddeos o asistes a reuniones en l\u00ednea.<\/p><h2>Potente Snapdragon\u00ae 680<\/h2><p>La avanzada tecnolog\u00eda de proceso de 6 nm mejora enormemente el rendimiento y proporciona una alta frecuencia de actualizaci\u00f3n de la pantalla para disfrutar de una experiencia r\u00e1pida y fluida.<\/p><h2>Hasta 1 TB de almacenamiento ampliable<\/h2><p>Disponible a partir de 8 GB de RAM + 128 GB de ROM, la velocidad del Redmi Pad SE puede satisfacer todas tus necesidades diarias. Y con hasta 1 TB de almacenamiento ampliable, tendr\u00e1s espacio de sobra para todas tus descargas.<\/p><h2>Mejora tu experiencia con MIUI Pad 14<\/h2><p>MIUI Pad 14 ofrece una experiencia c\u00f3moda y eficiente con gestos y adaptaci\u00f3n de aplicaciones mejorados.<\/p><ul><li><b>Procesador<\/b><\/li><li>Plataforma m\u00f3vil Snapdragon\u00ae 680<\/li><li>Tecnolog\u00eda de proceso de 6 nm<\/li><li>CPU: 8 n\u00facleos, hasta 2,4 GHz<\/li><li>GPU: Qualcomm\u00ae Adreno&#8482;<\/li><li><b>Almacenamiento y RAM<\/b><\/li><li>LPDDR4X + eMMC 5.1<\/li><li>RAM y ROM: 8 GB+256 GB<\/li><li>Alma