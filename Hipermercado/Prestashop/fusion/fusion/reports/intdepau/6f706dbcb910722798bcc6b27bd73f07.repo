es","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b951ee27aea05aba0b48d2cfda7231be.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Hub USB 2.0 Vention CHMBF\/ 4xUSB\/ 1m","category":"Perif\u00e9ricos","sub_category":"Hub USB","unit_price":8.42,"reference":"CHMBF","ean13":"6922794746596","weight":"0","quantity":0,"brand":"VENTION","description_pt":"<p><h2>Hub USB 2.0 de 4 puertos<\/h2><p>Expanda 4 puertos USB para su computadora<\/p><h2>Caracter\u00edsticas<\/h2><ul><li>De color negro<\/li><li>Tipo de conector: USB-A\/USB 2.0x4\/Micro-B<\/li><li>T\u00e9cnicas de interfaz: niquelado<\/li><li>Velocidad USB: 480Mbps (USB 2.0)<\/li><li>Entrada nominal: 5V&#9107;2A<\/li><li>Carcasa: ABS<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-hub%20chmbf_1.jpg","wholesale_price":"3.42","unit_price_tax":8.42},"product_model":{"product_data":{"ean13":["6922794746596"],"reference":"CHMBF","name":{"1":"Hub USB 2.0 Vention CHMBF\/ 4xUSB\/ 1m","2":"","3":"","4":""},"description":{"1":"<p><h2>Hub USB 2.0 de 4 puertos<\/h2><p>Expanda 4 puertos USB para su computadora<\/p><h2>Caracter\u00edsticas<\/h2><ul><li>De color negro<\/li><li>Tipo de conector: USB-A\/USB 2.0x4\/Micro-B<\/li><li>T\u00e9cnicas de interfaz: niquelado<\/li><li>Velocidad USB: 480Mbps (USB 2.0)<\/li><li>Entrada nominal: 5V&#9107;2A<\/li><li>Carcasa: ABS<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":8.42,"unit_price_tax":8.42,"tax_rules_group":null,"category":"Perif\u00e9ricos","sub_category":"Hub USB","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-hub%20chmbf_1.jpg"],"wholesale_price":3.42}}},"5099206079724":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5099206079724",false],"wholesale_price":[29.45,false],"price":[34.45,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.18",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:167838","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b791f05afb8f586665dab7ccf33d1d5a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rat\u00f3n Gaming Logitech G Pro Hero\/ Hasta 25600 DPI\/ Negro","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ratones","unit_price":34.45,"reference":"910-005440","ean13":"5099206079724","weight":"0.18","quantity":0,"brand":"LOGITECH","description_pt":"<p><h2>UN PROPOSITO<\/h2>En los deportes electr\u00f3nicos, ganar no se mide en metros o segundos, sino en micr\u00f3metros y milisegundos. Cuando hay mucho en juego, un solo movimiento y clic puede marcar la diferencia entre volver a casa con 5.000 d\u00f3lares o 500.000 d\u00f3lares. Por eso Logitech G cre\u00f3 PRO. Mejorado con HERO, nuestro sensor de juegos m\u00e1s avanzado, para brindar la incre\u00edble velocidad y precisi\u00f3n necesarias para ganar.<br><br><h2>SENSOR H\u00c9ROE 25K<\/h2>HERO 25K es nuestro sensor de juegos m\u00e1s preciso hasta la fecha con precisi\u00f3n de pr\u00f3xima generaci\u00f3n y una arquitectura innovadora. HERO 25K es capaz de ofrecer m\u00e1s de 400 IPS, 100 - 25 600 DPI y cero suavizado, filtrado o aceleraci\u00f3n en todo el rango de DPI. HERO 25K logra una precisi\u00f3n de nivel competitivo y la capacidad de respuesta m\u00e1s consistente jam\u00e1s vista. Aseg\u00farese de personalizar y ajustar la configuraci\u00f3n de DPI con Logitech G HUB.<br><br><h2>FORMA CL\u00c1SICA DE DEPORTES ELECTR\u00d3NICOS<\/h2>PRO se inspir\u00f3 en las l\u00edneas cl\u00e1sicas y la construcci\u00f3n simple de los chasis Logitech G100 y G100s que se hicieron famosos por los mejores profesionales competitivos de los deportes electr\u00f3nicos. La consistencia y la comodidad son fundamentales para rendir al m\u00e1ximo. El rat\u00f3n PRO ofrece ambas cosas.<br><br><h2>SISTEMA MEC\u00c1NICO DE TENSI\u00d3N DE BOTONES.<\/h2>El sistema mec\u00e1nico de tensi\u00f3n de botones del mouse para juegos Logitech G PRO mejora la consistencia de los botones izquierdo\/derecho del mouse y ayuda a reducir la fuerza necesaria para hacer clic. Esto da como resultado un rendimiento de clics n\u00edtido y confiable en el que puede confiar al m\u00e1s alto nivel de competencia.<br><br><h2>6 BOTONES PROGRAMABLES<\/h2>El mouse para juegos Logitech G PRO se puede usar de inmediato con configuraciones de botones preestablecidas o se puede configurar completamente seg\u00fan sus preferencias personalizadas usando G HUB. Los seis botones se pueden vincular para activar comandos del juego y m\u00e1s.<br><br><h2>SINCRONIZACI\u00d3N DE LUCES RGB<\/h2>PRO Mouse viene completo con ~16,8 millones de personalizaci\u00f3n de colores, perfecta para representar los colores de su equipo, personalizar su configuraci\u00f3n o sincronizar con otros productos G. LIGHTSYNC tambi\u00e9n presenta efectos de iluminaci\u00f3n basados &#8203;&#8203;en el juego que responden a la acci\u00f3n del juego, visualizaci\u00f3n de audio, muestreo de color de la pantalla y m\u00e1s. Progr\u00e1malo todo con G HUB.<br><br><h2>5 PERFILES DE MEMORIA INTEGRADA<\/h2>Con m\u00faltiples perfiles de memoria programables, los profesionales pueden guardar una variedad de preferencias directamente en PRO usando G HUB. Evite instalar software personalizado o reconfigurar sus ajustes en los sistemas de la competencia. Ve directamente al juego.<br><br><h2>RENDIMIENTO DURADERO<\/h2>Basado en m\u00e1s de 30 a\u00f1os de experiencia de Logitech en ingenier\u00eda, construcci\u00f3n y pruebas de ratones, PRO est\u00e1 dise\u00f1ado para resistir tanto el riguroso entrenamiento profesional como la temporada de torneos. La superficie de PRO est\u00e1 recubierta para mayor durabilidad y agarre. Mientras que los pies se prueban para funcionar durante m\u00e1s de 250 km de uso.<br><br><ul>  <li><b>DIMENSIONES<\/b><\/li>  <li>Altura : 116,6 mm<\/li>  <li>Ancho : 62,15 mm<\/li>  <li>Profundidad : 38,2 mm<\/li>  <li>Peso : 85 g, solo rat\u00f3n<\/li>  <li>Longitud del cable : 2,1 m<\/li>  <li><b>ESPECIFICACIONES T\u00c9CNICAS<\/b><\/li>  <li>SEGUIMIENTO<\/li>  <li>Sensor : H\u00c9ROE 25K<\/li>  <li>Resoluci\u00f3n : 100 &#8211; 25.600 ppp<\/li>  <li>Suavizado\/aceleraci\u00f3n\/filtrado cero<\/li>  <li>M\u00e1x. aceleraci\u00f3n : &gt;40G 1Probado en la alfombrilla de rat\u00f3n para juegos Logitech G240<\/li>  <li>M\u00e1x. Velocidad : &gt;400 IPS 2Probado en la alfombrilla de rat\u00f3n para juegos Logitech G240<\/li>  <li><b>SENSIBILIDAD<\/b><\/li>  <li>Formato de datos USB : 16 bits\/eje<\/li>  <li>Velocidad de informe USB : 1000 Hz (1 ms)<\/li>  <li>Microprocesador : ARM de 32 bits<\/li>  <li><b>DURABILIDAD<\/b><\/li>  <li>Pies de PTFE : alcance de 250 km. 3Probado en la alfombrilla de rat\u00f3n para juegos Logitech G240<\/li>  <li><b>OTRAS CARACTER\u00cdSTICAS<\/b><\/li>  <li>Memoria integrada : 5 perfiles<\/li>  <li>LIGHTSYNC RGB : 1 zona<\/li>  <li>Sistema mec\u00e1nico de tensi\u00f3n de botones.<\/li>  <li><b>COMPATIBILIDAD<\/b><\/li>  <li>Windows 7 o posterior<\/li>  <li>MacOS 10.11 o posterior<\/li>  <li>ChromeOS<\/li>  <li>Puerto USB<\/li>  <li>Acceso a Internet para Logitech G HUB (opcional)<\/li>  <li><b>EN LA CAJA<\/b><\/li>  <li>Rat\u00f3n<\/li>  <li>Documentaci\u00f3n del usuario<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_log-mou%20g%20pro%20hero%20bk_1.jpg","wholesale_price":"29.45","unit_price_tax":34.45},"product_model":{"product_data":{"ean13":["5099206079724"],"reference":"910-005440","name":{"1":"Rat\u00f3n Gaming Logitech G Pro Hero\/ Hasta 25600 DPI\/ Negro","2":"","3":"","4":""},"description":{"1":"<p><h2>UN PROPOSITO<\/h2>En los deportes electr\u00f3nicos, ganar no se mide en metros o segundos, sino en micr\u00f3metros y milisegundos. Cuando hay mucho en juego, un solo movimiento y clic puede marcar la diferencia entre volver a casa con 5.000 d\u00f3lares o 500.000 d\u00f3lares. Por eso Logitech G cre\u00f3 PRO. Mejorado con HERO, nuestro sensor de juegos m\u00e1s avanzado, para brindar la incre\u00edble velocidad y precisi\u00f3n necesarias para ganar.<br><br><h2>SENSOR H\u00c9ROE 25K<\/h2>HERO 25K es nuestro sensor de juegos m\u00e1s preciso hasta la fecha con precisi\u00f3n de pr\u00f3xima generaci\u00f3n y una arquitectura innovadora. HERO 25K es capaz de ofrecer m\u00e1s de 400 IPS, 100 - 25 600 DPI y cero suavizado, filtrado o aceleraci\u00f3n en todo el rango de DPI. HERO 25K logra una precisi\u00f3n de nivel competitivo y la capacidad de respuesta m\u00e1s consistente jam\u00e1s vista. Aseg\u00farese de personalizar y ajustar la configuraci\u00f3n de DPI con Logitech G HUB.<br><br><h2>FORMA CL\u00c1SICA DE DEPORTES ELECTR\u00d3NICOS<\/h2>PRO se inspir\u00f3 en las l\u00edneas cl\u00e1sicas y la construcci\u00f3n simple de los chasis Logitech G100 y G100s que se hicieron famosos por los mejores profesionales competitivos de los deportes electr\u00f3nicos. La consistencia y la comodidad son fundamentales para rendir al m\u00e1ximo. El rat\u00f3n PRO ofrece ambas cosas.<br><br><h2>SISTEMA MEC\u00c1NICO DE TENSI\u00d3N DE BOTONES.<\/h2>El sistema mec\u00e1nico de tensi\u00f3n de botones del mouse para juegos Logitech G PRO mejora la consistencia de los botones izquierdo\/derecho del mouse y ayuda a reducir la fuerza necesaria para hacer clic. Esto da como resultado un rendimiento de clics n\u00edtido y confiable en el que puede confiar al m\u00e1s alto nivel de competencia.<br><br><h2>6 BOTONES PROGRAMABLES<\/h2>El mouse para juegos Logitech G PRO se puede usar de inmediato con configuraciones de botones preestablecidas o se puede configurar completamente seg\u00fan sus preferencias personalizadas usando G HUB. Los seis botones se pueden vincular para activar comandos del juego y m\u00e1s.<br><br><h2>SINCRONIZACI\u00d3N DE LUCES RGB<\/h2>PRO Mouse viene completo con ~16,8 millones de personalizaci\u00f3n de colores, perfecta para representar los colores de su equipo, personalizar su configuraci\u00f3n o sincronizar con otros productos G. LIGHTSYNC tambi\u00e9n presenta efectos de iluminaci\u00f3n basados &#8203;&#8203;en el juego que responden a la acci\u00f3n del juego, visualizaci\u00f3n de audio, muestreo de color de la pantalla y m\u00e1s. Progr\u00e1malo todo con G HUB.<br><br><h2>5 PERFILES DE MEMORIA INTEGRADA<\/h2>Con m\u00faltiples perfiles de memoria programables, los profesionales pueden guardar una variedad de preferencias directamente en PRO usando G HUB. Evite instalar software personalizado o reconfigurar sus ajustes en los sistemas de la competencia. Ve directamente al juego.<br><br><h2>RENDIMIENTO DURADERO<\/h2>Basado en m\u00e1s de 30 a\u00f1os de experiencia de Logitech en ingenier\u00eda, construcci\u00f3n y pruebas de ratones, PRO est\u00e1 dise\u00f1ado para resistir tanto el riguroso entrenamiento profesional como la temporada de torneos. La superficie de PRO est\u00e1 recubierta para mayor durabilidad y agarre. Mientras que los pies se prueban para funcionar durante m\u00e1s de 250 km de uso.<br><br><ul>  <li><b>DIMENSIONES<\/b><\/li>  <li>Altura : 116,6 mm<\/li>  <li>Ancho : 62,15 mm<\/li>  <li>Profundidad : 38,2 mm<\/li>  <li>Peso : 85 g, solo rat\u00f3n<\/li>  <li>Longitud del cable : 2,1 m<\/li>  <li><b>ESPECIFICACIONES T\u00c9CNICAS<\/b><\/li>  <li>SEGUIMIENTO<\/li>  <li>Sensor : H\u00c9ROE 25K<\/li>  <li>Resoluci\u00f3n : 100 &#8211; 25.600 ppp<\/li>  <li>Suavizado\/aceleraci\u00f3n\/filtrado cero<\/li>  <li>M\u00e1x. aceleraci\u00f3n : &gt;40G 1Probado en la alfombrilla de rat\u00f3n para juegos Logitech G240<\/li>  <li>M\u00e1x. Velocidad : &gt;400 IPS 2Probado en la alfombrilla de rat\u00f3n para juegos Logitech G240<\/li>  <li><b>SENSIBILIDAD<\/b><\/li>  <li>Formato de datos USB : 16 bits\/eje<\/li>  <li>Velocidad de informe USB : 1000 Hz (1 ms)<\/li>  <li>Microprocesador : ARM de 32 bits<\/li>  <li><b>DURABILIDAD<\/b><\/li>  <li>Pies de PTFE : alcance de 250 km. 3Probado en la alfombrilla de rat\u00f3n para juegos Logitech G240<\/li>  <li><b>OTRAS CARACTER\u00cdSTICAS<\/b><\/li>  <li>Memoria integrada : 5 perfiles<\/li>  <li>LIGHTSYNC RGB : 1 zona<\/li>  <li>Sistema mec\u00e1nico de tensi\u00f3n de botones.<\/li>  <li><b>COMPATIBILIDAD<\/b><\/li>  <li>Windows 7 o posterior<\/li>  <li>MacOS 10.11 o posterior<\/li>  <li>ChromeOS<\/li>  <li>Puerto USB<\/li>  <li>Acceso a Internet para Logitech G HUB (opcional)<\/li>  <li><b>EN LA CAJA<\/b><\/li>  <li>Rat\u00f3n<\/li>  <li>Documentaci\u00f3n del usuario<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LOGITECH","supplier":null,"width":null,"height":null,"depth":null,"weight":0.18,"unit_price":34.45,"unit_price_tax":34.45,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ratones","quantity":0,"brand":"LOGITECH","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_log-mou%20g%20pro%20hero%20bk_1.jpg"],"wholesale_price":29.45}}},"8435693105077":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693105077",false],"wholesale_price":[55.96,false],"price":[60.96,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:167839","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/18aa475ebad0e4515119804a26431071.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Sistema de Refrigeraci\u00f3n L\u00edquida Mars Gaming ML-LCD240\/ Negro","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ventiladores","unit_price":60.96,"reference":"MLLCD240","ean13":"8435693105077","weight":"0","quantity":0,"brand":"MARS GAMING","description_pt":"<p><h2>REFRIGERACI\u00d3N L\u00cdQUIDA ML-LCD240<\/h2>El sistema de refrigeraci\u00f3n l\u00edquida AIO ML-LCD240 combina eficiencia y estilo. Equipado con dos ventiladores FDB de 120 mm con iluminaci\u00f3n ARGB, ofrece una disipaci\u00f3n de calor superior, manteniendo la CPU fresca incluso bajo cargas intensas. Incorpora la tecnolog\u00eda Opti-chamber 3rd Gen y un radiador de baja resistencia para un rendimiento \u00f3ptimo y hasta 500W TDP, tubos de tefl\u00f3n extralargos y compatibilidad universal multisocket. Su pantalla LCD ARGB en la bomba permite monitorear la temperatura del l\u00edquido refrigerante en tiempo real.<br><br><h2>ILUMINACI\u00d3N ARGB<\/h2>Con sus dos ventiladores ARGB de 120mm y la pantalla LCD con iluminaci\u00f3n ARGB integrada en la bomba asegura no solo un rendimiento y enfriamiento excepcional, sino tambi\u00e9n una integraci\u00f3n visual deslumbrante en tu setup.<br><br><h2>OPTI-CHAMBER 3RD GEN, FDB TDP 500W<\/h2>Disfruta de un rendimiento extremo. Hasta 500W TDP sin restricciones gracias a las m\u00e1s novedosas tecnolog\u00edas de refrigeraci\u00f3n l\u00edquida:<br><ul>  <li>Tecnolog\u00eda OPTI-CHAMBER de tercera generaci\u00f3n que permite extraer el calor de una forma extremadamente r\u00e1pida.<\/li>  <li>Radiador profesional ultra eficiente de baja resistencia, con un mejor rendimiento y un menor ruido de funcionamiento.<\/li>  <li>2x ventiladores ARGB de 120mm silenciosos con rodamiento FDB, con una duraci\u00f3n y estabilidad m\u00e1ximas.<\/li><\/ul><br><h2>DISPLAY LCD ARGB DE TEMPERATURA<\/h2>Con una innovadora pantalla LCD con iluminaci\u00f3n ARGB integrada en la bomba, la ML-LCD240 te permite monitorear la temperatura del l\u00edquido refrigerante en tiempo real, clave para una gesti\u00f3n t\u00e9rmica avanzada de tu sistema, ayud\u00e1ndote as\u00ed a prevenir el sobrecalentamiento y garantizar un rendimiento \u00f3ptimo de tus componentes.<br><br><h2>COMPATIBILIDAD TOTAL ARGB<\/h2>La refrigeraci\u00f3n l\u00edquida AIO ML-LCD240 es compatible con sistemas como Asus Aura Sync, Mystic Light Sync y RGB Fusion, permiti\u00e9ndote un absoluto control de la iluminaci\u00f3n a trav\u00e9s del conector 5V ARGB de 3 pines incluido. Con su iluminaci\u00f3n ARGB personalizable, no solo mantendr\u00e1s tus temperaturas bajo control, sino que tambi\u00e9n podr\u00e1s crear un espect\u00e1culo visual impresionante dentro de tu torre.<br><br><h2>TUBOS DE TEFL\u00d3N EXTRALARGOS<\/h2>Con tubos recubiertos con tefl\u00f3n de alta calidad, proporciona una durabilidad excepcional. Su longitud extendida facilita la instalaci\u00f3n en diferentes configuraciones, asegurando una compatibilidad vers\u00e1til con todo tipo de cajas de ordenador.<br><br><h2>MULTISOCKET UNIVERSAL<\/h2>La ML-LCD240 es compatible cuenta con una amplia compatibilidad que te permite utilizarlo con gran cantidad de placas base, ofreci\u00e9ndote soporte para INTEL LGA 2066\/2011\/1700\/1200\/1156\/1155\/1151\/1150 y AMD AM5\/AM4\/AM3+\/AM3\/AM2+\/AM2\/FM2\/FM1.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Peso<\/li>  <li>995g<\/li>  <li>TDP<\/li>  <li>500W<\/li>  <li>Longitud \/ Material Tubos<\/li>  <li>370mm \/ Teflon<\/li>  <li>Dimensiones \/ Material Radiador<\/li>  <li>277x120x27mm \/ Aluminio<\/li>  <li>Socket<\/li>  <li>INTEL LGA 2066\/2011\/1700\/1200\/1156\/1155\/1151\/1150 y AMD AM5\/AM4\/AM3+\/AM3\/AM2+\/AM2\/FM2\/FM1<\/li>  <li>Conectores iluminaci\u00f3n<\/li>  <li>Addressable RGB +5V 3 pin + VDG 3 pin<\/li>  <li>Dimensiones<\/li>  <li>68x68x49.5mm<\/li>  <li>Velocidad<\/li>  <li>3000 RPM\u00b110%<\/li>  <li>Material del bloque<\/li>  <li>Cobre<\/li>  <li>Nivel sonoro<\/li>  <li>15 dBA<\/li>  <li>Conector<\/li>  <li>3 pin<\/li>  <li>Voltaje \/ Corriente<\/li>  <li>12V DC \/ 0.25A<\/li>  <li>Dimensiones<\/li>  <li>120x120x25mm<\/li>  <li>Velocidad<\/li>  <li>800-2000 \u00b1 10% RPM<\/li>  <li>Nivel sonoro<\/li>  <li>9-26 dBA<\/li>  <li>Flujo de aire<\/li>  <li>27.2-69.2 CFM<\/li>  <li>Rodamientos<\/li>  <li>Hidr\u00e1ulico<\/li>  <li>Conector<\/li>  <li>PWM 4 pin<\/li>  <li>Voltaje \/ Corriente ventilador<\/li>  <li>12V DC \/ 0.15A<\/li>  <li>Voltaje \/ Corriente ARGB<\/li>  <li>5V DC \/ 0.25A<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-ref%20ml-lcd240%20bk_1.jpg","wholesale_price":"55.96","unit_price_tax":60.96},"product_model":{"product_data":{"ean13":["8435693105077"],"reference":"MLLCD240","name":{"1":"Sistema de Refrigeraci\u00f3n L\u00edquida Mars Gaming ML-LCD240\/ Negro","2":"","3":"","4":""},"description":{"1":"<p><h2>REFRIGERACI\u00d3N L\u00cdQUIDA ML-LCD240<\/h2>El sistema de refrigeraci\u00f3n l\u00edquida AIO ML-LCD240 combina eficiencia y estilo. Equipado con dos ventiladores FDB de 120 mm con iluminaci\u00f3n ARGB, ofrece una disipaci\u00f3n de calor superior, manteniendo la CPU fresca incluso bajo cargas intensas. Incorpora la tecnolog\u00eda Opti-chamber 3rd Gen y un radiador de baja resistencia para un rendimiento \u00f3ptimo y hasta 500W TDP, tubos de tefl\u00f3n extralargos y compatibilidad universal multisocket. Su pantalla LCD ARGB en la bomba permite monitorear la temperatura del l\u00edquido refrigerante en tiempo real.<br><br><h2>ILUMINACI\u00d3N ARGB<\/h2>Con sus dos ventiladores ARGB de 120mm y la pantalla LCD con iluminaci\u00f3n ARGB integrada en la bomba asegura no solo un rendimiento y enfriamiento excepcional, sino tambi\u00e9n una integraci\u00f3n visual deslumbrante en tu setup.<br><br><h2>OPTI-CHAMBER 3RD GEN, FDB TDP 500W<\/h2>Disfruta de un rendimiento extremo. Hasta 500W TDP sin restricciones gracias a las m\u00e1s novedosas tecnolog\u00edas de refrigeraci\u00f3n l\u00edquida:<br><ul>  <li>Tecnolog\u00eda OPTI-CHAMBER de tercera generaci\u00f3n que permite extraer el calor de una forma extremadamente r\u00e1pida.<\/li>  <li>Radiador profesional ultra eficiente de baja resistencia, con un mejor rendimiento y un menor ruido de funcionamiento.<\/li>  <li>2x ventiladores ARGB de 120mm silenciosos con rodamiento FDB, con una duraci\u00f3n y estabilidad m\u00e1ximas.<\/li><\/ul><br><h2>DISPLAY LCD ARGB DE TEMPERATURA<\/h2>Con una innovadora pantalla LCD con iluminaci\u00f3n ARGB integrada en la bomba, la ML-LCD240 te permite monitorear la temperatura del l\u00edquido refrigerante en tiempo real, clave para una gesti\u00f3n t\u00e9rmica avanzada de tu sistema, ayud\u00e1ndote as\u00ed a prevenir el sobrecalentamiento y garantizar un rendimiento \u00f3ptimo de tus componentes.<br><br><h2>COMPATIBILIDAD TOTAL ARGB<\/h2>La refrigeraci\u00f3n l\u00edquida AIO ML-LCD240 es compatible con sistemas como Asus Aura Sync, Mystic Light Sync y RGB Fusion, permiti\u00e9ndote un absoluto control de la iluminaci\u00f3n a trav\u00e9s del conector 5V ARGB de 3 pines incluido. Con su iluminaci\u00f3n ARGB personalizable, no solo mantendr\u00e1s tus temperaturas bajo control, sino que tambi\u00e9n podr\u00e1s crear un espect\u00e1culo visual impresionante dentro de tu torre.<br><br><h2>TUBOS DE TEFL\u00d3N EXTRALARGOS<\/h2>Con tubos recubiertos con tefl\u00f3n de alta calidad, proporciona una durabilidad excepcional. Su longitud extendida facilita la instalaci\u00f3n en diferentes configuraciones, asegurando una compatibilidad vers\u00e1til con todo tipo de cajas de ordenador.<br><br><h2>MULTISOCKET UNIVERSAL<\/h2>La ML-LCD240 es compatible cuenta con una amplia compatibilidad que te permite utilizarlo con gran cantidad de placas base, ofreci\u00e9ndote soporte para INTEL LGA 2066\/2011\/1700\/1200\/1156\/1155\/1151\/1150 y AMD AM5\/AM4\/AM3+\/AM3\/AM2+\/AM2\/FM2\/FM1.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Peso<\/li>  <li>995g<\/li>  <li>TDP<\/li>  <li>500W<\/li>  <li>Longitud \/ Material Tubos<\/li>  <li>370mm \/ Teflon<\/li>  <li>Dimensiones \/ Material Radiador<\/li>  <li>277x120x27mm \/ Aluminio<\/li>  <li>Socket<\/li>  <li>INTEL LGA 2066\/2011\/1700\/1200\/1156\/1155\/1151\/1150 y AMD AM5\/AM4\/AM3+\/AM3\/AM2+\/AM2\/FM2\/FM1<\/li>  <li>Conectores iluminaci\u00f3n<\/li>  <li>Addressable RGB +5V 3 pin + VDG 3 pin<\/li>  <li>Dimensiones<\/li>  <li>68x68x49.5mm<\/li>  <li>Velocidad<\/li>  <li>3000 RPM\u00b110%<\/li>  <li>Material del bloque<\/li>  <li>Cobre<\/li>  <li>Nivel sonoro<\/li>  <li>15 dBA<\/li>  <li>Conector<\/li>  <li>3 pin<\/li>  <li>Voltaje \/ Corriente<\/li>  <li>12V DC \/ 0.25A<\/li>  <li>Dimensiones<\/li>  <li>120x120x25mm<\/li>  <li>Velocidad<\/li>  <li>800-2000 \u00b1 10% RPM<\/li>  <li>Nivel sonoro<\/li>  <li>9-26 dBA<\/li>  <li>Flujo de aire<\/li>  <li>27.2-69.2 CFM<\/li>  <li>Rodamientos<\/li>  <li>Hidr\u00e1ulico<\/li>  <li>Conector<\/li>  <li>PWM 4 pin<\/li>  <li>Voltaje \/ Corriente ventilador<\/li>  <li>12V DC \/ 0.15A<\/li>  <li>Voltaje \/ Corriente ARGB<\/li>  <li>5V DC \/ 0.25A<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibil