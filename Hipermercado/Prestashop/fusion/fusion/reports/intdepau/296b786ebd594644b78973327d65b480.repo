t_price_tax":246.94,"tax_rules_group":null,"category":"Television","sub_category":"Televisor hasta 43 pulgadas","quantity":0,"brand":"HISENSE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_his-tv%2043e78hq_1.jpg"],"wholesale_price":241.94}}},"6942147480441":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6942147480441",false],"wholesale_price":[430.11,false],"price":[435.11,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Hisense QLED 65E78HQ 65&#39; TV\/ Ultra HD 4K\/ Smart TV\/ WiFi"],"result":false},"feed_data":{"name_pt":"Televisor Hisense QLED 65E78HQ 65'\/ Ultra HD 4K\/ Smart TV\/ WiFi","category":"Television","sub_category":"Televisor hasta 65 pulgadas","unit_price":435.11,"reference":"65E78HQ","ean13":"6942147480441","weight":"0","quantity":0,"brand":"HISENSE","description_pt":"                                                    ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_his-tv%2065e78hq_1.jpg","wholesale_price":"430.11","unit_price_tax":435.11},"product_model":{"product_data":{"ean13":["6942147480441"],"reference":"65E78HQ","name":{"1":"Televisor Hisense QLED 65E78HQ 65'\/ Ultra HD 4K\/ Smart TV\/ WiFi","2":"","3":"","4":""},"description":{"1":"                                                    ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HISENSE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":435.11,"unit_price_tax":435.11,"tax_rules_group":null,"category":"Television","sub_category":"Televisor hasta 65 pulgadas","quantity":0,"brand":"HISENSE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_his-tv%2065e78hq_1.jpg"],"wholesale_price":430.11}}},"8718863037225":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8718863037225",false],"wholesale_price":[395.3,false],"price":[400.3,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Philips TV 43PUS8118 43&#39;\/ Ultra HD 4K\/ Ambilight\/ Smart TV\/ WiFi"],"result":false},"feed_data":{"name_pt":"Televisor Philips 43PUS8118 43'\/ Ultra HD 4K\/ Ambilight\/ Smart TV\/ WiFi","category":"Television","sub_category":"Televisor hasta 43 pulgadas","unit_price":400.3,"reference":"43PUS8118\/12","ean13":"8718863037225","weight":"11.1","quantity":5,"brand":"PHILIPS","description_pt":"<p><h2>El televisor que cumplir\u00e1 todos tus deseos.<\/h2><p>\u00bfQuieres ver la serie del momento? \u00a1Solo pregunta! Este televisor tiene incorporado Alexa, por lo que solo tienes que decir lo que quieres ver y encontrar un lugar c\u00f3modo para sentarte mientras Ambilight te lleva al interior de la escena. Y con im\u00e1genes n\u00edtidas y un sonido Dolby Atmos realista, la inmersi\u00f3n es completa<\/p><h2>Televisor Ambilight 4K<\/h2><div><p><ul><li>Televisor Ambilight de 108 cm (43')<\/li><li>Admite los principales formatos HDR<\/li><li>Sonido Dolby Atmos<\/li><li>Televisores inteligentes Philips<\/li><\/ul><\/p><h2>Ambilight TV: d\u00e9jate rodear por lo que amas.<\/h2><p>Los televisores Ambilight son los \u00fanicos televisores con luces LED detr\u00e1s de la pantalla que reaccionan a lo que ves, ba\u00f1\u00e1ndote en un aura de luz de colores. Una verdadera innovaci\u00f3n: su televisor parece mucho m\u00e1s grande, lo que le permite sumergirse en sus programas, pel\u00edculas y juegos favoritos.<\/p><h2><span style='background-color: initial;'>Audio e im\u00e1genes como en el cine. Dolby Vision y Dolby Atmos.<\/span><\/h2><p>Con Dolby Vision y Dolby Atmos, la experiencia de visualizaci\u00f3n de sus pel\u00edculas, programas y juegos ser\u00e1 extraordinaria y con un sonido incre\u00edble. Podr\u00e1s disfrutar de im\u00e1genes s\u00faper detalladas y escuchar cada palabra con claridad. Experimente los efectos de sonido, como si la acci\u00f3n realmente sucediera a su alrededor.<\/p><h2>Im\u00e1genes ultra n\u00edtidas. Experiencia visual excepcional.<\/h2><p>Independientemente de lo que est\u00e9 viendo, este televisor LED 4K Ambilight le brindar\u00e1 una imagen brillante y ultran\u00edtida con colores intensos. Es compatible con todos los principales formatos HDR, para obtener im\u00e1genes m\u00e1s detalladas al mirar contenido HDR, incluso en \u00e1reas claras y oscuras.<\/p><h2>Gran televisor. No hay problemas. Televisores inteligentes Philips.<\/h2><p>Gracias a nuestra nueva smart TV encontrar\u00e1s todo lo que buscas en poco tiempo. \u00bfTe gusta una serie? Puede continuar vi\u00e9ndolo directamente desde la pantalla de inicio. Si est\u00e1 buscando algo nuevo, puede explorar categor\u00edas, como acci\u00f3n o drama, y &#8203;&#8203;ver recomendaciones de los principales servicios de transmisi\u00f3n, todo en un solo lugar.<\/p><h2>Control de voz. Compatible con el Asistente de Google* y Alexa<\/h2><p>\u00a1Habla con tu asistente de voz de confianza! Simplemente presione un bot\u00f3n en el control remoto para hablar con Alexa, integrado en el televisor. Si est\u00e1s viendo algo, el volumen baja autom\u00e1ticamente para que el micr\u00f3fono incorporado entienda lo que est\u00e1s diciendo. O, si lo prefieres, puedes controlar tu televisor a trav\u00e9s de los altavoces inteligentes de Google.<\/p><h2>Televisor delgado. Listo para el futuro.<\/h2><p>La pantalla pr\u00e1cticamente sin marco de este televisor Ambilight complementa cualquier decoraci\u00f3n, y el soporte gris oscuro delgado tiene la altura perfecta para una barra de sonido. Nuestro empaque est\u00e1 hecho de cart\u00f3n reciclado certificado FSC y nuestros materiales impresos est\u00e1n hechos de papel reciclado.<\/p><h2>Ideal para jugar. VVR y retraso m\u00ednimo en cualquier consola.<\/h2><p>Con HDMI 2.1 puede aprovechar al m\u00e1ximo su consola, con una acci\u00f3n de juego r\u00e1pida y gr\u00e1ficos fluidos. El televisor es compatible con VRR y tiene una configuraci\u00f3n de baja latencia que se activa autom\u00e1ticamente cuando enciende la consola. Descubre el modo de juego Ambilight y amplifica cada emoci\u00f3n.<\/p><br><\/div><div><h2>Especificaciones t\u00e9cnicas<\/h2><p><ul><li><span style='background-color: initial;'><b>Caracter\u00edsticas de Ambilight<\/b><\/span><\/li><li>Adaptable al color de la pared<\/li><li>Modo lounge<\/li><li>Modo de juego<\/li><li>M\u00fasica Ambilight<\/li><li>AmbiSleep<\/li><li>Ambilight incorporado<\/li><li>versi\u00f3n Ambilight<\/li><li>3 lados<\/li><li><b>Imagen\/Pantalla<\/b><\/li><li>Tama\u00f1o de pantalla diagonal (m\u00e9trico)<\/li><li>108cm<\/li><li>Pantalla<\/li><li>LED de resoluci\u00f3n Ultra HD 4K<\/li><li>Mejora de la imagen<\/li><li>HDR10<\/li><li>HLG (Hybrid Log Gamma)<\/li><li>Compatible con HDR10+<\/li><li>Visi\u00f3n Dolby<\/li><li><b>Resoluci\u00f3n de pantalla<\/b><\/li><li>3840x2160<\/li><li>Frecuencia de actualizaci\u00f3n nativa<\/li><li>60Hz<\/li><li>Motor de imagen<\/li><li>P\u00edxel preciso Ultra HD<\/li><li><b>Resoluci\u00f3n de pantalla<\/b><\/li><li>Frecuencia de actualizaci\u00f3n de la resoluci\u00f3n<\/li><li>576p-50Hz<\/li><li>640x480-60Hz<\/li><li>720p-50 Hz, 60 Hz<\/li><li>1920x1080p-24 Hz, 25 Hz, 30 Hz<\/li><li>50 Hz, 60 Hz<\/li><li>2560x1440-60Hz<\/li><li>3840x2160p-24 Hz, 25 Hz, 30 Hz<\/li><li>, 50 Hz, 60 Hz<\/li><li><b>Sintonizador\/Recepci\u00f3n\/Transmisi\u00f3n<\/b><\/li><li>Televisi\u00f3n digital<\/li><li>DVB-T\