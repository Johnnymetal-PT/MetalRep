"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"WOXTER","supplier":null,"width":null,"height":null,"depth":null,"weight":3.6,"unit_price":132.88,"unit_price_tax":132.88,"tax_rules_group":null,"category":"Altavoces","sub_category":"Barras de sonido","quantity":5,"brand":"WOXTER","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wox-alt%20sbar%20500%20bk_1.jpg"],"wholesale_price":127.88}}},"8435256897395":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435256897395",false],"wholesale_price":[33.64,false],"price":[38.64,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:194224","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0c20b4e043b9f42ac0ecc76c28fde134.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Inal\u00e1mbricos Deportivos de Conducci\u00f3n \u00d3sea Aiwa ESTBTN-880\/ con Micr\u00f3fono\/ Bluetooth\/ Negros","category":"Auriculares","sub_category":"Auriculares","unit_price":38.64,"reference":"ESTBTN-880","ean13":"8435256897395","weight":"0","quantity":0,"brand":"AIWA","description_pt":"                                                <h2>Aiwa ESTBTN-880<\/h2><div><h2>CORREA INAL\u00c1MBRICA PARA AURICULARES<\/h2><p>con ANC y almohadillas de espuma viscoel\u00e1stica<\/p><h2>HIPERBAJOS<\/h2><p>con carcasa met\u00e1lica para m\u00e1xima calidad de sonido<\/p><h2>IPX4 IMPERMEABLE Y A PRUEBA DE POLVO<\/h2><p>Banda para el cuello duradera de doble TPE con clip para cable y lujosos controles remotos de metal<\/p><br><\/div><div><h2>Especificaciones generales<\/h2><p><ul><li>Cancelaci\u00f3n activa de ruido (ANC) con supresi\u00f3n de ruido de 28 dB.<\/li><li>Compatibilidad Bluetooth 5.0 con conectividad r\u00e1pida y alcance inal\u00e1mbrico de 10 m.<\/li><li>Con activaci\u00f3n de asistente de voz (por ejemplo, Siri\/Asistente de Google).<\/li><li>IPX4 resistente al agua, al polvo y a los golpes.<\/li><li>Durable banda para el cuello con cable de doble TPE con clip para cable en el cuello y lujosos controles remotos de metal.<\/li><li>Dise\u00f1o intrauditivo ergon\u00f3mico, con almohadillas de silicona extra\u00edbles y esterilizables en tama\u00f1os S\/M\/L.<\/li><li>Almohadillas personalizadas en una gama completa de 5 pares intercambiables: silicona suave x 3 pares (S,M,L) + espuma viscoel\u00e1stica con aislamiento de sonido x 2 pares (M,L).<\/li><li>HYPERBASS con carcasa met\u00e1lica para m\u00e1xima calidad de sonido.<\/li><li>Controladores de altavoz din\u00e1micos extra grandes de 13,6 mm con respuesta de frecuencia de 20 Hz a 20 KHz.<\/li><li>Micr\u00f3fonos duales integrados para llamadas telef\u00f3nicas con manos libres y cancelaci\u00f3n activa de ruido.<\/li><li>Duraci\u00f3n de la bater\u00eda extralarga: aproximadamente 15 horas de reproducci\u00f3n\/conversaci\u00f3n, 300 horas de tiempo de espera.<\/li><li>Bater\u00eda de litio avanzada recargable de alta capacidad: 3,7 V\/250 mAh.<\/li><li>Tiempo de recarga ultrarr\u00e1pido de 1,5 horas.<\/li><li>Puerto de carga: Micro USB (cable de carga USB con cintur\u00f3n de cuero incluido).<\/li><li>Emparejamiento inal\u00e1mbrico autom\u00e1tico y reconexi\u00f3n con tel\u00e9fonos m\u00f3viles y tabletas.<\/li><li>Avisos de voz del sistema integrados para una operaci\u00f3n sencilla del usuario y una f\u00e1cil supervisi\u00f3n del estado del dispositivo.<\/li><li><b>Accesorios incluidos<\/b>: Cable USB trenzado de nailon con cintur\u00f3n de cuero y carcasa de aluminio, bolsa de transporte, 2 clips para cables en el cuello, 3 pares de almohadillas de silicona para los o\u00eddos, 2 pares de almohadillas para los o\u00eddos de espuma viscoel\u00e1stica.<\/li><li><b>Dimensiones<\/b><\/li><li>Peso: 32g.<\/li><li><b>\u00bfQu\u00e9 hay en la caja?<\/b><\/li><li>ESTBTN-880<\/li><li>Almohadillas de silicona (S, M, L)<\/li><li>Bolsa de transporte<\/li><li>Collar Clips para cables x2 piezas<\/li><li>Almohadillas de espuma viscoel\u00e1stica x 2 pares<\/li><li>Manual del usuario<\/li><li>Cable trenzado de nailon micro-usb con carcasa de aluminio.<\/li><\/ul><\/p><\/div>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aiw-aur%20estbtn-880%20bk_1.jpg","wholesale_price":"33.64","unit_price_tax":38.64},"product_model":{"product_data":{"ean13":["8435256897395"],"reference":"ESTBTN-880","name":{"1":"Auriculares Inal\u00e1mbricos Deportivos de Conducci\u00f3n \u00d3sea Aiwa ESTBTN-880\/ con Micr\u00f3fono\/ Bluetooth\/ Negros","2":"","3":"","4":""},"description":{"1":"                                                <h2>Aiwa ESTBTN-880<\/h2><div><h2>CORREA INAL\u00c1MBRICA PARA AURICULARES<\/h2><p>con ANC y almohadillas de espuma viscoel\u00e1stica<\/p><h2>HIPERBAJOS<\/h2><p>con carcasa met\u00e1lica para m\u00e1xima calidad de sonido<\/p><h2>IPX4 IMPERMEABLE Y A PRUEBA DE POLVO<\/h2><p>Banda para el cuello duradera de doble TPE con clip para cable y lujosos controles remotos de metal<\/p><br><\/div><div><h2>Especificaciones generales<\/h2><p><ul><li>Cancelaci\u00f3n activa de ruido (ANC) con supresi\u00f3n de ruido de 28 dB.<\/li><li>Compatibilidad Bluetooth 5.0 con conectividad r\u00e1pida y alcance inal\u00e1mbrico de 10 m.<\/li><li>Con activaci\u00f3n de asistente de voz (por ejemplo, Siri\/Asistente de Google).<\/li><li>IPX4 resistente al agua, al polvo y a los golpes.<\/li><li>Durable banda para el cuello con cable de doble TPE con clip para cable en el cuello y lujosos controles remotos de metal.<\/li><li>Dise\u00f1o intrauditivo ergon\u00f3mico, con almohadillas de silicona extra\u00edbles y esterilizables en tama\u00f1os S\/M\/L.<\/li><li>Almohadillas personalizadas en una gama completa de 5 pares intercambiables: silicona suave x 3 pares (S,M,L) + espuma viscoel\u00e1stica con aislamiento de sonido x 2 pares (M,L).<\/li><li>HYPERBASS con carcasa met\u00e1lica para m\u00e1xima calidad de sonido.<\/li><li>Controladores de altavoz din\u00e1micos extra grandes de 13,6 mm con respuesta de frecuencia de 20 Hz a 20 KHz.<\/li><li>Micr\u00f3fonos duales integrados para llamadas telef\u00f3nicas con manos libres y cancelaci\u00f3n activa de ruido.<\/li><li>Duraci\u00f3n de la bater\u00eda extralarga: aproximadamente 15 horas de reproducci\u00f3n\/conversaci\u00f3n, 300 horas de tiempo de espera.<\/li><li>Bater\u00eda de litio avanzada recargable de alta capacidad: 3,7 V\/250 mAh.<\/li><li>Tiempo de recarga ultrarr\u00e1pido de 1,5 horas.<\/li><li>Puerto de carga: Micro USB (cable de carga USB con cintur\u00f3n de cuero incluido).<\/li><li>Emparejamiento inal\u00e1mbrico autom\u00e1tico y reconexi\u00f3n con tel\u00e9fonos m\u00f3viles y tabletas.<\/li><li>Avisos de voz del sistema integrados para una operaci\u00f3n sencilla del usuario y una f\u00e1cil supervisi\u00f3n del estado del dispositivo.<\/li><li><b>Accesorios incluidos<\/b>: Cable USB trenzado de nailon con cintur\u00f3n de cuero y carcasa de aluminio, bolsa de transporte, 2 clips para cables en el cuello, 3 pares de almohadillas de silicona para los o\u00eddos, 2 pares de almohadillas para los o\u00eddos de espuma viscoel\u00e1stica.<\/li><li><b>Dimensiones<\/b><\/li><li>Peso: 32g.<\/li><li><b>\u00bfQu\u00e9 hay en la caja?<\/b><\/li><li>ESTBTN-880<\/li><li>Almohadillas de silicona (S, M, L)<\/li><li>Bolsa de transporte<\/li><li>Collar Clips para cables x2 piezas<\/li><li>Almohadillas de espuma viscoel\u00e1stica x 2 pares<\/li><li>Manual del usuario<\/li><li>Cable trenzado de nailon micro-usb con carcasa de aluminio.<\/li><\/ul><\/p><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AIWA","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":38.64,"unit_price_tax":38.64,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":0,"brand":"AIWA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aiw-aur%20estbtn-880%20bk_1.jpg"],"wholesale_price":33.64}}},"4892210137142":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4892210137142",false],"wholesale_price":[40.26,false],"price":[45.26,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:194226","Cat. IDs: 120","Associated Categories","Cat. Default: 120","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d112e3ef93d2cfa436d78ac89ca849d4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Amoladora Con Cable Ryobi RAG800-125G","category":"Bricolaje","sub_category":"Herramientas de Bricolaje","unit_price":45.26,"reference":"5133002491","ean13":"4892210137142","weight":"3","quantity":2,"brand":"RYOBI","description_pt":"<p>Cuando se aumenta el nivel de habilidad, \u00a1aqu\u00ed debemos buscar las herramientas adecuadas para dar siempre lo mejor! Con la amoladora angular RAG800-125G de Ryobi, podr\u00e1 realizar trabajos pesados &#8203;&#8203;y precisos sin dificultad; es una herramienta concebida con tecnolog\u00edas y componentes mec\u00e1nicos de alta calidad para garantizar la longevidad y la robustez; La l\u00ednea est\u00e1 confiada a un dise\u00f1o nuevo y moderno, que no renuncia a la practicidad y la comodidad. Adem\u00e1s, el RAG800-125G est\u00e1 equipado con:<br><br><ul>  <li><b>Caracter\u00edsticas<\/b><\/li>  <li>Potente y vers\u00e1til motor el\u00e9ctrico de 800 W.<\/li>  <li>Disco del diam. 125 incluidos<\/li>  <li>Cubierta protectora muy robusta con gancho de seguridad que le permite cambiar la posici\u00f3n del carter m\u00e1s r\u00e1pidamente<\/li>  <li>Nuevo sistema LLO para protecci\u00f3n contra arranques accidentales en caso de fallo de alimentaci\u00f3n.<\/li>  <li>Manija principal con controles de operaci\u00f3n pr\u00e1cticos, recubiertos de agarre suave para mayor comodidad y un agarre seguro<\/li>  <li>Asa extra ajustable en 2 posiciones para mejorar el uso incluso para operadores zurdos, con peque\u00f1o compartimento integrado para llaves<\/li>  <li>Bot\u00f3n de bloqueo del eje para cambiar r\u00e1pidamente el disco sin herramientas<\/li>  <li>Incluye llave de servicio<\/li>  <li><b>Especificaciones<\/b><\/li>  <li>Fuente de alimentaci\u00f3n: 230V <\/li>  <li>Motor: 800 W<\/li>  <li>Velocidad sin carga: 12000 rpm\/min&nbsp; <\/li>  <li>Rosca del husillo: M14<\/li>  <li>Di\u00e1metro del disco:&nbsp; 125 mm<\/li>  <li>Nivel de potencia de sonido:&nbsp; 97.5 dB<\/li>  <li>Nivel de presi\u00f3n sonora: 86.5 dB<\/li>  <li>Peso:&nbsp; 2,40 kg&nbsp;<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-amoladora%20rag800-125g_1.jpg","wholesale_price":"40.26","unit_price_tax":45.26},"product_model":{"product_data":{"ean13":["4892210137142"],"reference":"5133002491","name":{"1":"Amoladora Con Cable Ryobi RAG800-125G","2":"","3":"","4":""},"description":{"1":"<p>Cuando se aumenta el ni