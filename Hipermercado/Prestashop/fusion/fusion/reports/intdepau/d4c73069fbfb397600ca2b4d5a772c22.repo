s\/800\/800\/fixed\/art_sam-tv%20tq55q64dau_1.jpg"],"wholesale_price":632.24}}},"8806095413402":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806095413402",false],"wholesale_price":[790.49,false],"price":[795.49,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: TV Samsung QLED Q64D TQ65Q64DAU 65&#39;\/ Ultra HD 4K\/ Smart TV\/ WiFi"],"result":false},"feed_data":{"name_pt":"Televisor Samsung QLED Q64D TQ65Q64DAU 65'\/ Ultra HD 4K\/ Smart TV\/ WiFi","category":"Television","sub_category":"Televisor hasta 65 pulgadas","unit_price":795.49,"reference":"TQ65Q64DAUXXC","ean13":"8806095413402","weight":"28","quantity":5,"brand":"SAMSUNG","description_pt":"                                                <p><h2>TV QLED 65' Q64D 2024, 4K, Smart TV<\/h2><p><\/p><h2>Mil millones de tonos de color<\/h2><p>La tecnolog\u00eda Quantum Dot garantiza la mejor imagen que jam\u00e1s hayamos creado. Basado en Quantum Dots, reproduce perfectamente el 100% del volumen colorim\u00e9trico* para ofrecer colores ricos y vibrantes.<\/p><h2>Tu contenido favorito en 4K<\/h2><p>La mejora de 4K le brinda una experiencia visual 4K mejorada para todo su contenido.<\/p><h2>Smart TV Tizen<\/h2><p><strong>Mejora tu entretenimiento con Tizen<\/strong><\/p><p>Aprovecha al m\u00e1ximo tu televisor con los \u00faltimos servicios y aplicaciones en Tizen OS. Disfrute de canales de TV en vivo gratuitos y miles de pel\u00edculas con Samsung TV Plus, y transmita juegos en Gaming Hub. Incluso puede administrar sus actividades diarias con Daily+ y controlar sus dispositivos inteligentes desde su televisor con SmartThings, todo mientras mantiene su privacidad con Knox Security.<\/p><h2>Dise\u00f1o AirSlim<\/h2><p><strong>Dise\u00f1o incre\u00edblemente delgado<\/strong><\/p><p>Los televisores QLED presentan un dise\u00f1o elegante y minimalista desde todos los \u00e1ngulos. Sus bordes son tan finos que permanecer\u00e1s completamente inmerso en tu contenido. \u00a1Si\u00e9ntate y disfruta!<\/p><h2>HDR cu\u00e1ntico<\/h2><p>Un amplio abanico de contrastes dignos del cine<\/p><p>La tecnolog\u00eda Quantum HDR (High Dynamic Range) optimiza cada imagen y hace visible cada detalle independientemente del nivel de brillo.<\/p><p>Certificado PANTONE<\/p><p>Disfrute de colores precisos y naturales certificados por PANTONE para una experiencia realista.<\/p><h2>Centro SmartThings&#8482; integrado<\/h2><p><strong>Conecte sus dispositivos a su televisor<\/strong><\/p><p>Con SmartThings&#8482; Hub integrado en su televisor, puede conectar y controlar sin problemas dispositivos compatibles con Matter y HCA sin necesidad de un dispositivo adicional.<\/p><h2>Vista de mapa 3D<\/h2><p>Tu televisor como centro de control de tu hogar y tus dispositivos conectados<\/p><p>Administre mejor su hogar monitoreando y controlando intuitivamente sus electrodom\u00e9sticos y dispositivos conectados desde un mapa 3D de su hogar.<\/p><h2>Q-Sinfon\u00eda<\/h2><p><strong>En perfecta armon\u00eda<\/strong><\/p><p>La tecnolog\u00eda Q-Symphony sincroniza todos los altavoces del televisor con los altavoces de la barra de sonido Q-Series*. Funcionan simult\u00e1neamente para un mejor efecto de sonido envolvente.<\/p><h2>OTS Lite<\/h2><p><strong>Sonido inmersivo y realista<\/strong><\/p><p>Con la tecnolog\u00eda OTS, el sonido se mueve din\u00e1micamente siguiendo el movimiento de los objetos en la pantalla gracias a los altavoces<\/p><h2>Asegurado por Samsung Knox<\/h2><p><strong>Proteja su privacidad con Knox<\/strong><\/p><p>Bloquee sus datos, PIN o contrase\u00f1as con nuestra soluci\u00f3n de seguridad multinivel. Benef\u00edciate de actualizaciones peri\u00f3dicas que fortalecen tu televisor y lo protegen de posibles ataques.<\/p><h2>Modo ecol\u00f3gico con IA<\/h2><p><strong>Controla tu consumo energ\u00e9tico con SmartThings<\/strong><\/p><p>Gracias a la aplicaci\u00f3n SmartThings y al nuevo modo eco inteligente, ahora puedes controlar tu consumo energ\u00e9tico. La inteligencia artificial ajusta autom\u00e1ticamente el brillo del televisor seg\u00fan tu entorno para poder controlar su consumo.<\/p><h2>Especificaciones<\/h2><ul><li><strong>Tipo de producto<\/strong><\/li><li>QLED<\/li><li><strong>Pantalla<\/strong><\/li><li>Tama\u00f1o de pantalla<\/li><li>65'<\/li><li>Frecuencia de actualizaci\u00f3n<\/li><li>50Hz<\/li><li>Resoluci\u00f3n<\/li><li>4K (3840 x 2160)<\/li><li><strong>Video<\/strong><\/li><li>Procesador de v\u00eddeo<\/li><li>Procesador cu\u00e1ntico Lite 4K<\/li><li>HDR (alto rango din\u00e1mico)<\/li><li>HDR cu\u00e1ntico<\/li><li>HDR10+<\/li><li>S\u00ed (ADAPTABLE\/JUEGO)<\/li><li>IA de lujo<\/li><li>Mejora 4K<\/li><li>Contraste<\/li><li>LED doble<\/li><li>Micro Dimming<\/li><li>Atenuaci\u00f3n UHD definitiva<\/li><li>Inmersi\u00f3n<\/li><li>S\u00ed<\/li><li>Tecnolog\u00eda de movimiento<\/li><li>Xacelerador de movimiento<\/li><li>Calibraci\u00f3n inteligente<\/li><li>B\u00e1sico<\/li><li>Modo cineasta (FMM)<\/li><li>S\u00ed<\/li><li><strong>Audio<\/strong><\/li><li>Sonido adaptativo<\/li><li>Sonido adaptativo<\/li><li>Sonido de seguimiento de objetos<\/li><li>OTS Lite<\/li><li>Q-Sinfon\u00eda<\/li><li>S\u00ed<\/li><li>Descriptor de audio preestablecido<\/li><li>S\u00ed<\/li><li>Potencia de sonido (RMS)<\/li><li>20W<\/li><li>Tipo de altavoz<\/li><li>2 canales<\/li><li><strong>Servicios de televisi\u00f3n inteligente<\/strong><\/li><li>sistema de televisi\u00f3n inteligente<\/li><li>Televisor inteligente Tizen&#8482;<\/li><li>Bixby (asistente de voz integrado)<\/li><li>S\u00ed<\/li><li>Asistentes de voz integrados<\/li><li>Alexa (GB, DE, FR, IT, ES, AT, IE)<\/li><li>Televisor Samsung Plus<\/li><li>S\u00ed (GB, FR, DE, IT, ES, CH, AT, NL, SE, NO, DK, FI, PT, IE, BE, LU)<\/li><li>navegador web<\/li><li>S\u0