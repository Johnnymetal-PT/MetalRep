culos\/800\/800\/fixed\/art_var-pala%20pad%20lw%20cti%20dif%20bk_1.jpg"],"wholesale_price":58.83}}},"8401008201352":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8401008201352",false],"wholesale_price":[94.12,false],"price":[99.12,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:183296","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0a95363cdd889970927c3216a2dc2609.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Varlion LW Difusor\/ Negra","category":"PADEL","sub_category":"Padel","unit_price":99.12,"reference":"LW DIF BK","ean13":"8401008201352","weight":"0.3","quantity":2,"brand":"VARLION","description_pt":"<p>La VARLION LW DIFUSOR BLACK viene pisando fuerte con su dise\u00f1o y caracter\u00edsticas renovadas para sacar lo mejor en todas las situaciones de juego.<br><br><h2>TIPO DE JUGADOR<\/h2>Esta pala de Varlion la pueden llevar jugadores de todos los niveles, ya que cumple en todas las situaciones de juego por su buen manejo, control y aunque sea la gama Lethal Weapon sea la m\u00e1s conservadora, tambi\u00e9n responde muy bien a la hora de definir los puntos.<br><br><h2>CARACTER\u00cdSTICAS DE LA PALA<\/h2>La VARLION LW DIFUSOR BLACK destaca como ya hemos comentado, por la comodidad que desprende, sin duda en situaciones defensivas te ayuda mucho por el amplio punto dulce que tienen las caras, pero tambi\u00e9n en la volea es una pala con la capacidad de conseguir la iniciativa y dominar.<br><br>Es una pala con formato redondo con difusor, lo que nos va a ayudar a conseguir movimientos m\u00e1s veloces tanto para un bloqueo como una pegada r\u00e1pida.<br><br>En su fabricaci\u00f3n se emplea la fibra de carbono y su n\u00facleo esta construido con una goma Eva Hypersoft, consiguiendo un tacto suave.<br><br>El coraz\u00f3n de la pala esta protegido e impregnado por una resina VAR-FLEX dot\u00e1ndola de una mayor resistencia y estabilidad.<br><br><h2>ESTILO DE JUEGO<\/h2>En pista, este modelo es ideal para defender y lograr transiciones r\u00e1pidas para dominar con nuestro juego en la red.<br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_var-pala%20pad%20lw%20dif%20bk_1.jpg","wholesale_price":"94.12","unit_price_tax":99.12},"product_model":{"product_data":{"ean13":["8401008201352"],"reference":"LW DIF BK","name":{"1":"Pala de P\u00e1del Varlion LW Difusor\/ Negra","2":"","3":"","4":""},"description":{"1":"<p>La VARLION LW DIFUSOR BLACK viene pisando fuerte con su dise\u00f1o y caracter\u00edsticas renovadas para sacar lo mejor en todas las situaciones de juego.<br><br><h2>TIPO DE JUGADOR<\/h2>Esta pala de Varlion la pueden llevar jugadores de todos los niveles, ya que cumple en todas las situaciones de juego por su buen manejo, control y aunque sea la gama Lethal Weapon sea la m\u00e1s conservadora, tambi\u00e9n responde muy bien a la hora de definir los puntos.<br><br><h2>CARACTER\u00cdSTICAS DE LA PALA<\/h2>La VARLION LW DIFUSOR BLACK destaca como ya hemos comentado, por la comodidad que desprende, sin duda en situaciones defensivas te ayuda mucho por el amplio punto dulce que tienen las caras, pero tambi\u00e9n en la volea es una pala con la capacidad de conseguir la iniciativa y dominar.<br><br>Es una pala con formato redondo con difusor, lo que nos va a ayudar a conseguir movimientos m\u00e1s veloces tanto para un bloqueo como una pegada r\u00e1pida.<br><br>En su fabricaci\u00f3n se emplea la fibra de carbono y su n\u00facleo esta construido con una goma Eva Hypersoft, consiguiendo un tacto suave.<br><br>El coraz\u00f3n de la pala esta protegido e impregnado por una resina VAR-FLEX dot\u00e1ndola de una mayor resistencia y estabilidad.<br><br><h2>ESTILO DE JUEGO<\/h2>En pista, este modelo es ideal para defender y lograr transiciones r\u00e1pidas para dominar con nuestro juego en la red.<br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VARLION","supplier":null,"width":null,"height":null,"depth":null,"weight":0.3,"unit_price":99.12,"unit_price_tax":99.12,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":2,"brand":"VARLION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_var-pala%20pad%20lw%20dif%20bk_1.jpg"],"wholesale_price":94.12}}},"8401001245018":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8401001245018",false],"wholesale_price":[29,false],"price":[34,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.26",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:183297","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/06921e4e53c1ae79077fb70a46a2b647.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Varlion LW One\/ Plata y Amarilla","category":"PADEL","sub_category":"Padel","unit_price":34,"reference":"LW ONE","ean13":"8401001245018","weight":"0.26","quantity":5,"brand":"VARLION","description_pt":"<p>Con la pala VARLION LW ONE sin duda obtendremos un gran manejo de bola para tener precisi\u00f3n tanto en defensa como en ataque.<br><br><h2>TIPO DE JUGADOR<\/h2>Este modelo de pala esta indicado para jugadores que sobre todo busquen un buen control y calidad en el golpeo.<br><br><h2>CARACTER\u00cdSTICAS DE LA PALA<\/h2>Esta pala esta fabricada principalmente en fibra de vidrio en su totalidad, pero tambi\u00e9n incorpora carbono en su tubular bidireccional haci\u00e9ndola m\u00e1s duradera y resistente.<br><br>Tiene un formato redondo que sin duda nos beneficia a la hora de tener un amplio punto dulce para su control, de modo que con este modelo de Varlion obtendremos mucha ayuda para defender de manera eficaz y siempre poner una bola m\u00e1s dentro de la pista.<br><br>Su n\u00facleo esta fabricado con goma Eva Hypersoft con lo cual tendremos un tacto agradable y super c\u00f3modo.<br><br><h2>ESTILO DE JUEGO<\/h2>La VARLION LW ONE marca la diferencia por su manejo y control, ideal para aquellos que se est\u00e9n iniciando y que quieran dar un salto de calidad en su juego.<br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_var-pala%20pad%20lw%20one_1.jpg","wholesale_price":"29.00","unit_price_tax":34},"product_model":{"product_data":{"ean13":["8401001245018"],"reference":"LW ONE","name":{"1":"Pala de P\u00e1del Varlion LW One\/ Plata y Amarilla","2":"","3":"","4":""},"description":{"1":"<p>Con la pala VARLION LW ONE sin duda obtendremos un gran manejo de bola para tener precisi\u00f3n tanto en defensa como en ataque.<br><br><h2>TIPO DE JUGADOR<\/h2>Este modelo de pala esta indicado para jugadores que sobre todo busquen un buen control y calidad en el golpeo.<br><br><h2>CARACTER\u00cdSTICAS DE LA PALA<\/h2>Esta pala esta fabricada principalmente en fibra de vidrio en su totalidad, pero tambi\u00e9n incorpora carbono en su tubular bidireccional haci\u00e9ndola m\u00e1s duradera y resistente.<br><br>Tiene un formato redondo que sin duda nos beneficia a la hora de tener un amplio punto dulce para su control, de modo que con este modelo de Varlion obtendremos mucha ayuda para defender de manera eficaz y siempre poner una bola m\u00e1s dentro de la pista.<br><br>Su n\u00facleo esta fabricado con goma Eva Hypersoft con lo cual tendremos un tacto agradable y super c\u00f3modo.<br><br><h2>ESTILO DE JUEGO<\/h2>La VARLION LW ONE marca la diferencia por su manejo y control, ideal para aquellos que se est\u00e9n iniciando y que quieran dar un salto de calidad en su juego.<br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VARLION","supplier":null,"width":null,"height":null,"depth":null,"weight":0.26,"unit_price":34,"unit_price_tax":34,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":5,"brand":"VARLION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_var-pala%20pad%20lw%20one_1.jpg"],"wholesale_price":29}}},"8445090036423":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8445090036423",false],"wholesale_price":[88.24,false],"price":[93.24,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.32",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:183298","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2c1c9c80036c6e366208d9a04bd085b0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del VIBOR-A Yarara Black Series 1K\/ Negra","category":"PADEL","sub_category":"Padel","unit_price":93.24,"reference":"YAR BKS 1K","ean13":"8445090036423","weight":"0.32","quantity":2,"brand":"VIBOR-A","description_pt":"<p>La polivalencia est\u00e1 asegurada con una de las palas m\u00edticas de la marca en su versi\u00f3n m\u00e1s Premium, la VIBORA YARARA BLACK SERIES 1K. Una pala de V\u00edbora P\u00e1del, que nos asegura las mejores sensaciones en pista.<br><h2>TIPO DE JUGADOR<\/h2>La VIBORA YARARA BLACK SERIES 1K est\u00e1 dise\u00f1ada para jugadores de nivel alto o profesional, que busquen una pala c\u00f3moda de gran polivalencia.<br><br><h2>CARACTER\u00cdSTICAS DE LA PALA<\/h2>La&nbsp; VIBORA YARARA BLACK SERIES 1K presenta un formato de l\u00e1grima con amplio punto dulce y un balance medio, que responde genial en ataque y defensa. Las sensaciones que transmite en pista son de mucha seguridad y comodidad.<br><br>En los materiales de composici\u00f3n, la VIBORA YARARA BLACK SERIES 1K, se fabrica con Carbono 1K, un nuevo carbono novedoso que genera un tacto bestial. Su tubular tambi\u00e9n est\u00e1 compuesto&nbsp; en carbono, lo que le aporta resistencia y durabilidad a la pala. Su n\u00facleo est\u00e1 compuesto por la Goma Black Eva Ultra Soft, una goma de tacto blando, que genera gran control y buena salida de bola. En el cuello Vibora Padel ha incorporado un refuerzo de Aramida para disminuir las vibraciones.<br><br><h2>DISE\u00d1O DE LA PALA<\/h2>La VIBORA YARARA BLACK SERIES 1K sigue la l\u00ednea de la serie Black de Vibora Padel, con un dise\u00f1o elegante en negro, con detalles en los colores m\u00edticos del modelo. Una pasada.<br><br><h2>ESTILO DE JUEGO<\/h2>En cuanto al estilo de juego recomendado para este modelo, destacamos dentro de la polivalencia el buen control que otorga en nuestro juego este modelo.<br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_vib-pala%20pad%20yar%20bks%201k_1.jpg","wholesale_price":"88.24","unit_price_tax":93.24},"product_model":{"product_data":{"ean13":["8445090036423"],"reference":"YAR BKS 1K","name":{"1":"Pala de P\u00e1del VIBOR-A Yarara Black Series 1K\/ Negra","2":"","3":"","4":""},"description":{"1":"<p>La polivalencia est\u00e1 asegurada con una de las palas m\u00edticas de la marca en su versi\u00f3n m\u00e1s Premium, la VIBORA YARARA BLACK SERIES 1K. Una pala de V\u00edbora P\u00e1del, que nos asegura las mejores sensaciones en pista.<br><h2>TIPO DE JUGADOR<\/h2>La VIBORA YARARA BLACK SERIES 1K est\u00e1 dise\u00f1ada para jugadores de nivel alto o profesional, que busquen una pala c\u00f3moda de gran polivalencia.<br><br><h2>CARACTER\u00cdSTICAS DE LA PALA<\/h2>La&nbsp; VIBORA YARARA BLACK SERIES 1K presenta un formato de l\u00e1grima con amplio punto dulce y un balance medio, que responde genial en ataque y defensa. Las sensaciones que transmite en pista son de mucha seguridad y comodidad.<br><br>En los materiales de composici\u00f3n, la VIBORA YARARA BLACK SERIES 1K, se fabrica con Carbono 1K, un nuevo carbono novedoso que genera un tacto bestial. Su tubular tambi\u00e9n est\u00e1 compuesto&nbsp; en carbono, lo que le aporta resistencia y durabilidad a la pala. Su n\u00facleo est\u00e1 compuesto por la Goma Black Eva Ultra Soft, una goma de tacto blando, que genera gran control y buena salida de bola. En el cuello Vibora Padel ha incorporado un refuerzo de Aramida para disminuir las vibraciones.<br><br><h2>DISE\u00d1O DE LA PALA<\/h2>La VIBORA YARARA BLACK SERIES 1K sigue la l\u00ednea de la serie Black de Vibora Padel, con un dise\u00f1o elegante en negro, con detalles en los colores m\u00edticos del modelo. Una pasada.<br><br><h2>ESTILO DE JUEGO<\/h2>En cuanto al estilo de juego recomendado para este modelo, destacamos dentro de la polivalencia el buen control que otorga en nuestro juego este modelo.<br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VIBOR-A","supplier":null,"width":null,"height":null,"depth":null,"weight":0.32,"unit_price":93.24,"unit_price_tax":93.24,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":2,"brand":"VIBOR-A","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_vib-pala%20pad%20yar%20bks%201k_1.jpg"],"wholesale_price":88.24}}},"8436545693537":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436545693537",false],"wholesale_price":[71.12,false],"price":[76.12,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 9.6",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:183305","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/1c14fe68617d2548472ad41ba491d10f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Caja Gaming Torre Hiditec H2 Air ARGB","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","unit_price":76.12,"reference":"CHA010040","ean13":"8436545693537","weight":"9.6","quantity":5,"brand":"HIDITEC","description_pt":"                                                <h2>H2 AIR ARGB<\/h2><div>H2 AIR ARGB fabricado con acero laminado de alta calidad con 0,8 mm de espesor, una construcci\u00f3n aerodin\u00e1mica, un tama\u00f1o para albergar placas base E-ATX y una impresionante capacidad de refrigeraci\u00f3n con hasta 9 ventiladores , refrigeraci\u00f3n l\u00edquida de 360mm y CPU Coolers con una altura m\u00e1xima de 165mm, lo convierten en el aliado perfecto para los gamers m\u00e1s exigentes.<br><\/div><div><h2>Tu equipo a otro nivel<\/h2><p>H2 AIR ARGB fabricado con acero laminado de alta calidad con 0,8 mm de espesor, una construcci\u00f3n aerodin\u00e1mica, un tama\u00f1o para albergar placas base E-ATX y una impresionante capacidad de refrigeraci\u00f3n con hasta 9 ventiladores , refrigeraci\u00f3n l\u00edquida de 360mm y CPU coolers con una altura m\u00e1xima de 165mm, lo convierten en el aliado perfecto para los gamers m\u00e1s exigentes.<\/p><h2>La temperatura ya no es un problema<\/h2><p>El frontal micro perforado ofrece una ventilaci\u00f3n excepcional y una excelente entrada de aire fresco sin suciedad alguna ya que cuenta con filtro anti-polvo.<\/p><p>Adem\u00e1s soporta hasta nueve ventiladores, refrigeraci\u00f3n l\u00edquida de 360&#8203;&#8203;mm y disipador de CPU con una altura de 165mm, el impresionante potencial de refrigeraci\u00f3n del H2 AIR RGB elimina por completo cualquier riesgo de sobrecalentamiento de los componentes cr\u00edticos.<\/p><h2>El tama\u00f1o si importa<\/h2><p>Gracias a su dise\u00f1o con un ancho de 220 mm, H2 AIR ARGB ofrece un amplio espacio interior que alberga f\u00e1cilmente placas base E-ATX (305*278), tarjetas gr\u00e1ficas de hasta 370 mm, as\u00ed como todos los componentes necesarios para un equipo de alto rendimiento,\u00a0 lo que lo hace perfecto incluso para los usuarios m\u00e1s exigentes.<\/p><h2>Iluminaci\u00f3n infinita<\/h2><p>Equipado con cuatro ventiladores N18 ARGB de 120 mm con efecto infinito, H2 AIR RGB te permite controlar una variedad de impresionantes efectos de iluminaci\u00f3n con solo tocar un bot\u00f3n RGB dedicado, y si lo quieres hacer desde la distancia tambi\u00e9n podr\u00e1s hacerlo con el mando inal\u00e1mbrico que suministramos de serie.<\/p><p>Adem\u00e1s, el controlador LED incorporado es totalmente compatible con conexiones ARGB de 5 V en placas base, lo que permite una sincronizaci\u00f3n perfecta de la iluminaci\u00f3n en todo el sistema.<\/p><h2>Todo bien ordenado<\/h2><p>El sistema de gesti\u00f3n de cables en su interior est\u00e1 pensado para que quede todo bien organizado y est\u00e9ticamente perfecto, para ello cuenta con un habit\u00e1culo cubierto en la parte posterior del chasis.<\/p><p>Adem\u00e1s podr\u00e1s instalar c\u00f3modamente 2*HDD de 3.5 &#8243; y hasta 6*SSD de 2.5 &#8243;.\u00a0<\/p><h2>F\u00e1cil accesibilidad<\/h2><p>Cuenta con un puerto USB 3.0, un puerto USB 3.1 Type-C, un puerto USB 2.0 y conexi\u00f3n de micr\u00f3fono y altavoces en su parte superior.<\/p><p>Un bot\u00f3n de control RGB dedicado ofrece m\u00faltiples efectos de iluminaci\u00f3n preestablecidos para los ventiladores ARGB incluidos.<\/p><h2>Soporte de montaje vertical para la gr\u00e1fica<\/h2><p>El chasis H2 Air cuenta con 7 PCI horizontales pero adem\u00e1s ese soporte es reemplazable por este soporte adicional que permite tener 3 PCI verticales, y con ello poder montar la tarjeta gr\u00e1fica verticalmente.<\/p><p>Esta disponible en color blanco y en color negro. El cambio es muy sencillo ya que solo hay que retirar unos tornillos y sustituir uno por el otro<\/p><br><\/div><h2>Especificaciones<\/h2><div><p><ul><li>Dimensiones 510 x 215 x 415 mm<\/li><li>Peso 9100 grs<\/li><li>Fuente de alimentaci\u00f3n incluida No<\/li><li>Compatible refrigeraci\u00f3n l\u00edquida Si<\/li><li>Factor forma E-ATX<\/li><li>Frontal del chasis Microperforado<\/li><li>Laterales del chasis Cristal templado - SECC<\/li><li>Fuente de alimentaci\u00f3n del chasis ATX<\/li><li>Placa base E-ATX - ATX - Micro ATX - ITX<\/li><li>Puertos I\/O frontales 1 x USB 3.1 Type C, 1 x USB 3.0, 1 x USB 2.0, 1 x Audio in\/out<\/li><li>Bah\u00edas 3.5' x2<\/li><li>Bah\u00edas 2.5' x6<\/li><li>PCI x7<\/li><li>Ventiladores frontales 3 x 120mm LED ARGB<\/li><li>Ventiladores superiores 3 x 120mm (Opcional)<\/li><li>Ventilador trasero 1 x 120mm LED ARGB<\/li><li>Ventiladores inferiores 2 x 120mm (Opcional)<\/li><li>Altura m\u00e1xima CPU Cooler 165 mm<\/li><li>Longitud m\u00e1xima GPU 370 mm<\/li><li>Filtros antipolvo Si<\/li><li>Conexi\u00f3n ventilador 4pin 12v connector + 3pin 5v ARGB connector<\/li><li>Certificados CE , FCC , RoHs<\/li><li>Soporte radiador : Frontal 360mm \/ 240mm \/ 120mm<\/li><li>Soporte radiador : Superior 360mm \/ 240mm \/ 120mm<\/li><li>Soporte radiador : Trasero 120mm<\/li><\/ul><\/p><\/div>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hid-caja%20h2%20air%20argb%20bk_1.jpg","wholesale_price":"71.12","unit_price_tax":76.12},"product_model":{"product_data":{"ean13":["8436545693537"],"reference":"CHA010040","name":{"1":"Caja Gaming Torre Hiditec H2 Air ARGB","2":"","3":"","4":""},"description":{"1":"                                                <h2>H2 AIR ARGB<\/h2><div>H2 AIR ARGB fabricado con acero laminado de alta calidad con 0,8 mm de espesor, una construcci\u00f3n aerodin\u00e1mica, un tama\u00f1o para albergar placas base E-ATX y una impresionante capacidad de refrigeraci\u00f3n con hasta 9 ventiladores , refrigeraci\u00f3n l\u00edquida de 360mm y CPU Coolers con una altura m\u00e1xima de 165mm, lo convierten en el aliado perfecto para los gamers m\u00e1s exigentes.<br><\/div><div><h2>Tu equipo a otro nivel<\/h2><p>H2 AIR ARGB fabricado con acero laminado de alta calidad con 0,8 mm de espesor, una construcci\u00f3n aerodin\u00e1mica, un tama\u00f1o para albergar placas base E-ATX y una impresionante capacidad de refrigeraci\u00f3n con hasta 9 ventiladores , refrigeraci\u00f3n l\u00edquida de 360mm y CPU coolers con una altura m\u00e1xima de 165mm, lo convierten en el aliado perfecto para los gamers m\u00e1s exigentes.<\/p><h2>La temperatura ya no es un problema<\/h2><p>El frontal micro perforado ofrece una ventilaci\u00f3n excepcional y una excelente entrada de aire fresco sin suciedad alguna ya que cuenta con filtro anti-polvo.<\/p><p>Adem\u00e1s soporta hasta nueve ventiladores, refrigeraci\u00f3n l\u00edquida de 360&#8203;&#8203;mm y disipador de CPU con una altura de 165mm, el impresionante potencial de refrigeraci\u00f3n del H2 AIR RGB elimina por completo cualquier riesgo de sobrecalentamiento de los componentes cr\u00edticos.<\/p><h2>El tama\u00f1o si importa<\/h2><p>Gracias a su dise\u00f1o con un ancho de 220 mm, H2 AIR ARGB ofrece un amplio espacio interior que alberga f\u00e1cilmente placas base E-ATX (305*278), tarjetas gr\u00e1ficas de hasta 370 mm, as\u00ed como todos los componentes necesarios para un equipo de alto rendimiento,\u00a0 lo que lo hace perfecto incluso para los usuarios m\u00e1s exigentes.<\/p><h2>Iluminaci\u00f3n infinita<\/h2><p>Equipado con cuatro ventiladores N18 ARGB de 120 mm con efecto infinito, H2 AIR RGB te permite controlar una variedad de impresionantes efectos de iluminaci\u00f3n con solo tocar un bot\u00f3n RGB dedicado, y si lo quieres hacer desde la distancia tambi\u00e9n podr\u00e1s hacerlo con el mando inal\u00e1mbrico que suministramos de serie.<\/p><p>Adem\u00e1s, el controlador LED incorporado es totalmente compatible con conexiones ARGB de 5 V en placas base, lo que permite una sincronizaci\u00f3n perfecta de la iluminaci\u00f3n en todo el sistema.<\/p><h2>Todo bien ordenado<\/h2><p>El sistema de gesti\u00f3n de cables en su interior est\u00e1 pensado para que quede todo bien organizado y est\u00e9ticamente perfecto, para ello cuenta con un habit\u00e1culo cubierto en la parte posterior del chasis.<\/p><p>Adem\u00e1s podr\u00e1s instalar c\u00f3modamente 2*HDD de 3.5 &#8243; y hasta 6*SSD de 2.5 &#8243;.\u00a0<\/p><h2>F\u00e1cil accesibilidad<\/h2><p>Cuenta con un puerto USB 3.0, un puerto USB 3.1 Type-C, un puerto USB 2.0 y conexi\u00f3n de micr\u00f3fono y altavoces en su parte superior.<\/p><p>Un bot\u00f3n de control RGB dedicado ofrece m\u00faltiples efectos de iluminaci\u00f3n preestablecidos para los ventiladores ARGB incluidos.<\/p><h2>Soporte de montaje vertical para la gr\u00e1fica<\/h2><p>El chasis H2 Air cuenta con 7 PCI horizontales pero adem\u00e1s ese soporte es reemplazable por este soporte adicional que permite tener 3 PCI verticales, y con ello poder montar la tarjeta gr\u00e1fica verticalmente.<\/p><p>Esta disponible en color blanco y en color negro. El cambio es muy sencillo ya que solo hay que retirar unos tornillos y sustituir uno por el otro<\/p><br><\/div><h2>Especificaciones<\/h2><div><p><ul><li>Dimensiones 510 x 215 x 415 mm<\/li><li>Peso 9100 grs<\/li><li>Fuente de alimentaci\u00f3n incluida No<\/li><li>Compatible refrigeraci\u00f3n l\u00edquida Si<\/li><li>Factor forma E-ATX<\/li><li>Frontal del chasis Microperforado<\/li><li>Laterales del chasis Cristal templado - SECC<\/li><li>Fuente de alimentaci\u00f3n del chasis ATX<\/li><li>Placa base E-ATX - ATX - Micro ATX - ITX<\/li><li>Puertos I\/O frontales 1 x USB 3.1 Type C, 1 x USB 3.0, 1 x USB 2.0, 1 x Audio in\/out<\/li><li>Bah\u00edas 3.5' x2<\/li><li>Bah\u00edas 2.5' x6<\/li><li>PCI x7<\/li><li>Ventiladores frontales 3 x 120mm LED ARGB<\/li><li>Ventiladores superiores 3 x 120mm (Opcional)<\/li><li>Ventilador trasero 1 x 120mm LED ARGB<\/li><li>Ventiladores inferiores 2 x 120mm (Opcional)<\/li><li>Altura m\u00e1xima CPU Cooler 165 mm<\/li><li>Longitud m\u00e1xima GPU 370 mm<\/li><li>Filtros antipolvo Si<\/li><li>Conexi\u00f3n ventilador 4pin 12v connector + 3pin 5v ARGB connector<\/li><li>Certificados CE , FCC , RoHs<\/li><li>Soporte radiador : Frontal 360mm \/ 240mm \/ 120mm<\/li><li>Soporte radiador : Superior 360mm \/ 240mm \/ 120mm<\/li><li>Soporte radiador : Trasero 120mm<\/li><\/ul><\/p><\/div>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HIDITEC","supplier":null,"width":null,"height":null,"depth":null,"weight":9.6,"unit_price":76.12,"unit_price_tax":76.12,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming 