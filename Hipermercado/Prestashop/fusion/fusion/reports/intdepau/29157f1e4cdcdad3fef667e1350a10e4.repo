do. Con m\u00e1s potencia, m\u00e1s aerodin\u00e1mica, ligereza y manejabilidad la Vertex 04 desaf\u00eda toda esta categor\u00eda de palas haciendo posible el juego que antes era imposible. Ataques puros y veloces sin perder el control del juego.<\/p><p>\u00a1Velocidad con m\u00e1ximo dominio!<\/p><h2>Especificaciones<\/h2><p><ul><li><b>Tecnolog\u00edas: <\/b>Curv:aktiv, Air Power, Vertex Core, Ease Vibe, Custom Weight, Top Spin, Hesacore, Vibradrive, Xtend-Carbon 12k, Multieva, Carbontube.<\/li><li><b>Peso aprox:<\/b> 365-375 g<\/li><li><b>Perfil:<\/b> 38 mm<\/li><li><b>Balance:<\/b> &#8776; 25.5<\/li><li><b>Forma:<\/b> Diamante<\/li><li><b>Comp. exterior: <\/b>X-Tend Carbon 12K<\/li><li><b>Comp. interior:<\/b> Multieva<\/li><li><b>Jugador:<\/b> Adulto experto<\/li><li><b>Tipo:<\/b> Juego Total<\/li><li><b>Superficie de juego:<\/b> 530 cm\u00b2<\/li><li><b>Rugoso:<\/b> Top Spin<\/li><\/ul><\/p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BULLPADEL","supplier":null,"width":null,"height":null,"depth":null,"weight":0.38,"unit_price":159.95,"unit_price_tax":159.95,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":5,"brand":"BULLPADEL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bup-pala%20pad%20vertex%2004%2025_1.jpg"],"wholesale_price":152.95}}},"8445402691883":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8445402691883",false],"wholesale_price":[152.95,false],"price":[159.95,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.38",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product witho