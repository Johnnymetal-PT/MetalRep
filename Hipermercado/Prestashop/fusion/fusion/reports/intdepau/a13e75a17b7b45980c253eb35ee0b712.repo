"},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"RYOBI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":335.57,"unit_price_tax":335.57,"tax_rules_group":null,"category":"Bricolaje","sub_category":"Herramientas de Bricolaje","quantity":0,"brand":"RYOBI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-pack%20r18ck4f-252s_1.jpg"],"wholesale_price":330.57}}},"4892210149428":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4892210149428",false],"wholesale_price":[36.19,false],"price":[41.19,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:135401","Cat. IDs: 120","Associated Categories","Cat. Default: 120","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/94cb94d2d55de18d2442ca101c1a346b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pistola de Pegamento Sin Cable Ryobi ONE+ R18GLU-0\/ 18V \/ Sin Bater\u00eda ni Cargador","category":"Bricolaje","sub_category":"Herramientas de Bricolaje","unit_price":41.19,"reference":"5133002868","ean13":"4892210149428","weight":"0","quantity":0,"brand":"RYOBI","description_pt":"<p><h2>Pistola de pegamento inal\u00e1mbrica ONE+&#8482; de 18 V R18GLU-0<p>(Bater\u00eda no incluida)<\/p><\/h2>Ideal para aficionados al bricolaje dom\u00e9stico y entusiastas de la artesan\u00eda que realizan una amplia gama de trabajos de fijaci\u00f3n. Esta pistola de pegamento de 18 V solo tarda 3 minutos en calentarse hasta 180 \u00b0C para comenzar a trabajar en proyectos que utilizan diversos materiales como papel, cart\u00f3n, textiles, cuero, pl\u00e1stico, madera, metal, corcho o piedra. Cuenta con un gatillo ergon\u00f3mico de doble dedo que mejora el control para aplicar pegamento a la velocidad deseada. Compatible con cualquier marca de barras de pegamento multiuso est\u00e1ndar de 11 mm.<br>Con una bater\u00eda de 5 Ah (no incluida), el Ryobi R18GLU-0 puede dispensar hasta 58 barras de pegamento con una sola carga. Esta es una herramienta b\u00e1sica: la bater\u00eda y el cargador no est\u00e1n incluidos.<\/p><p><ul><li>Pistola de pegamento inal\u00e1mbrica, ideal para usar en una amplia selecci\u00f3n de materiales como papel, cart\u00f3n, textiles, cuero, pl\u00e1stico, madera, metal, corcho o piedra<\/li><li>Gatillo de dos dedos para un control mejorado<\/li><li>El calentamiento de 3 minutos significa que est\u00e1 listo para pegarse en muy poco tiempo.<\/li><li>Compatible con cualquier marca de adhesivos multiusos y de alta resistencia de 11 mm de di\u00e1metro<\/li><\/ul><h2>Especificaciones<\/h2><ul><li><b>INFORMACI\u00d3N B\u00c1SICA<\/b><\/li><li>N\u00famero de art\u00edculo<\/li><li>5133002868<\/li><li>Fuerza<\/li><li>18 voltios<\/li><li><b>Equipamiento estandar<\/b><\/li><li>3 barras de pegamento<\/li><li>Suministrado en: Cart\u00f3n Reciclable<\/li><li><b>ACTUACI\u00d3N<\/b><\/li><li>Rango de temperatura, \u00b0 C)<\/li><li>180<\/li><li>Di\u00e1metro de la barra de pegamento [mm]<\/li><li>11<\/li><li>Orificio de boquilla [mm]<\/li><li>3<\/li><li><b>FUENTE DE ALIMENTACI\u00d3N<\/b><\/li><li>Cargador incluido: No<\/li><li>N\u00ba de pilas suministradas: 0 no incluida<\/li><li>Fuerza<\/li><li>18 voltios<\/li><li>PESO<\/li><li>Peso (sin bater\u00eda) (kg)<\/li><li>0.4<\/li><li>Peso con bater\u00eda (EPTA) (kg)<\/li><li>0.7<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-pist%20pegam%20r18glu-0_1.jpg","wholesale_price":"36.19","unit_price_tax":41.19},"product_model":{"product_data":{"ean13":["4892210149428"],"reference":"5133002868","name":{"1":"Pistola de Pegamento Sin Cable Ryobi ONE+ R18GLU-0\/ 18V \/ Sin Bater\u00eda ni Cargador","2":"","3":"","4":""},"description":{"1":"<p><h2>Pistola de pegamento inal\u00e1mbrica ONE+&#8482; de 18 V R18GLU-0<p>(Bater\u00eda no incluida)<\/p><\/h2>Ideal para aficionados al bricolaje dom\u00e9stico y entusiastas de la artesan\u00eda que realizan una amplia gama de trabajos de fijaci\u00f3n. Esta pistola de pegamento de 18 V solo tarda 3 minutos en calentarse hasta 180 \u00b0C para comenzar a trabajar en proyectos que utilizan diversos materiales como papel, cart\u00f3n, textiles, cuero, pl\u00e1stico, madera, metal, corcho o piedra. Cuenta con un gatillo ergon\u00f3mico de doble dedo que mejora el control para aplicar pegamento a la velocidad deseada. Compatible con cualquier marca de barras de pegamento multiuso est\u00e1ndar de 11 mm.<br>Con una bater\u00eda de 5 Ah (no incluida), el Ryobi R18GLU-0 puede dispensar hasta 58 barras de pegamento con una sola carga. Esta es una herramienta b\u00e1sica: la bater\u00eda y el cargador no est\u00e1n incluidos.<\/p><p><ul><li>Pistola de pegamento inal\u00e1mbrica, ideal para usar en una amplia selecci\u00f3n de materiales como papel, cart\u00f3n, textiles, cuero, pl\u00e1stico, madera, metal, corcho o piedra<\/li><li>Gatillo de dos dedos para un control mejorado<\/li><li>El calentamiento de 3 minutos significa que est\u00e1 listo para pegarse en muy poco tiempo.<\/li><li>Compatible con cualquier marca de adhesivos multiusos y de alta resistencia de 11 mm de di\u00e1metro<\/li><\/ul><h2>Especificaciones<\/h2><ul><li><b>INFORMACI\u00d3N B\u00c1SICA<\/b><\/li><li>N\u00famero de art\u00edculo<\/li><li>5133002868<\/li><li>Fuerza<\/li><li>18 voltios<\/li><li><b>Equipamiento estandar<\/b><\/li><li>3 barras de pegamento<\/li><li>Suministrado en: Cart\u00f3n Reciclable<\/li><li><b>ACTUACI\u00d3N<\/b><\/li><li>Rango de temperatura, \u00b0 C)<\/li><li>180<\/li><li>Di\u00e1metro de la barra de pegamento [mm]<\/li><li>11<\/li><li>Orificio de boquilla [mm]<\/li><li>3<\/li><li><b>FUENTE DE ALIMENTACI\u00d3N<\/b><\/li><li>Cargador incluido: No<\/li><li>N\u00ba de pilas suministradas: 0 no incluida<\/li><li>Fuerza<\/li><li>18 voltios<\/li><li>PESO<\/li><li>Peso (sin bater\u00eda) (kg)<\/li><li>0.4<\/li><li>Peso con bater\u00eda (EPTA) (kg)<\/li><li>0.7<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"RYOBI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":41.19,"unit_price_tax":41.19,"tax_rules_group":null,"category":"Bricolaje","sub_category":"Herramientas de Bricolaje","quantity":0,"brand":"RYOBI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-pist%20pegam%20r18glu-0_1.jpg"],"wholesale_price":36.19}}},"4892210183217":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4892210183217",false],"wholesale_price":[82.64,false],"price":[87.64,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:135402","Cat. IDs: 120","Associated Categories","Cat. Default: 120","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/22dbfc79efb9a34d7f08054e8813743e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Sierra de Poda Ryobi ONE+ 18V RY18PSA-0\/ Corte \u00d880 mm\/ Sin Bater\u00eda ni Cargador","category":"Bricolaje","sub_category":"Herramientas de Jard\u00edn","unit_price":87.64,"reference":"5133004594","ean13":"4892210183217","weight":"0","quantity":0,"brand":"RYOBI","description_pt":"<p>Como parte del sistema Ryobi ONE+&#8482; de herramientas a bater\u00eda para el hogar, el jard\u00edn, el autom\u00f3vil, la limpieza y mucho m\u00e1s, la sierra de mno a bater\u00eda RYOBI\u00ae18V ONE+&#8482; RY18PSA-0 es perfecta para cortar \u00e1rboles y arbustos.<br><br>Dise\u00f1ada para ser compacta, ligera y para su uso con una sola mano, la empu\u00f1adura ergon\u00f3mica proporciona comodidad al usuario durante un uso prolongado y la sierra de ramas integrada le garantiza un control total, incluso cuando corta a pleno alcance. Con una gran capacidad de corte de 80 mm, la sierra de poda a bater\u00eda ONE+&#8482; es perfecta para cortar ramas peque\u00f1as y medianas. La sujeci\u00f3n de la hoja sin herramientas acepta hojas con ajuste est\u00e1ndar. Se suministra con una hoja de 8 DPP.<br><br>Con una bater\u00eda de 5.0Ah (no incluida), la Ryobi RY18PSA-0 puede realizar hasta 150 cortes con una sola carga. La bater\u00eda y el cargador no est\u00e1n incluidos.<br><br><\/p><ul>  <li><b>Caracter\u00edsticas<\/b><\/li>  <li>La sierra de poda de jard\u00edn RYOBI\u00ae 18V ONE+&#8482; facilita el trabajo de podar \u00e1rboles y arbustos<\/li>  <li>Una gran capacidad de corte de 80 mm es perfecta para cortar ramas de tama\u00f1o peque\u00f1o a mediano<\/li>  <li>Una mordaza de rama integrada garantiza el control total, incluso cuando corte al m\u00e1ximo<\/li>  <li>El dise\u00f1o ligero y compacto minimiza la fatiga, ayud\u00e1ndole a podar durante m\u00e1s tiempo<\/li>  <li>Se suministra con una hoja de sierra de 8 DPP<\/li>  <li>Funciona con todas las bater\u00edas RYOBI\u00ae Lithium+&#8482; 18V ONE+&#8482;<\/li><\/ul><ul>  <li><b>RENDIMIENTO<\/b><\/li>  <li>Capacidad de corte (mm)<\/li>  <li>80<\/li>  <li>Largo de la cuchillas (cm)<\/li>  <li>15<\/li>  <li>M\u00e1x. capacidad en madera (mm)<\/li>  <li>80<\/li>  <li>N\u00ba de carreras en vac\u00edo (cpm)<\/li>  <li>2600<\/li>  <li><b>BATER\u00cdA<\/b><\/li>  <li>Cargador incluido<\/li>  <li>No<\/li>  <li>N\u00ba bater\u00edas suministradas<\/li>  <li>0<\/li>  <li>Potencia<\/li>  <li>18V<\/li>  <li><b>PESO<\/b><\/li>  <li>Peso (sin bater\u00edas) (kg)<\/li>  <li>0.9<\/li>  <li>Peso con bater\u00eda (EPTA) (kg)<\/li>  <li>1.3<\/li><\/ul><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-sierra%20poda%20ry18psa-0_1.jpg","wholesale_price":"82.64","unit_price_tax":87.64},"product_model":{"product_data":{"ean13":["4892210183217"],"reference":"5133004594","name":{"1":"Sierra de Poda Ryobi ONE+ 18V RY18PSA-0\/ Corte \u00d880 mm\/ Sin Bater\u00eda ni Cargador","2":"","3":"","4":""},"description":{"1":"<p>Como parte del sistema Ryobi ONE+&#8482; de herramientas a bater\u00eda para el hogar, el jard\u00edn, el autom\u00f3vil, la limpieza y mucho m\u00e1s, la sierra de mno a bater\u00eda RYOBI\u00ae18V ONE+&#8482; RY18PSA-0 es perfecta para cortar \u00e1rboles y arbustos.<br><br>Dise\u00f1ada para ser compacta, ligera y para su uso con una sola mano, la empu\u00f1adura ergon\u00f3mica proporciona comodidad al usuario durante un uso prolongado y la sierra de ramas integrada le garantiza un control total, incluso cuando corta a pleno alcance. Con una gran capacidad de corte de 80 mm, la sierra de poda a bater\u00eda ONE+&#8482; es perfecta para cortar ramas peque\u00f1as y medianas. La sujeci\u00f3n de la hoja sin herramientas acepta hojas con ajuste est\u00e1ndar. Se suministra con una hoja de 8 DPP.<br><br>Con una bater\u00eda de 5.0Ah (no incluida), la Ryobi RY18PSA-0 puede realizar hasta 150 cortes con una sola carga. La bater\u00eda y el cargador no est\u00e1n incluidos.<br><br><\/p><ul>  <li><b>Caracter\u00edsticas<\/b><\/li>  <li>La sierra de poda de jard\u00edn RYOBI\u00ae 18V ONE+&#8482; facilita el trabajo de podar \u00e1rboles y arbustos<\/li>  <li>Una gran capacidad de corte de 80 mm es perfecta para cortar ramas de tama\u00f1o peque\u00f1o a mediano<\/li>  <li>Una mordaza de rama integrada garantiza el control total, incluso cuando corte al m\u00e1ximo<\/li>  <li>El dise\u00f1o ligero y compacto minimiza la fatiga, ayud\u00e1ndole a podar durante m\u00e1s tiempo<\/li>  <li>Se suministra con una hoja de sierra de 8 DPP<\/li>  <li>Funciona con todas las bater\u00edas RYOBI\u00ae Lithium+&#8482; 18V ONE+&#8482;<\/li><\/ul><ul>  <li><b>RENDIMIENTO<\/b><\/li>  <li>Capacidad de corte (mm)<\/li>  <li>80<\/li>  <li>Largo de la cuchillas (cm)<\/li>  <li>15<\/li>  <li>M\u00e1x. capacidad en madera (mm)<\/li>  <li>80<\/li>  <li>N\u00ba de carreras en vac\u00edo (cpm)<\/li>  <li>2600<\/li>  <li><b>BATER\u00cdA<\/b><\/li>  <li>Cargador incluido<\/li>  <li>No<\/li>  <li>N\u00ba bater\u00edas suministradas<\/li>  <li>0<\/li>  <li>Potencia<\/li>  <li>18V<\/li>  <li><b>PESO<\/b><\/li>  <li>Peso (sin bater\u00edas) (kg)<\/li>  <li>0.9<\/li>  <li>Peso con bater\u00eda (EPTA) (kg)<\/li>  <li>1.3<\/li><\/ul><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"RYOBI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":87.64,"unit_price_tax":87.64,"tax_rules_group":null,"category":"Bricolaje","sub_category":"Herramientas de Jard\u00edn","quantity":0,"brand":"RYOBI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-sierra%20poda%20ry18psa-0_1.jpg"],"wholesale_price":82.64}}},"4892210145741":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4892210145741",false],"wholesale_price":[82.58,false],"price":[87.58,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinatio