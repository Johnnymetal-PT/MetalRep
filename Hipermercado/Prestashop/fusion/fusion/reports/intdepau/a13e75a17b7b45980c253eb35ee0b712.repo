.89}}},"0045496478773":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0045496478773",false],"wholesale_price":[47.6,false],"price":[52.6,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:135455","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cfbf4b65b70fa4e628cd367434b61e85.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Juego para Consola Nintendo Switch The Legend of Zelda: Tears of the Kingdom","category":"Juegos y Accesorios","sub_category":"Juegos Nintendo Switch","unit_price":52.6,"reference":"TLOZ TEA OFTKIN","ean13":"0045496478773","weight":"0.05","quantity":0,"brand":"NINTENDO","description_pt":"                                                <p><ul>  <li>The Legend of Zelda: Tears of The Kingdom es la secuela de The Legend of Zelda: Breath of the Wild<\/li>  <li>Te aguarda un \u00e9pico viaje en el que recorrer\u00e1s las tierras y los vastos cielos de Hyrule en The Legend of Zelda: Tears of the Kingdom para Nintendo Switch<\/li>  <li>Emb\u00e1rcate en una peligrosa misi\u00f3n para descubrir el origen del estremecedor evento que ha sumido Hyrule en el caos.<\/li>  <li>Sigue tu propio camino a lo largo y ancho de los inmensos paisajes de Hyrule y las extra\u00f1as islas que flotan en las alturas.<\/li>  <li>\u00a1Domina el poder de las nuevas habilidades de Link para dise\u00f1ar y construir estupendas armas y veh\u00edculos!<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nin-ns-j%20tloz%20tea%20oftkin_1.jpg","wholesale_price":"47.60","unit_price_tax":52.6},"product_model":{"product_data":{"ean13":["0045496478773"],"reference":"TLOZ TEA OFTKIN","name":{"1":"Juego para Consola Nintendo Switch The Legend of Zelda: Tears of the Kingdom","2":"","3":"","4":""},"description":{"1":"                                                <p><ul>  <li>The Legend of Zelda: Tears of The Kingdom es la secuela de The Legend of Zelda: Breath of the Wild<\/li>  <li>Te aguarda un \u00e9pico viaje en el que recorrer\u00e1s las tierras y los vastos cielos de Hyrule en The Legend of Zelda: Tears of the Kingdom para Nintendo Switch<\/li>  <li>Emb\u00e1rcate en una peligrosa misi\u00f3n para descubrir el origen del estremecedor evento que ha sumido Hyrule en el caos.<\/li>  <li>Sigue tu propio camino a lo largo y ancho de los inmensos paisajes de Hyrule y las extra\u00f1as islas que flotan en las alturas.<\/li>  <li>\u00a1Domina el poder de las nuevas habilidades de Link para dise\u00f1ar y construir estupendas armas y veh\u00edculos!<\/li><\/ul><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NINTENDO","supplier":null,"width":null,"height":null,"depth":null,"weight":0.05,"unit_price":52.6,"unit_price_tax":52.6,"tax_rules_group":null,"category":"Juegos y Accesorios","sub_category":"Juegos Nintendo Switch","quantity":0,"brand":"NINTENDO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nin-ns-j%20tloz%20tea%20oftkin_1.jpg"],"wholesale_price":47.6}}},"6941812703670":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812703670",false],"wholesale_price":[126.15,false],"price":[131.15,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:135456","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b976443c02e857b16db6852e626632a5.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Robot Aspirador Xiaomi Robot Vacuum E10\/ Friegasuelos\/ control por WiFi\/ Blanco","category":"Limpieza de Hogar","sub_category":"Robots Aspirador","unit_price":131.15,"reference":"BHR6783EU","ean13":"6941812703670","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"<p><h2>Robot Aspirador Xiaomi E10<\/h2><p>Experto en limpieza vers\u00e1til<\/p><p><h2>Potente ventilador de succi\u00f3n de 4000Pa*<\/h2><p><b>Limpieza eficaz en una sola pasada<\/b><\/p><p>4 niveles de succi\u00f3n ajustables para facilitar la limpieza del polvo y los desechos y la eliminaci\u00f3n de part\u00edculas de polvo diminutas. 110 minutos de duraci\u00f3n de la bater\u00eda en modo est\u00e1ndar (aspiradora y fregona) con una capacidad de 2600 mAh*.<\/p><h2>Limpieza asistida multidireccional<\/h2><p><b>Limpiar espacios de dif\u00edcil acceso<\/b><\/p><p>Equipado con piezas de alta calidad, incluido el cepillo lateral, el cepillo principal y el filtro de la caja de polvo, con coordinaci\u00f3n multidireccional para una experiencia de limpieza completa y eficiente.<\/p><\/p><h2>Caudal de agua medido para fregado<\/h2><\/p><p>Equipada con un tanque de agua inteligente con 3 niveles de flujo de agua, la unidad puede ajustar la descarga de agua seg\u00fan los diferentes tipos de piso para evitar que se empape demasiado<br><\/p><p><h2>Caj\u00f3n dise\u00f1ado para una r\u00e1pida extracci\u00f3n y montaje.<\/h2><p>La caja de polvo del caj\u00f3n y el tanque de agua est\u00e1n dise\u00f1ados para ser r\u00e1pidos de quitar y f\u00e1ciles de limpiar.<\/p><p><h2>Cambie f\u00e1cilmente entre aspirar y limpiar<\/h2><p>Cambie entre 3 modos de limpieza de pisos, para una f\u00e1cil limpieza en un solo paso.<\/p><h2>El cuerpo delgado permite el movimiento libre.<\/h2><p>La unidad principal delgada puede moverse libremente debajo de la mayor\u00eda de las camas, gabinetes y sof\u00e1s para limpiar esos lugares dif\u00edciles de alcanzar.<\/p><h2>Limpieza planificada<\/h2><p><span style='background-color: initial;'>Ruta de limpieza en zigzag para un proceso de limpieza medido y una mayor eficiencia de limpieza.<\/span><br><\/p><h2>Adaptable a entornos complejos<\/h2><p>Los sensores integrados* brindan flexibilidad para manejar entornos dom\u00e9sticos complejos y garantizan una limpieza sin preocupaciones.<\/p><h2>Las notificaciones de voz te mantienen informado en tiempo real<\/h2><p>La funci\u00f3n de notificaci\u00f3n de voz le permite realizar un seguimiento del progreso de la limpieza en tiempo real.<\/p><h2>Control inteligente y f\u00e1cil de usar a trav\u00e9s de la aplicaci\u00f3n<\/h2><p>Con\u00e9ctese a la aplicaci\u00f3n Mi Home\/Xiaomi Home para una f\u00e1cil operaci\u00f3n cuando est\u00e9 fuera y para configurar tareas de limpieza programadas.<\/p><p><ul><li>Limpieza cercana a la pared con menos puntos perdidos<\/li><li><span style='background-color: initial;'>Se detiene inmediatamente cuando se detecta un paso<\/span><\/li><li><span style='background-color: initial;'>Atraviesa brechas y obst\u00e1culos*, es menos probable que se atasque<\/span><\/li><\/ul><\/p><br><\/p><p><h2>Especificaciones del producto<\/h2><p><ul><li>N\u00famero de modelo<\/li><li>B112<\/li><li>Dimensiones de la unidad principal<\/li><li>&#934;325x80mm<\/li><li>Potencia nominal<\/li><li>35W<\/li><li>Tensi\u00f3n nominal<\/li><li>14.4V&#9107;<\/li><li>Voltaje de carga<\/li><li>20V&#9107;<\/li><li>Capacidad de la bater\u00eda<\/li><li>2500 mAh (capacidad nominal)<\/li><li>2600 mAh (capacidad nominal)<\/li><li><b>Muelle de carga<\/b><\/li><li>Modelo de base de carga<\/li><li>CDZB112<\/li><li>Entrada nominal<\/li><li>20V&#9107; 0.6A<\/li><li>Salida nominal<\/li><li>20V&#9107; 0.6A<\/li><li>Dimensiones del producto<\/li><li>146 \u00d7 122 \u00d7 87,5 mm<\/li><li><b>Contenidos del paquete<\/b><\/li><li>Unidad principal \u00d7 1<\/li><li>Cepillo principal \u00d7 1 (Preinstalado en la unidad principal)<\/li><li>Tanque de agua 2 en 1 y contenedor de polvo \u00d7 1<\/li><li>Cepillo lateral \u00d7 1<\/li><li>Cubierta de cepillo \u00d7 1 (Preinstalado en la unidad principal)<\/li><li>Pad\u00d71 (Preinstalado en el marco de la fregona)<\/li><li>Marco de fregona \u00d7 1<\/li><li>Adaptador de corriente \u00d7 1<\/li><li>Base de carga \u00d7 1<\/li><li>Cepillo de limpieza \u00d7 1 (Sobre el dep\u00f3sito de agua y el dep\u00f3sito de polvo 2 en 1)<\/li><li>Manual de usuario \u00d7 1<\/li><\/ul><\/p><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-robot%20vacuum%20e10_1.jpg","wholesale_price":"126.15","unit_price_tax":131.15},"product_model":{"product_data":{"ean13":["6941812703670"],"reference":"BHR6783EU","name":{"1":"Robot Aspirador Xiaomi Robot Vacuum E10\/ Friegasuelos\/ control por WiFi\/ Blanco","2":"","3":"","4":""},"description":{"1":"<p><h2>Robot Aspirador Xiaomi E10<\/h2><p>Experto en limpieza vers\u00e1til<\/p><p><h2>Potente ventilador de succi\u00f3n de 4000Pa*<\/h2><p><b>Limpieza eficaz en una sola pasada<\/b><\/p><p>4 niveles de succi\u00f3n ajustables para facilitar la limpieza del polvo y los desechos y la eliminaci\u00f3n de part\u00edculas de polvo diminutas. 110 minutos de duraci\u00f3n de la bater\u00eda en modo est\u00e1ndar (aspiradora y fregona) con una capacidad de 2600 mAh*.<\/p><h2>Limpieza asistida multidireccional<\/h2><p><b>Limpiar espacios de dif\u00edcil acceso<\/b><\/p><p>Equipado con piezas de alta calidad, incluido el cepillo lateral, el cepillo principal y el filtro de la caja de polvo, con coordinaci\u00f3n multidireccional para una experiencia de limpieza completa y eficiente.<\/p><\/p><h2>Caudal de agua medido para fregado<\/h2><\/p><p>Equipada con un tanque de agua inteligente con 3 niveles de flujo de agua, la unidad puede ajustar la descarga de agua seg\u00fan los diferentes tipos de piso para evitar que se empape demasiado<br><\/p><p><h2>Caj\u00f3n dise\u00f1ado para una r\u00e1pida extracci\u00f3n y montaje.<\/h2><p>La caja de polvo del caj\u00f3n y el tanque de agua est\u00e1n dise\u00f1ados para ser r\u00e1pidos de quitar y f\u00e1ciles de limpiar.<\/p><p><h2>Cambie f\u00e1cilmente entre aspirar y limpiar<\/h2><p>Cambie entre 3 modos de limpieza de pisos, para una f\u00e1cil limpieza en un solo paso.<\/p><h2>El cuerpo delgado permite el movimiento libre.<\/h2><p>La unidad principal delgada puede moverse libremente debajo de la mayor\u00eda de las camas, gabinetes y sof\u00e1s para limpiar esos lugares dif\u00edciles de alcanzar.<\/p><h2>Limpieza planificada<\/h2><p><span style='background-color: initial;'>Ruta de limpieza en zigzag para un proceso de limpieza medido y una mayor eficiencia de limpieza.<\/span><br><\/p><h2>Adaptable a entornos complejos<\/h2><p>Los sensores integrados* brindan flexibilidad para manejar entornos dom\u00e9sticos complejos y garantizan una limpieza sin preocupaciones.<\/p><h2>Las notificaciones de voz te mantienen informado en tiempo real<\/h2><p>La funci\u00f3n de notificaci\u00f3n de voz le permite realizar un seguimiento del progreso de la limpieza en tiempo real.<\/p><h2>Control inteligente y f\u00e1cil de usar a trav\u00e9s de la aplicaci\u00f3n<\/h2><p>Con\u00e9ctese a la aplicaci\u00f3n Mi Home\/Xiaomi Home para una f\u00e1cil operaci\u00f3n cuando est\u00e9 fuera y para configurar tareas de limpieza programadas.<\/p><p><ul><li>Limpieza cercana a la pared con menos puntos perdidos<\/li><li><span style='background-color: initial;'>Se detiene inmediatamente cuando se detecta un paso<\/span><\/li><li><span style='background-color: initial;'>Atraviesa brechas y obst\u00e1culos*, es menos probable que se atasque<\/span><\/li><\/ul><\/p><br><\/p><p><h2>Especificaciones del producto<\/h2><p><ul><li>N\u00famero de modelo<\/li><li>B112<\/li><li>Dimensiones de la unidad principal<\/li><li>&#934;325x80mm<\/li><li>Potencia nominal<\/li><li>35W<\/li><li>Tensi\u00f3n nominal<\/li><li>14.4V&#9107;<\/li><li>Voltaje de carga<\/li><li>20V&#9107;<\/li><li>Capacidad de la bater\u00eda<\/li><li>2500 mAh (capacidad nominal)<\/li><li>2600 mAh (capacidad nominal)<\/li><li><b>Muelle de carga<\/b><\/li><li>Modelo de base de carga<\/li><li>CDZB112<\/li><li>Entrada nominal<\/li><li>20V&#9107; 0.6A<\/li><li>Salida nominal<\/li><li>20V&#9107; 0.6A<\/li><li>Dimensiones del producto<\/li><li>146 \u00d7 122 \u00d7 87,5 mm<\/li><li><b>Contenidos del paquete<\/b><\/li><li>Unidad principal \u00d7 1<\/li><li>Cepillo principal \u00d7 1 (Preinstalado en la unidad principal)<\/li><li>Tanque de agua 2 en 1 y contenedor de polvo \u00d7 1<\/li><li>Cepillo lateral \u00d7 1<\/li><li>Cubierta de cepillo \u00d7 1 (Preinstalado en la unidad principal)<\/li><li>Pad\u00d71 (Preinstalado en el marco de la fregona)<\/li><li>Marco de fregona \u00d7 1<\/li><li>Adaptador de corriente \u00d7 1<\/li><li>Base de carga \u00d7 1<\/li><li>Cepillo de limpieza \u00d7 1 (Sobre el dep\u00f3sito de agua y el dep\u00f3sito de polvo 2 en 1)<\/li><li>Manual de usuario \u00d7 1<\/li><\/ul><\/p><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":131.15,"unit_price_tax":131.15,"tax_rules_group":null,"category":"Limpieza de Hogar","sub_category":"Robots Aspirador","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-robot%20vacuum%20e10_1.jpg"],"wholesale_price":126.15}}},"6934177781926":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6934177781926",false],"wholesale_price":[173.25,false],"price":[178.25,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:135457","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c50d364388350a078a8b685092a75200.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Robot Aspirador Xiaomi Robot Vacuum S10\/ Friegasuelos\/ Autonom\u00eda 130 Min\/ control por WiFi\/ Blanco","category":"Limpieza de Hogar","sub_category":"Robots Aspirador","unit_price":178.25,"reference":"BHR5988EU","ean13":"6934177781926","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"<p><\/p><h2>Robot Aspirador Xiaomi S10<\/h2><div><h2>Navegaci\u00f3n l\u00e1ser, detecta con precisi\u00f3n el entorno<\/h2><p><b>Aspira el suelo sin perderse<\/b><\/p><p>Xiaomi Robot Vacuum S10 est\u00e1 equipado con tecnolog\u00eda de navegaci\u00f3n l\u00e1ser, que puede lograr un escaneo de 360\u00b0, identificar r\u00e1pidamente el entorno del hogar y crear un mapa del hogar preciso.<\/p><h2>Sensor LDS elevado con rango de detecci\u00f3n de 360 &#8203;&#8203;grados<\/h2><p>El robot cuenta con un sensor de distancia l\u00e1ser de \u00faltima generaci\u00f3n que permite un posicionamiento preciso, mediciones de distancia precisas y un mejor rendimiento.<\/p><h2>Funciones de mapeo personalizadas, limpia como quieras<\/h2><p>Con\u00e9ctese a la aplicaci\u00f3n Mi Home\/Xiaomi Home para generar mapas precisos y personalizar su programa de limpieza para lograr la m\u00e1xima eficiencia.<\/p><h2>Succi\u00f3n fuerte, limpieza eficaz, 4000Pa* potente, ventilador de succi\u00f3n aspira todo tipo de suciedad<\/h2><p>Gracias a su potente motor sin escobillas, el robot aspirador elimina el polvo y el pelo con facilidad. Tambi\u00e9n cuenta con un tanque de agua 2 en 1 y un contenedor de polvo, que es conveniente y sin preocupaciones.<\/p><h2>Tanque de agua inteligente, control de humedad<\/h2><p>Zigzag y en forma de Y limpieza de rutas, simula limpieza manual<\/p><p>La limpieza en forma de S garantiza la m\u00e1xima eficiencia de limpieza, mientras que en forma de Y simula la limpieza manual, repetidamente de izquierda a derecha para garantizar la eliminaci\u00f3n efectiva de las manchas del piso.<\/p><p>El dep\u00f3sito de agua inteligente libera agua de manera uniforme para garantizar una humedad constante sin empapar el suelo. Hay tres configuraciones de agua diferentes para acomodar diferentes materiales de piso.<\/p><h2>Gran capacidad de bater\u00eda de 3200 mAh, bater\u00eda de larga duraci\u00f3n<\/h2><p><p><b>Bater\u00eda de gran capacidad de 3200 mAh*<\/b><\/p><p><span style='background-color: initial;'>La bater\u00eda de 3200 mAh alimenta el robot aspirador hasta 130 minutos* de limpieza en modo est\u00e1ndar<\/span><br><\/p><\/p><h2>M\u00faltiples sensores, menos golpes y obst\u00e1culos<\/h2><p>M\u00faltiples sensores permiten que el robot aspirador reconozca entornos complejos, reduciendo efectivamente la probabilidad de que se bloquee o se atasque.<\/p><h2>Con\u00e9ctese a la aplicaci\u00f3n Mi Home\/Xiaomi Home para desbloquear m\u00e1s funciones de limpieza<\/h2><p>Utilice la aplicaci\u00f3n Mi Home\/Xiaomi Home para controlar el robot aspirador de forma remota y controlar el progreso de la limpieza.<\/p><h2>Soporta actualizaciones OTA, obt\u00e9n todas las funciones m\u00e1s recientes*<\/h2><p>Las mejoras y actualizaciones de la aplicaci\u00f3n se lanzan continuamente para mejorar el rendimiento del producto y hacer que su Mi Robot Vacuum S10 sea m\u00e1s inteligente.<\/p><br><\/div><ul><li><b>Especificaciones del producto<\/b><\/li><li>N\u00famero de modelo<\/li><li>B106GL<\/li><li>Dimensiones de la unidad principal<\/li><li>350x94.5mm<\/li><li>Potencia nominal<\/li><li>45W<\/li><li>Tensi\u00f3n nominal<\/li><li>14,8 V&#9107;<\/li><li>Voltaje de carga<\/li><li>20V&#9107;<\/li><li>Peso neto<\/li><li>3,6 kg<\/li><li><b>Contenidos del paquete<\/b><\/li><li>Unidad principal x1<\/li><li>Cepillo principal x1(Pre instalado)<\/li><li>Tanque de agua 2 en 1 y contenedor de polvo x1<\/li><li>Cepillo lateral x1<\/li><li>Cubierta de cepillo x1(Pre instalado)<\/li><li>Almohadilla x1<\/li><li>Marco de fregona x1<\/li><li>Adaptador de corriente x1<\/li><li>Base de carga x1<\/li><li>Cepillo de limpieza x1(Abrir la tapa para acceder)<\/li><li>Manual de usuario x1<\/li><\/ul><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-robot%20vacuum%20s10_1.jpg","wholesale_price":"173.25","unit_price_tax":178.25},"product_model":{"product_data":{"ean13":["6934177781926"],"reference":"BHR5988EU","name":{"1":"Robot Aspirador Xiaomi Robot Vacuum S10\/ Friegasuelos\/ Autonom\u00eda 130 Min\/ control por WiFi\/ Blanco","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Robot Aspirador Xiaomi S10<\/h2><div><h2>Navegaci\u00f3n l\u00e1ser, detecta con precisi\u00f3n el entorno<\/h2><p><b>Aspira el suelo sin perderse<\/b><\/p><p>Xiaomi Robot Vacuum S10 est\u00e1 equipado con tecnolog\u00eda de navegaci\u00f3n l\u00e1ser, que puede lograr un escaneo de 360\u00b0, identificar r\u00e1pidamente el entorno del hogar y crear un mapa del hogar preciso.<\/p><h2>Sensor LDS elevado con rango de detecci\u00f3n de 360 &#8203;&#8203;grados<\/h2><p>El robot cuenta con un sensor de distancia l\u00e1ser de \u00faltima generaci\u00f3n que permite un posicionamiento preciso, mediciones de distancia precisas y un mejor rendimiento.<\/p><h2>Funciones de mapeo personalizadas, limpia como quieras<\/h2><p>Con\u00e9ctese a la aplicaci\u00f3n Mi Home\/Xiaomi Home para generar mapas precisos y personalizar su programa de limpieza para lograr la m\u00e1xima eficiencia.<\/p><h2>Succi\u00f3n fuerte, limpieza eficaz, 4000Pa* potente, ventilador de succi\u00f3n aspira todo tipo de suciedad<\/h2><p>Gracias a su potente motor sin escobillas, el robot aspirador elimina el polvo y el pelo con facilidad. Tambi\u00e9n cuenta con un tanque de agua 2 en 1 y un contenedor de polvo, que es conveniente y sin preocupaciones.<\/p><h2>Tanque de agua inteligente, control de humedad<\/h2><p>Zigzag y en forma de Y limpieza de rutas, simula limpieza manual<\/p><p>La limpieza en forma de S garantiza la m\u00e1xima eficiencia de limpieza, mientras que en forma de Y simula la limpieza manual, repetidamente de izquierda a derecha para garantizar la eliminaci\u00f3n efectiva de las manchas del piso.<\/p><p>El dep\u00f3sito de agua inteligente libera agua de manera uniforme para garantizar una humedad constante sin empapar el suelo. Hay tres configuraciones de agua diferentes para acomodar diferentes materiales de piso.<\/p><h2>Gran capacidad de bater\u00eda de 3200 mAh, bater\u00eda de larga duraci\u00f3n<\/h2><p><p><b>Bater\u00eda de gran capacidad de 3200 mAh*<\/b><\/p><p><span style='background-color: initial;'>La bater\u00eda de 3200 mAh alimenta el robot aspirador hasta 130 minutos* de limpieza en modo est\u00e1ndar<\/span><br><\/p><\/p><h2>M\u00faltiples sensores, menos golpes y obst\u00e1culos<\/h2><p>M\u00faltiples sensores permiten que el robot aspirador reconozca entornos complejos, reduciendo efectivamente la probabilidad de que se bloquee o se atasque.<\/p><h2>Con\u00e9ctese a la aplicaci\u00f3n Mi Home\/Xiaomi Home para desbloquear m\u00e1s funciones de limpieza<\/h2><p>Utilice la aplicaci\u00f3n Mi Home\/Xiaomi Home para controlar el robot aspirador de forma remota y controlar el progreso de la limpieza.<\/p><h2>Soporta actualizaciones OTA, obt\u00e9n todas las funciones m\u00e1s recientes*<\/h2><p>Las mejoras y actualizaciones de la aplicaci\u00f3n se lanzan continuamente para mejorar el rendimiento del producto y hacer que su Mi Robot Vacuum S10 sea m\u00e1s inteligente.<\/p><br><\/div><ul><li><b>Especificaciones del producto<\/b><\/li><li>N\u00famero de modelo<\/li><li>B106GL<\/li><li>Dimensiones de la unidad principal<\/li><li>350x94.5mm<\/li><li>Potencia nominal<\/li><li>45W<\/li><li>Tensi\u00f3n nominal<\/li><li>14,8 V&#9107;<\/li><li>Voltaje de carga<\/li><li>20V&#9107;<\/li><li>Peso neto<\/li><li>3,6 kg<\/li><li><b>Contenidos del paquete<\/b><\/li><li>Unidad principal x1<\/li><li>Cepillo principal x1(Pre instalado)<\/li><li>Tanque de agua 2 en 1 y contenedor de polvo x1<\/li><li>Cepillo lateral x1<\/li><li>Cubierta de cepillo x1(Pre instalado)<\/li><li>Almohadilla x1<\/li><li>Marco de fregona x1<\/li><li>Adaptador de corriente x1<\/li><li>Base de carga x1<\/li><li>Cepillo de limpieza x1(Abrir la tapa para acceder)<\/li><li>Manual de usuario x1<\/li><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":178.25,"unit_price_tax":178.25,"tax_rules_group":null,"category":"Limpieza de Hogar","sub_category":"Robots Aspirador","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-robot%20vacuum%20s10_1.jpg"],"wholesale_price":173.25}}},"6934177794025":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6934177794025",false],"wholesale_price":[281.09,false],"price":[286.09,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:135458","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3009794bc73787bc83eaf9a4b1fb2825.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Robot Aspirador Xiaomi Vacuum S10+\/ Friegasuelos\/ Autonom\u00eda 120 Min\/ control por WiFi","category":"Limpieza de Hogar","sub_category":"Robots Aspirador","unit_price":286.09,"reference":"BHR6368EU","ean13":"6934177794025","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"                                                <p><h2>Robot Aspirador S10 Plus<\/h2>Limpieza a presi\u00f3n de doble almohadilla para una mejor eliminaci\u00f3n de manchas<br><\/p><h2>Potente ventilador de succi\u00f3n de 4000 Pa<\/h2><h2>Aspira el polvo y la suciedad de una sola vez<\/h2>La potencia de succi\u00f3n del ventilador m\u00e1s fuerte le permite limpiar su hogar de manera m\u00e1s eficiente. Con la potencia de succi\u00f3n del ventilador de 4000 Pa, sus necesidades diarias de limpieza se pueden satisfacer f\u00e1cilmente. Las 4 configuraciones de potencia de succi\u00f3n le permiten eliminar el polvo, el cabello y las part\u00edculas grandes de una sola vez.<br><br><b>4 velocidades<\/b><br>ajuste del modo de succi\u00f3n<br><br><b>450ml<\/b><br>dep\u00f3sito de gran capacidad<br><br><h2>Hasta 2 horas de duraci\u00f3n de la bater\u00eda<\/h2>Capacidad nominal de la bater\u00eda de 5200 mAh. Dura hasta 2 horas en\u00a0 la configuraci\u00f3n silenciosa en el modo de limpieza, ofreci\u00e9ndote una mayor tranquilidad. El robot es capaz de limpiar m\u00e1s de 200&#13217;<br><br><h2>Limpieza a presi\u00f3n con humedad constante<\/h2>Elimina eficazmente las manchas, 4 veces m\u00e1s poder de limpieza<br>Las almohadillas dobles para trapeador giran a alta velocidad para simular el efecto del trapeador manual a presi\u00f3n, lo que <br>mejora en gran medida el poder de limpieza y elimina eficazmente las manchas h\u00famedas, secas y de otro tipo<br><br><h2>Mopas compuestas de doble capa Fuerte absorci\u00f3n de agua y eliminaci\u00f3n efectiva de manchas eliminaci\u00f3n efectiva de manchas<\/h2>Las mopas hechas de telas tejidas (80% poli\u00e9ster + 20% fibra de polipropileno modificado) retienen la humedad de manera uniforme.<br>El potente rendimiento de limpieza elimina eficazmente las manchas del piso al trapear y puede proteger eficazmente las superficies del piso en toda la casa<br><br>\u00a0<br><h2>Tanque de agua de control electr\u00f3nico inteligente de gran capacidad de limpieza pisos hasta 150&#13217; en una sola pasada<\/h2>El tanque de agua con control electr\u00f3nico inteligente con capacidad aumentada de 200 ml libera agua de manera uniforme sin fugas.<br><br>Limpieza con humedad constante durante hasta 80 minutos, suficiente para satisfacer las necesidades de limpieza de pisos de un hogar de 150 &#13217;\u00a0 en una sola pasada<br><br><h2>Identificaci\u00f3n del borde de la alfombra<\/h2><h2>Para evitar montar la alfombra al trapear<\/h2>Cuando el robot funciona en el modo Mopping el robot evitar\u00e1 autom\u00e1ticamente la alfombra para que las almohadillas de la mopa no la empapen<br><h2>Detecci\u00f3n de obst\u00e1culos en 3D<\/h2><h2>Menos colisiones incluso en entornos con poca luz<\/h2>Identificaci\u00f3n de obst\u00e1culos a nivel milim\u00e9trico.<br><br><h2>Navegaci\u00f3n l\u00e1ser con escaneo de toda la casa<\/h2><h2>Planifique con precisi\u00f3n las rutas de limpieza<\/h2>Con la ayuda del l\u00e1ser de doble l\u00ednea y LDS LIDAR, el robot puede realizar un escaneo de 360\u00b0 de las habitaciones y crear r\u00e1pidamente un mapa, independientemente de las condiciones de iluminaci\u00f3n de la habitaci\u00f3n, y luego planificar con precisi\u00f3n la ruta de limpieza sin omisiones ni errores<br><br><h2>Certificaci\u00f3n est\u00e1ndar de protecci\u00f3n de privacidad y ciberseguridad de T\u00dcV Rheinland<\/h2><div><br><\/div><p><\/p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>350\u00d7350\u00d797mm<\/li>  <li>Potencia nominal<\/li>  <li>55W<\/li>  <li>Tiempo de carga<\/li>  <li>Aprox. 6 horas<\/li>  <li>Peso neto (con accesorios)<\/li>  <li>4,4 kg<\/li>  <li>Peso Neto (Robot Aspirador)<\/li>  <li>3,8 kg<\/li>  <li>Bater\u00eda<\/li>  <li>4800 mAh (capacidad nominal)<\/li>  <li>5200 mAh (capacidad nominal)<\/li>  <li>Voltaje nominal<\/li>  <li>&#9107; 14.4 V<\/li>  <li><b>Especificaciones de la base de carga<\/b><\/li>  <li>Dimensiones del art\u00edculo: 93mmx126x130<\/li>  <li>Entrada nominal: V~50\/60 HZ 0,5 A 100-240<\/li>  <li>Salida nominal: 19,8 V&#9107;1 A<\/li>  <li><b>Contenidos del paquete<\/b><\/li>  <ul>    <li>Aspiradora rob\u00f3tica \u00d7 1<\/li>    <li>Brush\u00d71<\/li>    <li>Cubierta de cepillo \u00d7 1<\/li>    <li>Compartimiento de polvo \u00d7 1<\/li>    <li>Tanque de agua \u00d7 1<\/li>    <li>Cepillo lateral \u00d7 1<\/li>    <li>Herramienta de limpieza \u00d7 1<\/li>    <li>Cable de alimentaci\u00f3n \u00d7 1<\/li>    <li>Mop Pad \u00d7 2 (preinstalado)<\/li>    <li>Soporte del limpiador \u00d7 2<\/li>    <li>Base de carga \u00d7 1<\/li>  <\/ul>  <li><b>Sensor de ca\u00edda<\/b><\/li>  <li>Se utiliza para detectar pasos y ca\u00eddas<\/li>  <li>El robot retroceder\u00e1 cuando el sensor detecte una ca\u00edda en la altura con respecto a los medios t\u00edpicos de aproximadamente 85 mm (blanco) o 15 mm (negro)<\/li>  <li><b>Sensor ultras\u00f3nico<\/b><\/li>  <li>Se utiliza para identificar el material de la alfombra<\/li>  <li><b>Sensor l\u00e1ser LDS<\/b><\/li>  <li>Utilizado en la formaci\u00f3n de im\u00e1genes<\/li>  <li>El modelo en uso es el D2M, las distancias de medici\u00f3n correspondientes son Blanco: 0,15&#8211;8 m y Negro: 0,15&#8211;4 m<\/li>  <li><b>Sensor l\u00e1ser de l\u00ednea<\/b><\/li>  <li>Se utiliza para detectar peque\u00f1os obst\u00e1culos<\/li>  <li>El l\u00e1ser puede alcanzar 50&#8211;400 mm en l\u00ednea recta<\/li>  <li><b>IA Sensor de identificaci\u00f3n visual<\/b><\/li>  <li>Se utiliza para detectar ciertos obst\u00e1culos y muebles<\/li>  <li><b>Sensor de borde extendido<\/b><\/li>  <li>Usado a lo largo de la pared<\/li>  <li><b>Sensor IMU<\/b><\/li>  <li>Detecci\u00f3n de estado de movimiento de vac\u00edo de robot<\/li>  <li>El movimiento se puede detectar en las siguientes \u00e1reas: rangos de aceleraci\u00f3n de \u00b1 2 g\/\u00b1 4 g\/\u00b1 8 g\/\u00b1 16 g, rangos de giroscopio de \u00b1 125 \u00b0\/s a \u00b1 200 \u00b0\/s<\/li>  <li><b>Sensor de elevaci\u00f3n de la rueda motriz<\/b><\/li>  <li>Se utiliza para detectar si la rueda motriz no toca el suelo<\/li>  <li>Detecta si las ruedas est\u00e1n levantadas y activa la rueda motriz para que se detenga si se levanta en movimiento<\/li>  <li><b>Sensor de presi\u00f3n de aire\u00a0<\/b><\/li><li>Prueba de capacidad de recolecci\u00f3n de polvo y conductos bloqueados<\/li><\/ul><p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-robot%20vacuum%20s10p_1.jpg","wholesale_price":"281.09","unit_price_tax":286.09},"product_model":{"product_data":{"ean13":["6934177794025"],"reference":"BHR6368EU","name":{"1":"Robot Aspirador Xiaomi Vacuum S10+\/ Friegasuelos\/ Autonom\u00eda 120 Min\/ control por WiFi","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Robot Aspirador S10 Plus<\/h2>Limpieza a presi\u00f3n de doble almohadilla para una mejor eliminaci\u00f3n de manchas<br><\/p><h2>Potente ventilador de succi\u00f3n de 4000 Pa<\/h2><h2>Aspira el polvo y la suciedad de una sola vez<\/h2>La potencia de succi\u00f3n del ventilador m\u00e1s fuerte le permite limpiar su hogar de manera m\u00e1s eficiente. Con la potencia de succi\u00f3n del ventilador de 4000 Pa, sus necesidades diarias de limpieza se pueden satisfacer f\u00e1cilmente. Las 4 configuraciones de potencia de succi\u00f3n le permiten eliminar el polvo, el cabello y las part\u00edculas grandes de una sola vez.<br><br><b>4 velocidades<\/b><br>ajuste del modo de succi\u00f3n<br><br><b>450ml<\/b><br>dep\u00f3sito de gran capacidad<br><br><h2>Hasta 2 horas de duraci\u00f3n de la bater\u00eda<\/h2>Capacidad nominal de la bater\u00eda de 5200 mAh. Dura hasta 2 horas en\u00a0 la configuraci\u00f3n silenciosa en el modo de limpieza, ofreci\u00e9ndote una mayor tranquilidad. El robot es capaz de limpiar m\u00e1s de 200&#13217;<br><br><h2>Limpieza a presi\u00f3n con humedad constante<\/h2>Elimina eficazmente las manchas, 4 veces m\u00e1s poder de limpieza<br>Las almohadillas dobles para trapeador giran a alta velocidad para simular el efecto del trapeador manual a presi\u00f3n, lo que <br>mejora en gran medida el poder de limpieza y elimina eficazmente las manchas h\u00famedas, secas y de otro tipo<br><br><h2>Mopas compuestas de doble capa Fuerte absorci\u00f3n de agua y eliminaci\u00f3n efectiva de manchas eliminaci\u00f3n efectiva de manchas<\/h2>Las mopas hechas de telas tejidas (80% poli\u00e9ster + 20% fibra de polipropileno modificado) retienen la humedad de manera uniforme.<br>El potente rendimiento de limpieza elimina eficazmente las manchas del piso al trapear y puede proteger eficazmente las superficies del piso en toda la casa<br><br>\u00a0<br><h2>Tanque de agua de control electr\u00f3nico inteligente de gran capacidad de limpieza pisos hasta 150&#13217; en una sola pasada<\/h2>El tanque de agua con control electr\u00f3nico inteligente con capacidad aumentada de 200 ml libera agua de manera uniforme sin fugas.<br><br>Limpieza con humedad constante durante hasta 80 minutos, suficiente para satisfacer las necesidades de limpieza de pisos de un hogar de 150 &#13217;\u00a0 en una sola pasada<br><br><h2>Identificaci\u00f3n del borde de la alfombra<\/h2><h2>Para evitar montar la alfombra al trapear<\/h2>Cuando el robot funciona en el modo Mopping el robot evitar\u00e1 autom\u00e1ticamente la alfombra para que las almohadillas de la mopa no la empapen<br><h2>Detecci\u00f3n de obst\u00e1culos en 3D<\/h2><h2>Menos colisiones incluso en entornos con poca luz<\/h2>Identificaci\u00f3n de obst\u00e1culos a nivel milim\u00e9trico.<br><br><h2>Navegaci\u00f3n l\u00e1ser con escaneo de toda la casa<\/h2><h2>Planifique con precisi\u00f3n las rutas de limpieza<\/h2>Con la ayuda del l\u00e1ser de doble l\u00ednea y LDS LIDAR, el robot puede realizar un escaneo de 360\u00b0 de las habitaciones y crear r\u00e1pidamente un mapa, independientemente de las condiciones de iluminaci\u00f3n de la habitaci\u00f3n, y luego planificar con precisi\u00f3n la ruta de limpieza sin omisiones ni errores<br><br><h2>Certificaci\u00f3n est\u00e1ndar de protecci\u00f3n de privacidad y ciberseguridad de T\u00dcV Rheinland<\/h2><div><br><\/div><p><\/p><ul>  <li><b>Especificaciones<\/b>  <\/li><li>350\u00d7350\u00d797mm<\/li>  <li>Potencia nominal<\/li>  <li>55W<\/li>  <li>Tiempo de carga<\/li>  <li>Aprox. 6 horas<\/li>  <li>Peso neto (con accesorios)<\/li>  <li>4,4 kg<\/li>  <li>Peso Neto (Robot Aspirador)<\/li>  <li>3,8 kg<\/li>  <li>Bater\u00eda<\/li>  <li>4800 mAh (capacidad nominal)<\/li>  <li>5200 mAh (capacidad nominal)<\/li>  <li>Voltaje nominal<\/li>  <li>&#9107; 14.4 V<\/li>  <li><b>Especificaciones de la base de carga<\/b><\/li>  <li>Dimensiones del art\u00edculo: 93mmx126x130<\/li>  <li>Entrada nominal: V~50\/60 HZ 0,5 A 100-240<\/li>  <li>Salida nominal: 19,8 V&#9107;1 A<\/li>  <li><b>Contenidos del paquete<\/b><\/li>  <ul>    <li>Aspiradora rob\u00f3tica \u00d7 1<\/li>    <li>Brush\u00d71<\/li>    <li>Cubierta de cepillo \u00d7 1<\/li>    <li>Compartimiento de polvo \u00d7 1<\/li>    <li>Tanque de agua \u00d7 1<\/li>    <li>Cepillo lateral \u00d7 1<\/li>    <li>Herramienta de limpieza \u00d7 1<\/li>    <li>Cable de alimentaci\u00f3n \u00d7 1<\/li>    <li>Mop Pad \u00d7 2 (preinstalado)<\/li>    <li>Soporte del limpiador \u00d7 2<\/li>    <li>Base de carga \u00d7 1<\/li>  <\/ul>  <li><b>Sensor de ca\u00edda<\/b><\/li>  <li>Se utiliza para detectar pasos y ca\u00eddas<\/li>  <li>El robot retroceder\u00e1 cuando el sensor detecte una ca\u00edda en la altura con respecto a los medios t\u00edpicos de aproximadamente 85 mm (blanco) o 15 mm (negro)<\/li>  <li><b>Sensor ultras\u00f3nico<\/b><\/li>  <li>Se utiliza para identificar el material de la alfombra<\/li>  <li><b>Sensor l\u00e1ser LDS<\/b><\/li>  <li>Utilizado en la formaci\u00f3n de im\u00e1genes<\/li>  <li>El modelo en uso es el D2M, las distancias de medici\u00f3n correspondientes son Blanco: 0,15&#8211;8 m y Negro: 0,15&#8211;4 m<\/li>  <li><b>Sensor l\u00e1ser de l\u00ednea<\/b><\/li>  <li>Se utiliza para detectar peque\u00f1os obst\u00e1culos<\/li>  <li>El l\u00e1ser puede alcanzar 50&#8211;400 mm en l\u00ednea recta<\/li>  <li><b>IA Sensor de identificaci\u00f3n visual<\/b><\/li>  <li>Se utiliza para detectar ciertos obst\u00e1culos y muebles<\/li>  <li><b>Sensor de borde extendido<\/b><\/li>  <li>Usado a lo largo de la pared<\/li>  <li><b>Sensor IMU<\/b><\/li>  <li>Detecci\u00f3n de estado de movimiento de vac\u00edo de robot<\/li>  <li>El movimiento se puede detectar en las siguientes \u00e1reas: rangos de aceleraci\u00f3n de \u00b1 2 g\/\u00b1 4 g\/\u00b1 8 g\/\u00b1 16 g, rangos de giroscopio de \u00b1 125 \u00b0\/s a \u00b1 200 \u00b0\/s<\/li>  <li><b>Sensor de elevaci\u00f3n de la rueda motriz<\/b><\/li>  <li>Se utiliza para detectar si la rueda motriz no toca el suelo<\/li>  <li>Detecta si las ruedas est\u00e1n levantadas y activa la rueda motriz para que se detenga si se levanta en movimiento<\/li>  <li><b>Sensor de presi\u00f3n de aire\u00a0<\/b><\/li><li>Prueba de capacidad de recolecci\u00f3n de polvo y conductos bloqueados<\/li><\/ul><p><\/p>               