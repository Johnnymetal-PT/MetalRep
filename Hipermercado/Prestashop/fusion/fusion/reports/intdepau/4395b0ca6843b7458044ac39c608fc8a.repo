6 \u00b115%&#937;<\/li><li>Sensibilidad (dB \/ mW) 103 dB\/mW (a 500 kHz)<\/li><li>Entrada m\u00e1x. (mW) 1000 mW (IEC*)<\/li><li>Respuesta de Frecuencia (Hz-kHz) 10 Hz - 23 kHz<\/li><li>Longitud del cable (m) 1,2 m (118,87 cm)<\/li><li>Peso (g) sin cable 138 g netos, 113 g sin cable<\/li><li>Miniclavija (3,5 mm de di\u00e1metro) S\u00ed<\/li><li>Clavija (Ni: N\u00edquel\/G: Oro) N\u00edquel<\/li><li>Control\/micr\u00f3fono S\u00ed<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PANASONIC","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":22.65,"unit_price_tax":22.65,"tax_rules_group":null,"category":"Auriculares","sub_category":"Auriculares","quantity":0,"brand":"PANASONIC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pan-aur%20rp-hf100me%20bk_1.jpg"],"wholesale_price":17.65}}},"5025232851027":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5025232851027",false],"wholesale_price":[17.65,false],"price":[22.65,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:212700","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8fa59b2cac307d32ddd44938a6515802.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Panasonic RP-HF100ME\/ con Micr\u00f3fono\/ Jack 3.5\/ Blancos","category":"Auriculares","sub_category":"Aur