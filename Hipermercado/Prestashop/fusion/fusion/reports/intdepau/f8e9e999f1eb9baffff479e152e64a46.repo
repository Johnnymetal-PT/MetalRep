e":"6321BS","ean13":"8436609913274","weight":"0.5","quantity":0,"brand":"SPC","description_pt":"<h2>Video Doorbell<\/h2><h2>Especificaicones<\/h2><ul>  <li><b>Caracter\u00edsticas generales:<\/b> Full HD 1080p<\/li>  <li><b>Resoluci\u00f3n:<\/b> 1920 x 1080<\/li>  <li><b>Campo de visi\u00f3n:<\/b> 160\u00b0<\/li>  <li><b>Funciones:<\/b> Grabaci\u00f3n de v\u00eddeo, audio bidireccional<\/li>  <li><b>Visi\u00f3n nocturna:<\/b> IR hasta 5 metros<\/li>  <li><b>Detecci\u00f3n de movimiento:<\/b> S\u00ed<\/li>  <li><b>Bater\u00eda recargable:<\/b> 5200 mAh<\/li>  <li><b>Opciones de alimentaci\u00f3n:<\/b> DC 5V 1A y AC 12V - 24V<\/li>  <li><b>Autonom\u00eda:<\/b> Aprox. 3 meses con una media de 10 detecciones\/d\u00eda<\/li>  <li><b>Timbre:<\/b> Alimentaci\u00f3n AC 100 - 240V, volumen ajustable, variedad de melod\u00edas<\/li>  <li><b>Conectividad:<\/b> Wi-Fi 4 (b\/g\/n)<\/li>  <li><b>Almacenamiento:<\/b> Hasta 128 GB por microSD (incluye tarjeta de 32 GB preinstalada)<\/li>  <li><b>Dimensiones:<\/b> 56 x 39 x 135 mm<\/li>  <li><b>Peso:<\/b> 212 g<\/li>  <li><b>Contenido del paquete:<\/b> Video Doorbell y timbre avisador, cable USB y gu\u00eda r\u00e1pida<\/li><\/ul>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-videoport%20video%20dbell_1.jpg","wholesale_price":"89.74","unit_price_tax":96.74},"product_model":{"product_data":{"ean13":["8436609913274"],"reference":"6321BS","name":{"1":"Videoportero Inteligente SPC Video Doorbell","2":"","3":"","4":""},"description":{"1":"<h2>Video Doorbell<\/h2><h2>Especificaicones<\/h2><ul>  <li><b>Caracter\u00edsticas generales:<\/b> Full HD 1080p<\/li>  <li><b>Resoluci\u00f3n:<\/b> 1920 x 1080<\/li>  <li><b>Campo de visi\u00f3n:<\/b> 160\u00b0<\/li>  <li><b>Funciones:<\/b> Grabaci\u00f3n de v\u00eddeo, audio bidireccional<\/li>  <li><b>Visi\u00f3n nocturna:<\/b> IR hasta 5 metros<\/li>  <li><b>Detecci\u00f3n de movimiento:<\/b> S\u00ed<\/li>  <li><b>Bater\u00eda recargable:<\/b> 5200 mAh<\/li>  <li><b>Opciones de alimentaci\u00f3n:<\/b> DC 5V 1A y AC 12V - 24V<\/li>  <li><b>Autonom\u00eda:<\/b> Aprox. 3 meses con una media de 10 detecciones\/d\u00eda<\/li>  <li><b>Timbre:<\/b> Alimentaci\u00f3n AC 100 - 240V, volumen ajustable, variedad de melod\u00edas<\/li>  <li><b>Conectividad:<\/b> Wi-Fi 4 (b\/g\/n)<\/li>  <li><b>Almacenamiento:<\/b> Hasta 128 GB por microSD (incluye tarjeta de 32 GB preinstalada)<\/li>  <li><b>Dimensiones:<\/b> 56 x 39 x 135 mm<\/li>  <li><b>Peso:<\/b> 212 g<\/li>  <li><b>Contenido del paquete:<\/b> Video Doorbell y timbre avisador, cable USB y gu\u00eda r\u00e1pida<\/li><\/ul>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SPC","supplier":null,"width":null,"height":null,"depth":null,"weight":0.5,"unit_price":96.74,"unit_price_tax":96.74,"tax_rules_group":null,"category":"Material Electrico","sub_category":"Videoporteros","quantity":0,"brand":"SPC","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_spc-videoport%20video%20dbell_1.jpg"],"wholesale_price":89.74}}},"6941812792261":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812792261",false],"wholesale_price":[76.09,false],"price":[83.09,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:273021","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/658fc05dd119003f4b52b34f56a44221.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Olla El\u00e9ctrica Xiaomi Electric Pressure Cooker 4.8L\/ 1000W","category":"Menaje de Hogar","sub_category":"Ollas Express","unit_price":83.09,"reference":"ELEC PRES COOK 4 8L","ean13":"6941812792261","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"<p><h2>Xiaomi Electric Pressure Cooker 4.8L<\/h2><p><ul><li>Ollas dobles para m\u00faltiples platos en una sola olla<\/li><li>Gran capacidad de 4,8 l<\/li><li><span style='background-color: initial;'>Dos ollas para diferentes platos.<\/span><\/li><li><span style='background-color: initial;'>8 protecciones de seguridad<\/span><\/li><li><span style='background-color: initial;'>Macetas interiores de 5 capas de espesor<\/span><\/li><li><span style='background-color: initial;'>6 modos de cocci\u00f3n<\/span><\/li><li><span style='background-color: initial;'>Control sobre un amplio rango de temperaturas<\/span><\/li><li><span style='background-color: initial;'>7 niveles de ajuste de textura de alimentos<\/span><\/li><li>Temporizador inteligente preestablecido de 24 horas<\/li><\/ul><\/p><\/p><p><h2>Perfecto para guisos, estofados, guisados &#8203;&#8203;y hervidos.<\/h2><p>Un experto en cocina multifuncional. Ya sea para guisar, estofar, guisar o hervir, prepara platos deliciosos.<\/p><h2>7 niveles de ajuste para un control inteligente de la presi\u00f3n para producir una textura masticable, media o tierna seg\u00fan sus preferencias.<\/h2><p>3 niveles con 7 niveles de ajuste que corresponden a diferentes temperaturas y tiempos de presi\u00f3n. Se pueden lograr tres texturas de alimentos: masticable, mediana o tierna, para que puedas personalizar la textura de tus alimentos seg\u00fan tus preferencias.<\/p><h2>Las ollas interiores de gran capacidad de 4,8 L son ideales para toda la familia.<\/h2><p>Con dos ollas interiores de gran capacidad de 4,8 L, es perfecto para familias numerosas.<\/p><h2>Ollas dobles para platos separados, cocci\u00f3n y servicio r\u00e1pidos.<\/h2><p>Alterne entre dos ollas interiores para separar los sabores. Despu\u00e9s de cocinar el arroz, intercambie las ollas interiores para preparar r\u00e1pidamente otros platos con el modo de cocci\u00f3n r\u00e1pida para lotes peque\u00f1os.<\/p><h2>El control sobre un amplio rango de temperatura ampl\u00eda las deliciosas posibilidades de comidas.<\/h2><p>Varias opciones, que incluyen guisos a baja temperatura, estofados con tapa abierta a presi\u00f3n constante y estofados r\u00e1pidos a alta presi\u00f3n, se adaptan a diversos escenarios de cocci\u00f3n y abren la puerta a una amplia variedad de platos.<\/p><h2>Temporizador inteligente preestablecido de 24 horas para horarios de comida flexibles sin largas esperas<\/h2><p>Con la funci\u00f3n de temporizador preestablecido extra largo de 24 horas, coloque los ingredientes en la olla antes de acostarse y despi\u00e9rtese con un congee fragante y cremoso.<\/p><h2>El revestimiento de 5 capas es antiadherente y se calienta de manera uniforme.<\/h2><p>Incluye dos ollas interiores con cinco capas de revestimiento para una excelente conductividad t\u00e9rmica. Resistente y f\u00e1cil de limpiar; el arroz no se pega f\u00e1cilmente y los residuos de la sopa hirviendo se limpian f\u00e1cilmente.<\/p><h2>El acero s\u00f3lido reforzado de 1,2 mm lo hace resistente a altas presiones.<\/h2><p>La cubierta superior est\u00e1 fabricada en acero inoxidable 304 reforzado de 1,2 mm apto para contacto con alimentos y pesa aproximadamente 1,5 kg. Es robusta, segura y fiable.<\/p><h2>8 medidas de seguridad para cocinar sin preocupaciones<\/h2><p>M\u00faltiples medidas de seguridad dise\u00f1adas para detectar y protegerlo autom\u00e1ticamente de la alta presi\u00f3n y temperatura para garantizar un uso seguro.<\/p><p><ul><li>La junta extra\u00edble permite una limpieza a fondo.<\/li><li><span style='background-color: initial;'>El interruptor de liberaci\u00f3n de presi\u00f3n manual ubicado lejos de las salidas de vapor evita quemaduras.<\/span><\/li><li><span style='background-color: initial;'>Cubierta superior de acero inoxidable 304 resistente, duradera y f\u00e1cil de limpiar<\/span><\/li><\/ul><\/p><br><\/p><p><h2><span style='background-color: initial;'>Especificaciones<\/span><\/h2><p><ul><li><span style='background-color: initial;'><b>Nombre<\/b><\/span><\/li><li>Olla a presi\u00f3n el\u00e9ctrica<\/li><li><b>Modelo<\/b><\/li><li>MYL02-1<\/li><li><b>Capacidad<\/b><\/li><li>4.8L<\/li><li><b>Potencia nominal de entrada<\/b><\/li><li>1000W<\/li><li><b>Voltaje nominal<\/b><\/li><li>220-240 V~<\/li><li><b>Frecuencia nominal<\/b><\/li><li>50\/60 Hz<\/li><li><b>Presi\u00f3n nominal<\/b><\/li><li>70 kPa<\/li><li><b>M\u00e9todo de calentamiento<\/b><\/li><li>Calefacci\u00f3n el\u00e9ctrica<\/li><li><b>Peso neto<\/b><\/li><li>5,3 kg<\/li><li><b>Dimensiones del art\u00edculo<\/b><\/li><li>296 x 347 x 288 mm<\/li><li><b>Capacidad utilizable<\/b><\/li><li>Capacidad 2\/3<\/li><li><b>Contenido del paquete<\/b><\/li><li>Paleta de arroz x1<\/li><li>Paleta de congee<\/li><li>Taza medidora<\/li><li>Olla interior negra<\/li><li>Olla interior dorada<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-olla%20elec%20pres%20cook%204%208l_1.jpg","wholesale_price":"76.09","unit_price_tax":83.09},"product_model":{"product_data":{"ean13":["6941812792261"],"reference":"ELEC PRES COOK 4 8L","name":{"1":"Olla El\u00e9ctrica Xiaomi Electric Pressure Cooker 4.8L\/ 1000W","2":"","3":"","4":""},"description":{"1":"<p><h2>Xiaomi Electric Pressure Cooker 4.8L<\/h2><p><ul><li>Ollas dobles para m\u00faltiples platos en una sola olla<\/li><li>Gran capacidad de 4,8 l<\/li><li><span style='background-color: initial;'>Dos ollas para diferentes platos.<\/span><\/li><li><span style='background-color: initial;'>8 protecciones de seguridad<\/span><\/li><li><span style='background-color: initial;'>Macetas interiores de 5 capas de espesor<\/span><\/li><li><span style='background-color: initial;'>6 modos de