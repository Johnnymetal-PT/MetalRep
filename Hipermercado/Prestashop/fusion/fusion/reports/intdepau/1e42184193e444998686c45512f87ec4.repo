00\/800\/fixed\/art_nan-cab%2010%2015%205135_1.jpg"],"wholesale_price":8.32}}},"8436586743628":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8436586743628",false],"wholesale_price":[5.37,false],"price":[12.37,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["O comprimento da propriedade Product->name \u00e9 atualmente de 136 carateres. O intervalo tem de estar entre 0 e 128 carateres. Name: Cabo USB 2.0 Tipo C Subblim Top 4 em 1\/ USB Tipo C Macho - USB Macho\/ USB Tipo C Macho - Lightning Macho\/ At\u00e9 60 W\/ 480 Mbps\/ 1 m\/ Preto"],"result":false},"feed_data":{"name_pt":"Cable USB 2.0 Tipo-C Subblim Top 4 en 1\/ USB Tipo-C Macho - USB Macho\/ USB Tipo-C Macho - Lightning Macho\/ Hasta 60W\/ 480Mbps\/ 1m\/ Negro","category":"Cables","sub_category":"Cable USB","unit_price":12.370000000000001,"reference":"SUBCAB-4IN101","ean13":"8436586743628","weight":"0","quantity":0,"brand":"SUBBLIM","description_pt":"<p><h2>CABLE TOP 4IN1 60W C-C-L-A 1m<\/h2><p>SUBBLIM TOP Cable 4 en 1 (USB-A\/C-C\/Lightning) 1 m &#8211; 60 W PD 3.0, 480 Mbps, Nylon Trenzado,&nbsp;<span style='background-color: initial;'>Carga R\u00e1pida iPhone\/Galaxy\/Pixel\/MacBook<\/span><\/p><h2>PUNTOS DESTACADOS:<\/h2><p><ul><li>4 CABLES EN 1 &#8211; Un solo cable cubre : USB-A &#10140; Lightning (12 W), USB-A &#10140; USB-C (15 W),&nbsp;<span style='background-color: initial;'>USB-C &#10140; Lightning (27 W) y USB-C &#10140; USB-C (60 W). Desp\u00eddete del l\u00edo de cables en casa, en el coche y&nbsp;<\/span><span style='background-color: initial;'>de viaje.<\/span><\/li><li>CARGA R\u00c1PIDA 60 W &#8211; PD 3.0 &amp; QC 3.0 &#8211; Hasta 20 V \/ 3 A para port\u00e1tiles ligeros, tablets y m\u00f3viles.&nbsp;<span style='background-color: initial;'>iPhone 15 Pro al 50 % en 30 min (con cargador USB-C adecuado).<\/span><\/li><li>SINCRONIZACI\u00d3N 480 Mbps &#8211; Copia 1 GB en cuesti\u00f3n de segundos entre dispositivos USB-C.<\/li><li>ULTRARRESISTENTE &#8211; Nylon trenzado + carcasa met\u00e1lica, certificado para 30 kg de tracci\u00f3n, 25 000 +&nbsp;<span style='background-color: initial;'>dobleces y 10 000 + ciclos de enchufado.<\/span><\/li><li>AMPLIA COMPATIBILIDAD &#8211; iPhone 12-16, Samsung Galaxy S8-S24, Pixel Series, iPad Pro\/Air,&nbsp;<span style='background-color: initial;'>MacBook, Huawei, Switch, AirPods, power banks y m\u00e1s.<\/span><\/li><li>LONGITUD IDEAL 1 M &#8211; Perfecto para mesa, escritorio y power bank; se recoge f\u00e1cil sin enredos.<\/li><\/ul><\/p><p><h2>Descripci\u00f3n<\/h2><p>El SUBBLIM TOP 4 in 1 combina los cuatro conectores m\u00e1s usados (USB-A, USB-C y Lightning) para que&nbsp;<span style='background-color: initial;'>cargues y sincronices pr\u00e1cticamente cualquier dispositivo actual sin cargar con varios cables.<\/span><\/p><p><ul><li>USB-C &#10140; USB-C 60 W (20 V \/ 3 A) Port\u00e1tiles ligeros, iPad Pro, Steam Deck<\/li><li>USB-C &#10140; Lightning 27 W (9 V \/ 3 A) iPhone 15\/14\/13, iPad mini<\/li><li>USB-A &#10140; USB-C 15 W (5 V \/ 3 A) Power bank, cargador coche<\/li><li>USB-A &#10140; Lightning 12 W (5 V \/ 2.4 A) Puertos USB tradicionales<\/li><\/ul><\/p><p>Carga y datos al mismo tiempo. Compatibilidad con Power Delivery 3.0 y Quick Charge 3.0 asegura carga&nbsp;<span style='background-color: initial;'>r\u00e1pida en m\u00f3viles Android y iPhone. Adem\u00e1s, la l\u00ednea de datos USB 2.0 alcanza 480 Mbps, ideal para fotos,&nbsp;<\/span><span style='background-color: initial;'>v\u00eddeos Full HD y documentos.<\/span><\/p><p><b>Dise\u00f1o preparado para el trote diario.<\/b><\/p><p><ul><li>Nylon trenzado anti-nudos y tacto premium.<\/li><li>Carcasa met\u00e1lica que protege los cabezales ante ca\u00eddas.<\/li><li>Test de 30 kg de tracci\u00f3n y 25 000 dobleces sin fallos, superando la vida \u00fatil de cables est\u00e1ndar.<\/li><li>Perfecto para viajar. Con 1 m de longitud, el SUBBLIM TOP cabe en cualquier mochila o bolsillo del&nbsp;<span style='background-color: initial;'>port\u00e1til. Es el compa\u00f1ero ideal para vuelos, hoteles o la mesa de trabajo compartida.<\/span><\/li><\/ul><\/p><\/p><h2>Especificaciones<\/h2><\/p><p><p><ul><li><b>Modelo:<\/b> SUBBLIM Cable &#8220;TOP 4 in 1&#8221;<\/li><li><b>Longitud:&nbsp;<\/b>1 m<\/li><li><b>Conectores:<\/b><\/li><li>USB-A, USB-C &#8596; USB-C, Lightning<\/li><li>Potencia m\u00e1x. (USB-C &#10140; USB-C) 60 W (20 V \/ 3 A)<\/li><li>Potencia m\u00e1x. (USB-C &#10140; Lightning) 27 W (9 V \/ 3 A)<\/li><li>Potencia m\u00e1x. (USB-A &#10140; USB-C) 15 W (5 V \/ 3 A)<\/li><li>Potencia m\u00e1x. (USB-A &#10140; Lightning) 12 W (5 V \/ 2.4 A)<\/li><li><b>Velocidad de datos:<\/b> Hasta 480 Mbps (USB 2.0)<\/li><li><b>Material exterior:<\/b>&nbsp;Nylon trenzado<\/li><li><b>Material conectores:<\/b> Aleaci\u00f3n de aluminio<\/li><li><b>Resistencia:&nbsp;<\/b><span style='background-color: initial;'>30 kg tracci\u00f3n \u00b7 25 000+&nbsp;<\/span><span style='background-color: initial;'>dobleces \u00b7 10 000+ inserciones<\/span><\/li><li><b>Compatibilidad amplia:&nbsp;<\/b><span style='background-color: initial;'>iPhone 12-16, Galaxy S8-S24, Pixel Series,&nbsp;<\/span><span style='background-color: initial;'>iPad Pro\/Air, MacBook, Huawei, Switch,&nbsp;<\/span><span style='background-color: initial;'>AirPods, etc.<\/span><\/li><li><b>Certificaciones:<\/b> CE, RoHS<\/li><li><b>Plug &amp; Play:<\/b> S\u00ed<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sub-cab%20subcab-4in101_1.jpg","wholesale_price":"5.37","unit_price_tax":12.370000000000001},"product_model":{"product_data":{"ean13":["8436586743628"],"reference":"SUBCAB-4IN101","name":{"1":"Cable USB 2.0 Tipo-C Subblim Top 4 en 1\/ USB Tipo-C Macho - USB Macho\/ USB Tipo-C Macho - Lightning Macho\/ Hasta 60W\/ 480Mbps\/ 1m\/ Negro","2":""