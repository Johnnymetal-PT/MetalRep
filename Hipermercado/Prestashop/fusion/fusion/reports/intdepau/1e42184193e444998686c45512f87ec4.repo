ly (PPS): 3'3 V CC - 21 V CC, 3A<\/li><li><span style='background-color: initial;'><b>COMPATIBILIDAD<\/b><\/span><\/li><li>Ordenadores port\u00e1tiles, smartphones y tablets con conector de carga tipo USB-C.<\/li><li><span style='background-color: initial;'><b>PROTECCIONES<\/b><\/span><\/li><li>Cortocircuito, sobrecarga y temperatura<\/li><li><b>CONECTOR<\/b><\/li><li>USB-C<\/li><li>ALIMENTACI\u00d3N<\/li><li>100 - 240 V CA ~ 50\/60 Hz, 1'8 A<\/li><li><b>MEDIDAS<\/b><\/li><li>46 x 89 x 31'5 mm fondo<\/li><li><b>PESO<\/b><\/li><li>0'11 kg<\/li><\/ul><p><\/p><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"FONESTAR","supplier":null,"width":null,"height":null,"depth":null,"weight":0.12,"unit_price":20.46,"unit_price_tax":20.46,"tax_rules_group":null,"category":"Accesorios de SmartPhones","sub_category":"Cargadores para Smartphones","quantity":5,"brand":"FONESTAR","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_fone-carga%20power-c-65_1.jpg"],"wholesale_price":13.46}}},"8433281015333":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8433281015333",false],"wholesale_price":[9.25,false],"price":[16.25,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:267828","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ec1e80331c45063e6f041e9090de6890.jpg; <br>-------------------------------"],"result":tru