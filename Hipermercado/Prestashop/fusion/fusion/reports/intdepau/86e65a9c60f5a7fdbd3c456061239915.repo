":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SIUX","supplier":null,"width":null,"height":null,"depth":null,"weight":0.37,"unit_price":81.48,"unit_price_tax":81.48,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":2,"brand":"SIUX","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_siu-pala%20pad%20sg%20cop%2018k%20ed%20s_1.jpg"],"wholesale_price":76.48}}},"0097512611329":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0097512611329",false],"wholesale_price":[94.12,false],"price":[99.12,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.43",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:182234","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2a42833ff153b07cf1107183acbb4e95.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pala de P\u00e1del Wilson Bela LT Roja","category":"PADEL","sub_category":"Padel","unit_price":99.12,"reference":"BELA LT RD","ean13":"0097512611329","weight":"0.43","quantity":2,"brand":"WILSON","description_pt":"<h2>WILSON BELA LT ROJO<\/h2><div>WILSON BELA LT ROJO - La m\u00e1s ligera de la serie, una pala potente, de forma diamante que te sorprender\u00e1 por su ligereza. Una alternativa para el jugador que busque potencia sin que su pala pese mucho.<br><\/div><div><p>La&nbsp;WILSON BELA LT ROJO&nbsp;va a ser tu nueva pala favorita de la serie Bela, un modelo m\u00e1s ligero, de unos 355 gramos aproximadamente, para satisfacer las necesidades de los que busquen potencia y ligereza.<\/p><p>Pensada para jugadores que buscan combinar potencia, control y estilo en la pista. Es ideal para jugadores sobre todo de nivel avanzado, pues es una de las palas de p\u00e1del m\u00e1s ligeras pero exigentes a la vez.<\/p><p>Es una pala de&nbsp;formato diamante, agresivo, de balance ligeramente alto,&nbsp;para jugadores que busquen alta potencia. Fabricada tambi\u00e9n como no puede ser de otro modo en fibra de carbono 100%. Este material nos da una resistencia superior, adem\u00e1s aporta m\u00e1s potencia en los golpes.<\/p><p>Tiene tecnolog\u00edas como la&nbsp;Sharp Hole, un proceso avanzado en el taladrado del perforado con el que se aumenta el punto dulce.<\/p><p>Cuenta con un grip de calidad superior, llamado&nbsp;Sublime Grip. Es un grip Premium, con micro perforaciones que mejora el agarre.<\/p><p>La goma de la&nbsp;WILSON BELA LT ROJO&nbsp;es una goma eva soft, de baja densidad y que aporta alta salida de bola.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li>Color 2 Negro, Rojo<\/li><li>Balance Alto<\/li><li>N\u00facleo Soft Eva<\/li><li>Cara Carbono<\/li><li>Formato Normal<\/li><li>Nivel de Juego Avanzado \/ Competici\u00f3n<\/li><li>Acabado Relieve 3d<\/li><li>Forma Diamante<\/li><li>Superficie Lisa<\/li><li>Jugador Hombre, Mujer<\/li><\/ul><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wil-pala%20pad%20bela%20lt%20rd_1.jpg","wholesale_price":"94.12","unit_price_tax":99.12},"product_model":{"product_data":{"ean13":["0097512611329"],"reference":"BELA LT RD","name":{"1":"Pala de P\u00e1del Wilson Bela LT Roja","2":"","3":"","4":""},"description":{"1":"<h2>WILSON BELA LT ROJO<\/h2><div>WILSON BELA LT ROJO - La m\u00e1s ligera de la serie, una pala potente, de forma diamante que te sorprender\u00e1 por su ligereza. Una alternativa para el jugador que busque potencia sin que su pala pese mucho.<br><\/div><div><p>La&nbsp;WILSON BELA LT ROJO&nbsp;va a ser tu nueva pala favorita de la serie Bela, un modelo m\u00e1s ligero, de unos 355 gramos aproximadamente, para satisfacer las necesidades de los que busquen potencia y ligereza.<\/p><p>Pensada para jugadores que buscan combinar potencia, control y estilo en la pista. Es ideal para jugadores sobre todo de nivel avanzado, pues es una de las palas de p\u00e1del m\u00e1s ligeras pero exigentes a la vez.<\/p><p>Es una pala de&nbsp;formato diamante, agresivo, de balance ligeramente alto,&nbsp;para jugadores que busquen alta potencia. Fabricada tambi\u00e9n como no puede ser de otro modo en fibra de carbono 100%. Este material nos da una resistencia superior, adem\u00e1s aporta m\u00e1s potencia en los golpes.<\/p><p>Tiene tecnolog\u00edas como la&nbsp;Sharp Hole, un proceso avanzado en el taladrado del perforado con el que se aumenta el punto dulce.<\/p><p>Cuenta con un grip de calidad superior, llamado&nbsp;Sublime Grip. Es un grip Premium, con micro perforaciones que mejora el agarre.<\/p><p>La goma de la&nbsp;WILSON BELA LT ROJO&nbsp;es una goma eva soft, de baja densidad y que aporta alta salida de bola.<\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li>Color 2 Negro, Rojo<\/li><li>Balance Alto<\/li><li>N\u00facleo Soft Eva<\/li><li>Cara Carbono<\/li><li>Formato Normal<\/li><li>Nivel de Juego Avanzado \/ Competici\u00f3n<\/li><li>Acabado Relieve 3d<\/li><li>Forma Diamante<\/li><li>Superficie Lisa<\/li><li>Jugador Hombre, Mujer<\/li><\/ul><\/p><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"WILSON","supplier":null,"width":null,"height":null,"depth":null,"weight":0.43,"unit_price":99.12,"unit_price_tax":99.12,"tax_rules_group":null,"category":"PADEL","sub_category":"Padel","quantity":2,"brand":"WILSON","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wil-pala%20pad%20bela%20lt%20rd_1.jpg"],"wholesale_price":94.12}}},"00