:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_real-sp%20c31%203-32%20gree_1.jpg"],"wholesale_price":65.11}}},"6941764426054":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941764426054",false],"wholesale_price":[122.92,false],"price":[127.92,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Realme C51 6GB\/ 256GB\/ 6,74&#39;\/ Preto"],"result":false},"feed_data":{"name_pt":"Smartphone Realme C51 6GB\/ 256GB\/ 6.74'\/ Negro","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":127.92,"reference":"C51 6-256 BK","ean13":"6941764426054","weight":"0.47","quantity":2,"brand":"REALME","description_pt":"<p><h2>C\u00c1MARA CON M\u00c1S NITIDEZ.<\/h2><h2>CARGA M\u00c1S R\u00c1PIDA.<\/h2><h2>M\u00c1S ESPACIO DE ALMACENAMIENTO.<\/h2><h2>UN CAMPE\u00d3N DE OTRO NIVEL.<\/h2><h2>ROM de 128 GB Almacenamiento mejorado<\/h2><p><br>Con la memoria ROM de 128 GB, tendr\u00e1s m\u00e1s espacio para tus fotos, v\u00eddeos, juegos y pel\u00edculas favoritos. Y gracias al almacenamiento adicional disponible, todas las tareas se ejecutar\u00e1n sin problemas en segundo plano.<\/p><h2><strong>RAM din\u00e1mica de hasta 4 GB + 4 GB Uniformidad aumentada<\/strong><\/h2><p>Ad\u00e9ntrate en un nuevo mundo de potencia con Dynamic RAM Expansion (DRE). Con 4 GB de RAM integrada y 4 GB adicionales disponibles a trav\u00e9s de la tecnolog\u00eda DRE, tendr\u00e1s a tu alcance potencia adicional cuando la necesites. Ejecuta m\u00e1s aplicaciones simult\u00e1neamente y pasa de una a otra sin ning\u00fan esfuerzo.<\/p><h2>CAMPE\u00d3N EN C\u00c1MARAS<\/h2><h2>C\u00c1MARA DE 50 MP CON IA<\/h2><h2>Dise\u00f1ada para ofrecer m\u00e1s nitidez<\/h2><p>El modo de 50 MP mejora en gran medida la nitidez y refleja detalles precisos incluso al capturar fotograf\u00edas de edificios y paisajes complejos.<\/p><h2>Modo nocturno<\/h2><p>El Modo nocturno ilumina los entornos de captura con poca luz sin sacrificar la nitidez para ofrecerte una experiencia de captura potente y fiable en la que podr\u00e1s confiar a cualquier hora del d\u00eda.<\/p><h2><strong>CAMPE\u00d3N EN CARGA<\/strong><\/h2><h2><strong>Carga SUPERVOOC de 33 W<\/strong><\/h2><h2><strong>Carga SUPERVOOC de 33 W Un 200 % m\u00e1s r\u00e1pida<\/strong><\/h2><p>La carga SUPERVOOC de 33 W incrementa la velocidad de carga en un 200 % en comparaci\u00f3n con la generaci\u00f3n anterior, de modo que podr\u00e1s cargar del 0 al 50 % en tan solo 28 minutos.<\/p><h2><strong>Gran bater\u00eda de 5000 mAh Potencia para todo el d\u00eda<\/strong><\/h2><p>Ve v\u00eddeos o juega a juegos durante todo el d\u00eda y, a\u00fan as\u00ed, te sobrar\u00e1 bater\u00eda.<\/p><h2><strong>CAMPE\u00d3N EN DISE\u00d1O<\/strong><\/h2><h2>Dise\u00f1o brillante y elegante<\/h2><h2>Proceso de polvo de vidrio brillante<\/h2><p>El proceso de polvo de vidrio brillante combina dos texturas, una brillante en la parte superior en contraste con otra que resplandece bajo la luz en la parte inferior: la uni\u00f3n perfecta para crear un efecto din\u00e1mico excepcional.<\/p><h2>Cuerpo fino. Sensaci\u00f3n liviana en la mano.<\/h2><p>Un cuerpo ultrafino de tan solo 7,99 mm se combina con un dise\u00f1o lateral de \u00e1ngulo en C para conseguir un tel\u00e9fono con un aspecto visualmente impactante y que se adapta perfectamente a la mano.<\/p><h2>Pantalla de 17,13 cm (6,74') y 90 Hz<\/h2><p>Una pantalla de gran tama\u00f1o se combina con una frecuencia de actualizaci\u00f3n ultrafluida de 90 Hz para que disfrutes de una experiencia de visualizaci\u00f3n expansiva con la que te sumergir\u00e1s de lleno en el juego.<\/p><p><strong>16,7 millones<\/strong><br>de colores de pantalla<br><strong>hasta 90 Hz<\/strong><br>Frecuencia de actualizaci\u00f3n de<br><strong>90,3 %<\/strong><br>Relaci\u00f3n pantalla-cuerpo del<\/p><h2>Minic\u00e1psula<\/h2><p>Consultar la informaci\u00f3n importante, como el estado de la bater\u00eda, el uso de datos o los pasos diarios, nunca antes hab\u00eda sido tan sencillo.<\/p><h2>Potente conjunto de chips de ocho n\u00facleos<\/h2><p>Un conjunto de chips de ocho n\u00facleos pone en tus manos un rendimiento potente y un procesamiento eficiente que te permitir\u00e1n descubrir una experiencia realmente fluida dise\u00f1ada para satisfacer todas tus necesidades.<\/p><h2><strong>Ranura para 3 tarjetas<\/strong><\/h2><h2><strong>Memoria externa de hasta 2 TB<\/strong><\/h2><p>Dos ranuras para tarjetas SIM y una ranura especial para una tarjeta micro-SD te ofrecen m\u00e1s opciones de uso para tu tel\u00e9fono.<\/p><h2>NFC de 360\u00b0<\/h2><p>Desliza sin problemas desde cualquier posici\u00f3n y \u00e1ngulo en la parte superior del tel\u00e9fono. Gracias al nuevo dise\u00f1o de la bobina y la antena m\u00f3vil, la superficie NFC es el doble de grande, de modo que podr\u00e1s deslizar con mayor eficacia.<\/p><h2>Huella digital lateral r\u00e1pida<\/h2><p>La perfecci\u00f3n en cuanto a rapidez y seguridad. Un simple toque y est\u00e1s dentro.<\/p><p><br><\/p><ul><li><strong>Procesador<\/strong><\/li><li>Potente conjunto de chips de ocho n\u00facleos<\/li><li>CPU: proceso de 12 nm, ocho n\u00facleos, hasta 1,82 GHz<\/li><li>GPU: Mal\u00ed-G57<\/li><li><strong>Almacenamiento y RAM<\/strong><\/li><li>RAM: 6GB LPDDR4X<\/li><li>ROM: 256GB<\/li><li>Hasta 2 TB de memoria externa<\/li><li><strong>Pantalla<\/strong><\/li><li>Pantalla de 17,13 cm (6,74'') y 90 Hz<\/li><li>Frecuencia de actualizaci\u00f3n: 90Hz<\/li><li>Tasa de muestreo t\u00e1ctil: 180Hz<\/li><li>Brillo m\u00e1ximo: 560nits<\/li><li>Relaci\u00f3n pantalla-cuerpo: 90,3 %<\/li><li>Tasa de muestreo t\u00e1ctil: 180Hz<\/li><li>Colores de pantalla: 16,7 millones<\/li><li><strong>C\u00e1mara<\/strong><\/li><li>C\u00e1mara con IA de 50MP<\/li><li>P\u00edxeles: 50MP<\/li><li>Lente: 5P<\/li><li>campo de visi\u00f3n: 77\u00b0<\/li><li>Apertura: f\/1.8<\/li><li>Distancia focal: 27 mm<\/li><li>Funciones de fotograf\u00eda:<\/li><li>Modo de 50MP, Video, Modo nocturno, Vista panor\u00e1mica, Experto, Lapso de tiempo, Modo de retrato, HDR, Reconocimiento de escena AI, Filtro, C\u00e1mara lenta<\/li><li>Grabaci\u00f3n de v\u00eddeo:<\/li><li>Soporta grabaci\u00f3n de video 1080P\/30fps<\/li><li>Soporta grabaci\u00f3n de video 720P\/30fps<\/li><li>Soporta grabaci\u00f3n de video 480P\/30fps<\/li><li>C\u00e1mara para selfies de 5MP<\/li><li>P\u00edxeles: 5MP<\/li><li>Lente: 3P<\/li><li>campo de visi\u00f3n: 76,8\u00b0<\/li><li>Apertura: f\/2.22<\/li><li>Funciones de fotograf\u00eda:<\/li><li>Video<\/li><li>Modo retrato<\/li><li>Modo belleza,&nbsp;<\/li><li>HDR, Reconocimiento facial, Filtro, Control de efecto Bokeh<\/li><li>Grabaci\u00f3n de v\u00eddeo:<\/li><li>Soporta grabaci\u00f3n de video 720P\/30fps<\/li><li>Soporta grabaci\u00f3n de video 480P\/30fps<\/li><li>Soporta grabaci\u00f3n de video CIF\/30fps<\/li><li><strong>Carga y Bater\u00eda<\/strong><\/li><li>Carga SUPERVOOC 33W<\/li><li>Bater\u00eda masiva de 5000 mAh (t\u00edpico)<\/li><li>Capacidad de la bater\u00eda de 4880 mAh (m\u00edn.)<\/li><li>Incluye un adaptador de carga de 11 V\/3 A.<\/li><li>Puerto USB tipo C<\/li><li><strong>Redes y Inal\u00e1mbrico<\/strong><\/li><li>Bandas de frecuencia:<\/li><li>G\/M: 850\/900\/1800\/1900 MHz<\/li><li>WCDMA: Bandas 1\/5\/8<\/li><li>FDD-LTE: Bandas 1\/3\/5\/8<\/li><li>TD-LTE: Bandas 38\/40\/41<\/li><li>Inal\u00e1mbrico:<\/li><li>WiFi de 2,4\/5 GHz<\/li><li>Bluetooth 5.0<\/li><li><strong>Tama\u00f1o y peso<\/strong><\/li><li>Longitud: 167,2 mm<\/li><li>Ancho: 76,7 mm<\/li><li>Profundidad 7,99 mm<\/li><li>Peso 186g<\/li><li><strong>Sensores<\/strong><\/li><li>Sensor de inducci\u00f3n magn\u00e9tica<\/li><li>Sensor de luz<\/li><li>Sensor de proximidad<\/li><li>girometro<\/li><li>Sensor de aceleraci\u00f3n<\/li><li>Navegaci\u00f3