\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-sp%20a556%208-128%20bl%20v2_1.jpg"],"wholesale_price":315.96}}},"6941399076860":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941399076860",false],"wholesale_price":[65.11,false],"price":[70.11,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Realme C31 3GB\/ 32GB\/ 6,5&#39;\/ Verde Escuro"],"result":false},"feed_data":{"name_pt":"Smartphone Realme C31 3GB\/ 32GB\/ 6.5'\/ Verde Oscuro","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":70.11,"reference":"6042217","ean13":"6941399076860","weight":"0","quantity":0,"brand":"REALME","description_pt":"<h2>Realme C31<\/h2><p><h2>Modo ultraahorro<\/h2><p>Activa el modo ultraahorro para no tener que preocuparte por si queda poca bater\u00eda. Incluso cuando quede un 5 % de bater\u00eda, podr\u00e1s seguir chateando con amigos y hacer llamadas si quieres<\/p><h2>Ultrafino de 8,4 mm<\/h2><p><b>Cada vez m\u00e1s fino<\/b><\/p><p>Los dise\u00f1adores de realme han utilizado un proceso avanzado para optimizar de manera continua la estructura interna de los tel\u00e9fonos de la serie C, de modo que sean m\u00e1s finos y ofrezcan un agarre m\u00e1s c\u00f3modo y un aspecto m\u00e1s elegante.*<\/p><h2>Dise\u00f1o con textura din\u00e1mica<\/h2><p>El realme C31 presenta un nuevo dise\u00f1o con textura din\u00e1mica, una sutil disposici\u00f3n de texturas bien ordenadas que reflejan la velocidad de las curvas y la sensaci\u00f3n de una ampliaci\u00f3n din\u00e1mica.<\/p><h2>Pantalla completa de 16,5 cm (6,5'') Visi\u00f3n ultraclara<\/h2><p>Gracias a la pantalla completa de 16,5 cm (6,5'') y a la relaci\u00f3n pantalla-cuerpo del 88,7 %, tus ojos disfrutar\u00e1n de detalles v\u00edvidos y de una experiencia fluida, tanto si est\u00e1s jugando como si te desplazas por la pantalla, y el contenido se podr\u00e1 ver con claridad incluso a plena luz del d\u00eda.*<\/p><h2>Sensor de huellas digitales ultrarr\u00e1pido en el lateral<\/h2><p>El realme C31 es compatible con el desbloqueo lateral mediante huella digital, por lo que, con un solo toque, el tel\u00e9fono se desbloquear\u00e1 con rapidez, de forma segura y eficaz.*<\/p><h2>C\u00e1mara triple de 13 MP con IA&nbsp;<\/h2><p>Varias maneras de hacer fotos<\/p><h2>C\u00e1mara principal de 13 MP<\/h2><p>Apertura f\/2.2<\/p><h2>Lente ByN<\/h2><p>Apertura f\/2.8<\/p><h2>Lente macro<\/h2><p>Apertura f\/2.4<\/p><h2>C\u00e1mara frontal de 5 MP<\/h2><p>Captura selfis bonitas con facilidad.<\/p><h2>Certificaci\u00f3n T\u00dcV Rheinland de&nbsp;<span style='background-color: initial;'>alta fiabilidad para smartphones.<\/span><\/h2><p>Todos los tel\u00e9fonos m\u00f3viles de realme se someten a rigurosas pruebas de calidad. En esta ocasi\u00f3n, el realme C31 tambi\u00e9n ha conseguido la certificaci\u00f3n de calidad T\u00dcV Rheinland para smartphones, lo que permite a los usuarios disfrutar de una vida inteligente m\u00e1s duradera.<\/p><h2>Ranura para 3 tarjetas<\/h2><p><span style='background-color: initial;'>Gracias a la compatibilidad con dos ranuras para tarjeta SIM y una ranura para tarjeta microSD, puedes disfrutar de una experiencia de red y almacenamiento mejoradas. Adem\u00e1s, con la memoria externa de 1 TB tendr\u00e1s m\u00e1s espacio de almacenamiento para v\u00eddeos y fotos.<\/span><br><\/p><br><\/p><h2>Especificaciones<\/h2><p><p><ul><li><b>Procesador<\/b><\/li><li>Procesador Unisoc T612<\/li><li>CPU: ocho n\u00facleos, 12 nm y hasta 1,82 GHz<\/li><li>GPU: ARM Mali-G57<\/li><li>Almacenamiento y RAM<\/li><li>RAM: LPDDR4X de 3GB<\/li><li>ROM: UFS 2.2 de 32 GB<\/li><li>Memoria externa de hasta 1 TB<\/li><li><b>Pantalla<\/b><\/li><li>Pantalla completa de 16,5 cm (6,5'')<\/li><li>Relaci\u00f3n pantalla-cuerpo: 88,7 %<\/li><li>Velocidad de muestreo t\u00e1ctil: 120 Hz<\/li><li>Colores de pantalla: 16,7 M<\/li><li><b>C\u00e1mara<\/b><\/li><li>C\u00e1mara triple de 13 MP con IA<\/li><li>C\u00e1mara principal de 13 MP<\/li><li>Apertura f\/2.2<\/li><li>Lente de 5 P<\/li><li>Lente macro<\/li><li>Apertura f\/2.4<\/li><li>Distancia de captura de 4 cm<\/li><li>Lente ByN<\/li><li>Apertura f\/2.8<\/li><li><b>Funciones de fotograf\u00eda<\/b><\/li><li>Modo: R\u00e1faga, Filtro, Intervalo de tiempo, Pro, Panor\u00e1mico, Macro, Pro nocturno, Retrato, HDR<\/li><li><b>Grabaci\u00f3n de v\u00eddeo<\/b><\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 1080p\/30 fps<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 720p\/30 fps<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 480p\/30 fps<\/li><li>C\u00e1mara frontal de 5 MP con IA<\/li><li>Apertura f\/2.2<\/li><li>Lente de 3 P<\/li><li><b>Funciones de fotograf\u00eda<\/b><\/li><li>HDR, Modo belleza, Filtro<\/li><li>Grabaci\u00f3n de v\u00eddeo<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 720p\/30 fps<\/li><li>Compatible con grabaci\u00f3n de v\u00eddeo de 480p\/30 fps<\/li><li><b>Carga y bater\u00eda<\/b><\/li><li>Gran bater\u00eda de 5000 mAh (t\u00edp.)<\/li><li>Carga r\u00e1pida de 10 W<\/li><li>Capacidad de la bater\u00eda de 4890 mAh (m\u00edn.)<\/li><li>Incluye un adaptador de carga de 10 W<\/li><li><b>Conexi\u00f3n m\u00f3vil e inal\u00e1mbrica<\/b><\/li><li>2 ranuras para tarjetas nano + 1 microSD<\/li><li>Cobertura de la banda de frecuencia principal<\/li><li>GSM: 850\/900\/1800\/1900 MHz<\/li><li>WCDMA: 850\/900\/2100 MHz<\/li><li>FDD-LTE: Bandas 1\/3\/5\/8<\/li><li>TDD-LTE: Bandas 38\/40\/41 (2535 MHz-2655 MHz)<\/li><li><b>Conexi\u00f3n inal\u00e1mbrica:<\/b><\/li><li>2,4 GHz<\/li><li>Bluetooth 5.0<\/li><li><b>Tama\u00f1o y peso<\/b><\/li><li>Longitud: 164,7 mm<\/li><li>Anchura: 76,1 mm<\/li><li>Profundidad &#8776; 8,4 mm<\/li><li>Peso &#8776; 197 g<\/li><li>* Datos facilitados por el laboratorio de realme. Debido a los diferentes m\u00e9todos de medici\u00f3n, los datos reales pueden tener un rango de tolerancia razonable.<\/li><li><b>Sensores<\/b><\/li><li>Sensor de luz<\/li><li>Giroscopio<\/li><li>Sensor de proximidad<\/li><li>Sensor de aceleraci\u00f3n<\/li><li>Sensor de inducci\u00f3n magn\u00e9tica<\/li><li>Navegaci\u00f3n<\/li><li>GPS\/AGPS\/BEIDOU\/GALILEO<\/li><li><b>Puertos<\/b><\/li><li>Conector de auriculares de 3,5 mm<\/li><li>Micro-USB<\/li><li>Ranura para 3 tarjetas<\/li><li><b>Sistema&nbsp;<span style='background-color: initial;'>operativo<\/span><\/b><\/li><li>realme UI R Edition<\/li><li>Basado en Android 11<\/li><li><b>Contenido del&nbsp;<span style='background-color: initial;'>paquete<\/span><\/b><\/li><li>realme C31<\/li><li>Cable micro-USB<\/li><li>Adaptador de carga de 10 W<\/li><li>Aguja para tarjeta SIM<\/li><li>Gu\u00eda r\u00e1pida<\/li><li>Informaci\u00f3n importante sobre el producto (incluida la tarjeta de garant\u00eda)<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_real-sp%20c31%203-32%20gree_1.jpg","wholesale_price":"65.11","unit_price_tax":70.11},"product_model":{"product_data":{"ean13":["6941399076860"],"reference":"6042217","name":{"1":"Smartphone Realme C31 3GB\/ 32GB\/ 6.5'\/ Verde Oscuro","2":"","3":"","4":""},"description":{"1":"<h2>Realme C31<\/h2><p><h2>Modo ultraahorro<\/h2><p>Activa el modo ultraahorro para no tener que preocuparte por si queda poca bater\u00eda. Incluso cuando quede un 5 % de bater\u00eda, podr\u00e1s seguir chateando con amigos y hacer llamadas si quieres<\/p><h2>Ultrafino de 8,4 mm<\/h2><p><b>Cada vez m\u00e1s fino<\/b><\/p><p>Los dise\u00f1adores de realme han utilizado un proceso avanzado para optimizar de manera continua la estructura interna de los tel\u00e9fonos de la serie C, de modo que sean m\u00e1s finos y ofrezcan un agarre m\u00e1s c\u00f3modo y un aspecto m\u00e1s elegante.*<\/p><h2>Dise\u00f1o con textura din\u00e1mica<\/h2><p>El rea