     ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0.62,"unit_price":324.95,"unit_price_tax":324.95,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":5,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20note13pp%208-256%20wh_1.jpg"],"wholesale_price":319.95}}},"6941812753521":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941812753521",false],"wholesale_price":[98.95,false],"price":[103.95,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Xiaomi POCO C65 6GB\/ 128GB\/ 6,74&#39;\/ Preto"],"result":false},"feed_data":{"name_pt":"Smartphone Xiaomi POCO C65 6GB\/ 128GB\/ 6.74'\/ Negro","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":103.95,"reference":"POCO C65 6-128 BK","ean13":"6941812753521","weight":"0.41","quantity":5,"brand":"XIAOMI","description_pt":"<p><h2>Poco C65<\/h2><p>MediaTek Helio G85 de gran potencia<br>C\u00e1mara triple de 50 MP con IA<\/p><h2>Pantalla de 6,74' inmersiva<\/h2><h2>Tama\u00f1o grande, m\u00e1s impresionante<\/h2><p>Equipado con una pantalla HD+ ultragrande de 6,74' poco habitual entre sus compa\u00f1eros que proporciona una experiencia visual asombrosa al ver v\u00eddeos y jugar<\/p><h2>Pantalla Corning\u00ae Gorilla\u00ae Glass<\/h2><h2>Mayor protecci\u00f3n<\/h2><h2>90 Hz<\/h2><h2>Alta frecuencia de actualizaci\u00f3n<\/h2><p>Disfruta de una experiencia visual fluida y envolvente en esta gran pantalla de 6,74' con una alta frecuencia de actualizaci\u00f3n de hasta 90 Hz.<\/p><h2>Protege tus ojos de la fatiga visual<\/h2><h2>Disfruta de im\u00e1genes c\u00f3modas<\/h2><p>Gracias a la certificaci\u00f3n de luz azul reducida de T\u00dcV (soluci\u00f3n de software) y a la certificaci\u00f3n de tecnolog\u00eda sin parpadeos de T\u00dcV, puedes disfrutar de tu tel\u00e9fono de d\u00eda o de noche sin sentir tanta fatiga visual.<\/p><h2>50 MP<\/h2><p>Sistema de im\u00e1genes ultran\u00edtido<\/p><p>C\u00e1mara macro de 2 MP<\/p><p>C\u00e1mara principal ultran\u00edtida de 50 MP<\/p><h2>Modo retrato<\/h2><p>La velocidad de retrato de la c\u00e1mara trasera ha aumentado un 79 % y la velocidad de fotograf\u00eda de escenas nocturnas ha aumentado un 19,5 %.<\/p><h2>M\u00e1s modos, m\u00e1s emoci\u00f3n<\/h2><h2>Anillo de luz suave delantero<\/h2><h2>Eleva tus selfies<\/h2><h2>C\u00e1mara cinematogr\u00e1fica<br>T\u00fa marcas las tendencias<\/h2><p>La c\u00e1mara frontal de 8 MP cuenta con un anillo de luz suave mejorado que permite capturar selfies deslumbrantes incluso en entornos oscuros con este modo activado.<\/p><h2>C\u00e1mara cinematogr\u00e1fica C-50D<\/h2><h2>Filtro de luz diurna<\/h2><p>Ideal para retratos art\u00edsticos en entornos relativamente iluminados.<\/p><h2>Modo macro<\/h2><p>Descubre las maravillas de los detalles en los que nunca te hab\u00edas fijado.<\/p><h2>Procesador de ocho n\u00facleos<\/h2><h2>Rendimiento superior<\/h2><p>Disfruta de una experiencia perfecta y fluida con el procesador de ocho n\u00facleos. Este excelente chipset alcanza un equilibrio entre rendimiento s\u00f3lido y eficiencia.<\/p><p>Hasta 2,0 GHz<br>Velocidad de CPU<\/p><h2>Hasta 16 GB<\/h2><h2>Con 8 GB de RAM ampliada<\/h2><p>El POCO C65 est\u00e1 disponible en una selecci\u00f3n de configuraciones de 6 GB y 8 GB, con la versi\u00f3n de 8 GB ampliable hasta 16 GB de RAM gracias a la tecnolog\u00eda de ampliaci\u00f3n de la memoria para la multitarea y la ejecuci\u00f3n de aplicaciones sin problemas.<\/p><h2>Ampliaci\u00f3n del almacenamiento hasta 1 TB<\/h2><h2>M\u00e1s capacidad de almacenamiento<\/h2><p>Gracias al almacenamiento ampliable hasta 1 TB, puedes almacenar f\u00e1cilmente todas tus fotos, archivos y aplicaciones y juegos favoritos, sin necesidad de preocuparte por quedarte sin espacio.<\/p><h2>Gran bater\u00eda de 5000 mAh (t\u00edp.)<br>Carga r\u00e1pida con suministro de potencia tipo C de 18 W<\/h2><p>Maximiza tu diversi\u00f3n y productividad con la enorme capacidad de la bater\u00eda para aguantar durante todo el d\u00eda y ayudarte a sacar el m\u00e1ximo partido a cada carga. Disfruta de la comodidad de la carga r\u00e1pida de 18 W para recargar la bater\u00eda r\u00e1pidamente cuando sea necesario.<\/p><h2>Nuevo aspecto moderno<\/h2><p>El exclusivo lenguaje de dise\u00f1o POCO, la distintiva decoraci\u00f3n de las c\u00e1maras grandes, el innovador dise\u00f1o estilizado y el estilo sencillo crean una est\u00e9tica asombrosa.<\/p><h2>Sensor de huella dactilar lateral<\/h2><p>Experiencia de desbloqueo r\u00e1pida y segura con un solo toque.<\/p><h2>Conector para auriculares de 3,5 mm<\/h2><p>Interfaz de audio independiente para una integraci\u00f3n sencilla con todo tipo de dispositivos de reproducci\u00f3n<\/p><h2>MIUI 14 para POCO<\/h2><p>Con el potente y f\u00e1cil de usar MIUI 14 para POCO, es a\u00fan m\u00e1s divertido y eficiente de usar.<\/p><ul><li><b>Procesador<\/b><\/li><li>Procesador MediaTek Helio G85<\/li><li>Proceso de 12 nm, ocho n\u00facleos<\/li><li>CPU:<\/li><li>Arm Cortex-A75 de 2,0 GHz<\/li><li>Arm Cortex-A55 de 1,8 GHz<\/li><li>GPU: Arm Mali-G52 MC2<\/li><li><b>Almacenamiento y RAM<\/b><\/li><li>6 GB + 128 GB<\/li><li>LPDDR4X + eMMC 5.1<\/li><li>Permite ampliar el almacenamiento hasta 1 TB<\/li><li><b>Dimensiones<\/b><\/li><li>Altura: 168 mm<\/li><li>Anchura: 78 mm<\/li><li>Grosor: 8,09 mm<\/li><li>Peso: 192 g<\/li><li><b>Pantalla<\/b><\/li><li>Pantalla Dot Drop de 6,74'<\/li><li>1600 x 720, 260 pppB<\/li><li>rillo: 450 nits (t\u00edp.); 600 nits (HBM)<\/li><li>Frecuencia de actualizaci\u00f3n: Hasta 90 Hz<\/li><li>Compatible con Reading Mode<\/li><li>Atenuaci\u00f3n de CC<\/li><li>Pantalla Corning\u00ae Gorilla\u00ae Glass<\/li><li>Certificaci\u00f3n de luz azul reducida de T\u00dcV Rheinland (soluci\u00f3n de software)<\/li><li>Certificaci\u00f3n de tecnolog\u00eda sin parpadeos de T\u00dcV Rheinland<\/li><li><b>C\u00e1mara trasera<\/b><\/li><li>C\u00e1mara cinematogr\u00e1fica | Modo HDR | Modo nocturno | Modo retrato | Modo 50 MP | Time-lapse<\/li><li>C\u00e1mara principal de 50 MP<\/li><li>Lente de 5 elementos, f\/1,8<\/li><li>C\u00e1mara macro de 2 MP<\/li><li>f\/2,4<\/li><li>Objetivo auxiliar<\/li><li>Funciones de v\u00eddeo de la c\u00e1mara trasera<\/li><li>1080P 1920 x 1080 30 fps<\/li><li>720P 1280 x 720 30 fps<\/li><li><b>C\u00e1mara frontal<\/b><\/li><li>Filtro cinematogr\u00e1fico | Modo HDR | Anillo de luz suave | Modo retrato | Time-lapse<\/li><li>C\u00e1mara delantera de 8 MP<\/li><li>f\/2,0<\/li><li>Grabaci\u00f3n de v\u00eddeo de la c\u00e1mara frontal<\/li><li>1080P 1920 x 1080 30 fps<\/li><li>720P 1280 x 720 30 fps<\/li><li><b>Bater\u00eda y carga<\/b><\/li><li>5000 mAh (t\u00edp.)<\/li><li>Admite carga con suministro de potencia de 18 W<\/li><li>*En la caja se incluye un adaptador de corriente de 10 W. Los adaptadores de corriente compatibles con la carga de 18 W se venden por separado. Se recomienda utilizar adaptadores de corriente de 18 W o superiores compatibles con la carga con suministro de potencia.<\/li><li>USB tipo C<\/li><li><b>Seguridad<\/b><\/li><li>Sensor de huella dactilar lateralDesbloqueo facial por IA<\/li><li><b>Red y conectividad<\/b><\/li><li>SIM doble + microSD<\/li><li>Bandas de red:<\/li><li>Compatible con 4G\/3G\/2G<\/li><li>4G: LTE TDD: 38\/40\/41<\/li><li>4G: LTE FDD: 1\/2\/3\/4\/5\/7\/8\/20\/28\/66<\/li><li>3G: WCDMA: 1\/2\/4\/5\/8<\/li><li>2G: GSM: 2\/3\/5\/8<\/li><li>Redes inal\u00e1mbricas<\/li><li>Wi-Fi: 2,4 GHz | 5 GHz<\/li><li>Bluetooth 5.3<\/li><li>Compatible con AAC\/SBC<\/li><li>Compatible con radio FM (con conector para auriculares)<\/li><li><b>Navegaci\u00f3n y posicionamiento<\/b><\/li><li>GPS | Glonass | Galileo | Beidou<\/li><li><b>Audio<\/b><\/li><li>Conector para auriculares de 3,5 mm<\/li><li><b>Sensores<\/b><\/li><li>Sensor de proximidad virtual | Sensor de luz ambiental | Aceler\u00f3metro | Br\u00fajula electr\u00f3nica<\/li><li><b>Sistema operativo<\/b><\/li><li>MIUI 14 para POCO<\/li><li>*La disponibilidad de las funciones, aplicaciones y servicios de MIUI puede variar en funci\u00f3n de la versi\u00f3n de software y el modelo de tel\u00e9fono.<\/li><li><b>Contenido del paquete<\/b><\/li><li>Tel\u00e9fono m\u00f3vil | Adaptador | Cable USB tipo C | Extractor de SIM | Gu\u00eda de inicio r\u00e1pido y tarjeta de garant\u00eda | Informaci\u00f3n de seguridad<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20poco%20c65%206-128%20bk_1.jpg","wholesale_price":"98.95","unit_price_tax":103.95},"product_model":{"product_data":{"ean13":["6941812753521"],"reference":"POCO C65 6-128 BK","name":{"1":"Smartphone Xiaomi POCO C65 6GB\/ 128GB\/ 6.74'\/ Negro","2":"","3":"","4":""},"description":{"1":"<p><h2>Poco C65<\/h2><p>MediaTek Helio G85 de gran potencia<br>C\u00e1mara triple de 50 MP con IA<\/p><h2>Pantalla de 6,74' inmersiva<\/h2><h2>Tama\u00f1o grande, m\u00e1s impresionante<\/h2><p>Equipado con una pantalla HD+ ultragrande de 6,74' poco habitual entre sus compa\u00f1eros que proporciona una experiencia visual asombrosa al ver v\u00eddeos y jugar<\/p><h2>Pantalla Corning\u00ae Gorilla\u00ae Glass<\/h2><h2>Mayor protecci\u00f3n<\/h2><h2>90 Hz<\/h2><h2>Alta frecuencia de actualizaci\u00f3n<\/h2><p>Disfruta de una experiencia visual fluida y envolvente en esta gran pantalla de 6,74' con una alta frecuencia de actualizaci\u00f3n de hasta 90 Hz.<\/p><h2>Protege tus ojos de la fatiga visual<\/h2><h2>Disfruta de im\u00e1genes c\u00f3modas<\/h2><p>Gracias a la certificaci\u00f3n de luz azul reducida de T\u00dcV (soluci\u00f3n de software) y a la certificaci\u00f3n de tecnolog\u00eda sin parpadeos de T\u00dcV, puedes disfrutar de tu tel\u00e9fono de d\u00eda o de noche sin sentir tanta fatiga visual.<\/p><h2>50 MP<\/h2><p>Sistema de im\u00e1genes ultran\u00edtido<\/p><p>C\u00e1mara macro de 2 MP<\/p><p>C\u00e1mara principal ultran\u00edtida de 50 MP<\/p><h2>Modo retrato<\/h2><p>La velocidad de retrato de la c\u00e1mara trasera ha aumentado un 79 % y la velocidad de fotograf\u00eda de escenas nocturnas ha aumentado un 19,5 %.<\/p><h2>M\u00e1s modos, m\u00e1s emoci\u00f3n<\/h2><h2>Anillo de luz suave delantero<\/h2><h2>Eleva tus selfies<\/h2><h2>C\u00e1mara cinematogr\u00e1fica<br>T\u00fa marcas las tendencias<\/h2><p>La c\u00e1mara frontal de 8 MP cuenta con un anillo de luz suave mejorado que permite capturar selfies deslumbrantes incluso en entornos oscuros con este modo activado.<\/p><h2>C\u00e1mara cinematogr\u00e1fica C-50D<\/h2><h2>Filtro de luz diurna<\/h2><p>Ideal para retratos art\u00edsticos en entornos relativamente iluminados.<\/p><h2>Modo macro<\/h2><p>Descubre las maravillas de los detalles en los que nunca te hab\u00edas fijado.<\/p><h2>Procesador de ocho n\u00facleos<\/h2><h2>Rendimiento superior<\/h2><p>Disfruta de una experiencia perfecta y fluida con el procesador de ocho n\u00facleos. Este excelente chipset alcanza un equilibrio entre rendimiento s\u00f3lido y eficiencia.<\/p><p>Hasta 2,0 GHz<br>Velocidad de CPU<\/p><h2>Hasta 16 GB<\/h2><h2>Con 8 GB de RAM ampliada<\/h2><p>El POCO C65 est\u00e1 disponible en una selecci\u00f3n de configuraciones de 6 GB y 8 GB, con la versi\u00f3n de 8 GB ampliable hasta 16 GB de RAM gracias a la tecnolog\u00eda de ampliaci\u00f3n de la memoria para la multitarea y la ejecuci\u00f3n de aplicaciones sin problemas.<\/p><h2>Ampliaci\u00f3n del almacenamiento hasta 1 TB<\/h2><h2>M\u00e1s capacidad de almacenamiento<\/h2><p>Gracias al almacenamiento ampliable hasta 1 TB, puedes almacenar f\u00e1cilmente todas tus fotos, archivos y aplicaciones y juegos favoritos, sin necesidad de preocuparte por quedarte sin espacio.<\/p><h2>Gran bater\u00eda de 5000 mAh (t\u00edp.)<br>Carga r\u00e1pida con suministro de potencia tipo C de 18 W<\/h2><p>Maximiza tu diversi\u00f3n y productividad con la enorme capacidad de la bater\u00eda para aguantar durante todo el d\u00eda y ayudarte a sacar el m\u00e1ximo partido a cada carga. Disfruta de la comodidad de la carga r\u00e1pida de 18 W para recargar la bater\u00eda r\u00e1pidamente cuando sea necesario.<\/p><h2>Nuevo aspecto moderno<\/h2><p>El exclusivo lenguaje de dise\u00f1o POCO, la distintiva decoraci\u00f3n de las c\u00e1maras grandes, el innovador dise\u00f1o estilizado y el estilo sencillo crean una est\u00e9tica asombrosa.<\/p><h2>Sensor de huella dactilar lateral<\/h2><p>Experiencia de desbloqueo r\u00e1pida y segura con un solo toque.<\/p><h2>Conector para auriculares de 3,5 mm<\/h2><p>Interfaz de audio independiente para una integraci\u00f3n sencilla con todo tipo de dispositivos de reproducci\u00f3n<\/p><h2>MIUI 14 para POCO<\/h2><p>Con el potente y f\u00e1cil de usar MIUI 14 para POCO, es a\u00fan m\u00e1s divertido y eficiente de usar.<\/p><ul><li><b>Procesador<\/b><\/li><li>Procesador MediaTek Helio G85<\/li><li>Proceso de 12 nm, ocho n\u00facleos<\/li><li>CPU:<\/li><li>Arm Cortex-A75 de 2,0 GHz<\/li><li>Arm Cortex-A55 de 1,8 GHz<\/li><li>GPU: Arm Mali-G52 MC2<\/li><li><b>Almacenamiento y RAM<\/b><\/li><li>6 GB + 128 GB<\/li><li>LPDDR4X + eMMC 5.1<\/li><li>Permite ampliar el almacenamiento hasta 1 TB<\/li><li><b>Dimensiones<\/b><\/li><li>Altura: 168 mm<\/li><li>Anchura: 78 mm<\/li><li>Grosor: 8,09 mm<\/li><li>Peso: 192 g<\/li><li><b>Pantalla<\/b><\/li><li>Pantalla Dot Drop de 6,74'<\/li><li>1600 x 720, 260 pppB<\/li><li>rillo: 450 nits (t\u00edp.); 600 nits (HBM)<\/li><li>Frecuencia de actua