eta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LG","supplier":null,"width":null,"height":null,"depth":null,"weight":2.22,"unit_price":1425,"unit_price_tax":1425,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles","quantity":2,"brand":"LG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lgp-16z90r-e%20ad78b_1.jpg"],"wholesale_price":1420}}},"8806084196552":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806084196552",false],"wholesale_price":[1500,false],"price":[1505,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 2.42",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:216673","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c15879f0a508d2c68fba2dbe32b62aab.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Port\u00e1til LG Gram 17Z90R-E.AD78B Intel Core i7-1360P\/ 32GB\/ 1TB SSD\/ GeForce RTX 3050\/ 17'\/ Win11","category":"Portatiles","sub_category":"Portatiles","unit_price":1505,"reference":"17Z90R-E.AD78B","ean13":"8806084196552","weight":"2.42","quantity":2,"brand":"LG","description_pt":"<h2>LG gram&nbsp;17Z90R-E.AD78B<\/h2><div><h2>Ligero como una pluma<\/h2><p>Delgado y ligero con unas altas prestaciones, LG gram ofrece una portabilidad y productividad brillantes.<\/p><h2>Pantalla 11% m\u00e1s grande y cobertura de color DCI-P3 99%<\/h2><p>Te cautivar\u00e1n los colores ricos y v\u00edvidos de la pantalla de alta resoluci\u00f3n WUXGA, con DCI-P3 99% (Typ) que permite una amplia gama de color y un ratio de 16:10 para poder ver m\u00e1s contenido con menos movimientos.<\/p><h2>Confort visual, incluso con luz<\/h2><p>El panel anti-glare reduce considerablemente los reflejos y autom\u00e1ticamente ajusta el brillo, permitiendo ver bien en lugares luminosos.<\/p><h2>Procesadores Intel Core13\u00aa Generaci\u00f3n<\/h2><p>Incrementa tu productividad con el nuevo procesador Intel\u00ae Core&#8482; 13\u00aa Generaci\u00f3n, m\u00e1s potente y robusto que sus predecesores. Obt\u00e9n un rendimiento a la altura de tu demanda.<\/p><h2>Experiencia de audio inmersiva<\/h2><p>Escucha, siente m\u00e1s y teletransp\u00f3rtate dentro de m\u00fasica y pel\u00edculas con Dolby Atmos. Emoci\u00f3nate con la experiencia de sonido envolvente inmersiva. Siente el mejor sonido con matices amplificados gracias a smart amp.<\/p><h2>Hasta 22,5hrs de bater\u00eda<\/h2><p>Experimenta una portabilidad sin cables con la bater\u00eda de alta capacidad de 90Wh<\/p><h2>M\u00faltiples puertos de conexi\u00f3n<\/h2><p>LG gram ofrece no solo varios puertos sino tambi\u00e9n dos Thunderbolt&#8482; 4 para la m\u00e1xima escalabilidad. Experimenta la pantalla 5K con 40GB de velocidad de transferencia mientras cargas dispositivos externos simult\u00e1neamente.<\/p><h2>Sistema de refrigeraci\u00f3n integrado<\/h2><p>El sistema de refrigeraci\u00f3n avanzada te permite trabajar a m\u00e1ximo nivel conservando una temperatura adecuada en el equipo.<\/p><h2>Detecci\u00f3n Facial Avanzada<\/h2><p>La detecci\u00f3n avanzada de cara, ojos y mirada de LG aumenta la seguridad y crea dispositivos m\u00e1s accesibles e intuitivos.<\/p><h2>LG Security Guard<\/h2><p>Tu port\u00e1til seguro incluso fuera. Tu gram se bloquear\u00e1 y mandar\u00e1 una alerta cuando detecte una situaci\u00f3n anormal, por ejemplo si se pierde.<\/p><h2>Experimenta una pantalla sin parpadeos<\/h2><p>D\u00e9jate impresionar por las transiciones visuales suaves y el ahorro de consumo energ\u00e9tico** con LG gram, que ajusta autom\u00e1ticamente su tasa de refresco y el brillo al comportamiento y actividad del usuario.<\/p><h2>Sincronizaci\u00f3n de m\u00f3viles iOS y Android<\/h2><p>Deja de hacer malabares para transferir ficheros, hacer llamadas o mandar mensajes. Concentra todas las tareas de tus dispositivos Android o iOS en tu gram.<\/p><h2>Durabilidad demostrada<\/h2><p>Fabricado con un material duradero pero ligero, LG gram ha sido sometido a un test de durabilidad militar de siete niveles de resistencia. Funciona incluso en las condiciones m\u00e1s duras.<\/p><br><\/div><div><p><h2><span style='background-color: initial;'>Especificaciones<\/span><\/h2><ul><li><b>Sistema operativo<\/b><\/li><li>Windows 11 Home<\/li><li><b>Tama\u00f1o<\/b><\/li><li>17<\/li><li><b>Procesador<\/b><\/li><li>i7-1360P<\/li><li><b>Memoria<\/b><\/li><li>32GB LPDDR5 (Dual Channel, 6000MHz)<\/li><li><b>Almacenamiento<\/b><\/li><li>SSD&nbsp;<span style='background-color: initial;'>1TB NVMe Gen4 M.2(2280) Dual SSD slots<\/span><\/li><li><b>Peso(kg)<\/b><\/li><li>1.45<\/li><li><b>Resoluci\u00f3n<\/b><\/li><li>WQXGA 2560 x 1600<\/li><li><b>Grafica<\/b><\/li><li>Nvidia RTX 3050 4GB<\/li><li><b>Gamut de colores<\/b><\/li><li>DCI-P3 99% (t\u00edpico, min 95%)<\/li><li><b>Dimensi\u00f3n (inch)<\/b><\/li><li>14.91 x 10.19 x 0.70<\/li><li><b>BATER\u00cdA<\/b><\/li><li>Bater\u00eda<\/li><li>90Wh<\/li><li><b>DISE\u00d1O<\/b><\/li><li>Materiales de chasis<\/li><li>Magnesio, PC-ABS<\/li><li>Color<\/li><li>Obsidian Black<\/li><li><b>PANTALLA<\/b><\/li><li>Brillo<\/li><li>400nit<\/li><li>Gamut de colores<\/li><li>DCI-P3 99% (t\u00edpico, min 95%)<\/li><li>Contrasto<\/li><li>1500:1 (Typical)<\/li><li>Tipo de panel<\/li><li>IPS sin tocar<\/li><li>Panel Multi<\/li><li>LGD<\/li><li>Pol<\/li><li>Anti-Glare<\/li><li>Relaci\u00f3n<\/li><li>16:10<\/li><li>Tasa de refresco<\/li><li>VRR(31Hz~144Hz)<\/li><li><b>SEGURIDAD<\/b><\/li><li>fTPM\/HW TPM<\/li><li>Opci\u00f3n<\/li><li>Cerradura Slim Kensington<\/li><li>S\u00ed.<\/li><li>Seguridad SSD<\/li><li>S\u00ed.<\/li><li><b>SONIDO<\/b><\/li><li>Audio<\/li><li>Audio HD con Dolby Atmos<\/li><li>Altavoz<\/li><li>Estereo Speaker 3.0W x 2, Max 5W(Amp inteligente)<\/li><li><b>CONECTIVIDAD<\/b><\/li><li>BT MATERIAL<\/li><li>BT 5.1<\/li><li>Webcam<\/li><li>FHD IR Webcam con Dual Mic (Reconocimiento de la cara)<\/li><li>Inal\u00e1mbrico<\/li><li>Intel\u00ae Wireless-AX211 (802.11ax, 2x2, Dual Band, BT Combo)<\/li><li>LAN<\/li><li>10\/100 with RJ45 adapter (Option)<\/li><li><b>POTENCIA<\/b><\/li><li>Adaptador de AC<\/li><li>65W<\/li><li>Tipo de adaptador AC<\/li><li>USB Tipo-C<\/li><li><b>ACCESORIO<\/b><\/li><li>Accesorio<\/li><li>Adaptador USB-C a RJ45 (opci\u00f3n B2B)<\/li><li><b>DISPOSITIVO DE ENTRADA<\/b><\/li><li>Teclado<\/li><li>Teclado con iluminaci\u00f3n completa (US: 100 Key, UK: 101 Key, JP: 104 Key w\/ Num\u00e9rico Keypad)<\/li><li>Dispositivo de se\u00f1alizaci\u00f3n<\/li><li>Tecnolog\u00eda t\u00e1ctil de precisi\u00f3n w\/ Funci\u00f3n de pergamino y Gesti\u00f3n (tama\u00f1o: 131.5 x 82.6mm)<\/li><li><b>LED<\/b><\/li><li>LED<\/li><li>Potencia, DC-In, Bloqueo de Caps, Webcam<\/li><li><b>PUERTA DE ENTRADA\/SALIDA<\/b><\/li><li>HP-Out<\/li><li>4Pole Headset, US type<\/li><li>USB Tipo A<\/li><li>USB 3.2 Gen 2x1 (x1)<\/li><li>USB Tipo C<\/li><li>USB 4 Gen3x2 Tipo C (x2, con alimentaci\u00f3n, puerto de pantalla, Thunderbolt 4)<\/li><li>HDMI<\/li><li>S\u00ed.<\/li><\/ul><\/p><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lgp-17z90r-e%20ad78b_1.jpg","wholesale_price":"1500.00","unit_price_tax":1505},"product_model":{"product_data":{"ean13":["8806084196552"],"reference":"17Z90R-E.AD78B","name":{"1":"Port\u00e1til LG Gram 17Z90R-E.AD78B Intel Core i7-1360P\/ 32GB\/ 1TB SSD\/ GeForce RTX 3050\/ 17'\/ Win11","2":"","3":"","4":""},"description":{"1":"<h2>LG gram&nbsp;17Z90R-E.AD78B<\/h2><div><h2>Ligero como una pluma<\/h2><p>Delgado y ligero con unas altas prestaciones, LG gram ofrece una portabilidad y productividad brillantes.<\/p><h2