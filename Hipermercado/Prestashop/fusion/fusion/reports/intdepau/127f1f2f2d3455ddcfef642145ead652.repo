dos","sub_category":"Teclados","quantity":0,"brand":"NGS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ngs-tec%20set%20fantasy%20kit%20pk_1.jpg"],"wholesale_price":25.89}}},"8435602907341":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435602907341",false],"wholesale_price":[65.87,false],"price":[70.87,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.8",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:217187","Cat. IDs: 192","Associated Categories","Cat. Default: 192","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fe7ecf1279b729ff00c41733ba79ebe9.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Impresora de Tickets 10POS RP-12NW\/ T\u00e9rmica\/ Ancho papel 80mm\/ USB-RS232-Ethernet-RJ11-WiFi\/ Negra","category":"Terminal Pto Venta TPV","sub_category":"Impresoras tickets","unit_price":70.87,"reference":"RP-12NW","ean13":"8435602907341","weight":"1.8","quantity":0,"brand":"10POS","description_pt":"<p><h2>Impresora de tickets t\u00e9rmica 10POS RP-12NW, USB, RS232, WIFI &amp; Ethernet. F. Alim., cable USB y cable RS232 incluidos.<\/h2><p>La impresora RP-12NW de 10POS es la mejor apuesta para cubrir sus necesidades de impresi\u00f3n de ticket a un precio contenido, sin renunciar ni a la fiabilidad ni a las prestaciones.<\/p><p>Se trata de una impresora t\u00e9rmica de tickets de 80 mm, con autocorte y se\u00f1al ac\u00fastica de fin de impresi\u00f3n.&nbsp;<\/p><p>Con una velocidad de hasta 260 mm\/s, 256Kbde buffer y una resoluci\u00f3n de hasta 203 ppp, la calidad y la rapidez de impresi\u00f3n est\u00e1n garantizadas.<\/p><p>A nivel de comunicaciones, equipada con cuadruple interface (USB, RS232 y Ethernet) m\u00e1s un puerto de apertura de caj\u00f3n.<\/p><p>Compatible con impresi\u00f3n de c\u00f3digos de barras 1D y 2D.<\/p><p>La impresora incluye en su presentaci\u00f3n fuente de alimentaci\u00f3n (24V), cable USB, cable RS232 y un peque\u00f1o rollo de papel t\u00e9rmico de 80 mm.<\/p><ul><li><strong>Prestaciones<\/strong><\/li><li>Soporte impresi\u00f3n: Ticket<\/li><li>Tecnolog\u00eda: T\u00e9rmica directa<\/li><li>Velocidad (mm\/s): 260 mm\/s<\/li><li>Resoluci\u00f3n: 203 ppp<\/li><li>Ancho: 80 mm<\/li><li>Corte Autom\u00e1tico: SI<\/li><li>Rebobinador: NO<\/li><li>Despegador (Peeler): NO<\/li><li>Banda Magn\u00e9tica: NO<\/li><li>Smart Card:<\/li><li>RFID: NO<\/li><li><strong>Instalaci\u00f3n<\/strong><\/li><li>Ubicaci\u00f3n: Sobremesa<\/li><li>Interface: USB,RS232,ETHERNET<\/li><li>Montaje en pared: SI<\/li><\/ul><div><br><\/div><h2><span style='background-color: initial;'>Especificaciones<\/span><\/h2><ul><li style=''><b>Impresi\u00f3n<\/b><\/li><li style=''>T\u00e9rmica directa<\/li><li style=''><b>Resoluci\u00f3n<\/b><\/li><li style=''>576\/512 ppl<\/li><li style=''><b>Ancho Impresi\u00f3n<\/b><\/li><li style=''>72 mm<\/li><li style=''><b>Velocidad<\/b><\/li><li style=''>260 mm\/s<\/li><li style=''><b>Corte<\/b><\/li><li style=''>Autom\u00e1tico<\/li><li style=''><b>Interfaz<\/b><\/li><li style=''>USB + RS232 + Ethernet + RJ11 (cajon portamonedas) + WiFi<\/li><li style=''><b>Buffer<\/b><\/li><li style=''>256 Kb<\/li><li style=''><b>Se\u00f1al ac\u00fastica<\/b><\/li><li style=''>S\u00ed (fin de impresi\u00f3n)<\/li><li style=''><b>NV Flash<\/b><\/li><li style=''>256 Kb<\/li><li style=''><b>Alimentaci\u00f3n<\/b><\/li><li style=''>24V (Fuente de alimentaci\u00f3n externa)<\/li><li style=''><b>Peso Neto<\/b><\/li><li style=''>1,0 Kg<\/li><li style=''><b>Tama\u00f1o<\/b><\/li><li style=''>138,2 x 180.2 x 129.5 (ancho x fondo x alto)<\/li><li style=''><b>Temperatura de trabajo<\/b><\/li><li style=''>0 ~ 45\u00ba C, Humedad 10 ~ 80%<\/li><li style=''><b>Temperatura almac\u00e9n<\/b><\/li><li style=''>-10 ~ 60\u00ba C, Humedad 10 ~ 90%<\/li><li style=''><b>Vida mecanismo<\/b><\/li><li style=''>150 Km<\/li><li style=''><b>Vida corte<\/b><\/li><li style=''>1.5 millones de cortes<\/li><li style=''><b>Contenido de caja<\/b><\/li><li style=''>Impresora, Fuente de alimentaci\u00f3n, cable DC, cable USB, cable RS232 y rollo de papel de 80mm de cortes\u00eda.<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_10p-imp%20ter%20rp-12nw_1.jpg","wholesale_price":"65.87","unit_price_tax":70.87},"product_model":{"product_data":{"ean13":["8435602907341"],"reference":"RP-12NW","name":{"1":"Impresora de Tickets 10POS RP-12NW\/ T\u00e9rmica\/ Ancho papel 80mm\/ USB-RS232-Ethernet-RJ11-WiFi\/ Negra","2":"","3":"","4":""},"description":{"1":"<p><h2>Impresora de tickets t\u00e9rmica 10POS RP-12NW, USB, RS232, WIFI &amp; Ethernet. F. Alim., cable USB y cable RS232 incluidos.<\/h2><p>La impresora RP-12NW de 10POS es la mejor apuesta para cubrir sus necesidades de impresi\u00f3n de ticket a un precio contenido, sin renunciar ni a la fiabilidad ni a las prestaciones.<\/p><p>Se trata de una impresora t\u00e9rmica de tickets de 80 mm, con autocorte y se\u00f1al ac\u00fastica de fin de impresi\u00f3n.&nbsp;<\/p><p>Con una velocidad de hasta 260 mm\/s, 256Kbde buffer y una resoluci\u00f3n de hasta 203 ppp, la calidad y la rapidez de impresi\u00f3n est\u00e1n garantizadas.<\/p><p>A nivel de comunicaciones, equipada con cuadruple interface (USB, RS232 y Ethernet) m\u00e1s un puerto de apertura de caj\u00f3n.<\/p><p>Compatible con impresi\u00f3n de c\u00f3digos de barras 1D y 2D.<\/p><p>La impresora incluye en su presentaci\u00f3n fuente de alimentaci\u00f3n (24V), cable USB, cable RS232 y un peque\u00f1o rollo de papel t\u00e9rmico de 80 mm.<\/p><ul><li><strong>Prestaciones<\/strong><\/li><li>Soporte impresi\u00f3n: Ticket<\/li><li>Tecnolog\u00eda: T\u00e9rmica directa<\/li><li>Velocidad (mm\/s): 260 mm\/s<\/li><li