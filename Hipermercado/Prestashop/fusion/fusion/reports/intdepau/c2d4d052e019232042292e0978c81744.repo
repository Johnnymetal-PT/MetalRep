): 1,8 m<\/li>  <li>Ajustes: S\u00ed<\/li>  <li>Color: Negro<\/li>  <li>Frecuencia(Hz): 50\/60 Hz<\/li>  <li>Temperatura m\u00e1xima(\u00b0C): 180 \u00b0C<\/li>  <li>Temperatura m\u00ednima(\u00b0C): 0 \u00b0C<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRISTAR","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":13.58,"unit_price_tax":13.58,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Planchas de pelo","quantity":0,"brand":"TRISTAR","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tris-pae-plp%20hd-2421_1.jpg"],"wholesale_price":8.58}}},"8436574708035":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8436574708035",false],"wholesale_price":[3.09,false],"price":[8.09,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Estojo para Unidade Externa de 2,5&#39; Aisens ASBG-001\/ Preto"],"result":false},"feed_data":{"name_pt":"Funda para Disco Externo de 2.5' Aisens ASBG-001\/ Negra","category":"Discos Duros Externos","sub_category":"Fundas Protectoras para Discos Externos","unit_price":8.09,"reference":"ASBG-001-BK","ean13":"8436574708035","weight":"0.11","quantity":5,"brand":"AISENS","description_pt":"<h2>ESTUCHE PROTECTOR PARA CAJA EXTERNA 2.5&nbsp;<\/h2><p>&nbsp;Este estuche es adecuado para guardar y transportar un disco duro port\u00e1til de manera segura y c\u00f3moda.&nbsp;<\/p><p>Cuenta con una estructura r\u00edgida en el exterior que protege el disco duro de posibles da\u00f1os durante 