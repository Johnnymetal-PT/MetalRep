l><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ROWENTA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.5,"unit_price":40.35,"unit_price_tax":40.35,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Planchas de pelo","quantity":2,"brand":"ROWENTA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_row-pae-plp%20sf7460f0_1.jpg"],"wholesale_price":35.35}}},"0619659184735":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0619659184735",false],"wholesale_price":[320.92,false],"price":[325.92,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.17",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:169561","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d8dc2fbe08ade6d23f50d6bc7b4901f7.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Disco Externo SSD SanDisk Extreme PRO Portable V2 4TB\/ USB 3.2 Gen 2","category":"Discos Duros Externos","sub_category":"Discos SSD Externos","unit_price":325.92,"reference":"SDSSDE81-4T00-G25","ean13":"0619659184735","weight":"0.17","quantity":0,"brand":"SANDISK","description_pt":"<p><p><\/p><h2>Acaba primero con un potente rendimiento SSD<\/h2><div><p>SanDisk Extreme PRO\u00ae Portable SSD, un producto de la marca en la que conf\u00edan fot\u00f3grafos profesionales de todo el mundo, ofrece un rendimiento de estado s\u00f3lido potente en una soluci\u00f3n de almacenamiento resistente y fiable.&nbsp;\u00a1Casi el doble de r\u00e1pido que la generaci\u00f3n anterior!<\/p><p><\/p><div><div><div><div><div><div><div><div><div><h2>R\u00e1pido y fiable<\/h2>Disfruta de un potente rendimiento de estado s\u00f3lido NVMe&#8482; con velocidades de lectura y escritura de 2000&nbsp;MB\/s en un disco port\u00e1til lo bastante fiable para llev\u00e1rtelo a cualquier aventura.<h2>Trabaja m\u00e1s r\u00e1pido y m\u00e1s tiempo<\/h2>Ahorra tiempo al almacenar y transferir datos con el chasis de aluminio forjado que tambi\u00e9n funciona como disipador de calor para lograr velocidades sostenidas superiores.<h2>Viaja sin preocupaciones<\/h2>Disfruta de total tranquilidad cuando viajes por el mundo gracias a la garant\u00eda limitada&nbsp;de 5&nbsp;a\u00f1os y a la combinaci\u00f3n de chasis de aluminio forjado y funda de silicona que logra un tacto de calidad y mayor protecci\u00f3n.<h2>Lo bastante resistente para llev\u00e1rtelo a cualquier parte<\/h2>Gracias a la protecci\u00f3n contra ca\u00eddas de hasta dos metros, la protecci\u00f3n IP55 contra el agua y el polvo&nbsp;y la pr\u00e1ctica asa con mosquet\u00f3n para engancharlo al cintur\u00f3n o la mochila, el disco es lo bastante resistente para llev\u00e1rtelo a cualquier parte.<h2>Cifrado para mayor seguridad<\/h2>Ayuda a mantener la privacidad de tus contenidos mediante la protecci\u00f3n con contrase\u00f1a incluida que cuenta con cifrado por hardware AES de 256&nbsp;bits.<h2>Almacenamiento profesional<\/h2>Un producto de SanDisk\u00ae, la marca en la que conf\u00edan fot\u00f3grafos profesionales de todo el mundo para manejar sus mejores tomas en los encargos m\u00e1s complicados<p><\/p><\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/div><\/div><li><b>Especificaciones completas<\/b><\/li><li>Capacidad<\/li><li>4 TB<\/li><li>Conexi\u00f3n<\/li><li>USB 3.2 Gen 2 x2<\/li><li>Conector<\/li><li>USB-C<\/li><li>Compatibilidad<