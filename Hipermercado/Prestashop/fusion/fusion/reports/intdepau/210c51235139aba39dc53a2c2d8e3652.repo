8.26,false],"price":[33.26,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.65",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:150417","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/596f9b68958ba664045ae16f2421f6e7.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Fuente de Alimentaci\u00f3n Aerocool LUX550\/ 550W\/ Ventilador 12cm\/ 80 Plus Bronze","category":"Componentes","sub_category":"Fuentes de alimentacion","unit_price":33.260000000000005,"reference":"LUX550","ean13":"4718009156234","weight":"1.65","quantity":0,"brand":"AEROCOOL","description_pt":"<p><p>La fuente de alimentaci\u00f3n LUX est\u00e1 dise\u00f1ada para garantizar una potencia de 550W totalmente segura, fiable y estable en todo momento. Con un dise\u00f1o optimizado para proporcionar prestaciones profesionales, se trata de una fuente de alimentaci\u00f3n preparada para ofrecer la energ\u00eda que tu PC necesita con toda la seguridad posible.<\/p><p><ul><li>Certificado 80Plus Bronze 230V EU para un rendimiento de alta eficiencia<\/li><li>Ventilador negro y silencioso de 12cm con control optimizado<\/li><li>Cables planos para una instalaci\u00f3n m\u00e1s c\u00f3moda y r\u00e1pida<\/li><li>Compatible con todos los factores de forma de Intel hasta ATX12V Ver. 2.4<\/li><\/ul><\/p><h2>CERTIFICADO DE ALTA EFICIENCIA<\/h2><p>La certificaci\u00f3n 80Plus Bronze 230V EU de la que goza esta fuente de alimentaci\u00f3n consigue una eficiencia de hasta 88%+, garantizando el mejor rendimiento para tu PC en todo momento para que puedas jugar sin descanso.<\/p><h2>VENTILACI\u00d3N MEJORADA<\/h2><p>La LUX de Aerocool est\u00e1 equipada con un ventilador negro de 12cm silencioso, con un control t\u00e9rmico de velocidad que ralentiza la ventilaci\u00f3n a nivel de arranque (800 RPM) antes de alcanzar el 60% de carga. As\u00ed, se alarga la durabilidad de la fuente y se mantiene una temperatura ideal en todo momento.<\/p><h2>COMPATIBILIDAD Y EFICIENCIA<\/h2><p>Es totalmente compatible con todos los factores de forma hasta ATX12V de versi\u00f3n 2.4 y est\u00e1 equipada con cables planos, largos y ligeros, con un dise\u00f1o totalmente profesional. As\u00ed, LUX es una fuente de alimentaci\u00f3n \u00f3ptima para garantizar rendimiento y seguridad en cualquier sistema.<\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aer-fuente%20lux550_1.jpg","wholesale_price":"28.26","unit_price_tax":33.260000000000005},"product_model":{"product_data":{"ean13":["4718009156234"],"reference":"LUX550","name":{"1":"Fuente de Alimentaci\u00f3n Aerocool LUX550\/ 550W\/ Ventilador 12cm\/ 80 Plus Bronze","2":"","3":"","4":""},"description":{"1":"<p><p>La fuente de alimentaci\u00f3n LUX est\u00e1 dise\u00f1ada para garantizar una potencia de 550W totalmente segura, fiable y estable en todo momento. Con un dise\u00f1o optimizado para proporcionar prestaciones profesionales, se trata de una fuente de alimentaci\u00f3n preparada para ofrecer la energ\u00eda que tu PC necesita con toda la seguridad posible.<\/p><p><ul><li>Certificado 80Plus Bronze 230V EU para un rendimiento de alta eficiencia<\/li><li>Ventilador negro y silencioso de 12cm con control optimizado<\/li><li>Cables planos para una instalaci\u00f3n m\u00e1s c\u00f3moda y r\u00e1pida<\/li><li>Compatible con todos los factores de forma de Intel hasta ATX12V Ver. 2.4<\/li><\/ul><\/p><h2>CERTIFICADO DE ALTA EFICIENCIA<\/h2><p>La certificaci\u00f3n 80Plus Bronze 230V EU de la que goza esta fuente de alimentaci\u00f3n consigue una eficiencia de hasta 88%+, garantizando el mejor rendimiento para tu PC en todo momento para que puedas jugar sin descanso.<\/p><h2>VENTILACI\u00d3N MEJORADA<\/h2><p>La LUX de Aerocool est\u00e1 equipada con un ventilador negro de 12cm silencioso, con un control t\u00e9rmico de velocidad que ralentiza la ventilaci\u00f3n a nivel de arranque (800 RPM) antes de alcanzar el 60% de carga. As\u00ed, se alarga la durabilidad de la fuente y se mantiene una temperatura ideal en todo momento.<\/p><h2>COMPATIBILIDAD Y EFICIENCIA<\/h2><p>Es totalmente compatible con todos los factores de forma hasta ATX12V de versi\u00f3n 2.4 y est\u00e1 equipada con cables planos, largos y ligeros, con un dise\u00f1o totalmente profesional. As\u00ed, LUX es una fuente de alimentaci\u00f3n \u00f3ptima para garantizar rendimiento y seguridad en cualquier sistema.<\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AEROCOOL","supplier":null,"width":null,"height":null,"depth":null,"weight":1.65,"unit_price":33.26,"unit_price_tax":33.26,"tax_rules_group":null,"category":"Componentes","sub_category":"Fuentes de alimentacion","quantity":0,"brand":"AEROCOOL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aer-fuente%20lux550_1.jpg"],"wholesale_price":28.26}}},"4718009156203":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4718009156203",false],"wholesale_price":[40.04,false],"price":[45.04,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.68",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:150418","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/a40cb6e7e529739aec0ec93c18983828.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Fuente de Alimentaci\u00f3n Aerocool LUX RGB 550M\/ 550W\/ Ventilador 12cm\/ 80 Plus Bronze","category":"Componentes","sub_category":"Fuentes de alimentacion","unit_price":45.04,"reference":"LUXRGB550M","ean13":"4718009156203","weight":"1.68","quantity":0,"brand":"AEROCOOL","description_pt":"<p><p>Dise\u00f1ada para proporcionar energ\u00eda y espectacularidad a tu PC, la fuente de alimentaci\u00f3n LUX RGB te ofrece hasta 13 efectos de iluminaci\u00f3n \u00fanicos con su sistema LED RGB. Adem\u00e1s, cuenta con las mejores prestaciones para sustituir tu vieja fuente y disfrutar de un potente abanico de colores dentro de tu PC, gracias a su certificado 80Plus Bronze 230V EU.<\/p><p><ul><li>Certificado 80Plus Bronze 230V EU para rendimiento de alta eficiencia<\/li><li>Compatible con placas base RGB Addressable<\/li><li>13 efectos de iluminaci\u00f3n LED RGB \u00fanicos<\/li><li>Ventilador negro y silencioso de 12cm con control t\u00e9rmico de velocidad<\/li><li>Cables planos para una instalaci\u00f3n f\u00e1cil y r\u00e1pida<\/li><li>Compatible con todos los factores de forma Intel de hasta ATX12V Ver. 2.4<\/li><\/ul><\/p><h2>PRISM LED RGB<\/h2><p>La LUX RGB de Aerocool est\u00e1 equipada con un sistema Prism LED RGB, un dise\u00f1o multicolor con 13 efectos distintos controlables a trav\u00e9s de un switch de control LED ubicado en la propia fuente, y compatible con placas base con RGB Addressable. Se acabaron las fuentes de alimentaci\u00f3n aburridas: la LUX RGB es el complemento ideal para todo amante de los setups iluminados y las cajas con ventana.<\/p><h2>RENDIMIENTO \u00d3PTIMO<\/h2><p>La fuente LUX RGB te ofrece un rendimiento como nunca antes. Dispone de un dise\u00f1o semimodular inteligente con una c\u00f3moda gesti\u00f3n del cableado, y su \u00e1rea de ventilaci\u00f3n se ha incrementado un 30% m\u00e1s de lo habitual para potenciar el flujo del aire. Adem\u00e1s, su certificado 80Plus Bronze 230V garantiza hasta un 88%+ m\u00e1s de eficiencia energ\u00e9tica.<\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aer-fuente%20luxrgb550m_1.jpg","wholesale_price":"40.04","unit_price_tax":45.04},"product_model":{"product_data":{"ean13":["4718009156203"],"reference":"LUXRGB550M","name":{"1":"Fuente de Alimentaci\u00f3n Aerocool LUX RGB 550M\/ 550W\/ Ventilador 12cm\/ 80 Plus Bronze","2":"","3":"","4":""},"description":{"1":"<p><p>Dise\u00f1ada para proporcionar energ\u00eda y espectacularidad a tu PC, la fuente de alimentaci\u00f3n LUX RGB te ofrece hasta 13 efectos de iluminaci\u00f3n \u00fanicos con su sistema LED RGB. Adem\u00e1s, cuenta con las mejores prestaciones para sustituir tu vieja fuente y disfrutar de un potente abanico de colores dentro de tu PC, gracias a su certificado 80Plus Bronze 230V EU.<\/p><p><ul><li>Certificado 80Plus Bronze 230V EU para rendimiento de alta eficiencia<\/li><li>Compatible con placas base RGB Addressable<\/li><li>13 efectos de iluminaci\u00f3n LED RGB \u00fanicos<\/li><li>Ventilador negro y silencioso de 12cm con control t\u00e9rmico de velocidad<\/li><li>Cables planos para una instalaci\u00f3n f\u00e1cil y r\u00e1pida<\/li><li>Compatible con todos los factores de forma Intel de hasta ATX12V Ver. 2.4<\/li><\/ul><\/p><h2>PRISM LED RGB<\/h2><p>La LUX RGB de Aerocool est\u00e1 equipada con un sistema Prism LED RGB, un dise\u00f1o multicolor con 13 efectos distintos controlables a trav\u00e9s de un switch de control LED ubicado en la propia fuente, y compatible con placas base con RGB Addressable. Se acabaron las fuentes de alimentaci\u00f3n aburridas: la LUX RGB es el complemento ideal para todo amante de los setups iluminados y las cajas con ventana.<\/p><h2>RENDIMIENTO \u00d3PTIMO<\/h2><p>La fuente LUX RGB te ofrece un rendimiento como nunca antes. Dispone de un dise\u00f1o semimodular inteligente con una c\u00f3moda gesti\u00f3n del cableado, y su \u00e1rea de ventilaci\u00f3n se ha incrementado un 30% m\u00e1s de lo habitual para potenciar el flujo del aire. Adem\u00e1s, su certificado 80Plus Bronze 230V garantiza hasta un 88%+ m\u00e1s de eficiencia energ\u00e9tica.<\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AEROCOOL","supplier":null,"width":null,"height":null,"depth":null,"weight":1.68,"unit_price":45.04,"unit_price_tax":45.04,"tax_rules_group":null,"category":"Componentes","sub_category":"Fuentes de alimentacion","quantity":0,"brand":"AEROCOOL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aer-fuente%20luxrgb550m_1.jpg"],"wholesale_price":40.04}}},"4718009156210":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4718009156210",false],"wholesale_price":[47.95,false],"price":[52.95,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:150419","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0591027dbfab29a0d15a99a4e1f6d0a4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Fuente de Alimentaci\u00f3n Aerocool LUX RGB 650M\/ 650W\/ Ventilador 12cm\/ 80 Plus Bronze","category":"Componentes","sub_category":"Fuentes de alimentacion","unit_price":52.95,"reference":"LUXRGB650M","ean13":"4718009156210","weight":"3","quantity":0,"bra