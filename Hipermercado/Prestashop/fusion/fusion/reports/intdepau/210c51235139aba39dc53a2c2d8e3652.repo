e_price":[372.35,false],"price":[377.35,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 1.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:150424","Cat. IDs: 190,99","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0e71f43a74dc75b1c5fc0adec0e534d6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tarjeta Gr\u00e1fica PNY GeForce RTX 4060 Ti XLR8 Gaming VERTO Triple Fan\/ 8GB GDDR6","category":"Componentes","sub_category":"Tarjetas Graficas","unit_price":377.35,"reference":"VCG4060T8TFXXPB1","ean13":"4718006455125","weight":"1.05","quantity":2,"brand":"PNY","description_pt":"<h2>PNY GeForce RTX&#8482; 4060 Ti 8GB XLR8 Gaming VERTO&#8482; EPIC-X RGB Triple Fan DLSS 3<\/h2><div><p><b>Descripci\u00f3n general<\/b><\/p><p>Las GPU NVIDIA\u00ae GeForce RTX&#8482; Serie 40 son m\u00e1s que r\u00e1pidas para jugadores y creadores. Est\u00e1n impulsados por la arquitectura ultraeficiente NVIDIA Ada Lovelace que ofrece un salto cu\u00e1ntico tanto en rendimiento como en gr\u00e1ficos impulsados por IA. Experimente mundos virtuales realistas con trazado de rayos y juegos FPS ultra altos con la latencia m\u00e1s baja. Descubra nuevas formas revolucionarias de crear y una aceleraci\u00f3n del flujo de trabajo sin precedentes.<\/p><p>Juega, transmite, crea. La GeForce RTX&#8482; 4060 Ti te permite disfrutar de los \u00faltimos juegos y aplicaciones con la arquitectura ultraeficiente NVIDIA Ada Lovelace. Experimente juegos inmersivos acelerados por IA con ray tracing y DLSS 3, y potencie su proceso creativo y productividad con NVIDIA Studio. Con iluminaci\u00f3n EPIC-X RGB electrizante, para la mejor experiencia de iluminaci\u00f3n controlable con infinitas posibilidades de iluminaci\u00f3n ARGB.<\/p><p>La nueva arquitectura NVIDIA\u00ae Ada Lovelace ofrece un salto cu\u00e1ntico en rendimiento, eficiencia y gr\u00e1ficos basados en IA. Tiene nuevos multiprocesadores de transmisi\u00f3n, n\u00facleos de trazado de rayos de tercera generaci\u00f3n y n\u00facleos de tensor de cuarta generaci\u00f3n. Se basa en un nuevo proceso TSMC 4N personalizado, se ejecuta con relojes ultrarr\u00e1pidos y cuenta con una gran cach\u00e9 L2. Permite un trazado de rayos r\u00e1pido, nuevas formas de crear y mucho m\u00e1s.<\/p><p><b>CARACTER\u00cdSTICAS CLAVE<\/b><\/p><p><ul><li>Con tecnolog\u00eda NVIDIA DLSS 3, arco Ada Lovelace ultraeficiente y trazado de rayos completo<\/li><li>N\u00facleos de trazado de rayos dedicados<\/li><li>N\u00facleos de tensor dedicados<\/li><li>NVIDIA DLSS 3<\/li><li>Controladores Game Ready y NVIDIA Studio<\/li><li>Experiencia NVIDIA\u00ae GeForce&#8482;<\/li><li>Difusi\u00f3n de NVIDIA<\/li><li>NVIDIA G-SYNC\u00ae<\/li><li>NVIDIA GPU Boost&#8482;<\/li><li>PCI Express\u00ae Gen 4<\/li><li>Microsoft DirectX\u00ae 12 \u00faltimo<\/li><li>API de Vulkan RT, Vulkan 1.3, OpenGL 4.6<\/li><li>HDCP 2.3<\/li><li>DisplayPort 1.4a, hasta 4K a 240 Hz o 8K a 60 Hz con DSC, HDR<\/li><li>Como se especifica en HDMI 2.1a: hasta 4K 240 Hz u 8K 60 Hz con DSC, Gaming VRR, HDR<\/li><\/ul><\/p><p><b>REQUERIMIENTOS M\u00cdNIMOS DEL SISTEMA<\/b><\/p><p><ul><li>Tarjeta madre compatible con PCI Express con una ranura para gr\u00e1ficos x16 de doble ancho (x8 activo)<\/li><li>Un conector de alimentaci\u00f3n suplementario de 8 pines<\/li><li>Fuente de alimentaci\u00f3n del sistema de 550 W o m\u00e1s2<\/li><li>Microsoft Windows\u00ae 11 de 64 bits, Windows 10 (noviembre de 2018 o posterior) de 64 bits, Linux de 64 bits<\/li><li>Conexi\u00f3n a Internet<\/li><\/ul><\/p><br><\/div><div><h2>Especificaciones<\/h2><p><ul><li><b>N\u00facleos CUDA<\/b><\/li><li>4352<\/li><li><b>Velocidad de reloj<\/b><\/li><li>2310 MHz<\/li><li><b>Velocidad de impulso<\/b><\/li><li>2535 MHz<\/li><li><b>Velocidad de memoria (Gbps)<\/b><\/li><li>18<\/li><li><b>Tama\u00f1o de la memoria<\/b><\/li><li>8GB GDDR6<\/li><li><b>Interfaz de memoria<\/b><\/li><li>128 bits<\/li><li><b>Ancho de banda de memoria (GB\/seg)<\/b><\/li><li>288<\/li><li><b>TDP<\/b><\/li><li>160W<\/li><li>Enlace NV<\/li><li>No soportado<\/li><li><b>Salidas<\/b><\/li><li>DisplayPort 1.4a (x3), HDMI 2.1<\/li><li>Pantalla multiple<\/li><li>4<\/li><li><b>Resoluci\u00f3n<\/b><\/li><li>7680 x 4320 a 120 Hz (digital)3<\/li><li><b>Entrada de alimentaci\u00f3n<\/b><\/li><li>Uno de 8 pines<\/li><li><b>Tipo de autob\u00fas<\/b><\/li><li>PCI-Express 4.0 x16 (x8 activo)<\/li><li><b>Dimensiones de la tarjeta<\/b><\/li><li>12,01' x 4,67' x 1,57'; Ranura doble<\/li><li><b>Dimensiones de la caja<\/b><\/li><li>14,96' x 7,56' x 2,56'<\/li><\/ul><\/p><br><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pny-gf%20rtx4060ti%20xlr8%20g%20v%208g_1.jpg","wholesale_price":"372.35","unit_price_tax":377.35},"product_model":{"product_data":{"ean13":["4718006455125"],"reference":"VCG4060T8TFXXPB1","name":{"1":"Tarjeta Gr\u00e1fica PNY GeForce RTX 4060 Ti XLR8 Gaming VERTO Triple Fan\/ 8GB GDDR6","2":"","3":"","4":""},"description":{"1":"<h2>PNY GeForce RTX&#8482; 4060 Ti 8GB XLR8 Gaming VERTO&#8482; EPIC-X RGB Triple Fan DLSS 3<\/h2><div><p><b>Descripci\u00f3n general<\/b><\/p><p>Las GPU NVIDIA\u00ae GeForce RTX&#8482; Serie 40 son m\u00e1s que r\u00e1pidas para jugadores y creadores. Est\u00e1n impulsados por la arquitectura ultraeficiente NVIDIA Ada Lovelace que ofrece un salto cu\u00e1ntico tanto en rendimiento como en gr\u00e1ficos impulsados por IA. Experimente mundos virtuales realistas con trazado de rayos y juegos FPS ultra altos con la latencia m\u00e1s baja. Descubra nuevas formas revolucionarias de crear y una aceleraci\u00f3n del flujo de trabajo sin precedentes.<\/p><p>Juega, transmite, crea. La GeForce RTX&#8482; 4060 Ti