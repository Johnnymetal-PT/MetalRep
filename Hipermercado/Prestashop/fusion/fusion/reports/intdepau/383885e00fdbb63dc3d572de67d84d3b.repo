lse],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:147429","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0ab88434b13681839d1401d66359afb2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Aro de Luz Profesional + Pantalla Trust Maku+\/ Incluye Pantalla Verde","category":"Iluminaci\u00f3n","sub_category":"Linternas y Aros de Luz","unit_price":33.879999999999995,"reference":"24881","ean13":"8713439248814","weight":"0","quantity":0,"brand":"TRUST","description_pt":"                                                <p><h2>Maku+ Kit de streaming 2 en 1<\/h2>Kit de streaming, con anillo de luz y pantalla verde, que mejorar\u00e1 tu configuraci\u00f3n de v\u00eddeo.<\/p><p><h2>Brilla con luz propia<\/h2>\u00bfEst\u00e1s listo para ser el centro de atenci\u00f3n? El led anular de 25,5 cent\u00edmetros del Maku te convierte en la estrella del espect\u00e1culo. Y con el mando a distancia Bluetooth para el disparador, solo te falta decir \u00ab\u00a1luces, c\u00e1mara y acci\u00f3n!\u00bb<\/p><p><h2>La estrella del croma<\/h2>Viaja por todo el mundo (y por el universo) con el croma plegable de 140 cent\u00edmetros de Maku. Solo tienes que fijarlo con el velcro al respaldo de la silla y podr\u00e1s elegir el fondo que m\u00e1s te guste.<\/p><p><h2>Pru\u00e9balo<\/h2>T\u00fa pones el m\u00f3vil y nosotros nos ocupamos de todo lo dem\u00e1s. Maku incluye su propio tr\u00edpode con r\u00f3tula, as\u00ed que todo lo que tienes que hacer es colocar tu m\u00f3vil en la pinza universal, pulsar el bot\u00f3n... \u00a1y a grabar!<\/p><p><h2>Baja todas las luces, menos la tuya<\/h2>Sabemos que tienes una imagen fant\u00e1stica con cualquier luz, pero Maku te ofrece la posibilidad de utilizar luz fr\u00eda, neutra o c\u00e1lida, y cuenta con un regulador de 10 pasos para adaptarla a la atm\u00f3sfera de tu v\u00eddeo.<\/p><p><h2>\u00danete al equipo stream<\/h2>Que nada te detenga. Maku es compatible con cualquier cargador o bater\u00eda externa con un simple puerto USB, para que tu viaje a la fama en internet pueda empezar hoy mismo.<\/p><p><br><h2>Especificaciones<\/h2><ul>  <li><b>Informaci\u00f3n extra<\/b><\/li>  <li>N\u00famero de referencia<\/li>  <li>24881<\/li>  <li><b>Contenido del paquete<\/b><\/li>  <li>Pantalla verde<\/li>  <li>Anillo de luz<\/li>  <li>Abrazadera flexible para tel\u00e9fono<\/li>  <li>Soporte para c\u00e1mara web<\/li>  <li>Tr\u00edpode<\/li>  <li>Cabeza esf\u00e9rica<\/li>  <li>Bot\u00f3n de obturador Bluetooth (con bater\u00eda incluida)<\/li>  <li>Gu\u00eda de usuario<\/li>  <li>Requisitos del sistema<\/li>  <li>Cargador USB o bater\u00eda externa<\/li><\/ul><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-aro%20kit%20strea%20maku%20plus_1.jpg","wholesale_price":"28.88","unit_price_tax":33.879999999999995},"product_model":{"product_data":{"ean13":["8713439248814"],"reference":"24881","name":{"1":"Aro de Luz Profesional + Pantalla Trust Maku+\/ Incluye Pantalla Verde","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Maku+ Kit de streaming 2 en 1<\/h2>Kit de streaming, con anillo de luz y pantalla verde, que mejorar\u00e1 tu configuraci\u00f3n de v\u00eddeo.<\/p><p><h2>Brilla con luz propia<\/h2>\u00bfEst\u00e1s listo para ser el centro de atenci\u00f3n? El led anular de 25,5 cent\u00edmetros del Maku te convierte en la estrella del espect\u00e1culo. Y con el mando a distancia Bluetooth para el disparador, solo te falta decir \u00ab\u00a1luces, c\u00e1mara y acci\u00f3n!\u00bb<\/p><p><h2>La estrella del croma<\/h2>Viaja por todo el mundo (y por el universo) con el croma plegable de 140 cent\u00edmetros de Maku. Solo tienes que fijarlo con el velcro al respaldo de la silla y podr\u00e1s elegir el fondo que m\u00e1s te guste.<\/p><p><h2>Pru\u00e9balo<\/h2>T\u00fa pones el m\u00f3vil y nosotros nos ocupamos de todo lo dem\u00e1s. Maku incluye su propio tr\u00edpode con r\u00f3tula, as\u00ed que todo lo que tienes que hacer es colocar tu m\u00f3vil en la pinza universal, pulsar el bot\u00f3n... \u00a1y a grabar!<\/p><p><h2>Baja todas las luces, menos la tuya<\/h2>Sabemos que tienes una imagen fant\u00e1stica con cualquier luz, pero Maku te ofrece la posibilidad de utilizar luz fr\u00eda, neutra o c\u00e1lida, y cuenta con un regulador de 10 pasos para adaptarla a la atm\u00f3sfera de tu v\u00eddeo.<\/p><p><h2>\u00danete al equipo stream<\/h2>Que nada te detenga. Maku es compatible con cualquier cargador o bater\u00eda externa con un simple puerto USB, para que tu viaje a la fama en internet pueda empezar hoy mismo.<\/p><p><br><h2>Especificaciones<\/h2><ul>  <li><b>Informaci\u00f3n extra<\/b><\/li>  <li>N\u00famero de referencia<\/li>  <li>24881<\/li>  <li><b>Contenido del paquete<\/b><\/li>  <li>Pantalla verde<\/li>  <li>Anillo de luz<\/li>  <li>Abrazadera flexible para tel\u00e9fono<\/li>  <li>Soporte para c\u00e1mara web<\/li>  <li>Tr\u00edpode<\/li>  <li>Cabeza esf\u00e9rica<\/li>  <li>Bot\u00f3n de obturador Bluetooth (con bater\u00eda incluida)<\/li>  <li>Gu\u00eda de usuario<\/li>  <li>Requisitos del sistema<\/li>  <li>Cargador USB o bater\u00eda externa<\/li><\/ul><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRUST","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":33.88,"unit_price_tax":