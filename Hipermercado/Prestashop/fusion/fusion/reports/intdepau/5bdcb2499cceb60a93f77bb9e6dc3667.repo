BM<\/li>  <li>Resoluci\u00f3n de reproducci\u00f3n de V\u00eddeo<\/li>  <li>UHD 4K (3840 x 2160) @30fps<\/li>  <li>Formatos de reproducci\u00f3n de Audio<\/li>  <li>MP3, M4A, 3GA, AAC, OGG, OGA, WAV, AMR, AWB, FLAC, MID, MIDI, XMF, MXMF, IMY, RTTTL, RTX, OTA<\/li>  <li><b>Servicios y Aplicaciones<\/b><\/li>  <li>Compatibilidad Gear<\/li>  <li>Galaxy Buds2 Pro, Galaxy Buds Pro, Galaxy Buds Live, Galaxy Buds+, Galaxy Buds2, Galaxy Buds, Galaxy Buds FE, Galaxy Fit3, Galaxy Fit2, Galaxy Fit e, Galaxy Fit, Galaxy Watch6, Galaxy Watch5, Galaxy Watch4, Galaxy Watch3, Galaxy Watch, Galaxy Watch Active2, Galaxy Watch Active<\/li>  <li>Samsung DeX Support<\/li>  <li>No<\/li>  <li>Bluetooth\u00ae Hearing Aid Support<\/li>  <li>Android Audio Streaming for Hearing Aid(ASHA)<\/li>  <li>SmartThings Support<\/li>  <li>Yes<\/li>  <li>Mobile TV<\/li>  <li>No<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":0.34,"unit_price":260.86,"unit_price_tax":260.86,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":2,"brand":"SAMSUNG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sam-sp%20a356%208-256%20bk_1.jpg"],"wholesale_price":255.86}}},"8806095457949":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["8806095457949",false],"wholesale_price":[257.8,false],"price":[262.8,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Samsung Galaxy A35 8