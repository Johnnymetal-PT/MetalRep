te<\/b><\/li><li>HUB x1<\/li><li>Manual de usuario x1<\/li><\/ul><\/p><p><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":26.92,"unit_price_tax":26.92,"tax_rules_group":null,"category":"Perif\u00e9ricos","sub_category":"Hub USB","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-hub%20tipo-c%205%20en%201%20wh_1.jpg"],"wholesale_price":21.92}}},"8435089039610":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435089039610",false],"wholesale_price":[73.59,false],"price":[78.59,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 15.5",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:236822","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/dffb73cb879dca6327b98bbb23aae03a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Silla Gaming Woxter Stinger Alien Titanium\/","category":"Perif\u00e9ricos Gaming","sub_category":"Sillas y Mesas Gaming","unit_price":78.59,"reference":"GM26-123","ean13":"8435089039610","weight":"15.5","quantity":5,"brand":"STINGER BY WOXTER","description_pt":"                                                                                                                                         