corte perfecto<\/li><li>Ajuste de precisi\u00f3n:&nbsp; presenta recortes precisos para un f\u00e1cil acceso a todos los botones, puertos y c\u00e1maras, lo que garantiza una funcionalidad completa sin ninguna obstrucci\u00f3n.<\/li><\/ul><br><h2>Especificaciones<\/h2><ul><li>Color:&nbsp; transparente<\/li><li>Material:&nbsp; PC (policarbonato) de alta calidad + TPU (poliuretano termopl\u00e1stico)<\/li><li>Imanes:&nbsp; N52 * 38 (imanes de neodimio de primera calidad)<\/li><li>Fuerza magn\u00e9tica:&nbsp;8 N&#8722;9 N<\/li><li>Compatibilidad con MagSafe:&nbsp; totalmente compatible<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0.12,"unit_price":8.98,"unit_price_tax":8.98,"tax_rules_group":null,"category":"Accesorios Apple","sub_category":"Accesorios y Perif\u00e9ricos Apple","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-funda%20kugt0-20_1.jpg"],"wholesale_price":3.98}}},"6922794786868":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6922794786868",false],"wholesale_price":[4.78,false],"price":[9.78,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.12",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:236405","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/eefafbb2db5b4be2e3bba93c4f1e5a12.jpg; <br>-------------