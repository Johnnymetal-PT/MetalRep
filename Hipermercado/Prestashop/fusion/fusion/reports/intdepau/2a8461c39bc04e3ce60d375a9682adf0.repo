s\/articulos\/800\/800\/fixed\/art_asu-d%20g13chr-71470f0570_1.jpg"],"wholesale_price":936.03}}},"4711387745649":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4711387745649",false],"wholesale_price":[459,false],"price":[464,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 8.25",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:236788","Cat. IDs: 187","Associated Categories","Cat. Default: 187","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/05f92dfbdbd14982ce0f045fea320927.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"PC Asus ExpertCenter D500SEES-513500114X Intel Core i5-13500\/ 8GB\/ 512GB SSD\/ Win11 Pro","category":"Ordenadores","sub_category":"Ordenadores Sobremesa","unit_price":464,"reference":"90PF0401-M03VU0","ean13":"4711387745649","weight":"8.25","quantity":5,"brand":"ASUS","description_pt":"<p><h2>ExpertCenter D5 (D500SE)<\/h2><p>ASUS ExpertCenter D5 SFF ofrece un rendimiento potente, fiable y ampliable, creado especialmente para las necesidades exclusivas de las peque\u00f1as empresas. Su formato peque\u00f1o, ultracompacto, flexible y elegante permite a los usuarios empresariales disfrutar de un espacio de trabajo flexible y ordenado. Adem\u00e1s, con la ayuda de nuestros servicios de soporte simplificados para peque\u00f1as empresas, puede disfrutar de un menor tiempo de inactividad y un menor coste total de propiedad.<\/p><h2>Rendimiento excepcional, sea cual sea la tarea<\/h2><p>Para simplificar todas sus tareas comerciales, el ExpertCenter D5 SFF est\u00e1 equipado con un procesador Intel Core de 13.\u00aa generaci\u00f3n de \u00faltima generaci\u00f3n con la \u00faltima memoria RAM DDR4. Una GPU discreta NVIDIA es una opci\u00f3n para quienes requieren un rendimiento gr\u00e1fico avanzado para tareas visuales exigentes.<\/p><h2>Optimice su espacio de trabajo con un dispositivo compacto<\/h2><p>Ya sea que desee ahorrar espacio, crear un espacio de trabajo ordenado, incorporar m\u00e1s computadoras en las oficinas o conectar m\u00e1s perif\u00e9ricos comerciales, el delgado y compacto ExpertCenter D5 SFF est\u00e1 hecho para usted. Para garantizar un rendimiento constante y un ruido m\u00ednimo en un paquete peque\u00f1o, optimizamos el dise\u00f1o t\u00e9rmico de ExpertCenter D5 SFF creando c\u00e1maras de aire aisladas dedicadas para los generadores de calor principales de la PC para evitar la acumulaci\u00f3n de calor en el interior, lo que garantiza un funcionamiento silencioso incluso durante su m\u00e1ximo rendimiento.<\/p><h2>Compacto y flexible<\/h2><p>Dise\u00f1ado para adaptarse a cualquier espacio de trabajo, el ExpertCenter D5 SFF tiene un chasis peque\u00f1o, moderno, compacto y elegante que puede colocarse tanto en posici\u00f3n vertical como horizontal. Por ejemplo, puede colocar un monitor a su lado o encima de \u00e9l: \u00a1usted elige!<\/p><p><br><\/p><h2>Especificaciones<\/h2><ul><li><strong>Procesador<\/strong><\/li><li>Modelo del procesador Intel Core i5-13500<\/li><li>N\u00famero de n\u00facleos de procesador 14<\/li><li>N\u00famero de hilos de ejecuci\u00f3n 20<\/li><li>Frecuencia del procesador turbo 4,8 GHz<\/li><li>N\u00facleos de rendimiento 6<\/li><li>N\u00facleos de eficiencia 8<\/li><li>Frecuencia turbo m\u00e1xima del n\u00facleo de rendimiento 4,8 GHz<\/li><li>Frecuencia turbo m\u00e1xima del n\u00facleo de eficiencia 3,5 GHz<\/li><li>Frecuencia base de n\u00facleo de rendimiento 2,5 GHz<\/li><li>Frecuencia base de n\u00facleo eficiente 1,8 GHz<\/li><li>Cach\u00e9 del procesador 24 MB<\/li><li>Tipo de cache en procesador Smart Cache<\/li><li>Potencia base del procesador 65 W<\/li><li>Potencia turbo m\u00e1xima 154 W<\/li><li><strong>Memoria<\/strong><\/li><li>Memoria interna 8 GB&nbsp;DDR4-SDRAM<\/li><li>Memoria interna m\u00e1xima 64 GB<\/li><li>Disposici\u00f3n de la memoria 1 x 8 GB<\/li><li>Ranuras de memoria 2x DIMM<\/li><li><strong>Medios de almacenaje<\/strong><\/li><li>Capacidad total de almacenaje 512 GB&nbsp;SSD<\/li><li>Capacidad total de SSD 512 GB<\/li><li>N\u00famero de unidades SSD instalados1<\/li><li>Interfaces del SDD PCI Express 4.0<\/li><li>NVMe Yes<\/li><li>Factor de forma de disco SSD M.2<\/li><li>Tarjeta de lectura integrada Yes<\/li><li><strong>Gr\u00e1ficos<\/strong><\/li><li>Adaptador de gr\u00e1ficos discreto *No<\/li><li>Adaptador gr\u00e1fico incorporado *Yes<\/li><li>Modelo de adaptador de gr\u00e1ficos discretos *No disponible<\/li><li>Fabricante de GPU (unidad de procesamiento gr\u00e1fico) integrada Intel<\/li><li>Modelo de adaptador gr\u00e1fico incorporado Intel UHD Graphics 770<\/li><li><strong>Conexi\u00f3n<\/strong><\/li><li>Ethernet *Yes<\/li><li>Ethernet LAN, velocidad de transferencia de datos 10, 100, 1000 Mbit\/s<\/li><li>Tecnolog\u00eda de cableado 10\/100\/1000 Base-T(X)<\/li><li>Wifi *Yes<\/li><li>Est\u00e1ndar Wi-Fi Wi-Fi 6 (802.11ax)<\/li><li>Wi-Fi est\u00e1ndares Wi-Fi 6 (802.11ax)<\/li><li>Tipo de antena 2x2<\/li><li>Bluetooth Yes<\/li><li>Versi\u00f3n de Bluetooth 5.2<\/li><li><strong>Puertos e Interfaces<\/strong><\/li><li>Cantidad de puertos USB 2.0 *4<\/li><li><strong>Puertos e Interfaces<\/strong><\/li><li>Cantidad de puertos tipo A USB 3.2 Gen 1 (3.1 Gen 1) *2<\/li><li>Cantidad de puertos tipo A USB 3.2 Gen 2 (3.1 Gen 2) *2<\/li><li>Cantidad de puertos VGA (D-Sub) 1<\/li><li>N\u00famero de puertos HDMI *1<\/li><li>Versi\u00f3n HDMI 1.4<\/li><li>Puerto de rat\u00f3n PS\/22<\/li><li>Ethernet LAN (RJ-45) cantidad de puertos 1<\/li><li>Micr\u00f3fono, jack de entrada Yes<\/li><li>Salidas para auriculares 2<\/li><li>Entrada de l\u00ednea Yes<\/li><li>Combo de salida de auriculares \/ micr\u00f3fono del puerto Yes<\/li><li>N\u00famero de conectores SATA III 4<\/li><li><strong>Ranuras de expansi\u00f3n<\/strong><\/li><li>PCI Express x1 (Gen 3.x) ranuras 2<\/li><li>PCI Express x16 Gen (3.x) ranuras 1<\/li><li><strong>Dise\u00f1o<\/strong><\/li><li>Tipo de chasis *SFF<\/li><li>Nombre del color Black<\/li><li>Volumen 9 L<\/li><li>Ranura para cable de seguridad Yes<\/li><li>Tipo de ranura de bloqueo del cable Kensington<\/li><li>Color del producto Negro<\/li><li>A\u00f1o de introducci\u00f3n 2024<\/li><li><strong>Desempe\u00f1o<\/strong><\/li><li>Chipset Intel B760<\/li><li>Sistema de audio Audio de alta definici\u00f3n<\/li><li>Canales de salida de audio 7.1 canales<\/li><li>Protecci\u00f3n mediante contrase\u00f1a Yes<\/li><li>Protecci\u00f3n con contrase\u00f1a Unidad de disco duro, Usuario<\/li><li>M\u00f3dulo de plataforma confiable (TPM) Yes<\/li><li><strong>Software<\/strong><\/li><li>Sistema operativo instalado Windows 11 Pro<\/li><li>Arquitectura del sistema operativo 64 bits<\/li><li><strong>Control de energ\u00eda<\/strong><\/li><li>Fuente de alimentaci\u00f3n 180 W<\/li><li>Certificaci\u00f3n 80 PLUS 80 PLUS Bronze<\/li><li><strong>Aprobaciones reguladoras<\/strong><\/li><li>Certificados de conformidad REACH<\/li><li><strong>Sostenibilidad<\/strong><\/li><li>Certificados de sostenibilidad ENERGY STAR, EPEAT Silver<\/li><li><strong>Peso y dimensiones<\/strong><\/li><li>Ancho *94,6 mm<\/li><li>Profundidad *292,7 mm<\/li><li>Altura *339,6 mm<\/li><li>Peso *5 kg<\/li><li><strong>Contenido del embalaje<\/strong><\/li><li>Rat\u00f3n incluido Yes<\/li><li>Conectividad del rat\u00f3n Al\u00e1mbrico<\/li><li>Incluye teclado Yes<\/li><li>Conectividad del teclado Al\u00e1mbrico<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_asu-d%20d500sees-513500114x_1.jpg","wholesale_price":"459.00","unit_price_tax":464},"product_model":{"product_data":{"ean13":["4711387745649"],"reference":"90PF0401-M03VU0","name":{"1":"PC Asus ExpertCenter D500SEES-513500114X Intel Core i5-13500\/ 8GB\/ 512G