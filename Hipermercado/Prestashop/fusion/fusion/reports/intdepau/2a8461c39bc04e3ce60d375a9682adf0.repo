uct ID:236810","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b0d536e51e7a22f5dd715405d2738450.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Casco para Adulto SmartGyro Helmet Urban\/ Tama\u00f1o L-M\/ Blanco","category":"Patinetes - Hoverboards","sub_category":"Accesorios para Patinetes","unit_price":36.230000000000004,"reference":"SG27-540","ean13":"8435089039696","weight":"0","quantity":0,"brand":"SMARTGYRO","description_pt":"<p><h2>Casco para Adulto SmartGyro Helmet Urban<\/h2><p>El Smart Helmet Urban ofrece un ajuste perfecto con rueda y correas ajustables, garantizando comodidad y seguridad. Su dise\u00f1o ergon\u00f3mico incluye orificios de ventilaci\u00f3n para mantenerte fresco, y proporciona una excelente protecci\u00f3n contra impactos. Adem\u00e1s, se puede cargar por USB.<\/p><p><strong>Casco recomendado para bicicletas y patinetes el\u00e9ctricos.<\/strong><\/p><h2>Caracter\u00edsticas del casco smartGyro HELMET URBAN:<\/h2><ul><li>Esponjas interiores suaves y ergon\u00f3micas y cintas ajustables<\/li><li>Luces Led traseras de alta luminosidad con 3 modos de iluminaci\u00f3n: luz fija para visibilidad constante, luz parpadeante para una mayor atenci\u00f3n, y luz flash para m\u00e1xima seguridad en movimiento.<\/li><li>Tama\u00f1o M\/L, recomendado para una circunferencia de cabeza aproximada 52-61 cm (M\/L)<\/li><li>Toma de carga USB-C<\/li><li>Medidas 26.5x20,5x12 Peso: 258 Gr<\/li><li>Medidas del paquete: 29x23x16,5 cm<\/li><\/ul><h2>Especificaciones<\/h2><ul><li><strong>Material<\/strong><\/li><li>Materiales de PC y EPS para hacer que los cascos sean m\u00e1s seguros<\/li><li><strong>Altavoces<\/strong><\/li><li>No<\/li><li><strong>Incorporan bater\u00eda<\/strong><\/li><li>S\u00ed<\/li><li><strong>Cintas ajustables<\/strong><\/li><li>S\u00ed<\/li><li><strong>Manos libres<\/strong><\/li><li>No<\/li><li><strong>Frenada inteligente<\/strong><\/li><li>S\u00ed, se activa al detectar la desaceleraci\u00f3n<\/li><li><strong>Con intermitentes y mando<\/strong><\/li><li>No<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_srg-cas%20helmet%20urban%20l-m%20wh_1.jpg","wholesale_price":"31.23","unit_price_tax":36.230000000000004},"product_model":{"product_data":{"ean13":["8435089039696"],"reference":"SG27-540","name":{"1":"Casco para Adulto SmartGyro Helmet Urban\/ Tama\u00f1o L-M\/ Blanco","2":"","3":"","4":""},"description":{"1":"<p><h2>Casco para Adulto SmartGyro Helmet Urban<\/h2><p>El Smart Helmet Urban ofrece un ajuste perfecto con rueda y correas ajustables, garantizando comodidad y seguridad. Su dise\u00f1o ergon\u00f3mico incluye orificios de ventilaci\u00f3n para mantenerte fresco, y proporciona una excelente protecci\u00f3n contra impactos. Adem\u00e1s, se puede cargar por USB.<\/p><p><strong>Casco recomendado para bicicletas y patinetes el\u00e9ctricos.<\/strong><\/p><h2>Caracter\u00edsticas del casco smartGyro HELMET URBAN:<\/h2><ul><li>Esponjas interiores suaves y ergon\u00f3micas y cintas ajustables<\/li><li>Luces Led traseras de alta luminosidad con 3 modos de iluminaci\u00f3n: luz fija para visibilidad constante, luz parpadeante para una mayor atenci\u00f3n, y luz flash para m\u00e1xima seguridad en movimiento.<\/li><li>Tama\u00f1o M\/L, recomendado para una circunferencia de cabeza aproximada 52-61 cm (M\/L)<\/li><li>Toma de carga USB-C<\/li><li>Medidas 26.5x20,5x12 Peso: 258 Gr<\/li><li>Medidas del paquete: 29x23x16,5 cm<\/li><\/ul><h2>Especificaciones<\/h2><ul><li><strong>Material<\/strong><\/li><li>Materiales de PC y EPS para hacer que los cascos sean m\u00e1s seguros<\/li><li><strong>Altavoces<\/strong><\/li><li>No<\/li><li><strong>Incorporan bater\u00eda<\/strong><\/li><li>S\u00ed<\/li><li><strong>Cintas ajustables<\/strong><\/li><li>S\u00ed<\/li><li><strong>Manos libres<\/strong><\/li><li>No<\/li><li><strong>Frenada inteligente<\/strong><\/li><li>S\u00ed, se activa al detectar la desaceleraci\u00f3n<\/li><li><strong>Con intermitentes y mando<\/strong><\/li><li>No<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SMARTGYRO","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":36.23,"unit_price_tax":36.23,"tax_rules_group":null,"category":"Patinetes - Hoverboards","sub_category":"Accesorios para Patinetes","quantity":0,"brand":"SMARTGYRO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_srg-cas%20helmet%20urban%20l-m%20wh_1.jpg"],"wholesale_price":31.23}}},"6941812791639":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6941812791639",false],"wholesale_price":[21.92,false],"price":[26.92,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:236821","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/463046bc35911bd7ac1a895056b4b50f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Docking USB 3.0 Tipo-C Xiaomi 5 en 1\/ 3xUSB\/ 1xUSB Tipo-C PD\/ 1xHDMI\/ Blanco","category":"Perif\u00e9ricos","sub_category":"Hub USB","unit_price":26.92,"reference":"TIPO-C 5 EN 1 WH","ean13":"6941812791639","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"                                                                                                <p><\/p><h2>5 puertos en 1<\/h2><p><b>Funcionalidad mejorada<\/b><\/p><p>Este vers\u00e1til concentrador 5 en 1 transforma un solo puerto Tipo-C en cinco puertos externos, incluidos tres puertos USB 3.0, un puerto Tipo-C y un puerto HDMI, abordando de manera eficaz el problema de los puertos limitados en las computadoras y cumpliendo sin esfuerzo con los amplios requisitos de la oficina.<\/p><h2>Amplia compatibilidad con m\u00faltiples sistemas<\/h2><p>Totalmente compatible con sistemas operativos Windows, Android, macOS y Linux. Admite conexiones intercambiables en caliente para una comodidad plug-and-play sin necesidad de firmware de la unidad.<\/p><h2>La transmisi\u00f3n USB 3.0 eficiente mejora las velocidades de lectura y escritura de datos<\/h2><p>Con una tasa te\u00f3rica de 5 Gbps, USB 3.0 alcanza una velocidad de transmisi\u00f3n de hasta 450 MB\/s, lo que le permite manejar 1 GB de datos en aproximadamente 3 segundos.<\/p><h2>El vers\u00e1til puerto tipo C admite tanto la transmisi\u00f3n de datos como la carga.<\/h2><p>El puerto Tipo-C admite una carga r\u00e1pida PD100W, lo que soluciona los problemas de energ\u00eda de la computadora port\u00e1til, mientras que los puertos USB 3.0 admiten la transmisi\u00f3n de datos de alta velocidad, lo que garantiza una transmisi\u00f3n de datos fluida y una carga simult\u00e1nea.<\/p><h2>El puerto digital HDMI admite resoluci\u00f3n 4K UHD<\/h2><p>Admite transmisi\u00f3n de video de ultra alta definici\u00f3n de hasta 4K a 60 Hz para obtener im\u00e1genes n\u00edtidas y experiencias de video y juegos fluidas.<\/p><h2>Ingeniosa gesti\u00f3n de cables<\/h2><p>Ranura oculta para guardar el cable para una mejor protecci\u00f3n del conector tipo C<\/p><h2>Carcasa de aleaci\u00f3n de aluminio completa.<\/h2><p>La carcasa de aleaci\u00f3n de aluminio integrada combina una sensaci\u00f3n de primera calidad con disipaci\u00f3n de calor.<\/p><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li><b>Nombre<\/b><\/li><li>HUB tipo C 5 en 1 de Xiaomi<\/li><li><b>Dimensiones<\/b><\/li><li>112,5 x 10,4 x 39 mm<\/li><li><b>Conector<\/b><\/li><li>Tipo C<\/li><li><b>Puertos<\/b><\/li><li>Tipo-C\/USB-A x 3\/HDMI<\/li><li>Temperatura ambiente de funcionamiento:<\/li><li>De 0 \u00b0C a 35 \u00b0C<\/li><li><b>Aporte<\/b><\/li><li>Conector tipo C 5 V&#9107;3 A (M\u00c1X.)<\/li><li>Puerto tipo C 20 V&#9107;5 A (M\u00c1X.)<\/li><li><b>Producci\u00f3n<\/b><\/li><li>Conector tipo C 20 V&#9107;4,5 A (M\u00c1X.)<\/li><li>Puerto tipo C 5 V&#9107;1,5 A (M\u00c1X.)<\/li><li>Puertos USB-A 5 V&#9107;1,5 A (M\u00c1X.)<\/li><li>*El puerto HDMI admite una resoluci\u00f3n de 4K a 60 Hz (M\u00c1X.)<\/li><li><b>Contenido del paquete<\/b><\/li><li>HUB x1<\/li><li>Manual de usuario x1<\/li><\/ul><\/p><p><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-hub%20tipo-c%205%20en%201%20wh_1.jpg","wholesale_price":"21.92","unit_price_tax":26.92},"product_model":{"product_data":{"ean13":["6941812791639"],"reference":"TIPO-C 5 EN 1 WH","name":{"1":"Docking USB 3.0 Tipo-C Xiaomi 5 en 1\/ 3xUSB\/ 1xUSB Tipo-C PD\/ 1xHDMI\/ Blanco","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><\/p><h2>5 puertos en 1<\/h2><p><b>Funcionalidad mejorada<\/b><\/p><p>Este vers\u00e1til concentrador 5 en 1 transforma un solo puerto Tipo-C en cinco puertos externos, incluidos tres puertos USB 3.0, un puerto Tipo-C y un puerto HDMI, abordando de manera eficaz el problema de los puertos limitados en las computadoras y cumpliendo sin esfuerzo con los amplios requisitos de la oficina.<\/p><h2>Amplia compatibilidad con m\u00faltiples sistemas<\/h2><p>Totalmente compatible con sistemas operativos Windows, Android, macOS y Linux. Admite conexiones intercambiables en caliente para una comodidad plug-and-play sin necesidad de firmware de la unidad.<\/p><h2>La transmisi\u00f3n