ription_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"JABRA","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":33.98,"unit_price_tax":33.98,"tax_rules_group":null,"category":"Accesorios de SmartPhones","sub_category":"Auriculares SmartPhones","quantity":0,"brand":"JABRA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_jab-aur%20talk%2015%20se_1.jpg"],"wholesale_price":28.98}}},"6935364030216":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6935364030216",false],"wholesale_price":[12.49,false],"price":[17.49,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.06",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:74065","Cat. IDs: 89,89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/815356d552e5b7af2d3f5d5addf7262b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Modulo SFP Transceptor de Fibra \u00d3ptica TP-Link TL-SM311LS","category":"Adaptadores","sub_category":"Adaptadores de Red","unit_price":17.490000000000002,"reference":"TL-SM311LS","ean13":"6935364030216","weight":"0.06","quantity":2,"brand":"TP-LINK","description_pt":"<p>Los m\u00f3dulos para fibra de la serie TL-SM311 han sido dise\u00f1adas para ampliar la distancia de transferencia cuando se conectan a nuestros switches gestionados Web Smart. Gracias a ellos, es posible ampliar la distancia de transmisi\u00f3n a varios kil\u00f3metros, incluso a decenas de ellos, lo que puede satisfacer las necesidades de cualquier tipo de red local. El usuario puede escoger con qu\u00e9 dispositivos utilizar los m\u00f3dulos en funci\u00f3n de la demanda a fin de rebajar los costes.<br><\/p><p><\/p><ul><li>M\u00f3dulo MiniGBIC monomodo<\/li><li>Serie T3700 compatible, serie T2700, serie T2600, serie T2500, serie T1700, serie T1600, serie T1500, switches de la serie 2\/3\/5 y MC220L<\/li><\/ul><div><br><\/div><ul><li><b>CONVERTIDOR DE MEDIOS Y M\u00d3DULO<\/b><\/li><li>Est\u00e1ndares y Protocolos IEEE 802.3z, CSMA\/CD, TCP\/IP<\/li><li>Longitud de Onda 1310nm<\/li><li>Fuente de Alimentaci\u00f3n 3.3V<\/li><li>Seguridad y Emisi\u00f3n FCC, CE<\/li><li>Cable Fibra monomodo<\/li><li>Tipo de Fibra 9\/125 &#956;m monomodo<\/li><li>M\u00e1x. Longitud de Cable 10km<\/li><li>Tasa de Dato 1.25Gbps<\/li><li>Tipo de Puertos LC\/UPC<\/li><li>Ambiente&nbsp;<\/li><li>Temperatura de funcionamiento: 0&#8451;~70&#8451; (32&#8457;~158&#8457;)<\/li><li>Temperatura de almacenamiento: -40&#8451;~80&#8451; (-40&#8457;~176&#8457;)<\/li><li>Humedad de funcionamiento: 10%~90% sin condensaci\u00f3n<\/li><li>Humedad de almacenamiento: 5%~90% sin condensaci\u00f3n<\/li><\/ul><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tpl-modulo%20tl-sm311ls_1.jpg","wholesale_price":"12.49","unit_price_tax":17.490000000000002},"product_model":{"product_data":{"ean13":["6935364030216"],"reference":"TL-SM311LS","name":{"1":"Modulo SFP Transceptor de Fibra \u00d3ptica TP-Link TL-SM311LS","2":"","3":"","4":""},"description":{"1":"<p>Los m\u00f3dulos para fibra de la serie TL-SM311 han sido dise\u00f1adas para ampliar la distancia de transferencia cuando se conectan a nuestros switches gestionados Web Smart. Gracias a ellos, es posible ampliar la distancia de transmisi\u00f3n a varios kil\u00f3metros, incluso a decenas de ellos, lo que puede satisfacer las necesidades de cualquier tipo de red local. El usuario puede escoger con qu\u00e9 dispositivos utilizar los m\u00f3dulos en funci\u00f3n de la demanda a fin de rebajar los costes.<br><\/p><p><\/p><ul><li>M\u00f3dulo MiniGBIC monomodo<\/li><li>Serie T3700 compatible, serie T2700, serie T2600, serie T2500, serie T1700, serie T1600, serie T1500, switches de la serie 2\/3\/5 y MC220L<\/li><\/ul><div><br><\/div><ul><li><b>CONVERTIDOR DE MEDIOS Y M\u00d3DULO<\/b><\/li><li>Est\u00e1ndares y Protocolos IEEE 802.3z, CSMA\/CD, TCP\/IP<\/li><li>Longitud de Onda 1310nm<\/li><li>Fuente de Alimentaci\u00f3n 3.3V<\/li><li>Seguridad y Emisi\u00f3n FCC, CE<\/li><li>Cable Fibra monomodo<\/li><li>Tipo de Fibra 9\/125 &#956;m monomodo<\/li><li>M\u00e1x. Longitud de Cable 10km<\/li><li>Tasa de Dato 1.25Gbps<\/li><li>Tipo de Puertos LC\/UPC<\/li><li>Ambiente&nbsp;<\/li><li>Temperatura de funcionamiento: 0&#8451;~70&#8451; (32&#8457;~158&#8457;)<\/li><li>Temperatura de almacenamiento: -40&#8451;~80&#8451; (-40&#8457;~176&#8457;)<\/li><li>Humedad de funcionamiento: 10%~90% sin condensaci\u00f3n<\/li><li>Humedad de almacenamiento: 5%~90% sin condensaci\u00f3n<\/li><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TP-LINK","supplier":null,"width":null,"height":null,"depth":null,"weight":0.06,"unit_price":17.49,"unit_price_tax":17.49,"tax_rules_group":null,"category":"Adaptadores","sub_category":"Adaptadores de Red","quantity":2,"brand":"TP-LINK","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tpl-modulo%20tl-sm311ls_1.jpg"],"wholesale_price":12.49}}},"6935364072933":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6935364072933",false],"wholesale_price":[9,false],"price":[14,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.04",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:74067","Cat. IDs: 89,89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/aba73dcfe9a028095f2a0f0441f8f305.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Modulo SFP Transceptor de Fibra \u00d3ptica TP-Link TL-SM321A-2 Bidireccional","category":"Adaptadores","sub_category":"Adaptadores de Red","unit_price":14,"reference":"TL-SM321A-2","ean13":"6935364072933","weight":"0.04","quantity":2,"brand":"TP-LINK","description_pt":"<p><\/p><p>El TL-SM321A-2 de TP-LINK se desarrolla de acuerdo con el acuerdo de m\u00faltiples fuentes conectables de formato peque\u00f1o (SFP-MSA). Como transceptor \u00f3ptico bidireccional WDM, el TL-SM321A-2 utiliza un conector de interfaz \u00f3ptica bidireccional LC integrado y el enlace de datos es de hasta 2 km en SMF (fibra monomodo) de 9\/125 &#956;m.<\/p><p>Adem\u00e1s, TL-SM321A-2 incorpora la funci\u00f3n de Monitoreo de diagn\u00f3stico digital (DDM) que es compatible con SFF-8472. DDM admite la supervisi\u00f3n en tiempo real del transceptor y muestra los par\u00e1metros, incluida la corriente del transceptor que transmite \/ recibe potencia \u00f3ptica y temperatura de funcionamiento.<\/p><p>El TL-SM321A-2 de TP-Link se utiliza en la pr\u00e1ctica para redes de fibra de corta y media distancia, y proporciona una conexi\u00f3n de fibra gigabit r\u00e1pida y estable para conmutadores, enrutadores, servidores, etc.<\/p><ul><li>Adopta el \u00faltimo est\u00e1ndar 1000Base-BX<\/li><li>Distancia de transmisi\u00f3n de hasta 2 km en SMF (fibra monomodo) de 9\/125 &#956;m<\/li><li>Compatible con el acuerdo de m\u00faltiples fuentes conectables de formato peque\u00f1o (SFP-MSA)<\/li><li>Soporta monitorizaci\u00f3n&nbsp;de diagn\u00f3stico digital (DDM)<\/li><li>Admite intercambio en caliente<\/li><\/ul><br><p><\/p><p><p><ul><li><b>CARACTER\u00cdSTICAS DE HARDWARE<\/b><\/li><li>DDM Si<\/li><li>SFP-MSA Si<\/li><li>Hot Swappable Si<\/li><li><b>CONVERTIDOR DE MEDIOS Y M\u00d3DULO<\/b><\/li><li>Est\u00e1ndares y Protocolos IEEE 802.3z, TCP\/IP<\/li><li>Longitud de Onda<\/li><li>TX: 1550 nm<\/li><li>RX: 1310 nm<\/li><li>Fuente de Alimentaci\u00f3n 3.3 V<\/li><li>Seguridad y Emisi\u00f3n<\/li><li>FCC, CE<\/li><li>Cable<\/li><li>Fibra monomodo<\/li><li>Tipo de Fibra<\/li><li>9\/125 &#956;m monomodo<\/li><li>M\u00e1x. Longitud de Cable 2 KM<\/li><li>Tasa de Dato<\/li><li>1.25 Gbps<\/li><li>Tipo de Puertos<\/li><li>LC Simplex<\/li><li>Ambiente<\/li><li>Temperatura de funcionamiento: 0 a 70 \u00b0 C (32 a 158 \u00b0 F)<\/li><li>Temperatura de almacenamiento: -40&#8211;85 \u00b0 C (-40&#8211;185 \u00b0 F)<\/li><li>Humedad de funcionamiento: 10 a 90% de humedad relativa, sin condensaci\u00f3n<\/li><li>Humedad de almacenamiento: 5&#8211;90% RH, sin condensaci\u00f3n<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tpl-modulo%20tl-sm321a-2_1.jpg","wholesale_price":"9.00","unit_price_tax":14},"product_model":{"product_data":{"ean13":["6935364072933"],"reference":"TL-SM321A-2","name":{"1":"Modulo SFP Transceptor de Fibra \u00d3ptica TP-Link TL-SM321A-2 Bidireccional","2":"","3":"","4":""},"description":{"1":"<p><\/p><p>El TL-SM321A-2 de TP-LINK se desarrolla de acuerdo con el acuerdo de m\u00faltiples fuentes conectables de formato peque\u00f1o (SFP-MSA). Como transceptor \u00f3ptico bidireccional WDM, el TL-SM321A-2 utiliza un conector de interfaz \u00f3ptica bidireccional LC integrado y el enlace de datos es de hasta 2 km en SMF (fibra monomodo) de 9\/125 &#956;m.<\/p><p>Adem\u00e1s, TL-SM321A-2 incorpora la funci\u00f3n de Monitoreo de diagn\u00f3stico digital (DDM) que es compatible con SFF-847