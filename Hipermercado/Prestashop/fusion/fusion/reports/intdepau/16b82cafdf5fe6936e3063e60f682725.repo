edquida ML-PRO120 es compatible con una amplia variedad de sockets de CPU, incluyendo INTEL LGA 2066\/2011\/1700\/1200\/1156\/1155\/1151\/1150 y AMD AM5\/AM4\/AM3+\/AM3\/AM2+\/AM2\/FM2\/FM1. La versatilidad est\u00e1 a tu alcance.<\/p><p><br><\/p><p><ul><li><b>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/b><\/li><li>Peso<\/li><li>765g<\/li><li>TDP<\/li><li>220W<\/li><li>Longitud \/ Material Tubos<\/li><li>330mm \/ Teflon<\/li><li>Dimensiones \/ Material Radiador<\/li><li>153x120x27mm \/ Aluminio<\/li><li>Socket<\/li><li>INTEL LGA 2066\/2011\/1700\/1200\/1156\/1155\/1151\/1150 y AMD AM5\/AM4\/AM3+\/AM3\/AM2+\/AM2\/FM2\/FM1<\/li><li><b>BOMBA<\/b><\/li><li>Dimensiones<\/li><li>68x68x42mm<\/li><li>Velocidad<\/li><li>3000 RPM\u00b110%<\/li><li>Material del bloque<\/li><li>Cobre<\/li><li><b>CONTENIDO DE LA CAJA<\/b><\/li><li>Refrigeraci\u00f3n l\u00edquida + 1x Ventiladores + Soporte backplate Intel LGA 115X + Soporte AMD + Fijaciones + Pasta t\u00e9rmica + Manual<\/li><\/ul><\/p><div><br><\/div><br><p><\/p><div><br><\/div>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":35.61,"unit_price_tax":35.61,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Ventiladores","quantity":0,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-ref%20ml-pro120%20bk_1.jpg"],"wholesale_price":30.61}}},"4711387059463":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["4711387059463",false],"wholesale_price":[421.17,false],"price":[426.17,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"f