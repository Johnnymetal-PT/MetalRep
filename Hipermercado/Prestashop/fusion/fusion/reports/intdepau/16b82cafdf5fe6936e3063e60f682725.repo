_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:161611","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/77f598310aa4f5702d91f423e808c164.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cable HDMI 2.1 8K Vention AALBF\/ HDMI Macho - HDMI Macho\/ 1m\/ Gris y Negro","category":"Cables","sub_category":"Cables HDMI","unit_price":12.07,"reference":"AALBF","ean13":"6922794742666","weight":"0","quantity":0,"brand":"VENTION","description_pt":"<p><h2>Cable HDMI 2.1 chapado en oro y compatible con una resoluci\u00f3n de hasta 8K.<\/h2>Este cable HDMI garantiza la mejor calidad de imagen en su sala de estar. Gracias a la \u00faltima versi\u00f3n de HDMI (2.1), este cable puede admitir una resoluci\u00f3n 3D de hasta 8K (7680x4320P). El cable tiene una frecuencia de actualizaci\u00f3n de 120 Hz con resoluci\u00f3n 4K y 60 Hz con resoluci\u00f3n 8K, por lo que no experimentar\u00e1s ning\u00fan tartamudeo en la imagen. Esto es especialmente \u00fatil para los jugadores entre nosotros.<br><br><h2>eARC HiFi<\/h2>HDMI 2.1 presenta un canal de retorno de audio mejorado (eARC), una mejora con respecto al canal de retorno de audio (ARC) anterior. eARC simplifica la conectividad y proporciona una mayor facilidad de uso para el descubrimiento de m\u00faltiples componentes y la optimizaci\u00f3n de audio. Admite los \u00faltimos formatos de audio de alta tasa de bits de hasta 192 kHz, 5.1 y 7.1 de 24 bits y sin comprimir, y audio sin comprimir de 32 canales. Tambi\u00e9n es compatible con DTS-HD Master Audio&#8482;, DTS:X\u00ae, Dolby\u00ae TrueHD, Dolby Atmos\u00ae. Ahora es m\u00e1s f\u00e1cil que nunca experimentar un sonido con calidad cinematogr\u00e1fica en una sala de estar para disfrutar de una experiencia inmersiva multidimensional y un detalle y profundidad de audio mejorados.<br><br><h2>VRR<\/h2>Uno de los aspectos m\u00e1s destacados de las m\u00faltiples funciones multimedia y de juegos de la especificaci\u00f3n HDMI 2.1 es la frecuencia de actualizaci\u00f3n variable. VRR reduce o elimina el retraso, la vibraci\u00f3n y el desgarro del cuadro para lograr un juego m\u00e1s fluido y detallado. VRR permite que una fuente de juego, como una consola o una computadora, entregue cuadros de video lo m\u00e1s r\u00e1pido posible, lo que en muchos casos es m\u00e1s lento que la frecuencia de actualizaci\u00f3n est\u00e1tica normal.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>HDMI: 2.1a<\/li>  <li>Longitud: 1m<\/li>  <li>Peso: 158 gr<\/li>  <li>Resoluci\u00f3n: 8K, 4K y 1080P<\/li>  <li>eARC<\/li>  <li>VRR<\/li>  <li>HDR<\/li>  <li>Frecuencia de actualizaci\u00f3n: 60 Hz con 8K, 120 Hz con 4K y 1080P<\/li>  <li>Tipo de conector: HDMI macho A<\/li>  <li>Chapado en oro<\/li>  <li>Conductor: Cobre y cobre plateado.<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-cab%20hdmi%20aalbf_1.jpg","wholesale_price":"7.07","unit_price_tax":12.07},"product_model":{"product_data":{"ean13":["6922794742666"],"reference":"AALBF","name":{"1":"Cable HDMI 2.1 8K Vention AALBF\/ HDMI Macho - HDMI Macho\/ 1m\/ Gris y Negro","2":"","3":"","4":""},"description":{"1":"<p><h2>Cable HDMI 2.1 chapado en oro y compatible con una resoluci\u00f3n de hasta 8K.<\/h2>Este cable HDMI garantiza la mejor calidad de imagen en su sala de estar. Gracias a la \u00faltima versi\u00f3n de HDMI (2.1), este cable puede admitir una resoluci\u00f3n 3D de hasta 8K (7680x4320P). El cable tiene una frecuencia de actualizaci\u00f3n de 120 Hz con resoluci\u00f3n 4K y 60 Hz con resoluci\u00f3n 8K, por lo que no experimentar\u00e1s ning\u00fan tartamudeo en la imagen. Esto es especialmente \u00fatil para los jugadores entre nosotros.<br><br><h2>eARC HiFi<\/h2>HDMI 2.1 presenta un canal de retorno de audio mejorado (eARC), una mejora con respecto al canal de retorno de audio (ARC) anterior. eARC simplifica la conectividad y proporciona una mayor facilidad de uso para el descubrimiento de m\u00faltiples componentes y la optimizaci\u00f3n de audio. Admite los \u00faltimos formatos de audio de alta tasa de bits de hasta 192 kHz, 5.1 y 7.1 de 24 bits y sin comprimir, y audio sin comprimir de 32 canales. Tambi\u00e9n es compatible con DTS-HD Master Audio&#8482;, DTS:X\u00ae, Dolby\u00ae TrueHD, Dolby Atmos\u00ae. Ahora es m\u00e1s f\u00e1cil que nunca experimentar un sonido con calidad cinematogr\u00e1fica en una sala de estar para disfrutar de una experiencia inmersiva multidimensional y un detalle y profundidad de audio mejorados.<br><br><h2>VRR<\/h2>Uno de los aspectos m\u00e1s destacados de las m\u00faltiples funciones multimedia y de juegos de la especificaci\u00f3n HDMI 2.1 es la frecuencia de actualizaci\u00f3n variable. VRR reduce o elimina el retraso, la vibraci\u00f3n y el desgarro del cuadro para lograr un juego m\u00e1s fluido y detallado. VRR permite que una fuente de juego, como una consola o una computadora, entregue cuadros de video lo m\u00e1s r\u00e1pido posible, lo que en muchos casos es m\u00e1s lento que la frecuencia de actualizaci\u00f3n est\u00e1tica normal.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>HDMI: 2.1a<\/li>  <li>Longitud: 1m<\/li>  <li>Peso: 158 gr<\/li>  <li>Resoluci\u00f3n: 8K, 4K y 1080P<\/li>  <li>eARC<\/li>  <li>VRR<\/li>  <li>HDR<\/li>  <li>Frecuencia de actualizaci\u00f3n: 60 Hz con 8K, 120 Hz con 4K y 1080P<\/li>  <li>Tipo de conector: HDMI macho A<\/li>  <li>Chapado en oro<\/li>  <li>Conductor: Cobre y cobre plateado.<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywor