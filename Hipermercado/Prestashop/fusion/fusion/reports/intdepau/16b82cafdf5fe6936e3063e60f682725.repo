write":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":7.08,"unit_price_tax":7.08,"tax_rules_group":null,"category":"Accesorios","sub_category":"Herramientas - Limpieza","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-org%20kbsb0-2_1.jpg"],"wholesale_price":2.08}}},"6922794768987":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6922794768987",false],"wholesale_price":[48.54,false],"price":[53.54,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["O comprimento da propriedade Product->name \u00e9 atualmente de 142 carateres. O intervalo tem de estar entre 0 e 128 carateres. Name: Docking USB Type-C Vention TTHC\/ 1xHDMI\/ 1xVGA\/ 3xUSB\/ 1xUSB Type-C\/ 1xUSB Type-C PD\/ 1xRJ45\/ 1xSD e leitor de cart\u00e3o MicroSD\/ Jack 3.5\/ Cinza"],"result":false},"feed_data":{"name_pt":"Docking USB Tipo-C Vention THTHC\/ 1xHDMI\/ 1xVGA\/ 3xUSB\/ 1xUSB Tipo-C\/ 1xUSB Tipo-C PD\/ 1xRJ45\/ 1xLector Tarjetas SD y MicroSD\/ Jack 3.5\/ Gris","category":"Accesorios de Portatiles","sub_category":"Dockstations","unit_price":53.54,"reference":"THTHC","ean13":"6922794768987","weight":"0","quantity":0,"brand":"VENTION","description_pt":"<h2>USB-C multifunci\u00f3n a HDMI\/VGA\/USB-C Gen 1\/USB 3.0x2\/USB 2.0\/RJ45\/SD\/TF\/TRRS 3,5 mm\/PD<\/h2><div><h2>Expansi\u00f3n masiva<\/h2><div><h2>Para el modo TV de tu Nintendo Switch<\/h2><p>Conecta tu Nintendo Switch para disfrutar de juegos en HD en tu televisor.<\/p><h2>Puertos de v\u00eddeo duales HDMI+VGA<\/h2><p>Puede trabajar de manera m\u00e1s eficiente con una pantalla grande e im\u00e1genes de alta calidad en dispositivos compatibles con HDMI\/VGA, como TV, proyector o monitor.<\/p><h2>Transmisi\u00f3n de datos r\u00e1pida USB-C<\/h2><p>Con interfaz USB-C Gen 1, admite disco duro USB-C, disco U y lector de tarjetas<\/p><h2>Carga r\u00e1pida PD de hasta 100 W<\/h2><p>La entrega de energ\u00eda de 100 W (PD 3.0) permite cargar una computadora port\u00e1til mientras se utilizan otros puertos de nuestra estaci\u00f3n de acoplamiento 11 en 1.<\/p><h2>Maximice la eficiencia de su trabajo<\/h2><p>2 * puertos USB 3.0 de s\u00faper velocidad y 1 * puerto USB 2.0 conectan el mouse, el teclado, el disco U y otros dispositivos para una transferencia de datos sin esfuerzo y sin demoras. Una estaci\u00f3n de acoplamiento puede cambiar completamente su oficina en casa o su espacio de trabajo.<\/p><h2>Ranura para tarjeta SD\/TF<\/h2><p>Con ranura para tarjeta dual para que los dispositivos accedan a archivos r\u00e1pidamente desde el lector de tarjetas SD\/TF, ideal para fot\u00f3grafos, dise\u00f1adores o editores de v\u00eddeo, etc.<\/p><h2>Puerto Gigabit Ethernet<\/h2><p>Proporciona una conexi\u00f3n estable y r\u00e1pida a una red cableada<\/p><h2>Disfruta de la m\u00fasica en cualquier momento y lugar<\/h2><p>Conecte los auriculares\/altavoz a su computadora port\u00e1til a trav\u00e9s del puerto de audio de 3,5 mm<\/p><h2>Chip potente<\/h2><p>Cada funci\u00f3n se realiza mediante un chip independiente y la funci\u00f3n multifunci\u00f3n se mantiene estable y fluida cuando se usa al mismo tiempo.<\/p><h2>Plug &amp; Play sin unidad<\/h2><p>Compatible con Win 11\/10\/8\/7\/Vista\/XP, Mac OS Linux, iOS, Android OS y otros sistemas operativos.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li>Color : Gris<\/li><li>Interfaz : USB-C 3.1, VGA, HDML, USB-C Gen 1 USB 3.0*2, USB 2.0, RJ45, SD\/TF TRRS<\/li><li>3,5 mm, T\u00e9cnicas de interfaz PD : Niquelado<\/li><li>Velocidad de transmisi\u00f3n : 5 Gbps (USB-C Gen 1\/USB 3.0) 480 Mbps (USB 2.0)<\/li><li>Resoluci\u00f3n : HDMI: 4K@30HZ, VGA: 1080P@60Hz Salida simult\u00e1nea: 1080P@60Hz<\/li><li>RJ45 : 1000Mbps<\/li><li>Conductor : Cobre esta\u00f1ado<\/li><li>Carcasa: Aleaci\u00f3n de aluminio<\/li><li>Cubierta: TPE<\/li><li>AWG: 32AWG<\/li><li>OD: 4,5 mm+0,2 mm<\/li><li>Longitud: 0,25 m+0,01 m (longitud neta)<\/li><li>Potencia nominal: 100 W<\/li><li>Tipo de ranura para tarjeta: 2.0 SD 1-LUN<\/li><li>Tarjeta de memoria compatible: Micro SD\/Micro SDHC\/Micro SDXC Compatible con SDHC\/SDXC<\/li><li>Capacidad de tarjeta de memoria: 256G<\/li><li>Lectura y escritura simult\u00e1neas: No compatible<\/li><\/ul><\/p><br><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-dock%20ththc_1.jpg","wholesale_price":"48.54","unit_price_tax":53.54},"product_model":{"product_data":{"ean13":["6922794768987"],"reference":"THTHC","name":{"1":"Docking USB Tipo-C Vention THTHC\/ 1xHDMI\/ 1xVGA\/ 3xUSB\/ 1xUSB Tipo-C\/ 1xUSB Tipo-C PD\/ 1xRJ45\/ 1xLector Tarjetas SD y MicroSD\/ Jack 3.5\/ Gris","2":"","3":"","4":""},"description":{"1":"<h2>USB-C multifunci\u00f3n a HDMI\/VGA\/USB-C Gen 1\/USB 3.0x2\/USB 2.0\/RJ45\/SD\/TF\/TRRS 3,5 mm\/PD<\/h2><div><h2>Expansi\u00f3n masiva<\/h2><div><h2>Para el modo TV de tu Nintendo Switch<\/h2><p>Conecta tu Nintendo Switch para disfrutar de juegos en HD en tu televisor.<\/p><h2>Puertos de v\u00eddeo duales HDMI+VGA<\/h2><p>Puede trabajar de manera m\u00e1s eficiente con una pantalla grande e im\u00e1genes de alta calidad en dispositivos compatibles con HDMI\/VGA, como TV, proyector o monitor.<\/p><h2>Transmisi\u00f3n de datos r\u00e1pida USB-C<\/h2><p>Con interfaz USB-C Gen 1, admite disco duro USB-C, disco U y lector de tarjetas<\/p><h2>Carga r\u00e1pida PD de hasta 100 W<\/h2><p>La entrega de energ\u00eda de 100 W (PD 3.0) permite cargar una computadora port\u00e1til mientras se utilizan otros puertos de nuestra estaci\u00f3n de acoplamiento 11 en 1.<\/p><h2>Maximice la eficiencia de su trabajo<\/h2><p>2 * puertos USB 3.0 de s\u00faper velocidad y 1 * puerto USB 2.0 conectan el mouse, el teclado, el disco U y otros dispositivos para una transferencia de datos sin esfuerzo y sin demoras. Una estaci\u00f3n de acoplamiento puede cambiar completamente su oficina en casa o su espacio de trabajo.<\/p><h2>Ranura para tarjeta SD\/TF<\/h2><p>Con ranura para tarjeta dual para que los dispositivos accedan a archivos r\u00e1pidamente desde el lector de tarjetas SD\/TF, ideal para fot\u00f3grafos, dise\u00f1adores o editores de v\u00eddeo, etc.<\/p><h2>Puerto Gigabit Ethernet<\/h2><p>Proporciona una conexi\u00f3n estable y r\u00e1pida a una red cableada<\/p><h2>Disfruta de la m\u00fasica en cualquier momento y lugar<\/h2><p>Conecte los auriculares\/altavoz a su computadora port\u00e1til a trav\u00e9s del puerto de audio de 3,5 mm<\/p><h2>Chip potente<\/h2><p>Cada funci\u00f3n se realiza mediante un chip independiente y la funci\u00f3n multifunci\u00f3n se mantiene estable y fluida cuando se usa al mismo tiempo.<\/p><h2>Plug &amp; Play sin unidad<\/h2><p>Compatible con Win 11\/10\/8\/7\/Vista\/XP, Mac OS Linux, iOS, Android OS y otros sistemas operativos.<\/p><br><\/div><h2>Especificaciones<\/h2><p><ul><li>Color : Gris<\/li><li>Interfaz : USB-C 3.1, VGA, HDML, USB-C Gen 1 USB 3.0*2, USB 2.0, RJ45, SD\/TF TRRS<\/li><li>3,5 mm, T\u00e9cnicas de interfaz PD : Niquelado<\/li><li>Velocidad de transmisi\u00f3n : 5 Gbps (USB-C Gen 1\/USB 3.0) 480 Mbps (USB 2.0)<\/li><li>Resoluci\u00f3n : HDMI: 4K@30HZ, VGA: 1080P@60Hz Salida simult\u00e1nea: 1080P@60Hz<\/li><li>RJ45 : 1000Mbps<\/li><li>Conductor : Cobre esta\u00f1ado<\/li><li>Carcasa: Aleaci\u00f3n de aluminio<\/li><li>Cubierta: TPE<\/li><li>AWG: 32AWG<\/li><li>OD: 4,5 mm+0,2 mm<\/li><li>Longitud: 0,25 m+0,01 m (longitud neta)<\/li><li>Potencia nominal: 100 W<\/li><li>Tipo de ranura para tarjeta: 2.0 SD 1-LUN<\/li><li>Tarjeta de memoria compatible: Micro SD\/Micro SDHC\/Micro SDXC Compatible con SDHC\/SDXC<\/li><li>Capacidad de tarjeta de memoria: 256G<\/li><li>Lectura y escritura simult\u00e1neas: No compatible<\/li><\/ul><\/p><br><\/div>","2":"","3":"","4":""},"descript