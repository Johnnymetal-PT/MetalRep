ght%20mwty3zmbardera_1.jpg"],"wholesale_price":12.43}}},"8435568405790":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435568405790",false],"wholesale_price":[53.18,false],"price":[58.18,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 6.3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:211471","Cat. IDs: 36","Associated Categories","Cat. Default: 36","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c48a57367cfaf1ed195d70cf10c9f523.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Ventilador de Suelo Orbegozo PWN 2050\/ 155W\/ 3 Aspas 50cm\/ 3 velocidades","category":"Calefaccion y Clima","sub_category":"Ventiladores y Climatizadores","unit_price":58.18,"reference":"18086","ean13":"8435568405790","weight":"6.3","quantity":2,"brand":"ORBEGOZO","description_pt":"<p>En los calurosos d\u00edas de verano, un ventilador industrial&nbsp; PWN 2050 se convierte en un aliado indispensable para mantenernos frescos y c\u00f3modos. Estos robustos dispositivos no solo son ideales para espacios industriales, sino tambi\u00e9n para talleres, almacenes, oficinas y hogares.<br><br>Con 155 W de potencia, este ventilador no se anda con rodeos. Su motor de alto rendimiento garantiza un flujo de aire constante y vigoroso. Ya sea que est\u00e9s en una f\u00e1brica o en tu taller personal, este ventilador no te defraudar\u00e1. Las aspas de 50 cent\u00edmetros de di\u00e1metro son la clave para su eficiencia. Su dise\u00f1o aerodin\u00e1mico permite mover grandes vol\u00famenes de aire sin esfuerzo. Imagina la brisa refrescante que proporcionar\u00e1 en un d\u00eda caluroso.<br><br>Con tres velocidades de ventilaci\u00f3n, puedes adaptar el flujo de aire seg\u00fan tus necesidades. Desde una brisa suave hasta un vendaval vigorizante, este ventilador tiene la flexibilidad para satisfacer tus preferencias. El t\u00e9rmino &#8220;industrial&#8221; no es en vano. Este ventilador ofrece un gran caudal de aire, lo que significa que incluso en los espacios m\u00e1s amplios, sentir\u00e1s su efecto refrescante.<br><br>La rejilla de seguridad es una caracter\u00edstica crucial. Protege tus dedos curiosos y evita accidentes. Puedes estar tranquilo sabiendo que este ventilador est\u00e1 dise\u00f1ado pensando en la seguridad. El asa de transporte facilita moverlo de un lugar a otro. Si necesitas cambiarlo de posici\u00f3n o llevarlo a otra \u00e1rea, este ventilador no te dar\u00e1 dolores de espalda. \u00bfNecesitas dirigir el flujo de aire hacia arriba o hacia abajo? No hay problema. La inclinaci\u00f3n regulable te permite personalizar la direcci\u00f3n del viento seg\u00fan tus preferencias.<br><br>Nada es m\u00e1s frustrante que un ventilador que se tambalea. La base estable de este modelo garantiza que permanezca firme en su lugar, incluso cuando est\u00e1 funcionando a m\u00e1xima potencia.<br><br>En resumen, el PWN 2050 combina potencia, seguridad y versatilidad en un solo dispositivo. Ya sea en un taller bullicioso o en tu garaje, este ventilador te mantendr\u00e1 fresco y concentrado. As\u00ed que, la pr\u00f3xima vez que sientas el calor sofocante, enciende tu ventilador industrial y disfruta de la brisa revitalizante que ofrece.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Potencia: 155 W.<\/li>  <li>Taman&#771;o de aspas: 50 cm.<\/li>  <li>3 velocidades de ventilacio&#769;n.<\/li>  <li>Gran caudal de aire.<\/li>  <li>Rejilla de seguridad.<\/li>  <li>Asa para transporte.<\/li>  <li>Inclinacio&#769;n regulable.<\/li>  <li>Base estable.<\/li>  <li>Conexio&#769;n: 230 V ~ 50 Hz.<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_orb-vent%20pwn%202050_1.jpg","wholesale_price":"53.18","unit_price_tax":58.18},"product_model":{"product_data":{"ean13":["8435568405790"],"reference":"18086","name":{"1":"Ventilador de Suelo Orbegozo PWN 2050\/ 155W\/ 3 Aspas 50cm\/ 3 velocidades","2":"","3":"","4":""},"description":{"1":"<p>En los calurosos d\u00edas de verano, un ventilador industrial&nbsp; PWN 2050 se convierte en un aliado indispensable para mantenernos frescos y c\u00f3modos. Estos robustos dispositivos no solo son ideales para espacios industriales, sino tambi\u00e9n para talleres, almacenes, oficinas y hogares.<br><br>Con 155 W de potencia, este ventilador no se anda con rodeos. Su motor de alto rendimiento garantiza un flujo de aire constante y vigoroso. Ya sea que est\u00e9s en una f\u00e1brica o en tu taller personal, este ventilador no te defraudar\u00e1. Las aspas de 50 cent\u00edmetros de di\u00e1metro son la clave para su eficiencia. Su dise\u00f1o aerodin\u00e1mico permite mover grandes vol\u00famenes de aire sin esfuerzo. Imagina la brisa refrescante que proporcionar\u00e1 en un d\u00eda caluroso.<br><br>Con tres velocidades de ventilaci\u00f3n, puedes adaptar el flujo de aire seg\u00fan tus necesidades. Desde una brisa suave hasta un vendaval vigorizante, este ventilador tiene la flexibilidad para satisfacer tus preferencias. El t\u00e9rmino &#8220;industrial&#8221; no es en vano. Este ventilador ofrece un gran caudal de aire, lo que significa que incluso en los espacios m\u00e1s amplios, sentir\u00e1s su efecto refrescante.<br><br>La rejilla de seguridad es una caracter\u00edstica crucial. Protege tus dedos curiosos y evita accidentes. Puedes estar tranquilo sabiendo que este ventilador est\u00e1 dise\u00f1ado pensando en la seguridad. El asa de transporte facilita moverlo de un lugar a otro. Si necesitas cambiarlo de posici\u00f3n o llevarlo a otra \u00e1rea, este ventilador no te dar\u00e1 dolores de espalda. \u00bfNecesitas dirigir el flujo de aire hacia arriba o hacia abajo? No hay problema. La inclinaci\u00f3n regulable 