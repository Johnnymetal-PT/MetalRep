/800\/fixed\/art_ais-sop%20spk11u-433_1.jpg"],"wholesale_price":27.41}}},"0198154671013":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0198154671013",false],"wholesale_price":[99.94,false],"price":[106.94,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.9",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:292858","Cat. IDs: 196","Associated Categories","Cat. Default: 196","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9af442bd30cae11de3b092a11508e911.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Tablet Lenovo Tab 10.1'\/ 4GB\/ 128GB\/ Octacore\/ Gris Luna","category":"Tablets","sub_category":"Tablets","unit_price":106.94,"reference":"ZAEH0055ES","ean13":"0198154671013","weight":"0.9","quantity":0,"brand":"LENOVO","description_pt":"<h2>Lenovo Tab<\/h2><p>Versatilidad sin esfuerzo para cada estilo de vida.<\/p><ul>\t<li>Dise\u00f1o met\u00e1lico sofisticado con facilidad ergon\u00f3mica<\/li>\t<li>Experiencia de pantalla FHD de 25,654 cm (10,1') inmersiva<\/li>\t<li>Rendimiento sin problemas del procesador Helio G85 y bater\u00eda de larga duraci\u00f3n<\/li><\/ul><h2>Adaptado a cada necesidad<\/h2><p>Disfruta de horas de transmisi\u00f3n sin interrupciones con una tablet dise\u00f1ada para adaptarse a cualquier estilo de vida. El dise\u00f1o elegante totalmente met\u00e1lico se ve muy bien y es muy c\u00f3modo. Disfruta de tus programas favoritos con una claridad impresionante con una pantalla FHD de 25.654 cm (10,1') y altavoces duales con tecnolog\u00eda Dolby Atmos. Con el procesador MediaTek Helio G85, la multitarea est\u00e1 asegurada.<\/p><h2><span style='background-color: initial;'>IM\u00c1GENES N\u00cdTIDAS<\/span><\/h2><p><b>Claridad con facilidad<\/b><\/p><p>Disfruta de tus programas favoritos en la pantalla FHD de 25,654 cm (10,1'), ya que el cuidado de la vista con certificaci\u00f3n T\u00dcV reduce la fatiga visual para sesiones de visualizaci\u00f3n c\u00f3modas y largas. Es perfecto para ver v\u00eddeos, navegar o leer durante tu tiempo libre.<\/p><h2>Dise\u00f1ada para complementar tu estilo<\/h2><p>Imag\u00ednate en el sof\u00e1 con tu Lenovo Tab, dise\u00f1ada con una estructura totalmente met\u00e1lica de forma redonda que irradia elegancia y se siente elegante y c\u00f3moda en tus manos. Ya sea navegando, leyendo o viendo v\u00eddeos, el dise\u00f1o suave y ergon\u00f3mico garantiza que tu tablet sea f\u00e1cil de sostener durante per\u00edodos prolongados.<\/p><h2>Encuentra tu momento de relajaci\u00f3n<\/h2><p>Convierte tu tablet en un llamativo marco de fotos digital o en un reloj impresionante cuando no est\u00e9 en uso ni cargando. Muestra tus recuerdos favoritos o a\u00f1ade un toque de estilo a cualquier espacio con im\u00e1genes din\u00e1micas. Es la manera perfecta de mantener a raya el aburrimiento mientras le das un prop\u00f3sito a tu tablet, \u00a1incluso cuando no la est\u00e9s usando!<\/p><h2>Versatilidad sin esfuerzo<\/h2><p>Disfruta de una versatilidad sin esfuerzo con Lenovo Tab con accesorios opcionales para una visualizaci\u00f3n sin problemas en cualquier momento y lugar. Cada opci\u00f3n garantiza comodidad y comodidad, mejorando tu experiencia Lenovo Tab en casa o mientras te desplazas.<\/p><h2>Mantente seguro y preparado para el futuro<\/h2><p>Disfruta de la tranquilidad con Android 14 y Lenovo ZUI 16, asegur\u00e1ndote de que tu tablet est\u00e9 siempre actualizada y funcionando sin problemas. Con dos actualizaciones de sistema operativo garantizadas, que te mantienen al d\u00eda hasta Android 16, adem\u00e1s de cuatro a\u00f1os de parches de seguridad, tu dispositivo se mantiene seguro, optimizado y listo para satisfacer tus necesidades en los pr\u00f3ximos a\u00f1os.<\/p><h2>Especificaciones<\/h2><br><p><b>Rendimiento y hardware<\/b><\/p><p>Procesador: MediaTek Helio G85 (8 n\u00facleos, 2 x A75 a 2,0 GHz y 6 x A55 a 1,8 GHz)<\/p><p>Gr\u00e1ficos: GPU integrada ARM Mali-G52 MC2<\/p><p>Chipset: Plataforma MediaTek SoC<\/p><p>Memoria RAM: 4 GB LPDDR4x soldada<\/p><p>Almacenamiento: 128 GB eMMC 5.1<\/p><p>Lector de tarjetas: Ranura para tarjeta microSD<\/p><p>Almacenamiento soportado: Tarjeta microSD de hasta 1 TB<\/p><br><p><b>Pantalla y dise\u00f1o<\/b><\/p><p>Pantalla: LCD TFT IPS de 10,1 pulgadas WUXGA (1920 x 1200), 400 nits, 72% NTSC, 60 Hz, antihuellas<\/p><p>Pantalla t\u00e1ctil: Multit\u00e1ctil de 10 puntos en celda<\/p><p>Material del chasis: Metal<\/p><p>Color: Luna gris<\/p><p>Dimensiones: 235,7 x 154,5 x 7,5 mm con protuberancia de c\u00e1mara de 9,4 mm<\/p><p>Peso: Aproximadamente 425 g<\/p><p>Bol\u00edgrafo: No incluido<\/p><br><p><b>Multimedia<\/b><\/p><p>Altavoces: 2 altavoces laterales optimizados con Dolby Atmos<\/p><p>Micr\u00f3fono: Mono<\/p><p>C\u00e1mara frontal: 5 MP<\/p><p>C\u00e1mara trasera: 8 MP<\/p><p>Llamadas de voz: No compatible<\/p><br><p><b>Sensores<\/b><\/p><p>Sensores: Aceler\u00f3metro, sensor Hall, sensor de luz virtual<\/p><p>Motor de vibraci\u00f3n: No compatible<\/p><br><p><b>Conectividad<\/b><\/p><p>Wi-Fi: Wi-Fi 5 802.11ac 1x1<\/p><p>Bluetooth: Bluetooth 5.3<\/p><p>WWAN: No compatible<\/p><p>Servicios de localizaci\u00f3n: GPS, GLONASS, Galileo y Beidou<\/p><p>Puertos:<\/p><p>1 x USB-C USB 2.0 con carga y audio digital<\/p><p>1 x conector combinado de auriculares y micr\u00f3fono de 3,5 mm<\/p><p>1 x ranura para tarjeta<\/p><br><p><b>Bater\u00eda y alimentaci\u00f3n<\/b><\/p><p>Bater\u00eda: Integrada de 5100 mAh<\/p><p>Adaptador de corriente: No incluido<\/p><br><p><b>Software<\/b><\/p><p>Sistema operativo: Android 14 o posterior<\/p><br><p><b>Accesorios<\/b><\/p><p>Accesorios incluidos: Estuche transparente<\/p><br><p><b>Protecci\u00f3n<\/b><\/p><p>Resistenci