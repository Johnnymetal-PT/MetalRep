e":"MUVIT FOR CHANGE","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":21.02,"unit_price_tax":21.02,"tax_rules_group":null,"category":"Accesorios de SmartPhones","sub_category":"Powerbank - Baterias","quantity":0,"brand":"MUVIT FOR CHANGE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_muv-bat%20mcchp0010_1.jpg"],"wholesale_price":14.02}}},"8436546594659":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436546594659",false],"wholesale_price":[6.55,false],"price":[13.55,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.09",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:292785","Cat. IDs: 77","Associated Categories","Cat. Default: 77","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fad0078989725cad1b4926ec3a0cdc3f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cargador de Pared Tech One Tech TEC2222\/ 1xUSB Tipo-C + Cable Lightning\/ 20W\/ Blanco","category":"Accesorios de SmartPhones","sub_category":"Cargadores hasta 45W","unit_price":13.55,"reference":"TEC2222","ean13":"8436546594659","weight":"0.09","quantity":5,"brand":"TECH ONE TECH","description_pt":"<h2>Cargador de Pared Tech One Tech TEC2222<\/h2><p>Cargador ultrarr\u00e1pido con tecnolog\u00eda GaN Power Delivery 3.0 (PD) 20W, color blanco. Carga hasta un 400% m\u00e1s r\u00e1pido que un cargador est\u00e1ndar de 5W. Compatible con dispositivos anteriores. Conector tipo Apple lightning de 3A.&nbsp; Este cargador permite cargar dispositivos como tabletas, m\u00f3viles, consolas, bater\u00edas, auriculares, etc.&nbsp; &nbsp;<\/p><p>T\u00dcV GS&nbsp; Calidad alemana certificada.<\/p><h2>Compatibilidad:<\/h2><p>Entre otros con iPhone 14, 14 Plus, 14 Pro, 14 Pro Max, SE 3, iPhone 13, 13 mini, 13 Pro 13 Pro Max, 12,12 Pro, 12 Pro Max , 12 Mini , iPhone 11, 11 Pro , 11 Pro Max , iPhone SE , XS , XS Max.<\/p><h2>Salida inteligente PD<\/h2><p>Puertos de salida inteligente que se comunica con el dispositivo cargado, suministrando la potencia necesaria y requerida.&nbsp;<\/p><p>Incrementa los niveles de potencia sobre los est\u00e1ndares existentes de USB.<\/p><p>Permite la m\u00e1xima funcionalidad al proporcionar un suministro de energ\u00eda m\u00e1s flexible junto con datos a trav\u00e9s&nbsp; de un solo cable.<\/p><h2>Smart recognition<\/h2><p>Incorpora microchip de gesti\u00f3n de energ\u00eda, identificaci\u00f3n inteligente (IC), carga de manera eficiente y protege completamente su equipo.<\/p><h2>Fire retardant Shell<\/h2><p>Fabricado en PC\/ABS, proporciona una alta resistencia al calor e impactos, as\u00ed como un amplio rango t\u00e9rmico de funcionamiento.<\/p><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li><b>Dimensiones \/ Peso<\/b>&nbsp;<span style='background-color: initial;'>78mm x 40mm x 25mm, peso 50 gramos<\/span><\/li><li><b>Alimentaci\u00f3n<\/b>: 100 - 240V&nbsp; 50 - 60Hz.<\/li><li><b>Tensi\u00f3n de salida<\/b>: 5V-3A \/ 9V-2.77A \/ 12V-1.67A.<\/li><li><b>Normativas y seguridad<\/b>&nbsp;<span style='background-color: initial;'>Cumple con las normas T\u00dcV GS, CE, FCC, RAEE y ROHS. Multi-protecciones contra sobrecarga y cortocircuito previenen efectivamente los posibles da\u00f1os a tus dispositivos<\/span><\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tot-car%20tec2222_1.jpg","wholesale_price":"6.55","unit_price_tax":13.55},"product_model":{"product_data":{"ean13":["8436546594659"],"reference":"TEC2222","name":{"1":"Cargador de Pared Tech One Tech TEC2222\/ 1xUSB Tipo-C + Cable Lightning\/ 20W\/ Blanco","2":"","3":"","4":""},"description":{"1":"<h2>Cargador de Pared Tech One Tech TEC2222<\/h2><p>Cargador ultrarr\u00e1pido con tecnolog\u00eda GaN Power Delivery 3.0 (PD) 20W, color blanco. Carga hasta un 400% m\u00e1s r\u00e1pido que un cargador est\u00e1ndar de 5W. Compatible con dispositivos anteriores. Conector tipo Apple lightning de 3A.&nbsp; Este cargador permite cargar dispositivos como tabletas, m\u00f3viles, consolas, bater\u00edas, auriculares, etc.&nbsp; &nbsp;<\/p><p>T\u00dcV GS&nbsp; Calidad alemana certificada.<\/p><h2>Compatibilidad:<\/h2><p>Entre otros con iPhone 14, 14 Plus, 14 Pro, 14 Pro Max, SE 3, iPhone 13, 13 mini, 13 Pro 13 Pro Max, 12,12 Pro, 12 Pro Max , 12 Mini , iPhone 11, 11 Pro , 11 Pro Max , iPhone SE , XS , XS Max.<\/p><h2>Salida inteligente PD<\/h2><p>Puertos de salida inteligente que se comunica con el dispositivo cargado, suministrando la potencia necesaria y requerida.&nbsp;<\/p><p>Incrementa los niveles de potencia sobre los est\u00e1ndares existentes de USB.<\/p><p>Permite la m\u00e1xima funcionalidad al proporcionar un suministro de energ\u00eda m\u00e1s flexible junto con datos a trav\u00e9s&nbsp; de un solo cable.<\/p><h2>Smart recognition<\/h2><p>Incorpora microchip de gesti\u00f3n de energ\u00eda, identificaci\u00f3n inteligente (IC), carga de manera eficiente y protege completamente su equipo.<\/p><h2>Fire retardant Shell<\/h2><p>Fabricado en PC\/ABS, proporciona una alta resistencia al calor e impactos, as\u00ed como un amplio rango t\u00e9rmico de funcionamiento.<\/p><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li><b>Dimensiones \/ Peso<\/b>&nbsp;<span style='background-color: initial;'>78mm x 40mm x 25mm, peso 50 gramos<\/span><\/li><li><b>Alimentaci\u00f3n<\/b>: 100 - 240V&nbsp; 50 - 60Hz.<\/li><li><b>Tensi\u00f3n de salida<\/b>: 5V-3A \/ 9V-2.77A \/ 12V-1.67A.<\/li><li><b>Normativas y seguridad<\/b>&nbsp;<span style='background-color: initial;'>Cumple con las normas T\u00dcV GS, CE, FCC, RAEE y ROHS. Multi-protecciones contra sobrecarga y cortocircuito previenen efectivamente los posibles da\u00f1os a tus dispositivos<\/span><\/li><\/ul