":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PIQUERAS Y CRESPO","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":71.73,"unit_price_tax":71.73,"tax_rules_group":null,"category":"Muebles","sub_category":"Muebles","quantity":5,"brand":"PIQUERAS Y CRESPO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pyc-silla%20544bnm8403d840rn_1.jpg"],"wholesale_price":66.73}}},"8435501019503":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435501019503",false],"wholesale_price":[48.85,false],"price":[53.85,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:295275","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8af8b4dd26ee73956458831ac5c73f5c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Silla de Oficina Piqueras y Crespo Ergo535 535BNDW00RN\/ Negra","category":"Muebles","sub_category":"Muebles","unit_price":53.85,"reference":"535BNDW00RN","ean13":"8435501019503","weight":"0","quantity":5,"brand":"PIQUERAS Y CRESPO","description_pt":"<p><\/p><h2>Silla operativa con respaldo de malla y&nbsp;<span style='background-color: initial;'>brazos fijos.<\/span><\/h2><p>Silla de oficina Ergo535 con mecanismo Basculante tapizada con Tela color Negro. Equipada con lumbar&nbsp;<span style='background-color: initial;'>Fijo, Brazos fijos y Ruedas de nailon 50 mm<\/span><\/p><p><span style='background-color: initial;'><p>La silla giratoria oficina Ergo535 de la marca FOR\u00d6L es la opci\u00f3n ideal para quienes buscan comodidad y funcionalidad en su espacio de trabajo. Dise\u00f1ada para un uso moderado de 4-6 horas, esta silla es perfecta para quienes pasan tiempo en su escritorio sin comprometer su bienestar.<\/p><p>Con un peso m\u00e1ximo de 120 Kg, la Ergo535 cuenta con brazos fijos que brindan un soporte adicional, mientras que su mecanismo basculante permite un movimiento fluido y adaptable a tus necesidades. Aunque no incluye cabecero, su dise\u00f1o se complementa con un apoyo lumbar fijo que ayuda a mantener una postura adecuada durante largas horas de trabajo.<\/p><p>El respaldo fijo de la Ergo535 est\u00e1 fabricado en malla\/tela, lo que proporciona una ventilaci\u00f3n adecuada y un toque moderno a tu oficina. Adem\u00e1s, su tipo de espuma de corte con una densidad de 50 mm y 25 kg\/m3 asegura una experiencia de asiento c\u00f3moda y duradera.<\/p><p>Las ruedas de nailon permiten un desplazamiento suave y silencioso, facilitando el movimiento en tu espacio de trabajo. Disponible en un elegante color negro, esta silla se adapta a cualquier estilo de oficina, convirti\u00e9ndose en una opci\u00f3n vers\u00e1til y funcional.<\/p><p>La Ergo535 es una de las mejores sillas reclinables para oficina que puedes encontrar, ideal para quienes buscan una silla giratoria escritorio que combine confort y dise\u00f1o. No te pierdas la oportunidad de mejorar tu experiencia laboral con esta excelente opci\u00f3n.<\/p><\/span><\/p><p><\/p><h2>Especificaciones<\/h2><br><p><b>Componentes<\/b><\/p><p>Base: Base de poliamida de 5 radios y 600 mm de di\u00e1metro con acabado negro<\/p><p>Gas: Pist\u00f3n de elevaci\u00f3n de semidirecci\u00f3n en color negro<\/p><p>Ruedas: Ruedas de nailon de 50 mm de di\u00e1metro con eje interno de acero y perno de acero de 11 mm<\/p><br><p><b>Mecanismo<\/b><\/p><p>Mecanismo: Sistema basculante con regulador de presi\u00f3n de la basculaci\u00f3n y elevaci\u00f3n del asiento en altura<\/p><br><p><b>Interiores<\/b><\/p><p>Asiento: Madera laminada con espuma de poliuretano<\/p><br><p><b>Exteriores<\/b><\/p><p>Respaldo: Respaldo de malla transpirable 100% PES<\/p><br><p><b>Datos t\u00e9cnicos<\/b><\/p><p>Horas de uso recomendadas: Uso moderado de 4 a 6 horas<\/p><p>Peso: 8,5 kg<\/p><p>Peso m\u00e1ximo soportado: 120 kg<\/p><p>Acabado: Malla y tela<\/p><p>Color: Negro<\/p><p>Certificaci\u00f3n: UNE-EN-1335<\/p><br><p><b>Dimensiones del producto<\/b><\/p><p>Altura total m\u00e1xima: 103 cm<\/p><p>Altura total m\u00ednima: 94 cm<\/p><p>Altura del asiento m\u00e1xima: 57 cm<\/p><p>Altura del asiento m\u00ednima: 48 cm<\/p><p>Ancho total: 62 cm<\/p><p>Ancho del asiento: 48 cm<\/p><p>Ancho del respaldo: 44 cm<\/p><p>Fondo total: 55 cm<\/p><p>Fondo del asiento: 50 cm<\/p><p>Altura del brazo m\u00e1xima: 73 cm<\/p><p>Altura del brazo m\u00ednima: 63 cm<\/p><br><p><b>Dimensiones del embalaje<\/b><\/p><p>Altura de la caja: 56 cm<\/p><p>Ancho de la caja: 28 cm<\/p><p>Largo de la caja: 60 cm<\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pyc-silla%20535bndw00rn_1.jpg","wholesale_price":"48.85","unit_price_tax":53.85},"product_model":{"product_data":{"ean13":["8435501019503"],"reference":"535BNDW00RN","name":{"1":"Silla de Oficina Piqueras y Crespo Ergo535 535BNDW00RN\/ Negra","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Silla operativa con respaldo de malla y&nbsp;<span style='background-color: initial;'>brazos fijos.<\/span><\/h2><p>Silla de oficina Ergo535 con mecanismo Basculante tapizada con Tela color Negro. Equipada con lumbar&nbsp;<span style='background-color: initial;'>Fijo, Brazos fijos y Ruedas de nailon 50 mm<\/span><\/p><p><span style='background-color: initial;'><p>La silla giratoria oficina Ergo535 de la marca FOR\u00d6L es la opci\u00f3n ideal para quienes buscan comodidad y funcionalidad en su espacio de trabajo. Dise\u00f1ada para un uso moderado de 4-6 horas, esta silla es perfecta para quienes pasan tiempo en su escritorio sin comprometer su bienestar.<\/p><p>Con un peso m\u00e1ximo de 120 Kg, la Ergo535 cuenta con brazos fijos que brindan un soporte adicional, mientras que su mecanismo basculante permite un movimiento fluido y adaptable a tus necesidades. Aunque no incluye cabecero, su dise\u00f1o se complementa con un apoyo lumbar fijo que ayuda a mantener una postura adecuada durante largas horas de trabajo.<\/p><p>El respaldo fijo de la Ergo535 est\u00e1 fabricado en malla\/tela, lo que proporciona una ventilaci\u00f3n adecuada y un toque moderno a tu oficina. Adem\u00e1s, su tipo de espuma de corte con una densidad de 50 mm y 25 kg\/m3 asegura una experiencia de asiento c\u00f3moda y duradera.<\/p><p>Las ruedas de nailon permiten un desplazamiento suave y silencioso, facilitando el movimiento en tu espacio de trabajo. Disponible en un elegante color negro, esta silla se adapta a cualquier estilo de oficina, convirti\u00e9ndose en una opci\u00f3n vers\u00e1til y funcional.<\/p><p>La Ergo535 es una de las mejores sillas reclinables para oficina que puedes encontrar, ideal para quienes buscan una silla giratoria escritorio que combine confort y dise\u00f1o. No te pierdas la oportunidad de mejorar tu experiencia laboral con esta excelente opci\u00f3n.<\/p><\/span><\/p><p><\/p><h2>Especificaciones<\/h2><br><p><b>Componentes<\/b><\/p><p>Base: Base de poliamida de 5 radios y 600 mm de di\u00e1metro con acabado negro<\/p><p>Gas: Pist\u00f3n de elevaci\u00f3n de semidirecci\u00f3n en color negro<\/p><p>Ruedas: Ruedas de nailon de 50 mm de di\u00e1metro con eje interno de acero y perno de acero de 11 mm<\/p><br><p><b>Mecanismo<\/b><\/p><p>Mecanismo: Sistema basculante con regulador de presi\u00f3n de la basculaci\u00f3n y elevaci\u00f3n del asiento en altura<\/p><br><p><b>Interiores<\/b><\/p><p>Asiento: Madera laminada con espuma de poliuretano<\/p><br><p><b>Exteriores<\/b><\/p><p>Respaldo: Respaldo de malla transpirable 100% PES<\/p><br><p><b>Datos t\u00e9cnicos<\/b><\/p><p>Horas de uso r