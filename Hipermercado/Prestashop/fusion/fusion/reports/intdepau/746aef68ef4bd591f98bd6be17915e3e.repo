ier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":74.51,"unit_price_tax":74.51,"tax_rules_group":null,"category":"Muebles","sub_category":"Muebles","quantity":5,"brand":"PIQUERAS Y CRESPO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pyc-silla%20520pacrsp840_1.jpg"],"wholesale_price":69.51}}},"8435501019343":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435501019343",false],"wholesale_price":[71.12,false],"price":[76.12,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:295269","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ba0d14637cc9db4fe11b507f4c12016d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Silla de Oficina Piqueras y Crespo Opti524 524BM840A840RN\/ Negro","category":"Muebles","sub_category":"Muebles","unit_price":76.12,"reference":"524BM840A840RN","ean13":"8435501019343","weight":"0","quantity":5,"brand":"PIQUERAS Y CRESPO","description_pt":"<h2>Silla operativa giratoria, mecanismo&nbsp;<span style='background-color: initial;'>basculante, brazos abatibles y ruedas de&nbsp;<\/span><span style='background-color: initial;'>nailon.<\/span><\/h2><p><span style='background-color: initial;'><\/span><\/p><p>Silla de oficina Opti524 con mecanismo Basculante tapizada con Tela color Negro. Equipada con Base&nbsp;<span style='background-color: initial;'>poliamida negra, Brazos abatibles y Ruedas de nailon 50 mm<\/span><\/p><p>La Opti524 de FOR\u00d6L es una excelente opci\u00f3n en la categor\u00eda de siller\u00eda operativa, ideal para quienes buscan comodidad y funcionalidad en su espacio de trabajo. Dise\u00f1ada para un uso moderado de 4-6 horas, esta silla es perfecta para quienes pasan tiempo en la oficina sin comprometer su bienestar.<\/p><p>Con un peso m\u00e1ximo soportado de 120 Kg, la Opti524 se adapta a diferentes usuarios. Sus brazos abatibles permiten una mayor flexibilidad, facilitando el movimiento y la adaptaci\u00f3n a diferentes posiciones. El mecanismo basculante ofrece un ajuste din\u00e1mico, permitiendo que la silla se mueva con el usuario, lo que contribuye a una experiencia m\u00e1s c\u00f3moda.<\/p><p>El respaldo fijo proporciona un soporte estable, mientras que el acabado en malla\/tela asegura una buena transpiraci\u00f3n, manteniendo la frescura durante el uso. La espuma de corte con una densidad de 40 mm y 25 kg\/m3 garantiza un confort adecuado, adapt\u00e1ndose a la forma del cuerpo sin perder su estructura.<\/p><p>Las ruedas de nailon permiten un deslizamiento suave sobre diferentes superficies, facilitando el movimiento en la oficina. Con un elegante color negro, la Opti524 se integra perfectamente en cualquier entorno laboral.<\/p><p>Si buscas un precio de silla de oficina giratoria que combine calidad y dise\u00f1o, la Opti524 es una opci\u00f3n a considerar. Adem\u00e1s, su dise\u00f1o la hace comparable a una silla giratoria morada, pero con la ventaja de ser m\u00e1s vers\u00e1til y funcional. No te pierdas la oportunidad de disfrutar de una silla giratoria malla que se adapta a tus necesidades y te acompa\u00f1a en tu d\u00eda a d\u00eda.<\/p><h2>Especificaciones<\/h2><br><p><b>Componentes<\/b><\/p><p>Base: Base desmontable de poliamida de 5 radios y 640 mm de di\u00e1metro con acabado negro<\/p><p>Gas: Pist\u00f3n de elevaci\u00f3n de semidirecci\u00f3n en color negro<\/p><p>Ruedas: Ruedas de nailon de 50 mm de di\u00e1metro con eje interno de acero y perno de acero de 11 mm<\/p><br><p><b>Mecanismo<\/b><\/p><p>Mecanismo: Sistema basculante con regulador de presi\u00f3n de la basculaci\u00f3n y elevaci\u00f3n del asiento en altura<\/p><br><p><b>Interiores<\/b><\/p><p>Asiento: Madera laminada con espuma de poliuretano<\/p><br><p><b>Exteriores<\/b><\/p><p>Respaldo: Respaldo de malla transpirable 100% PES<\/p><br><p><b>Datos t\u00e9cnicos<\/b><\/p><p>Horas de uso recomendadas: Uso moderado de 4 a 6 horas<\/p><p>Peso: 10,2 kg<\/p><p>Peso m\u00e1ximo soportado: 120 kg<\/p><p>Acabado: Malla y tela<\/p><p>Color: Negro<\/p><p>Certificaci\u00f3n: UNE-EN-1335<\/p><br><p><b>Dimensiones del producto<\/b><\/p><p>Altura total m\u00e1xima: 119 cm<\/p><p>Altura total m\u00ednima: 112 cm<\/p><p>Altura del asiento m\u00e1xima: 51,5 cm<\/p><p>Altura del asiento m\u00ednima: 44,5 cm<\/p><p>Ancho total: 61 cm<\/p><p>Ancho del asiento: 49 cm<\/p><p>Ancho del respaldo: 47 cm<\/p><p>Fondo total: 61 cm<\/p><p>Fondo del asiento: 49 cm<\/p><p>Altura del brazo m\u00e1xima: 74 cm<\/p><p>Altura del brazo m\u00ednima: 67 cm<\/p><br><p><b>Dimensiones del embalaje<\/b><\/p><p>Altura de la caja: 52,5 cm<\/p><p>Ancho de la caja: 25 cm<\/p><p>Largo de la caja: 69 cm<\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pyc-silla%20524bm840a840rn_1.jpg","wholesale_price":"71.12","unit_price_tax":76.12},"product_model":{"product_data":{"ean13":["8435501019343"],"reference":"524BM840A840RN","name":{"1":"Silla de Oficina Piqueras y Crespo Opti524 524BM840A840RN\/ Negro","2":"","3":"","4":""},"description":{"1":"<h2>Silla operativa giratoria, mecanismo&nbsp;<span style='background-color: initial;'>basculante, brazos abatibles y ruedas de&nbsp;<\/span><span style='background-color: initial;'>nailon.<\/span><\/h2><p><span style='background-color: initial;'><\/span><\/p><p>Silla de oficina Opti524 con mecanismo Basculante tapizada con Tela color Negro. Equipada con Base&nbsp;<span style='background-color: initial;'>poliamida negra, Brazos abatibles y Ruedas de nailon 50 mm<\/span><\/p><p>La Opti524 de FOR\u00d6L es una excelente opci\u00f3n en la categor\u00eda de siller\u00eda operativa, ideal para quienes buscan comodidad y funcionalidad en su espacio de trabajo. Dise\u00f1ada para un uso moderado de 4-6 horas, esta silla es perfecta para quienes pasan tiempo en la oficina sin comprometer su bienestar.<\/p><p>Con un peso m\u00e1ximo soportado de 120 Kg, la Opti524 se adapta a diferentes usuarios. Sus brazos abatibles permiten una mayor flexibilidad, facilitando el movimiento y la adaptaci\u00f3n a diferentes posiciones. El mecanismo basculante ofrece un ajuste din\u00e1mico, permitiendo que la silla se mueva con el usuario, lo que contribuye a una experiencia m\u00e1s c\u00f3moda.<\/p><p>El respaldo fijo proporciona un soporte estable, mientras que el acabado en malla\/tela asegura una buena transpiraci\u00f3n, manteniendo la frescura durante el uso. La espuma de corte con una densidad de 40 mm y 25 kg\/m3 garantiza un confort adecuado, adapt\u00e1ndose a la forma del cuerpo sin perder su estructura.<\/p><p>Las ruedas de nailon permiten un deslizamiento suave sobre diferentes superficies, facilitando el movimiento en la oficina. Con un elegante color negro, la Opti524 se integra perfectamente en cualquier entorno laboral.<\/p><p>Si buscas un precio de silla de oficina giratoria que combine calidad y dise\u00f1o, la Opti524 es una opci\u00f3n a considerar. Adem\u00e1s, su dise\u00f1o la hace comparable a una silla giratoria morada, pero con la ventaja de ser m\u00e1s vers\u00e1til y funcional. No te pierdas la oportunidad de disfrutar de una silla giratoria malla que se adapta a tus necesidades y te acompa\u00f1a en tu d\u00eda a d\u00eda.<\/p><h2>Especificaciones<\/h2><br><p><b>Componentes<\/b><\/p><p>Base: Base desmontable de poliamida de 5 radios y 640 mm de di\u00e1metro con acabado negro<\/p><p>Gas: Pist\u00f3n de elevaci\u00f3n de semidirecci\u00f3n en color negro<\/p><p>Ruedas: Ruedas de nailon de 50 mm de di\u00e1metro con eje interno de acero y perno de acero de 11 mm<\/p><br><p><b>Mecanismo<\/b><\/p><p>Mecanismo: Sistema basculante con regulador de presi\u00f3n de la basculaci\u00f3n y elevaci\u00f3n del asiento en altura<\/p><br><p><b>Interiores<\/b><\/p><p>Asiento: Madera laminada con espuma de poliuretano<\/p><br><p><b>Exteriores<\/b><\/p><p>Respaldo: Respaldo de malla transpirable 100% PES<\/p><br><p><b>Datos t\u00e9cnicos<\/b><\/p><p>Horas de uso recomendadas: Uso moderado de 4 a 6 horas<\/p><p>Peso: 10,2 kg<\/p><p>Peso m\u00e1ximo soportado: 120 kg<\/p><p>Acabado: Malla y tela<\/p><p>Color: Negro<\/p><p>Certificaci\u00f3n: UNE-EN-1335<\/p><br><p><b>Dimensiones del producto<\/b><\/p><p>Altura total m\u00e1xima: 119 cm<\/p><p>Altura total m\u00ednima: 112 cm<\/p><p>Altura del asiento m\u00e1xima: 51,5 cm<\/p><p>Altura del asiento m\u00ednima: 44,5 cm<\/p><p>Ancho total: 61 cm<\/p><p>Ancho del asiento: 49 cm<\/p><p>Ancho del respaldo: 47 cm<\/p><p>Fondo total: 61 cm<\/p><p>Fondo del asiento: 49 cm<\/p><p>Altura del brazo m\u00e1xima: 74 cm<\/p><p>Altura del brazo m\u00ednima: 67 cm<\/p><br><p><b>Dimensiones del embalaje<\/b><\/p><p>Altura de la caja: 52,5 cm<\/p><p>Ancho de la caja: 25 cm<\/p><p>Largo de la caja: 69 cm<\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PIQUERAS Y CRESPO","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":76.12,"unit_price_tax":76.12,"tax_rules_group":null,"category":"Muebles","sub_category":"Muebles","quantity":5,"brand":"PIQUERAS Y CRESPO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pyc-silla%20524bm840a840rn_1.jpg"],"wholesale_price":71.12}}},"8435501019350":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435501019350",false],"wholesale_price":[79.54,false],"price":[84.54,false],"id_tax_rules_group":[1,false],"categorys