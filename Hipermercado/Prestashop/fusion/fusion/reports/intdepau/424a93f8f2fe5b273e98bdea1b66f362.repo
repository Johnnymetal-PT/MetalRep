:""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TOSHIBA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.04,"unit_price":7.22,"unit_price_tax":7.22,"tax_rules_group":null,"category":"Electronica","sub_category":"Pilas de consumo","quantity":0,"brand":"TOSHIBA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tos-pila%20tnh-03gae%20bp-2c_1.jpg"],"wholesale_price":2.22}}},"8435089039658":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435089039658",false],"wholesale_price":[64.05,false],"price":[69.05,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:242794","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/6d1a60c2928376593bca174494a284f4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Bandolera con Pantalla LED Woxter Loy-Evil Eye\/ Negra","category":"EQUIPAJE","sub_category":"Maletas - Mochilas -Trolley","unit_price":69.05,"reference":"AC26-009","ean13":"8435089039658","weight":"0","quantity":0,"brand":"WOXTER","description_pt":"                                                                                                <p><h2>Bandolera Loy-Evil Eye\u00a0<\/h2><p><b>Dise\u00f1o personalizable:<\/b> puedes ajustar el arte de p\u00edxeles en la pantalla a tu gusto. La aplicaci\u00f3n incluye una amplia variedad de im\u00e1genes predeterminadas, o puedes optar por crear tus propias im\u00e1genes, con o sin texto.<\/p><p><b>Espacio amplio:<\/b> el bolsillo frontal de la mochila permite almacenar una bater\u00eda recargable que alimenta la pantalla LED, mientras que los compartimentos separados pueden contener pa\u00f1uelos, llaves, botellas de agua, y otros art\u00edculos.<\/p><p><b>Correa ajustable:<\/b> la mochila cuenta con correas ajustables para que puedas llevarla al hombro o alrededor de la cintura, y la hebilla del cintur\u00f3n incorpora un im\u00e1n fuerte para sujetarla de manera segura.<\/p><h2>Especificaciones<\/h2><p><ul><li>Compatible con la APP LOY EYES, podr\u00e1s enviar im\u00e1genes predise\u00f1adas, im\u00e1genes propias y textos.<\/li><li>Capacidad 6 litros.<\/li><li>Voltaje nominal: 5V\/2A<\/li><li>Tama\u00f1o del producto: 32 x 20 x 9 cm<\/li><li>Espaciado de p\u00edxeles LED: 2 mm<\/li><li>Modos de alimentaci\u00f3n: Power bank o USB<\/li><li>Comunicaci\u00f3n: Bluetooth<\/li><li>Resoluci\u00f3n de pantalla: 48 x 48 puntos<\/li><li>Material: ABS + PC + Dacr\u00f3n<\/li><li>Peso: 0.8 kg<\/li><li>Power bank no incluido<\/li><li><b>M\u00e1s informaci\u00f3n:<\/b><\/li><li>Pantalla de alta definici\u00f3n: Matriz de puntos 48x48 con colores vivos y mayor claridad.<\/li><li>Control por Bluetooth: Configura y personaliza tu mochila desde tu m\u00f3vil a trav\u00e9s de Bluetooth.<\/li><li>Resistente al agua: Protege tus pertenencias de forma segura en cualquier clima.<\/li><li>Multifuncionalidad: Muestra texto, im\u00e1genes o GIFs animados, personalizando tu estilo de manera \u00fanica.<\/li><\/ul><\/p><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wox-band%20ac26-009_1.jpg","wholesale_price":"64.05","unit_price_tax":69.05},"product_model":{"product_data":{"ean13":["8435089039658"],"reference":"AC26-009","name":{"1":"Bandolera con Pantalla LED Woxter Loy-Evil Eye\/ Negra","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><h2>Bandolera Loy-Evil Eye\u00a0<\/h2><p><b>Dise\u00f1o personalizable:<\/b> puedes ajustar el arte de p\u00edxeles en la pantalla a tu gusto. La aplicaci\u00f3n incluye una amplia variedad de im\u00e1genes predeterminadas, o puedes optar por crear tus propias im\u00e1genes, con o sin texto.<\/p><p><b>Espacio amplio:<\/b> el bolsillo frontal de la mochila permite almacenar una bater\u00eda recargable que alimenta la pantalla LED, mientras que los compartimentos separados pueden contener pa\u00f1uelos, llaves, botellas de agua, y otros art\u00edculos.<\/p><p><b>Correa ajustable:<\/b> la mochila cuenta con correas ajustables para que puedas llevarla al hombro o alrededor de la cintura, y la hebilla del cintur\u00f3n incorpora un im\u00e1n fuerte para sujetarla de manera segura.<\/p><h2>Especificaciones<\/h2><p><ul><li>Compatible con la APP LOY EYES, podr\u00e1s enviar im\u00e1genes predise\u00f1adas, im\u00e1genes propias y textos.<\/li><li>Capacidad 6 litros.<\/li><li>Voltaje nominal: 5V\/2A<\/li><li>Tama\u00f1o del producto: 32 x 20 x 9 cm<\/li><li>Espaciado de p\u00edxeles LED: 2 mm<\/li><li>Modos de alimentaci\u00f3n: Power bank o USB<\/li><li>Comunicaci\u00f3n: Bluetooth<\/li><li>Resoluci\u00f3n de pantalla: 48 x 48 puntos<\/li><li>Material: ABS + PC + Dacr\u00f3n<\/li><li>Peso: 0.8 kg<\/li><li>Power bank no incluido<\/li><li><b>M\u00e1s informaci\u00f3n:<\/b><\/li><li>Pantalla de alta definici\u00f3n: Matriz de puntos 48x48 con colores vivos y mayor claridad.<\/li><li>Control por Bluetooth: Configura y personaliza tu mochila desde tu m\u00f3vil a trav\u00e9s de Bluetooth.<\/li><li>Resistente al agua: Protege tus pertenencias de forma segura en cualquier clima.<\/li><li>Multifuncionalidad: Muestra texto, im\u00e1genes o GIFs animados, personalizando tu estilo de manera \u00fanica.<\/li><\/ul><\/p><\/p>                                          