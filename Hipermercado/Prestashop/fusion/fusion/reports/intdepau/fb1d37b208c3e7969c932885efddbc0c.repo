ay\/output') en los conectores HDMI, a fin de garantizar que el dispositivo y la fuente HDMI se conecten correctamente.<\/strong><\/p><h2>Especificaciones<\/h2><ul><li>Longitud: 10M<\/li><li>Color: Negro<\/li><li>Normativas: RoHS<\/li><li>Test de funcionamiento: 100% testeado<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"AISENS","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":29.07,"unit_price_tax":29.07,"tax_rules_group":null,"category":"Cables","sub_category":"Cables HDMI","quantity":0,"brand":"AISENS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ais-cab%20a153-0933_1.jpg"],"wholesale_price":22.07}}},"8435739902783":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435739902783",false],"wholesale_price":[23.75,false],"price":[30.75,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:250633","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e9ef7d801bd35a78fe7257ab9d76e4a6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cable HDMI 2.1 AOC 8K Aisens A153-0934\/ HDMI Macho - HDMI Macho\/ 15m\/ Negro","category":"Cables","sub_category":"Cables HDMI","unit_price":30.75,"reference":"A153-0934","ean13":"8435739902783","weight":"0","quantity":0,"brand":"AISENS","description_pt":"<p><h2>Cable HDMI V2.1 ultra alta veloc