,false],"price":[30.29,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:164173","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5c266b4afc2b58f9a6d190528410534c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cepillo Alisador para el Pelo Braun Satin Hair 7 Iontec BR710E\/ I\u00f3nico\/ Negro y Verde","category":"Cuidado Personal","sub_category":"Planchas de pelo","unit_price":30.29,"reference":"BR710E","ean13":"3030050182484","weight":"0","quantity":0,"brand":"BRAUN","description_pt":"                                                                                                <h2>Braun Satin Hair 7 Iontec BR710 Cepillo i\u00f3nico<\/h2><div>Desp\u00eddete del cabello rebelde con el cepillo con tecnolog\u00eda IONTEC. Libera millones de iones activos que envuelven cada mech\u00f3n de cabello y combaten la electricidad est\u00e1tica y el encrespamiento y aumentan visiblemente el brillo.<br><\/div><div><h2>Caracter\u00edsticas del producto BR710<\/h2><p>Celdas continuas para aflojar suavemente los nudos Sin imprecisiones ni puntas espinosas, las celdas continuas del cepillo Satin Hair 7 IONTEC son suaves para el cabello. Perfectas para cabellos medianos a gruesos, se deslizan suavemente para desatar los nudos r\u00e1pida y f\u00e1cilmente sin da\u00f1ar la cut\u00edcula capilar. \u00a1Quedar\u00e1s impresionado por los excelentes resultados!<\/p><ul><li>Un cepillo i\u00f3nico con iones activos que aumenta el brillo visiblemente desde la primera pasada<\/li><li>Celdas naturales que ofrecen un cepillado incre\u00edblemente suave<\/li><li>Almohadilla es desmontable para facilitar la limpieza<\/li><li>Apagado autom\u00e1tico para una mayor duraci\u00f3n<\/li><\/ul><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li>Peso: 175 g.\u00a0<\/li><li>Adecuado para: Adulto<\/li><li>Tipo: Cepillo paleta para el pelo<\/li><li>Color del producto: Negro, Verde<\/li><li>Agarradera(s): Si<\/li><li><b>Empaquetado<\/b><\/li><li>Ancho del paquete: 65 mm<\/li><li>Profundidad del paquete: 71 mm<\/li><li>Altura del paquete: 235 mm<\/li><li>Peso del paquete: 216 g<\/li><li><b>Contenido del embalaje<\/b><\/li><li>Cantidad por paquete: 1\u00a0Braun Satin Hair 7 Iontec<\/li><\/ul><\/p><br><\/div>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-pae-mold%20br710e_1.jpg","wholesale_price":"25.29","unit_price_tax":30.29},"product_model":{"product_data":{"ean13":["3030050182484"],"reference":"BR710E","name":{"1":"Cepillo Alisador para el Pelo Braun Satin Hair 7 Iontec BR710E\/ I\u00f3nico\/ Negro y Verde","2":"","3":"","4":""},"description":{"1":"                                                                                                <h2>Braun Satin Hair 7 Iontec BR710 Cepillo i\u00f3nico<\/h2><div>Desp\u00eddete del cabello rebelde con el cepillo con tecnolog\u00eda IONTEC. Libera millones de iones activos que envuelven cada mech\u00f3n de cabello y combaten la electricidad est\u00e1tica y el encrespamiento y aumentan visiblemente el brillo.<br><\/div><div><h2>Caracter\u00edsticas del producto BR710<\/h2><p>Celdas continuas para aflojar suavemente los nudos Sin imprecisiones ni puntas espinosas, las celdas continuas del cepillo Satin Hair 7 IONTEC son suaves para el cabello. Perfectas para cabellos medianos a gruesos, se deslizan suavemente para desatar los nudos r\u00e1pida y f\u00e1cilmente sin da\u00f1ar la cut\u00edcula capilar. \u00a1Quedar\u00e1s impresionado por los excelentes resultados!<\/p><ul><li>Un cepillo i\u00f3nico con iones activos que aumenta el brillo visiblemente desde la primera pasada<\/li><li>Celdas naturales que ofrecen un cepillado incre\u00edblemente suave<\/li><li>Almohadilla es desmontable para facilitar la limpieza<\/li><li>Apagado autom\u00e1tico para una mayor duraci\u00f3n<\/li><\/ul><p><br><\/p><h2>Especificaciones<\/h2><p><ul><li>Peso: 175 g.\u00a0<\/li><li>Adecuado para: Adulto<\/li><li>Tipo: Cepillo paleta para el pelo<\/li><li>Color del producto: Negro, Verde<\/li><li>Agarradera(s): Si<\/li><li><b>Empaquetado<\/b><\/li><li>Ancho del paquete: 65 mm<\/li><li>Profundidad del paquete: 71 mm<\/li><li>Altura del paquete: 235 mm<\/li><li>Peso del paquete: 216 g<\/li><li><b>Contenido del embalaje<\/b><\/li><li>Cantidad por paquete: 1\u00a0Braun Satin Hair 7 Iontec<\/li><\/ul><\/p><br><\/div>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"BRAUN","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":30.29,"unit_price_tax":30.29,"tax_rules_group":null,"category":"Cuidado Personal","sub_category":"Planchas de pelo","quantity":0,"brand":"BRAUN","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_bra-pae-mold%20br710e_1.jpg"],"wholesale_price":25.29}}},"3030050182385":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3030050182385",false],"wholesale_price":[16.48,false],"price":[21.48,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_aler