"",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Xiaomi Redmi 13 Smartphone 8GB\/ 256GB\/ 6,79&#39;\/ Preto Meia-Noite"],"result":false},"feed_data":{"name_pt":"Smartphone Xiaomi Redmi 13 8GB\/ 256GB\/ 6.79'\/ Negro Medianoche","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":150.46,"reference":"REDMI 13 8-256 BK","ean13":"6941812776865","weight":"0","quantity":0,"brand":"XIAOMI","description_pt":"                                                                                                                                                ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20redmi%2013%208-256%20bk_1.jpg","wholesale_price":"145.46","unit_price_tax":150.46},"product_model":{"product_data":{"ean13":["6941812776865"],"reference":"REDMI 13 8-256 BK","name":{"1":"Smartphone Xiaomi Redmi 13 8GB\/ 256GB\/ 6.79'\/ Negro Medianoche","2":"","3":"","4":""},"description":{"1":"                                                                                                                                                ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"XIAOMI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":150.46,"unit_price_tax":150.46,"tax_rules_group":null,"category":"SmartPhones y Moviles","sub_category":"Smartphones","quantity":0,"brand":"XIAOMI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_xia-sp%20redmi%2013%208-256%20bk_1.jpg"],"wholesale_price":145.46}}},"6941764417366":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["6941764417366",false],"wholesale_price":[85.87,false],"price":[90.87,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: Smartphone Realme C51 4GB\/ 128GB\/ 6,74&#39;\/ Verde Menta"],"result":false},"feed_data":{"name_pt":"Smartphone Realme C51 4GB\/ 128GB\/ 6.74'\/ Verde Menta","category":"SmartPhones y Moviles","sub_category":"Smartphones","unit_price":90.87,"reference":"C51 4-128 GREE","ean13":"6941764417366","weight":"0","quantity":0,"brand":"REALME","description_pt":"                                                <p><h2>C\u00c1MARA CON M\u00c1S NITIDEZ.<\/h2><h2>CARGA M\u00c1S R\u00c1PIDA.<\/h2><h2>M\u00c1S ESPACIO DE ALMACENAMIENTO.<\/h2><h2>UN CAMPE\u00d3N DE OTRO NIVEL.<\/h2><h2>ROM de 128 GB Almacenamiento mejorado<\/h2><br>Con la memoria ROM de 128 GB, tendr\u00e1s m\u00e1s espacio para tus fotos, v\u00eddeos, juegos y pel\u00edculas favoritos. Y gracias al almacenamiento adicional disponible, todas las tareas se ejecutar\u00e1n sin problemas en segundo plano.<br><br><h2>RAM din\u00e1mica de hasta 4 GB + 4 GB Uniformidad aumentada<\/h2>Ad\u00e9ntrate en un nuevo mundo de potencia con Dynamic RAM Expansion (DRE). Con 4 GB de RAM integrada y 4 GB adicionales disponibles a trav\u00e9s de la tecnolog\u00eda DRE, tendr\u00e1s a tu alcance potencia adicional cuando la necesites. Ejecuta m\u00e1s aplicaciones simult\u00e1neamente y pasa de una a otra sin ning\u00fan esfuerzo.<h2>CAMPE\u00d3N EN C\u00c1MARAS<\/h2><h2>C\u00c1MARA DE 50 MP CON IA<\/h2><h2>Dise\u00f1ada para ofrecer m\u00e1s nitidez<\/h2><p>El modo de 50 MP mejora en gran medida la nitidez y refleja detalles precisos incluso al capturar fotograf\u00edas de edificios y paisajes complejos.<\/p><h2>Modo nocturno<\/h2><p>El Modo nocturno ilumina los entornos de captura con poca luz sin sacrificar la nitidez para ofrecerte una experiencia de captura potente y fiable en la que podr\u00e1s confiar a cualquier hora del d\u00eda.<\/p><h2>CAMPE\u00d3N EN CARGA<\/h2><h2>Carga SUPERVOOC de 33 W<\/h2><h2>Carga SUPERVOOC de 33 W Un 200 % m\u00e1s r\u00e1pida<\/h2>La carga SUPERVOOC de 33 W incrementa la velocidad de carga en un 200 % en comparaci\u00f3n con la generaci\u00f3n anterior, de modo que podr\u00e1s cargar del 0 al 50 % en tan solo 28 minutos.<br><h2>Gran bater\u00eda de 5000 mAh Potencia para todo el d\u00eda<\/h2>Ve v\u00eddeos o juega a juegos durante todo el d\u00eda y, a\u00fan as\u00ed, te sobrar\u00e1 bater\u00eda.<h2>CAMPE\u00d3N EN DISE\u00d1O<\/h2><h2>Dise\u00f1o brillante y elegante<\/h2><h2>Proceso de polvo de vidrio brillante<\/h2><p>El proceso de polvo de vidrio brillante combina dos texturas, una brillante en la parte superior en contraste con otra que resplandece bajo la luz en la parte inferior: la uni\u00f3n perfecta para crear un efecto din\u00e1mico excepcional.<\/p><h2>Cuerpo fino. Sensaci\u00f3n liviana en la mano.<\/h2><p>Un cuerpo ultrafino de tan solo 7,99 mm se combina con un dise\u00f1o lateral de \u00e1ngulo en C para conseguir un tel\u00e9fono con un aspecto visualmente impactante y que se adapta perfectamente a la mano.<\/p><h2>Pantalla de 17,13 cm (6,74') y 90 Hz<\/h2><p>Una pantalla de gran tama\u00f1o se combina con una frecuencia de actualizaci\u00f3n ultrafluida de 90 Hz para que disfrutes de una experiencia de visualizaci\u00f3n expansiva con la que te sumergir\u00e1s de lleno en el juego.<\/p><p><b>16,7 millones<\/b><br>de colores de pantalla<br><b>hasta 90 Hz<\/b><br>Frecuencia de actualizaci\u00f3n de<br><b>90,3 %<\/b><br>Relaci\u00f3n pantalla-cuerpo del<\/p><h2>Minic\u00e1psula<\/h2><p>Consultar la informaci\u00f3n importante, como el estado de la bater\u00eda, el uso de datos o los pasos diarios, nunca antes hab\u00eda sido tan sencillo.<\/p><h2>Potente conjunto de chips de ocho n\u00facleos<\/h2>Un conjunto de chips de ocho n\u00facleos pone en tus manos un rendimiento potente y un procesamiento eficiente que te permitir\u00e1n descubrir una experiencia realmente fluida dise\u00f1ada para satisfacer todas tus necesidades.<br><h2>Ranura para 3 tarjetas<\/h2><h2>Memoria externa de hasta 2 TB<\/h2>Dos ranuras para tarjetas SIM y una ranura especial para una tarjeta micro-SD te ofrecen m\u00e1s opciones de uso para tu tel\u00e9fono.<br><br><h2>NFC de 360\u00b0<\/h2>Desliza sin problemas desde cualquier posici\u00f3n y \u00e1ngulo en la parte superior del tel\u00e9fono. Gracias al nuevo dise\u00f1o de la bobina y la antena m\u00f3vil, la superficie NFC es el doble de grande, de modo que podr\u00e1s deslizar con mayor eficacia.<br><br><h2>Huella digital lateral r\u00e1pida<\/h2>La perfecci\u00f3n en cuanto a rapidez y seguridad. Un simple toque y est\u00e1s dentro.<br><br><ul><li><b>Procesador<\/b><\/li><li>Potente conjunto de chips de ocho n\u00facleos<\/li><li>CPU: proceso de 12 nm, ocho n\u00facleos, hasta 1,82 GHz<\/li><li>GPU: Mal\u00ed-G57<\/li><li><b>Almacenamiento y RAM<\/b><\/li><li>Opci\u00f3n m\u00e1xima de 4 GB + 128 GB<\/li><li>RAM: 4GB LPDDR4X<\/li><li>ROM: 128GB<\/li><li>Hasta 2 TB de memoria externa<\/li><li><b>Pantalla<\/b><\/li><li>Pantalla de 17,13 cm (6,74'') y 90 Hz<\/li><li>Frecuencia de actualizaci\u00f3n: 90Hz<\/li><li>Tasa de muestreo t\u00e1ctil: 180Hz<\/li><li>Brillo m\u00e1ximo: 560nits<\/li><li>Relaci\u00f3n pantalla-cuerpo: 90,3 %<\/li><li>Tasa de muestreo t\u00e1ctil: 180Hz<\/li><li>Colores de pantalla: 16,7 millones<\/li><li><b>C\u00e1mara<\/b><\/li><li>C\u00e1mara con IA de 50MP<\/li><li>P\u00edxeles: 50MP<\/li><li>Lente: 5P<\/li><li>campo de visi\u00f3n: 77\u00b0<\/li><li>Apertura: f\/1.8<\/li><li>Distancia focal: 27 mm<\/li><li>Funciones de fotograf\u00eda:<\/li><li>Modo de 50MP, Video, Modo nocturno, Vista panor\u00e1mica, Experto, Lapso de tiempo, Modo de retrato, HDR, Reconocimiento de escena AI, Filtro, C\u00e1mara lenta<\/li><li>Grabaci\u00f3n de v\u00eddeo:<\/li><li>Soporta grabaci\u00f3n de video 1080P\/30fps<\/li><li>Soporta grabaci\u00f3n de video 720P\/30fps<\/li><li>Soporta grabaci\u00f3n de video 480P\/30fps<\/li><li>C\u00e1mara para selfies de 5MP<\/li><li>P\u00edxeles: 5MP<\/li><li>Lente: 3P<\/li><li>campo de visi\u00f3n: 76,8\u00b0<\/li><li>Apertura: f\/2.22<\/li><li>Funciones de fotograf\u00eda:<\/li><li>Video<\/li><li>Modo retrato<\/li><li>Modo belleza,\u00a0<\/li><li>HDR, Reconocimiento facial, Filtro, Control de efecto Bokeh<\/li><li>Grabaci\u00f3n de v\u00eddeo:<\/li><li>Soporta grabaci\u00f3n de video 720P\/30fps<\/li><li>Soporta grabaci\u00f3n de video 480P\/30fps<\/li><li>Soporta grabaci\u00f3n de video CIF\/30fps<\/li><li><b>Carga y Bater\u00eda<\/b><\/li><li>Carga SUPERVOOC 33W<\/li><li>Bater\u00eda masiva de 5000 mAh (t\u00edpico)<\/li><li>Capacidad de la bater\u00eda de 4880 mAh (m\u00edn.)<\/li><li>Incluye un adaptador de carga de 11 V\/3 A.<\/li><li>Puerto USB tipo C<\/li><li><b>Redes y Inal\u00e1mbrico<\/b><\/li><li>Bandas de frecuencia:<\/li><li>G\/M: 850\/900\/1800\/1900 MHz<\/li><li>WCDMA: Bandas 1\/5\/8<\/li><li>FDD-LTE: Bandas 1\/3\/5\/8<\/li><li>TD-LTE: Bandas 38\/40\/41<\/li><li>Inal\u00e1mbrico:<\/li><li>WiFi de 2,4\/5 GHz<\/li><li>Bluetooth 5.0<\/li><li><b>Tama\u00f1o y peso<\/b><\/li><li>Longitud: 167,2 mm<\/li><li>Ancho: 76,7 mm<\/li><li>Profundidad 7,99 mm<\/li><li>Peso 186g<\/li><li><b>Sensores<\/b><\/li><li>Sensor de inducci\u00f3n magn\u00e9tica<\/li><li>Sensor de luz<\/li><li>Sensor de proximidad<\/li><li>girometro<\/li><li>Sensor de aceleraci\u00f3n<\/li><li>Navegaci\u00f3n<\/li><li>GPS\/AGPS\/GLONASS\/Galileo<\/li><li><b>Puertos<\/b><\/li><li>Conector para auriculares de 3,5 mm<\/li><li>Tipo-C<\/li><li>Ranura para 3 tarjetas<\/li><li><b>Sistema operativo<\/b><\/li><li>edici\u00f3n realme UI T<\/li><li>Basado en Android 13<\/li><li><b>Contenido del embalaje<\/b><\/li><li>realme C51<\/li><li>Adaptador de corriente de 33W<\/li><li>Cable USB tipo C<\/li><li>Funda protectora<\/li><li>Aguja de tarjeta SIM<\/li><li>Gu\u00eda r\u00e1pida<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_real-sp%20c51%204-128%20gree_1.jpg","wholesale_price":"85.87","unit_price_tax":90.87},"product_model":{"product_data":{"ean13":["6941764417366"],"reference":"C51 4-128 GREE","name":{"1":"Smartphone Realme C51 4GB\/ 128GB\/ 6.74'\/ Verde Menta","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>C\u00c1MARA CON M\u00c1S NITIDEZ.<\/h2><h2>CARGA M\u00c1S R\u00c1PIDA.<\/h2><h2>M\u00c1S ESPACIO DE ALMACENAMIENTO.<\/h2><h2>UN CAMPE\u00d3N DE OTRO NIVEL.<\/h2><h2>ROM de 128 GB Almacenamiento mejorado<\/h2><br>Con la memoria ROM de 128 GB, tendr\u00e1s m\u00e1s espacio para tus fotos, v\u00eddeos, juegos y pel\u00edculas favoritos. Y gracias al almacenamiento adicional disponible, todas las tareas se ejecutar\u00e1n sin problemas en segundo plano.<br><br><h2>RAM din\u00e1mica de hasta 4 GB + 4 GB Uniformidad aumentada<\/h2>Ad\u00e9ntrate en un nuevo mundo de potencia con Dynamic RAM Expansion (DRE). Con 4 GB de RAM integrada y 4 GB adicionales disponibles a trav\u00e9s de la tecnolog\u00eda DRE, tendr\u00e1s a tu alcance potencia adicional cuando la necesites. Ejecuta m\u00e1s aplicaciones simult\u00e1neamente y pasa de una a otra sin ning\u00fan esfuerzo.<h2>CAMPE\u00d3N EN C\u00c1MARAS<\/h2><h2>C\u00c1MARA DE 50 MP CON IA<\/h2><h2>Dise\u00f1ada para ofrecer m\u00e1s nitidez<\/h2><p>El modo de 50 MP mejora en gran medida la nitidez y refleja detalles precisos incluso al capturar fotograf\u00edas de edificios y paisajes complejos.<\/p><h2>Modo nocturno<\/h2><p>El Modo nocturno ilumina los entornos de captura con poca luz sin sacrificar la nitidez para ofrecerte una experiencia de captura potente y fiable en la que podr\u00e1s confiar a cualquier hora del d\u00eda.<\/p><h2>CAMPE\u00d3N EN CARGA<\/h2><h2>Carga SUPERVOOC de 33 W<\/h2><h2>Carga SUPERVOOC de 33 W Un 200 % m\u00e1s r\u00e1pida<\/h2