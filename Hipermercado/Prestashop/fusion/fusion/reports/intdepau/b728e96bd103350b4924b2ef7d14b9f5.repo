":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"DISNEY","supplier":null,"width":null,"height":null,"depth":null,"weight":0.63,"unit_price":27.13,"unit_price_tax":27.13,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":5,"brand":"DISNEY","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_leo-alt%20stwars%20byoda%20002_1.jpg"],"wholesale_price":22.13}}},"8806087088366":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806087088366",false],"wholesale_price":[197.56,false],"price":[202.56,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84649","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/38817909421a25733d9bdbaab321dc94.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Altavoz con Bluetooth LG XBOOM RNC5\/ 2.0","category":"Altavoces","sub_category":"Altavoces","unit_price":202.56,"reference":"RNC5","ean13":"8806087088366","weight":"0","quantity":0,"brand":"LG","description_pt":"                                                <div><h2>Altavoz todo en uno con sonido bestial<\/h2><p>Gracias al Super Bass Boost, conseguir\u00e1s llevar la fiesta a otro nivel con ritmos potentes y personalizados a tu gusto.<\/p><h2>El sonido que da vida a tus fiestas<\/h2><p>LG XBOOM\u00a0RNC5 genera un flujo de aire extra para reproducir unos graves contundentes y potentes.<\/p><h2>Ilumina la pista de baile<\/h2><p>El colorido de las luces LED var\u00eda y cambia con el ritmo para a\u00f1adir m\u00e1s alegr\u00eda a tus fiestas.<\/p><h2>Tu m\u00f3vil y la m\u00fasica se unen al mismo ritmo<\/h2><p>Dale un poco m\u00e1s de diversi\u00f3n a la fiesta. Conecta hasta tres tel\u00e9fonos y suj\u00e9talos mientras la luz trasera parpadea al ritmo de la m\u00fasica.<\/p><h2>Gira los platos desde la pista de baile<\/h2><p>\u00a1Qu\u00e9 la fiesta no pare! Aplica efectos de sonido directamente desde la aplicaci\u00f3n DJ App en Android o iOS, o controla DJ Pad en el altavoz.<\/p><h2>Canta alto y claro<\/h2><p>Ajusta el volumen de la m\u00fasica y del micr\u00f3fono por separado, reduce las voces de la pista con el Cancelador de voz y ajusta la m\u00fasica a tu tono de voz con el Cambiador de tono. Y, cuando lo tengas todo listo, canta con todo tu coraz\u00f3n.<\/p><h2>Revive la mejor sesi\u00f3n con tus amigos<\/h2><p>Graba tus listas de reproducci\u00f3n y el DJ lo mezclar\u00e1 en el USB para que las puedas volver a escucharlo en cualquier momento, o env\u00edalas a tus amigos por Bluetooth<\/p><br><\/div><h2>ESPECIFICACIONES<\/h2><ul>\t<li><b>Altavoces<\/b><\/li>\t<li>3 Altavoces de 2 v\u00edas<\/li>\t<li>Woofer de 8'<\/li>\t<li>Tweter de 2'x2<\/li>\t<li><b>Conectividad<\/b><\/li>\t<li>USB1<\/li>\t<li>USB2<\/li>\t<li>FM \/ DAB+<\/li>\t<li>Optical<\/li>\t<li>Bluetooth 4.0<\/li>\t<li>Entrada Micro ( 6.3mm) \/ Entrada Guitarra (6.3mm)<\/li>\t<li><b>Funciones<\/b><\/li>\t<li>Formatos de audio: MP3, WMA, Bluetooth AAC\/SBC Codec<\/li>\t<li>Compatible con APP XBOOM Bluetooth (Android \/ IOS)<\/li>\t<li>Altavoz con iluminaci\u00f3n Multicolor RGB<\/li>\t<li>Wireless Party Link (Twin Mode)<\/li>\t<li>Efectos DJ (Por APP): Loop, Scratcher, Sampler Creator, Auto DJ<\/li>\t<li>Funciones Karaoke (por APP): Efectos voz, Cancelador de voz, Cambio de Registro, modo Echo<\/li>\t<li><b>Dimensiones<\/b><\/li>\t<li>Dimensiones Equipo ( An x AL x Fn): 330 x 685 x 344 mm<\/li>\t<li>Peso unidad Principal: 13.8 Kg<\/li>\t<li><b>Otros<\/b><\/li>\t<li>Mando MA2<\/li>\t<li>Pilas AAAx2<\/li>\t<li>Manual Simple<\/li>\t<li>Garant\u00eda<\/li>\t<li>Antena DAB+<\/li>\t<li>Asa transporte<\/li><\/ul>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lge-alt%20rnc5_1.jpg","wholesale_price":"197.56","unit_price_tax":202.56},"product_model":{"product_data":{"ean13":["8806087088366"],"reference":"RNC5","name":{"1":"Altavoz con Bluetooth LG XBOOM RNC5\/ 2.0","2":"","3":"","4":""},"description":{"1":"                                                <div><h2>Altavoz todo en uno con sonido bestial<\/h2><p>Gracias al Super Bass Boost, conseguir\u00e1s llevar la fiesta a otro nivel con ritmos potentes y personalizados a tu gusto.<\/p><h2>El sonido que da vida a tus fiestas<\/h2><p>LG XBOOM\u00a0RNC5 genera un flujo de aire extra para reproducir unos graves contundentes y potentes.<\/p><h2>Ilumina la pista de baile<\/h2><p>El colorido de las luces LED var\u00eda y cambia con el ritmo para a\u00f1adir m\u00e1s alegr\u00eda a tus fiestas.<\/p><h2>Tu m\u00f3vil y la m\u00fasica se unen al mismo ritmo<\/h2><p>Dale un poco m\u00e1s de diversi\u00f3n a la fiesta. Conecta hasta tres tel\u00e9fonos y suj\u00e9talos mientras la luz trasera parpadea al ritmo de la m\u00fasica.<\/p><h2>Gira los platos desde la pista de baile<\/h2><p>\u00a1Qu\u00e9 la fiesta no pare! Aplica efectos de sonido directamente desde la aplicaci\u00f3n DJ App en Android o iOS, o controla DJ Pad en el altavoz.<\/p><h2>Canta alto y claro<\/h2><p>Ajusta el volumen de la m\u00fasica y del micr\u00f3fono por separado, reduce las voces de la pista con el Cancelador de voz y ajusta la m\u00fasica a tu tono de voz con el Cambiador de tono. Y, cuando lo tengas todo listo, canta con todo tu coraz\u00f3n.<\/p><h2>Revive la mejor sesi\u00f3n con tus amigos<\/h2><p>Graba tus listas de reproducci\u00f3n y el DJ lo mezclar\u00e1 en el USB para que las puedas volver a escucharlo en cualquier momento, o env\u00edalas a tus amigos por Bluetooth<\/p><br><\/div><h2>ESPECIFICACIONES<\/h2><ul>\t<li><b>Altavoces<\/b><\/li>\t<li>3 Altavoces de 2 v\u00edas<\/li>\t<li>Woofer de 8'<\/li>\t<li>Tweter de 2'x2<\/li>\t<li><b>Conectividad<\/b><\/li>\t<li>USB1<\/li>\t<li>USB2<\/li>\t<li>FM \/ DAB+<\/li>\t<li>Optical<\/li>\t<li>Bluetooth 4.0<\/li>\t<li>Entrada Micro ( 6.3mm) \/ Entrada Guitarra (6.3mm)<\/li>\t<li><b>Funciones<\/b><\/li>\t<li>Formatos de audio: MP3, WMA, Bluetooth AAC\/SBC Codec<\/li>\t<li>Compatible con APP XBOOM Bluetooth (Android \/ IOS)<\/li>\t<li>Altavoz con iluminaci\u00f3n Multicolor RGB<\/li>\t<li>Wireless Party Link (Twin Mode)<\/li>\t<li>Efectos DJ (Por APP): Loop, Scratcher, Sampler Creator, Auto DJ<\/li>\t<li>Funciones Karaoke (por APP): Efectos voz, Cancelador de voz, Cambio de Registro, modo Echo<\/li>\t<li><b>Dimensiones<\/b><\/li>\t<li>Dimensiones Equipo ( An x AL x Fn): 330 x 685 x 344 mm<\/li>\t<li>Peso unidad Principal: 13.8 Kg<\/li>\t<li><b>Otros<\/b><\/li>\t<li>Mando MA2<\/li>\t<li>Pilas AAAx2<\/li>\t<li>Manual Simple<\/li>\t<li>Garant\u00eda<\/li>\t<li>Antena DAB+<\/li>\t<li>Asa transporte<\/li><\/ul>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"LG","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":202.56,"unit_price_tax":202.56,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":0,"brand":"LG","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lge-alt%20rnc5_1.jpg"],"wholesale_price":197.56}}},"8806091987419":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806091987419",false],"wholesale_price":[192.41,false],"price":[197.41,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 3",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84652","Cat. IDs: 89,71","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/a29b7ec4d2b37f9feff0fa2db333f338.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Barra de Sonido con Bluetooth LG SN4R\/ 420W\/ 4.1\/ Negra","category":"Altavoces","sub_category":"Barras de sonido","unit_price":197.41,"reference":"SN4R","ean13":"8806091987419","weight":"3","quantity":2,"brand":"LG","description_pt":"<p><h2>Woofer de Carbono<\/h2><h2>Busqueda de la fildelidad de sonido m\u00e1s alta<\/h2>Cada unidad de woofer est\u00e1 dise\u00f1ada con un diafragma de carbono para asegurar una excelente claridad<br><br><h2>Audio adaptivo para disfrutar todo tipo de contenidos.<\/h2>El sonido IA Pro analiza autom\u00e1ticamente el contenido para instantaneamente optimizar los ajustes del audio que se est\u00e9 reproduciendo. Disfruta de cada detalle como una conversaci\u00f3n clara como el agua o una escena de acci\u00f3n incre\u00edble, dependiendo del g\u00e9nero.<br><br><h2>A\u00f1ade m\u00e1s potencia f\u00e1cilmente<\/h2>Siente el ritmo con los potentes subwoofer inal\u00e1mbrico de la Barra de Sonido LG SN4R. Con un extra de 200 watts, suena genial y f\u00e1cil y conveniente de instalar.<br><br><h2>Con\u00e9ctalo de la manera m\u00e1s conveniente<\/h2>A\u00f1ade la conectividad por Bluetooth\u00ae a las opciones de audio o con\u00e9ctalo convenientemente y disfr\u00fatalo mediante un cable \u00f3ptico o HDMI.<br><br><h2>Streaming Inteligente para la mejor calidad de audio<\/h2>Reproduce m\u00fasica directamente desde tu smartphone a tu Barra de Sonido LG SN4R via Bluetooth\u00ae. Sonido excepcional para toda tu m\u00fasica a tu alcance.<br><br><h2>Sincron\u00edzala con tu TV<\/h2>La Barra de Sonido SN4R es f\u00e1cilmente conectable con tu televisor LG via Bluetooth\u00ae o cable \u00f3ptico. Tu experiencia audiovisual completa estar\u00e1 lista f\u00e1cilmente.<br><br><ul>  <li><b>POTENCIA<\/b><\/li>  <li>Potencia total: 420W, (82dB)<\/li>  <li>Subwoofer: 200W(Inal\u00e1mbrico), (85dB)<\/li>  <li>Sistema: 4.1ch<\/li>  <li><b>SONIDO ESPECIAL<\/b><\/li>  <li>DTS Virtual: X<\/li>  <li>ASC (Adaptvie Sound Control): S\u00ed<\/li>  <li>HDMI Audio Return Channel (ARC): S\u00ed<\/li>  <li>Bass Blast \/ Bass Blast +: S\u00ed<\/li>  <li><b>FORMATOS DE AUDIO<\/b><\/li>  <li>LPCM: S\u00ed<\/li>  <li>Dolby Digital: S\u00ed<\/li>  <li>DTS Digital Surround: S\u00ed<\/li>  <li>AAC \/ AAC+: S\u00ed<\/li>  <li>FLAC (USB): S\u00ed<\/li>  <li>OGG (USB): S\u00ed<\/li>  <li>WAV (USB): S\u00ed<\/li>  <li>MP3 (USB): S\u00ed<\/li>  <li>WMA (USB): S\u00ed<\/li>  <li><b>CONEXIONES<\/b><\/li>  <li>Bluetooth 4.0: S\u00ed<\/li>  <li>Optical: S\u00ed<\/li>  <li>HDMI 1.4 (1in\/1out): S\u00ed<\/li>  <li>USB: S\u00ed<\/li>  <li><b>OTROS<\/b><\/li>  <li>Sound Sync Bluetooth\/\u00d3ptico: S\u00ed<\/li>  <li>Control Volumen+\/- con el mando de tu TV: S\u00ed<\/li>  <li>User EQ - Mando\/App: S\u00ed<\/li>  <li>Modo Noche &#8211; App: S\u00ed<\/li>  <li>App de control: Android<\/li>  <li>HDMI SIMPLINK: S\u00ed<\/li>  <li>A\/V Sync (0~300ms) - App: S\u00ed<\/li>  <li><b>ACCESORIOS<\/b><\/li>  <li>Manual Simple: S\u00ed<\/li>  <li>Garant\u00eda: S\u00ed<\/li>  <li>Mando MA7: S\u00ed<\/li>  <li>Pilas: AAA x 2<\/li>  <li><b>DIMENSIONES<\/b><\/li>  <li>Unidad Principal: 890 x 57 x 85 mm, 2.35Kg<\/li>  <li>Medida para TVs de Mayor \/ Igual 40 Pulgadas: S\u00ed<\/li>  <li>Subwoofer: 180 x 394 x 290 mm, 5.8Kg<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_lge-alt%20sn4r_1.jpg","wholesale_price":"192.41","unit_price_tax":197.41},"product_model":{"product_data":{"ean13":