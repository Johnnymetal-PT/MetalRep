scription":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TOSHIBA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.5,"unit_price":21.67,"unit_price_tax":21.67,"tax_rules_group":null,"category":"Altavoces","sub_category":"Altavoces","quantity":5,"brand":"TOSHIBA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tos-alt%20wsp70%20rd_1.jpg"],"wholesale_price":16.67}}},"8713439244823":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8713439244823",false],"wholesale_price":[22.38,false],"price":[27.38,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.7",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84715","Cat. IDs: 89,71","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/7987b637b1d0e071d9bf8450420aef25.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Barra de Sonido Trust Gaming GXT 620 Axon\/ 12W\/ 2.0","category":"Altavoces","sub_category":"Barras de sonido","unit_price":27.38,"reference":"24482","ean13":"8713439244823","weight":"0.7","quantity":2,"brand":"TRUST GAMING","description_pt":"                                                <p>Barra de sonido para gaming con iluminaci\u00f3n RGB en ondas de arco iris y volumen de f\u00e1cil acceso<br><\/p><p><h2>Sonido\u00a0visible<\/h2><p>La barra de sonido iluminada GXT 620 Axon RGB ilumina tu experiencia de audio en los juegos, con una iluminaci\u00f3n RGB de ondas arco\u00edris que se adapta al ambiente de tus juegos y accesorios favoritos. Inmersiva, elegante y colorida, te permitir\u00e1 experimentar el sonido como nunca.\u00a0<\/p><h2>Ahorro\u00a0de\u00a0espacio<\/h2><p>El dise\u00f1o compacto de la barra de sonido permite que se pueda colocar f\u00e1cilmente debajo de una TV o de un monitor de PC, mientras que los 12\u00a0W de potencia ofrecen cualquier cosa menos un sonido m\u00ednimo. Disfrutar\u00e1s de un entorno de juego despejado, junto con un sonido cristalino.<\/p><h2>Conectada,\u00a0personalizada,\u00a0controlada<\/h2><p>Un dial de control grande e iluminado permite ajustar el volumen de una manera r\u00e1pida y sencilla, incluso durante las sesiones de juego m\u00e1s intensas. Un cable USB act\u00faa como fuente de alimentaci\u00f3n, y una \u00fanica entrada AUX de 3,5\u00a0mm conecta tu sonido y te permite reproducir m\u00fasica directamente desde tu dispositivo, personalizando a\u00fan m\u00e1s tu experiencia.<\/p><br><\/p><p><p><ul><li><b>General<\/b><\/li><li>Tipo de altavoz<\/li><li>Barra de sonido<\/li><li>Altura del producto principal (en mm)<\/li><li>68mm<\/li><li>Ancho del producto principal (en mm)<\/li><li>420mm<\/li><li>Profundidad del producto principal (en mm)<\/li><li>78mm<\/li><li>Peso total<\/li><li>713 gramos<\/li><li>Peso de la unidad principal<\/li><li>590g<\/li><li><b>Caracter\u00edsticas<\/b><\/li><li><span style='background-color: initial;'>RGB<\/span><\/li><li>Control<\/li><li>Control S<\/li><li>control de volumen, encendido\/apagado de luces<\/li><li><b>Conectividad<\/b><\/li><li>Tipo de conexi\u00f3n<\/li><li>cableado<\/li><li>cables incluidos<\/li><li>Alimentaci\u00f3n USB\/conector de 3,5 mm de 140 cm<\/li><li>Audio<\/li><li>Potencia de salida (pico)<\/li><li>12 W<\/li><li>Potencia de salida (RMS)<\/li><li>6 W.<\/li><li>Respuesta frecuente<\/li><li>20 Hz - 20 000 Hz<\/li><li>Unidades de controlador<\/li><li>2<\/li><li>Impedancia del altavoz<\/li><li>4 ohmios<\/li><li>Impedancia de entrada<\/li><li>10000 ohmios<\/li><li>Entrada de audio<\/li><li>3,5mm<\/li><li>Salida de audio<\/li><li>Ninguna<\/li><li><b>Encendido<\/b><\/li><li>Luces<\/li><li>s\u00ed<\/li><li><b>Aporte<\/b><\/li><li>Fuente de alimentaci\u00f3n<\/li><li>USB<\/li><li><b>Compatibilidad<\/b><\/li><li>Tipos de dispositivos compatibles<\/li><li>computadora port\u00e1til, pc, tel\u00e9fono inteligente, tableta<\/li><li><b>Compatibilidad general<\/b><\/li><li>Dispositivos con un conector de salida de audio de 3,5 mm<\/li><\/ul><\/p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-alt%20gxt%20620%20axon_1.jpg","wholesale_price":"22.38","unit_price_tax":27.38},"product_model":{"product_data":{"ean13":["8713439244823"],"reference":"24482","name":{"1":"Barra de Sonido Trust Gaming GXT 620 Axon\/ 12W\/ 2.0","2":"","3":"","4":""},"description":{"1":"                                                <p>Barra de sonido para gaming con iluminaci\u00f3n RGB en ondas de arco iris y volumen de f\u00e1cil acceso<br><\/p><p><h2>Sonido\u00a0visible<\/h2><p>La barra de sonido iluminada GXT 620 Axon RGB ilumina tu experiencia de audio en los juegos, con una iluminaci\u00f3n RGB de ondas arco\u00edris que se adapta al ambiente de tus juegos y accesorios favoritos. Inmersiva, elegante y colorida, te permitir\u00e1 experimentar el sonido como nunca.\u00a0<\/p><h2>Ahorro\u00a0de\u00a0espacio<\/h2><p>El dise\u00f1o compacto de la barra de sonido permite que se pueda colocar f\u00e1cilmente debajo de una TV o de un monitor de PC, mientras que los 12\u00a0W de potencia ofrecen cualquier cosa menos un sonido m\u00ednimo. Disfrutar\u00e1s de un entorno de juego despejado, junto con un sonido cristalino.<\/p><h2>Conectada,\u00a0personalizada,\u00a0controlada<\/h2><p>Un dial de control grande e iluminado permite ajustar el volumen de una manera r\u00e1pida y sencilla, incluso durante las sesiones de juego m\u00e1s intensas. Un cable USB act\u00faa como fuente de alimentaci\u00f3n, y una \u00fanica entrada AUX de 