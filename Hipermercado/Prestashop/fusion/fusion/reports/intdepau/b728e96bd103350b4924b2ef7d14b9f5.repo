s:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_pila%20fonestar%20r03_1.jpg"],"wholesale_price":4.59}}},"8713016014924":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8713016014924",false],"wholesale_price":[18.33,false],"price":[23.33,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.55",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:87689","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/b0d328e6c8e15f502c302d03f0530142.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Despertador AudioSonic CL-1492\/ Radio FM","category":"Electronica","sub_category":"Despertadores","unit_price":23.33,"reference":"CL-1492","ean13":"8713016014924","weight":"0.55","quantity":5,"brand":"AUDIOSONIC","description_pt":"<p>Con el reloj despertador Smartwares CL-1492 podr\u00e1 despertarse con su emisora de radio favorita. Adem\u00e1s, el reloj despertador cuenta con dos alarmas y funci\u00f3n de repetici\u00f3n.<br><h2>No vuelva a quedarse dormido<\/h2>Este reloj despertador cuenta con dos alarmas para que pueda establecer una para su pareja y otra para usted mismo, o dos para usted mismo si le cuesta mucho levantarse. Utilice la funci\u00f3n de cancelaci\u00f3n para fines de semana y aseg\u00farese de que los fines de semana la alarma no suena. Adem\u00e1s, puede utilizar una bater\u00eda auxiliar para asegurarse de que se despierta a tiempo si se produce un corte del suministro el\u00e9ctrico.<br><h2>Proyecci\u00f3n de la hora<\/h2>Este despertador cuenta con un proyector que le permite proyectar la hora actual en la pared o en el techo. Su luz roja garantiza que los n\u00fameros se muestren con claridad y sean f\u00e1ciles de leer en la oscuridad. El proyector se enfoca con facilidad, por lo que siempre brillar\u00e1 en la direcci\u00f3n adecuada.<br><h2>Alarma o radio<\/h2>Elija c\u00f3mo quiere despertarse: con una alarma o con la radio. La radio busca autom\u00e1ticamente las mejores frecuencias y permite guardar hasta 10 emisoras. Gracias a esta funci\u00f3n, podr\u00e1 despertarse siempre con su emisora de radio favorita. La luz verde es regulable, por lo que podr\u00e1 cambiar entre los modos para seleccionar el m\u00e1s agradable.<br><h2>Contenido de la caja:<\/h2>Reloj despertador, manual de instrucciones<br><h2>Caracter\u00edsticas:<\/h2><ul>  <li>Aseg\u00farese de despertarse siempre a tiempo con este reloj despertador digital con radio FM<\/li>  <li>Configure las dos alarmas para usted o para su pareja.<\/li>  <li>Elija su emisora de radio favorita y guarde hasta 10 emisoras.<\/li>  <li>Proyecte la hora en la pared o en el techo gracias a su proyector.<\/li>  <li>Prep\u00e1rese ante un posible corte del suministro el\u00e9ctrico con una bater\u00eda auxiliar.<\/li><\/ul><p><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_aud-des%20cl-1492_1.jpg","wholesale_price":"18.33","unit_price_tax":23.33},"product_model":{"product_data":{"ean13":["8713016014924"],"reference":"CL-1492","name":{"1":"Despertador AudioSonic CL-1492\/ Radio FM","2":"","3":"","4":""},"description":{"1":"<p>Con el reloj despertador Smartwares CL-1492 podr\u00e1 despertarse con su emisora de radio favorita. Adem\u00e1s, el reloj despertador cuenta con dos alarmas y funci\u00f3n de repetici\u00f3n.<br><h2>No vuelva a quedarse dormido<\/h2>Este reloj despertador cuenta con dos alarmas para que pueda establecer una para su pareja y otra para usted mismo, o dos para usted mismo si le cuesta mucho levantarse. Utilice la funci\u00f3n de cancelaci\u00f3n para fines de semana y aseg\u00farese de que los fines de semana la alarma no