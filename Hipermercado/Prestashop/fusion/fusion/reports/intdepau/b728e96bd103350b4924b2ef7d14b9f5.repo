product":["",false],"ean13":["6923410715361",false],"wholesale_price":[4.55,false],"price":[9.55,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.04",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:84908","Cat. IDs: 71","Associated Categories","Cat. Default: 71","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/40aeae63caf62b22cf89785f7923aebc.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Auriculares Intrauditivos Philips SHE3595\/ con Micr\u00f3fono\/ Jack 3.5\/ Rosas","category":"Auriculares","sub_category":"Auriculares","unit_price":9.55,"reference":"SHE3595PK","ean13":"6923410715361","weight":"0.04","quantity":5,"brand":"PHILIPS","description_pt":"<p><h2>Graves din\u00e1micos<\/h2>El dise\u00f1o intrauditivo ultrapeque\u00f1o de estos auriculares con almohadillas suaves ofrece un ajuste c\u00f3modo y compacto. Con altavoces eficientes y de tama\u00f1o reducido que ofrece un sonido claro con graves din\u00e1micos. Micr\u00f3fono y bot\u00f3n para descolgar integrados para disfrutar de llamadas c\u00f3modamente. <br><br><h2>Micr\u00f3fono y bot\u00f3n de llamada integrados<\/h2>Su micr\u00f3fono y bot\u00f3n de llamada integrados te permiten usar este auricular de Philips tanto para escuchar m\u00fasica como para realizar llamadas con tu tel\u00e9fono m\u00f3vil. Disfruta de las llamadas telef\u00f3nicas manos libres, puedes aceptar y finalizar llamadas f\u00e1cilmente desde el auricular.<br><br><h2>3 juegos de almohadillas de caucho para una \u00f3ptima adaptaci\u00f3n a cualquier o\u00eddo<\/h2>Con 3 tama\u00f1os de almohadillas intercambiables, siempre dispondr\u00e1s de un juego para que estos auriculares de Philips se ajusten perfectamente al tama\u00f1o de tu o\u00eddo.<br><br><h2>Altavoces peque\u00f1os y potentes que reproducen un sonido con graves precisos<\/h2>Los altavoces peque\u00f1os y potentes para auriculares Philips garantizan un ajuste perfecto y ofrecen un sonido preciso con graves potentes; son perfectos para disfrutar de la mejor m\u00fasica.<br><br><h2>Dise\u00f1o ultrapeque\u00f1o para un ajuste intrauditivo c\u00f3modo<\/h2>Dise\u00f1o ultrapeque\u00f1o y ligero para un ajuste perfecto en todo tipo de o\u00eddos; ideal para escuchar m\u00fasica durante horas.<br><br><h2>Un cable de 1,2 m de longitud ideal para utilizarlo en el exterior<\/h2>La longitud de cable ideal que te dar\u00e1 la libertad de colocar tu dispositivo de audio donde quieras.<br><br><h2>Perfecto sellado intrauditivo para eliminar el ruido externo<\/h2>Los peque\u00f1os controladores de altavoces de estos auriculares Philips se adaptan c\u00f3modamente a la oreja y gracias a su ajuste excepcionalmente c\u00f3modo consiguen bloquear el ruido exterior para ofrecer una experiencia de audici\u00f3n intensa.<br><br><h2>Sistema de protecci\u00f3n de goma para el cable que aumenta la duraci\u00f3n<\/h2>Para prolongar la vida \u00fatil del producto, la goma flexible situada entre los auriculares y el cable protege la conexi\u00f3n de los da\u00f1os causados por la curvatura continua del cable.<br><br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Sonido<\/li>  <li>Sistema ac\u00fastico<\/li>  <li>Cerrado<\/li>  <li>Tipo de im\u00e1n<\/li>  <li>Neodimio<\/li>  <li>Bobina m\u00f3vil<\/li>  <li>Cobre<\/li>  <li>Diafragma<\/li>  <li>C\u00fapula mylar<\/li>  <li>Impedancia<\/li>  <li>16 ohmios<\/li>  <li>Entrada de alimentaci\u00f3n m\u00e1xima<\/li>  <li>50 mW<\/li>  <li>Sensibilidad<\/li>  <li>103 dB<\/li>  <li>Di\u00e1metro del altavoz<\/li>  <li>9 mm<\/li>  <li>Tipo<\/li>  <li>Din\u00e1mico<\/li>  <li>Respuesta de frecuencia<\/li>  <li>12 - 23.500&nbsp; Hz<\/li>  <li>Conectividad<\/li>  <li>Conexi\u00f3n de cable<\/li>  <li>Dos en paralelo, sim\u00e9trico<\/li>  <li>Longitud de cable<\/li>  <li>1,2 m<\/li>  <li>Tipo de cable<\/li>  <li>Cobre<\/li>  <li>Acabado del conector<\/li>  <li>Cromado<\/li>  <li>Micr\u00f3fono<\/li>  <li>Micr\u00f3fono integrado<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-aur%20she3595%20pk_1.jpg","wholesale_price":"4.55","unit_price_tax":9.55},"product_model":{"product_data":{"ean13":["6923410715361"],"reference":"SHE3595PK","name":{"1":"Auriculares Intrauditivos Philips SHE3595\/ con Micr\u00f3fono\/ Jack 3.5\/ Rosas","2":"","3":"","4":""},"description":{"1":"<p><h2>Graves din\u00e1micos<\/h2>El dise\u00f1o intrauditivo ultrapeque\u00f1o de estos auriculares con almohadillas suaves ofrece un ajuste c\u00f3modo y compacto. Con altavoces eficientes y de tama\u00f1o reducido que ofrece un sonido claro con graves din\u00e1micos. Micr\u00f3fono y bot\u00f3n para descolgar integrados para disfrutar de llamadas c\u00f3modamente. <br><br><h2>Micr\u00f3fono y bot\u00f3n de llamada integrados<\/h2>Su micr\u00f3fono y bot\u00f3n de llamada integrados te permiten usar este auricular de Philips tanto para escuchar m\u00fasica como para realizar llamadas con tu tel\u00e9fono m\u00f3vil. Disfruta de las llamadas telef\u00f3nicas manos libres, puedes aceptar y finalizar llamadas f\u00e1cilmente desde el auricular.<br><br><h2>3 juegos de almohadillas de caucho para una \u00f3ptima adaptaci\u00f3n a cualquier o\u00eddo<\/h2>Con 3 tama\u00f1os de almohadillas intercambiables, siempre dispondr\u00e1s de un juego para que estos auriculares de Philips se ajusten perfectamente al tama\u00f1o de tu o\u00eddo.<br><br><h2>Altavoces peque\u00f1os y potentes que reproducen un sonido con graves precisos<\/h2>Los altavoces peque\u00f1os y potentes para auriculares Philips garantizan un ajuste perfecto y ofrecen un sonido preciso con graves potentes; son perfectos para disfrutar de la mejor m\u00fasica.<br><br><h2>Dise\u00f1o ultrapeque\u00f1o para un ajuste intrauditivo c\u00f3modo<\/h2>Dise\u00f1o ultrapeque\u00f1o y ligero para un ajuste perfecto en todo tipo de o\u00eddos; ideal para escuchar m\u00fasica durante horas.<br><br><h2>Un cable de 1,2 m de longitud ideal para utilizarlo en el exterior<\/h2>La longitud de cable ideal que te dar\u00e1 la libertad de colocar tu dispositivo de audio donde quieras.<br><br><h2>Perfecto sellado intrauditivo para eliminar el ruido externo<\/h2>Los peque\u00f1os controladores de altavoces de estos auriculares Philips se adaptan c\u00f3modamente a la oreja y gracias a su ajuste excepcionalmente c\u00f3modo consiguen bloquear el ruido exterior para ofrecer una experiencia de audici\u00f3n intensa.<br><br><h2>Sistema de protecci\u00f3n de goma para el cable que aumenta la duraci\u00f3n<\/h2>Para prolongar la vida \u00fatil del producto, la goma flexible situada entre los auriculares y el cable protege la conexi\u00f3n de los da\u00f1os causados por la curvatura continua del cable.<br><br><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Sonido<\/li>  <li>Sistema ac\u00fastico<\/li>  <li>Cerrado<\/li>  <li>Tipo de im\u00e1n<\/li>  <li>Neodimio<\/li>  <li>Bobina m\u00f3vil<\/li>  <li>Cobre<\/li>  <li>Diafragma<\/li>  <li>C\u00fapula mylar<\/li>  <li>Impedancia<\/li>  <li>16 ohmios<\/li>  <li>Entrada de alimentaci\u00f3n m\u00e1xima<\/li>  <li>50 mW<\/li>  <li>Sensibilidad<\/li>  <li>103 dB<\/li>  <li>Di\u00e1metro del altavoz<\/li>  <li>9 mm<\/li>  <li>Tipo<\/li>  <li>Din\u00e1mico<\/li>  <li>Respuesta de frecuencia<\/li>  <li>12 - 23.500&nbsp; Hz<\/li>  <li>Conectividad<\/li>  <li>Conexi\u00f3n de cable<\/li>  <li>Dos en paralelo, sim\u00e9trico<\/li>  <li>Longitud de cable<\/li>  <li>1,2 m<\/li>  <li>Tipo de cable<\/li>  <li>Cobre<\/li>  <li>Acabado del conector<\/li>  <li>Cromado<\/li>  <li>Micr\u00f3fono<\/li>  <li>Micr\u00f3fono integrado<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"",