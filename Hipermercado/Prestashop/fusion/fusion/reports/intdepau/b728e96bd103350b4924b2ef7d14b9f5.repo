<li><span style='font-weight: 700; background-color: initial;'>Color<\/span><\/li><li><span style='background-color: initial;'>Negro<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Tipo de cable<\/span><\/li><li><span style='background-color: initial;'>Recubrimiento de goma<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Potencia<\/span><\/li><li><span style='background-color: initial;'>10W<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Conector<\/span><\/li><li><span style='background-color: initial;'>USB alimentaci\u00f3n + Jack 3.5mm audio<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Drivers<\/span><\/li><li><span style='background-color: initial;'>2 Activos<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Subwoofer<\/span><\/li><li><span style='background-color: initial;'>No<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Rango de frecuencia<\/span><\/li><li><span style='background-color: initial;'>40Hz-20KHz<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Impedancia<\/span><\/li><li><span style='background-color: initial;'>4ohm<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Control de volumen<\/span><\/li><li><span style='background-color: initial;'>S\u00ed<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Entrada auriculares<\/span><\/li><li><span style='background-color: initial;'>No<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Voltaje<\/span><\/li><li><span style='background-color: initial;'>DC 5V<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Corriente<\/span><\/li><li><span style='background-color: initial;'>1A<\/span><\/li><li><span style='font-weight: 700; background-color: initial;'>Compatibilidad<\/span><\/li><li><span style='background-color: 