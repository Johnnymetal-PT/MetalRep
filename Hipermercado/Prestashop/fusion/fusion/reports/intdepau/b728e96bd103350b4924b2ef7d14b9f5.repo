alse],"weight":["Product weight is 0.5",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86601","Cat. IDs: 195,193","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/b5273bea939bb9d47e7cf08efcdbe600.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Router Inal\u00e1mbrico 4G D-Link DWR-921 150Mbps\/ 2 Antenas\/ WiFi 802.11n\/b\/g","category":"Conectividad","sub_category":"Router WIFI","unit_price":68.25,"reference":"DWR-921","ean13":"0790069382246","weight":"0.5","quantity":2,"brand":"DLINK","description_pt":"                                                                                                                                                                                                DWR-921 4G LTE del router D-Link le permite acceder y compartir su4G LTE o conexiones de banda ancha m\u00f3vil 3G. Una vezconectado, puede transferir datos, medios de la corriente, y enviarmensajes SMS. Simplemente inserte su tarjeta SIM \/ USIM y compartirsu 4G LTE o conexi\u00f3n 3G a Internet a trav\u00e9s de una redinal\u00e1mbrica segura o cualquiera de los cuatro puertosEthernet. El LTE router DWR-921 4G est\u00e1 dise\u00f1ado conconexi\u00f3n constante.<br><br><h2>Fast Mobile Internet<\/h2><br>El router LTE 4G le permite conectarse a su 4G LTE conexi\u00f3nm\u00f3vil con altas velocidades de descarga de hasta 100 Mbps yvelocidades de carga de hasta 50 Mbps, que le da una experienciar\u00e1pida y sensible a Internet, lo que le permite navegar porla Web con facilitar y transmitir m\u00fasica y video sinb\u00fafer.<br><br><h2>Asegurar las conexiones por cable e inal\u00e1mbrica<\/h2><br>El DWR-921 utiliza doble cortafuegos activo (SPI y NAT) para evitarposibles intrusiones no deseadas de Internet. Encriptaci\u00f3nWPA\/WPA2 inal\u00e1mbrica de su red inal\u00e1mbrica segura y laseguridad de su tr\u00e1fico, lo que le permite compartir de formasegura sus conexiones 4G LTE o 3G sin tener que preocuparse acercade los usuarios autorizados tengan acceso a su red.<br><br><h2>F\u00e1cil de configurar y utilizar<\/h2><br>El DWR-921 4G LTE Router puede instalarse r\u00e1pida yf\u00e1cilmente en cualquier lugar. <br>Este router es ideal para situaciones donde se necesita una redinal\u00e1mbrica, o donde el acceso convencional a Internet noest\u00e1 disponible. El DWR-921 se puede instalar incluso enautobuses, trenes o barcos, permitiendo a los pasajeros paracomprobar el correo electr\u00f3nico o chat en l\u00ednea,mientras viaja o de viaje.<br><br><h2 style=\\\\\\'line-height: 1.45em;\\\\\\'>Especificaciones t\u00e9cnicas<\/h2><br><p><h2>Interfaz<\/h2><\/p><ul><li>4x puertos 10\/100 Ethernet LAN<\/li><li>WAN (RJ-45)<\/li><li>Dos antenas desmontables 4G LTE \/ 3G<\/li><\/ul><p><h2>Datos<\/h2><\/p><ul><li>Hasta 150 Mbps con clientes 802.11n<\/li><li>LTE de enlace ascendente: hasta 50 Mbps<\/li><li>LTE enlace descendente: hasta 100 Mbps<\/li><\/ul><p><h2>Normas<\/h2><\/p><ul><li>802.11n, compatible con 802.11g \/ b,<\/li><li>802.3<\/li><li>802.3u<\/li><\/ul><p><h2>UMTS \/ HSDPA \/ HSUPA banda<\/h2><\/p><ul><li>900\/2100 MHz<\/li><li>Potencia Clase 3<\/li><\/ul><p><h2>LTE banda<\/h2><\/p><ul><li>900\/1800\/2600\/800 MHz<\/li><\/ul><p><h2>Seguridad inal\u00e1mbrica<\/h2><\/p><ul><li>64\/128-bit WEP (Wired Equivalent Privacy)<\/li><li>WPA y WPA2 (Wi-Fi Protected Access)<\/li><\/ul><p><h2>Firewall<\/h2><\/p><ul><li>Traducci\u00f3n de direcciones de red (NAT)<\/li><li>Stateful Packet Inspection (SPI)<\/li><\/ul><p><h2>VPN<\/h2><\/p><ul><li>L2TP\/PPTP\/IPSEC VPN pass-through<\/li><\/ul><p><h2>Indicadores de estado LED<\/h2><\/p><ul><li>WAN<\/li><li>LAN<\/li><li>WLAN<\/li><li>4G LTE<\/li><li>3G<\/li><li>SMS<\/li><li>Se\u00f1al<\/li><\/ul><p>