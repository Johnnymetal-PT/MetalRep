eywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"INSTA360","supplier":null,"width":null,"height":null,"depth":null,"weight":0.43,"unit_price":260.37,"unit_price_tax":260.37,"tax_rules_group":null,"category":"C\u00e1maras","sub_category":"Camaras Digitales","quantity":5,"brand":"INSTA360","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-cam%20go%202_1.jpg"],"wholesale_price":255.37}}},"6970357851805":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6970357851805",false],"wholesale_price":[371.93,false],"price":[376.93,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.49",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:85904","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/04abb8a00c90e1a57c5515b739eb8039.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"C\u00e1mara Digital Deportiva Insta360 One X2\/ 5.7K\/ \u00c1ngulo de visi\u00f3n 360\u00ba\/ Negra","category":"C\u00e1maras","sub_category":"Camaras Digitales","unit_price":376.93,"reference":"CINOSXX\/A","ean13":"6970357851805","weight":"0.49","quantity":2,"brand":"INSTA360","description_pt":"<p><\/p><h2>CAPTURA 5.7K 360\u00b0<\/h2><h2>Lo imposible en el bolsillo.<\/h2>Desbloquea un mundo de posibilidades creativas con una c\u00e1mara de acci\u00f3n 360&nbsp; de bolsillo que graba, estabiliza y edita v\u00eddeos de 5,7K en 360\u00ba por ti. No equipo adicional.<br><br><h2>La mejor estabilizaci\u00f3n de imagen del sector.<\/h2>Sea cual sea la acci\u00f3n, consigue v\u00eddeo fluido con la ONE X2 y la estabilizaci\u00f3n de imagen de la mejor c\u00e1mara de acci\u00f3n de su clase. Olv\u00eddate del gimbal y coge tu c\u00e1mara 360 de bolsillo.<br><br><h2>Nivela el horizonte.<\/h2>Desbloquea un nivel completamente nuevo de estabilizaci\u00f3n de imagen de c\u00e1maras de acci\u00f3n. <br>Gira tu c\u00e1mara 360 en cualquier direcci\u00f3n y observa c\u00f3mo el horizonte se mantiene nivelado.<br><br><h2>\u00bfSin dron? No pasa nada.<\/h2>Captura con el Selfie Stick Invisible y luego observa c\u00f3mo desaparece en tu edici\u00f3n. Captura f\u00e1cilmente \u00e1ngulos a\u00e9reos y perspectivas en tercera persona con una c\u00e1mara de acci\u00f3n 360&#8212; sin necesidad de un dron.<br><br><h2>Captura primero, apunta despu\u00e9s.<\/h2><h2>Captura estable con una sola lente.<\/h2><p>\u00bfNo te preocupa el reencuadre? Convierte tu c\u00e1mara 360 en una c\u00e1mara de acci\u00f3n tradicional con el modo Steady Cam. Graba con un solo objetivo y obt\u00e9n un metraje ultra estable y gran angular que estar\u00e1 listo para compartir en un instante.<\/p><h2>C\u00e1mara de Acci\u00f3n Robusta y Resistente al Agua.<\/h2><p>Robusta y resistente al agua IPX8 hasta 10 metros (33 pies) nada m\u00e1s sacarla de la caja. Consigue la carcasa de buceo para coser sin problemas tus grabaciones subacu\u00e1ticas en 360\u00ba hasta 45 metros.<\/p><h2>55% m\u00e1s de potencia.<\/h2><p>Una bater\u00eda de 1630 mAh de alto rendimiento la mantiene lista para lo inesperado. Tendr\u00e1s siempre bater\u00eda disponible para disfrutar de tu Insta360 ONE X2.<\/p><h2>Una sala de edici\u00f3n en tu bolsillo.<\/h2><p>La aplicaci\u00f3n Insta360 facilita la edici\u00f3n de tus grabaciones con c\u00e1maras 360 con una serie de herramientas de edici\u00f3n manuales y de IA. Exporta en relaciones de aspecto 16:9, 1:1 o 9:16 y comparte directamente en Instagram, YouTube, Facebook, TikTok y m\u00e1s.<\/p><h2>Ediciones creativas con un solo toque.<\/h2><p>La edici\u00f3n creativa es f\u00e1cil. Elige una plantilla y deja que la IA haga el resto. Shot Lab sigue mejorando con una gama de plantillas constantemente actualizadas basadas en las \u00faltimas y las mejores t\u00e9cnicas de c\u00e1mara 360.<\/p><h2>Bullet Time 3.0<\/h2><p>Reduce la velocidad en el centro de la acci\u00f3n. Bullet Time es m\u00e1s f\u00e1cil y mejor que nunca con la nivelaci\u00f3n autom\u00e1tica de horizonte, aceleraci\u00f3n inteligente y un accesorio completamente nuevo.<\/p><h2>Controla el tiempo y el espacio.<\/h2><p>Hazlo a c\u00e1mara ultralenta o acelera las cosas con un hyperlapse con el modo TimeShift. Controla la velocidad de tus grabaciones 360 o el metraje Steady Cam con facilidad.<\/p><h2>Cong\u00e9late en el tiempo.<\/h2><p>Congela el v\u00eddeo en medio de la acci\u00f3n con solo un toque en el bot\u00f3n de velocidad de la app.<\/p><h2>Lleva el rango din\u00e1mico al extremo.<\/h2><p>La Insta360 ONE X2 es compatible foto y v\u00eddeo HDR, brindando tomas con mejor rango din\u00e1mico e iluminaci\u00f3n natural.<\/p><h2>Domina tu edici\u00f3n en el escritorio.<\/h2><p>Insta360 Studio es el software de edici\u00f3n de v\u00eddeo 360 de escritorio definitivo gratuito. O bien, utiliza nuestros plugins para agilizar la edici\u00f3n en Adobe Premiere Pro.<\/p><p><br><\/p><h2>ESPECIFICACIONES<\/h2><ul>  <li><span style='background-color: initial;'><b>Apertura<\/b><\/span><br><\/li>  <li>F2.0<\/li>  <li>Equivalente a focal de 35mm<\/li>  <li>7.2mm<\/li>  <li>EV<\/li>  <li>\u00b14EV<\/li>  <li>ISO<\/li>  <li>Auto, 100-3200<\/li>  <li>WB<\/li>  <li>Auto, 2700K, 4000K, 5000K, 6500K, 7500K<\/li>  <li><b>Resoluci\u00f3n de Foto<\/b><\/li>  <li>360\u00b0: 6080 x 3040 (2:1) <\/li>  <li>Pano: 4320 \u00d7 1440 (3:1)<\/li>  <li><b>Resoluci\u00f3n de V\u00eddeo<\/b><\/li>  <li>360: <\/li>  <li>5.7K@30fps, 25fps, 24fps<\/li>  <li>4K@50fps, 30fps<\/li>  <li>3K@100fps<\/li>  <li>Gran angular (Modo Steady Cam): <\/li>  <li>2560x1440@50fps, 30fps<\/li>  <li>1920x1080@50fps, 30fps<\/li>  <li><b>Formato de Foto<\/b><\/li>  <li>insp (puede ser exportado con APP o Studio), <\/li>  <li>RAW (dng, los ficheros RAW requieren de un PC\/ Mac)<\/li>  <li><b>Formato de Video<\/b><\/li>  <li>Steady Cam: MP4 360: INSV<\/li>  <li>Modos Foto<\/li>  <li>Est\u00e1ndar, HDR, Burst, Interval, Modo Noche, PureShot, InstaPano<\/li>  <li>Modos V\u00eddeo<\/li>  <li>Est\u00e1ndar, HDR, Timelapse, TimeShift, Bullet Time, Steady Cam<\/li>  <li><b>Modos de exposici\u00f3n<\/b><\/li>  <li>Modos de Foto<\/li>  <li>Auto, Manual(Obturador 1\/8000s-120s, ISO 100-3200), Prioridad de Obturador (1\/8000s-1s), Prioridad de ISO (100-3200), Exposici\u00f3n aislada<\/li>  <li>Modos de V\u00eddeo<\/li>  <li>Auto, Manual(Obturador 1\/8000s-1\/30s, ISO 100-3200), Prioridad de Obturador (1\/8000s-1\/30s), Prioridad de ISO (100-3200), Exposici\u00f3n aislada<\/li>  <li><b>Codificaci\u00f3n de V\u00eddeo<\/b><\/li>  <li>H.264 \/ H.265<\/li>  <li>Tasa de Bits de V\u00eddeo<\/li>  <li>100Mbps<\/li>  <li><b>Gir\u00f3scopo<\/b><\/li>  <li>Gir\u00f3scopo de 6 ejes<\/li>  <li><b>Audio<\/b><\/li>  <li>Reducci\u00f3n de Viento,<\/li>  <li>360 Direccional<\/li>  <li><b>Dispositivos Compatibles<\/b><\/li>  <li>iOS: <\/li>  <li>iOS A11 o superior <\/li>  <li>iPhone SE 2, iPhone 11\/11 Pro\/11 Pro Max, iPhone XS\/XS Max, iPhone XR, iPhone X, iPhone 8\/8 Plus <\/li>  <li>Android: <\/li>  <li>Kirin 980 o superior (Huawei Mate20, P30 y superiores) <\/li>  <li>Qualcomm Snapdragon 845 (Samsung S9, Xiaomi Mi 8 y superiores) <\/li>  <li>Exynos 9810 o superior (Samsung Galaxy S9, S9+, Note9 y superiores) <\/li>  <li>* Los dispositivos que no cumplan los requerimientos mencionados arriba tambi\u00e9n pueden usar la app para controlar la ONE X2, sin embargo, algunas operaciones de alta demanda de potencia como las funciones de IA o la reproducci\u00f3n de v\u00eddeo, pueden no ser tan satisfactorias.<\/li>  <li><b>Bluetooth<\/b><\/li>  <li>BLE 4.2<\/li>  <li>Wi-Fi<\/li>  <li>802.11a\/b\/g\/n\/ac<\/li>  <li>USB<\/li>  <li>Type-C<\/li>  <li>Tarjeta Micro SD<\/li>  <li>Se recomienda velocidad clase UHS-I V30, exFAT(FAT64) formato; m\u00e1xima capacidad de almacenamiento 1TB<\/li>  <li><b>Capacidad de la Bater\u00eda<\/b><\/li>  <li>1630mAh<\/li>  <li><b>M\u00e9todo de Carga<\/b><\/li>  <li>Type-C<\/li>  <li><b>Tiempo de Carga<\/b><\/li>  <li>85 minutos<\/li>  <li><b>Entorno de Uso<\/b><\/li>  <li>-20&#8451; to +40&#8451;<\/li>  <li><b>Peso<\/b><\/li>  <li>149g<\/li>  <li><b>Dimensiones (WxHxD)<\/b><\/li>  <li>4.62 x 11.3 x 2.98 cm<\/li>  <li><b>Autonom\u00eda<\/b><\/li>  <li>5.7K@30fps &#8211; 80 minutos<\/li>  <li><b>Color Profiles<\/b><\/li>  <li>V\u00edvido, Est\u00e1ndar, LOG<\/li><\/ul><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ist-cam%20one%20x2_1.jpg","wholesale_price":"371.93","unit_price_tax":376.93},"product_model":{"product_data":{"ean13":["6970357851805"],"reference":"CINOSXX\/A","name":{"1":"C\u00e1mara Digital Deportiva Insta360 One X2\/ 5.7K\/ \u00c1ngulo de visi\u00f3n 360\u00ba\/ Negra","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>CAPTURA 5.7K 360\u00b0<\/h2><h2>Lo imposible en el bolsillo.<\/h2>Desbloquea un mundo de posibilidades creativas con una c\u00e1mara de acci\u00f3n 360&nbsp; de bolsillo que graba, estabiliza y edita v\u00eddeos de 5,7K en 360\u00ba por ti. No equipo adicional.<br><br><h2>La mejor estabilizaci\u00f3n de imagen del sector.<\/h2>Sea cual sea la acci\u00f3n, consigue v\u00eddeo fluido con la ONE X2 y la estabilizaci\u00f3n de imagen de la mejor c\u00e1mara de acci\u00f3n de su clase. Olv\u00eddate del gimbal y coge tu c\u00e1mara 360 de bolsillo.<br><br><h2>Nivela el horizonte.<\/h2>Desbloquea un nivel completamente nuevo de estabilizaci\u00f3n de imagen de c\u00e1maras de acci\u00f3n. <br>Gira tu c\u00e1mara 360 en cualquier direcci\u00f3n y observa c\u00f3mo el horizonte se mantiene nivelado.<br><br><h2>\u00bfSin dron? No pasa nada.<\/h2>Captura con el Selfie Stick 