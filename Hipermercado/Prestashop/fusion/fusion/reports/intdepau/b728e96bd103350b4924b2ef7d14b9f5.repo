ht":0.05,"unit_price":178.45,"unit_price_tax":178.45,"tax_rules_group":null,"category":"Componentes","sub_category":"Discos Duros SSD","quantity":5,"brand":"WESTERN DIGITAL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wd-ssd%20wd%20bk%20sn850x%202tb_1.jpg"],"wholesale_price":173.45}}},"0718037884639":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0718037884639",false],"wholesale_price":[32.77,false],"price":[37.77,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.07",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:86488","Cat. IDs: 190,98","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/81c519139a89856f5535a20a5347d58a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Disco SSD Western Digital WD Blue SA510 500GB\/ SATA III","category":"Componentes","sub_category":"Discos Duros SSD","unit_price":37.77,"reference":"WDS500G3B0A","ean13":"0718037884639","weight":"0.07","quantity":5,"brand":"WESTERN DIGITAL","description_pt":"                                                <p><h2>WD Blue SA510 SATA SSD 2.5&#8221;\/7mm cased. Eleva tu creatividad<\/h2>Da nueva vida a tu PC para que puedas impulsar tu trabajo y hacer crecer tu potencial creativo. Dise\u00f1ado espec\u00edficamente para profesionales, creadores de contenido y editores, el SSD SATA WD Blue SA510 incluye el software de copia de seguridad y protecci\u00f3n cibern\u00e9tica Acronis\u00ae True Image&#8482; para Western Digital.<br><br><h2>Mejore su creatividad<\/h2>Con velocidades de lectura de hasta 560 MB\/s, este SSD SATA r\u00e1pido ofrece un impulso de rendimiento que se mantiene al d\u00eda con sus cargas de trabajo para que pueda seguir siendo creativo y ser m\u00e1s productivo.<br><br><h2>Renueve su PC<\/h2>\u00bfPor qu\u00e9 comprar una computadora de escritorio nueva y costosa? Con alta resistencia y bajo consumo de energ\u00eda para prolongar la vida \u00fatil del port\u00e1til entre cargas y reducir las vibraciones en comparaci\u00f3n con los discos duros, el SSD WD Blue SA510 SATA es el disco perfecto para una potente actualizaci\u00f3n de PC.<br><br><h2>Ayude a proteger su contenido<\/h2>Clone todo el disco duro de su computadora a su unidad WD Blue SA510 con el software Acronis True Image&#8482; para Western Digital incluido.\u00a0 Este software f\u00e1cil y eficiente tambi\u00e9n ayuda a brindar protecci\u00f3n basada en inteligencia artificial contra el ransomware y lo defiende de muchos ataques.<br><br><h2>Cree con m\u00e1s control<\/h2>Estr\u00e9sese menos y mantenga sus proyectos a punto, ya que el Panel SSD de Western Digital descargable lo ayuda a controlar el estado, la temperatura, el espacio disponible, la versi\u00f3n de firmware y m\u00e1s de su disco.<br><br><br><h2>Especificaciones <\/h2><ul>  <li>Capacidad:500GB<\/li>  <li>Conexi\u00f3n: SATAIII<\/li>  <li>Dimensiones (largo, ancho y alto): 100,2 mm x 69,85 mm x 7 mm<\/li>  <li>Rendimiento de lectura secuencial: 560 MB\/s<\/li>  <li>Rendimiento de escritura secuencial: 510 MB\/s<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wd-ssd%20wd%20bl%20sa510%20500gb_1.jpg","wholesale_price":"32.77","unit_price_tax":37.77},"product_model":{"product_data":{"ean13":["0718037884639"],"reference":"WDS500G3B0A","name":{"1":"Disco SSD Western Digital WD Blue SA510 500GB\/ SATA III","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>WD Blue SA510 SATA SSD 2.5&#8221;\/7mm cased. Eleva tu creatividad<\/h2>Da nueva vida a tu PC para que puedas impulsar tu trabajo y h