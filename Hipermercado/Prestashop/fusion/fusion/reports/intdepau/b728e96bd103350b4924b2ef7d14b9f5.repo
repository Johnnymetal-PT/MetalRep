A<\/li>  <li>Salida: Adaptador de alimentaci\u00f3n externo de 55V DC y 2.55A<\/li>  <li>Consumo m\u00e1ximo: 126W<\/li>  <li><b>PoE&nbsp; <\/b><\/li>  <li>Potencia PoE disponible: 120W<\/li>  <li>Modo PoE A: Pins 1, 2 para alimentaci\u00f3n y pins 3, 6 para alimentaci\u00f3n<\/li>  <li><b>Temperatura admitida&nbsp; <\/b><\/li>  <li>0\u00b0 &#8211; 40 \u00b0C (32\u00b0 &#8211; 104 \u00b0F)<\/li>  <li><b>Humedad admitida&nbsp; <\/b><\/li>  <li>M\u00e1x. 90% sin condensaci\u00f3n<\/li>  <li><b>Dimensiones:&nbsp; <\/b><\/li>  <li>240 x 105 x 27mm (9.45 x 4.13 x 1.1 pulgadas)<\/li>  <li><b>Peso&nbsp; <\/b><\/li>  <li>580g (20.45 onzas)<\/li>  <li><b>Certificaciones&nbsp; <\/b><\/li>  <li>ESTE<\/li>  <li>FCC<\/li>  <li>LVD<\/li>  <li><b>CONTENIDOS DEL PAQUETE<\/b><\/li>  <li>TPE-TG84<\/li>  <li>Gu\u00eda de instalaci\u00f3n r\u00e1pida<\/li>  <li>Adaptador de corriente (55V DC, 2.55A)<\/li><\/ul><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRENDNET","supplier":null,"width":null,"height":null,"depth":null,"weight":1.4,"unit_price":89.35,"unit_price_tax":89.35,"tax_rules_group":null,"category":"Conectividad","sub_category":"Switchs","quantity":2,"brand":"TRENDNET","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_trn-switch%20tpe-tg84_1.jpg"],"wholesale_price":84.35}}},"2610000002348":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["2610000002348",false],"wholesale_price":[5.75,false],"price":[10.75,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.12",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without co