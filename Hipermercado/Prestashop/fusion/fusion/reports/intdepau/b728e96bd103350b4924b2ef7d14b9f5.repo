ada: -40\u00b0C a 60\u00b0C<\/li>  <li>Alimentando<\/li>  <li>Detalles<\/li>  <li>N\u00famero de entradas de CC: 2 (toma de CC, PoE-IN)<\/li>  <li>Voltaje de entrada del conector de CC: 8-30 V<\/li>  <li>Consumo m\u00e1ximo de energ\u00eda: 18 W.<\/li>  <li>Consumo m\u00e1ximo de energ\u00eda sin accesorios: 6 W.<\/li>  <li>Tipo de refrigeraci\u00f3n: Pasivo<\/li>  <li>PoE en: PoE pasivo<\/li>  <li>PoE en voltaje de entrada: 8-30 V<\/li>  <li>salida PoE<\/li>  <li>Detalles<\/li>  <li>Puertos de salida PoE: Ether10<\/li>  <li>Salida PoE: PoE pasivo<\/li>  <li>Salida m\u00e1xima por puerto de salida (entrada 18-30 V): 510mA<\/li>  <li>Salida total m\u00e1xima (A): 510mA<\/li>  <li>Ethernet<\/li>  <li>Detalles<\/li>  <li>Puertos Ethernet 10\/100: 5<\/li>  <li>Puertos Ethernet 10\/100\/1000: 5<\/li>  <li>Certificaci\u00f3n y aprobaciones<\/li>  <li>Detalles<\/li>  <li>Certificaci\u00f3n: CE, EAC, ROHS<\/li>  <li>IP: IP20<\/li><\/ul><p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MIKROTIK","supplier":null,"width":null,"height":null,"depth":null,"weight":0.55,"unit_price":77.69,"unit_price_tax":77.69,"tax_rules_group":null,"category":"Conectividad Profesional","sub_category":"Mikrotik","quantity":2,"brand":"MIKROTIK","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_mkt-switch%20rb2011il-rm_1.jpg"],"wholesale_price":72.69}}},"4752224003157":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4752224003157",false],"wholesale_price":[33.09,false],"price":[38.09,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.32",false],"images":["Create 1 images",false],"tags":["Product witho