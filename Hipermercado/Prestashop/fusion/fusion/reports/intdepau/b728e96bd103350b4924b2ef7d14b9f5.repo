holesale_price":22.23}}},"8435484041980":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484041980",false],"wholesale_price":[36.2,false],"price":[41.2,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.76",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:87529","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/bf66e41631e723c0b78e212a8ce80fb4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Rizador para el pelo Cecotec Bamba SurfCare 750 Travel Magic Waves\/ Gris y Rosa","category":"Cuidado Personal","sub_category":"Planchas de pelo","unit_price":41.2,"reference":"6634198","ean13":"8435484041980","weight":"0.76","quantity":2,"brand":"CECOTEC","description_pt":"                                                <p><h2>Cilindro de cer\u00e1mica avanzada<\/h2>Cilindro de cer\u00e1mica avanzada que permite alcanzar la temperatura de forma r\u00e1pida y estable, evitando el sobrecalentamiento. Ideal para crear unos rizos suaves y brillantes respetando el cabello y cuidando al m\u00e1ximo su salud.<br><br><h2>Look sencillo y personalizado<\/h2>Su agarre vertical permite una postura mucho m\u00e1s relajada favoreciendo crear rizos sim\u00e9tricos en todo el cabello reduciendo los enredos y tirones. Su sistema de rizado permite crear 3 estilos de rizos: en direcci\u00f3n hacia la cara, al rev\u00e9s o alternar la direcci\u00f3n para crear looks m\u00e1s naturales y espectaculares de forma inmediata.<br><br><h2>Pantalla LCD<\/h2>Pantalla LCD con indicadores que muestran: temperatura, ajustable entre 160\u00ba y 200\u00baC, con rango de temperatura de 20\u00baC; y el tiempo, ajustable de 3 a 15 segundos, para adaptarse a cualquier tipo de cabello y estilo de peinado.<br><br><h2>Dial de ajuste y aviso sonoro<\/h2>Dispone de dial de ajuste y aviso sonoro cuando el rizo est\u00e1 listo, cuando la temperatura deseada se ha alcanzado, as\u00ed como cuando se enciende y se apaga.<br><br><h2>Bolsa de viaje termoresistente.<\/h2>Incluye una bolsa termoresistente ideal para guardar el producto con total seguridad, y poder llevarlo donde desees de forma c\u00f3moda y sencilla.<br><br><h2>Hasta 50 minutos de autonom\u00eda<\/h2>Rizador inal\u00e1mbrico que cuenta con una bater\u00eda de litio de 5000 mAh, lo que permite una autonom\u00eda de hasta 50 minutos, para poder rizar el pelo en cualquier sitio y momento, con un tiempo de carga de aproximadamente 3 horas.<br><br><ul>  <li><b>Descripci\u00f3n<\/b><\/li>  <li>Rizador autom\u00e1tico inal\u00e1mbrico de cer\u00e1mica con ajuste de temperatura y tiempo, con pantalla LCD<\/li>  <li>Rizador autom\u00e1tico con cilindro de cer\u00e1mica avanzada que alcanza la temperatura de forma r\u00e1pida y estable, evitando el sobrecalentamiento, ideal para crear unos rizos suaves y brillantes, respetando el cabello y cuidando al m\u00e1ximo su salud. <\/li>  <li>Este rizador es inal\u00e1mbrico y cuenta con una bater\u00eda de litio de 5000 mAh, lo que permite una autonom\u00eda de hasta 50 minutos, para poder rizar el pelo en cualquier sitio y momento, con un tiempo de carga de 3 horas y 15 minutos.<\/li>  <li>Su agarre vertical permite una postura mucho m\u00e1s relajada, consiguiendo crear rizos sim\u00e9tricos en todo el cabello, reduciendo de esta forma los enredos y tirones. Consigue que sea m\u00e1s f\u00e1cil y seguro de usar, alejando el punto de sujeci\u00f3n del elemento calefactor.<\/li>  <li>Pantalla LCD\u00a0 con indicadores que muestran la temperatura y el tiempo, ajustable de 3 a 15 segundos.<\/li>  <li>Temperatura ajustable entre 160\u00ba y 200\u00baC, con rango de temperatura de 20\u00baC para adaptarse a cualquier tipo de cabello. <\/li>  <li>Incluye una bolsa de viaje termorresistente, para poder guardarlo y transportarlo c\u00f3modamente a cualquier lugar. <\/li>  <li>Incluye una gu\u00eda de rizado en la parte superior del cilindro para asegurar que el tama\u00f1o del mech\u00f3n de cabello y la posici\u00f3n, es \u00f3ptima para obtener rizos profesionales de forma f\u00e1cil y sencilla. <\/li>  <li>El sistema de rizado permite crear 3 estilos de rizos: en direcci\u00f3n hacia la cara, al rev\u00e9s o alternar la direcci\u00f3n para crear looks m\u00e1s naturales y espectaculares de forma inmediata<\/li>  <li>Dispone de dial de ajuste para seleccionar tiempo y temperatura de forma f\u00e1cil y sencilla, evitando que durante su uso estos par\u00e1metros se modifiquen de forma accidental<\/li>  <li>Dispone de aviso sonoro cuando el rizo est\u00e1 listo, cuando la temperatura deseada se ha alcanzado, as\u00ed como cuando se enciende y se apaga.<\/li>  <li>Dise\u00f1ado para un calentamiento del cilindro uniforme y r\u00e1pido para poder comenzar a crear looks sin largas esperas.<\/li>  <li><b>Composici\u00f3n<\/b><\/li>  <li>Producto<\/li>  <li>Cargador<\/li>  <li>Bolsa termorresistente<\/li>  <li>Manual de instrucciones<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cec-pae-plp%20surfcare%20750_1.jpg","wholesale_price":"36.20","unit_price_tax":41.2},"product_model":{"product_data":{"ean13":["8435484041980"],"reference":"6634198","name":{"1":"Rizador para el pelo Cecotec Bamba SurfCare 750 Travel Magic Waves\/ Gris y Rosa","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Cilindro de cer\u00e1mica avanzada<\/h2>Cilindro de cer\u00e1mica avanzada que permite alcanzar la temperatura de forma r\u00e1pida y estable, evitando el sobrecalentamiento. Ideal para crear unos rizos suaves y brillantes respetando el cabello y 