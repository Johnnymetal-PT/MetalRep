"3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHILIPS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.12,"unit_price":13.1,"unit_price_tax":13.1,"tax_rules_group":null,"category":"Electronica","sub_category":"Pilas de consumo","quantity":5,"brand":"PHILIPS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-pila%20r6b4b260%2010_1.jpg"],"wholesale_price":8.1}}},"4895229116627":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4895229116627",false],"wholesale_price":[11.08,false],"price":[16.08,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.14",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:87746","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/209853e30e8c7d4dfbb362a3b66d2fe6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Radio Port\u00e1til Philips TAR1506","category":"Electronica","sub_category":"Radio CD - Radio de bolsillo","unit_price":16.08,"reference":"TAR1506\/00","ean13":"4895229116627","weight":"0.14","quantity":5,"brand":"PHILIPS","description_pt":"                                                <p><h2>Radio port\u00e1til TAR1506<\/h2><b>La cl\u00e1sica radio de bolsillo<\/b><br><ul>  <li>FM\/OM<\/li>  <li>Sintonizaci\u00f3n anal\u00f3gica<\/li>  <li>Funciona con pilas<\/li><\/ul><h2>Dise\u00f1o cl\u00e1sico. F\u00e1cil de sintonizar<\/h2>Esta radio FM\/OM anal\u00f3gica ultraport\u00e1til es f\u00e1cil de sintonizar en el momento. Solo tienes que girar la rueda de sintonizaci\u00f3n lateral para deslizar el indicador a lo largo de la escala. Una amplia ventana de sintonizaci\u00f3n de estilo tradicional te facilitar\u00e1 la visualizaci\u00f3n cuando alcances la frecuencia deseada.<br><br><h2>Controles sencillos. Rueda para ajustar el volumen y para apagar y encender<\/h2>Esta peque\u00f1a radio permite un uso sencillo con una sola mano. El volumen y el encendido y el apagado se controlan mediante una rueda convenientemente situada. Hay un puerto para auriculares para escuchar en privado y un interruptor lateral para seleccionar se\u00f1ales FM u OM.<br><br><h2>Ultraport\u00e1til. Ideal para usar en casa o fuera de ella<\/h2>M\u00e9tete esta radio en el bolsillo y ll\u00e9vate all\u00e1 donde vayas las noticias, el partido que no te puedes perder o ese programa que tanto te gusta. Las 2 pilas AAA le dan fuerza al sonido y la antena telesc\u00f3pica te garantiza siempre la mejor recepci\u00f3n posible.<br><br><h2>Especificaciones t\u00e9cnicas<\/h2><ul>  <li><b>Sintonizador\/recepci\u00f3n\/transmisi\u00f3n<\/b><\/li>  <li>Bandas del sintonizador<\/li>  <li>FM<\/li>  <li>OM<\/li>  <li>RDS<\/li>  <li>No<\/li>  <li><b>Sonido<\/b><\/li>  <li>Potencia de salida (RMS)<\/li>  <li>100 mW<\/li>  <li>Sistema de sonido<\/li>  <li>Mono<\/li>  <li>Control de volumen<\/li>  <li>giratorio (anal\u00f3gico)<\/li>  <li><b>Altavoces<\/b><\/li>  <li>N\u00famero de altavoces de rango completo<\/li>  <li>1<\/li>  <li>Di\u00e1metro del altavoz de rango completo<\/li>  <li>1,5'<\/li>  <li><b>Conectividad<\/b><\/li>  <li>Salida de audio\/v\u00eddeo<\/li>  <li>Auriculares (3,5 mm)<\/li>  <li><b>Potencia<\/b><\/li>  <li>Tipo de bater\u00eda<\/li>  <li>Tama\u00f1o AAA (LR3)<\/li>  <li>Voltaje de la pila<\/li>  <li>1,5\u00a0 V<\/li>  <li>N\u00famero de pilas<\/li>  <li>2<\/li>  <li><b>Accesorios<\/b><\/li>  <li>Accesorios incluidos<\/li>  <li>Gu\u00eda de inicio r\u00e1pido<\/li>  <li>Certificado de garant\u00eda<\/li>  <li><b>Dimensiones del producto<\/b><\/li>  <li>Profundidad<\/li>  <li>2,2\u00a0 cm<\/li>  <li>Altura<\/li>  <li>11,62\u00a0 cm<\/li>  <li>Peso<\/li>  <li>0,09\u00a0 kg<\/li>  <li>Anchura<\/li>  <li>5,6\u00a0 cm<\/li>  <li><b>Contenido de la caja<\/b><\/li>  <li>Otros elementos de la caja<\/li>  <li>Gu\u00eda de inicio r\u00e1pido<\/li>  <li>Certificado de garant\u00eda<\/li><\/ul><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-rad%20tar1506_1.jpg","wholesale_price":"11.08","unit_price_tax":16.08},"product_model":{"product_data":{"ean13":["4895229116627"],"reference":"TAR1506\/00","name":{"1":"Radio Port\u00e1til Philips TAR1506","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Radio port\u00e1til TAR1506<\/h2><b>La cl\u00e1sica radio de bolsillo<\/b><br><ul>  <li>FM\/OM<\/li>  <li>Sintonizaci\u00f3n anal\u00f3gica<\/li>  <li>Funciona con pilas<\/li><\/ul><h2>Dise\u00f1o cl\u00e1sico. F\u00e1cil de sintonizar<\/h2>Esta radio FM\/OM anal\u00f3gica ultraport\u00e1til es f\u00e1cil de sintonizar en el momento. Solo tienes que girar la rueda de sintonizaci\u00f3n lateral para deslizar el indicador a lo largo de la escala. Una amplia ventana de sintonizaci\u00f3n de estilo tradicional te facilitar\u00e1 la visualizaci\u00f3n cuando alcances la frecuencia deseada.<br><br><h2>Controles sencillos. Rueda para ajustar el volumen y para apagar y encender<\/h2>Esta peque\u00f1a radio permite un uso sencillo con una sola mano. El volumen y el encendido y el apagado se controlan mediante una rueda convenientemente situada. Hay un puerto para auriculares para escuchar en privado y un interruptor lateral para seleccionar se\u00f1ales FM u OM.<br><br><h2>Ultraport\u00e1til. Ideal para usar en casa o fuera de ella<\/h2>M\u00e9tete esta radio en el bolsillo y ll\u00e9vate all\u00e1 donde vayas las noticias, el partido que no te puedes perder o ese programa que tanto te gusta. Las 2 pilas AAA le dan fuerza al sonido y la antena telesc\u00f3pica te garantiza siempre la mejor recepci\u00f3n posible.<br><br><h2>Especificaciones t\u00e9cnicas<\/h2><ul>  <li><b>Sintonizador\/recepci\u00f3n\/transmisi\u00f3n<\/b><\/li>  <li>Bandas del sintonizador<\/li>  <li>FM<\/li>  <li>OM<\/li>  <li>RDS<\/li>  <li>No<\/li>  <li><b>Sonido<\/b><\/li>  <li>Potencia de salida (RMS)<\/li>  <li>100 mW<\/li>  <li>Sistema de sonido<\/li>  <li>Mono<\/li>  <li>Control de volumen<\/li>  <li>giratorio (anal\u00f3gico)<\/li>  <li><b>Altavoces<\/b><\/li>  <li>N\u00famero de altavoces de rango completo<\/li>  <li>1<\/li>  <li>Di\u00e1metro del altavoz de rango completo<\/li>  <li>1,5'<\/li>  <li><b>Conectividad<\/b><\/li>  <li>Salida de audio\/v\u00eddeo<\/li>  <li>Auriculares (3,5 mm)<\/li>  <li><b>Potencia<\/b><\/li>  <li>Tipo de bater\u00eda<\/li>  <li>Tama\u00f1o AAA (LR3)<\/li>  <li>Voltaje de la pila<\/li>  <li>1,5\u00a0 V<\/li>  <li>N\u00famero de pilas<\/li>  <li>2<\/li>  <li><b>Accesorios<\/b><\/li>  <li>Accesorios incluidos<\/li>  <li>Gu\u00eda de inicio r\u00e1pido<\/li>  <li>Certificado de garant\u00eda<\/li>  <li><b>Dimensiones del producto<\/b><\/li>  <li>Profundidad<\/li>  <li>2,2\u00a0 cm<\/li>  <li>Altura<\/li>  <li>11,62\u00a0 cm<\/li>  <li>Peso<\/li>  <li>0,09\u00a0 kg<\/li>  <li>Anchura<\/li>  <li>5,6\u00a0 cm<\/li>  <li><b>Contenido de la caja<\/b><\/li>  <li>Otros elementos de la caja<\/li>  <li>Gu\u00eda de inicio r\u00e1pido<\/li>  <li>Certificado de garant\u00eda<\/li><\/ul><br><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHILIPS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.14,"unit_price":16.08,"unit_price_tax":16.08,"tax_rules_group":null,"category":"Electronica","sub_category":"Radio CD - Radio de bolsillo","quantity":5,"brand":"PHILIPS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-rad%20tar1506_1.jpg"],"wholesale_price":11.08}}},"4895229116634":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4895229116634",false],"wholesale_price":[19.1,false],"price":[24.1,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.99",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:87747","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/96e8fbcc9da74f1f7b7120004b8ef0c5.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Radio Port\u00e1til Philips TAR2506\/12","category":"Electronica","sub_category":"Radio CD - Radio de bolsillo","unit_price":24.1,"reference":"TAR2506\/12","ean13":"4895229116634","weight":"0.99","quantity":0,"brand":"PHILIPS","description_pt":"<p><\/p><h2>El compa\u00f1ero cl\u00e1sico<\/h2><p>Disfruta de una experiencia de escucha tradicional en la cocina, el ba\u00f1o o el garaje. Esta cl\u00e1sica radio anal\u00f3gica FM\/OM resulta f\u00e1cil de sintonizar, ofrece un sonido n\u00edtido y cuenta con un magn\u00edfico dise\u00f1o. Y si necesitas salir, dispones de alimentaci\u00f3n mediante CA o bater\u00eda.<\/p><ul><li>FM\/OM<\/li><li>Sintonizaci\u00f3n anal\u00f3gica<\/li><li>Alimentaci\u00f3n por CA o pilas<\/li><\/ul><h2>Dise\u00f1o cl\u00e1sico. F\u00e1cil de sintonizar<\/h2><p>Esta radio FM\/OM anal\u00f3gica encaja en pr\u00e1cticamente cualquier habitaci\u00f3n. Una amplia ventana de sintonizaci\u00f3n de estilo tradicional facilita la visualizaci\u00f3n cuando se alcanza la frecuencia deseada. Solo tienes que girar la rueda de sintonizaci\u00f3n lateral para deslizar el indicador a lo largo de la escala.<\/p><h2>Cambia entre los modos de noticias y m\u00fasica. Control de tono<\/h2><p>S\u00e1cale el m\u00e1ximo partido a tu m\u00fasica con el modo m\u00fasica. Cambia al modo de noticias cuando est\u00e9s escuchando las noticias o tu programa favorito. Sea lo que sea que te guste, el altavoz de 3.5' te garantiza un sonido n\u00edtido.<\/p><h2>Controles sencillos. Control de volumen de gran tama\u00f1o<\/h2><p>Nunca tendr\u00e1s que buscar el control de volumen en esta radio. Adem\u00e1s del gran dial de volumen, la radio dispone de interruptores montados en la parte superior para cambiar entre las se\u00f1ales FM\/OM y los modos de sonido. Tambi\u00e9n encontrar\u00e1s un puerto para auriculares para una escucha privada.<\/p><h2>Col\u00f3calo en cualquier parte<\/h2><p>Podr\u00e1s llevarte esta radio a donde te apetezca. Simplemente enchufa la radio a una toma de pared o inserta dos pilas D y sal de casa. Es la compa\u00f1era perfecta para tomarte una copa de vino en el balc\u00f3n o hacer un p\u00edcnic en el patio trasero.<\/p><div><br><\/div><br><p><\/p><p><p><ul><li><b>Especificaciones t\u00e9cnicas<\/b><\/li><li>Sintonizador\/recepci\u00f3n\/transmisi\u00f3n<\/li><li>Bandas del sintonizador<\/li><ul><li>FM<\/li><li>OM<\/li><\/ul><li>RDS No<\/li><li><b>Sonido<\/b><\/li><li>Potencia de salida (RMS)<\/li><li>300 mW<\/li><li>Sistema de sonido<\/li><li>Mono<\/li><li>Control de volumen<\/li><li>giratorio (anal\u00f3gico)<\/li><li>Mejora del sonido<\/li><li>control de tono<\/li><li><b>Altavoces<\/b><\/li><li>N\u00famero de altavoces de rango completo<\/li><li>1<\/li><li>Di\u00e1metro del altavoz de rango completo<\/li><li>3,5 pulg.<\/li><li><b>Conectividad<\/b><\/li><li>Salida de audio\/v\u00eddeo<\/li><li>Auriculares (3,5 mm)<\/li><li><b>Potencia<\/b><\/li><li>Alimentaci\u00f3n<\/li><ul><li>220-240 V<\/li><li>50\/60 Hz<\/li><\/ul><li>Tipo de bater\u00eda<\/li><li>Tama\u00f1o D (LR20)<\/li><li>Voltaje de la pila<\/li><li>1,5&nbsp; V<\/li><li>N\u00famero de pilas<\/li><li>2<\/li><li><b>Accesorios<\/b><\/li><li>Accesorios incluidos<\/li><ul><li>Cable de alimentaci\u00f3n de CA<\/li><li>Gu\u00eda de inicio r\u00e1pido<\/li><li>Certificado de garant\u00eda<\/li><\/ul><li><b>Dimensiones del producto<\/b><\/li><li>Profundidad<\/li><li>6,63&nbsp; cm<\/li><li>Altura<\/li><li>14,9&nbsp; cm<\/li><li>Peso<\/li><li>0,7&nbsp; kg<\/li><li>Anchura<\/li><li>21&nbsp; cm<\/li><li>Profundidad<\/li><li>9&nbsp; cm<\/li><li>Peso bruto<\/li><li>0,972&nbsp; kg<\/li><li>Altura<\/li><li>19,5&nbsp; cm<\/li><li>Peso neto<\/li><li>0,802&nbsp; kg<\/li><li>Peso tara<\/li><li>0,17&nbsp; kg<\/li><li>Anchura<\/li><li>23,5&nbsp; cm<\/li><li>N\u00famero de productos incluidos<\/li><li>1<\/li><li>Tipo de colocaci\u00f3n<\/li><li>Horizontal<\/li><li><b>Contenido de la caja<\/b><\/li><li>Otros elementos de la caja<\/li><ul><li>Cable de alimentaci\u00f3n de CA<\/li><li>Gu\u00eda de inicio r\u00e1pido<\/li><li>Certificado de garant\u00eda<\/li><\/ul><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-radio%20tar2506%2012_1.jpg","wholesale_price":"19.10","unit_price_tax":24.1},"product_model":{"product_data":{"ean13":["4895229116634"],"reference":"TAR2506\/12","name":{"1":"Radio Port\u00e1til Philips TAR2506\/12","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>El compa\u00f1ero cl\u00e1sico<\/h2><p>Disfruta de una experiencia de escucha tradicional en la cocina, el ba\u00f1o o el garaje. Esta cl\u00e1sica radio anal\u00f3gica FM\/OM resulta f\u00e1cil de sintonizar, ofrece un sonido n\u00edtido y cuenta con un magn\u00edfico dise\u00f1o. Y si necesitas salir, dispones de alimentaci\u00f3n mediante CA o bater\u00eda.<\/p><ul><li>FM\/OM<\/li><li>Sintonizaci\u00f3n anal\u00f3gica<\/li><li>Alimentaci\u00f3n por CA o pilas<\/li><\/ul><h2>Dise\u00f1o cl\u00e1sico. F\u00e1cil de sintonizar<\/h2><p>Esta radio FM\/OM anal\u00f3gica encaja en pr\u00e1cticamente cualquier habitaci\u00f3n. Una amplia ventana de sintonizaci\u00f3n de estilo tradicional facilita la visualizaci\u00f3n cuando se alcanza la frecuencia deseada. Solo tienes que girar la rueda de sintonizaci\u00f3n lateral para deslizar el indicador a lo largo de la escala.<\/p><h2>Cambia entre los modos de noticias y m\u00fasica. Control de tono<\/h2><p>S\u00e1cale el m\u00e1ximo partido a tu m\u00fasica con el modo m\u00fasica. Cambia al modo de noticias cuando est\u00e9s escuchando las noticias o tu programa favorito. Sea lo que sea que te guste, el altavoz de 3.5' te garantiza un sonido n\u00edtido.<\/p><h2>Controles sencillos. Control de volumen de gran tama\u00f1o<\/h2><p>Nunca tendr\u00e1s que buscar el control de volumen en esta radio. Adem\u00e1s del gran dial de volumen, la radio dispone de interruptores montados en la parte superior para cambiar entre las se\u00f1ales FM\/OM y los modos de sonido. Tambi\u00e9n encontrar\u00e1s un puerto para auriculares para una escucha privada.<\/p><h2>Col\u00f3calo en cualquier parte<\/h2><p>Podr\u00e1s llevarte esta radio a donde te apetezca. Simplemente enchufa la radio a una toma de pared o inserta dos pilas D y sal de casa. Es la compa\u00f1era perfecta para tomarte una copa de vino en el balc\u00f3n o hacer un p\u00edcnic en el patio trasero.<\/p><div><br><\/div><br><p><\/p><p><p><ul><li><b>Especificaciones t\u00e9cnicas<\/b><\/li><li>Sintonizador\/recepci\u00f3n\/transmisi\u00f3n<\/li><li>Bandas del sintonizador<\/li><ul><li>FM<\/li><li>OM<\/li><\/ul><li>RDS No<\/li><li><b>Sonido<\/b><\/li><li>Potencia de salida (RMS)<\/li><li>300 mW<\/li><li>Sistema de sonido<\/li><li>Mono<\/li><li>Control de volumen<\/li><li>giratorio (anal\u00f3gico)<\/li><li>Mejora del sonido<\/li><li>control de tono<\/li><li><b>Altavoces<\/b><\/li><li>N\u00famero de altavoces de rango completo<\/li><li>1<\/li><li>Di\u00e1metro del altavoz de rango completo<\/li><li>3,5 pulg.<\/li><li><b>Conectividad<\/b><\/li><li>Salida de audio\/v\u00eddeo<\/li><li>Auriculares (3,5 mm)<\/li><li><b>Potencia<\/b><\/li><li>Alimentaci\u00f3n<\/li><ul><li>220-240 V<\/li><li>50\/60 Hz<\/li><\/ul><li>Tipo de bater\u00eda<\/li><li>Tama\u00f1o D (LR20)<\/li><li>Voltaje de la pila<\/li><li>1,5&nbsp; V<\/li><li>N\u00famero de pilas<\/li><li>2<\/li><li><b>Accesorios<\/b><\/li><li>Accesorios incluidos<\/li><ul><li>Cable de alimentaci\u00f3n de CA<\/li><li>Gu\u00eda de inicio r\u00e1pido<\/li><li>Certificado de garant\u00eda<\/li><\/ul><li><b>Dimensiones del producto<\/b><\/li><li>Profundidad<\/li><li>6,63&nbsp; cm<\/li><li>Altura<\/li><li>14,9&nbsp; cm<\/li><li>Peso<\/li><li>0,7&nbsp; kg<\/li><li>Anchura<\/li><li>21&nbsp; cm<\/li><li>Profundidad<\/li><li>9&nbsp; cm<\/li><li>Peso bruto<\/li><li>0,972&nbsp; kg<\/li><li>Altura<\/li><li>19,5&nbsp; cm<\/li><li>Peso neto<\/li><li>0,802&nbsp; kg<\/li><li>Peso tara<\/li><li>0,17&nbsp; kg<\/li><li>Anchura<\/li><li>23,5&nbsp; cm<\/li><li>N\u00famero de productos incluidos<\/li><li>1<\/li><li>Tipo de colocaci\u00f3n<\/li><li>Horizontal<\/li><li><b>Contenido de la caja<\/b><\/li><li>Otros elementos de la caja<\/li><ul><li>Cable de alimentaci\u00f3n de CA<\/li><li>Gu\u00eda de inicio r\u00e1pido<\/li><li>Certificado de garant\u00eda<\/li><\/ul><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"PHILIPS","supplier":null,"width":null,"height":null,"depth":null,"weight":0.99,"unit_price":24.1,"unit_price_tax":24.1,"tax_rules_group":null,"category":"Electronica","sub_category":"Radio CD - Radio de bolsillo","quantity":0,"brand":"PHILIPS","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phil-radio%20tar2506%2012_1.jpg"],"wholesale_price":19.1}}},"8711500557537":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8711500557537",false],"wholesale_price":[0.77,false],"price":[5.77,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.2",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:87749","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/f99b45ca88caf709f1f4376d344f524d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pila Philips 8LR932\/ 12V\/ Alcalinas","category":"Electronica","sub_category":"Pilas de consumo","unit_price":5.77,"reference":"8LR932","ean13":"8711500557537","weight":"0.2","quantity":5,"brand":"PHILIPS","description_pt":"<p><\/p><h2>Potencia para tus dispositivos de alto consumo<\/h2><p>Tus productos electr\u00f3nicos, como juguetes electr\u00f3nicos y dispositivos de audio port\u00e1tiles, necesitan hoy en d\u00eda m\u00e1s energ\u00eda que nunca. Util\u00edzalos durante m\u00e1s tiempo con las pilas alcalinas.<\/p><p><ul><li>Alcalina<\/li><\/ul><\/p><h2>Rendimiento fiable de larga duraci\u00f3n<\/h2><p>En la fabricaci\u00f3n se utilizan las \u00faltimas tecnolog\u00edas, para garantizar un rendimiento fiable y de larga duraci\u00f3n.<\/p><h2>Ideales para mandos a distancia de coches, sistemas de acceso sin llave<\/h2><p>Ideales para mandos a distancia de coches, sistemas de acceso sin llave, equipos fotogr\u00e1ficos y otros dispositivos electr\u00f3nicos<\/p><h2>La pila conserva sus prestaciones durante 5 a\u00f1os<\/h2><p>Toda pila sufre p\u00e9rdidas de energ\u00eda cuando no se utiliza. Nosotros garantizamos que la pila contiene como m\u00ednimo el 80 % de su energ\u00eda inicial durante la fecha preferente de utilizaci\u00f3n.<\/p><br><p><\/p><div><h2>Especificaciones t\u00e9cnicas<\/h2><p><ul><li>Potencia<\/li><li>Tipo de bater\u00eda<\/li><li>Pila de bot\u00f3n\/alcalina<\/li><li>Voltaje de la pila<\/li><li>12&nbsp; V<\/li><\/ul><\/p><h2>Especificaciones medioambientales<\/h2><p><ul><li>Composici\u00f3n qu\u00edmica<\/li><li>Alcalina<\/li><li>Metales pesados<\/li><li>Sin cadmio<\/li><li>Sin mercurio<\/li><li>Sin plomo<\/li><li>Material de embalaje<\/li><li>Cart\u00f3n<\/li><li>PET<\/li><li>Tipo de embalaje<\/li><li>Bl\u00edster de PET<\/li><\/ul><\/p><h2>Especificaciones t\u00e9cnicas<\/h2><p><ul><li>Intercambiable por<\/li><li>8LR932, MN21, LR23A<\/li><li>Autonom\u00eda<\/li><li>5 a\u00f1os<\/li><\/ul><\/p><br><\/div>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_php-8lr932barder01b_1.jpg","wholesale_price":"0.77","unit_price_tax":5.77},"product_model":{"product_data":{"ean13":["8711500557537"],"reference":"8LR932","name":{"1":"Pila Philips 8LR932\/ 12V\/ Alcalinas","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>Potencia para tus dispositivos de alto consumo<\/h2><p>Tus productos electr\u00f3nicos, como juguetes electr\u00f3nicos y dispositivos de audio port\u00e1tiles, necesitan hoy en d\u00eda m\u00e1s energ\u00eda que nunca. Util\u00edzalos durante m\u00e1s tiempo con las pilas alcalinas.<\/p><p><ul><li>Alcalina<\/li><\/ul><\/p><h2>Rendimiento fiable de larga duraci\u00f3n<\/h2><p>En la fabricaci\u00f3n se utilizan las \u00faltimas tecnolog\u00edas, para garantizar un rendimiento fiable y de larga duraci\u00f3n.<\/p><h2>Ideales para mandos a distancia de coches, sistemas de acceso sin llave<\/h2><p>Ideales para mandos a distancia de coches, sistemas de acceso sin llave, equipos fotogr\u00e1ficos y otros dispositivos electr\u00f3nicos<\/p><h2>La pila conserva sus prestaciones durante 5 a\u00f1os<\/h2><p>Toda pila sufre 