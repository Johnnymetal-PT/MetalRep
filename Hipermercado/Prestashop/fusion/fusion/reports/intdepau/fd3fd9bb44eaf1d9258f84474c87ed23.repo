045496454036",false],"wholesale_price":[284.18,false],"price":[289.18,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 1.53",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:243867","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9bc1bfd0173abed9a757702eb036621b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Nintendo Switch OLED\/ Incluye Base\/ 2 Mandos Joy-Con\/ Incluye Juego Mario Kart Deluxe + 12 Meses de Nintendo Switch Online","category":"Consolas","sub_category":"Nintendo Switch","unit_price":289.18,"reference":"SWITCH OLED MARIO KD","ean13":"0045496454036","weight":"1.53","quantity":5,"brand":"NINTENDO","description_pt":"                                                <p><h2>Con una vibrante pantalla OLED de 7 pulgadas con colores vivos<\/h2><p>Nintendo Switch &#8212; Modelo OLED es la \u00faltima incorporaci\u00f3n a la familia de consolas Nintendo Switch. Incluye una pantalla OLED de 7 pulgadas, un amplio soporte ajustable para el modo sobremesa, una nueva base con un puerto LAN con cable para usar en modo televisor, 64 GB de almacenamiento interno y audio mejorado para jugar en modo port\u00e1til y sobremesa. Al igual que Nintendo Switch, juega en un televisor, comparte los mandos Joy-Con extra\u00edbles para divertirte en modo multijugador o lleva la consola donde quieras para disfrutar de su versatilidad en cualquier lugar.<\/p><h2>Contenido de la caja:<\/h2><p><ul><li>Consola Nintendo Switch &#8212; Modelo OLED* \u00d7 1<\/li><li>* 64 GB de espacio de almacenamiento; parte de \u00e9l est\u00e1 reservado a datos de la consola.<\/li><li>Base de Nintendo Switch (con puerto LAN) \u00d7 1<\/li><li>Mando Joy-Con izquierdo (blanca) \u00d7 1<\/li><li>Mando Joy-Con derecho (blanca) \u00d7 1<\/li><li>Soporte para mandos Joy-Con \u00d7 1<\/li><li>Correa del mando Joy-Con \u00d7 2<\/li><li>Cable HDMI \u00d7 1<\/li><li>Adaptador de corriente de Nintendo Switch \u00d7 1<\/li><\/ul><div><h2>Tres modos de juego<\/h2><p>Nintendo Switch se puede transformar para adaptarse a tu situaci\u00f3n, por lo que puedes jugar a los juegos que quieras, sin importar lo ocupada que est\u00e9 tu vida. Descubre una nueva era en la que ya no necesitas cambiar tu estilo de vida para jugar a tus t\u00edtulos favoritos: \u00a1ahora es la consola la que se adapta a ti!<\/p><h2>Modo televisor<\/h2><p>Ponte delante de la pantalla y juega en compa\u00f1\u00eda. Conecta tu Nintendo Switch en la base para disfrutar de juegos HD en tu televisor.<\/p><h2>Modo sobremesa<\/h2><p>Comparte la pantalla, \u00a1y la diversi\u00f3n! Coloca la pantalla de la consola sobre una superficie y p\u00e1salo en grande con t\u00edtulos multijugador.<\/p><h2>Modo port\u00e1til<\/h2><p>Lleva contigo una pantalla grande y elegante donde quiera que vayas. Ll\u00e9vala y juega con los mandos Joy-Con conectados.<\/p><h2>Nintendo Switch Online<\/h2><p>S\u00e1cale m\u00e1s partido a Nintendo Switch con el servicio de pago Nintendo Switch Online y disfruta del juego en l\u00ednea de manera competitiva y cooperativa con amigos y rivales de todo el mundo en t\u00edtulos de Nintendo Switch compatibles como, por ejemplo, Mario Kart 8 Deluxe y Splatoon 2. \u00danete a trav\u00e9s de la Nintendo eShop y recibe una prueba gratuita de 7 d\u00edas (solo suscripci\u00f3n individual).<\/p><\/div><\/p><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nin-consola%20sw%20o%20wh%20mkd%2012m_1.jpg","wholesale_price":"284.18","unit_price_tax":289.18},"product_model":{"product_data":{"ean13":["0045496454036"],"reference":"SWITCH OLED MARIO KD","name":{"1":"Nintendo Switch OLED\/ Incluye Base\/ 2 Mandos Joy-Con\/ Incluye Juego Mario Kart Deluxe + 12 Meses de Nintendo Switch Online","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Con una vibrante pantalla OLED de 7 pulgadas con colores vivos<\/h2><p>Nintendo Switch &#8212; Modelo OLED es la \u00faltima incorporaci\u00f3n a la familia de consolas Nintendo Switch. Incluye una pantalla OLED de 7 pulgadas, un amplio soporte ajustable para el modo sobremesa, una nueva base con un puerto LAN con cable para usar en modo televisor, 64 GB de almacenamiento interno y audio mejorado para jugar en modo port\u00e1til y sobremesa. Al igual que Nintendo Switch, juega en un televisor, comparte los mandos Joy-Con extra\u00edbles para divertirte en modo multijugador o lleva la consola donde quieras para disfrutar de su versatilidad en cualquier lugar.<\/p><h2>Contenido de la caja:<\/h2><p><ul><li>Consola Nintendo Switch &#8212; Modelo OLED* \u00d7 1<\/li><li>* 64 GB de espacio de almacenamiento; parte de \u00e9l est\u00e1 reservado a datos de la consola.<\/li><li>Base de Nintendo Switch (con puerto LAN) \u00d7 1<\/li><li>Mando Joy-Con izquierdo (blanca) \u00d7 1<\/li><li>Mando Joy-Con derecho (blanca) \u00d7 1<\/li><li>Soporte para mandos Joy-Con \u00d7 1<\/li><li>Correa del mando Joy-Con \u00d7 2<\/li><li>Cable HDMI \u00d7 1<\/li><li>Adaptador de corriente de Nintendo Switch \u00d7 1<\/li><\/ul><div><h2>Tres modos de juego<\/h2><p>Nintendo Switch se puede transformar para adaptarse a tu situaci\u00f3n, por lo que puedes jugar a los juegos que quieras, sin importar lo ocupada que est\u00e9 tu vida. Descubre una nueva era en la que ya no necesitas cambiar tu estilo de vida para jugar a tus t\u00edtulos favoritos: \u00a1ahora es la consola la que se adapta a ti!<\/p><h2>Modo televisor<\/h2><p>Ponte delante de la pantalla y juega en compa\u00f1\u00eda. Conecta tu Nintendo Switch en la base para disfrutar de juegos HD en tu televisor.<\/p><h2>Modo sobremesa<\/h2><p>Comparte la pantalla, \u00a1y la diversi\u00f3n! Coloca la pantalla de la consola sobre una superficie y p\u00e1salo en grande con t\u00edtulos multijugador.<\/p><h2>Modo port\u00e1til<\/h2><p>Lleva contigo una pantalla grande y elegante donde quiera que vayas. Ll\u00e9vala y juega con los mandos Joy-Con conectados.<\/p><h2>Nintendo Switch Online<\/h2><p>S\u00e1cale m\u00e1s partido a Nintendo Switch con el servicio de pago Nintendo Switch Online y disfruta del juego en l\u00ednea de manera competitiva y cooperativa con amigos y rivales de todo el mundo en t\u00edtulos de Nintendo Switch compatibles como, por ejemplo, Mario Kart 8 Deluxe y Splatoon 2. \u00danete a trav\u00e9s de la Nintendo eShop y recibe una prueba gratuita de 7 d\u00edas (solo suscripci\u00f3n individual).<\/p><\/div><\/p><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NINTENDO","supplier":null,"width":null,"height":null,"depth":null,"weight":1.53,"unit_price":289.18,"unit_price_tax":289.18,"tax_rules_group":null,"category":"Consolas","sub_category":"Nintendo Switch","quantity":5,"brand":"NINTENDO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_nin-consola%20sw%20o%20wh%20mkd%2012m_1.jpg"],"wholesale_price":284.18}}},"4904530108075":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4904530108075",false],"wholesale_price":[1.43,false],"price":[6.43,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.01",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"e