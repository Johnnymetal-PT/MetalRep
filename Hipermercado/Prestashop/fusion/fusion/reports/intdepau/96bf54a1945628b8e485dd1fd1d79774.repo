 para uso en interiores<\/li><li>Material de la cubierta:\u00a0 PVC duradero y flexible.<\/li><li>Color de la chaqueta:\u00a0 blanco cl\u00e1sico<\/li><li>Material del conductor:\u00a0 cobre de alta pureza para una claridad de se\u00f1al \u00f3ptima<\/li><li>Tipo de conector:\u00a0 RJ11 (6P4C) est\u00e1ndar de la industria<\/li><li>Caracter\u00edsticas notables:\u00a0 Conectores Trident chapados en oro, dise\u00f1o de cable plano flexible para un f\u00e1cil enrutamiento y una cubierta de PVC robusta para un rendimiento duradero.<\/li><\/ul><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"VENTION","supplier":null,"width":null,"height":null,"depth":null,"weight":0.16,"unit_price":6.59,"unit_price_tax":6.59,"tax_rules_group":null,"category":"Cables de Red","sub_category":"Cables de Red + 10 mt","quantity":0,"brand":"VENTION","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ven-cab%20iqbwl_1.jpg"],"wholesale_price":1.59}}},"5032037280815":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5032037280815",false],"wholesale_price":[234.14,false],"price":[239.14,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:241632","Cat. IDs: 190,99","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ea48af186e134fe79a3e7e59827f7bcd.jpg; <br>-------------------------------"],"result":tr