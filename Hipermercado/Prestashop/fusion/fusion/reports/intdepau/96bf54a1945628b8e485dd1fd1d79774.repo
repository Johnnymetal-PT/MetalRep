pport<\/li><li>Yes<\/li><li>Compatibilidad con DirectX<\/li><li>DirectX 12 Ultimate<\/li><li>Compatibilidad con Vulkan<\/li><li>1.3<\/li><li>Compatibilidad con OpenGL<\/li><li>Up to 4.6<\/li><li>Compatibilidad con OpenCL<\/li><li>3.0<\/li><li>Motores de c\u00f3decs multiformato&nbsp;<\/li><li>2<\/li><li>Compatibilidad con Intel\u00ae Extension for PyTorch* (IPEX)&nbsp;<\/li><li>Yes<\/li><li>Compatibilidad con Intel\u00ae Xe Super Sampling (XeSS)&nbsp;<\/li><li>Yes<\/li><li><strong>Atributos de las tarjetas de referencia Intel\u00ae<\/strong><\/li><li>Dimensiones (largo x ancho)<\/li><li>272 x 115 mm<\/li><li>Ranuras<\/li><li>2<\/li><li>Peso<\/li><li>779 G<\/li><li>Fuente de alimentaci\u00f3n m\u00ednima<\/li><li>600 W<\/li><li>Conectores de alimentaci\u00f3n<\/li><li>1 x 8-pin<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"INTEL","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":239.14,"unit_price_tax":239.14,"tax_rules_group":null,"category":"Componentes","sub_category":"Tarjetas Graficas","quantity":0,"brand":"INTEL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_itl-gf%20arc%20b580%2012g_1.jpg"],"wholesale_price":234.14}}},"8806095575650":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806095575650",false],"wholesale_price":[123.88,false],"price":[128.88,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.07",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:241633","Cat. IDs: 190,98","Associa