arga<\/span><\/li><li><span style='font-weight: normal;'>DisplayPort<\/span><\/li><li><span style='font-weight: normal;'>USB 3.1 Gen 2 (hasta 10 Gb\/s)<\/span><\/li><li>Bater\u00eda y alimentaci\u00f3n<\/li><li><span style='font-weight: normal;'>Modelos Wi&#8209;Fi + Cellular<\/span><\/li><li><span style='font-weight: normal;'>Hasta 9 horas de navegaci\u00f3n por internet a trav\u00e9s de redes m\u00f3viles<\/span><\/li><li>Sistema operativo<\/li><li><span style='font-weight: normal;'>iPadOS 15<\/span><\/li><li><span style='font-weight: normal;'>iPadOS est\u00e1 repleto de prestaciones y apps integradas dise\u00f1adas para aprovechar toda la potencia del iPad.<\/span><\/li><\/ul><\/h2><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"APPLE","supplier":null,"width":null,"height":null,"depth":null,"weight":0.88,"unit_price":746.89,"unit_price_tax":746.89,"tax_rules_group":null,"category":"iPad","sub_category":"iPad Air","quantity":2,"brand":"APPLE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_apl-ipad%20mm6u3tybardera_1.jpg"],"wholesale_price":741.89}}},"5051893242621":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5051893242621",false],"wholesale_price":[41.77,false],"price":[46.77,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.11",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:133808","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5cc1bcaf98892a539e9ec12d625b8d5d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Juego para Consola Sony PS4 Hogwarts Legacy Standard","category":"Juegos y Accesorios","sub_category":"Juegos PS4","unit_price":46.77,"reference":"HOGWARTS LEG STD PS4","ean13":"5051893242621","weight":"0.11","quantity":5,"brand":"SONY","description_pt":"<p><h2>Hogwarts Legacy Standard PlayStation 4<\/h2>Hogwarts Legacy es un inmersivo juego RPG de acci\u00f3n y mundo abierto ambientado en el universo descrito por primera vez en los libros de Harry Potter. Emb\u00e1rcate en un viaje que te llevar\u00e1 a lugares nuevos y ya conocidos, y en el que podr\u00e1s descubrir animales fant\u00e1sticos, personalizar a tu personaje, elaborar pociones, dominar hechizos, mejorar tus habilidades y convertirte en la bruja o el mago que quieras ser. Disfruta de Hogwarts en el siglo XIX. Tu personaje es un estudiante que tiene la clave de un antiguo secreto que amenaza la estabilidad del mundo m\u00e1gico. Descubre la experiencia de vivir en Hogwarts, conseguir aliados, enfrentarte a magos tenebrosos y decidir el destino del mundo m\u00e1gico. T\u00fa defines tu legado. Escribe tu propia historia.<br><br><ul><li>Editor \/ Editora:Warner Bros Games<\/li><li>Compatibilidad 3D: No<\/li><li>Pegi: 16+<\/li><li>Plataforma: Playstation 4<\/li><li>Idioma voces del juego: Castellano<\/li><li>Idioma subt\u00edtulos del juego: Castellano<\/li><li>Desarrolladores: Avalanche Studios<\/li><li>G\u00e9nero: RPG<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_sony-ps4-j%20hogwarts%20leg%20std_1.jpg","wholesale_price":"41.77","unit_price_tax":46.77},"product_model":{"product_data":{"ean13":["5051893242621"],"reference":"HOGWARTS LEG STD PS4","name":{"1":"Juego para Consola Sony PS4 Hogwarts Legacy Standard","2":"","3":"","4":""},"description":{"1":"<p><h2>Hogwarts Legacy Standard PlayStation 4<\/h2>Hogwar