rticulos\/800\/800\/fixed\/art_jbl-aur%20quantum%20400%20bk_1.jpg"],"wholesale_price":69}}},"8435693102946":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693102946",false],"wholesale_price":[59.83,false],"price":[64.83,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 7.95",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:133950","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/94737e3f96a91e2df9cd1724d6d4214e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Caja Gaming Torre Mars Gaming MCV4\/ Blanca","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","unit_price":64.83,"reference":"MCV4W","ean13":"8435693102946","weight":"7.95","quantity":0,"brand":"MARS GAMING","description_pt":"                                                                                                <p><\/p><h2>TORRE GAMING CUSTOM PREMIUM XXL MCV4<\/h2>Cristal templado continuo sin marco, tama\u00f1o XXL E-ATX para las configuraciones m\u00e1s exclusivas. Con soporte hasta 10 ventiladores y refrigeraciones l\u00edquidas triples en varias posiciones.<br><h2>Cristal templado continuo sin marco. XXL E-ATX<\/h2><ul>  <li>Cristal templado continuo sin marco<\/li>  <li>Capacidad ampliada XXL E-ATX<\/li>  <li>Soporte total refrigeraciones l\u00edquidas<\/li>  <li>Estructura modular de doble c\u00e1mara<\/li><\/ul><h2>EDICI\u00d3N CUSTOM<\/h2><p>La MCV4 es una caja de concepto custom para que dispongas de la base perfecta y construyas as\u00ed el PC de tus sue\u00f1os sin ninguna limitaci\u00f3n de serie y sin tener que malgastar partes que no vayas a utilizar. Es por ello por lo que la MCV4 no incluye de serie (ni pagas por ello) extras personalizables como los ventiladores o el soporte\/cable vertical para tarjetas gr\u00e1ficas.<\/p><h2>CRISTAL TEMPLADO CONTINUO SIN MARCO<\/h2><p>Disfruta como nunca de un impresionante espect\u00e1culo gracias a sus ventanas de cristal templado continuo sin marco. Muestra tu hardware en su m\u00e1ximo esplendor sin marcos que interfieran la visi\u00f3n.<\/p><h2>ESTRUCTURA MODULAR DE DOBLE C\u00c1MARA<\/h2><p>Gracias a su estructura de doble c\u00e1mara, separa la fuente de alimentaci\u00f3n y los discos duros en una c\u00e1mara lateral oculta para una m\u00e1xima refrigeraci\u00f3n y optimizaci\u00f3n del espacio.<\/p><h2>CAPACIDAD AMPLIADA XXL<\/h2><p>Nuevo tama\u00f1o ampliado al m\u00e1ximo y capacidad hasta E-ATX. La MCV4 tiene capacidad de sobra para el PC de tus sue\u00f1os. Instala hasta 10 ventiladores y 5 discos duros, gr\u00e1ficas de 400mm en horizontal o vertical*, refrigeradores de aire XXL y radiadores de 360mm. La caja no ser\u00e1 nunca m\u00e1s una limitaci\u00f3n. *Adaptador para montaje de tarjeta gr\u00e1fica en vertical no incluido.<\/p><h2>SOPORTE TOTAL PARA REFRIGERACIONES L\u00cdQUIDAS<\/h2><p>Instala el kit de refrigeraci\u00f3n l\u00edquida del tama\u00f1o que quieras o crea el sistema custom de tus sue\u00f1os. La MCV4 tiene el espacio y dise\u00f1o que necesitas para hacer tu proyecto realidad.<\/p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><ul>  <li><b>Dimensiones<\/b><\/li>  <li>400x289x440mm<\/li>  <li><b>Peso<\/b><\/li>  <li>6.5Kg<\/li>  <li><b>Tama\u00f1o<\/b><\/li>  <li>Torre<\/li>  <li><b>Ventana<\/b><\/li>  <li>Ventana lateral y frontal completa de cristal templado<\/li>  <li><b>Extras<\/b><\/li>  <li>Sistema de gesti\u00f3n de cableado interno<\/li>  <li>Compatibilidad con placas base<\/li>  <li>E-ATX \/ ATX \/ MicroATX \/ Mini-ITX<\/li>  <li>Filtros antipolvo<\/li>  <li>1x filtro superior magn\u00e9tico + 1x filtro inferior magn\u00e9tico<\/li>  <li><b>Puertos<\/b><\/li>  <li>USB3.0 x1 \/ USB2.0 x2 \/ HD Audio + Mic<\/li>  <li>Tipo de fuente<\/li>  <li>ATX<\/li>  <li><b>Bah\u00edas internas<\/b><\/li>  <li>2x 3.5' HDD \/ 3x 2.5' SSD<\/li>  <li>Longitud VGA m\u00e1x.<\/li>  <li>418mm<\/li>  <li>Anchura VGA m\u00e1x.<\/li>  <li>157mm<\/li>  <li>Altura disipador m\u00e1x.<\/li>  <li>162mm<\/li>  <li>Slots de expansi\u00f3n<\/li>  <li>7<\/li>  <li><b>Soporte refrigeraci\u00f3n l\u00edquida<\/b><\/li>  <li>360mm, 280mm, 240mm, 140mm, 120mm superior \/ 360mm, 240mm, 120mm inferior \/ 280mm, 240mm, 140mm, 120mm interior \/ 120mm trasero<\/li>  <li><b>Capacidad de ventiladores<\/b><\/li>  <li>Hasta 10x 120mm o 4x 140mm<\/li>  <li>Medidas internas<\/li>  <li>Ancho-27 Alto-37.5 (suelo a techo) Largo 42cm<\/li>  <li><b>CONTENIDO DE LA CAJA<\/b><\/li>  <li>Set torniller\u00eda<\/li><\/ul><br><p><\/p>                                                                                        ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20mcv4%20wh_1.jpg","wholesale_price":"59.83","unit_price_tax":64.83},"product_model":{"product_data":{"ean13":["8435693102946"],"reference":"MCV4W","name":{"1":"Caja Gaming Torre Mars Gaming MCV4\/ Blanca","2":"","3":"","4":""},"description":{"1":"                                                                                                <p><\/p><h2>TORRE GAMING CUSTOM PREMIUM XXL MCV4<\/h2>Cristal templado continuo sin marco, tama\u00f1o XXL E-ATX para las configuraciones m\u00e1s exclusivas. Con soporte hasta 10 ventiladores y refrigeraciones l\u00edquidas triples en varias posiciones.<br><h2>Cristal templado continuo sin marco. XXL E-ATX<\/h2><ul>  <li>Cristal templado continuo sin marco<\/li>  <li>Capacidad ampliada XXL E-ATX<\/li>  <li>Soporte total refrigeraciones l\u00edquidas<\/li>  <li>Estructura modular de doble c\u00e1mara<\/li><\/ul><h2>EDICI\u00d3N CUSTOM<\/h2><p>La MCV4 es una caja de concepto custom para que dispongas de la base perfecta y construyas as\u00ed el PC de tus sue\u00f1os sin ninguna limitaci\u00f3n de serie y sin tener que malgastar partes que no vayas a utilizar. Es por ello por lo que la MCV4 no incluye de serie (ni pagas por ello) extras personalizables como los ventiladores o el soporte\/cable vertical para tarjetas gr\u00e1ficas.<\/p><h2>CRISTAL TEMPLADO CONTINUO SIN MARCO<\/h2><p>Disfruta como nunca de un impresionante espect\u00e1culo gracias a sus ventanas de cristal templado continuo sin marco. Muestra tu hardware en su m\u00e1ximo esplendor sin marcos que interfieran la visi\u00f3n.<\/p><h2>ESTRUCTURA MODULAR DE DOBLE C\u00c1MARA<\/h2><p>Gracias a su estructura de doble c\u00e1mara, separa la fuente de alimentaci\u00f3n y los discos duros en una c\u00e1mara lateral oculta para una m\u00e1xima refrigeraci\u00f3n y optimizaci\u00f3n del espacio.<\/p><h2>CAPACIDAD AMPLIADA XXL<\/h2><p>Nuevo tama\u00f1o ampliado al m\u00e1ximo y capacidad hasta E-ATX. La MCV4 tiene capacidad de sobra para el PC de tus sue\u00f1os. Instala hasta 10 ventiladores y 5 discos duros, gr\u00e1ficas de 400mm en horizontal o vertical*, refrigeradores de aire XXL y radiadores de 360mm. La caja no ser\u00e1 nunca m\u00e1s una limitaci\u00f3n. *Adaptador para montaje de tarjeta gr\u00e1fica en vertical no incluido.<\/p><h2>SOPORTE TOTAL PARA REFRIGERACIONES L\u00cdQUIDAS<\/h2><p>Instala el kit de refrigeraci\u00f3n l\u00edquida del tama\u00f1o que quieras o crea el sistema custom de tus sue\u00f1os. La MCV4 tiene el espacio y dise\u00f1o que necesitas para hacer tu proyecto realidad.<\/p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><ul>  <li><b>Dimensiones<\/b><\/li>  <li>400x289x440mm<\/li>  <li><b>Peso<\/b><\/li>  <li>6.5Kg<\/li>  <li><b>Tama\u00f1o<\/b><\/li>  <li>Torre<\/li>  <li><b>Ventana<\/b><\/li>  <li>Ventana lateral y frontal completa de cristal templado<\/li>  <li><b>Extras<\/b><\/li>  <li>Sistema de gesti\u00f3n de cableado interno<\/li>  <li>Compatibilidad con placas base<\/li>  <li>E-ATX \/ ATX \/ MicroATX \/ Mini-ITX<\/li>  <li>Filtros antipolvo<\/li>  <li>1x filtro superior magn\u00e9tico + 1x filtro inferior magn\u00e9tico<\/li>  <li><b>Puertos<\/b><\/li>  <li>USB3.0 x1 \/ USB2.0 x2 \/ HD Audio + Mic<\/li>  <li>Tipo de fuente<\/li>  <li>ATX<\/li>  <li><b>Bah\u00edas internas<\/b><\/li>  <li>2x 3.5' HDD \/ 3x 2.5' SSD<\/li>  <li>Longitud VGA m\u00e1x.<\/li>  <li>418mm<\/li>  <li>Anchura VGA m\u00e1x.<\/li>  <li>157mm<\/li>  <li>Altura disipador m\u00e1x.<\/li>  <li>162mm<\/li>  <li>Slots de expansi\u00f3n<\/li>  <li>7<\/li>  <li><b>Soporte refrigeraci\u00f3n l\u00edquida<\/b><\/li>  <li>360mm, 280mm, 240mm, 140mm, 120mm superior \/ 360mm, 240mm, 120mm inferior \/ 280mm, 240mm, 140mm, 120mm interior \/ 120mm trasero<\/li>  <li><b>Capacidad de ventiladores<\/b><\/li>  <li>Hasta 10x 120mm o 4x 140mm<\/li>  <li>Medidas internas<\/li>  <li>Ancho-27 Alto-37.5 (suelo a techo) Largo 42cm<\/li>  <li><b>CONTENIDO DE LA CAJA<\/b><\/li>  <li>Set torniller\u00eda<\/li><\/ul><br><p><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":7.95,"unit_price":64.83,"unit_price_tax":64.83,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","quantity":0,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20mcv4%20wh_1.jpg"],"wholesale_price":59.83}}},"8435693102243":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693102243",false],"wholesale_price":[21.84,false],"price":[26.84,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.34",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:133951","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b71c297ea0eb7f139267e4ceaf5051ca.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Gamepad Mars Gaming MGP-BT Inal\u00e1mbrico","category":"Perif\u00e9ricos Gaming","sub_category":"Joysticks - Pads - Volantes","unit_price":26.84,"reference":"MGPBT","ean13":"8435693102243","weight":"0.34","quantity":5,"brand":"MARS GAMING","description_pt":"                                                <p><h2>GAMEPAD INAL\u00c1MBRICO MGP-BT<\/h2><p>Gamepad inal\u00e1mbrico con conexi\u00f3n dual Bluetooth 5.0 y USB. Sistema girosc\u00f3pico avanzado y vibraci\u00f3n h\u00e1ptica dual. Espectacular dise\u00f1o transl\u00facido negro con iluminaci\u00f3n NE\u00d3N RGB. App de control Android\/IOS. Adaptador para smartphone y compatibilidad multiplataforma<\/p><p><ul><li>Dual bluetooth 5.0 + USB<\/li><li>Gir\u00f3scopo y vibraci\u00f3n h\u00e1ptica<\/li><li>App de control android\/ios<\/li><li>Adaptador para smartphone<\/li><\/ul><\/p><h2>CONEXI\u00d3N DUAL BLUETOOTH 5.0 + USB<\/h2><p>Disfruta de la libertad del juego inal\u00e1mbrico gracias a su conexi\u00f3n Bluetooth 5.0 y su bater\u00eda de gran capacidad con hasta 10 horas de uso o con\u00e9ctalo con el cable USB-C extra\u00edble incluido para eliminar la latencia, aumentar la compatibilidad y disfrutar sin l\u00edmites.<\/p><h2>DISE\u00d1O TRANSL\u00daCIDO NE\u00d3N RGB<\/h2><p>Admira la belleza electr\u00f3nica y mec\u00e1nica del MGP-BT a trav\u00e9s de su acabado negro transl\u00facido y deslumbra con su espectacular sistema de iluminaci\u00f3n multimodo RGB por fibra \u00f3ptica.<\/p><h2>ADAPTADOR DE SMARTPHONE<\/h2><p>Convierte tu MGP-BT en una consola port\u00e1til de \u00faltima generaci\u00f3n incorporando tu smartphone gracias a su adaptador incluido.<\/p><h2>M\u00c1XIMAS PRESTACIONES<\/h2><p>Modos X-input y Direct-input para compatibilidad total, funci\u00f3n turbo configurable, 20 botones t\u00e1ctiles, joysticks anal\u00f3gicos y pad direccional de alta precisi\u00f3n. Adem\u00e1s, cuenta con bot\u00f3n wakeup para Switch.<\/p><h2>APP DE CONTROL IOS\/ANDROID<\/h2><p>Control total de personalizaci\u00f3n de tu MGP-BT gracias a su APP de control en Android e IOS. Remapea los botones, ajusta a la perfecci\u00f3n la sensibilidad de los joysticks, selecciona las caracter\u00edsticas del sistema dual de vibraci\u00f3n h\u00e1ptica, ajusta el tiempo de apagado autom\u00e1tico y realiza tests operativos de los joysticks y botones. Todo bajo tu control.<\/p><h2>GIR\u00d3SCOPO AVANZADO Y VIBRACI\u00d3N H\u00c1PTICA DUAL<\/h2><p>Lleva tu experiencia gaming al m\u00e1ximo gracias al avanzado gir\u00f3scopo de 6 ejes y su sistema motion control (switch) para aumentar la precisi\u00f3n y estabilidad de los movimientos. Adem\u00e1s, el MGP-BT cuenta con un potente sistema vibraci\u00f3n h\u00e1ptica customizable por software para dotar de un realismo extremo a tus gameplays.<\/p><h2>DISE\u00d1O ERGON\u00d3MICO<\/h2><p>Confort asegurado gracias a su dise\u00f1o ergon\u00f3mico con formas redondeadas y joysticks en posici\u00f3n asim\u00e9trica.<\/p><h2>COMPATIBILIDAD MULTIPLATAFORMA<\/h2><p>Compatible con Switch, PC, Mac, Android, iOS 13.0 o superior, Raspberry Pi y PS3 (cable).<\/p><br><\/p><p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><p><ul><li><b>Dimensiones<\/b><\/li><li>152x115x58mm<\/li><li><b>Peso<\/b><\/li><li>215g<\/li><li><b>Iluminaci\u00f3n<\/b><\/li><li>RGB Neon<\/li><li><b>Botones<\/b><\/li><li>20<\/li><li><b>Bater\u00eda<\/b><\/li><li>Recargable Ion-Litio<\/li><li><b>Compatibilidad<\/b><\/li><li>Switch, PC, Mac, Android, iOS 13.0 o superior, Raspberry Pi, PS3 (cable)<\/li><li><b>Cable<\/b><\/li><li>1 metros extra\u00edble USB-A \/ USB-C<\/li><li><b>PC input<\/b><\/li><li>X-input & D-input<\/li><li><b>Vibraci\u00f3n<\/b><\/li><li>Dual personalizable<\/li><li><b>Giroscopio<\/b><\/li><li>Giroscopio 6 ejes (Switch)<\/li><li><b>Tiempo de carga<\/b><\/li><li>3 horas<\/li><li><b>Autonom\u00eda<\/b><\/li><li>10 horas<\/li><li><b>Conectividad<\/b><\/li><li>Bluetooth 5.0 + cable USB<\/li><li><b>Distancia (Inal\u00e1mbrico)<\/b><\/li><li>10m<\/li><li><b>Funci\u00f3n standby<\/b><\/li><li>S\u00ed<\/li><li><b>Conector mando<\/b><\/li><li>USB-C<\/li><li><b>Aplicaci\u00f3n m\u00f3vil<\/b><\/li><li>Keylinker APP Android & iOS<\/li><\/ul><\/p><h2>CONTENIDO DE LA CAJA<\/h2><p><ul><li>Cable USB-A \/ USB-C, manual, soporte smartphone y mando<\/li><\/ul><\/p><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-gamepad%20mgp-bt_1.jpg","wholesale_price":"21.84","unit_price_tax":26.84},"product_model":{"product_data":{"ean13":["8435693102243"],"reference":"MGPBT","name":{"1":"Gamepad Mars Gaming MGP-BT Inal\u00e1mbrico","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>GAMEPAD INAL\u00c1MBRICO MGP-BT<\/h2><p>Gamepad inal\u00e1mbrico con conexi\u00f3n dual Bluetooth 5.0 y USB. Sistema girosc\u00f3pico avanzado y vibraci\u00f3n h\u00e1ptica dual. Espectacular dise\u00f1o transl\u00facido negro con iluminaci\u00f3n NE\u00d3N RGB. App de control Android\/IOS. Adaptador para smartphone y compatibilidad multiplataforma<\/p><p><ul><li>Dual bluetooth 5.0 + USB<\/li><li>Gir\u00f3scopo y vibraci\u00f3n h\u00e1ptica<\/li><li>App de control android\/ios<\/li><li>Adaptador para smartphone<\/li><\/ul><\/p><h2>CONEXI\u00d3N DUAL BLUETOOTH 5.0 + USB<\/h2><p>Disfruta de la libertad del juego inal\u00e1mbrico gracias a su conexi\u00f3n Bluetooth 5.0 y su bater\u00eda de gran capacidad con hasta 10 horas de uso o con\u00e9ctalo con el cable 