jo de aire de 250\/500 min1<\/li>  <li>Peso 0,8 kg<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-decap%20ehg2020lcd_1.jpg","wholesale_price":"67.56","unit_price_tax":72.56},"product_model":{"product_data":{"ean13":["4892210120397"],"reference":"5133001730","name":{"1":"Decapador Ryobi EHG2020LCD\/ 2000W\/ Incluye 1 Rascador y 4 Boquillas","2":"","3":"","4":""},"description":{"1":"                                                <p>Decapador vers\u00e1til sirve para quitar o secar las pinturas y esmaltes. Elige la temperatura seg\u00fan aplicaci\u00f3n. Indicador de temperatura en LCD display. Protector frontal extraible para un cambio r\u00e1pido de accesorios. 2 posiciones de caudal de aire. Sensor de protecci\u00f3n contra el sobrecalentamiento. Gancho para colgar. Incluye 4 x boquillas, 1 x rascador.<br><br><ul>  <li><b>Especificaciones<\/b><\/li>  <li>Potencia 2000 watts<\/li>  <li>Los ajustes de temperatura 50-650 \u00b0<\/li>  <li>El flujo de aire de 250\/500 min1<\/li>  <li>Peso 0,8 kg<\/li><\/ul><\/p>                                            ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"RYOBI","supplier":null,"width":null,"height":null,"depth":null,"weight":0,"unit_price":72.56,"unit_price_tax":72.56,"tax_rules_group":null,"category":"Bricolaje","sub_category":"Herramientas de Bricolaje","quantity":0,"brand":"RYOBI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ryo-decap%20ehg2020lcd_1.jpg"],"wholesale_price":67.56}}},"4892210176196":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4892210176196",false],"wholesale_price":[88.46,false],"price":[93.46,false],"id_tax_rules