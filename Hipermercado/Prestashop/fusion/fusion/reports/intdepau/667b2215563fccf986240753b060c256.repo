imentaci\u00f3n1 kit de fuente de alimentaci\u00f3n HPE Titanium hot-plug con ranura flexible y bajo contenido en hal\u00f3genos de 800 W<\/li>  <li>Ranuras de expansi\u00f3n 2 m\u00e1ximo; para obtener una descripci\u00f3n detallada, consulta las especificaciones r\u00e1pidas<\/li>  <li>Controlador de red Adaptador de red integrado HPE 1 GB 4 puertos BCM5719<\/li>  <li>Controlador de almacenamiento RAID de software Intel VROC SATA integrado<\/li>  <li>Caracter\u00edsticas de los ventiladores del sistemaTres (3) ventiladores no redundantes de alto rendimiento con conexi\u00f3n hot-plug<\/li><\/ul><\/p>                                                                                        ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HEWLETT PACKARD ENTERPRISE","supplier":null,"width":null,"height":null,"depth":null,"weight":12.9,"unit_price":1549.4,"unit_price_tax":1549.4,"tax_rules_group":null,"category":"Servidores","sub_category":"Servidores","quantity":2,"brand":"HEWLETT PACKARD ENTERPRISE","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hps-p65396-421_1.jpg"],"wholesale_price":1542.4}}},"4549821626670":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4549821626670",false],"wholesale_price":[1879.14,false],"price":[1886.14,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 14.75",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:257344","Cat. IDs: 187","Associated Categories","Cat. Default: 187","Deleted old images","New images created","Ad