k_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRUST GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0.32,"unit_price":21.76,"unit_price_tax":21.76,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Kits Completos","quantity":2,"brand":"TRUST GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-pack%20gxt%20112%20felox%20bk_1.jpg"],"wholesale_price":14.76}}},"8713439251173":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8713439251173",false],"wholesale_price":[22.47,false],"price":[29.47,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.7",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:257279","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/6505c2d567e1ec2c732f29ba6006fa34.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Pack Gaming Trust Gaming GXT 790\/ Rat\u00f3n \u00d3ptico + Auriculares + Alfombrilla","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Kits Completos","unit_price":29.47,"reference":"25117","ean13":"8713439251173","weight":"0.7","quantity":2,"brand":"TRUST GAMING","description_pt":"<p><h2>GXT 790 Paquete gaming 3 en 1<\/h2><p>Paquete gaming 3 en 1 con auriculares ligeros, rat\u00f3n con iluminaci\u00f3n y alfombrilla<\/p><h2>Triple encanto<\/h2><p>Se suele decir que las cosas buenas vienen de tres en tres, y Tridox lo confirma. Todo lo que necesitas para un set-up de gaming b\u00e1sico: un juego de auriculares ligero, un rat\u00f3n iluminado y una alfombrilla para rat\u00f3n. \u00a1Ya lo tienes todo!<\/p><h2>As\u00ed suena el \u00e9xito<\/h2><p>Celebra tus victorias con total comodidad y el mejor sonido con el juego de auriculares Zirox. Las potentes unidades de altavoz de 50 mm te transportan directamente al centro de la acci\u00f3n, mientras que su c\u00f3modo dise\u00f1o ligero de tan solo 244 gramos es tan ligero que apenas notar\u00e1s que lo llevas puesto.<\/p><h2>M\u00e1s claro, agua<\/h2><p>Ahora lo ves, ahora no lo ves. El micr\u00f3fono plegable hacia arriba del juego de auriculares Zirox se puede guardar f\u00e1cilmente, mientras que el control de volumen supraaural y la funci\u00f3n de silenciamiento del micr\u00f3fono te permiten o\u00edr y decir exactamente lo que quieres.<\/p><h2>El alma de la fiesta<\/h2><p>S\u00e9 el centro de atenci\u00f3n gracias a las 3 configuraciones distintas de LED multicolor del rat\u00f3n Felox. Tienes muchas opciones para hacer que el set-up de gaming tenga personalidad propia. \u00bfAcaso se puede tener m\u00e1s estilo?<\/p><h2>Especificaciones<\/h2><p><ul><li><b>Contenido del paquete<\/b><\/li><li>Auriculares gaming<\/li><li>Rat\u00f3n gaming<\/li><li>Alfombrilla para rat\u00f3n<\/li><li><b>Requisitos del sistema<\/b><\/li><li>Conexi\u00f3n de audio o micr\u00f3fono de 3,5 mm<\/li><li>Puerto USB<\/li><li>Windows 10 u 11<\/li><\/ul><\/p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tru-pack%20gxt%20790%20bk_1.jpg","wholesale_price":"22.47","unit_price_tax":29.47},"product_model":{"product_data":{"ean13":["8713439251173"],"reference":"25117","name":{"1":"Pack Gaming Trust Gaming GXT 790\/ Rat\u00f3n \u00d3ptico + Auriculares + Alfombrilla","2":"","3":"","4":""},"description":{"1":"<p><h2>GXT 790 Paquete gaming 3 en 1<\/h2><p>Paquete gaming 3 en 1 con auriculares ligeros, rat\u00f3n con iluminaci\u00f3n y alfombrilla<\/p><h2>Triple encanto<\/h2><p>Se suele decir que las cosas buenas vienen de tres en tres, y Tridox lo confirma. Todo lo que necesitas para un set-up de gaming b\u00e1sico: un juego de auriculares ligero, un rat\u00f3n iluminado y una alfombrilla para rat\u00f3n. \u00a1Ya lo tienes todo!<\/p><h2>As\u00ed suena el \u00e9xito<\/h2><p>Celebra tus victorias con total comodidad y el mejor sonido con el juego de auriculares Zirox. Las potentes unidades de altavoz de 50 mm te transportan directamente al centro de la acci\u00f3n, mientras que su c\u00f3modo dise\u00f1o ligero de tan solo 244 gramos es tan ligero que apenas notar\u00e1s que lo llevas puesto.<\/p><h2>M\u00e1s claro, agua<\/h2><p>Ahora lo ves, ahora no lo ves. El micr\u00f3fono plegable hacia arriba del juego de auriculares Zirox se puede guardar f\u00e1cilmente, mientras que el control de volumen supraaural y la funci\u00f3n de silenciamiento del micr\u00f3fono te permiten o\u00edr y decir exactamente lo que quieres.<\/p><h2>El alma de la fiesta<\/h2><p>S\u00e9 el centro de atenci\u00f3n gracias a las 3 configuraciones distintas de LED multicolor del rat\u00f3n Felox. Tienes muchas opciones para hacer que el set-up de gaming tenga personalidad propia. \u00bfAcaso se puede tener m\u00e1s estilo?<\/p><h2>Especificaciones<\/h2><p><ul><li><b>Contenido del paquete<\/b><\/li><li>Auriculares gaming<\/li><li>Rat\u00f3n gaming<\/li><li>Alfombrilla para rat\u00f3n<\/li><li><b>Requisitos del sistema<\/b><\/li><li>Conexi\u00f3n de audio o micr\u00f3fono de 3,5 mm<\/li><li>Puerto USB<\/li><li>Windows 10 u 11<\/li><\/ul><\/p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TRUST GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0.7,"unit_price":29.47,"unit_price_tax":29.47,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Kits Completos","quantity":2,"brand":"TRUST GAMING","images":["https:\/\/cdn2.depau.es\/arti