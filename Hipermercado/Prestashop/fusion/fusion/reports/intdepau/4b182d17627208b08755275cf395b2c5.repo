er":null,"width":null,"height":null,"depth":null,"weight":0.14,"unit_price":102.9,"unit_price_tax":102.9,"tax_rules_group":null,"category":"Material Electrico","sub_category":"Interruptores Magnetotermicos","quantity":0,"brand":"SALICRU","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_slc-medidor%20esm1%20eqx_1.jpg"],"wholesale_price":97.9}}},"8435253529602":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435253529602",false],"wholesale_price":[11.42,false],"price":[16.42,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.23",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90798","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/eb8656a326867bf611993ef14c6c5912.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Ahorrador de Energ\u00eda Jocca 2256","category":"Material Electrico","sub_category":"Programadores de Enchufe","unit_price":16.42,"reference":"2256 JOC","ean13":"8435253529602","weight":"0.23","quantity":2,"brand":"JOCCA","description_pt":"<p><p>Dispositivo que&nbsp;filtra y estabiliza la corriente el\u00e9ctrica, ofrece protecci\u00f3n a sus electrodom\u00e9sticos y proporciona un ahorro de energ\u00eda eficiente.<\/p><p>Ese producto proporciona&nbsp;una protecci\u00f3n segura para sus electrodom\u00e9sticos, prolongando su vida \u00fatil. Ahorrador de energ\u00eda con una alt\u00edsima eficiencia dise\u00f1ado, especialmente, para cubrir las necesidades de su hogar.<\/p><p>Se trata de un novedoso dispositivo que filtra y estabiliza la energ\u00eda el\u00e9ctrica, mejorando su eficiencia y elevando el factor de potencia el\u00e9ctrica utilizando la tecnolog\u00eda m\u00e1s puntera en el campo de la eficiencia energ\u00e9tica.<br><br><b>\u00bfC\u00f3mo funciona?<\/b><\/p><p>Regula el sistema el\u00e9ctrico de su hogar. Esta regulaci\u00f3n reduce el calor por resistencia, disminuyendo el amperaje, mejorando la eficiencia el\u00e9ctrica y obteniendo una reducci\u00f3n en el consumo de energ\u00eda. Esto provoca un menor desperdicio de energ\u00eda a la vez que protege los componentes el\u00e9ctricos de los electrodom\u00e9sticos de su hogar.<\/p><p><b>\u00bfQuieres pagar menos en tus facturas de la luz?&nbsp;<\/b><\/p><ul><li>Este dispositivo, testado y certificado tambi\u00e9n proteger\u00e1 tus aparatos de las subidas de tensi\u00f3n y sobrecargas de la red<\/li><li>Voltaje: 100-240V<\/li><li>Frecuencia: 50\/60 Hz<\/li><\/ul><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_joc-pae-ahorrador%202256_1.jpg","wholesale_price":"11.42","unit_price_tax":16.42},"product_model":{"product_data":{"ean13":["8435253529602"],"reference":"2256 JOC","name":{"1":"Ahorrador de Energ\u00eda Jocca 2256","2":"","3":"","4":""},"description":{"1":"<p><p>Dispositivo que&nbsp;filtra y estabiliza la corriente el\u00e9ctrica, ofrece protecci\u00f3n a sus electrodom\u00e9sticos y proporciona un ahorro de energ\u00eda eficiente.<\/p><p>Ese producto proporciona&nbsp;una protecci\u00f3n segura para sus electrodom\u00e9sticos, prolongando su vida \u00fatil. Ahorrador de energ\u00eda con una alt\u00edsima eficiencia dise\u00f1ado, especialmente, para cubrir las necesidades de su hogar.<\/p><p>Se trata de un novedoso dispositivo que filtra y estabiliza la energ\u00eda el\u00e9ctrica, mejorando su eficiencia y elevando el factor de potencia el\u00e9ctrica utilizando la tecnolog\u00eda m\u00e1s puntera en el campo de la eficiencia energ\u00e9tica.<br><br><b>\u00bfC\u00f3mo funciona?<\/b><\/p><p>Regula el sistema el\u00e9ctrico de su hogar. Esta regulaci\u00f3n reduce el calor por resistencia, disminuyendo el amperaje, mejorando la eficiencia el\u00e9ctrica y obteniendo una reducci\u00f3n en el consumo de energ\u00eda. Esto provoca un menor desperdicio de energ\u00eda a la vez que protege los componentes el\u00e9ctricos de los electrodom\u00e9sticos de su hogar.<\/p><p><b>\u00bfQuieres pagar menos en tus facturas de la luz?&nbsp;<\/b><\/p><ul><li>Este dispositivo, testado y certificado tambi\u00e9n proteger\u00e1 tus aparatos de las subidas de tensi\u00f3n y sobrecargas de la red<\/li><li>Voltaje: 100-240V<\/li><li>Frecuencia: 50\/60 Hz<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"JOCCA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.23,"unit_price":16.42,"unit_price_tax":16.42,"tax_rules_group":null,"category":"Material Electrico","sub_category":"Programadores de Enchufe","quantity":2,"brand":"JOCCA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_joc-pae-ahorrador%202256_1.jpg"],"wholesale_price":11.42}}},"3414971067196":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3414971067196",false],"wholesale_price":[17.38,false],"price":[22.38,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.29",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90799","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/071f9e6551bf88c379a79b8654fd4644.jpg; <br>-------------------------------"],"result":true}