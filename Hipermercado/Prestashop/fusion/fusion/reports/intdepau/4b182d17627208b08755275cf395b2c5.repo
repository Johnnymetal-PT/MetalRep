 x4<\/li><li>Tiempo medio entre fallos: 1750000 h<\/li><li>Calificaci\u00f3n TBW: 1000<\/li><li><h2>Control de energ\u00eda<\/h2><\/li><li>Corriente: 2,8 A<\/li><li>Consumo energ\u00e9tico (en suspensi\u00f3n): 0,0035 W<\/li><li><h2>Condiciones ambientales<\/h2><\/li><li>Intervalo de temperatura operativa: 0 - 70 \u00b0C<\/li><li>Intervalo de temperatura de almacenaje: -55 - 85 \u00b0C<\/li><li>M\u00e1xima temperatura: 70 \u00b0C<\/li><li><h2>Peso y dimensiones<\/h2><\/li><li>Ancho: 22 mm<\/li><li>Profundidad: 80 mm<\/li><li>Altura: 2,38 mm<\/li><li>Peso: 7,5 g<\/li><\/ul><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"WESTERN DIGITAL","supplier":null,"width":null,"height":null,"depth":null,"weight":0.05,"unit_price":89.91,"unit_price_tax":89.91,"tax_rules_group":null,"category":"Componentes","sub_category":"Discos Duros SSD","quantity":0,"brand":"WESTERN DIGITAL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wd-ssd%20wd%20rd%20sn700%20nas%201tb_1.jpg"],"wholesale_price":84.91}}},"0718037872360":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0718037872360",false],"wholesale_price":[84.95,false],"price":[89.95,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90650","Cat. IDs: 190,98","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/b65258a8b958d2438d986392bae3bdae.jpg; <br>--