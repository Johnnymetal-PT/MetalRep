":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HP","supplier":null,"width":null,"height":null,"depth":null,"weight":3.95,"unit_price":904,"unit_price_tax":904,"tax_rules_group":null,"category":"Portatiles","sub_category":"Portatiles Gaming","quantity":5,"brand":"HP","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_hpp-omen%2016-n0012ns_1.jpg"],"wholesale_price":899}}},"0196548971480":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["0196548971480",false],"wholesale_price":[686.18,false],"price":[691.18,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->name n\u00e3o \u00e9 v\u00e1lida Name: HP Pavilion 14-DV2006NS Laptop Intel Core i5-1235U\/ 16 GB\/ 512 GB SSD\/ 14&#39;\/ Win11"],"result":false},"feed_data":{"name_pt":"Port\u00e1til HP Pavilion 14-DV2006NS Intel Core i5-1235U\/ 16GB\/ 512GB SSD\/ 14'\/ Win11","category":"Portatiles","sub_category":"Portatiles","unit_price":691.18,"reference":"6H617EA","ean13":"0196548971480","weight":"2.2","quantity":5,"brand":"HP","description_pt":"<p><\/p><h2>Port\u00e1til HP Pavilion 14-dv2006ns<\/h2><b>Un port\u00e1til dise\u00f1ado para brindar m\u00e1s potencia y diversi\u00f3n<\/b><br>El port\u00e1til HP Pavilion sirve para trabajar y a\u00fan m\u00e1s para jugar. Realiza sin complicaciones tus tareas diarias gracias al potente procesador Intel\u00ae&nbsp; Util\u00edzalo en los desplazamientos gracias al dise\u00f1o compacto ya una bater\u00eda de larga duraci\u00f3n. Disfruta de un entretenimiento excepcional con el audio de B&amp;O y una pantalla con micro borde con tecnolog\u00eda anti parpadeo 2 . Fabricado pensando en el planeta, el port\u00e1til HP Pavilion contiene pl\u00e1stico destinado a acabar en los oc\u00e9anos .<br>Incre\u00edble rendimiento en un ordenador m\u00e1s peque\u00f1o que te permite una mayor productividad y disfrutar de tus contenidos desde cualquier lugar.<br><br><h2>Especificaciones<\/h2><ul><li><b>Sistema operativo<\/b>: Windows 11<\/li><li>Familias de procesadores: Procesador Intel\u00ae Core&#8482; i5 de 12. \u00aa generaci\u00f3n<\/li><li><b>Procesador<\/b>: Intel\u00ae Core&#8482; i5-1235U (hasta 4,4 GHz con tecnolog\u00eda Intel\u00ae Turbo Boost, 12 MB de cach\u00e9 L3, 10 n\u00facleos, 12 subprocesos)&nbsp;<\/li><li>Conjunto de fichas: Intel\u00ae SoC integrado<\/li><li>Especificaciones de impacto sostenible: Ocean-Bound Plastic (OBP) en las carcasas de los altavoces<\/li><li>Gesti\u00f3n de la seguridad: Compatible con el m\u00f3dulo de plataforma de confianza (firmware TPM)<\/li><li><b>Memoria<\/b>: RAM DDR4-3200 MHz 16 GB (2 de 8 GB)<\/li><li>Dise\u00f1o de la memoria (ranuras y tama\u00f1o): 2 de 8GB<\/li><li><b>Almacenamiento interno<\/b>: SSD de 512 GB PCIe\u00ae NVMe&#8482; M.2<\/li><li>Servicio en la nube: Almacenamiento en Dropbox de 25 GB durante 12 meses<\/li><li>Unidad \u00f3ptica: Unidad \u00f3ptica no incluida<\/li><li><b>Pantalla<\/b>: FHD de 14' (35,6 cm) en diagonal, IPS, bisel microborde, antirreflectante, 250 nits, 45 % NTSC (1920 x 1080)<\/li><li>Tama\u00f1o de la pantalla (diagonal): 35,6 cm (14 pulg.)<\/li><li>Gr\u00e1ficos: integrada<\/li><li><b>Gr\u00e1ficos (integrados)<\/b>: Gr\u00e1ficos Intel\u00ae Iris\u00ae X&#7497;<\/li><li><b>Puertos<\/b>:&nbsp;<\/li><ul><li>1 SuperSpeed &#8203;&#8203;USB Type-C\u00ae con velocidad de se\u00f1al de 10 Gbps (USB con suministro de energ\u00eda, DisplayPort&#8482; 1.4, HP Sleep and Charge);&nbsp;<\/li><li>2 SuperSpeed &#8203;&#8203;USB Type-A con velocidad de se\u00f1al de 5 Gbps;&nbsp;<\/li><li>1 HDMI 2.1;&nbsp;<\/li><li>1 pin inteligente de CA;&nbsp;<\/li><li>1 combo de auriculares\/micr\u00f3fono<\/li><\/ul><