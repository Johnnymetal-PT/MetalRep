"4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CASIO","supplier":null,"width":null,"height":null,"depth":null,"weight":0.3,"unit_price":72.8,"unit_price_tax":72.8,"tax_rules_group":null,"category":"SmartWatch - Pulseras","sub_category":"Relojes Digitales","quantity":0,"brand":"CASIO","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cas-reloj%20ga-100-1a4er_1.jpg"],"wholesale_price":67.8}}},"4971850924012":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4971850924012",false],"wholesale_price":[35,false],"price":[40,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.11",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:91169","Cat. IDs: 76","Associated Categories","Cat. Default: 76","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/a2bc0ab8dea42558c53dcd177b54c468.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Reloj Digital Casio Vintage Iconic LA680WEGA-1ER\/ 34mm\/ Dorado","category":"SmartWatch - Pulseras","sub_category":"Relojes Digitales","unit_price":40,"reference":"LA680WEGA-1ER","ean13":"4971850924012","weight":"0.11","quantity":2,"brand":"CASIO","description_pt":"                                                <p><p><\/p><h2>Alarma diaria<\/h2><p>La alarma diaria emite una se\u00f1al ac\u00fastica en el momento programado para recordar aquellos acontecimientos que se repiten diariamente.<\/p><h2>Correa de acero inoxidable<\/h2><p>Robusta, resistente y elegante. La correa de acero inoxidable es un cl\u00e1sico para relojes.<\/p><h2>5 a\u00f1os - 1 pila<\/h2><p>La pila proporciona al reloj la energ\u00eda necesaria durante aprox. 5 a\u00f1os<\/p><h2>Luz LED<\/h2><p>Para iluminar la esfera del reloj se usa un diodo emisor de luz (LED).<\/p><h2>Caja de resina<\/h2><p>La caja de resina es el compa\u00f1ero ideal para cada d\u00eda. Es duradera, ligera y relativamente insensible al fr\u00edo, calor u otras influencias externas.<\/p><h2>Cristal acr\u00edlico<\/h2><p>El acr\u00edlico es f\u00e1cil y relativamente irrompible.<\/p><p><\/p><h2>Calendario autom\u00e1tico<\/h2><p>Una vez ajustado, el calendario autom\u00e1tico muestra siempre la fecha correcta.<\/p><h2>Indicaci\u00f3n de hora normal de 12\/24 horas<\/h2><p>Las horas se visualizan ya sea en el formato de 12 o 24 horas.<\/p><h2>Cron\u00f3metro - 1\/100 seg. - 1 hora<\/h2><p>El tiempo transcurrido, los tiempos parciales y el tiempo final se miden con una precisi\u00f3n de cent\u00e9simas de segundo. El reloj tiene capacidad para cronometrar hasta una hora.<\/p><h2>Cierre ajustable<\/h2><p>El cierre se puede ajustar individualmente de forma sencilla para proporcionar la m\u00e1xima comodidad.<\/p><h2>Clasificaci\u00f3n de resistencia al agua (WR) seg\u00fan ISO 22810<\/h2><p>Este modelo es resistente al agua seg\u00fan DIN 8310 o ISO 22810 y soporta peque\u00f1as salpicaduras de agua. Deber\u00e1 evitarse cualquier mayor contacto con el agua.<\/p><br><\/p><p><p><ul><li><b>Especificaciones<\/b><\/li><li>Exactitud<\/li><li>+\/- 30 seg<\/li><li>Alarmas<\/li><li>Alarma diaria<\/li><li>Calendario autom\u00e1tico<\/li><li>Si<\/li><li>Correa<\/li><li>Correa de acero inoxidable<\/li><li>Color de base<\/li><li>dorado<\/li><li>Duraci\u00f3n de la bater\u00eda<\/li><li>5 A\u00f1o(s)<\/li><li>Tipo de pila<\/li><li>CR1616<\/li><li>Caja<\/li><li>Caja de resina<\/li><li>Cierre ajustable<\/li><li>Cierre ajustable<\/li><li>Digital \/ Anal\u00f3gico<\/li><li>Digital<\/li><li>G\u00e9nero<\/li><li>Mujeres<\/li><li>Iluminador<\/li><li>Luz LED<\/li><li>La resistencia al agua<\/li><li>0 barra<\/li><li>Dimensiones (Al x An x Pr)<\/li><li>33,5 mm x 28,6 mm x 8,6 mm<\/li><li>Peso<\/li><li>36 gramos<\/li><\/ul><\/p><br><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_cas-reloj%20la680wega-1er_1.jpg","wholesale_price":"35.00","unit_price_tax":40},"product_model":{"product_data":{"ean13":["4971850924012"],"reference":"LA680WEGA-1ER","name":{"1":"Reloj Digital Casio Vintage Iconic LA680WEGA-1ER\/ 34mm\/ Dorado","2":"","3":"","4":""},"description":{"1":"                                                <p><p><\/p><h2>Alarma diaria<\/h2><p>La alarma diaria emite una se\u00f1al ac\u00fastica en el momento programado para recordar aquellos acontecimientos que se repiten diariamente.<\/p><h2>Correa de acero inoxidable<\/h2><p>Robusta, resistente y elegante. La correa de acero inoxidable es un cl\u00e1sico para relojes.<\/p><h2>5 a\u00f1os - 1 pila<\/h2><p>La pila proporciona al reloj la energ\u00eda necesaria durante aprox. 5 a\u00f1os<\/p><h2>Luz LED<\/h2><p>Para iluminar la esfera del reloj se usa un diodo emisor de luz (LED).<\/p><h2>Caja de resina<\/h2><p>La caja de resina es el compa\u00f1ero ideal para cada d\u00eda. Es duradera, ligera y relativamente insensible al fr\u00edo, calor u otras influencias externas.<\/p><h2>Cristal acr\u00edlico<\/h2><p>El acr\u00edlico es f\u00e1cil y relativamente irrompible.<\/p><p><\/p><h2>Calendario autom\u00e1tico<\/h2><p>Una vez ajustado, el calendario autom\u00e1tico muestra siempre la fecha correcta.<\/p><h2>Indicaci\u00f3n de hora normal de 12\/24 horas<\/h2><p>Las horas se visualizan ya sea en el formato de 12 o 24 horas.<\/p><h2>Cron\u00f3metro - 1\/100 seg. - 1 hora<\/h2><p>El tiempo transcurrido, los tiempos parciales y el tiempo final se miden con una precisi\u00f3n de cent\u00e9simas de segundo. El reloj tiene capacidad para cronometrar hasta una hora.<\/p><h2>Cierre ajustable<\/h2><p>El cierre se puede ajustar individualmente de forma sencilla p