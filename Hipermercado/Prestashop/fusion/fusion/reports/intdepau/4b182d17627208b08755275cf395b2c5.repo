tures",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90948","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/7dad10e8a4f3639a3213d3de64463f32.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Gamepad Mars Gaming MGP-24 Inal\u00e1mbrico","category":"Perif\u00e9ricos Gaming","sub_category":"Joysticks - Pads - Volantes","unit_price":31.22,"reference":"MGP24","ean13":"8435693102267","weight":"0.31","quantity":5,"brand":"MARS GAMING","description_pt":"<h2>GAMEPAD INAL\u00c1MBRICO MGP-24<\/h2><p>Gamepad con conexi\u00f3n inal\u00e1mbrica profesional 2.4GPRO, sin lag y con la m\u00e1xima estabilidad de conexi\u00f3n. Espectacular dise\u00f1o transl\u00facido negro con iluminaci\u00f3n NE\u00d3N RGB. Sistema de vibraci\u00f3n h\u00e1ptica dual y compatibilidad superior multiplataforma.<\/p><p><p><ul><li>Inal\u00e1mbrico 2.4GPRO profesional<\/li><li>Dise\u00f1o transl\u00facido ne\u00f3n RGB<\/li><li>Vibraci\u00f3n h\u00e1ptica dual<\/li><li>Compatibilidad superior<\/li><\/ul><\/p><h2>CONEXI\u00d3N INAL\u00c1MBRICA PROFESIONAL 2.4GPRO<\/h2><p>Para un rendimiento inal\u00e1mbrico profesional sin lag ni interferencias, el MGP-24 incorpora la m\u00e1s avanzada tecnolog\u00eda 2.4GPRO con adaptador USB incorporado. La conexi\u00f3n 2.4GPRO es la tecnolog\u00eda inal\u00e1mbrica de elecci\u00f3n profesional ya que es t\u00e9cnicamente superior, m\u00e1s r\u00e1pida y estable que la tecnolog\u00eda bluetooth. Adem\u00e1s, disfruta de hasta 10 horas de uso con su bater\u00eda de gran capacidad y rec\u00e1rgala c\u00f3modamente con el cable USB-C extra\u00edble incluido.<\/p><h2>DISE\u00d1O TRANSL\u00daCIDO NE\u00d3N RGB<\/h2><p>Admira la belleza electr\u00f3nica y mec\u00e1nica del MGP-24 a trav\u00e9s de su acabado negro transl\u00facido y deslumbra con su espectacular sistema de iluminaci\u00f3n multimodo RGB por fibra \u00f3ptica.<\/p><h2>M\u00c1XIMAS PRESTACIONES<\/h2><p>Modos X-input y Direct-input para compatibilidad total, funci\u00f3n turbo, 20 botones t\u00e1ctiles, joysticks anal\u00f3gicos y pad direccional de alta precisi\u00f3n.<\/p><h2>VIBRACI\u00d3N H\u00c1PTICA DUAL<\/h2><p>El MGP-24 cuenta con un potente sistema vibraci\u00f3n h\u00e1ptica para dotar de un realismo extremo a tus gameplays.<\/p><h2>DISE\u00d1O ERGON\u00d3MICO<\/h2><p>Confort asegurado gracias a su dise\u00f1o ergon\u00f3mico con formas redondeadas y joysticks en posici\u00f3n asim\u00e9trica.<\/p><h2>COMPATIBILIDAD MULTIPLATAFORMA SUPERIOR<\/h2><p>Compatible con PC, PS3, PS4, PS5 (limitada), XBOX360, Raspberry Pi, Mac y *Android<\/p><br><\/p><p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><p><ul><li><b>Dimensiones<\/b><\/li><li>152x115x58mm<\/li><li><b>Peso<\/b><\/li><li>211g<\/li><li><b>Iluminaci\u00f3n<\/b><\/li><li>RGB Neon<\/li><li><b>Botones<\/b><\/li><li>20<\/li><li><b>Bater\u00eda<\/b><\/li><li>Recargable Ion-Litio<\/li><li><b>Compatibilidad<\/b><\/li><li>PC, PS3, PS4, PS5 (s\u00f3lo juegos PS4), XBOX360, Raspberry Pi, Mac (Requiere firmware), *Android (Compatible con m\u00f3viles mediante adaptador OTG no incluido)<\/li><li><b>Cable<\/b><\/li><li>1 metros extra\u00edble USB-A \/ USB-C<\/li><li><b>PC input<\/b><\/li><li>X-input &amp; D-input<\/li><li><b>Vibraci\u00f3n<\/b><\/li><li>Dual<\/li><li><b>Tiempo de carga<\/b><\/li><li>3 horas<\/li><li><b>Autonom\u00eda<\/b><\/li><li>10 horas<\/li><li><b>Conectividad<\/b><\/li><li>Inal\u00e1mbrica 2.4GHz<\/li><li><b>Distancia (Inal\u00e1mbrico)<\/b><\/li><li>10m<\/li><li><b>Funci\u00f3n standby<\/b><\/li><li>S\u00ed<\/li><li><b>Conector mando<\/b><\/li><li>USB-C<\/li><\/ul><\/p><h2>CONTENIDO DE LA CAJA<\/h2><p><ul><li>Cable USB-A \/ USB-C, manual, receptor USB y mando<\/li><\/ul><\/p><br><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-gamepad%20mgp-24_1.jpg","wholesale_price":"26.22","unit_price_tax":31.22},"product_model":{"product_data":{"ean13":["8435693102267"],"reference":"MGP24","name":{"1":"Gamepad Mars Gaming MGP-24 Inal\u00e1mbrico","2":"","3":"","4":""},"description":{"1":"<h2>GAMEPAD INAL\u00c1MBRICO MGP-24<\/h2><p>Gamepad con conexi\u00f3n inal\u00e1mbrica profesional 2.4GPRO, sin lag y con la m\u00e1xima estabilidad de conexi\u00f3n. Espectacular dise\u00f1o transl\u00facido negro con iluminaci\u00f3n NE\u00d3N RGB. Sistema de vibraci\u00f3n h\u00e1ptica dual y compatibilidad superior multiplataforma.<\/p><p><p><ul><li>Inal\u00e1mbrico 2.4GPRO profesional<\/li><li>Dise\u00f1o transl\u00facido ne\u00f3n RGB<\/li><li>Vibraci\u00f3n h\u00e1ptica dual<\/li><li>Compatibilidad superior<\/li><\/ul><\/p><h2>CONEXI\u00d3N INAL\u00c1MBRICA PROFESIONAL 2.4GPRO<\/h2><p>Para un rendimiento inal\u00e1mbrico profesional sin lag ni interferencias, el MGP-24 incorpora la m\u00e1s avanzada tecnolog\u00eda 2.4GPRO con adaptador USB incorporado. La conexi\u00f3n 2.4GPRO es la tecnolog\u00eda inal\u00e1mbrica de elecci\u00f3n profesional ya que es t\u00e9cnicamente superior, m\u00e1s r\u00e1pida y estable que la tecnolog\u00eda bluetooth. Adem\u00e1s, disfruta de hasta 10 horas de uso con su bater\u00eda de gran capacidad y rec\u00e1rgala c\u00f3modamente con el cable USB-C extra\u00edble incluido.<\/p><h2>DISE\u00d1O TRANSL\u00daCIDO NE\u00d3N RGB<\/h2><p>Admira la belleza electr\u00f3nica y mec\u00e1nica del MGP-24 a trav\u00e9s de su acabado negro transl\u00facido y deslumbra con su espectacular sistema de iluminaci\u00f3n multimodo RGB por fibra \u00f3ptica.<\/p><h2>M\u00c1XIMAS PRESTACIONES<\/h2><p>Modos X-input y Direct-input para compatibilidad total, funci\u00f3n turbo, 20 botones t\u00e1ctiles, joysticks anal\u00f3gicos y pad direccional de alta precisi\u00f3n.<\/p><h2>VIBRACI\u00d3N H\u00c1PTICA DUAL<\/h2><p>El MGP-24 cuenta con un potente sistema vibraci\u00f3n h\u00e1ptica para dotar de un realismo extremo a tus gameplays.<\/p><h2>DISE\u00d1O ERGON\u00d3MICO<\/h2><p>Confort asegurado gracias a su dise\u00f1o ergon\u00f3mico con formas redondeadas y joysticks en posici\u00f3n asim\u00e9trica.<\/p><h2>COMPATIBILIDAD MULTIPLATAFORMA SUPERIOR<\/h2><p>Compatible con PC, PS3, PS4, PS5 (limitada), XBOX360, Raspberry Pi, Mac y *Android<\/p><br><\/p><p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><p><ul><li><b>Dimensiones<\/b><\/li><li>152x115x58mm<\/li><li><b>Peso<\/b><\/li><li>211g<\/li><li><b>Iluminaci\u00f3n<\/b><\/li><li>RGB Neon<\/li><li><b>Botones<\/b><\/li><li>20<\/li><li><b>Bater\u00eda<\/b><\/li><li>Recargable Ion-Litio<\/li><li><b>Compatibilidad<\/b><\/li><li>PC, PS3, PS4, PS5 (s\u00f3lo juegos PS4), XBOX360, Raspberry Pi, Mac (Requiere firmware), *Android (Compatible con m\u00f3viles mediante adaptador OTG no incluido)<\/li><li><b>Cable<\/b><\/li><li>1 metros extra\u00edble USB-A \/ USB-C<\/li><li><b>PC input<\/b><\/li><li>X-input &amp; D-input<\/li><li><b>Vibraci\u00f3n<\/b><\/li><li>Dual<\/li><li><b>Tiempo de carga<\/b><\/li><li>3 horas<\/li><li><b>Autonom\u00eda<\/b><\/li><li>10 horas<\/li><li><b>Conectividad<\/b><\/li><li>Inal\u00e1mbrica 2.4GHz<\/li><li><b>Distancia (Inal\u00e1mbrico)<\/b><\/li><li>10m<\/li><li><b>Funci\u00f3n standby<\/b><\/li><li>S\u00ed<\/li><li><b>Conector mando<\/b><\/li><li>USB-C<\/li><\/ul><\/p><h2>CONTENIDO DE LA CAJA<\/h2><p><ul><li>Cable USB-A \/ USB-C, manual, receptor USB y mando<\/li><\/ul><\/p><br><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MARS GAMING","supplier":null,"width":null,"height":null,"depth":null,"weight":0.31,"unit_price":31.22,"unit_price_tax":31.22,"tax_rules_group":null,"category":"Perif\u00e9ricos Gaming","sub_category":"Joysticks - Pads - Volantes","quantity":5,"brand":"MARS GAMING","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-gamepad%20mgp-24_1.jpg"],"wholesale_price":26.22}}},"8435693102557":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435693102557",false],"wholesale_price":[60.21,false],"price":[65.21,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 7",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90949","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/05d37cb48e5788b99cf680b45d7ee767.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Caja Gaming Torre Mars Gaming MC-KX\/ Negra","category":"Perif\u00e9ricos Gaming","sub_category":"Gaming - Cajas ATX","unit_price":65.21000000000001,"reference":"MCKX","ean13":"8435693102557","weight":"7","quantity":5,"brand":"MARS GAMING","description_pt":"<p><\/p><h2>TORRE GAMING PREMIUM MC-KX<\/h2>Exclusivo sistema de refrigeraci\u00f3n CPU FREEZER. Incluye 5 ventiladores ultra-silenciosos ARGB con controladora incluida y mando a distancia o control por software con placas base ARGB. Estructura XXL E-ATX con bah\u00edas VGA verticales, soporte de hasta 9 ventiladores de 120mm y 5 ventiladores de 140mm, soporte para liquidas de 360 y 280.<h2>Refrigeraci\u00f3n insuperable. Tama\u00f1o XXL<\/h2><p>  <\/p><ul>    <li>Sistema CPU FREEZER<\/li>    <li>5x ventiladores ARGB<\/li>    <li>Controladora ARGB con mando a distancia<\/li>    <li>Tama\u00f1o XXL E-ATX<\/li>  <\/ul><p><\/p><h2>REFRIGERACI\u00d3N M\u00c1XIMA<\/h2>Un flujo de aire constante es la clave para extender la vida \u00fatil de tus componentes y hacer que tu sistema funcione a pleno rendimiento. La MC-KX, elimina todo problema de temperatura manteniendo el silencio gracias al enorme flujo de aire de sus 5 ventiladores, su rejilla frontal sin restricci\u00f3n de flujo y su exclusivo sistema CPU FREEZER. Adem\u00e1s, ofrece soporte total para refrigeraci\u00f3n l\u00edquida incluyendo sistemas extra-grandes con radiadores de 360 o 280mm.<p><\/p><p><\/p><h2>SISTEMA CPU FREEZER<\/h2>Innovador y eficiente sistema de refrigeraci\u00f3n con un ventilador dedicado a la zona m\u00e1s caliente de tu PC: el microprocesador y su zona en la placa base. Gracias al sistema CPU FREEZER conseguir\u00e1s mantener a raya la temperatura de tu procesador y placa base para maximizar el rendimiento.<br><br><b>Nota: El sistema CPU freezer podr\u00eda no ser compatible con algunos backplates de disipadores CPU en placas base Intel<\/b><p><\/p><p><\/p><h2>CAPACIDAD INTERNA SUPERIOR XXL E-ATX<\/h2>La MC-KX ofrece un enorme espacio interno para la instalaci\u00f3n de componentes de alto rendimiento, ofreciendo soporte para placas E-ATX, ATX, micro-ATX y mini-ITX, ranuras verticales, hasta 9 ventiladores de 120mm y 5 ventiladores de 140mm y refrigeraciones l\u00edquidas de hasta 360 o 280.<p><\/p><p><\/p><h2>CONTROLADORA ARGB CON MANDO RF<\/h2>El sistema de iluminaci\u00f3n de la MC-KX te proporciona control y soporte para hasta 10 ventiladores a trav\u00e9s de su mando a distancia RF, pero adem\u00e1s incluye una conexi\u00f3n ARGB standard para que puedas sincronizar la iluminaci\u00f3n con placas base o controladoras compatibles ARGB. Elige el modo que mejor se adapte a tu setup y disfruta de una infinita gama de posibilidades est\u00e9ticas.<p><\/p><p><\/p><h2>ESCAPARATE ESPECTACULAR<\/h2>Dotada de una ventana completa de cristal templado y dos ranuras verticales para tarjeta gr\u00e1fica*, la caja MC-KX permite mostrar tu PC en todo su esplendor.<p><\/p><p><br><\/p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><p><\/p><ul><li><b>Dimensiones: <\/b>397x210x490mm<\/li><li><b>Peso: <\/b>4.9Kg<\/li><li><b>Tama\u00f1o<\/b>: Torre<\/li><li><b>Ventana:<\/b> Ventana lateral completa de cristal templado<\/li><li>Iluminaci\u00f3n: Addressable RGB + modos de luz predefinidos (HUB y mando de control)<\/li><li><b>Extras<\/b><\/li><li>Sistema de gesti\u00f3n de cableado interno y ventilador dedicado para CPU<\/li><li><b>Compatibilidad con placas base<\/b><\/li><li>E-ATX \/ ATX \/ MicroATX \/ Mini-ITX<\/li><li><b>Filtros antipolvo<\/b><\/li><li>1x filtro superior magn\u00e9tico y 1x filtro inferior extra\u00edble<\/li><li>Lector de tarjetas: No<\/li><li><b>Puertos<\/b><\/li><li>USB3.0 x1 \/ USB2.0 x2 \/ HD Audio + Mic<\/li><li><b>Tipo de fuente:<\/b> ATX<\/li><li><b>Bah\u00edas internas<\/b><\/li><li>2x 3.5' HDD \/ 4x 2.5' SSD<\/li><li><b>Longitud VGA m\u00e1x<\/b>.: 348mm<\/li><li><b>Anchura VGA m\u00e1x.:<\/b> 155mm<\/li><li><b>Altura disipador m\u00e1x.<\/b>: 160mm<\/li><li><b>Slots de expansi\u00f3n:<\/b> 7 + 2 verticales<\/li><li><b>Soporte refrigeraci\u00f3n l\u00edquida<\/b><\/li><li>360mm, 280mm, 140mm, 120mm frontal \/ 280mm, 240mm, 140mm, 120mm superior \/ 120mm, trasero<\/li><li><b>Capacidad de ventiladores<\/b><\/li><li>Hasta 9x 120mm o 5x 140mm - El ventilador CPU freezer podr\u00eda no ser compatible con algunos backplates de disipadores CPU en placas base Intel.<\/li><li><b>Ventiladores incluidos<\/b><\/li><li>3x 120mm ARGB frontal + 1x 120mm ARGB trasero + 1x 120mm ARGB lateral<\/li><li><b>Medidas internas<\/b><\/li><li>Ancho-19.5 Alto-47 (suelo a techo) Largo 34.8cm<\/li><li><b>Conexiones HUB<\/b><\/li><li>Hasta x10 +12V 6pin ARGB \/ 2x tiras LED PH2.0 3PIN<\/li><li>PWM: No<\/li><li><b>Presi\u00f3n del aire:<\/b> 1.05mm- H2O<\/li><li>Rodamientos: 1100 \u00b1 10% RPM<\/li><li>Flujo de aire (CFM): 31 CFM<\/li><li>Nivel sonoro \/dBA): 14dB(A)<\/li><li>Potencia Max. Entrada (W): 1.8W<\/li><li>Duraci\u00f3n: 60.000 horas<\/li><li><b>Conexi\u00f3n<\/b><\/li><li>6 pin (Ventilador) \/ Sata + 5V Adressable RGB 3 pin (HUB)<\/li><li>Compatibilidad Addressable RGB<\/li><li>Asus Aura Sync, MSI Mystic Light Sync y RGB Fusion 2.0<\/li><li>Conectores de alimentaci\u00f3n<\/li><li>SATA (HUB) \/ Addressable RGB 3 pin (HUB)<\/li><li><b>CONTENIDO DE LA CAJA<\/b><\/li><li>Mando control RF, HUB, set torniller\u00eda<\/li><\/ul><br><p><\/p><br><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20mc-kx%20bk_1.jpg","wholesale_price":"60.21","unit_price_tax":65.21000000000001},"product_model":{"product_data":{"ean13":["8435693102557"],"reference":"MCKX","name":{"1":"Caja Gaming Torre Mars Gaming MC-KX\/ Negra","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>TORRE GAMING PREMIUM MC-KX<\/h2>Exclusivo sistema de refrigeraci\u00f3n CPU FREEZER. Incluye 5 ventiladores ultra-silenciosos ARGB con controladora incluida y mando a distancia o control por software con placas base ARGB. Estructura XXL E-ATX con bah\u00edas VGA verticales, soporte de hasta 9 ventiladores de 120mm y 5 ventiladores de 140mm, soporte para liquidas de 360 y 280.<h2>Refrigeraci\u00f3n insuperable. Tama\u00f1o XXL<\/h2><p>  <\/p><ul>    <li>Sistema CPU FREEZER<\/li>    <li>5x ventiladores ARGB<\/li>    <li>Controladora ARGB con mando a distancia<\/li>    <li>Tama\u00f1o XXL E-ATX<\/li>  <\/ul><p><\/p><h2>REFRIGERACI\u00d3N M\u00c1XIMA<\/h2>Un flujo de aire constante es la clave para extender la vida \u00fatil de tus componentes y hacer que tu sistema funcione a pleno rendimiento. La MC-KX, elimina todo problema de temperatura manteniendo el silencio gracias al enorme flujo de aire de sus 5 ventiladores, su rejilla frontal sin restricci\u00f3n de flujo y su exclusivo sistema CPU FREEZER. Adem\u00e1s, ofrece soporte total para refrigeraci\u00f3n l\u00edquida incluyendo sistemas extra-grandes con radiadores de 360 o 280mm.<p><\/p><p><\/p><h2>SISTEMA CPU FREEZER<\/h2>Innovador y eficiente sistema de refrigeraci\u00f3n con un ventilador dedicado a la zona m\u00e1s caliente de tu PC: el microprocesador y su zona en la placa base. Gracias al sistema CPU FREEZER conseguir\u00e1s mantener a raya la temperatura de tu procesador y placa base para maximizar el rendimiento.<br><br><b>Nota: El sistema CPU freezer podr\u00eda no ser compatible con algunos backplates de disipadores CPU en placas base Intel<\/b><p><\/p><p><\/p><h2>CAPACIDAD INTERNA SUPERIOR XXL E-ATX<\/h2>La MC-KX ofrece un enorme espacio interno para la instalaci\u00f3n de componentes de alto rendimiento, ofreciendo soporte para placas E-ATX, ATX, micro-ATX y mini-ITX, ranuras verticales, hasta 9 ventiladores de 120mm y 5 ventiladores de 140mm y refrigeraciones l\u00edquidas de hasta 360 o 280.<p><\/p><p><\/p><h2>CONTROLADORA ARGB CON MANDO RF<\/h2>El sistema de iluminaci\u00f3n de la MC-KX te proporciona control y soporte para hasta 10 ventiladores a trav\u00e9s de su mando a distancia RF, pero adem\u00e1s incluye una conexi\u00f3n ARGB standard para que puedas sincronizar la iluminaci\u00f3n con placas base o controladoras compatibles ARGB. Elige el modo que mejor se adapte a tu setup y disfruta de una infinita gama de posibilidades est\u00e9ticas.<p><\/p><p><\/p><h2>ESCAPARATE ESPECTACULAR<\/h2>Dotada de una ventana completa de cristal templado y dos ranuras verticales para tarjeta gr\u00e1fica*, la caja MC-KX permite mostrar tu PC en todo su esplendor.<p><\/p><p><br><\/p><h2>CARACTER\u00cdSTICAS T\u00c9CNICAS<\/h2><p><\/p><ul><li><b>Dimensiones: <\/b>397x210x490mm<\/li><li><b>Peso: <\/b>4.9Kg<\/li><li><b>Tama\u00f1o<\/b>: Torre<\/li><li><b>Ventana:<\/b> Ventana lateral completa de cristal templado<\/li><li>Iluminaci\u00f3n: Addressable RGB + modos de luz predefinidos (HUB y mando de control)<\/li><li><b>Extras<\/b><\/li><li>Sistema de gesti\u00f3n de cableado interno y ventilador dedicado para CPU<\/li><li><b>Compatibilidad con placas base<\/b><\/li><li>E-ATX \/ ATX \/ MicroATX \/ Mini-ITX<\/li><li><b>Filtros antipolvo<\/b><\/li><li>1x filtro superior magn\u00e9tico y 1x filtro inferior extra\u00edble<\/li><li>Lector de tarjetas: No<\/li><li><b>Puertos<\/b><\/li><li>USB3.0 x1 \/ USB2.0 x2 \/ HD Audio + Mic<\/li><li><b>Tipo de fuente:<\/b> ATX<\/li><li><b>Bah\u00edas internas<\/b><\/li><li>2x 3.5' HDD \/ 4x 2.5' SSD<\/li><li><b>Longitud VGA m\u00e1x<\/b>.: 348mm<\/li><li><b>Anchura VGA m\u00e1x.:<\/b> 155mm<\/li><li><b>Altura disipador m\u00e1x.<\/b>: 160mm<\/li><li><b>Slots de expansi\u00f3n:<\/b> 7 + 2 verticales<\/li><li><b>Soporte refrigeraci\u00f3n l\u00edquida<\/b><\/li><li>360mm, 280mm, 140mm, 120mm frontal \/ 280mm, 240mm, 140mm, 120mm superior \/ 120mm, trasero<\/li><li><b>Capacidad de ventiladores<\/b><\/li><li>Hasta 9x 120mm o 5x 140mm - El ventilador CPU freezer podr\u00eda no ser compatible con algunos backplates de disipadores CPU en placas base Intel.<\/li><li><b>Ventiladores incluidos<\/b><\/li><li>3x 120mm ARGB frontal + 1x 120mm ARGB trasero + 1x 120mm ARGB lateral<\/li><li><b>Medidas internas<\/b><\/li><li>Ancho-19.5 Alto-47 (suelo a techo) Largo 34.8cm<\/li><li><b>Conexiones HUB<\/b><\/li><li>Hasta x10 +12V 6pin ARGB \/ 2x tiras LED PH2.0 3PIN<\/li><li>PWM: No<\/li><li><b>Presi\u00f3n del aire:<\/b> 1.05mm- H2O<\/li><li>Rodamientos: 1100 \u00b1 10% RPM<\/li><li>Flujo de aire (CFM): 31 CFM<\/li><li>Nivel sonoro \/dBA): 14dB(A)<\/li><li>Potencia Max. Entrada (W): 1.8W<\/li><li>Duraci\u00f3n: 60.000 horas<\/li><li><b>Conexi\u00f3n<\/b><\/li><li>6 pin (Ventilador) \/ Sata + 5V Adressable RGB 3 pin (HUB)<\/li><li>Compatibilidad Addressable RGB<\/li><li>Asus Aura Sync, MSI Mystic Light Sync y RGB Fusion 2.0<\/li><li>Conectores de alimentaci\u00f3n<\/li><li>SATA (HUB) \/ Addressable RGB 3 pin (HUB)<\/li><li><b>CONTENIDO DE LA CAJA<\/b><\/li><li>Mando control RF, HUB, set torniller\u00eda<\/li><\/ul><br><p><\/p><br><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manu