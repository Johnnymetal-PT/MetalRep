,"3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"JOCCA","supplier":null,"width":null,"height":null,"depth":null,"weight":0.7,"unit_price":16.87,"unit_price_tax":16.87,"tax_rules_group":null,"category":"Cocina","sub_category":"Bolsas Porta Alimentos","quantity":2,"brand":"JOCCA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_joc-pae-tupper%204463_1.jpg"],"wholesale_price":11.87}}},"0010942223467":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0010942223467",false],"wholesale_price":[288.98,false],"price":[293.98,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 9",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90640","Cat. IDs: 48","Associated Categories","Cat. Default: 48","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/c51a4a0be95d51efac9952783edc2fea.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cafetera Expreso Krups Arabica Display\/ 1450W\/ 15 Bares\/ Negra","category":"Cocina","sub_category":"Cafeteras","unit_price":293.98,"reference":"EA817010","ean13":"0010942223467","weight":"9","quantity":2,"brand":"KRUPS","description_pt":"<p><\/p><h2>ARABICA DISPLAY BLACK<\/h2>Lleva la esencia del espresso directamente a tu taza<br>Disfruta de la esencia de un caf\u00e9 espresso de forma f\u00e1cil con la cafetera superautom\u00e1tica Arabica. A pesar de su compacto dise\u00f1o, est\u00e1 dotada de una gran capacidad, lo que la convierte en una cafetera muy pr\u00e1ctica. Es muy f\u00e1cil de usar y contiene los \u00faltimos avances tecnol\u00f3gicos, todo ello para producir unos caf\u00e9s y espressos llenos de sabor directamente a tu taza.<p><\/p><p><\/p><h2>Preparar un caf\u00e9 perfecto nunca fue tan f\u00e1cil<\/h2>Una cafetera sencilla y f\u00e1cil de usar pero dotada de la tecnolog\u00eda m\u00e1s avanzada para brindar el aut\u00e9ntico sabor del caf\u00e9 en su esencia m\u00e1s pura y producir unos espressos y cappuccinos llenos de aroma.<p><\/p><p><\/p><h2>Dise\u00f1o compacto pero de gran capacidad<\/h2>Descubra lo mejor de dos mundos, con toda la comodidad de un dise\u00f1o compacto sin comprometer la capacidad.<p><\/p><p><\/p><h2>Tecnolog\u00eda avanzada para un caf\u00e9 sin igual<\/h2>El sistema Quattro Force mejora cada paso de preparaci\u00f3n del caf\u00e9: molinillo un 20 % m\u00e1s r\u00e1pido, prensado ultraplano, sistema de percolaci\u00f3n optimizado y limpieza autom\u00e1tica para garantizar un rendimiento duradero de la cafetera.<p><\/p><p><br><\/p><h2>GENERAL<\/h2><ul>  <li>Interfaz Botones<\/li>  <li>Potencia 1450 W<\/li>  <li>Personalizaci\u00f3n de la cantidad S\u00cd<\/li>  <li>Presi\u00f3n 15<\/li>  <li>Molinillo de caf\u00e9 Molinillo c\u00f3nico de metal<\/li>  <li>Capacidad del recipiente de caf\u00e9 260 g<\/li>  <li>Capacidad del dep\u00f3sito de agua 1,7 L<\/li>  <li>Indicador de dep\u00f3sito de agua vac\u00edo S\u00ed<\/li>  <li>Capacidad del recolector de caf\u00e9 molido usado [9]<\/li>  <li>Sistema Thermoblock Compacto (CTS) patentado S\u00ed<\/li>  <li>Espumador de leche S\u00ed<\/li>  <li>Recetario Espresso, Americano<\/li>  <li><b>T\u00c9CNICO<\/b><\/li>  <li>N\u00famero de tazas de caf\u00e9 al mismo tiempo (n\u00famero de ciclos) [2]<\/li>  <li>Unidad de volumen de bebida variable 6-9 g<\/li>  <li>Cantidad variable de agua en taza S\u00ed<\/li>  <li>Configuraci\u00f3n del grado de molienda Manual (3 niveles)<\/li>  <li>N\u00famero de niveles de temperatura 3<\/li>  <li>Niveles de temperatura del caf\u00e9 3<\/li>  <li>Ciclo de molido doble y autom\u00e1tico para caf\u00e9s largos (220 ml) S\u00ed<\/li>  <li>Distancia m\u00e1x. boquilla de caf\u00e9 - bandeja de goteo 10,8 cm<\/li>  <li>Altura de salida de caf\u00e9 ajustable S\u00ed<\/li>  <li><b>MANTENIMIENTO<\/b><\/li>  <li>Indicador de cal Autom\u00e1tico<\/li>  <li>Programa de aclarado Autom\u00e1tico<\/li>  <li>Programa de aclarado para el sistema de leche Sin programa<\/li>  <li>Programa de limpieza Autom\u00e1tico<\/li>  <li>Recordatorio de descalcificaci\u00f3n Autom\u00e1tico<\/li>  <li><b>OTROS<\/b><\/li>  <li>Apagado autom\u00e1tico programable S\u00ed<\/li>  <li>Bandeja de goteo extra\u00edble S\u00ed<\/li>  <li>Soporte de taza S\u00ed<\/li>  <li>Colores NEGRO<\/li><\/ul><p><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_kru-pae-caf%20arabica%20disp%20bk_1.jpg","wholesale_price":"288.98","unit_price_tax":293.98},"product_model":{"product_data":{"ean13":["0010942223467"],"reference":"EA817010","name":{"1":"Cafetera Expreso Krups Arabica Display\/ 1450W\/ 15 Bares\/ Negra","2":"","3":"","4":""},"description":{"1":"<p><\/p><h2>ARABICA DISPLAY BLACK<\/h2>Lleva la esencia del espresso directamente a tu taza<br>Disfruta de la esencia de un caf\u00e9 espresso de forma f\u00e1cil con la cafetera superautom\u00e1tica Arabica. A pesar de su compacto dise\u00f1o, est\u00e1 dotada de una gran capacidad, lo que la convierte en una cafetera muy pr\u00e1ctica. Es muy f\u00e1cil de usar y contiene los \u00faltimos avances tecnol\u00f3gicos, todo ello para producir unos caf\u00e9s y espressos llenos de sabor directamente a tu taza.<p><\/p><p><\/p><h2>Preparar un caf\u00e9 perfecto nunca fue tan f\u00e1cil<\/h2>Una cafetera sencilla y f\u00e1cil de usar pero dotada de la tecnolog\u00eda m\u00e1s avanzada para brindar el aut\u00e9ntico sabor del caf\u00e9 en su esencia m\u00e1s pura y producir unos espressos y cappuccinos llenos de aroma.<p><\/p><p><\/p><h2>Dise\u00f1o compacto pero de gran capacidad<\/h2>Descubra lo mejor de dos mundos, con toda la comodidad de 