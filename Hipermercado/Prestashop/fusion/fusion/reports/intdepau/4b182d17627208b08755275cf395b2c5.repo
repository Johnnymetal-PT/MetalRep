"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ANIMA","supplier":null,"width":null,"height":null,"depth":null,"weight":2.55,"unit_price":24.4,"unit_price_tax":24.4,"tax_rules_group":null,"category":"Componentes","sub_category":"Cajas - Torres","quantity":5,"brand":"ANIMA","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20anima%20ac4_1.jpg"],"wholesale_price":19.4}}},"4718009155886":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4718009155886",false],"wholesale_price":[28.39,false],"price":[33.39,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 3.4",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90644","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/5d0e922d348e38bf59796119f04d26b6.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Caja Minitorre Anima AC4500 con Fuente 500W","category":"Componentes","sub_category":"Cajas - Torres","unit_price":33.39,"reference":"AC4500","ean13":"4718009155886","weight":"3.4","quantity":0,"brand":"ANIMA","description_pt":"                                                                                                                                                                                                <P><B>Dise\u00f1o<\/B><BR>La AC4500 es una caja compacta MicroATX \/ Mini-ITX de alto rendimiento que ofrece una gran funcionalidad, con una est\u00e9tica minimalista perfecta para cualquier contexto con un frontal de tipo aluminio pulido y un acabado negro profesional. Incluye una fuente de alimentaci\u00f3n de 500W equipada con las mejores prestaciones para una eficiencia \u00f3ptima.<BR><BR><B>Prestaciones<\/B><BR>Cuenta con m\u00faltiples bah\u00edas para un montaje f\u00e1cil y accesible, ofreciendo adem\u00e1s una total conectividad para tus perif\u00e9ricos. Dispone tambi\u00e9n de bah\u00edas \u00f3pticas externas de 5.25\u0094 y 3.5\u0094, y bah\u00edas internas para diferentes combinaciones de discos duros (3 x 2.5\u0094 SSD o 3 x 3.5\u0094 HDD). Adem\u00e1s, ofrece puertos USB 3.0 y 2.0, y conectores para audio y micr\u00f3fono.<BR><BR><B>Refrigeraci\u00f3n<\/B><BR>La AC4500 dispone de un amplio soporte para ventilaci\u00f3n, permiti\u00e9ndote instalar un ventilador frontal de 12cm, otro lateral y uno de 8 cm en la parte trasera.<BR><BR><B>Eficiencia energ\u00e9tica<\/B><BR>Incluye una fuente de alimentaci\u00f3n de 500W equipada con un ventilador TACENS de 12cm ultrasilencioso de 24dB, con un sistema de control t\u00e9rmico inteligente de velocidad y sistema antivibraciones. Generando el m\u00ednimo ruido, cuenta con una eficiencia energ\u00e9tica estable gracias a un sistema de ra\u00edl 12v \u00fanico, garantizando el mejor rendimiento para tu PC.<BR><BR>Especificaciones: <BR><BR><UL><LI>Tipo: Caja Mini Torre<\/LI><LI>Placas: MicroATX \/ Mini-ITX<\/LI><LI>Material: Panel frontal de aluminio pulido con acabado profesional en negro<\/LI><LI>Estructura: Optimizada con m\u00faltiples bah\u00edas para un montaje f\u00e1cil y accesible<\/LI><LI>Conectividad: 1 x USB 3.0 \/ 1 x USB 2.0 \/ Audio y micr\u00f3fono<\/LI><LI>Bah\u00edas Externas: 1 x bah\u00eda \u00f3ptica de 5.25' \/ 1 x 3.5'<\/LI><LI>Bah\u00edas Internas: 3 x 2.5' SSD o 3 x 3.5' HDD<\/LI><LI>Ventilaci\u00f3n: 1 x 12 cm frontal, 1 x 12 cm lateral, 1x 8cm trasero<\/LI><LI>Ranuras de expansi\u00f3n: 4<\/LI><LI>VGA: max 310mm<\/LI><LI>CPU: 155mm<\/LI><LI>Fuente de alimentaci\u00f3n: ATX 500W con ventilador de 12cm (incluida)<\/LI><LI>Conectores: 1 x ATX 20+4 PIN \/ 1x EPS 4+4 PIN \/ 3x SATA \/ 2x PATA <\/LI><LI>Dimensiones: 350 x 315 x 165 mm<\/LI><LI>Peso: 2.8 Kg<\/LI><\/UL><BR><P><\/P>                                                                                                                                                                                ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_tac-caja%20anima%20ac4500_1.jpg","wholesale_price":"28.39","unit_price_tax":33.39},"product_model":{"product_data":{"ean13":["4718009155886"],"reference":"AC4500","name":{"1":"Caja Minitorre Anima AC4500 con Fuente 500W","2":"","3":"","4":""},"description":{"1":"                                                                                                                                                                                                <P><B>Dise\u00f1o<\/B><BR>La AC4500 es una caja compacta MicroATX \/ Mini-ITX de alto rendimiento que ofrece una gran funcionalidad, con una est\u00e9tica minimalista perfecta para cualquier contexto con un frontal de tipo aluminio pulido y un acabado negro profesional. Incluye una fuente de alimentaci\u00f3n de 500W equipada con las mejores prestaciones para una eficiencia \u00f3ptima.<BR><BR><B>Prestaciones<\/B><BR>Cuenta con m\u00faltiples bah\u00edas para un montaje f\u00e1cil y accesible, ofreciendo adem\u00e1s una total conectividad para tus perif\u00e9ricos. Dispone tambi\u00e9n de bah\u00edas \u00f3pticas externas de 5.25\u0094 y 3.5\u0094, y bah\u00edas internas para diferentes combinaciones de discos duros (3 x 2.5\u0094 SSD o 3 x 3.5\u0094 HDD). Adem\u00e1s, ofrece puertos USB 3.0 y 2.0, y conectores para audio y micr\u00f3fono.<BR><BR><B>Refrigeraci\u00f3n<\/B><BR>La AC4500 dispone de un amplio soporte para ventilaci\u00f3n, permiti\u00e9ndote instalar un ventilador frontal de 12cm, otro lateral y uno de 8 cm en la parte trasera.<BR><BR><B>Eficiencia energ\u00e9tica<\/B><BR>Incluye una fuente de alimentaci\u00f3n de 500W equipada con un ventilador TACENS de 12cm ultrasilencioso de 24dB, con un sistema de control t\u00e9rmico inteligente de velocidad y sistema antivibraciones. Generando el m\u00ednimo ruido, cuenta con una eficiencia energ\u00e9tica estable gracias a un sistema de ra\u00edl 12v \u00fanico, garantizando el mejor rendimiento para tu PC.<BR><BR>Especificaciones: <BR><BR><UL><LI>Tipo: Caja Mini Torre<\/LI><LI>Placas: MicroATX \/ Mini-ITX<\/LI><LI>Material: Panel frontal de aluminio pulido con acabado profesional en negro<\/LI><LI>Estructura: Optimizada con m\u00faltiples bah\u00edas para un montaje f\u00e1cil y accesible<\/LI><LI>Conectividad: 1 x USB 3.0 \/ 1 x USB 2.0 \/ Audio y micr\u00f3fono<\/LI><LI>Bah\u00edas Externas: 1 x bah\u00eda \u00f3ptica de 5.25' \/ 1 x 3.5'<\/LI><LI>Bah\u00edas Internas: 3 x 2.5' SSD o 3 x 3.5' HDD<\/LI><LI>Ventilaci\u00f3n: 1 x 12 cm frontal, 1 x 12 cm lateral, 1x 8cm trasero<\/LI><LI>Ranuras de expansi\u00f3n: 4<\/LI><LI>VGA: max 310mm<\/LI><LI>CPU: 155mm<\/LI><LI>Fuente de alimentaci\u00f3n: ATX 500W con ventilador de 12cm (incluida)<\/LI><LI>Conectores: 1 x ATX 20+4 PIN \/ 1x EPS 4+4 PIN \/ 3x SATA \/ 2x PATA <\/LI><LI>Dimensiones: 350 x 315 x 165 mm<\/LI><LI>Peso: 2.8 Kg<\/LI><\/UL><BR><P><\/P>                                                                                                                                                                                ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ANIMA","supplier":null,"width":null,"height":null,"depth":null,"weight":3.4,"unit_price":33.39,"unit_price_tax":33.39,"tax_rules_group":null,"category":"Componentes","sub_category":"Cajas - Torres","quantity":0,"brand":"ANIMA","images":["https:\/\/cdn2.depau.es\/articulos\/800