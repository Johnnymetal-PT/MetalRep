---------------------------"],"result":true},"feed_data":{"name_pt":"Caja de Bol\u00edgrafos de Tinta de Aceite Retr\u00e1ctil Milan P1 Cooper 176583914\/ 54 unidades\/ Colores Surtidos","category":"Escritura","sub_category":"Bol\u00edgrafos","unit_price":30.95,"reference":"176583914 14U","ean13":"8411574083368","weight":"0.57","quantity":2,"brand":"MILAN","description_pt":"<p>Estuche flexible que contiene 4 bol\u00edgrafos P1 serie Copper con el cuerpo del mismo color de la tinta: negro, lila, verde y rosa.&nbsp;<\/p><p><ul><li>Longitud de escritura aproximada de 1200 metros.&nbsp;<\/li><li>Punta 1 mm.&nbsp;<\/li><li>Dise\u00f1o original creado por el departamento de I+D de MILAN.<\/li><li>Medidas bol\u00edgrafo: 14.1 x 1.7 cm. 1 cm \u00d8.&nbsp;<\/li><li>El estuche permite doblar la tapa y disponer los bol\u00edgrafos en un c\u00f3modo expositor de sobremesa.<\/li><\/ul><\/p>","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_mil-boli%20176583914%2014u_1.jpg","wholesale_price":"25.95","unit_price_tax":30.95},"product_model":{"product_data":{"ean13":["8411574083368"],"reference":"176583914 14U","name":{"1":"Caja de Bol\u00edgrafos de Tinta de Aceite Retr\u00e1ctil Milan P1 Cooper 176583914\/ 54 unidades\/ Colores Surtidos","2":"","3":"","4":""},"description":{"1":"<p>Estuche flexible que contiene 4 bol\u00edgrafos P1 serie Copper con el cuerpo del mismo color de la tinta: negro, lila, verde y rosa.&nbsp;<\/p><p><ul><li>Longitud de escritura aproximada de 1200 metros.&nbsp;<\/li><li>Punta 1 mm.&nbsp;<\/li><li>Dise\u00f1o original creado por el departamento de I+D de MILAN.<\/li><li>Medidas bol\u00edgrafo: 14.1 x 1.7 cm. 1 cm \u00d8.&nbsp;<\/li><li>El estuche permite doblar la tapa y disponer los bol\u00edgrafos en un c\u00f3modo expositor de sobremesa.<\/li><\/ul><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"