Hz: 6dBi<\/LI><LI>M\u00e9todo de alimentaci\u00f3n Passive Power over Ethernet (48V), Soporta 802.3af\/803.2at (Rango de Voltaje de 44 a 57VDC)<\/LI><LI>Max. Consumo de energ\u00eda 6,5 W (20W con accesorio optional)<\/LI><LI>Hasta cuatro BSSID por Radio<\/LI><LI>Ahorro de energ\u00eda compatible<\/LI><LI>Seguridad inal\u00e1mbrica WEP, WPA-PSK, WPA-TKIP,<\/LI><LI>WPA2 AES, 802.11i<\/LI><LI>Clientes concurrentes: 200+<\/LI><LI>Certificaciones CE, FCC, IC<\/LI><LI>Montaje para Pared \/ techo (Kit incluido)<\/LI><LI>Temperatura de funcionamiento -10 a 70 \u00b0 C><\/LI><LI>Humedad de funcionamiento 5 - 95% sin condensaci\u00f3n<\/LI><\/UL>                                                                                                                                    ","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"UBIQUITI","supplier":null,"width":null,"height":null,"depth":null,"weight":3,"unit_price":576.14,"unit_price_tax":576.14,"tax_rules_group":null,"category":"Conectividad Profesional","sub_category":"Ubiquiti Productos","quantity":2,"brand":"UBIQUITI","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_ubi-punto%20ac%20uap-ac-pro-5_1.jpg"],"wholesale_price":571.14}}},"0817882029667":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0817882029667",false],"wholesale_price":[149.78,false],"price":[154.78,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.96",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:90706","Cat. IDs: 2","Associated Categ