res actuales como en las de equipos m\u00e1s antiguos.<p><br><ul>  <li><b>Especificaciones<\/b>  <\/li><li>Capacidad<\/li>  <li>500 GB<\/li>  <li>Formato<\/li>  <li>M.2 2280<\/li>  <li>Conector<\/li>  <li>SATA<\/li>  <li>Compatibilidad<\/li>  <li>Windows\u00ae 11, Windows\u00ae 10<\/li>  <li>Rendimiento de lectura secuencial<\/li>  <li>560MB\/s<\/li>  <li>Rendimiento de escritura secuencial<\/li>  <li>510MB\/s<\/li>  <li>Lectura aleatoria<\/li>  <li>90K IOPS<\/li>  <li>Escritura aleatoria<\/li>  <li>82K IOPS<\/li>  <li>Conexi\u00f3n<\/li>  <li>SATA<\/li>  <li>Resistencia (TBW)<\/li>  <li>200<\/li>  <li>Dimensiones (largo, ancho y alto)<\/li>  <li>80mm x 22mm x 2.38mm<\/li>  <li>Peso<\/li>  <li>4.8gms<\/li>  <li>Temperatura de funcionamiento<\/li>  <li>0\u00b0C to 70\u00b0C<\/li>  <li>Non-Operating Temperature<\/li>  <li>-55\u00b0C to 85\u00b0C<\/li>  <li>Certificaciones<\/li>  <li>FCC, UL, TUV, KC, BSMI, VCCI, Morocco<\/li><\/ul><\/p><p><\/p>","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"WESTERN DIGITAL","supplier":null,"width":null,"height":null,"depth":null,"weight":0.04,"unit_price":45.4,"unit_price_tax":45.4,"tax_rules_group":null,"category":"Componentes","sub_category":"Discos Duros SSD","quantity":5,"brand":"WESTERN DIGITAL","images":["https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_wd-ssd%20m2%20sa%20wd%20bl%20sa510%20500_1.jpg"],"wholesale_price":40.4}}},"0718037887319":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0718037887319",false],"wholesale_price":[42.88,false],"price":[47.88,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0.05",false],"images":["Create 1 images",false],"tags":["Product without tags",false],