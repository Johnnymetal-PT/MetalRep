n2.depau.es\/articulos\/800\/800\/fixed\/art_ven-funda%20iodl0-100_1.jpg"],"wholesale_price":2.37}}},"8710103795766":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8710103795766",false],"wholesale_price":[20.32,false],"price":[27.32,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0.31",false],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:246991","Cat. IDs: 2","Associated Categories","Cat. Default: 2","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ada0a9692e1d904d0e6889c505adac07.jpg; <br>-------------------------------"],"result":true},"feed_data":{"name_pt":"Cortapelos Multigroom Series 3000 Philips MG3710 con Bater\u00eda\/ 6 Accesorios","category":"Cuidado Personal","sub_category":"Cortapelos","unit_price":27.32,"reference":"MG3710\/15","ean13":"8710103795766","weight":"0.31","quantity":5,"brand":"PHILIPS","description_pt":"                                                <p><h2>Multigroom series 3000<\/h2><p>Cara 6 en 1<\/p><h2>Recortador 6 en 1<\/h2><ul><li>Cuchillas de acero templado que no se rompen, desafilan ni oxidan<\/li><li>Recorta y da forma a tu cara con las 6 herramientas<\/li><li>Recorta los bordes de la barba y el cuello para completar tu look<\/li><li>Mantiene el pelo de la nariz y las orejas a raya<\/li><li>4 peines-gu\u00eda para recortar la cara<\/li><\/ul><h2>Recortador todo en uno<\/h2><p>Pruebe un nuevo look, cualquier d\u00eda de la semana, con esta recortadora todo en uno duradera. 6 herramientas de calidad le permiten crear f\u00e1cilmente el estilo facial exacto que desea.<\/p><h2>Cuchillas de acero templado que no se rompen, desafilan ni oxidan<\/h2><p>Las cuchillas autoafilables de acero de este recortador para la cara y el cuerpo est\u00e1n reforzadas con hierro y templadas para ofrecer la m\u00e1xima resistencia. El resultado es que las cuchillas permanecen tan afiladas como el primer d\u00eda. No se oxidan ni necesitan lubricante.<\/p><h2>Recorta y da forma a tu cara con las 6 herramientas<\/h2><p>Este recortador todo en uno recorta y da forma c\u00f3modamente al pelo de la cara.<\/p><h2>Recorta los bordes de la barba y el cuello para completar tu look<\/h2><p>Utiliza el recortador con un peine-gu\u00eda para obtener l\u00edneas limpias y definidas alrededor de los bordes de la barba y el cuello. Las cuchillas autoafilables del recortador permanecen afiladas como el primer d\u00eda despu\u00e9s de 3 a\u00f1os de uso.<\/p><h2>Mantiene el pelo de la nariz y las orejas a raya<\/h2><p>Evita los rasgu\u00f1os y cortes, ya que el recortador todo en uno elimina r\u00e1pidamente el vello no deseado de la nariz y las orejas.<\/p><h2>4 peines-gu\u00eda para recortar la cara<\/h2><p>2 peines-gu\u00eda para barba (1 y 2 mm) y 2 peines-gu\u00eda para barba de 2 d\u00edas (3 y 5 mm).<\/p><h2>60 minutos de autonom\u00eda<\/h2><p>Este recortador de Philips te proporciona hasta 60 minutos de uso sin cable con una sola carga de 16 horas.<\/p><h2>Accesorios f\u00e1ciles de mantener<\/h2><p>El recortador para la cara y el cuerpo es f\u00e1cil de mantener, con cuchillas no corrosivas y protectores resistentes al agua para una limpieza sencilla.<\/p><h2>Gu\u00e1rdalo y mantenlo organizado<\/h2><p>Ordena el ba\u00f1o y la bolsa del gimnasio, y guarda todos tus accesorios en un solo lugar con una peque\u00f1a funda que te permite organizar y viajar con facilidad.<\/p><h2>Especificaciones t\u00e9cnicas<\/h2><ul><li><strong>Crea el peinado que desees<\/strong><\/li><li>N\u00famero de herramientas<\/li><li>6 herramientas<\/li><li>Herramientas de estilo<\/li><li>Recortador<\/li><li>Recortador para nariz y orejas<\/li><li>2 peines-gu\u00eda para la barba<\/li><li>2 peines-gu\u00eda para barba corta<\/li><li>estilo facial<\/li><li>Barba larga<\/li><li>Barba corta<\/li><li>Barba de tres d\u00edas<\/li><li>L\u00edneas definidas<\/li><li>Estilo definido<\/li><li>Perilla<\/li><li><strong>Accesorios<\/strong><\/li><li>Funda<\/li><li>Funda de viaje<\/li><li>Mantenimiento<\/li><li>Cepillo de limpieza<\/li><li><strong>Potencia<\/strong><\/li><li>Tiempo de funcionamiento<\/li><li>60 minutos<\/li><li>Voltaje autom\u00e1tico<\/li><li>100-240 voltios<\/li><li>Tipo de bater\u00eda<\/li><li>NiMH<\/li><li>Carga<\/li><li>Carga completa en 16 horas<\/li><li>Modo de apagado (sin accesorios)<\/li><li>< 0,1 W<\/li><li>Modo de bajo consumo<\/li><li>< 0,3 W<\/li><li><strong>Sistema de corte<\/strong><\/li><li>Cuchillas autoafilables<\/li><li>S\u00ed<\/li><li><strong>F\u00e1cil de usar<\/strong><\/li><li>Limpieza<\/li><li>Accesorios enjuagables<\/li><li>No necesita mantenimiento<\/li><li>Sin necesidad de aceite<\/li><\/ul><\/p>                                            ","images":"https:\/\/cdn2.depau.es\/articulos\/800\/800\/fixed\/art_phpae-cor%20mg%20s3000%20mg3710%20v2_1.jpg","wholesale_price":"20.32","unit_price_tax":27.32},"product_model":{"product_data":{"ean13":["8710103795766"],"reference":"MG3710\/15","name":{"1":"Cortapelos Multigroom Series 3000 Philips MG3710 con Bater\u00eda\/ 6 Accesorios","2":"","3":"","4":""},"description":{"1":"                                                <p><h2>Multigroom series 3000<\/h2><p>Cara 6 en 1<\/p><h2>Recortador 6 en 1<\/h2><ul><li>Cuchillas de acero templado que no se rompen, desafilan ni oxidan<\/li><li>Recorta y da forma a tu cara con las 6 herramientas<\/li><li>Recorta los bordes de la barba y el cuello para completar tu look<\/li><li>Mantiene el pelo de la nariz y las orejas a raya<\/li><li>4 peines-gu\u00eda para recortar la cara<\/li><\/ul><h2>Recortador todo en uno<\/h2><p>Pruebe un nuevo look, cualquier d\u00eda de la semana, con esta recortadora todo en uno duradera. 6 herramientas de calidad le permiten crear f\u00e1cilmente el estilo facial exacto que desea.<\/p><h2>Cuchillas de acero templado que no se rompen, desafilan ni oxidan<\/h2><p>Las cuchillas autoafilables de acero de este recortador para la cara y el cuerpo est\u00e1n reforzadas con hierro y templadas para ofrecer la m\u00e1xima resistencia. El resultado es que las cuchillas permanecen tan afiladas como el primer d\u00eda. No se oxidan ni necesitan lubricante.<\/p><h2>Recorta y da forma a tu cara con las 6 herramientas<\/h2><p>Este recortador todo en uno recorta y da forma c\u00f3modamente al pelo de la cara.<\/p><h2>Recorta los bordes de la barba y el cuello para completar tu look<\/h2><p>Utiliza el recortador con un peine-gu\u00eda para obtener l\u00edneas limpias y definidas alrededor de los bordes de la barba y el cuello. Las cuchillas autoafilables del recortador permanecen afiladas como el primer d\u00eda despu\u00e9s de 3 a\u00f1os de uso.<\/p><h2>Mantiene el pelo de la nariz y las orejas a raya<\/h2><p>Evita los rasgu\u00f1os y cortes, ya que el recortador todo en uno elimina r\u00e1pidamente el vello no deseado de la nariz y las orejas.<\/p><h2>4 peines-gu\u00eda para recortar la cara<\/h2><p>2 peines-gu\u00eda para barba (1 y 2 mm) y 2 peines-gu\u00eda para barba de 2 d\u00edas (3 y 5 mm).<\/p><h2>60 minutos de autonom\u00eda<\/h2><p>Este recortador de Philips te proporciona hasta 60 minutos de uso sin cable con una sola carga de 16 horas.<\/p><h2>Accesorios f\u00e1ciles de mantener<\/h2><p>El recortador para la cara y el cuerpo es f\u00e1cil de mantener, con cuchillas no corrosivas y protectores resistentes al agua para una limpieza sencilla.<\/p><h2>Gu\u00e1rdalo y mantenlo organizado<\/h2><p>Ordena el ba\u00f1o y la bolsa del gimnasio, y guarda todos tus accesorios en un solo lugar con una peque\u00f1a funda que te permite organizar y viajar con facilidad.<\/p><h2>Especificaciones t\u00e9cnicas<\/h2><ul><li><strong>Crea el peinado que desees<\/strong><\/li><li>N\u00famero de herramientas<\/li><li>6 herramientas<\/li><li>Herramientas