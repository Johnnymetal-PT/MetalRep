m-negra.png","wholesale_price":"10.18","unit_price_tax":20.18},"product_model":{"product_data":{"ean13":["4719331550714"],"reference":"GA90154192","name":{"1":"ALFOMBRILLA GAMING GIGABYTE AMP-900 900X360X3 MM NEGRA","2":"","3":"","4":""},"description":{"1":"Gigabyte AMP900","2":"","3":"","4":""},"description_short":{"1":"Gigabyte AMP900","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Gigabyte","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":20.18,"unit_price_tax":20.18,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Gigabyte","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/204\/78382\/48531495\/bg\/alfombrilla-gaming-gigabyte-amp-900-900x360x3-mm-negra.png"],"wholesale_price":10.18}}},"8714574646909":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8714574646909",false],"wholesale_price":[132.67,false],"price":[142.67,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:193705","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8d8a1bb6371b682d75584bf67032cc4c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"IM42108485","unit_price":142.67,"category":"Impresoras","brand":"Canon","name_pt":"IMPRESORA CANON MAXIFY MB5150  GARANTIA 3AN","quantity":0,"ean13":"8714574646909","description_short_pt":"24\/15.5 ipm, A4, 600 x 1200 dpi, ADF, 2x CIS, 33.6kbps, 463 x 394 x 291 mm, 11.4 kg","description_pt":"Un multifunci\u00f3n de inyecci\u00f3n de tinta en color, con impresora, esc\u00e1ner, copiadora y fax, para uso intensivo, y compatibilidad para dispositivos m\u00f3viles y servicios en la nube, r\u00e1pida velocidad de impresi\u00f3n de 24 ipm en blanco y negro, y f\u00e1cil integraci\u00f3n de red.Descripci\u00f3n general- R\u00e1pida productividad a 24 ipm en blanco y negro, 15,5 ipm en color- Impresi\u00f3n inal\u00e1mbrica para smartphones y tablets- Conectividad con la nube: escaneo a la nube o a correo electr\u00f3nico- Altos rendimientos de tinta: 2.500 p\u00e1ginas en blanco y negro\/1.500 en color- Gran capacidad de 250 hojas y D-ADF de 50 hojasOficina peque\u00f1a, enorme productividadUna impresora, esc\u00e1ner, copiadora y fax totalmente equipado y dise\u00f1ado para oficinas peque\u00f1as que necesitan una magn\u00edfica calidad de impresi\u00f3n en blanco y negro y en color sin dejar de tener un funcionamiento econ\u00f3mico. Las tintas de pigmento DRHD resistentes a los marcadores y la fricci\u00f3n producen negros intensos, colores profundos y texto n\u00edtido. La MAXIFY serie MB5150 de Canon imprime en A4 a una velocidad ultrarr\u00e1pida de 24 ipm en blanco y negro y 15,5 ipm en color, adem\u00e1s de tener un tiempo de salida de la primera p\u00e1gina (FPOT) de solo 6 segundos, mientras que el escaneo a doble cara de una sola pasada permite escanear m\u00e1s r\u00e1pido que nunca. Excelente rentabilidad de impresi\u00f3nDesde su bajo consumo de energ\u00eda de solo 0 kWh (TEC) hasta los cartuchos de color sustituibles individualmente, el aspecto econ\u00f3mico es una prioridad. Los cartuchos negros proporcionan un rendimiento ISO de 2.500 p\u00e1ginas y los cartuchos en color de 1.500 p\u00e1ginas, lo que permite a la oficina trabajar con menos interrupciones. El multipack de 4 colores opcional ofrece una impresi\u00f3n a\u00fan m\u00e1s rentable.Mayor productividad y facilidad de usoImprimir, copiar, escanear y enviar faxes es muy f\u00e1cil con la gran pantalla t\u00e1ctil TFT en color de 8,8 cm (3,5?) y la interfaz de usuario mejorada de la MAXIFY serie MB5150 de Canon. Adem\u00e1s del cassette de gran capacidad de 250 hojas y del alimentador autom\u00e1tico de documentos de 50 hojas, la impresi\u00f3n a doble cara y la compatibilidad con una amplia variedad de tama\u00f1os y tipos de papel (desde papel normal A4 hasta etiquetas, sobres, papel fotogr\u00e1fico e incluso copia de carn\u00e9 de identidad a doble cara) de la impresora hacen que las tareas de impresi\u00f3n habituales de la oficina resulten sencillas.Preparado para dispositivos m\u00f3viles, preparado para la nube, preparado para trabajarLa compatibilidad con Google Cloud Print, Apple AirPrint (iOS), Mopria y la aplicaci\u00f3n Canon PRINT ofrece una impresi\u00f3n y escaneo r\u00e1pidos y sencillos desde dispositivos m\u00f3viles. Puedes imprimir desde la nube e incluso escanear y guardar documentos en conocidos servicios en la nube, incluidos Google Drive, Dropbox, Evernote, OneNote, OneDrive y Concur. El modo Punto de acceso supone que los usuarios de dispositivos m\u00f3viles pueden conectarse a la impresora sin una red Wi-Fi externa.Capacidades de supervisi\u00f3n y mantenimiento completasEl filtrado de direcciones IP supone que solo un n\u00famero determinado de usuarios puede obtener acceso, mientras que la compatibilidad con correo electr\u00f3nico SMTP permite escanear a correo electr\u00f3nico de forma segura. Los administradores de sistemas pueden configurar la impresora y restringir ciertas operaciones, como el escaneo a USB, de forma r\u00e1pida y sencilla.Integraci\u00f3n sin esfuerzo en la redLa compatibilidad con el Protocolo simple de administraci\u00f3n de red (SNMP) facilita la integraci\u00f3n de la impresora en una red de oficina existente. El est\u00e1ndar SNMP habilita una amplia gama de funciones de supervisi\u00f3n y mantenimiento, incluidos los niveles de tinta, estados de error y contador de p\u00e1ginas.","images":"https:\/\/www.dmi.es\/photo\/304\/27159\/19573135\/bg\/impresora-canon-maxify-mb5150--garantia-3an.jpg","wholesale_price":"132.67","unit_price_tax":142.67},"product_model":{"product_data":{"ean13":["8714574646909"],"reference":"IM42108485","name":{"1":"IMPRESORA CANON MAXIFY MB5150  GARANTIA 3AN","2":"","3":"","4":""},"description":{"1":"Un multifunci\u00f3n de inyecci\u00f3n de tinta en color, con impresora, esc\u00e1ner, copiadora y fax, para uso intensivo, y compatibilidad para dispositivos m\u00f3viles y servicios en la nube, r\u00e1pida velocidad de impresi\u00f3n de 24 ipm en blanco y negro, y f\u00e1cil integraci\u00f3n de red.Descripci\u00f3n general- R\u00e1pida productividad a 24 ipm en blanco y negro, 15,5 ipm en color- Impresi\u00f3n inal\u00e1mbrica para smartphones y tablets- Conectividad con la nube: escaneo a la nube o a correo electr\u00f3nico- Altos rendimientos de tinta: 2.500 p\u00e1ginas en blanco y negro\/1.500 en color- Gran capacidad de 250 hojas y D-ADF de 50 hojasOficina peque\u00f1a, enorme productividadUna impresora, esc\u00e1ner, copiadora y fax totalmente equipado y dise\u00f1ado para oficinas peque\u00f1as que necesitan una magn\u00edfica calidad de impresi\u00f3n en blanco y negro y en color sin dejar de tener un funcionamiento econ\u00f3mico. Las tintas de pigmento DRHD resistentes a los marcadores y la fricci\u00f3n producen negros intensos, colores profundos y texto n\u00edtido. La MAXIFY serie MB5150 de Canon imprime en A4 a una velocidad ultrarr\u00e1pida de 24 ipm en blanco y negro y 15,5 ipm en color, adem\u00e1s de tener un tiempo de salida de la primera p\u00e1gina (FPOT) de solo 6 segundos, mientras que el escaneo a doble cara de una sola pasada permite escanear m\u00e1s r\u00e1pido que nunca. Excelente rentabilidad de impresi\u00f3nDesde su bajo consumo de energ\u00eda de solo 0 kWh (TEC) hasta los cartuchos de color sustituibles individualmente, el aspecto econ\u00f3mico es una prioridad. Los cartuchos negros proporcionan un rendimiento ISO de 2.500 p\u00e1ginas y los cartuchos en color de 1.500 p\u00e1ginas, lo que permite a la oficina trabajar con menos interrupciones. El multipack de 4 colores opcional ofrece una impresi\u00f3n a\u00fan m\u00e1s rentable.Mayor productividad y facilidad de usoImprimir, copiar, escanear y enviar faxes es muy f\u00e1cil con la gran pantalla t\u00e1ctil TFT en color de 8,8 cm (3,5?) y la interfaz de usuario mejorada de la MAXIFY serie MB5150 de Canon. Adem\u00e1s del cassette de gran capacidad de 250 hojas y del alimentador autom\u00e1tico de documentos de 50 hojas, la impresi\u00f3n a doble cara y la compatibilidad con una amplia variedad de tama\u00f1os y tipos de papel (desde papel normal A4 hasta etiquetas, sobres, papel fotogr\u00e1fico e incluso copia de carn\u00e9 de identidad a doble cara) de la impresora hacen que las tareas de impresi\u00f3n habituales de la oficina resulten sencillas.Preparado para dispositivos m\u00f3viles, preparado para la nube, preparado para trabajarLa compatibilidad con Google Cloud Print, Apple AirPrint (iOS), Mopria y la aplicaci\u00f3n Canon PRINT ofrece una impresi\u00f3n y escaneo r\u00e1pidos y sencillos desde dispositivos m\u00f3viles. Puedes imprimir desde la nube e incluso escanear y guardar documentos en conocidos servicios en la nube, incluidos Google Drive, Dropbox, Evernote, OneNote, OneDrive y Concur. El modo Punto de acceso supone que los usuarios de dispositivos m\u00f3viles pueden conectarse a la impresora sin una red Wi-Fi externa.Capacidades de supervisi\u00f3n y mantenimiento completasEl filtrado de direcciones IP supone que solo un n\u00famero determinado de usuarios puede obtener acceso, mientras que la compatibilidad con correo electr\u00f3nico SMTP permite escanear a correo electr\u00f3nico de forma segura. Los administradores de sistemas pueden configurar la impresora y restringir ciertas operaciones, como el escaneo a USB, de forma r\u00e1pida y sencilla.Integraci\u00f3n sin