lert":true,"report":{"notes":{"product":["",false],"ean13":["8435484041447",false],"wholesale_price":[19.09,false],"price":[22.5318,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188346","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ef391a3e81f59a735d531e1c17ec6b27.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO12330015","unit_price":22.5318,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"BASCULA DE COCINA CECOTEC COOK CONTROL 10300 ECOPOWER NUTRITION","quantity":5,"ean13":"8435484041447","description_short_pt":"LCD, 1 gr - 8 kg, tare","description_pt":"Gira la rueda y \u00a1olv\u00eddate de las pilas!Gracias al pulsador EcoPower olv\u00eddate de cambiar pilas. Basta con girar la rueda para crear energ\u00eda cin\u00e9tica, que se transforma en energ\u00eda el\u00e9ctrica de forma simple y autom\u00e1tica, consiguiendo una b\u00e1scula ecol\u00f3gica y m\u00e1s respetuosa con el medioambiente.Funci\u00f3n conteo de KcalDispone de una pr\u00e1ctica funci\u00f3n de conteo de Kcal para 7 tipos de alimentos predefinidos tales como pollo, mantequilla, az\u00facar, harina, huevos, chocolate y ternera. Esta funci\u00f3n ayuda a saber cu\u00e1ntas calor\u00edas tiene el alimento, adem\u00e1s de saber el peso.Gran precisi\u00f3nSoporta un peso m\u00e1ximo de hasta 8 kg e incorpora 4 sensores de alta precisi\u00f3n. Adem\u00e1s, presenta una sensibilidad de 1 g de graduaci\u00f3n para que las medidas sean extremadamente exactas.ResistenteEl dise\u00f1o de acero inoxidable de alta calidad hace que se adapte a cualquier estilo de cocina y facilita la limpieza y una correcta higienizaci\u00f3n.M\u00e1xima facilidad de lecturaLa b\u00e1scula incorpora una gran pantalla digital LCD facilitando la lectura de todas las mediciones.F\u00e1cil usabilidadGracias al sistema de energ\u00eda que dispone, no es necesario usar pilas por lo que siempre est\u00e1 lista para usar, adem\u00e1s su dise\u00f1o facilita el almacenaje y la limpieza.Funci\u00f3n TaraGracias a la funci\u00f3n Tara, tomar medidas a\u00f1adiendo ingredientes es simple y sencillo, lo que te hace olvidarte de usar varios recipientes.","images":"https:\/\/www.dmi.es\/photo\/1426\/102292\/83558756\/bg\/bascula-de-cocina-cecotec-cook-control-10300-ecopower-nutrition.jpg","wholesale_price":"19.09","unit_price_tax":22.5318},"product_model":{"product_data":{"ean13":["8435484041447"],"reference":"CO12330015","name":{"1":"BASCULA DE COCINA CECOTEC COOK CONTROL 10300 ECOPOWER NUTRITION","2":"","3":"","4":""},"description":{"1":"Gira la rueda y \u00a1olv\u00eddate de las pilas!Gracias al pulsador EcoPower olv\u00eddate de cambiar pilas. Basta con girar la rueda para crear energ\u00eda cin\u00e9tica, que se transforma en energ\u00eda el\u00e9ctrica de forma simple y autom\u00e1tica, consiguiendo una b\u00e1scula ecol\u00f3gica y m\u00e1s respetuosa con el medioambiente.Funci\u00f3n conteo de KcalDispone de una pr\u00e1ctica funci\u00f3n de conteo de Kcal para 7 tipos de alimentos predefinidos tales como pollo, mantequilla, az\u00facar, harina, huevos, chocolate y ternera. Esta funci\u00f3n ayuda a saber cu\u00e1ntas calor\u00edas tiene el alimento, adem\u00e1s de saber el peso.Gran precisi\u00f3nSoporta un peso m\u00e1ximo de hasta 8 kg e incorpora 4 sensores de alta precisi\u00f3n. Adem\u00e1s, presenta una sensibilidad de 1 g de graduaci\u00f3n para que las medidas sean extremadamente exactas.ResistenteEl dise\u00f1o de acero inoxidable de alta calidad hace que se adapte a cualquier estilo de cocina y facilita la limpieza y una correcta higi