62,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190134","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cb3d24cc2ce42e38799826426c603b15.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO10330033","unit_price":82.62,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"FREIDORA CECOTEC DIETETICA CECOFRY ADVANCE PRECISION","quantity":0,"ean13":"8435484032148","description_short_pt":"Cecofry Advance Precision 5.5 L, 1700 W","description_pt":"COCINA CON UNA SOLA CUCHARADA DE ACEITETus platos ser\u00e1n irresistibles y saludables. La freidora cocina con menos aceite, respetando al m\u00e1ximo las propiedades de los alimentos para que disfrutes de grandes sabores de la forma m\u00e1s saludable.COCINA GRANDES RECETASOlv\u00eddate de cocinar por tandas. Gracias a su capacidad de 5,5 L podr\u00e1s cocinar una gran variedad de recetas para el disfrute de varios comensales. Prepara hasta 600 g de una sola vez y disfruta de grandes opciones en la cocina.RECETAS IRRESISTIBLES SIN ESPERASLa comida r\u00e1pida ahora tambi\u00e9n es saludable. Con su potencia de 1700 W podr\u00e1s cocinar una gran variedad de alimentos de la forma m\u00e1s r\u00e1pida y sencilla.TECNOLOG\u00cdA AVANZADA DE AIRE CALIENTECon la tecnolog\u00eda PerfectCook de aire caliente tus recetas saldr\u00e1n siempre perfectas, tiernas por dentro y crujientes por fuera. Disfruta de cada receta de la forma m\u00e1s sencilla y saludable.CONTROLA TUS RECETAS CON UN SIMPLE TOQUELa freidora cuenta con un dise\u00f1o moderno y compacto con un panel de control t\u00e1ctil multifunci\u00f3n para un control f\u00e1cil e intuitivo.8 MODOS PRECONFIGURADOSOlv\u00eddate de controlar tiempo y temperaturas, la freidora lo hace por ti. Escoge uno de sus 8 modos preconfigurados seg\u00fan la receta que quieras preparar y la freidora har\u00e1 el resto.TEMPERATURA A MEDIDA PARA RECETAS PERFECTASCon la freidora diet\u00e9tica podr\u00e1s hacer infinidad de elaboraciones y, para adaptarla a cada una de ellas, solo tendr\u00e1s que programar la temperatura de 80 a 200 grados. Fija los ajustes y disfruta con cada receta.B\u00c1SCULA INTEGRADACada gramo cuenta. La freidora cuenta con una b\u00e1scula con un peso m\u00e1ximo de hasta 3 kg con 2 sensores de alta precisi\u00f3n para resultados perfectos y a medida.","images":"https:\/\/www.dmi.es\/photo\/1319\/92594\/68069575\/bg\/freidora-cecotec-dietetica-cecofry-advance-precision.jpg","wholesale_price":"78.00","unit_price_tax":82.62},"product_model":{"product_data":{"ean13":["8435484032148"],"reference":"CO10330033","name":{"1":"FREIDORA CECOTEC DIETETICA CECOFRY ADVANCE PRECISION","2":"","3":"","4":""},"description":{"1":"COCINA CON UNA SOLA CUCHARADA DE ACEITETus platos ser\u00e1n irresistibles y saludables. La freidora cocina con menos aceite, respetando al m\u00e1ximo las propiedades de los alimentos para que disfrutes de grandes sabores de la forma m\u00e1s saludable.COCINA GRANDES RECETASOlv\u00eddate de cocinar por tandas. Gracias a su capacidad de 5,5 L podr\u00e1s cocinar una gran variedad de recetas para el disfrute de varios comensales. Prepara hasta 600 g de una sola vez y disfruta de grandes opciones en la cocina.RECETAS IRRESISTIBLES SIN ESPERASLa comida r\u00e1pida ahora tambi\u00e9n es saludable. Con su potencia de 1700 W podr\u00e1s cocinar una gran variedad de alimentos de la forma m\u00e1s r\u00e1pida y sencilla.TECNOLOG\u00cdA AVANZADA DE AIRE CALIENTECon la tecnolog\u00eda PerfectCook de aire caliente tus recetas saldr\u00e1n siempre perfectas, tiernas por dentro y crujientes por fuera. Disfruta de cada receta de la forma m\u00e1s sencilla y saludable.CONTROLA TUS RECETAS CON UN SIMPLE TOQUELa freidora cuenta con un dise\u00f1o moderno y compacto con un panel de control t\u00e1ctil multifunci\u00f3n para un control f\u00e1cil e intuitivo.8 MODOS PRECONFIGURADOSOlv\u00eddate de controlar tiempo y temperaturas, la freidora lo hace por ti. Escoge uno de sus 8 modos preconfigurados seg\u00fan la receta que quieras preparar y la freidora har\u00e1 el resto.TEMPERATURA A MEDIDA PARA RECETAS PERFECTASCon la freidora diet\u00e9tica podr\u00e1s hacer infinidad de elaboraciones y, para adaptarla a cada una de ellas, solo tendr\u00e1s que programar la temperatura de 80 a 200 grados. Fija los ajustes y disfruta con cada receta.B\u00c1SCULA INTEGRADACada gramo cuenta. La freidora cuenta con una b\u00e1scula con un peso m\u00e1ximo de hasta 3 kg con 2 sensores de alta precisi\u00f3n para resultados perfectos y a medida.","2":"","3":"","4":""},"description_short":{"1":"Cecofry Advance Precision 5.5 L, 1700 W","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":82.62,"unit_price_tax":82.62,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1319\/92594\/68069575\/bg\/freidora-cecotec-dietetica-cecofry-advance-precision.jpg"],"wholesale_price":78}}},"8435484033183":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484033183",false],"wholesale_price":[60.9,false],"price":[65.178,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",fal