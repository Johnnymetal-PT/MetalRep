, 7,11 cm (2.8\"), Bluetooth, 1600 mAh, Negro, Blanco","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Doro","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":103.275,"unit_price_tax":103.275,"tax_rules_group":null,"category":"Telefon\u00eda","brand":"Doro","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/119\/77580\/59229552\/bg\/telefono-movil-senior-doro-780x-2-8--512mb-4gb-blanco-negro.jpg"],"wholesale_price":98.25}}},"8437012429574":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8437012429574",false],"wholesale_price":[14.47,false],"price":[17.8194,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185131","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0a397cc64a04afec49731646056bc868.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CN48231072","unit_price":17.8194,"category":"Adaptadores y Convertidores","brand":"CoolBox","name_pt":"HUB USB COOLBOX USB 7 PUERTOS (4 USB3.0) CON ALIMENTACION","quantity":0,"ean13":"8437012429574","description_short_pt":"Hub 4x USB 3.0\/3x USB 2.0 Puertos, Negro","description_pt":"Hub USB (distribuidor o concentrador de puertos USB), un dispositivo que permite concentrar varios puertos USB en uno s\u00f3lo lo que amplia enormemente las posibilidades de conexi\u00f3n de nuestro ordenador. Ideal para ordenadores con menos puertos USB de los requeridos, usuarios con muchas necesidades de conexi\u00f3n de dispositivos USB de forma simult\u00e1nea, o que prefieren no estar conectando y desconectando dispositivos.Este modelo dispone de 7 puertos, cuatro de ellos USB 3.0. Es un completo multiplexor ya que incorpora interruptores para seleccionar o deshabilitar cada uno de los puertos (para una mejor gesti\u00f3n de los dispositivos USB y su alimentaci\u00f3n). ?Bus-powered?: toma la energ\u00eda del bus USB (del ordenador), pero si necesitamos m\u00e1s energ\u00eda, si utilizamos todos los puertos disponibles, o el dispositivo USB conectado requiere m\u00e1salimentaci\u00f3n, tambi\u00e9n dispone de alimentaci\u00f3n externa (funcionar\u00e1 con cualquier dispositivo que puedas conectar en el futuro). Otras de sus ventajas es que el adaptador de alimentaci\u00f3n externo incorporado se puede utilizar de forma independiente para recarga de tablets y smartphones (Apple, Samsung, etc.) gracias a sus dos puertos USB 2.0.","images":"https:\/\/www.dmi.es\/photo\/243\/96155\/15669193\/bg\/hub-usb-coolbox-usb-7-puertos--4-usb3-0--con-alimentacion.jpg","wholesale_price":"14.47","unit_price_tax":17.8194},"product_model":{"product_data":{"ean13":["8437012429574"],"reference":"CN48231072","name":{"1":"HUB USB COOLBOX USB 7 PUERTOS (4 USB3.0) CON ALIMENTACION","2":"","3":"","4":""},"description":{"1":"Hub USB (distribuidor o concentrador de puertos USB), un dispositivo que permite concentrar varios puertos USB en uno s\u00f3lo lo que amplia enormemente las posibilidades de conexi\u00f3n de nuestro ordenador. Ideal para ordenadores con menos puertos USB de los requeridos, usuarios con muchas necesidades de conexi\u00f3n de dispositivos USB de forma simult\u00e1nea, o que prefieren no estar conectando y desconectando dispositivos.Este modelo dispone de 7 puertos, cuatro de ellos USB 3.0. Es un completo multiplexor ya que incorpora interruptores para seleccionar o deshabilitar cada uno de los puertos (para una mejor gesti\u00f3n de los dispositivos USB y su alimentaci\u00f3n). ?Bus-powered?: toma la energ\u00eda del bus USB (del ordenador), pero si necesitamos m\u00e1s energ\u00eda, si utilizamos todos los puertos disponibles, o el dispositivo USB conectado requiere m\u00e1salimentaci\u00f3n, tambi\u00e9n dispone de alimentaci\u00f3n externa (funcionar\u00e1 con cualquier dispositivo que puedas conectar en el futuro). Otras de sus ventajas es que el adaptador de alimentaci\u00f3n externo incorporado se puede utilizar de forma independiente para recarga de tablets y smartphones (Apple, Samsung, etc.) gracias a sus dos puertos USB 2.0.","2":"","3":"","4":""},"description_short":{"1":"Hub 4x USB 3.0\/3x USB 2.0 Puertos, Negro","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"CoolBox","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":17.8194,"unit_price_tax":17.8194,"tax_rules_group":null,"category":"Adaptadores y Convertidores","brand":"CoolBox","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/243\/96155\/15669193\/bg\/hub-usb-coolbox-usb-7-puertos--4-usb3-0--con-alimentacion.jpg"],"wholesale_price":14.47}}},"0810354022586":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0810354022586",false],"wholesale_price":[127.34,false],"price":[132.9468,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185132","Cat. IDs: 193","Associated Categories","Cat. Default: 193","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0e3b56243fbfaf2562