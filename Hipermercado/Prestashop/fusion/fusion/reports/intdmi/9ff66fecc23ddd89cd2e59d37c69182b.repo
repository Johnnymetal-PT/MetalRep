alse],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188284","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/4f44b841e0cb49f5abec408ad1702216.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"IM7336047","unit_price":255.62220000000002,"category":"Impresoras","brand":"Epson","name_pt":"IMPRESORA EPSON TM-M30 TICKET ETHERNET BLUETOOTH  NEGRA","quantity":0,"ean13":"8715946605821","description_short_pt":"Themal Line, 200 mm\/sec, 203 DPI x 203 DPI, Ethernet, Bluetooth, USB 2.0 Type B, USB 2.0 Type A","description_pt":"La puerta de entrada a la impresi\u00f3n en puntos de venta basados en tabletEsta compacta impresora de recibos es perfecta para entornos de punto de venta con tablet como la hosteler\u00eda o los comercios especializados. Disponible tanto en negro como en blanco, es perfecta para clientes con poco espacio en el mostrador gracias a su reducido tama\u00f1o.Con un dise\u00f1o elegante y una funcionalidad inteligente, es la soluci\u00f3n ideal para clientes que deseen cambiarse a un sistema de punto de venta gestionado con tablet, incluidos quienes utilizan actualmente puntos de venta basados en ordenadores.Amplia conectividadSolo tienes que aproximar un dispositivo m\u00f3vil equipado con NFC o una tablet a la impresora TM-m30 para conectarlos y empezar a imprimir. En el caso de los equipos m\u00f3viles que no sean compatibles con NFC, la conexi\u00f3n con la impresora es muy f\u00e1cil mediante el escaneado de un c\u00f3digo QR exclusivo.Integraci\u00f3n inteligenteEl kit de desarrollo de software de impresi\u00f3n ePOS1 permite la impresi\u00f3n directa en CUALQUIER dispositivo m\u00f3vil sin necesidad de instalar ni actualizar drivers. Est\u00e1 disponible para dispositivos iOS y Android.Con interfaces Ethernet, Bluetooth o Wi-Fi, esta impresora puede incorporarse pr\u00e1cticamente a cualquier entorno de trabajo. Las versiones est\u00e1n disponibles solo con Ethernet, con Ethernet y Bluetooth, o con Ethernet y Wi-Fi, lo que permite la conectividad doble en algunos modelos.Flexible y adaptableLa impresora TM-m30 es muy elegante, por lo que es perfecta para cualquier entorno.Acceso frontal Acceso superiorSu dise\u00f1o compacto significa que es una de las impresoras est\u00e1ticas de punto de venta m\u00e1s peque\u00f1as del mundo2 y hace que sea ideal para colocarla en cualquier sitio. Puede instalarse tanto en horizontal como en vertical, para lo cual solo hay que cambiar sus dos cubiertas, lo que proporciona todav\u00eda m\u00e1s flexibilidad en la ubicaci\u00f3n de la impresora en mostrador. Esto facilita el acceso superior y frontal.Alta calidadLa impresora TM-m30 imprime recibos en m\u00faltiples escalas de grises, con funciones avanzadas de impresi\u00f3n de gr\u00e1ficos y c\u00f3digos de barras que permiten dise\u00f1os de recibos altamente personalizados, incluidos logotipos y mensajes promocionales, que pueden a\u00f1adirse f\u00e1cilmente. Todo ello con la calidad que esperas del fabricante n\u00famero uno de impresoras de punto de venta3.","images":"https:\/\/www.dmi.es\/photo\/1675\/70913\/17692983\/bg\/impresora-epson-tm-m30-ticket-ethernet-bluetooth--negra.jpg","wholesale_price":"247.61","unit_price_tax":255.62220000000002},"product_model":{"product_data":{"ean13":["8715946605821"],"reference":"IM7336047","name":{"1":"IMPRESORA EPSON TM-M30 TICKET ETHERNET BLUETOOTH  NEGRA","2":"","3":"","4":""},"description":{"1":"La puerta de entrada a la impresi\u00f3n en puntos de venta basados en tabletEsta compacta impresora de recibos es perfecta para entornos de punto de venta con tablet como la hosteler\u00eda o los comercios especializados. Disponible tanto en negro como en blanco, es perfecta para clientes con poco espacio en el mostrador gracias a su reducido tama\u00f1o.Con un dise\u00f1o elegante y una funcionalidad inteligente, es la soluci\u00f3n ideal para clientes que deseen cambiarse a un sistema de punto de venta gestionado con tablet, incluidos quienes utilizan actualmente puntos de venta basados en ordenadores.Amplia conectividadSolo tienes que aproximar un dispositivo m\u00f3vil equipado con NFC o una tablet a la impresora TM-m30 para conectarlos y empezar a imprimir. En el caso de los equipos m\u00f3viles que no sean compatibles con NFC, la conexi\u00f3n con la impresora es muy f\u00e1cil mediante el escaneado de un c\u00f3digo QR exclusivo.Integraci\u00f3n inteligenteEl kit de desarrollo de software de impresi\u00f3n ePOS1 permite la impresi\u00f3n directa en CUALQUIER dispositivo m\u00f3vil sin necesidad de instalar ni actualizar drivers. Est\u00e1 disponible para dispositivos iOS y Android.Con interfaces Ethernet, Bluetooth o Wi-Fi, esta impresora puede incorporarse pr\u00e1cticamente a cualquier entorno de trabajo. Las versiones est\u00e1n disponibles solo con Ethernet, con Ethernet y Bluetooth, o con Ethernet y Wi-Fi, lo que permite la conectividad doble en algunos modelos.Flexible y adaptableLa impresora TM-m30 es muy elegante, por lo que es perfecta para cualquier entorno.Acceso frontal Acceso superiorSu dise\u00f1o compacto significa que es una de las impresoras est\u00e1ticas de punto de venta m\u00e1s peque\u00f1as del mundo2 y hace que sea ideal para colocarla en cualquier sitio. Puede instalarse tanto en horizontal como en vertical, para lo cual solo hay que cambiar sus dos cubiertas, lo que proporciona todav\u00eda m\u00e1s flexibilidad en la ubicaci\u00f3n de la impresora en mostrador. Esto facilita el acceso superior y frontal.Alta calidadLa impresora TM-m30 imprime recibos en m\u00faltiples escalas de grises, con funciones avanzadas de impresi\u00f3n de gr\u00e1ficos y c\u00f3digos de barras que permiten dise\u00f1os de recibos altamente personalizados, incluidos logotipos y mensajes promocionales, que pueden a\u00f1adirse f\u00e1cilmente. Todo ello con la calidad que esperas del fabricante n\u00famero uno de impresoras de punto de venta3.","2":"","3":"","4":""},"description_short":{"1":"Themal Line, 200 mm\/sec, 203 DPI x 203 DPI, Ethernet, Bluetooth, USB 2.0 Type B, USB 2.0 Type A","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Epson","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":255.6222,"unit_price_tax":255.6222,"tax_rules_group":null,"category":"Impresoras","brand":"Epson","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1675\/70913\/17692983\/bg\/impresora-epson-tm-m30-ticket-ethernet-bluetooth--negra.jpg"],"wholesale_price":247.61}}},"8023251002458":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8023251002458",false],"wholesale_price":[148.58,false],"price":[154.6116,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188285","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d391ae31a0755328b027b20ecdd80dfc.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"LB12476320","unit_price":154.6116,"category":"Electricidad","brand":"Riello","name_pt":"SAI RIELLO IDIALOG 1600 USB & SERIE","quantity":0,"ean13":"8023251002458","description_short_pt":"1600VA, 960W, USB, 6.9kg, Negro","description_pt":"La gama iDialog es la soluci\u00f3n ideal para la protecci\u