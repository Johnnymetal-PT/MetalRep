t without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188205","Cat. IDs: 102","Associated Categories","Cat. Default: 102","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3a8e0c54b5eae5878fe0c86d3ea49132.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CP18330019","unit_price":16.5444,"category":"Equipamiento deportivo","brand":"Cecotec","name_pt":"COMBA DRUMFIT SMARTCOMBA 3000 CONNECTED","quantity":0,"ean13":"8435484071963","description_short_pt":"Drumfit SmartComba 3000 Connected inteligente, compacta y ajustable para saltar en espacios reducidos con app y contador. 30 cm","description_pt":"Ad\u00e1ptate a tu ejercicio.La comba es totalmente ajustable para adecuarse a tus requerimientos y condiciones de entrenamiento.Conecta tu comba a la APP.Consigue que tu entrenamiento se haga m\u00e1s \u00e1gil y llevadero gracias a los diferentes planes de la aplicaci\u00f3n.2 cuerdas de 30 cm.Podr\u00e1s contar con dos cuerdas de PVC de 30 cm para cada uno de los mangos que te permitir\u00e1n realizar ejercicio en espacios reducidos, como por ejemplo en casa, sin golpear el suelo ni la l\u00e1mpara.Salta en espacios amplios.Tambi\u00e9n incluye una cuerda de PVC de 3 m de largo ajustable que podr\u00e1s f\u00e1cilmente intercambiar por las de 30 cm cuando quieras realizar el ejercicio en espacios abiertos.Toda tu informaci\u00f3n de un vistazo.Con sus 3 modos y pantalla LED, podr\u00e1s elegir si usar su modo de estilo libre, cronometrado o de cuenta atr\u00e1s.R\u00e1pida rotaci\u00f3n 360\u00ba.Su funci\u00f3n SmartBearing facilita un entrenamiento fluido y sin interrupciones. Al completar una rotaci\u00f3n, autom\u00e1ticamente el contador sumar\u00e1 un salto en su ejercicio.Carga f\u00e1cil y c\u00f3moda.El dispositivo dispone de puerto de carga USB de tipo C y cuenta con una bater\u00eda con durabilidad de hasta 3 meses de carga.Dise\u00f1o compacto.Gracias a las medidas del mango de 15,5 cm, di\u00e1metro de 2,5 cm y a su peso ligero de 250 g, podr\u00e1s llevarte c\u00f3modamente la Smart Comba a cualquier parte.","images":"https:\/\/www.dmi.es\/photo\/2123\/104682\/87907957\/bg\/comba-drumfit-smartcomba-3000-connected.jpg","wholesale_price":"13.22","unit_price_tax":16.5444},"product_model":{"product_data":{"ean13":["8435484071963"],"reference":"CP18330019","name":{"1":"COMBA DRUMFIT SMARTCOMBA 3000 CONNECTED","2":"","3":"","4":""},"description":{"1":"Ad\u00e1ptate a tu ejercicio.La comba es totalmente ajustable para adecuarse a tus requerimientos y condiciones de entrenamiento.Conecta tu comba a la APP.Consigue que tu entrenamiento se haga m\u00e1s \u00e1gil y llevadero gracias a los diferentes planes de la aplicaci\u00f3n.2 cuerdas de 30 cm.Podr\u00e1s contar con dos cuerdas de PVC de 30 cm para cada uno de los mangos que te permitir\u00e1n realizar ejercicio en espacios reducidos, como por ejemplo en casa, sin golpear el suelo ni la l\u00e1mpara.Salta en espacios amplios.Tambi\u00e9n incluye una cuerda de PVC de 3 m de largo ajustable que podr\u00e1s f\u00e1cilmente intercambiar por las de 30 cm cuando quieras realizar el ejercicio en espacios abiertos.Toda tu informaci\u00f3n de un vistazo.Con sus 3 modos y pantalla LED, podr\u00e1s elegir si usar su modo de estilo libre, cronometrado o de cuenta atr\u00e1s.R\u00e1pida rotaci\u00f3n 360\u00ba.Su funci\u00f3n SmartBearing facilita un entrenamiento fluido y sin interrupciones. Al completar una rotaci\u00f3n, autom\u00e1ticamente el contador sumar\u00e1 un salto en su ejercicio.Carga f\u00e1cil y c\u00f3moda.El dispositivo dispone de puerto de carga USB de tipo C y cuenta con una bater\u00eda con durabilidad de hasta 3 meses de carga.Dise\u00f1o compacto.Gracias a las medidas del mango de 15,5 cm, di\u00e1metro de 2,5 cm y a su peso ligero de 250 g, podr\u00e1s llevarte c\u00f3modamente la Smart Comba a cualquier parte.","2":"","3":"","4":""},"description_short":{"1":"Drumfit SmartComba 3000 Connected inteligente, compacta y ajustable para saltar en espacios reducidos con app y contador. 30 cm","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":16.5444,"unit_price_tax":16.5444,"tax_rules_group":null,"category":"Equipamiento deportivo","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/2123\/104682\/87907957\/bg\/comba-drumfit-smartcomba-3000-connected.jpg"],"wholesale_price":13.22}}},"8435484017015":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484017015",false],"wholesale_price":[49.38,false],"price":[53.4276,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188206","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/766fba94ee963e2aabd81f6c7494b27f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO10330078","unit_price":53.427600000000005,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"MICROONDAS PROCLEAN 3010 RETRO BLUE","quantity":0,"ean13":"8435484017015","description_short_pt":"ProClean 3010 Retro Blue Microondas Retro Blue Microondas mec\u00e1nico de 20L, 700W.","description_pt":"Cecotec 01701. Tipo de instalaci\u00f3n: Encimera, Tipo de producto: Solo microondas, Capacidad interior: 20 L, Potencia del microondas: 700 W, Tipo de control: Giratorio, Color del producto: Azul","images":"https:\/\/www.dmi.es\/photo\/1325\/104685\/87872487\/bg\/microondas-proclean-3010-retro-blue.jpg","wholesale_price":"49.38","unit_price_tax":53.427600000000005},"product_model":{"product_data":{"ean13":["8435484017015"],"reference":"CO10330078","name":{"1":"MICROONDAS PROCLEAN 3010 RETRO BLUE","2":"","3":"","4":""},"description":{"1":"Cecotec 01701. Tipo de instalaci\u00f3n: Encimera, Tipo de producto: Solo microondas, Capacidad interior: 20 L, Potencia del microondas: 700 W, Tipo de control: Giratorio, Color del producto: Azul","2":"","3":"","4":""},"description_short":{"1":"ProClean 3010 Retro Blue Microondas Retro Blue Microondas mec\u00e1nico de 20L, 700W.","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":53.4276,"unit_price_tax":53.4276,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1325\/104685\/87872487\/bg\/microondas-proclean-3010-retro-blue.jpg"],"wholesale_price":49.38}}},"8435484017176":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484017176",false],"wholesale_price":[172.12,false],"price":[178.6224,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188207","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/4733da9f5889d335363f439b6d8921c2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO11330172","unit_price":178.6224,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"CAFETERA SUPER AUTOMATICA CREMMAET MACCHIA WHITE","quantity":0,"ean13":"8435484017176","description_short_pt":"1.5 l, 19 bares","description_pt":"Tu superautom\u00e1tica, s\u00faper compacta.Prepara espressos y americanos con caf\u00e9 reci\u00e9n molido de forma f\u00e1cil y r\u00e1pida. \u00a1Y no te preocupes por el espacio! Gracias a su dise\u00f1o compacto, se adapta perfectamente a cualquier cocina.Mejor crema y m\u00e1ximo aroma.Su potente bomba de presi\u00f3n de 19 bares extrae todas las cualidades del caf\u00e9 y consigue la mejor crema y un aroma \u00fanico.Caf\u00e9 a tu gusto.Selecciona desde su display t\u00e1ctil la cantidad e intensidad del caf\u00e9, guarda tu configuraci\u00f3n favorita y disfruta a diario de caf\u00e9s perfectos de la forma m\u00e1s c\u00f3moda.Del grano a la taza con un toque.Prepara caf\u00e9 como un aut\u00e9ntico barista de la forma m\u00e1s c\u00f3moda y r\u00e1pida, !un toque y listo!Caf\u00e9 reci\u00e9n molido al instante.Gracias al sistema Thermoblock, la cafetera se calienta de forma r\u00e1pida, para que puedas disfrutar de caf\u00e9 reci\u00e9n molido con una crema perfecta sin largas esperas.Muele y conserva el caf\u00e9.La cafetera cuenta con un dep\u00f3sito herm\u00e9tico de 200 g para conservar todo el aroma de cada grano de caf\u00e9. Adem\u00e1s, cuenta con un molinillo integrado para que puedas elegir el nivel de molienda y extraerlo para su limpieza.Dep\u00f3sito de agua de 1,5 L.Disfruta a diario de caf\u00e9s perfectos sin tener que estar rellanando su dep\u00f3sito de agua constantemente. Todo ventajas para que disfrutes de tu caf\u00e9 como nunca.","images":"https:\/\/www.dmi.es\/photo\/1320\/104675\/87873736\/bg\/cafetera-super-automatica-cremmaet-macchia-white.jpg","wholesale_price":"172.12","unit_price_tax":178.6224},"product_model":{"product_data":{"ean13":["8435484017176"],"reference":"CO11330172","name":{"1":"CAFETERA SUPER AUTOMATICA CREMMAET MACCHIA WHITE","2":"","3":"","4":""},"description":{"1":"Tu superautom\u00e1tica, s\u00faper compacta.Prepara espressos y americanos con caf\u00e9 reci\u00e9n molido de forma f\u00e1cil y r\u00e1pida. \u00a1Y no te preocupes por el espacio! Gracias a su dise\u00f1o compacto, se adapta perfectamente a cualquier cocina.Mejor crema y m\u00e1ximo aroma.Su potente bomba de presi\u00f3n de 19 bares extrae todas las cualidades del caf\u00e9 y consigue la mejor crema y un aroma \u00fanico.Caf\u00e9 a tu gusto.Selecciona desde su display t\u00e1ctil la cantidad e intensidad del caf\u00e9, guarda tu configuraci\u00f3n favorita y disfruta a diario de caf\u00e9s perfectos de la forma m\u00e1s c\u00f3moda.Del grano a la taza con un toque.Prepara caf\u00e9 como un aut\u00e9ntico barista de la forma m\u00e1s c\u00f3moda y r\u00e1pida, !un toque y listo!Caf\u00e9 reci\u00e9n molido al instante.Gracias al sistema Thermoblock, la cafetera se calienta de forma r\u00e1pida, para que puedas disfrutar de caf\u00e9 reci\u00e9n molido con una crema perfecta sin largas esperas.Muele y conserva el caf\u00e9.La cafetera cuenta con un dep\u00f3sito herm\u00e9tico de 200 g para conservar todo el aroma de cada grano de caf\u00e9. Adem\u00e1s, cuenta con un molinillo integrado para que puedas elegir el nivel de molienda y extraerlo para su limpieza.Dep\u00f3sito de agua de 1,5 L.Disfruta a diario de caf\u00e9s perfectos sin tener que estar rellanando su dep\u00f3sito de agua constantemente. Todo ventajas para que disfrutes de tu caf\u00e9 como nunca.","2":"","3":"","4":""},"description_short":{"1":"1.5 l, 19 bares","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"",