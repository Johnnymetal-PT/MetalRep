":[58.4766,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186678","Cat. IDs: 77","Associated Categories","Cat. Default: 77","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/22604c38a806f25f12a95419cb0f2ff7.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"LB13131206","unit_price":58.4766,"category":"Accesorios telefon\u00eda","brand":"Targus","name_pt":"CARGADOR ADAPTADOR UNIVERSAL TARGUS 45W TIPO C NEGRO","quantity":0,"ean13":"5051794019933","description_short_pt":"1.8m, 45W, 5V, 12V, 15V, 20V","description_pt":"El USB-C es el conector de carga de nueva generaci\u00f3n para dispositivos tales como port\u00e1tiles, m\u00f3viles, tablets e incluso wearables. El cargador USBC-C de CA de 45w de Targus ha sido dise\u00f1ado para ofrecer soluciones de carga universal para dispositivos USB-C entre los que se incluye a potentes port\u00e1tiles de 45w. Permite cargar dispositivos de 5V, 9V, 15V y 20V, con lo que con un solo cargador podr\u00e1 cargar todos sus dispositivos con toma de alimentaci\u00f3n USB-C. El cable de 1,8 m le ofrece la flexibilidad que necesita mientras trabaja, y a la par la protecci\u00f3n frente a sobretensiones protege el dispositivo frente a picos de tensi\u00f3n. Este cargador se suministra con 4 clavijas intercambiables, lo que lo hace ideal para usarlo en Europa continental, Reino Unido, EE. UU. o Australia.- Cargador USB-C universal para autom\u00f3vil con capacidad para cargar dispositivos con 4 perfiles de alimentaci\u00f3n distintos, lo que hace que sea ideal para utilizarlo con su port\u00e1til, m\u00f3vil, tablet y wearables.- Potente, hasta 45w, e ideal para port\u00e1tiles modernos entre los que se incluye a los nuevos MacBook, Dell y Lenovo Modelos- Protege, la protecci\u00f3n integrada frente a picos de tensi\u00f3n impide que las sobrecargas da\u00f1en sus dispositivos de hardware.- Cable con una longitud de 1,8m, ideal para cargar dispositivos lejos de su vista.- 4 clavijas intercambiables, lo que lo hace ideal para usarlo en Europa continental, Reino Unido, EE. UU. o Australia.- Dise\u00f1o USB-C reversible, olv\u00eddese de tener que pensar de qu\u00e9 lado enchufar el cable.- Soporta dispositivos de 5V, 12V, 15V y 20V de hasta 45 vatios (salidas de 5V-3A\/12V-3A\/15V-2,5A\/20V-2,25A)","images":"https:\/\/www.dmi.es\/photo\/1399\/78603\/18363692\/bg\/cargador-adaptador-universal-targus-45w-tipo-c-negro.jpg","wholesale_price":"54.33","unit_price_tax":58.4766},"product_model":{"product_data":{"ean13":["5051794019933"],"reference":"LB13131206","name":{"1":"CARGADOR ADAPTADOR UNIVERSAL TARGUS 45W TIPO C NEGRO","2":"","3":"","4":""},"description":{"1":"El USB-C es el conector de carga de nueva generaci\u00f3n para dispositivos tales como port\u00e1tiles, m\u00f3viles, tablets e incluso wearables. El cargador USBC-C de CA de 45w de Targus ha sido dise\u00f1ado para ofrecer soluciones de carga universal para dispositivos USB-C entre los que se incluye a potentes port\u00e1tiles de 45w. Permite cargar dispositivos de 5V, 9V, 15V y 20V, con lo que con un solo cargador podr\u00e1 cargar todos sus dispositivos con toma de alimentaci\u00f3n USB-C. El cable de 1,8 m le ofrece la flexibilidad que necesita mientras trabaja, y a la par la protecci\u00f3n frente a sobretensiones protege el dispositivo frente a picos de tensi\u00f3n. Este cargador se suministra con 4 clavijas intercambiables, lo que lo hace ideal para usarlo en Europa continental, Reino Unido, EE. UU. o Australia.- Cargador USB-C universal para autom\u00f3vil con capacidad para cargar dispositivos con 4 perfiles de alimentaci\u00f3n distintos, lo que hace que sea ideal para utilizarlo con s