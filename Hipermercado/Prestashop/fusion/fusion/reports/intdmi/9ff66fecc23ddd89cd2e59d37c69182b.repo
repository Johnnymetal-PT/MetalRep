escription_pt":"Con un motor de 850w de potencia m\u00e1xima y un chasis redise\u00f1ado para que sea m\u00e1s ligero y m\u00e1s c\u00f3modo, el Mamba Lite consigue dar, con las mismas prestaciones, un par superior, lo que significa mayor potencia de salida. Seguridad incrementada gracias a su triple frenada y a su doble suspensi\u00f3n invertida, lo que, combinado con su base ancha, proporciona tambi\u00e9n un extra de comodidad. Adem\u00e1s, con su App, podr\u00e1s controlar todos los datos en tiempo real de tu patinete y bloquearlo desde el m\u00f3vil en cualquier momento.La noche no supone ning\u00fan desaf\u00edo para el mamba lite ya que incorpora luces led delantera y traseras, las cuales aportan est\u00e9tica y seguridad. Estructura de aluminio robusta capaz de aguantar hasta 120 kg pesando tan solo 20 kg, no hay nada que se le resista. Todo esto y mucho m\u00e1s, hacen que el mamba lite supere cualquier expectativa.","images":"https:\/\/www.dmi.es\/photo\/6450\/102645\/84292100\/bg\/patinete-electrico-olsson-mamba-lite-10--850w-bth-luz-led-20kg-freno-de-disco.jpg","wholesale_price":"418.46","unit_price_tax":429.88919999999996},"product_model":{"product_data":{"ean13":["8445488111800"],"reference":"MU01509092","name":{"1":"PATINETE ELECTRICO OLSSON MAMBA LITE 10\" 850W BTH LUZ LED 20KG FRENO DE DISCO","2":"","3":"","4":""},"description":{"1":"Con un motor de 850w de potencia m\u00e1xima y un chasis redise\u00f1ado para que sea m\u00e1s ligero y m\u00e1s c\u00f3modo, el Mamba Lite consigue dar, con las mismas prestaciones, un par superior, lo que significa mayor potencia de salida. Seguridad incrementada gracias a su triple frenada y a su doble suspensi\u00f3n invertida, lo que, combinado con su base ancha, proporciona tambi\u00e9n un extra de comodidad. Adem\u00e1s, con su App, podr\u00e1s controlar todos los datos en tiempo real de tu patinete y bloquearlo desde el m\u00f3vil en cualquier momento.La noche no supone ning\u00fan desaf\u00edo para el mamba lite ya que incorpora luces led delantera y traseras, las cuales aportan est\u00e9tica y seguridad. Estructura de aluminio robusta capaz de aguantar hasta 120 kg pesando tan solo 20 kg, no hay nada que se le resista. Todo esto y mucho m\u00e1s, hacen que el mamba lite supere cualquier expectativa.","2":"","3":"","4":""},"description_short":{"1":"850W, 25km\/h, 35km, Display, 10000mAh, max 120kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"OLSSON and Brothers","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":429.8892,"unit_price_tax":429.8892,"tax_rules_group":null,"category":"Patinetes y scooters","brand":"OLSSON and Brothers","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/6450\/102645\/84292100\/bg\/patinete-electrico-olsson-mamba-lite-10--850w-bth-luz-led-20kg-freno-de-disco.jpg"],"wholesale_price":418.46}}},"4719331805586":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4719331805586",false],"wholesale_price":[68.17,false],"price":[72.5934,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190148","Cat. IDs: 188","Associated Categories","Cat. Default: 188","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/244ba4cd3ea1d85e69ac4e6032180b80.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PB11154539","unit_price":72.5934,"category":"Placas base","brand":"Gigabyte","name_pt":"PLACA BASE GIGABYTE B450M DS3H WIFI AM4 MATX 4XDDR4","quantity":0,"ean13":