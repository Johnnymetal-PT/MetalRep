ser\u00e1 mayor o menor. Le recomendamos lea con detenimiento el manual de usuario de este producto para conocer al detalle todas sus opciones y poder sacar el m\u00e1ximo rendimiento al mismo.","2":"","3":"","4":""},"description_short":{"1":"LEOTEC KIDS ALLO GPS ANTIP\u00c9RDIDA PLUS 4G","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Leotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":52.3668,"unit_price_tax":52.3668,"tax_rules_group":null,"category":"Relojes Inteligentes","brand":"Leotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/2647\/99742\/75672641\/bg\/leotec-smartwatch-kids-allo-plus-4g-gps-anti-perdida-negro.jpg"],"wholesale_price":48.34}}},"8716309079648":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8716309079648",false],"wholesale_price":[6.9,false],"price":[10.098,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185315","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3718219bd0c9650b406c857db1d5eadc.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"OP1232608","unit_price":10.098,"category":"Perif\u00e9ricos","brand":"Gembird","name_pt":"RATON OPTICO GEMBIRD BLUETOOTH 1600 DPI NEGRO 6 BOTONES","quantity":0,"ean13":"8716309079648","description_short_pt":"800 ? 1600 DPI, Bluetooth","description_pt":"Gembird MUSWB2. Factor de forma: mano derecha. Tecnolog\u00eda de det