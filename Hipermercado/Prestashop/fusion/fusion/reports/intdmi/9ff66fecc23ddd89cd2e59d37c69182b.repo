4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NATEC","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":5.0286,"unit_price_tax":5.0286,"tax_rules_group":null,"category":"Refrigeraci\u00f3n","brand":"NATEC","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1529\/77031\/46580071\/bg\/pasta-termica-pack-natec-husky-1-gr-10-uds.jpg"],"wholesale_price":1.93}}},"5901969425536":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5901969425536",false],"wholesale_price":[1.3,false],"price":[4.386,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186745","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2c35fc478e8c21b12109317cbab6bc56.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"VE90416005","unit_price":4.386,"category":"Refrigeraci\u00f3n","brand":"GENESIS","name_pt":"PASTA TERMICA GENESIS SILICON 701 0,5 GR","quantity":0,"ean13":"5901969425536","description_short_pt":"Silicon 701, 8.3 W\/mK, 0.2 ml","description_pt":"SILICON 701Genesis Silicon 701 es una pasta t\u00e9rmica que estar\u00e1 a la altura de las expectativas de los usuarios de potentes PCs, cuyos equipos est\u00e1n basados en componentes que requieren soluciones excepcionales para alcanzar temperaturas de trabajo \u00f3ptimas.CUMPLE CON TODOS LOS REQUISITOSPara satisfacer esas altas exigencias, la pasta de Silicon 701 ofrece una alta conductividad t\u00e9rmica, una resistencia t\u00e9rmica baja, no es conductora de la electricidad, no se degrada y no requiere tiempo de fraguado, con ella se consigue un rendimiento t\u00e9rmico \u00f3ptimo desde el primer arranque del componente en el que se ha aplicado la pasta.DE F\u00c1CIL APLICACI\u00d3NDebido al uso de la pr\u00e1ctica jeringuilla, su aplicaci\u00f3n y conservaci\u00f3n no ser\u00e1 un problema ni siquiera para los usuarios menos expertos. Dentro del paquete, los usuarios encontrar\u00e1n una esp\u00e1tula, que ayuda a esparcir la pasta de manera m\u00e1s uniforme sobre la superficie a aplicar. En la mayor\u00eda de los casos, sin embargo, la utilizaci\u00f3n de una peque\u00f1a gota (del tama\u00f1o de un grano de arroz o m\u00e1s peque\u00f1o - dependiendo del \u00e1rea de la superficie) en el centro del dispositivo de refrigeraci\u00f3n, resultar\u00e1 ideal.","images":"https:\/\/www.dmi.es\/photo\/1529\/77132\/46452094\/bg\/pasta-termica-genesis-silicon-701-0-5-gr.jpg","wholesale_price":"1.30","unit_price_tax":4.386},"product_model":{"product_data":{"ean13":["5901969425536"],"reference":"VE90416005","name":{"1":"PASTA TERMICA GENESIS SILICON 701 0,5 GR","2":"","3":"","4":""},"description":{"1":"SILICON 701Genesis Silicon 701 es una pasta t\u00e9rmica que estar\u00e1 a la altura de las expectativas de los usuarios de potentes PCs, cuyos equipos est\u00e1n basados en componentes que requieren soluciones excepcionales para alcanzar temperaturas de trabajo \u00f3ptimas.CUMPLE CON TODOS LOS REQUISITOSPara satisfacer esas altas exigencias, la pasta de Silicon 701 ofrece una alta conductividad t\u00e9rmica, una resistencia t\u00e9rmica baja, no es conductora de la electricidad, no se degrada y no requiere tiempo de fraguado, con ella se consigue un rendimiento t\u00e9rmico \u00f3ptimo desde el primer arranque del componente en el que se ha aplicado la pasta.DE F\u00c1CIL APLICACI\u00d3NDebido al uso de la pr\u00e1ctica jeringuilla, su aplicaci\u00f3n y conservaci\u00f3n no ser\u00e1 un problema ni siquiera para los usuarios menos expertos. Dentro del paquete, los usuarios encontrar\u00e1n una esp\u00e1tula, que ayuda a esparcir la pasta de manera m\u00e1s uniforme sobre la superficie a aplicar. En la mayor\u00eda de los casos, sin embargo, la utilizaci\u00f3n de una peque\u00f1a gota (del tama\u00f1o de un grano de arroz o m\u00e1s peque\u00f1o - dependiendo del \u00e1rea de la superficie) en el centro del dispositivo de refrigeraci\u00f3n, resultar\u00e1 ideal.","2":"","3":"","4":""},"description_short":{"1":"Silicon 701, 8.3 W\/mK, 0.2 ml","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GENESIS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":4.386,"unit_price_tax":4.386,"tax_rules_group":null,"category":"Refrigeraci\u00f3n","brand":"GENESIS","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1529\/77132\/46452094\/bg\/pasta-termica-genesis-silicon-701-0-5-gr.jpg"],"wholesale_price":1.3}}},"5901969425543":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5901969425543",false],"wholesale_price":[1.67,false],"price":[4.7634,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186746","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/aff7a4242c84462907d31e1cb2afb9a7.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"VE90416006","unit_price":4.7634,"category