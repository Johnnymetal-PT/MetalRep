_price_tax":111.4044,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1650\/105499\/85706164\/bg\/ma\u0081quina-de-hacer-hielo-chillin--ice-1500.jpg"],"wholesale_price":106.22}}},"8435484049863":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484049863",false],"wholesale_price":[94.2,false],"price":[99.144,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190445","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ec5b4364076186ed50f097f48fc2982e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO10330095","unit_price":99.144,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"CECOFRY ADVANCE 9000 WINDOW","quantity":0,"ean13":"8435484049863","description_short_pt":"Cecofry Advance 9000 Window Freidora diet\u00e9tica digital de 9 L de capacidad con pared divisoria m\u00f3vil, temperatura dual, ventana y tecnolog\u00eda PerfectCook.","description_pt":"Capacidad superior.Su amplia cubeta de 9 litros permite cocinar todo tipo de recetas c\u00f3modamente sin preocuparte por tener que cocinar en varias tandas. Platos para todos los gustos.Convierte los 9 litros de capacidad en dos cubetas de 4,5 litros gracias a su pared divisoria m\u00f3vil. As\u00ed puedes cocinar dos recetas diferentes al mismo tiempo sin problemas. Cocci\u00f3n dualSelecciona la temperatura ideal desde 80\u00baC hasta 200 \u00baC de forma indiviudal para cada cubeta y disfruta de diferentes recetas cocinadas a la vez con un punto perfecto.Mira a trav\u00e9s.Valora en todo momento la cocci\u00f3n de tus recetas a trav\u00e9s de la ventana de visualizaci\u00f3n de tu Cecofry y no desperdicies ni un grado de temperatura.2850 W de cocina saludable.Con su gran potencia podr\u00e1s cocinar una gran variedad de alimentos de forma r\u00e1pida y sencilla. Disfruta de tus recetas favoritas de la forma m\u00e1s saludable y sin esperas.6 men\u00fas.Con sus men\u00fas preconfigurados olv\u00eddate de pensar. Solo escoge el men\u00fa que vayas a cocinar y ella sola ajustar\u00e1 el tiempo y la temperatura para dejar tu plato perfecto. Un solo movimiento para un control total.Con su panel de control t\u00e1ctil multifunci\u00f3n tienes el control total en cada elaboraci\u00f3n de la forma m\u00e1s c\u00f3moda y r\u00e1pida. Todo a su debido punto.Introduce los alimentos dentro del cestillo, programa los ajustes y la freidora con su avanzada tecnolog\u00eda de aire caliente Perfect Cook conseguir\u00e1 resultados espectaculares.","images":"https:\/\/www.dmi.es\/photo\/1319\/105486\/85976954\/bg\/cecofry-advance-9000-window.jpg","wholesale_price":"94.20","unit_price_tax":99.144},"product_model":{"product_data":{"ean13":["8435484049863"],"reference":"CO10330095","name":{"1":"CECOFRY ADVANCE 9000 WINDOW","2":"","3":"","4":""},"description":{"1":"Capacidad superior.Su amplia cubeta de 9 litros permite cocinar todo tipo de recetas c\u00f3modamente sin preocuparte por tener que cocinar en varias tandas. Platos para todos los gustos.Convierte los 9 litros de capacidad en dos cubetas de 4,5 litros gracias a su pared divisoria m\u00f3vil. As\u00ed puedes cocinar dos recetas diferentes al mismo tiempo sin problemas. Cocci\u00f3n dualSelecciona la temperatura ideal desde 80\u00baC hasta 200 \u00baC de forma indiviudal para cada cubeta y disfruta de diferentes recetas cocinadas a la vez con un punto perfecto.Mira a trav\u00e9s.Valora en todo momento la cocci\u00f3n de tus recetas a trav\u00e9s de la ventana de visualizaci\u0