":0,"images":["https:\/\/www.dmi.es\/photo\/827\/77106\/46457396\/bg\/cargador-natec-temera-90-universal-portatil-90w.jpg"],"wholesale_price":21.36}}},"8436532164347":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436532164347",false],"wholesale_price":[72.16,false],"price":[76.6632,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189524","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/951cf69a59e0d753ec496546f0925aa5.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"FA10356032","unit_price":76.66319999999999,"category":"Cajas y fuentes","brand":"NOX","name_pt":"FUENTE ALIMENTACION NOX HUMMER GD750 750W 80+ GOLD ATX NEGRO","quantity":0,"ean13":"8436532164347","description_short_pt":"750W, ATX 12V v2.31, 120mm, 3x Molex, 5x SATA, 4x PCI-e 6+2pin, 1x MB, 1x 4+4pin","description_pt":"Hummer 750w GD seriesHummer GD, son las fuentes con certificado 80 PLUS Gold de Nox. Se trata de fuentes que garantizan una eficiencia del 90%, dise\u00f1adas para aquellos que necesitan una potencia estable y una garant\u00eda de rendimiento en equipos de altas prestaciones.- Certificado 80 PLUS Gold que garantiza una eficiencia del 87-90%- Ventilador de 120 mm ultra silencioso- Compatible con ATX12V v2.31- Filtro EMI de doble capa que reduce interferencias- electromagn\u00e9ticas y retenci\u00f3n de ruido- CircuitShieldTM OVP, UVP, SCP y OPP- Entrada universal de 100-240 VMayor eficienciaLas fuentes Hummer GD cuentan con certificado 80 PLUS Gold, el cual, garantiza una eficiencia del 90%, por lo tanto, el rendimiento de la fuente es mayor con menores costes. A su vez, las emisiones de calor se ver\u00e1n reducidas con un eficaz funcionamiento, permitiendo trabajar al ventilador a menor velocidad y en consecuencia, el ruido producido por la fuente ser\u00e1 pr\u00e1cticamente imperceptible.M\u00e1xima potencia, m\u00ednimo ruidoLas Hummer GD cuentan con ventilador de 120 mm, t\u00e9rmicamente controlado, es decir, tan solo funcionar\u00e1 a m\u00e1xima potencia en caso de ser necesario. De esta manera, la fuente siempre estar\u00e1 a temperatura \u00f3ptima garantizando una baja sonoridad. Su dise\u00f1o es funcional y din\u00e1mico, para obtener la m\u00e1xima disipaci\u00f3n de calor y un perfecto rendimiento.Dise\u00f1o eleganteDise\u00f1adas por completo en negro, tanto en su interior como en su exterior, las fuentes Hummer GD se presentan con un elegante acabado. Sus cables son negros y planos, lo que permitir\u00e1 gestionar el cableado de una manera m\u00e1s c\u00f3moda y ordenada que garantice un \u00f3ptimo flujo de aire en el interior del equipo.ConectoresTodas las fuentes Hummer GD cuentan con un completo set de cables para todo tipo de dispositivos y conexiones.","images":"https:\/\/www.dmi.es\/photo\/963\/29060\/16727339\/bg\/fuente-alimentacion-nox-hummer-gd750-750w-80+-gold-atx-negro.jpg","wholesale_price":"72.16","unit_price_tax":76.66319999999999},"product_model":{"product_data":{"ean13":["8436532164347"],"reference":"FA10356032","name":{"1":"FUENTE ALIMENTACION NOX HUMMER GD750 750W 80+ GOLD ATX NEGRO","2":"","3":"","4":""},"description":{"1":"Hummer 750w GD seriesHummer GD, son las fuentes con certificado 80 PLUS Gold de Nox. Se trata de fuentes que garantizan una eficiencia del 90%, dise\u00f1adas para aquellos que necesitan una potencia estable y una garant\u00eda de rendimiento en equipos de altas prestaciones.- Certificado 80 PLUS Gold que garantiza una eficiencia del 87-90%- Ventilador de 120 mm ultra silencioso- Compatible con ATX12V v2.31- Filtro EMI de doble capa que reduce interferencias- electromagn\u00e9ticas y retenci\u00f3n de ruido- CircuitShieldTM OVP, UVP, SCP y OPP- Entrada universal de 100-240 VMayor eficienciaLas fuentes Hummer GD cuentan con certificado 80 PLUS Gold, el cual, garantiza una eficiencia del 90%, por lo tanto, el rendimiento de la fuente es mayor con menores costes. A su vez, las emisiones de calor se ver\u00e1n reducidas con un eficaz funcionamiento, permitiendo trabajar al ventilador a menor velocidad y en consecuencia, el ruido producido por la fuente ser\u00e1 pr\u00e1cticamente imperceptible.M\u00e1xima potencia, m\u00ednimo ruidoLas Hummer GD cuentan con ventilador de 120 mm, t\u00e9rmicamente controlado, es decir, tan solo funcionar\u00e1 a m\u00e1xima potencia en caso de ser necesario. De esta manera, la fuente siempre estar\u00e1 a temperatura \u00f3ptima garantizando una baja sonoridad. Su dise\u00f1o es funcional y din\u00e1mico, para obtener la m\u00e1xima disipaci\u00f3n de calor y un perfecto rendimiento.Dise\u00f1o eleganteDise\u00f1adas por completo en negro, tanto en su interior como en su exterior, las fuentes Hummer GD se presentan con un elegante acabado. Sus cables son negros y planos, lo que permitir\u00e1 gestionar el cableado de una manera m\u00e1s c\u00f3moda y ordenada que garantice un \u00f3ptimo flujo de aire en el interior del equipo.ConectoresTodas las fuentes Hummer GD cuentan con un completo set de cables para todo tipo de dispositivos y conexiones.","2":"","3":"","4":""},"description_short":{"1":"750W, ATX 12V v2.31, 120mm, 3x Molex, 5x SATA, 4x PCI-e 6+2pin, 1x MB, 1x 4+4pin","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":76.6632,"unit_price_tax":76.6632,"tax_rules_group":null,"category":"Cajas y 