hasta el 50 % para minimizar los costes operativos.","2":"","3":"","4":""},"description_short":{"1":"16x 25GbE SFP28, 1x 10GbE RJ45, Web Managed, 100-240VAC, 50\/60 Hz, 43.5 x 285 x 237.7 mm, 2.15 kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"QNAP","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":1110.321,"unit_price_tax":1110.321,"tax_rules_group":null,"category":"Switches y Transceptores","brand":"QNAP","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/258\/94236\/63140256\/bg\/switch-qnap-qsw-m5216-1t-l2-10g-ethernet.jpg"],"wholesale_price":1085.55}}},"8716309124799":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8716309124799",false],"wholesale_price":[381.49,false],"price":[392.1798,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189121","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cb66b42beb286329d92d0abfb4403266.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"LB2932075","unit_price":392.1798,"category":"Electricidad","brand":"Gembird","name_pt":"UPS GEMBIRD EN L\u00c3NEA 3000 VA","quantity":0,"ean13":"8716309124799","description_short_pt":"Gembird EG-UPSO-3000, Doble conversi\u00f3n (en l\u00ednea), 3 kVA, 2700 W, Onda sinusoidal pura, 220 V, 50\/60 Hz","description_pt":"Gembird EG-UPSO-3000. Topolog\u00eda UPS: Doble conversi\u00f3n (en l\u00ednea), Capacidad de potenci