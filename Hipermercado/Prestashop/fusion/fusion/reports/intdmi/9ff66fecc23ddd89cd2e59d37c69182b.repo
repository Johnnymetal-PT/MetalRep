null,"height":null,"depth":null,"weight":null,"unit_price":5.2122,"unit_price_tax":5.2122,"tax_rules_group":null,"category":"Cables y Conectores","brand":"3GO","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/883\/19416\/14044846\/bg\/latiguillo-cat-5e-3m.jpg"],"wholesale_price":2.11}}},"8435484083997":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484083997",false],"wholesale_price":[75.28,false],"price":[79.8456,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187897","Cat. IDs: 145","Associated Categories","Cat. Default: 145","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c3c2d47c7f752b50d311e555bdab3763.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO02330194","unit_price":79.8456,"category":"Limpieza","brand":"Cecotec","name_pt":"ASPIRADOR VERTICAL CECOTEC SCOBA 2100 TWICE ANIMAL","quantity":0,"ean13":"8435484083997","description_short_pt":"210 W, 45 min, 20 kPa, Cabezal 360\u00ba, 1,55 kg","description_pt":"Limpia libremente.Gracias a los dos rodamientos circulares de la base, el cabezal de limpieza con doble cepillo es capaz de moverse en todas direcciones, adapt\u00e1ndose a todo tipo de espacios y obst\u00e1culos. Un d\u00fao todav\u00eda m\u00e1s din\u00e1mico.La combinaci\u00f3n infalible del cepillo multifunci\u00f3n, capaz de raspar y arrastrar la suciedad, y el cepillo Jalisco con millones de microfibras que atrapan la microsuciedad. Cepillo Jalisco.Ideal para suelos duros por su facilidad para atrapar part\u00edculas de microsuciedad, polvo y \u00e1caros gracias a sus millones de microfibras ultra atrayentes.  Cepillo Multifunci\u00f3n.Arrasa con la suciedad m\u00e1s grande y los pelos de tu mascota tanto en suelos como alfombras.  Ultrapotencia y ligereza van de la mano.Con su motor digital de \u00faltima generaci\u00f3n que maximiza sus 210 W, aspira todo tipo de suciedad exprimiendo sus 20 kPa de succi\u00f3n. Una potencia escandalosa para su poco peso. Peso plumaCon s\u00f3lo 0,73 kg en el aspirador de mano y 1,5 kg como escoba, limpiar tu casa con su s\u00faper potencia es tan f\u00e1cil que ya no hay excusa para dejar algo sin recoger o hacer repasos ultrarr\u00e1pidos. Scoba te da tiempo.Con sus hasta 45 minutos de autonom\u00eda es perfecta para usarla durante semanas en momentos puntuales o para una limpieza espec\u00edfica como el sof\u00e1.Pet-friendly.Como aspirador de mano, la Scoba es perfecta para mantener tu hogar libre de pelos de mascota. Con su accesorio especial para animales PetStyle, podr\u00e1s cepillar a tu mascota mientras aspiras el pelo restante. Adem\u00e1s, tambi\u00e9n contar\u00e1s con el accesorio 2 en 1 y el accesorio para tapicer\u00edas con los que sacar\u00e1s a relucir tu casa.","images":"https:\/\/www.dmi.es\/photo\/1872\/102253\/83686023\/bg\/aspirador-vertical-cecotec-scoba-2100-twice-animal.jpg","wholesale_price":"75.28","unit_price_tax":79.8456},"product_model":{"product_data":{"ean13":["8435484083997"],"reference":"HO02330194","name":{"1":"ASPIRADOR VERTICAL CECOTEC SCOBA 2100 TWICE ANIMAL","2":"","3":"","4":""},"description":{"1":"Limpia libremente.Gracias a los dos rodamientos circulares de la base, el cabezal de limpieza con doble cepillo es capaz de moverse en todas direcciones, adapt\u00e1ndose a todo tipo de espacios y obst\u00e1culos. Un d\u00fao todav\u00eda m\u00e1s din\u00e1mico.La combinaci\u00f3n infalible del cepillo multifunci\u00f3n, capaz de raspar y arrastrar la suciedad, y el cepillo Jalisco con millones de microfibras que atrapan la microsuciedad. Cepillo Jalisco.Ideal para suelos duros por su facilidad para atrapar part\u00edculas de microsuciedad, polvo y \u00e1caros gracias a sus millones de microfibras ultra atrayentes.  Cepillo Multifunci\u00f3n.Arrasa con la suciedad m\u00e1s grande y los pelos de tu mascota tanto en suelos como alfombras.  Ultrapotencia y ligereza van de la mano.Con su motor digital de \u00faltima generaci\u00f3n que maximiza sus 210 W, aspira todo tipo de suciedad exprimiendo sus 20 kPa de succi\u00f3n. Una potencia escandalosa para su poco peso. Peso plumaCon s\u00f3lo 0,73 kg en el aspirador de mano y 1,5 kg como escoba, limpiar tu casa con su s\u00faper potencia es tan f\u00e1cil que ya no hay excusa para dejar algo sin recoger o hacer repasos ultrarr\u00e1pidos. Scoba te da tiempo.Con sus hasta 45 minutos de autonom\u00eda es perfecta para usarla durante semanas en momentos puntuales o para una limpieza espec\u00edfica como el sof\u00e1.Pet-friendly.Como aspirador de mano, la Scoba es perfecta para mantener tu hogar libre de pelos de mascota. Con su accesorio especial para animales PetStyle, podr\u00e1s cepillar a tu mascota mientras aspiras el pelo restante. Adem\u00e1s, tambi\u00e9n contar\u00e1s con el accesorio 2 en 1 y el accesorio para tapicer\u00edas con los que sacar\u00e1s a relucir tu casa.","2":"","3":"","4":""},"description_short":{"1":"210 W, 45 min, 20 kPa, Cabezal 360\u00ba, 1,55 kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":79.8456,"unit_price_tax":79.8456,"tax_rules_group":null,"category":"Limpieza","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1872\/102253\/83686023\/bg\/aspirador-vertical-cecotec-scoba-2100-twice-animal.jpg"],"wholesale_price":75.28}}},"6971693278189":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["