\/64253697\/bg\/ventilador-cpu-nox-hummer-h-123pro-pwm-rgb.jpg"],"wholesale_price":11.36}}},"8052101432251":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8052101432251",false],"wholesale_price":[470.33,false],"price":[482.7966,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189247","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b9a99ee68231a013571cb7f61d4972c3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"LB13534522","unit_price":482.7966,"category":"Baterias y fuentes de alimentaci\u00f3n","brand":"Ewent","name_pt":"ARMARIO DE CARGA EW1700 30 DISPOSITIVOS","quantity":0,"ean13":"8052101432251","description_short_pt":"Carro de carga - 30 dispositivos - Sistema de carga inteligente","description_pt":"El carro de carga EW1700 le permite proteger, almacenar y cargar f\u00e1cilmente hasta 30 dispositivos Tablets, Chromebook o port\u00e1tiles con pantallas de hasta 17\". Cuenta con un sistema de carga inteligente, estantes con ranuras para dispositivos flexibles y duraderas, un sistema de administraci\u00f3n de cables\/fuente de alimentaci\u00f3n y, lo mejor de todo, est\u00e1 completamente ensamblado para una implementaci\u00f3n r\u00e1pida. Adem\u00e1s, cuenta con espacios numerados para dispositivos y sus correspondientes espacios para suministro de energ\u00eda para optimizar la organizaci\u00f3n. El carro tambi\u00e9n cuenta con puertas ventiladas con un mecanismo de bloqueo con llave de 3 puntos y la opci\u00f3n de agregar su propio candado para mayor seguridad.","images":"https:\/\/www.dmi.es\/photo\/2763\/105075\/83390482\/bg\/armario-de-carga-ew1700-30-dispositivos.jpg","wholesale_price":"470.33","unit_price_tax":482.7966},"product_model":{"product_data":{"ean13":["8052101432251"],"reference":"LB13534522","name":{"1":"ARMARIO DE CARGA EW1700 30 DISPOSITIVOS","2":"","3":"","4":""},"description":{"1":"El carro de carga EW1700 le permite proteger, almacenar y cargar f\u00e1cilmente hasta 30 dispositivos Tablets, Chromebook o port\u00e1tiles con pantallas de hasta 17\". Cuenta con un sistema de carga inteligente, estantes con ranuras para dispositivos flexibles y duraderas, un sistema de administraci\u00f3n de cables\/fuente de alimentaci\u00f3n y, lo mejor de todo, est\u00e1 completamente ensamblado para una implementaci\u00f3n r\u00e1pida. Adem\u00e1s, cuenta con espacios numerados para dispositivos y sus correspondientes espacios para suministro de energ\u00eda para optimizar la organizaci\u00f3n. El carro tambi\u00e9n cuenta con puertas ventiladas con un mecanismo de bloqueo con llave de 3 puntos y la opci\u00f3n de agregar su propio candado para mayor seguridad.","2":"","3":"","4":""},"description_short":{"1":"Carro de carga - 30 dispositivos - Sistema de carga inteligente","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Ewent","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":482.7966,"unit_price_tax":482.7966,"tax_rules_group":null,"category":"Baterias y fuentes de alimentaci\u00f3n","brand":"Ewent","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/2763\/105075\/83390482\/bg\/armario-de-carga-ew1700-30-dispositivos.jpg"],"wholesale_price":470.33}}},"8435484081238":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484081238",false],"wholesale_price":[76.8,false],"price":[81.396,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189248","Cat. IDs: 145","Associated Categories","Cat. Default: 145","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/122853d68d8b10cac5bddad6bb06ff93.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO02330212","unit_price":81.396,"category":"Limpieza","brand":"Cecotec","name_pt":"ASPIRADOR DE COLCHONES CONGA 7000 MATTRESS","quantity":0,"ean13":"8435484081238","description_short_pt":"Cyclonic System, 700 W, 12 kPa, 5 m, UV-C Light","description_pt":"FORCESONIC 700 WAspirador de colchones y tapicer\u00edas con Tecnolog\u00eda ForceSonic, aumenta la potencia m\u00e1xima hasta los 700 W para acabar con toda la suciedad y al\u00e9rgenos.Elimina hasta el 99,9 % de bacteriasGracias a la luz ultravioleta incorporada de longitud de onda 253,7 nm elimina hasta el 99,9 % de los \u00e1caros y bacterias que se acumulan en las tapicer\u00edas y colchones. Acaba con los s\u00edntomas de la alergia de una pasada gracias a la luz UV-C.Tecnolog\u00eda de aire caliente que desinfectaTecnolog\u00eda de aire caliente Heat Tech que desinfecta y ayuda a eliminar los \u00e1caros y las bacterias de los colchones.Elimina los al\u00e9rgenos de tus colchonesIncluye la tecnolog\u00eda Power Brush con cepillo motorizado de cerdas y silicona que elimina los al\u00e9rgenos de tus colchones. Gracias al cepillo motorizado es capaz de extraer los al\u00e9rgenos m\u00e1s incrustados para poder succionarlos eficazmente.Absorbe los \u00e1caros y la suciedadGenera un gran poder de succi\u00f3n que llega hasta los 12 kPa que atrapan los \u00e1caros, al\u00e9rgenos y suciedad acumulados en los colchones o tapicer\u00edas.Elige tu limpieza: luz UV-C, cepillo motorizado o ambasElige la limpieza que prefieras gracias a la tecnolog\u00eda 3 Modes con 3 modos distintos. Podr\u00e1s elegir si quieres succionar con luz UV-C para acabar con las bacterias de tus colchones y tapicerias, succionar con cepillo motorizado si lo que quieres es eliminar los al\u00e9rgenos incrustados o una limpieza completa con succi\u00f3n, luz UV-C y cepillo motorizado para acabar con todo tipo de bacterias y al\u00e9rgenos.Gran radio de acci\u00f3n con cable de 5 mAspira con comodidad gracias al cable XXL de 5 metros. Aspira f\u00e1cilmente y con total libertad cualquier cama o sof\u00e1 sin necesidad de cambiar el cable de enchufe.Tecnolog\u00eda cicl\u00f3nica sin bolsasLa tecnolog\u00eda cicl\u00f3nica sin bolsas Cyclonic System mantiene la potencia de succi\u00f3n como el primer d\u00eda. Ofrece un resultado profesional en una sola pasada y una limpieza extrema y duradera.","images":"https:\/\/www.dmi.es\/photo\/1872\/104607\/87933889\/bg\/aspirador-de-colchones-conga-7000-mattress.jpg","wholesale_price":"76.80","unit_price_tax":81.396},"product_model":{"product_data":{"ean13":["8435484081238"],"reference":"HO02330212","name":{"1":"ASPIRADOR DE COLCHONES CONGA 7000 MATTRESS","2":"","3":"","4":""},"description":{"1":"FORCESONIC 700 WAspirador de colchones y tapicer\u00edas con Tecnolog\u00eda ForceSonic, aumenta la potencia m\u00e1xima hasta los 700 W para acabar con toda la suciedad y al\u00e9rgenos.Elimina hasta el 99,9 % de bacteriasGracias a la luz ultravioleta incorporada de longitud de onda 253,7 nm elimina hasta el 99,9 % de los \u00e1caros y bacterias que se acumulan en las tapicer\u00edas y colchones. Acaba con los s\u00edntomas de la alergia de una pasada gracias a la luz UV-C.Tecnolog\u00eda de aire caliente que desinfectaTecnolog\u00eda de aire caliente Heat Tech que desinfecta y ayuda a eliminar los \u00e1caros y las bacterias de los colchones.Elimina los al\u00e9rgenos de tus colchonesIncluye la tecnol