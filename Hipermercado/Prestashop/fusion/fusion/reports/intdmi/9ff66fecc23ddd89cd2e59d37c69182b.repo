es_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187667","Cat. IDs: 86","Associated Categories","Cat. Default: 86","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9d6afa28f17f56d716b2704e4877dc67.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA40358196","unit_price":146.29860000000002,"category":"Gaming","brand":"DRIFT","name_pt":"SILLA GAMING DRIFT DR110 NEGRO-VERDE","quantity":5,"ean13":"8436587973345","description_short_pt":"150 kg, Tela Fabric, Foam\/Estructura de metal, Reposabrazos 4D, Elevador class 4, 19.2 kg, Negro\/Verde","description_pt":"Reposabrazos 4DPara una comodidad m\u00e1xima, esta silla integra reposabrazos 4D acolchados y personalizados con el logo de Drift.Alta transpiraci\u00f3nLa DR110 es una silla para jugadores revestida de un tejido de tela muy suave, de manera que la transpiraci\u00f3n queda asegurada, manteni\u00e9ndose uno m\u00e1s fresco durante todo el d\u00eda, incluso en los meses m\u00e1s calurosos del a\u00f1o.Pist\u00f3n de gas de clase 4Su robusta base de metal de 70 cm con pist\u00f3n de gas de Clase 4 ofrece una gran resistencia, pudiendo admitir hasta un peso de 150 kilos.Desplazamiento silenciosoSus ruedas silenciosas de nailon y poliuretano, personalizadas con el logo de Drift, permiten un desplazamiento sin esfuerzo, controlando los movimientos.Ergonom\u00eda ganadoraLa DR110 cuenta con un mecanismo de mariposa que favorece una buena postura corporal.Altura regulablePodr\u00e1s ajustar la silla tambi\u00e9n en altura, de manera que la DR110 se adapta a tu espacio gaming o de trabajo sin complicaciones.Respaldo ajustableSi necesitas una breve siesta entre partida y partida para recuperar energ\u00eda, podr\u00e1s reclinar el respaldo hasta los 135 grados. Si\u00e9ntate o rel\u00e1jate, t\u00fa decides.Coj\u00edn lumbar y cervicalPara una sujeci\u00f3n ergon\u00f3mica, incluye tanto coj\u00edn lumbar como coj\u00edn cervical, de modo que puedas apoyar las partes m\u00e1s delicadas del cuerpo manteniendo una postura saludable.","images":"https:\/\/www.dmi.es\/photo\/4554\/95281\/71187508\/bg\/silla-gaming-drift-dr110-negro-verde.jpg","wholesale_price":"140.43","unit_price_tax":146.29860000000002},"product_model":{"product_data":{"ean13":["8436587973345"],"reference":"GA40358196","name":{"1":"SILLA GAMING DRIFT DR110 NEGRO-VERDE","2":"","3":"","4":""},"description":{"1":"Reposabrazos 4DPara una comodidad m\u00e1xima, esta silla integra reposabrazos 4D acolchados y personalizados con el logo de Drift.Alta transpiraci\u00f3nLa DR110 es una silla para jugadores revestida de un tejido de tela muy suave, de manera que la transpiraci\u00f3n queda asegurada, manteni\u00e9ndose uno m\u00e1s fresco durante todo el d\u00eda, incluso en los meses m\u00e1s calurosos del a\u00f1o.Pist\u00f3n de gas de clase 4Su robusta base de metal de 70 cm con pist\u00f3n de gas de Clase 4 ofrece una gran resistencia, pudiendo admitir hasta un peso de 150 kilos.Desplazamiento silenciosoSus ruedas silenciosas de nailon y poliuretano, personalizadas con el logo de Drift, permiten un desplazamiento sin esfuerzo, controlando los movimientos.Ergonom\u00eda ganadoraLa DR110 cuenta con un mecanismo de mariposa que favorece una buena postura corporal.Altura regulablePodr\u00e1s ajustar la silla tambi\u00e9n en altura, de manera que la DR110 se adapta a tu espacio gaming o de trabajo sin complicaciones.Respaldo ajustableSi necesitas una breve siesta entre partida y partida para recuperar energ\u00eda, podr\u00e1s reclinar el respaldo hasta los 135 grados. Si\u00e9ntate o rel\u00e1jate, t\u00fa decides.Coj\u00edn lumbar y cervicalPara una sujeci\u00f3n ergon\u00f3mica, incluye tanto coj\u00edn lumbar como coj\u00edn cervical, de modo que puedas apoyar las partes m\u00e1s delicadas del cuerpo manteniendo una postura saludable.","2":"","3":"","4":""},"description_short":{"1":"150 kg, Tela Fabric, Foam\/Estructura de metal, Reposabrazos 4D, Elevador class 4, 19.2 kg, Negro\/Verde","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"DRIFT","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":146.2986,"unit_price_tax":146.2986,"tax_rules_group":null,"category":"Gaming","brand":"DRIFT","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/4554\/95281\/71187508\/bg\/silla-gaming-drift-dr110-negro-verde.jpg"],"wholesale_price":140.43}}},"8436587973376":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587973376",false],"wholesale_price":[174.47,false],"price":[181.0194,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187668","Cat. IDs: 86","Associated Categories","Cat. Default: 86","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5279cb4fbc47320cd05d17ddc021542b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA40358199","unit_price":181.0194,"category":"Gaming","brand":"DRIFT","name_pt":"SILLA GAMING EXPERT DRIFT DR350 NEGRA-ROJA","quantity":0,"ean13":"8436587973376","description_short_pt":"150 kg, PU Texturizado, Foam\/Estructura de metal, Reposabrazos 4D personalizados, Elevador Clase 4, 23.1 kg, Negro\/Roja","description_pt":"Reposabrazos 4DPara disfrutar de las partidas sin fin, la DR350 cuenta con reposabrazos 4D ajustables tanto en altura, como \u00e1ngulo lateral, pudi\u00e9ndose regular tambi\u00e9n hacia delante y hacia atr\u00e1s, as\u00ed como hacia la izquierda o la derecha. Con acolchado extra en los reposabrazos, personalizados con el logo de Drift, esta silla para jugadores es la mejor aliada.Dise\u00f1o PremiumCuenta con una estructura robusta. Con FOAM de alta calidad y una densidad perfecta, la DR350 es una silla tan c\u00f3moda que no querr\u00e1s levantarte. Este asiento dise\u00f1ado para largas horas de juego o de trabajo ha sido construido con materiales premium, lo que asegura una gran durabilidad.Pist\u00f3n de gas de clase 4Todo en ella ha sido dise\u00f1ado para que puedas disfrutar de la mayor comodidad durante las partidas de tu juego favorito. Con un s\u00f3lido pist\u00f3n de gas de Clase 4, esta silla gaming soporta hasta 150 kilos y ser\u00e1 tu mejor support incluso en la situaci\u00f3n m\u00e1s dif\u00edcil de la batalla.Mu\u00e9vete donde y como quierasMejora tu rendimiento gracias a un desplazamiento silencioso y seguro. Gracias a sus ruedas de nailon y poliuretano, personalizadas con el logo de Drift, para que te sientas todo un PRO, podr\u00e1s moverte por cualquier superficie sin que te oiga el enemigo.Mecanismo de mariposaPara jugar, estudiar o trabajar, entre las funcionalidades de la Drift DR350 destaca el mecanismo de mariposa que integra, que posibilita un adecuado reparto del peso del cuerpo, mejorando tu rendimiento.Altura regulableAjusta la altura de la silla gaming DR350 para adecuarla a las necesidades de cada espacio.Respaldo ajustableAd\u00e1ptate a cualquier situaci\u00f3n gracias a su respaldo reclinable desde los 90 hasta los 135 grados: encontrar la postura perfecta en cada situaci\u00f3n te resultar\u00e1 de lo m\u00e1s sencillo.Apoyo lumbar & cervicalEsta silla de Drift incluye tanto coj\u00edn lumbar como cervical a juego para poder mantener siempre una postura correcta: la ergonom\u00eda de esta silla para gamers es m\u00e1xima.","images":"https:\/\/www.dmi.es\/photo\/4554\/95284\/69246481\/bg\/silla-gaming-expert-drift-dr350-negra-roja.jpg","wholesale_price":"174.47","unit_price_tax":181.0194},"product_model":{"product_data":{"ean13":["8436587973376"],"reference":"GA40358199","name":{"1":"SILLA GAMING EXPERT DRIFT DR350 NEGRA-ROJA","2":"","3":"","4":""},"description":{"1":"Reposabrazos 4DPara disfrutar de las partidas sin fin, la DR350 cuenta con reposabrazos 4D ajustables tanto en altura, como \u00e1ngulo lateral, pudi\u00e9ndose regular tambi\u00e9n hacia delante y hacia atr\u00e1s, as\u00ed como hacia la izquierda o la derecha. Con acolchado extra en los reposabrazos, personalizados con el logo de Drift, esta silla para jugadores es la mejor aliada.Dise\u00f1o PremiumCuenta con una estructura robusta. Con FOAM de alta calidad y una densidad perfecta, la DR350 es una silla tan c\u00f3moda que no querr\u00e1s levantarte. Este asiento dise\u00f1ado para largas horas de juego o de trabajo ha sido construido con materiales premium, lo que asegura una gran durabilidad.Pist\u00f3n de gas de clase 4Todo en ella ha sido dise\u00f1ado para que puedas disfrutar de la mayor comodidad durante las partidas de tu juego favorito. Con un s\u00f3lido pist\u00f3n de gas de Clase 4, esta silla gaming soporta hasta 150 kilos y ser\u00e1 tu mejor support incluso en la situaci\u00f3n m\u00e1s dif\u00edcil de la batalla.Mu\u00e9vete donde y como quierasMejora tu rendimiento gracias a un desplazamiento silencioso y seguro. Gracias a sus ruedas de nailon y poliuretano, personalizadas con el logo de Drift, para que te sientas todo un PRO, podr\u00e1s moverte por cualquier superficie sin que te oiga el enemigo.Mecanismo de mariposaPara jugar, estudiar o trabajar, entre las funcionalidades de la Drift DR350 destaca el mecanismo de mariposa que integra, que posibilita un adecuado reparto del peso del cuerpo, mejorando tu rendimiento.Altura regulableAjusta la altura de la silla gaming DR350 para adecuarla a las necesidades de cada espacio.Respaldo ajustableAd\u00e1ptate a cualquier situaci\u00f3n gracias a su respaldo reclinable desde los 90 hasta los 135 grados: encontrar la postura perfecta en cada situaci\u00f3n te resultar\u00e1 de lo m\u00e1s sencillo.Apoyo lumbar & cervicalEsta silla de Drift incluye tanto coj\u00edn lumbar como cervical a juego para poder mantener siempre una postura correcta: la ergonom\u00eda de esta silla para gamers es m\u00e1xima.","2":"","3":"","4":""},"description_short":{"1":"150 kg, PU Texturizado, Foam\/Estructura de metal, Reposabrazos 4D personalizados, Elevador Clase 4, 23.1 kg, Negro\/Roja","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"DRIFT","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":181.0194,"unit_price_tax":181.0194,"tax_rules_group":null,"category":"Gaming","brand":"DRIFT","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/4554\/95284\/69246481\/bg\/silla-gaming-expert-drift-dr350-negra-roja.jpg"],"wholesale_price":174.47}}},"8436556145759":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436556145759",false],"wholesale_price":[15.73,false],"price":[19.1046,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187669","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fc9b77fba5150e725e8f46e9bda13c12.jpg; <br>--------