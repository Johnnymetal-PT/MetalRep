ures",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189378","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/b748879ae5620baa891520bf19eddd40.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"OR62131193","unit_price":46.6446,"category":"Accesorios port\u00e1tiles","brand":"Targus","name_pt":"MALETIN PORTATIL TARGUS BALANCE ECO SMART 14\" BRIEFCASE NEGRO","quantity":0,"ean13":"5051794025484","description_short_pt":"La funda para port\u00e1til EcoSmart 14? ? Negro","description_pt":"La gama Balance? EcoSmart\u00ae de Targus es una alternativa respetuosa con el medio ambiente, fabricada con tela de materiales reciclados, como botellas de agua, componentes sin n\u00edquel y cremalleras reciclables. Los materiales resistentes a la intemperie resultan adecuados contra los elementos, por lo que su tecnolog\u00eda, sus accesorios y sus objetos personales est\u00e1n a salvo en el interior de la funda. El sistema SafePort\u00ae Sling Plus de Targus, dise\u00f1ado para adaptarse a pantallas de hasta 14?, suspende su port\u00e1til dentro de la bolsa para protegerlo contra da\u00f1os por ca\u00eddas gracias a un acolchado de calidad a los lados y en la parte delantera de su dispositivo. Un dise\u00f1o ergon\u00f3mico certificado garantiza la comodidad de transporte, y la correa Equalizer\u00ae se amolda a su hombro izquierdo o derecho y equilibra continuamente la distribuci\u00f3n del peso. Una gama de caracter\u00edsticas ajustables y c\u00f3modos puntos de contacto que cumple todas las expectativas en lo que a ergonom\u00eda se refiere. Organizaci\u00f3n y almacenamiento meticulosos con grandes bolsillos ocultos y una estaci\u00f3n de trabajo interior. Gama fabricada con materiales sensibles con el planeta y dise\u00f1ada pensando en la comodidad. Buena para usted. Buena para nuestro planeta.","images":"https:\/\/www.dmi.es\/photo\/1285\/67103\/26370082\/bg\/maletin-portatil-targus-balance-eco-smart-14--briefcase-negro.jpg","wholesale_price":"42.73","unit_price_tax":46.6446},"product_model":{"product_data":{"ean13":["5051794025484"],"reference":"OR62131193","name":{"1":"MALETIN PORTATIL TARGUS BALANCE ECO SMART 14\" BRIEFCASE NEGRO","2":"","3":"","4":""},"description":{"1":"La gama Balance? EcoSmart\u00ae de Targus es una alternativa respetuosa con el medio ambiente, fabricada con tela de materiales reciclados, como botellas de agua, componentes sin n\u00edquel y cremalleras reciclables. Los materiales resistentes a la intemperie resultan adecuados contra los elementos, por lo que su tecnolog\u00eda, sus accesorios y sus objetos personales est\u00e1n a salvo en el interior de la funda. El sistema SafePort\u00ae Sling Plus de Targus, dise\u00f1ado para adaptarse a pantallas de hasta 14?, suspende su port\u00e1til dentro de la bolsa para protegerlo contra da\u00f1os por ca\u00eddas gracias a un acolchado de calidad a los lados y en la parte delantera de su dispositivo. Un dise\u00f1o ergon\u00f3mico certificado garantiza la comodidad de transporte, y la correa Equalizer\u00ae se amolda a su hombro izquierdo o derecho y equilibra continuamente la distribuci\u00f3n del peso. Una gama de caracter\u00edsticas ajustables y c\u00f3modos puntos de contacto que cumple todas las expectativas en lo que a ergonom\u00eda se refiere. Organizaci\u00f3n y almacenamiento meticulosos con grandes bolsillos ocultos y una estaci\u00f3n de trabajo interior. Gama fabricada con materiales sensibles con el planeta y dise\u00f1ada pensando en la comodidad. Buena para usted. Buena para nuestro planeta.","2":"","3":"","4":""},"description_short":{"1":"La funda para port\u00e1til EcoSmart 14? ? Negro","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Targus","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":46.6446,"unit_price_tax":46.6446,"tax_rules_group":null,"category":"Accesorios port\u00e1tiles","brand":"Targus","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1285\/67103\/26370082\/bg\/maletin-portatil-targus-balance-eco-smart-14--briefcase-negro.jpg"],"wholesale_price":42.73}}},"8436587973079":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587973079",false],"wholesale_price":[8.91,false],"price":[12.1482,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189379","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2d9ef186aa04525a43c0eb4cc7fdaac4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"OP52356150","unit_price":12.1482,"category":"Refrigeraci\u00f3n","brand":"NOX","name_pt":"VENTILADOR NOX HUMMER ARGB 120 MM ESPEJO INFINITO","quantity":0,"ean13":"8436587973079","description_short_pt":"120 x 120 x 25mm, 1200 RPM, 23 dB, 5V - 12V, 150 g","description_pt":"Nox Hummer M-FAN es un eficiente ventilador de 120 mm que te ofrecer\u00e1 un excelente flujo de aire de una manera silenciosa y con una impactante iluminaci\u00f3n para que puedas personalizar tu setup: este es el ventilador ARGB definitivo con una est\u00e9tica diferencial y una eficiencia total.VENTILACI\u00d3N SUPERIORCon un dise\u00f1o con espejo infinito, Nox Hummer M-FAN es un ventilador de 120 x 120 x 25 mm con un total de 1200 RPM. Sus siete aspas aerodin\u00e1micas favorecen un buen caudal de aire con un ruido m\u00ednimo gracias al rodamiento hidr\u00e1ulico, que genera una baja fricci\u00f3n, funcionando el ventilador de una manera suave. El dise\u00f1o innovador permite evitar el sobrecalentamiento del equipo gracias a un flujo m\u00e1ximo de 35,5 CFM. Adem\u00e1s, este ventilador para PC con ARGB posee una alta durabilidad: tiene una vida \u00fatil de cuarenta mil horas.EFECTO ESPEJO ARGB INFINITOEste ventilador es perfecto para todo entusiasta de la iluminaci\u00f3n. Con un dise\u00f1o incre\u00edble, en el que destaca su centro con efecto espejo infinito, que se ilumina y gira sin parar, y unas aspas trasl\u00facidas, permite elegir entre 16,8 millones de impresionantes y vivos colores.Nox Hummer M-FAN, te posibilita reflejar tu estilo de juego al poder sincronizarlo con el resto de elementos de tu setup, personaliz\u00e1ndolo de manera \u00fanica y ayud\u00e1ndote a diferenciarte todav\u00eda m\u00e1s de tus rivales.DISE\u00d1O ESPECTACULARCon un dise\u00f1o impactante que contempla un marco cuadrado con esquinas engomadas antivibraci\u00f3n, para amortiguar el sonido, el Nox Hummer M-FAN ofrece un ruido bajo, siendo este de un m\u00e1ximo de 23 dB. Con este ventilador podr\u00e1s maximizar el enfriamiento sin sacrificar el silencio.INSTALACI\u00d3N SENCILLACon un equilibrio perfecto entre rendimiento y baja emisi\u00f3n sonora, Nox Hummer M-FAN es r\u00e1pido y f\u00e1cil de instalar ya que posee un cable de 550 mm para un montaje c\u00f3modo.","images":"https:\/\/www.dmi.es\/photo\/921\/90250\/64069750\/bg\/ventilador-nox-hummer-argb-120-mm-espejo-infinito.jpg","wholesale_price":"8.91","unit_price_tax":12.1482},"product_model":{"product_data":{"ean13":["8436587973079"],"reference":"OP52356150","name":{"1":"VENTILADOR NOX HUMMER ARGB 120 MM ESPEJO INFINITO","2":"","3":"","4":""},"description":{"1":"Nox Hummer M-FAN es un eficiente ventilador de 120 mm que te ofrecer\u00e1 un excelente flujo de aire de una manera silenciosa y con una impactante iluminaci\u00f3n para que puedas personalizar tu setup: este es el ventilador ARGB definitivo con una est\u00e9tica diferencial y una eficiencia total.VENTILACI\u00d3N SUPERIORCon un dise\u00f1o con espejo infinito, Nox Hummer M-FAN es un ventilador de 120 x 120 x 25 mm con un total de 1200 RPM. Sus siete aspas aerodin\u00e1micas favorecen un buen caudal de aire con un ruido m\u00ednimo gracias al rodamiento hidr\u00e1ulico, que genera una baja fricci\u00f3n, funcionando el ventilador de una manera suave. El dise\u00f1o innovador permite evitar el sobrecalentamiento del equipo gracias a un flujo m\u00e1ximo de 35,5 CFM. Adem\u00e1s, este ventilador para PC con ARGB posee una alta durabilidad: tiene una vida \u00fatil de cuarenta mil horas.EFECTO ESPEJO ARGB INFINITOEste ventilador es perfecto para todo entusiasta de la iluminaci\u00f3n. Con un dise\u00f1o incre\u00edble, en el que destaca su centro con efecto espejo infinito, que se ilumina y gira sin parar, y unas aspas trasl\u00facidas, permite elegir entre 16,8 millones de impresionantes y vivos colores.Nox Hummer M-FAN, te posibilita reflejar tu estilo de juego al poder sincronizarlo con el resto de elementos de tu setup, personaliz\u00e1ndolo de manera \u00fanica y ayud\u00e1ndote a diferenciarte todav\u00eda m\u00e1s de tus rivales.DISE\u00d1O ESPECTACULARCon un dise\u00f1o impactante que contempla un marco cuadrado con esquinas engomadas antivibraci\u00f3n, para amortiguar el sonido, el Nox Hummer M-FAN ofrece un ruido bajo, siendo este de un m\u00e1ximo de 23 dB. Con este ventilador podr\u00e1s maximizar el enfriamiento sin sacrificar el silencio.INSTALACI\u00d3N SENCILLACon un equilibrio perfecto entre rendimiento y baja emisi\u00f3n sonora, Nox Hummer M-FAN es r\u00e1pido y f\u00e1cil de instalar ya que posee un cable de 550 mm para un montaje c\u00f3modo.","2":"","3":"","4":""},"description_short":{"1":"120 x 120 x 25mm, 1200 RPM, 23 dB, 5V - 12V, 150 g","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":12.1482,"unit_price_tax":12.1482,"tax_rules_group":null,"category":"Refrigeraci\u00f3n","brand":"NOX","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/921\/90250\/64069750\/bg\/ventilador-nox-hummer-argb-120-mm-espejo-infinito.jpg"],"wholesale_price":8.91}}},"5051794002775":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5051794002775",false],"wholesale_price":[20.65,false],"price":[24.123,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189380","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c22d436191415431feb87553ca0c3db3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"OP72131012","unit_price":24.122999999999998,"category":"Perif\u00e9ricos","brand":"Targus","name_pt":"PUNTERO TARGUS AMP13EU INALAMBRICO","quantity":5,"ean13":"5051794002775","description_short_pt":"Laser Presentation Remote, 2.4GHz, USB","description_pt":"El presentador l\u00e1ser con control remoto de Targus cuenta con una disposici\u00f3n de botones clara e intuitiva, haciendo que sea f\u00e1cil hacer presentaciones. Gracias a su tecnolog\u00eda inal\u00e1mbrica de 2,4 GHz podr\u00e1 moverse libremente por la sala y controlar su presentaci\u00f3n de Microsoft PowerPoint? o de Apple Keynote? de forma remota, sin cables molestos. La tecnolog\u00eda KeyLock?, pendiente de patente, permite bloquear los botones no esenciales para eliminar la posibilidad de pulsarlos por error. El puntero l\u00e1ser integrado permite al presentador resaltar el contenido importante mientras que los botones se iluminan y proporcionan visibilidad en entornos con poca luz. La tecnolog\u00eda de radiofrecuencia de 2,4 GHz m\u00e1s avanzada funciona desde un alcance de 15 metros, para proporcionar flexibilidad a la hora de hacer presentaciones en salas de conferencias o aulas grandes. El minirreceptor USB se guarda dentro del control remoto cuando no se usa, para m\u00e1s comodidad, para que no se pierda ni estropee. Ya no tiene que preocuparse de quedarse sin pilas a mitad de la presentaci\u00f3n. En caso de que la pila AAA Energizer\u00ae MAX\u00ae se acabe, el dispositivo cuenta con un compartimento donde puede guardar una pila de repuesto. El presentador con control remoto de Targus es elegante y funcional. La herramienta esencial para conseguir una presentaci\u00f3n perfecta.-Funcionalidad: su disposici\u00f3n clara e intuitiva permite a los usuarios abrir y ejecutar la presentaci\u00f3n con facilidad. El puntero l\u00e1ser permite se\u00f1alar con facilidad el contenido de la presentaci\u00f3n mientras que los botones se iluminan y permiten realizar la presentaci\u00f3n en salas con poca luz.-Pr\u00e1ctico: dise\u00f1ado para acomodarse a la mano de forma natural y c\u00f3moda mientras hace la presentaci\u00f3n.-Tecnolog\u00eda KeyLock?: esta tecnolog\u00eda, pendiente de patente, permite bloquear los botones no esenciales para eliminar la posibilidad de pulsarlos por error.-Inal\u00e1mbrico: tecnolog\u00eda inal\u00e1mbrica de 2,4 GHz, con un alcance de hasta 15 m para m\u00e1s flexibilidad. El receptor USB se guarda dentro del presentador.-Compatibilidad: requiere un puerto USB, dispositivo plug-and-play, no requiere drivers. Compatible con PC, Mac y Netbook.","images":"https:\/\/www.dmi.es\/photo\/196\/71429\/13824747\/bg\/puntero-targus-amp13eu-inalambrico.jpg","wholesale_price":"20.65","unit_price_tax":24.122999999999998},"product_model":{"product_data":{"ean13":["5051794002775"],"reference":"OP72131012","name":{"1":"PUNTERO TARGUS AMP13EU INALAMBRICO","2":"","3":"","4":""},"description":{"1":"El presentador l\u00e1ser con control remoto de Targus cuenta con una disposici\u00f3n de botones clara e intuitiva, haciendo que sea f\u00e1cil hacer presentaciones. Gracias a su tecnolog\u00eda inal\u00e1mbrica de 2,4 GHz podr\u00e1 moverse libremente por la sala y controlar su presentaci\u00f3n de Microsoft PowerPoint? o de Apple Keynote? de forma remota, sin cables molestos. La tecnolog\u00eda KeyLock?, pendiente de patente, permite bloquear los botones no esenciales para eliminar la posibilidad de pulsarlos por error. El puntero l\u00e1ser integrado permite al presentador resaltar el contenido importante mientras que los botones se iluminan y proporcionan visibilidad en entornos con poca luz. La tecnolog\u00eda de radiofrecuencia de 2,4 GHz m\u00e1s avanzada funciona desde un alcance de 15 metros, para proporcionar flexibilidad a la hora de hacer presentaciones en salas de conferencias o aulas grandes. El minirreceptor USB se guarda dentro del control remoto cuando no se usa, para m\u00e1s comodidad, para que no se pierda ni estropee. Ya no tiene que preocuparse de quedarse sin pilas a mitad de la presentaci\u00f3n. En caso de que la pila AAA Energizer\u00ae MAX\u00ae se acabe, el dispositivo cuenta con un compartimento donde puede guardar una pila de repuesto. El presentador con control remoto de Targus es elegante y funcional. La herramienta esencial para conseguir una presentaci\u00f3n perfecta.-Funcionalidad: su disposici\u00f3n clara e intuitiva permite a los usuarios abrir y ejecutar la presentaci\u00f3n con facilidad. El puntero l\u00e1ser permite se\u00f1alar con facilidad el contenido de la presentaci\u00f3n mientras que los botones se iluminan y permiten realizar la presentaci\u00f3n en salas con poca luz.-Pr\u00e1ctico: dise\u00f1ado para acomodarse a la mano de forma natural y c\u00f3moda mientras hace la presentaci\u00f3n.-Tecnolog\u00eda KeyLock?: esta tecnolog\u00eda, pendiente de patente, permite bloquear los botones no esenciales para eliminar la posibilidad de pulsarlos por error.-Inal\u00e1mbrico: tecnolog\u00eda inal\u00e1mbrica de 2,4 GHz, con un alcance de hasta 15 m para m\u00e1s flexibilidad. El receptor USB se guarda dentro del presentador.-Compatibilidad: requiere un puerto USB, dispositivo plug-and-play, no requiere drivers. Compatible con PC, Mac y Netbook.","2":"","3":"","4":""},"description_short":{"1":"Laser Presentation Remote, 2.4GHz, USB","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Targus","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":24.123,"unit_price_tax":24.123,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Targus","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/196\/71429\/13824747\/bg\/puntero-targus-amp13eu-inalambrico.jpg"],"wholesale_price":20.65}}},"4711387299401":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4711387299401",false],"wholesale_price":[301.42,false],"price":[310.5084,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189381","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/82dc2f91bfbeb06937d33cb871f15633.jpg; <br>-------------------------------"],"