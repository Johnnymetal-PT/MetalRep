aciones en el trabajo, no hemos puesto en compromiso ninguna de sus funciones. Aunque el acabado blanco de la superficie es en s\u00ed llamativo, tambi\u00e9n despliega toda la iluminaci\u00f3n RGB llev\u00e1ndola a su m\u00e1ximo potencial. Adem\u00e1s, el software descargable proporciona cualquier tipo de reajuste requerido. SWITCHES ROJOS (interruptores): lineales con punto de conexi\u00f3n indetectable y clic point indetectable tambi\u00e9n.","2":"","3":"","4":""},"description_short":{"1":"ES LAYOUT (disposici\u00f3n de teclas espa\u00f1ola), mec\u00e1nico, switches Kailh, full-size (100%), iluminaci\u00f3n RGB, memoria integrada (10KB), USB, Negro, 1,46 kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Sharkoon","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":47.5626,"unit_price_tax":47.5626,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Sharkoon","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/194\/85022\/56063970\/bg\/teclado-gaming-sharkoon-sgk3-mecanico-rgb-usb-red-switch-blanco.jpg"],"wholesale_price":43.63}}},"8436587972027":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587972027",false],"wholesale_price":[19.9,false],"price":[23.358,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185299","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/711f12fc5b2da3a6a6910747be071c8e.jpg; <br>-----------