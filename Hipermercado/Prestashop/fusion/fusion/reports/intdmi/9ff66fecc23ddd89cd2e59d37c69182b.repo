tmp\/6d89a94fee90fcc0994a49a38890098d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CN43534043","unit_price":9.0576,"category":"Lectores","brand":"Ewent","name_pt":"LECTOR DE TARJETAS EWENT SMART CARD ID USB TIPO C","quantity":5,"ean13":"8054392612343","description_short_pt":"Lector de DNI electr\u00f3nicos y tarjetas inteligentes USB-C","description_pt":"\u00bfNecesita un lector de tarjetas para su DNI electr\u00f3nico o tarjeta inteligente? El lector compacto de tarjetas inteligentes USB-C Ewent EW1055 le permite leer su DNI electr\u00f3nico o tarjeta inteligente de manera sencilla y segura en cualquier lugar. El lector de tarjetas inteligentes cuenta con una interfaz USB-C y es compatible con Windows y macOS.Admite todas las tarjetas inteligentes comunesEl lector de tarjetas inteligentes est\u00e1 dise\u00f1ado para cumplir todos los est\u00e1ndares y especificaciones principales de tarjetas inteligentes en formato de tarjeta ID-1, incluidas las tarjetas de identificaci\u00f3n personal. El lector de tarjetas se pueda utilizar para e-Commerce, e-Business, firmas digitales, autenticaci\u00f3n y protecci\u00f3n de acceso. El lector EW1055 cuenta con la homologaci\u00f3n CAC y es compatible con PC\/SC y WHQL.Equipado con interfaz USB-CEl lector de tarjetas inteligentes USB EW1055 est\u00e1 equipado con un conector USB-C y es adecuado para Windows y macOS. El lector de tarjetas se alimenta a trav\u00e9s de USB.","images":"https:\/\/www.dmi.es\/photo\/1754\/102706\/49942063\/bg\/lector-de-tarjetas-ewent-smart-card-id-usb-tipo-c.jpg","wholesale_price":"5.88","unit_price_tax":9.0576},"product_model":{"product_data":{"ean13":["8054392612343"],"reference":"CN43534043","name":{"1":"LECTOR DE TARJETAS EWENT SMART CARD ID USB TIPO C","2":"","3":"","4":""},"description":{"1":"\u00bfNecesita un lector de tarjetas para su DNI electr\u00f3nico o tarjeta inteligente? El lector compacto de tarjetas inteligentes USB-C Ewent EW1055 le permite lee