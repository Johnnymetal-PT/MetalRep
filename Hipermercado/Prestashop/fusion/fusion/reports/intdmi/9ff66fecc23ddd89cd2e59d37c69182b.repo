lesale_price":"22.20","unit_price_tax":25.704},"product_model":{"product_data":{"ean13":["8435484038997"],"reference":"CO07330060","name":{"1":"XQUEEZE RETROJUICE 600 RED","2":"","3":"","4":""},"description":{"1":"- 600 W de potencia: exprimidor el\u00e9ctrico de brazo para c\u00edtricos que exprime de forma r\u00e1pida y sencilla aprovechando al m\u00e1ximo la fruta.- Filtro de acero inoxidable: dispositivo que maximiza los sabores y facilita la limpieza.- Exprime c\u00edtricos grandes y peque\u00f1os: sus dos conos de pl\u00e1stico desmontables sirven tanto para c\u00edtricos grandes como para peque\u00f1os.- Palanca de presi\u00f3n: extrae tus zumos sin esfuerzo.- Sistema de extracci\u00f3n continua: vierte el zumo directamente al vaso de forma f\u00e1cil y c\u00f3moda.- Sistema antigoteo: permite un vertido m\u00e1s f\u00e1cil y limpio.- Apto para lavavajillas: limpia sus piezas desmontables en el lavavajillas.","2":"","3":"","4":""},"description_short":{"1":"600 W, 220-240 V, 50\/60 Hz, Red","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":25.704,"unit_price_tax":25.704,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1406\/104643\/87927620\/bg\/xqueeze-retrojuice-600-red.jpg"],"wholesale_price":22.2}}},"8435484080392":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484080392",false],"wholesale_price":[22.43,false],"price":[25.9386,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188809","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0a2a609653ba1efdfd7e7670b102e469.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO09330079","unit_price":25.9386,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"TOSTADORA VERTICAL RETROVISION BLUE","quantity":0,"ean13":"8435484080392","description_short_pt":"700 W, 220 - 240 V, 50-60 Hz, blue","description_pt":"Saborea desayunos completos.Gracias a las dos ranuras extra anchas del tostador podr\u00e1s introducir panes del grosor que quieras. Disfruta de desayunos completos y deliciosos con sus 700 W de potencia con los que podr\u00e1s tostar r\u00e1pidamente tu pan preferido de la mejor manera.No m\u00e1s tostadas quemadas.La tostadora expulsar\u00e1 autom\u00e1ticamente tus tostadas cuando el tiempo haya finalizado y se apagar\u00e1 autom\u00e1ticamente, evitando que tus panes se quemen.Tostado uniforme, tostado perfecto.El sistema de autocentrado tuesta el pan de manera uniforme por ambas caras para que puedas disfrutar de unas tostadas crujientes y perfectas. Elige entre sus 5 posiciones de tostado y consigue resultados a tu gusto.Controla todo el proceso.Gracias a la ventana de visualizaci\u00f3n de tu tostador vintage, podr\u00e1s controlar en todo momento tu tostada a la vez que le das un toque dise\u00f1o a tu hogar con la colecci\u00f3n retro m\u00e1s completa.- 2 ranuras extra-anchas: la tostadora cuenta con dos ranuras que permiten introducir panes gruesos o de gran tama\u00f1o.- Visualizaci\u00f3n: valora f\u00e1cilmente el proceso de tostado gracias a su dise\u00f1o con ventana.- Cubierta antipolvo: evita que la suciedad entre en el producto tap\u00e1ndolo con su cubierta.- Sistema de auto-centrado: consigue un tostado uniforme por las dos caras.- Potencia regulable: elige entre sus 5 posiciones de tostado para un resultado al gusto.- Apagado y pop-up autom\u00e1tico: bajada y elevaci\u00f3n de la tostada de forma autom\u00e1tica al inicio y fin del programa.- Dise\u00f1o retro: ofr\u00e9cele a tu cocina un toque vintage gracias al dise\u00f1o retro de tu tostadora.- 700 W de potencia: disfruta del alto rendimiento de tu tostadora.","images":"https:\/\/www.dmi.es\/photo\/1318\/104645\/87931883\/bg\/tostadora-vertical-retrovision-blue.jpg","wholesale_price":"22.43","unit_price_tax":25.9386},"product_model":{"product_data":{"ean13":["8435484080392"],"reference":"CO09330079","name":{"1":"TOSTADORA VERTICAL RETROVISION BLUE","2":"","3":"","4":""},"description":{"1":"Saborea desayunos completos.Gracias a las dos ranuras extra anchas del tostador podr\u00e1s introducir panes del grosor que quieras. Disfruta de desayunos completos y deliciosos con sus 700 W de potencia con los que podr\u00e1s tostar r\u00e1pidamente tu pan preferido de la mejor manera.No m\u00e1s tostadas quemadas.La tostadora expulsar\u00e1 autom\u00e1ticamente tus tostadas cuando el tiempo haya finalizado y se apagar\u00e1 autom\u00e1ticamente, evitando que tus panes se quemen.Tostado uniforme, tostado perfecto.El sistema de autocentrado tuesta el pan de manera uniforme por ambas caras para que puedas disfrutar de unas tostadas crujientes y perfectas. Elige entre sus 5 posiciones de tostado y consigue resultados a tu gusto.Controla todo el proceso.Gracias a la ventana de visualizaci\u00f3n de tu tostador vintage, podr\u00e1s controlar en todo momento tu tostada a la vez que le das un toque dise\u00f1o a tu hogar con la colecci\u00f3n retro m\u00e1s completa.- 2 ranuras extra-anchas: la tostadora cuenta con dos ranuras que permiten introducir panes gruesos o de gran tama\u00f1o.- Visualizaci\u00f3n: valora f\u00e1cilmente el proceso de tostado gracias a su dise\u00f1o con ventana.- Cubierta antipolvo: evita que la suciedad entre en el producto tap\u00e1ndolo con su cubierta.- Sistema de auto-centrado: consigue un tostado uniforme por las dos caras.- Potencia regulable: elige entre sus 5 posiciones de tostado para un resultado al gusto.- Apagado y pop-up autom\u00e1tico: bajada y elevaci\u00f3n de la tostada de forma autom\u00e1tica al inicio y fin del programa.- Dise\u00f1o retro: ofr\u00e9cele a tu cocina un toque vintage gracias al dise\u00f1o retro de tu tostadora.- 700 W de potencia: disfruta del alto rendimiento de tu tostadora.","2":"","3":"","4":""},"description_short":{"1":"700 W, 220 - 240 V, 50-60 Hz, blue","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":25.9386,"unit_price_tax":25.9386,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1318\/104645\/87931883\/bg\/tostadora-vertical-retrovision-blue.jpg"],"wholesale_price":22.43}}},"8054392618550":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8054392618550",false],"wholesale_price":[1.06,false],"price":[4.1412,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188810","Cat. IDs: 122","Associated Categories","Cat. Default: 122","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/af6192fdb718f51aadc07cd198f68998.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CA20