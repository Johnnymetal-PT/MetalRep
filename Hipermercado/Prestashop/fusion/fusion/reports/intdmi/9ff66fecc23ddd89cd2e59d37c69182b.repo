jo m\u00e1s potente y productiva con la base de conexi\u00f3n Targus USB-C? DisplayPort? Alt. Mode con alimentaci\u00f3n de 85 W. Elegante y potente, esta base incluye todos los puertos y la potencia que necesitas en un solo aparato. Dise\u00f1ada para ser compatible con una amplia variedad de marcas de port\u00e1tiles y sistemas operativos, la DOCK430 ofrece una amplia compatibilidad para una amplia gama de dispositivos anfitriones, dispositivos gen\u00e9ricos y perif\u00e9ricos.","images":"https:\/\/www.dmi.es\/photo\/152\/103681\/34838148\/bg\/docking-station-targus-triple-hd-85w.jpg","wholesale_price":"155.56","unit_price_tax":161.7312},"product_model":{"product_data":{"ean13":["5051794028843"],"reference":"PT91131213","name":{"1":"DOCKING STATION TARGUS TRIPLE HD 85W","2":"","3":"","4":""},"description":{"1":"Crea una estaci\u00f3n de trabajo m\u00e1s potente y productiva con la base de conexi\u00f3n Targus USB-C? DisplayPort? Alt. Mode con alimentaci\u00f3n de 85 W. Elegante y potente, esta base incluye todos los puertos y la potencia que necesitas en un solo aparato. Dise\u00f1ada para ser compatible con una amplia variedad de marcas de port\u00e1tiles y sistemas operativos, la DOCK430 ofrece una amplia compatibilidad para una amplia gama de dispositivos anfitriones, dispositivos gen\u00e9ricos y perif\u00e9ricos.","2":"","3":"","4":""},"description_short":{"1":"Base de conexi\u00f3n con puerto multifunci\u00f3n USB-C? DisplayPort? Alt. Mode con capacidad triple de v\u00eddeo y alimentaci\u00f3n de 85 W","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Targus","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":161.7312,"unit_price_tax":161.7312,"tax_rules_group":null,"category":"Accesorios port\u00e1tiles","brand":"Targus","quantity":