s controles f\u00e1ciles de usar para ajustar con precisi\u00f3n su hardware y lograr un rendimiento \u00f3ptimo del ordenador.ILUMINA TU PCPon un poco de color y efectos de iluminaci\u00f3n RGB utilizando MSI Mystic Light con 16,8 millones de colores y efectos LED de fantas\u00eda. MSI Mystic Light le proporciona un control completo de la iluminaci\u00f3n RGB de su PC en un solo software.","2":"","3":"","4":""},"description_short":{"1":"360 mm, 4-pin, ARGB, 20 dBA, 3000 RPM, 394 x 119.2 x 27mm","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MSI","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":109.9764,"unit_price_tax":109.9764,"tax_rules_group":null,"category":"Refrigeraci\u00f3n","brand":"MSI","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/921\/105210\/81761544\/bg\/refrigeracion-liquida-msi-mag-coreliquid-e360-white.jpg"],"wholesale_price":104.82}}},"5425025591732":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5425025591732",false],"wholesale_price":[45.29,false],"price":[49.2558,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190458","Cat. IDs: 7","Associated Categories","Cat. Default: 7","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/afe15e7328ca802201bf1d1e72ea4984.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA30517052","unit_price":49.2558,"category":"Videojuegos, Consolas y Accesorios","brand":"EgoGear","name_pt":"PACK EGOGEAR