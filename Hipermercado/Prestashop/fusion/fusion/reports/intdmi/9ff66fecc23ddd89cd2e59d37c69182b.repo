rs-silver.jpg"],"wholesale_price":158.06}}},"4710474830824":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4710474830824",false],"wholesale_price":[244.75,false],"price":[252.705,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189413","Cat. IDs: 98","Associated Categories","Cat. Default: 98","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e4508833843743c4cac34cb298694cf3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HD33512181","unit_price":252.705,"category":"Discos duros internos","brand":"Asustor","name_pt":"CARCASA DISCO DURO IX0141-BW3S10 SSD NEGRO 2.5\/3.5","quantity":0,"ean13":"4710474830824","description_short_pt":"4x 2.5\/3.5\" HDD\/SSD, USB 3.0 B, 90 W PSU, 100-240 V, 185.5x170x230 mm, ADM 3.0","description_pt":"Simplemente con\u00e9cteloEl AS6004U utiliza un cable de conexi\u00f3n USB 3.0. Simplemente con\u00e9ctelo a cualquier ASUSTOR NAS para completar la expansi\u00f3n del hardware. Dependiendo del modelo, los dispositivos ASUSTOR NAS pueden conectar simult\u00e1neamente hasta 3 unidades AS6004U, satisfaciendo las demandas de almacenamiento de alta capacidad de los usuarios empresariales.Soporte de seguridad para conexiones segurasEl soporte de seguridad y el dise\u00f1o del orificio de montaje permiten que el AS6004U y el cable USB se conecten de forma segura sin tener que preocuparse por las desconexiones.Cierre de seguridad en las bandejas de los discosCon el fin de ayudar a los usuarios a evitar la extracci\u00f3n de los discos duros accidentalmente pulsando los botones de la bandeja de los discos durante el funcionamiento, ASUSTOR ha a\u00f1adido un nuevo mecanismo de bloqueo a sus bandejas de disco duro. El dise\u00f1o de punta plana de la cerradura asegura que los usuarios no necesitar\u00e1n ninguna llave especial o herramientas para desbloquearlo, solamente un destornillador de cabeza plana. Las nuevas bandejas de los discos se pueden utilizar con todos los dispositivos NAS de ASUSTOR, proporcionando una capa adicional de seguridad para aplicaciones que requieren el intercambio frecuente de los discos duros (por ejemplo, MyArchive).Ahorro inteligente de energ\u00edaEl AS6004U tiene un mecanismo de sincronizaci\u00f3n de energ\u00eda que lo sincroniza con el estado de operaci\u00f3n del NAS. Cuando el NAS entra en el modo de suspensi\u00f3n o se apaga, el AS6004U entrar\u00e1 en modo de espera. Cuando el NAS vuelva a funcionar normalmente, el AS6004U volver\u00e1 a montarse. Esta funci\u00f3n ayuda a los usuarios a ahorrar energ\u00eda significativamente.Control inteligente de la temperatura del ventiladorBajo cargas pesadas y operaciones, la temperatura interna del sistema aumentar\u00e1. El AS6004U utiliza ventiladores con un amplio rango de velocidad que soportan una funci\u00f3n de control de temperatura combinada con un mecanismo de velocidad inteligente. Cuando la carga del sistema y la temperatura aumenta, los ventiladores aumentar\u00e1n autom\u00e1ticamente su velocidad para enfriar el dispositivo permitiendo que el sistema mantenga una temperatura de funcionamiento adecuada, proporcionando un rendimiento estable y servicio.Almacenamiento seguroEl AS6004U cuenta con 4 compartimentos de disco intercambiables en caliente y es compatible con los discos duros m\u00e1s grandes del mercado. Soporta RAID y cifrado AES de 256 bits, proporcionando mecanismos \u00f3ptimos de protecci\u00f3n de datos.Expansi\u00f3n y copia de seguridad de almacenamiento flexibleAdem\u00e1s de proporcionar un espacio de almacenamiento econ\u00f3mico de gran capacidad, la AS6004U tambi\u00e9n es compatible con la tecnolog\u00eda de copia de seguridad en fr\u00edo MyArchive de ASUSTOR. Esto permite a los usuarios crear archivos de almacenamiento extra\u00edbles en cualquier momento y copiar datos importantes a ellos.Garant\u00eda de Producto de Primera ClaseTodos los productos ASUSTOR NAS vienen con una garant\u00eda de 3 a\u00f1os. ASUSTOR contin\u00faa haciendo del servicio al cliente su prioridad al proporcionar el m\u00e1s alto nivel de servicio postventa y soporte t\u00e9cnico.","images":"https:\/\/www.dmi.es\/photo\/862\/100957\/22645836\/bg\/carcasa-disco-duro-ix0141-bw3s10-ssd-negro-2-5-3-5.jpg","wholesale_price":"244.75","unit_price_tax":252.705},"product_model":{"product_data":{"ean13":["4710474830824"],"reference":"HD33512181","name":{"1":"CARCASA DISCO DURO IX0141-BW3S10 SSD NEGRO 2.5\/3.5","2":"","3":"","4":""},"description":{"1":"Simplemente con\u00e9cteloEl AS6004U utiliza un cable de conexi\u00f3n USB 3.0. Simplemente con\u00e9ctelo a cualquier ASUSTOR NAS para completar la expansi\u00f3n del hardware. Dependiendo del modelo, los dispositivos ASUSTOR NAS pueden conectar simult\u00e1neamente hasta 3 unidades AS6004U, satisfaciendo las demandas de almacenamiento de alta capacidad de los usuarios empresariales.Soporte de seguridad para conexiones segurasEl soporte de seguridad y el dise\u00f1o del orificio de montaje permiten que el AS6004U y el cable USB se conecten de forma segura sin tener que preocuparse por las desconexiones.Cierre de seguridad en las bandejas de los discosCon el fin de ayudar a los usuarios a evitar la extracci\u00f3n de los discos duros accidentalmente pulsando los botones de la bandeja de los discos durante el funcionamiento, ASUSTOR ha a\u00f1adido un nuevo mecanismo de bloqueo a sus bandejas de disco duro. El dise\u00f1o de punta plana de la cerradura asegura que los usuarios no necesitar\u00e1n ninguna llave especial o herramientas para desbloquearlo, solamente un destornillador de cabeza plana. Las nuevas bandejas de los discos se pueden utilizar con todos los dispositivos NAS de ASUSTOR, proporcionando una capa adicional de seguridad para aplicaciones que requieren el intercambio frecuente de los discos duros (por ejemplo, MyArchive).Ahorro inteligente de energ\u00edaEl AS6004U tiene un mecanismo de sincronizaci\u00f3n de energ\u00eda que lo sincroniza con el estado de operaci\u00f3n del NAS. Cuando el NAS entra en el modo de suspensi\u00f3n o se apaga, el AS6004U entrar\u00e1 en modo de espera. Cuando el NAS vuelva a funcionar normalmente, el AS6004U volver\u00e1 a montarse. Esta funci\u00f3n ayuda a los usuarios a ahorrar energ\u00eda significativamente.Control inteligente de la temperatura del ventiladorBajo cargas pesadas y operaciones, la temperatura interna del sistema aumentar\u00e1. El AS6004U utiliza ventiladores con un amplio rango de velocidad que soportan una funci\u00f3n de control de temperatura combinada con un mecanismo de velocidad inteligente. Cuando la carga del sistema y la temperatura aumenta, los ventiladores aumentar\u00e1n autom\u00e1ticamente su velocidad para enfriar el dispositivo permitiendo que el sistema mantenga una temperatura de funcionamiento adecuada, proporcionando un rendimiento estable y servicio.Almacenamiento seguroEl AS6004U cuenta con 4 compartimentos de disco intercambiables en caliente y es compatible con los discos duros m\u00e1s grandes del mercado. Soporta RAID y cifrado AES de 256 bits, proporcionando mecanismos \u00f3ptimos de protecci\u00f3n de datos.Expansi\u00f3n y copia de seguridad de almacenamiento flexibleAdem\u00e1s de proporcionar un espacio de almacenamiento econ\u00f3mico de gran capacidad, la AS6004U tambi\u00e9n es compatible con la tecnolog\u00eda de copia de seguridad en fr\u00edo MyArchive de ASUSTOR. Esto permite a los usuarios crear archivos de almacenamiento extra\u00edbles en cualquier momento y copiar datos importantes a ellos.Garant\u00eda de Producto de Primera ClaseTodos los productos ASUSTOR NAS vienen con una garant\u00eda de 3 a\u00f1os. A