\/public_html\/img\/tmp\/3afd6d893131a72b0e2a3dc02a1b1e68.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PE40131083","unit_price":52.632000000000005,"category":"Perif\u00e9ricos","brand":"Targus","name_pt":"WEBCAM TARGUS FHD 1080P CON TAPA DE PRIVACIDAD","quantity":5,"ean13":"5051794036541","description_short_pt":"Full HD 1080p, CMOS, f\/2.5, 78 x 43 x 55 mm, 100 g","description_pt":"Con\u00e9ctese al mundo en Full HD con la Targus\u00ae Webcam Plus - Webcam Full HD 1080p con enfoque autom\u00e1tico. Un paso m\u00e1s all\u00e1 de las t\u00edpicas webcams para port\u00e1tiles gracias a su lente de gran apertura, su censor CMOS y su correcci\u00f3n autom\u00e1tica de la iluminaci\u00f3n, que trabajan al un\u00edsono para garantizar un v\u00eddeo Full HD de alta calidad incluso con una luz poco \u00f3ptima. Adem\u00e1s, la tecnolog\u00eda de autoenfoque te mantiene n\u00edtido en el encuadre en todo momento, por lo que ya no apareces como un avatar borroso y difuso en la pantalla, ideal para los profesionales que trabajan en casa y exigen videoconferencias de alta calidad.Con un \u00e1ngulo de visi\u00f3n de 67 grados, es adecuado para encuadrar la cabeza y los hombros, adem\u00e1s de espacio para un colega m\u00e1s, sin incluir demasiadas distracciones de fondo. El soporte de libre inclinaci\u00f3n permite colocar e inclinar la c\u00e1mara web para encontrar el \u00e1ngulo m\u00e1s c\u00f3modo. El micr\u00f3fono con reducci\u00f3n de ruido integrado minimiza los sonidos ambientales para garantizar que se escuche tan bien como se ve, adem\u00e1s, como ventaja adicional, la c\u00e1mara web incluye un soporte para tr\u00edpode para que pueda colocar la c\u00e1mara lejos del PC, perfecto para profesores, blogueros y personas influyentes que deseen transmitir en vivo.Compatible con la mayor\u00eda de los programas de videoconferencia y con una sencilla conexi\u00f3n plug-and-play a trav\u00e9s de USB, la Webcam Plus de Targus\u00ae es ideal para cualquiera que desee mejorar la calidad de v\u00eddeo oscura y de baja resoluci\u00f3n de las t\u00edpicas c\u00e1maras web de los port\u00e1tiles.","images":"https:\/\/www.dmi.es\/photo\/577\/88770\/61202934\/bg\/webcam-targus-fhd-1080p-con-tapa-de-privacidad.jpg","wholesale_price":"48.60","unit_price_tax":52.632000000000005},"product_model":{"product_data":{"ean13":["5051794036541"],"reference":"PE40131083","name":{"1":"WEBCAM TARGUS FHD 1080P CON TAPA DE PRIVACIDAD","2":"","3":"","4":""},"description":{"1":"Con\u00e9ctese al mundo en Full HD con la Targus\u00ae Webcam Plus - Webcam Full HD 1080p con enfoque autom\u00e1tico. Un paso m\u00e1s all\u00e1 de las t\u00edpicas webcams para port\u00e1tiles gracias a su lente de gran apertura, su censor CMOS y su correcci\u00f3n autom\u00e1tica de la iluminaci\u00f3n, que trabajan al un\u00edsono para garantizar un v\u00eddeo Full HD de alta calidad incluso con una luz poco \u00f3ptima. Adem\u00e1s, la tecnolog\u00eda de autoenfoque te mantiene n\u00edtido en el encuadre en todo momento, por lo que ya no apareces como un avatar borroso y difuso en la pantalla, ideal para los profesionales que trabajan en casa y exigen videoconferencias de alta calidad.Con un \u00e1ngulo de visi\u00f3n de 67 grados, es adecuado para encuadrar la cabeza y los hombros, adem\u00e1s de espacio para un colega m\u00e1s, sin incluir demasiadas distracciones de fondo. El soporte de libre inclinaci\u00f3n permite colocar e inclinar la c\u00e1mara web para encontrar el \u00e1ngulo m\u00e1s c\u00f3modo. El micr\u00f3fono con reducci\u00f3n de ruido integrado minimiza los sonidos ambientales para garantizar que se escuche tan bien como se ve, adem\u00e1s, como ventaja adicional, la c\u00e1mara web incluye un soporte para tr\u00edpode para que pueda colocar la c\u00e1mara lejos del PC, perfecto para profesores, blogueros y personas influyentes que deseen transmitir en vivo.Compatible con la mayor\u00eda de los programas de videoconferencia y 