l teclado est\u00e1 equipado con teclas programables y patas de inclinaci\u00f3n ajustables. El mouse tiene un receptor nano USB, botones izquierdo y derecho y rueda de desplazamiento. Tanto el teclado como el mouse tienen un sistema inteligente de ahorro de energ\u00eda para extender la vida \u00fatil de las bater\u00edas. El nanorreceptor USB-A 2 en 1 se almacena en la parte inferior del mouse.","images":"https:\/\/www.dmi.es\/photo\/194\/102761\/80662521\/bg\/paquete-ewent-de-teclado-y-raton-inalambricos---diseno-es.jpg","wholesale_price":"8.14","unit_price_tax":11.3628},"product_model":{"product_data":{"ean13":["8052101431896"],"reference":"PT91534199","name":{"1":"PAQUETE EWENT DE TECLADO Y RATON INALAMBRICOS - DISE\u00d1O ES","2":"","3":"","4":""},"description":{"1":"El EW3281 es un Kit Teclado y Mouse inal\u00e1mbricos que contiene un teclado s\u00f3lido de tama\u00f1o completo y un mouse de 1000 DPI. El teclado est\u00e1 equipado con teclas programables y patas de inclinaci\u00f3n ajustables. El mouse tiene un receptor nano USB, botones izquierdo y derecho y rueda de desplazamiento. Tanto el teclado como el mouse tienen un sistema inteligente de ahorro de energ\u00eda para extender la vida \u00fatil de las bater\u00edas. El nanorreceptor USB-A 2 en 1 se almacena en la parte inferior del mouse.","2":"","3":"","4":""},"description_short":{"1":"Kit Teclado y Mouse inal\u00e1mbricos, QWERTY, dise\u00f1o ES","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Ewent","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":11.3628,"unit_price_tax":11.3628,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Ewent","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/194\/102761\/80662521\/bg\/paquete-ewent-de-teclado-y-raton-inalambricos--