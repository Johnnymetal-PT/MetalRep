"price":[174.318,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190568","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/bcbd0985bc3d16c2ce57b4fa297e19d5.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO30330016","unit_price":174.318,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"VINOTECA CECOTEC BOLERO 34030 NEGRA 34 BOTELLAS REGULABLE","quantity":0,"ean13":"8435484027151","description_short_pt":"80 L, 34 botellas,41 dB, 5 - 18 \u00baC, LED, 84 x 44 x 47.4 cm","description_pt":"\u00a1Vino para todos!Guarda tus vinos en su espacio interior de 80 L, ideal para 34 botellas.Tus vinos por fin tendr\u00e1n su propia habitaci\u00f3n. Utiliza la vinoteca grandsommelier para mantener tu colecci\u00f3n de vinos en las mejores condiciones.Gran capacidad.Los 80 L de capacidad de tu vinoteca son ideales para guardar 34 botellas. Sorprende a tus invitados con un vino a temperatura perfecta.Acabados de dise\u00f1o.La vinoteca cuenta con unos elegantes acabados en negro para darle a tu cocina un toque \u00fanico.Temperatura al servicio de tus vinos.Enfriamiento por compresor que mantiene tus botellas de vino con la temperatura adecuada.C\u00f3modo y f\u00e1cil de controlar.Su panel de control t\u00e1ctil y display es sencillo de controlar, con el que podr\u00e1s regular la temperatura, encender o apagar la luz y elegir entre \u00baF o \u00baC.Temperatura a tu medida.Regula la temperatura de la vinoteca de 5 a18 \u00baC seg\u00fan tus preferencias y necesidades.Ni te enterar\u00e1s de su presencia.Funcionamiento muy silencioso de 41 dB y sin vibraciones. Olv\u00eddate de ruidos molestos que interfieran en tu descanso o tranquilidad.Luz LED interior.Visualiza el interior de la bodega en todo momento con su luz LED interior que te permitir\u00e1 elegir el vino que m\u00e1s te guste en un momento.","images":"https:\/\/www.dmi.es\/photo\/2427\/105243\/89470953\/bg\/vinoteca-cecotec-bolero-34030-negra-34-botellas-regulable.jpg","wholesale_price":"167.90","unit_price_tax":174.318},"product_model":{"product_data":{"ean13":["8435484027151"],"reference":"CO30330016","name":{"1":"VINOTECA CECOTEC BOLERO 34030 NEGRA 34 BOTELLAS REGULABLE","2":"","3":"","4":""},"description":{"1":"\u00a1Vino para todos!Guarda tus vinos en su espacio interior de 80 L, ideal para 34 botellas.Tus vinos por fin tendr\u00e1n su propia habitaci\u00f3n. Utiliza la vinoteca grandsommelier para mantener tu colecci\u00f3n de vinos en las mejores condiciones.Gran capacidad.Los 80 L de capacidad de tu vinoteca son ideales para guardar 34 botellas. Sorprende a tus invitados con un vino a temperatura perfecta.Acabados de dise\u00f1o.La vinoteca cuenta con unos elegantes acabados en negro para darle a tu cocina un toque \u00fanico.Temperatura al servicio de tus vinos.Enfriamiento por compresor que mantiene tus botellas de vino con la temperatura adecuada.C\u00f3modo y f\u00e1cil de controlar.Su panel de control t\u00e1ctil y display es sencillo de controlar, con el que podr\u00e1s regular la temperatura, encender o apagar la luz y elegir entre \u00baF o \u00baC.Temperatura a tu medida.Regula la temperatura de la vinoteca de 5 a18 \u00baC seg\u00fan tus preferencias y necesidades.Ni te enterar\u00e1s de su presencia.Funcionamiento muy silencioso de 41 dB y sin vibraciones. Olv\u00eddate de ruidos molestos que interfieran en tu descanso o tranquilidad.Luz LED interior.Visualiza el interior de la bodega en todo momento con su luz LED interior que te permitir\u00e1 elegir el vino que m\u00e1s te guste en un momento.","2":"","3":"","4":""},"des