tures",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188965","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/f92f867f6338f8265d66736400b2ba2f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"SE3035067","unit_price":31.9362,"category":"Almacenamiento port\u00e1til","brand":"HPE","name_pt":"ACCESORIO HPE  LTO-51 PAQUETE - 1,50 TB (Nativa) \/ 3 TB","quantity":0,"ean13":"4948382718051","description_short_pt":"HP LTO-5 Ultrium 3TB RW Data Cartridge","description_pt":"Los soportes HP LTO-4 Ultrium ofrecen el mejor \u00edndice de capacidad\/rendimiento de cualquier tecnolog\u00eda de cinta, con capacidad y rendimiento de clase terabyte. Casi duplica la capacidad y ofrece un rendimiento m\u00e1s r\u00e1pido que LTO-4 Ultrium, con capacidad de cifrado incorporado y una opci\u00f3n de escritura \u00fanica, lectura m\u00faltiple (WORM) sin sobrecarga de rendimiento. Puede escribir y leer datos a la velocidad vertiginosa de 1 TB\/hora, almacenando, cifrando y protegiendo hasta 3 TB en un solo cartucho, convirti\u00e9ndolo en el gran logro en entornos de TI cr\u00edticos a gran escala para usar las 24 h todos los d\u00edas.  La estandarizaci\u00f3n en HP LTO-5 Ultrium proporciona la capacidad de cumplir los decrecientes plazos de las copias de seguridad, cifrado AES de 256 bits (IEEE1619.1) est\u00e1ndar del sector y soportes RW o WORM intercambiables sin espacio adicional o superexplotaci\u00f3n de los recursos de TI.Mayor capacidad y rendimiento que cualquier tecnolog\u00eda de cinta comparable&bull,&nbsp,HP LTO-5 Ultrium puede escribir y leer datos a una velocidad vertiginosa de 1 TB\/h, almacenando, cifrando y protegiendo hasta 3 TB en un solo cartucho, convirti\u00e9ndolo en el gran logro en entornos de TI cr\u00edticos a gran escala para usar las 24 h todos los d\u00edas.Ultrafiable&bull,&nbsp,Mecanismo superior de 'atracci\u00f3n inteligente' e interbloqueo mec\u00e1nico para evitar que el pasador del puntero sea extra\u00eddo en el interior del alojamiento de la cinta. Los sensores detectan la conexi\u00f3n correcta e impiden la p\u00e9rdida del puntero que destruir\u00eda la cinta.Seguro&bull,&nbsp,La versi\u00f3n de escritura \u00fanica, lectura m\u00faltiple (WORM) permite un almacenamiento de datos compatible con antimanipulaci\u00f3n.Buena rentabilidad&bull,&nbsp,La estandarizaci\u00f3n en HP LTO-4 o LTO-5 Ultrium aporta la capacidad para cumplir con los decrecientes plazos de las copias de seguridad, el cifrado AES de 256 bits (IEEE1619.1) est\u00e1ndar del sector y los soportes RW o WORM intercambiables, sin espacio adicional o superexplotaci\u00f3n de los recursos de TI.","images":"https:\/\/www.dmi.es\/photo\/293\/9556\/18255042\/bg\/accesorio-hpe--lto-51-paquete---1-50-tb--nativa----3-tb.jpg","wholesale_price":"28.31","unit_price_tax":31.9362},"product_model":{"product_data":{"ean13":["4948382718051"],"reference":"SE3035067","name":{"1":"ACCESORIO HPE  LTO-51 PAQUETE - 1,50 TB (Nativa) \/ 3 TB","2":"","3":"","4":""},"description":{"1":"Los soportes HP LTO-4 Ultrium ofrecen el mejor \u00edndice de capacidad\/rendimiento de cualquier tecnolog\u00eda de cinta, con capacidad y rendimiento de clase terabyte. Casi duplica la capacidad y ofrece un rendimiento m\u00e1s r\u00e1pido que LTO-4 Ultrium, con capacidad de cifrado incorporado y una opci\u00f3n de escritura \u00fanica, lectura m\u00faltiple (WORM) sin sobrecarga de rendimiento. Puede escribir y leer datos a la velocidad vertiginosa de 1 TB\/hora, almacenando, cifrando y protegiendo hasta 3 TB en un solo cartucho, convirti\u00e9ndolo en el gran logro en entornos de TI cr\u00edticos a gran escala para usar las 24 h todos los d\u00edas.  La estandarizaci\u00f3n en HP LTO-5 Ultrium proporciona la capacidad de cumplir los decrecientes plazos de las copias de seguridad, cifrado AES de 256 bits (IEEE1619.1) est\u00e1ndar del sector y soportes RW o WORM intercambiables sin espacio adicional o superexplotaci\u00f3n de los recursos de TI.Mayor capacidad y rendimiento que cualquier tecnolog\u00eda de cinta comparable&bull,&nbsp,HP LTO-5 Ultrium puede escribir y leer datos a una velocidad vertiginosa de 1 TB\/h, almacenando, cifrando y protegiendo hasta 3 TB en un solo cartucho, convirti\u00e9ndolo en el gran logro en entornos de TI cr\u00edticos a gran escala para usar las 24 h todos los d\u00edas.Ultrafiable&bull,&nbsp,Mecanismo superior de 'atracci\u00f3n inteligente' e interbloqueo mec\u00e1nico para evitar que el pasador del puntero sea extra\u00eddo en el interior del alojamiento de la cinta. Los sensores detectan la conexi\u00f3n correcta e impiden la p\u00e9rdida del puntero que destruir\u00eda la cinta.Seguro&bull,&nbsp,La versi\u00f3n de escritura \u00fanica, lectura m\u00faltiple (WORM) permite un almacenamiento de datos compatible con antimanipulaci\u00f3n.Buena rentabilidad&bull,&nbsp,La estandarizaci\u00f3n en HP LTO-4 o LTO-5 Ultrium aporta la capacidad para cumplir con los decrecientes plazos de las copias de seguridad, el cifrado AES de 256 bits (IEEE1619.1) est\u00e1ndar del sector y los soportes RW o WORM intercambiables, sin espacio adicional o superexplotaci\u00f3n de los recursos de TI.","2":"","3":"","4":""},"description_short":{"1":"HP LTO-5 Ultrium 3TB RW Data Cartridge","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"HPE","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":31.9362,"unit_price_tax":31.9362,"tax_rules_group":null,"category":"Almacenamiento port\u00e1til","brand":"HPE","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/293\/9556\/18255042\/bg\/accesorio-hpe--lto-51-paquete---1-50-tb--