eight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190062","Cat. IDs: 98","Associated Categories","Cat. Default: 98","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3d987009f20bda47ea30b50364e76189.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HD3425973","unit_price":407.7552,"category":"Discos duros internos","brand":"Kingston Technology","name_pt":"3840G DC600M 2.5 Enterprise SATA SSDKingston DC600M - SSD -","quantity":0,"ean13":"0740617334975","description_short_pt":"3840GB, 2.5\", SATA 3.0, 3D TLC, 92.34g","description_pt":"Disco SSD empresarial SATA DC600M de 2,5? Almacenamiento SATA 3.0 de 6 Gbps para cargas de trabajo de uso mixtoEl disco DC600M de Kingston es un SSD SATA 3.0 de cuarta generaci\u00f3n para centros de datos, que alcanza 6 Gbps SSD, con NAND TLC 3D previsto para cargas de trabajo de ?uso mixto?. El DC600M es id\u00f3neo para utilizar en servidores de altos vol\u00famenes montados en bastidor, e incluye PLP (protecci\u00f3n contra p\u00e9rdidas de alimentaci\u00f3n) interno basado en hardware. Mediante condensadores contra p\u00e9rdidas de alimentaci\u00f3n, el DC600M protege los datos contra cortes el\u00e9ctricos imprevistos para reducir la posibilidad de p\u00e9rdidas de datos y garantizar que la unidad se reinicializar\u00e1 sin problemas en el siguiente arranque del sistema. El DC600M ha sido dise\u00f1ado para ofrecer la homogeneidad de latencia y de IOPS que requieren los integradores de sistemas, los centros de datos de hiperescala y los prestadores de servicios en la nube.PLP basada en hardwareCondensadores de protecci\u00f3n de cortes de alimentaci\u00f3n para proteger los datos del usuario contra interrupciones imprevistas de fluido el\u00e9ctrico y mejorar el rendimiento.Excelente Calidad de servicio (QoS)Previsibilidad de rendimiento optimizada para cumplir los contratos de nivel de servicio (SLA).Unidad de autocifrado AES 256-bitProtecci\u00f3n integrada de los datos importantes.Con capacidades de hasta 7680 GBMejore y administre el almacenamiento con capacidades de hasta 7680 GB.","images":"https:\/\/www.dmi.es\/photo\/1563\/100572\/84293673\/bg\/3840g-dc600m-2-5-enterprise-sata-ssdkingston-dc600m---ssd--.jpg","wholesale_price":"396.76","unit_price_tax":407.7552},"product_model":{"product_data":{"ean13":["0740617334975"],"reference":"HD3425973","name":{"1":"3840G DC600M 2.5 Enterprise SATA SSDKingston DC600M - SSD -","2":"","3":"","4":""},"description":{"1":"Disco SSD empresarial SATA DC600M de 2,5? Almacenamiento SATA 3.0 de 6 Gbps para cargas de trabajo de uso mixtoEl disco DC600M de Kingston es un SSD SATA 3.0 de cuarta generaci\u00f3n para centros de datos, que alcanza 6 Gbps SSD, con NAND TLC 3D previsto para cargas de trabajo de ?uso mixto?. El DC600M es id\u00f3neo para utilizar en servidores de altos vol\u00famenes montados en bastidor, e incluye PLP (protecci\u00f3n contra p\u00e9rdidas de alimentaci\u00f3n) interno basado en hardware. Mediante condensadores contra p\u00e9rdidas de alimentaci\u00f3n, el DC600M protege los datos contra cortes el\u00e9ctricos imprevistos para reducir la posibilidad de p\u00e9rdidas de datos y garantizar que la unidad se reinicializar\u00e1 sin problemas en el siguiente arranque del sistema. El DC600M ha sido dise\u00f1ado para ofrecer la homogeneidad de latencia y de IOPS que requieren los integradores de sistemas, los centros de datos de hiperescala y los prestadores de servicios en la nube.PLP basada en hardwareCondensadores de protecci\u00f3n de cortes de alimentaci\u00f3n para proteger los datos del usuario contra interrupciones imprevistas de fluido el\u00e9ctrico y mejorar el rendimiento.Excelente Calidad de servicio (QoS)Previsibilidad de rendimiento optimizada para cumplir los contratos de nivel de servicio (SLA).Unidad de autocifrado AES 256-bitProtecci\u00f3n integrada de los datos importantes.Con capacidades de hasta 7680 GBMejore y administre el almacenamiento con capacidades de hasta 7680 GB.","2":"","3":"","4":""},"description_short":{"1":"3840GB, 2.5\", SATA 3.0, 3D TLC, 92.34g","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Kingston Technology","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":407.7552,"unit_price_tax":407.7552,"tax_rules_group":null,"category":"Discos duros internos","brand":"Kingston Technology","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1563\/100572\/84293673\/bg\/3840g-dc600m-2-5-enterprise-sata-ssdkingston-dc600m---ssd--.jpg"],"wholesale_price":396.76}}},"4719331857370":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4719331857370",false],"wholesale_price":[1031,false],"price":[1054.68,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190063","Cat. IDs: 88","Associated Categories","Cat. Default: 88","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cf1481c54c20894b00403d65610ad681.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PT051541008","unit_price":1054.68,"category":"Port\u00e1tiles","brand":"Gigabyte","name_pt":"PORTATIL GIGABYTE G6 KF-H3ES854SD I7-13620H 4060 16GB DDR5 1TB 16\" DOS","quantity":5,"ean13":"4719331857370","description_short_pt":"Gigabyte G6 KF-H3ES8