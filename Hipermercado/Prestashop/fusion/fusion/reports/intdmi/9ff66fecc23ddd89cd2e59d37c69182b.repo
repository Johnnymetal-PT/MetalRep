aspirador-de-colchones-conga-7000-mattress.jpg"],"wholesale_price":76.8}}},"0649528906526":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0649528906526",false],"wholesale_price":[34.86,false],"price":[38.6172,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189249","Cat. IDs: 189","Associated Categories","Cat. Default: 189","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/70ba893d46f3ea66adae82dc60c96be3.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"MM12183470","unit_price":38.6172,"category":"Memoria RAM","brand":"Crucial","name_pt":"DDR5 SODIMM CRUCIAL 16GB 4800","quantity":0,"ean13":"0649528906526","description_short_pt":"Crucial CT16G48C40S5, 16 GB, 1 x 16 GB, DDR5, 4800 MHz, 262-pin SO-DIMM","description_pt":"Crucial CT16G48C40S5. Componente para: Port\u00e1til, Memoria interna: 16 GB, Dise\u00f1o de memoria (m\u00f3dulos x tama\u00f1o): 1 x 16 GB, Tipo de memoria interna: DDR5, Velocidad de memoria del reloj: 4800 MHz, Forma de factor de memoria: 262-pin SO-DIMM, Latencia CAS: 40","images":"https:\/\/www.dmi.es\/photo\/911\/94307\/60669955\/bg\/ddr5-sodimm-crucial-16gb-4800.jpg","wholesale_price":"34.86","unit_price_tax":38.6172},"product_model":{"product_data":{"ean13":["0649528906526"],"reference":"MM12183470","name":{"1":"DDR5 SODIMM CRUCIAL 16GB 4800","2":"","3":"","4":""},"description":{"1":"Crucial CT16G48C40S5. Componente para: Port\u00e1til, Memoria interna: 16 GB, Dise\u00f1o de memoria (m\u00f3dulos x tama\u00f1o): 1 x 16 GB, Tipo de memoria interna: DDR5, Velocidad de memoria del reloj: 4800 MHz, Forma de factor de memoria: 262-pin SO-DIMM, Latencia CAS: 40","2":"","3":"","4":""},"description_short":{"1":"Crucial CT16G48C40S5, 16 GB, 1 x 16 GB, DDR5, 4800 MHz, 262-pin SO-DIMM","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Crucial","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":38.6172,"unit_price_tax":38.6172,"tax_rules_group":null,"category":"Memoria RAM","brand":"Crucial","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/911\/94307\/60669955\/bg\/ddr5-sodimm-crucial-16gb-4800.jpg"],"wholesale_price":34.86}}},"0649528906533":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0649528906533",false],"wholesale_price":[71.13,false],"price":[75.6126,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189250","Cat. IDs: 189","Associated Categories","Cat. Default: 189","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/f043cdf6bccb5241ced218c216800f1d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"MM12183471","unit_price":75.6126,"category":"Memoria RAM","brand":"Crucial","name_pt":"DDR5 SODIMM CRUCIAL 32GB 4800","quantity":0,"ean13":"0649528906533","description_short_pt":"32 GB DDR5, 4800 MHz, SO-DIMM, 1.1 V","description_pt":"Las memorias Crucial DDR5 para ordenadores port\u00e1tiles pueden potenciar su ordenador para alcanzar transferencias de datos un 50 % superiores en su lanzamiento que la DDR4, proporcionando transferencia de archivos, descargas, tasas de actualizaci\u00f3n y tiempos de carga m\u00e1s r\u00e1pidos, adem\u00e1s de retardos mucho menores.Transferencia de archivos y tiempos de carga m\u00e1s r\u00e1pidosLas memorias de sobremesa Crucial DDR5 pueden potenciar su ordenador para alcanzar transferencias de datos un 50 % superiores en su lanzamiento que la DDR4, proporcionando transferencia de archivos, descargas, tasas de actualizaci\u00f3n y tiempos de carga m\u00e1s r\u00e1pidos, adem\u00e1s de retrasos mucho menores5. Debido a la elevada eficiencia de su bus, la tecnolog\u00eda DDR5 no solo es m\u00e1s r\u00e1pida que la anterior generaci\u00f3n, sino tambi\u00e9n mejorMultitareas con mayor capacidad de respuestaLas memorias Crucial DDR5 ofrecen velocidades un 50 % m\u00e1s altas que las DDR4 en su lanzamiento4, lo que permite a los usuarios un rendimiento extremo desde el primer momento. Y algo todav\u00eda m\u00e1s impresionante: las Crucial DDR5 est\u00e1n optimizadas para mejorar el rendimiento y las multitareas, no solo durante las pruebas sino tambi\u00e9n en condiciones reales. Ahora, abrir m\u00e1s pesta\u00f1as de navegador y cambiar entre aplicaciones es m\u00e1s r\u00e1pido que nunca.M\u00e1xima innovaci\u00f3n para un rendimiento estableLas memorias Crucial DDR5 representan un salto inmenso en ingenier\u00eda respecto a la anterior generaci\u00f3n, con dos canales independientes de 32 bits por m\u00f3dulo para ofrecer un rendimiento \u00f3ptimo7. Dise\u00f1adas con ECC en la propia matriz (ODECC)8 en el nivel de los componentes para lograr la m\u00e1xima estabilidad a largo plazo, las Crucial DDR5 est\u00e1n dise\u00f1adas para ofrecer la misma fiabilidad que sus predecesoras, incluso con las rigurosas exigencias que plantea la inform\u00e1tica de nueva generaci\u00f3n.Eficiencia de alimentaci\u00f3n optimizadaPara lograr una mayor eficiencia y estabilidad, las Crucial DDR5 incorporan una regulaci\u00f3n de tensi\u00f3n en el propio m\u00f3dulo con un circuito de gesti\u00f3n de alimentaci\u00f3n integrado (PMIC, por sus siglas en ingl\u00e9s) que, en las tecnolog\u00edas de memoria m\u00e1s antiguas7, estaba en la placa base. El resultado es una mejor se\u00f1alizaci\u00f3n y una alimentaci\u00f3n m\u00e1s limpia para los m\u00f3dulos (DIMM, por sus siglas en ingl\u00e9s). Adem\u00e1s, la tensi\u00f3n de alimentaci\u00f3n en un m\u00f3dulo DDR5 es de solo 1,1 V en comparaci\u00f3n con los 1,2 V de las anteriores DDR4.Calidad Micron\u00ae: fiabilidad probada para su seguridadComo marca de consumo integrada verticalmente de Micron, millones de usuarios conf\u00edan en Crucial por su fiabilidad, rendimiento y compatibilidad. Al contrario de lo que ocurre con los ensambladores de m\u00f3dulos, nuestra relaci\u00f3n \u00fanica con Micron nos ha llevado a colaborar en el campo de la ingenier\u00eda a un nivel mucho m\u00e1s profundo para sacar el m\u00e1ximo rendimiento a nuestros productos sin comprometer su fiabilidad. Con los m\u00e1s de 43 a\u00f1os de excelencia en fabricaci\u00f3n que ostenta Micron y los m\u00e1s de 25 a\u00f1os de desarrollo de productos para el mercado de consumo de Crucial, las Crucial DDR5 ofrecen adem\u00e1s una garant\u00eda limitada de por vida9 y un potente rendimiento en el que puede confiar. Cuando se trata de memorias, no se conforme con menos.","images":"https:\/\/www.dmi.es\/photo\/911\/94309\/60669983\/bg\/ddr5-sodimm-crucial-32gb-4800.jpg","wholesale_price":"71.13","unit_price_tax":75.6126},"product_model":{"product_data":{"ean13":["0649528906533"],"reference":"MM12183471","name":{"1":"DDR5 SODIMM CRUCIAL 32GB 4800","2":"","3":"","4":""},"description":{"1":"Las memorias Crucial DDR5 para ordenadores port\u00e1tiles pueden potenciar su ordenador para alcanzar transferencias de datos un 50 % superiores en su lanzamiento que la DDR4, proporcionando transferencia de archivos, descargas, tasas de actualizaci\u00f3n y tiempos de carga m\u00e1s r\u00e1pidos, adem\u00e1s de retardos mucho menores.Transferencia de archivos y tiempos de carga m\u00e1s r\u00e1pidosLas memorias de sobremesa Crucial DDR5 pueden potenciar su ordenador para alcanzar transferencias de datos un 50 % superiores en su lanzamiento que la DDR4, proporcionando transferencia de archivos, descargas, tasas de actualizaci\u00f3n y tiempos de carga m\u00e1s r\u00e1pidos, adem\u00e1s de retrasos mucho menores5. Debido a la elevada eficiencia de su bus, la tecnolog\u00eda DDR5 no solo es m\u00e1s r\u00e1pida que la anterior generaci\u00f3n, sino tambi\u00e9n mejorMultitareas con mayor capacidad de respuestaLas memorias Crucial DDR5 ofrecen velocidades un 50 % m\u00e1s altas que las DDR4 en su lanzamiento4, lo que permite a los usuarios un rendimiento extremo desde el primer momento. Y algo todav\u00eda m\u00e1s impresionante: las Crucial DDR5 est\u00e1n optimizadas para mejorar el rendimiento y las multitareas, no solo durante las pruebas sino tambi\u00e9n en condiciones reales. Ahora, abrir m\u00e1s pesta\u00f1as de navegador y cambiar entre aplicaciones es m\u00e1s r\u00e1pido que nunca.M\u00e1xima innovaci\u00f3n para un rendimiento estableLas memorias Crucial DDR5 representan un salto inmenso en ingenier\u00eda respecto a la anterior generaci\u00f3n, con dos canales independientes de 32 bits por m\u00f3dulo para ofrecer un rendimiento \u00f3ptimo7. Dise\u00f1adas con ECC en la propia matriz (ODECC)8 en el nivel de los componentes para lograr la m\u00e1xima estabilidad a largo plazo, las Crucial DDR5 est\u00e1n dise\u00f1adas para ofrecer la misma fiabilidad que sus predecesoras, incluso con las rigurosas exigencias que plantea la inform\u00e1tica de nueva generaci\u00f3n.Eficiencia de alimentaci\u00f3n optimizadaPara lograr una mayor eficiencia y estabilidad, las Crucial DDR5 incorporan una regulaci\u00f3n de tensi\u00f3n en el propio m\u00f3dulo con un circuito de gesti\u00f3n de alimentaci\u00f3n integrado (PMIC, por sus siglas en ingl\u00e9s) que, en las tecnolog\u00edas de memoria m\u00e1s antiguas7, estaba en la placa base. El resultado es una mejor se\u00f1alizaci\u00f3n y una alimentaci\u00f3n m\u00e1s limpia para los m\u00f3dulos (DIMM, por sus siglas en ingl\u00e9s). Adem\u00e1s, la tensi\u00f3n de alimentaci\u00f3n en un m\u00f3dulo DDR5 es de solo 1,1 V en comparaci\u00f3n con los 1,2 V de las anteriores DDR4.Calidad Micron\u00ae: fiabilidad probada para su seguridadComo marca de consumo integrada verticalmente de Micron, millones de usuarios conf\u00edan en Crucial por su fiabilidad, rendimiento y compatibilidad. Al contrario de lo que ocurre con los ensambladores de m\u00f3dulos, nuestra relaci\u00f3n \u00fanica con Micron nos ha llevado a colaborar en el campo de la ingenier\u00eda a un nivel mucho m\u00e1s profundo para sacar el m\u00e1ximo rendimiento a nuestros productos sin comprometer su fiabilidad. Con los m\u00e1s de 43 a\u00f1os de excelencia en fabricaci\u00f3n que ostenta Micron y los m\u00e1s de 25 a\u00f1os de desarrollo de productos para el mercado de consumo de Crucial, las Crucial DDR5 ofrecen adem\u00e1s una garant\u00eda limitada de por vida9 y un potente rendimiento en el que puede confiar. Cuando se trata de memorias, no se conforme con menos.","2":"","3":"","4":""},"description_short":{"1":"32 GB DDR5, 4800 MHz, SO-DIMM, 1.1 V","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Crucial","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":75.6126,"unit_price_tax":75.6126,"tax_rules_group":null,"category":"Memoria RAM","brand":"Crucial","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/911\/94309\/60669983\/bg\/ddr5-sodimm-crucial-32gb-4800.jpg"],"wholesale_price":71.13}}},"4960999617022":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4960999617022",false],"wholesale_price":[19.84,false],"price":[23.2968,false],"id_tax_rules_group":[1,fals