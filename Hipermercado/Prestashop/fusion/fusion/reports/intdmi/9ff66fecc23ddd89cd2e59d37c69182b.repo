as, refrigeradores de CPU y fuentes de alimentaci\u00f3n. La S25-V es completada con prestaciones como los filtros de polvo extra\u00edbles y f\u00e1cil de limpiar, un sistema de gesti\u00f3n del cableado y un panel frontal f\u00e1cilmente desmontable.","2":"","3":"","4":""},"description_short":{"1":"Mini-ITX\/Micro-ATX\/ATX, 2 x USB 3.0, 450 x 210 x 465 mm, 2 ventiladores incluidos, 6.5 Kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Sharkoon","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":58.6806,"unit_price_tax":58.6806,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"Sharkoon","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/237\/27326\/18832092\/bg\/caja-sharkoon-s25-v-atx-2xusb3-0-sin-fuente.jpg"],"wholesale_price":54.53}}},"4044951013951":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4044951013951",false],"wholesale_price":[47.46,false],"price":[51.4692,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185556","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c4a3344e8108a54ac2680d885de9e506.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ11312436","unit_price":51.4692,"category":"Cajas y fuentes","brand":"Sharkoon","name_pt":"CAJA SHARKOON V1000 MATX 2XUSB3.0 SIN FUENTE","quantity":0,"ean13":"4044951013951","description_short_pt":"Mini-ITX\/Micro-ATX, 2 x USB 3.0, 450 x 195 x 402 mm, 2 ventiladores incluidos, 5.6 Kg","description_pt":"Nos encontramos ante un sofisticado ordenador de oficina, una compacta estaci\u00f3n multimedia o un PC gaming econ\u00f3mico: la V1000 es una caja micro-ATX que ofrece soluciones vers\u00e1tiles para particulares. Los 2 ventiladores preinstalados y la rejilla en el panel frontal proporcionan un flujo de aire \u00f3ptimo. \u00c9ste se puede mejorar, si lo deseamos, por medio de dos ventiladores m\u00e1s adicionales. El t\u00fanel en el panel inferior oculta la fuente de alimentaci\u00f3n y los cables, haciendo posible la instalaci\u00f3n ordenada de hardware en el interior de la caja. Tambi\u00e9n hay posibilidades flexibles para acomodar diversas unidades de almacenamiento de datos.","images":"https:\/\/www.dmi.es\/photo\/237\/29139\/25448385\/bg\/caja-sharkoon-v1000-matx-2xusb3-0-sin-fuente.jpg","wholesale_price":"47.46","unit_price_tax":51.4692},"product_model":{"product_data":{"ean13":["4044951013951"],"reference":"CJ11312436","name":{"1":"CAJA SHARKOON V1000 MATX 2XUSB3.0 SIN FUENTE","2":"","3":"","4":""},"description":{"1":"Nos encontramos ante un sofisticado ordenador de oficina, una compacta estaci\u00f3n multimedia o un PC gaming econ\u00f3mico: la V1000 es una caja micro-ATX que ofrece soluciones vers\u00e1tiles para particulares. Los 2 ventiladores preinstalados y la rejilla en el panel frontal proporcionan un flujo de aire \u00f3ptimo. \u00c9ste se puede mejorar, si lo deseamos, por medio de dos ventiladores m\u00e1s adicionales. El t\u00fanel en el panel inferior oculta la fuente de alimentaci\u00f3n y los cables, haciendo posible la instalaci\u00f3n ordenada de hardware en el interior de la caja. Tambi\u00e9n hay posibilidades flexibles para acomodar diversas unidades de almacenamiento de datos.","2":"","3":"","4":""},"description_short":{"1":"Mini-ITX\/Micro-ATX, 2 x USB 3.0, 450 x 195 x 402 mm, 2 ventiladores incluidos, 5.6 Kg","2":"","3":"","4":""},"meta_description":{"1":""