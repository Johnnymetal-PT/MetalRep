69\/59452039\/bg\/caja-gaming-antec-df800-flux-atx-2xusb2-0-1xusb3-0-sin-fuente-neg-rgb.jpg","wholesale_price":"90.46","unit_price_tax":95.3292},"product_model":{"product_data":{"ean13":["0761345800815"],"reference":"CJ11132640","name":{"1":"CAJA GAMING ANTEC DF800 FLUX ATX 2XUSB2.0 1XUSB3.0 SIN FUENTE NEG RGB","2":"","3":"","4":""},"description":{"1":"Antec DF800 FLUX. Factor de forma: Midi Tower, Tipo: PC, Color del producto: Negro. Ventiladores frontales instalados: 3x 120 mm, Di\u00e1metro de ventiladores frontales soportados: 120,140 mm, Ventiladores traseros instalados: 1x 120 mm. Tama\u00f1os de disco duro soportados: 2.5,3.5\", Factor de forma de disco SSD: 2.5\". Ancho: 220 mm, Profundidad: 479 mm, Altura: 488 mm. Peso del paquete: 8,7 kg","2":"","3":"","4":""},"description_short":{"1":"Antec DF800 FLUX, Midi Tower, PC, Negro, ATX, micro ATX, Mini-ITX, Pl\u00e1stico, Acero, Juego","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Antec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":95.3292,"unit_price_tax":95.3292,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"Antec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/237\/87469\/59452039\/bg\/caja-gaming-antec-df800-flux-atx-2xusb2-0-1xusb3-0-sin-fuente-neg-rgb.jpg"],"wholesale_price":90.46}}},"8436587973543":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587973543",false],"wholesale_price":[27.88,false],"price":[31.4976,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185603","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/87d1ccb312dbd2aad71aae1f2cdca44c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ11356653","unit_price":31.4976,"category":"Cajas y fuentes","brand":"NOX","name_pt":"CAJA NOX Micro ATX NOX TAU 2 x USB 3.0","quantity":5,"ean13":"8436587973543","description_short_pt":"Mini torre, Micro ATX \u00b7 ITX, Cooler CPU: 147 mm (M\u00e1x.), VGA: 315 mm (M\u00e1x.), Acero SPCC 0.4 mm \/ Pl\u00e1stico ABS, 2x USB 3.0 \/ HD audio","description_pt":"COMPACTA Y ELEGANTENox TAU es una vers\u00e1til semitorre con capacidad para instalar hasta tres ventiladores y con buena accesibilidad, contando con dos puertos USB 3.0 de alta velocidad.DISE\u00d1O MINIMALISTADe color negro y un llamativo dise\u00f1o con panel frontal con acabado cepillado, esta caja tiene un tama\u00f1o de 377 x 186 x 360 mm. Construida en ABS y acero SPCC de 0,4 mm, es resistente y compacta, lo que lo hace ideal para cualquier tipo de setup, especialmente para montar un pc para el hogar o un ordenador de oficina.EXCELENTE ACCESIBILIDADEsta caja de Nox cuenta con los accesos principales en su parte frontal. Ah\u00ed se encuentran dos USB 3.0 de alta velocidad y las conexiones HD audio y micr\u00f3fono.GRAN CAPACIDADNox Tau es una caja potente que permite montar una tarjeta gr\u00e1fica de hasta 315 mm. Adem\u00e1s, cuenta con dos bah\u00edas externas, una de 5,25\" y otra de 3,5\". De igual modo, tiene dos bah\u00edas internas de 3,5\" y otro par de 2,5\".\u00d3PTIMO FLUJO DE AIRECompatible con los formatos Micro ATX e ITX, esta semitorre permite instalar hasta tres ventiladores, uno en su frontal de 120 mm, otro en el lateral tambi\u00e9n de 120 mm y un tercero en la parte trasera de 80 mm. Adem\u00e1s, permite integrar un cooler CPU m\u00e1ximo de 147 mm.","images":"https:\/\/www.dmi.es\/photo\/237\/89228\/64624256\/bg\/caja-nox-micro-atx-nox-tau-2-x-usb-3-0.jpg","wholesale_price":"27.88","unit_price_tax":31.4976},"product_model":{"product_data":{"ean13":["8436587973543"],"reference":"CJ11356653","name":{"1":"CAJA NOX Micro ATX NOX TAU 2 x USB 3.0","2":"","3":"","4":""},"description":{"1":"COMPACTA Y ELEGANTENox TAU es una vers\u00e1til semitorre con capacidad para instalar hasta tres ventiladores y con buena accesibilidad, contando con dos puertos USB 3.0 de alta velocidad.DISE\u00d1O MINIMALISTADe color negro y un llamativo dise\u00f1o con panel frontal con acabado cepillado, esta caja tiene un tama\u00f1o de 377 x 186 x 360 mm. Construida en ABS y acero SPCC de 0,4 mm, es resistente y compacta, lo que lo hace ideal para cualquier tipo de setup, especialmente para montar un pc para el hogar o un ordenador de oficina.EXCELENTE ACCESIBILIDADEsta caja de Nox cuenta con los accesos principales en su parte frontal. Ah\u00ed se encuentran dos USB 3.0 de alta velocidad y las conexiones HD audio y micr\u00f3fono.GRAN CAPACIDADNox Tau es una caja potente que permite montar una tarjeta gr\u00e1fica de hasta 315 mm. Adem\u00e1s, cuenta con dos bah\u00edas externas, una de 5,25\" y otra de 3,5\". De igual modo, tiene dos bah\u00edas internas de 3,5\" y otro par de 2,5\".\u00d3PTIMO FLUJO DE AIRECompatible con los formatos Micro ATX e ITX, esta semitorre permite instalar hasta tres ventiladores, uno en su frontal de 120 mm, otro en el lateral tambi\u00e9n de 120 mm y un tercero en la parte trasera de 80 mm. Adem\u00e1s, permite integrar un cooler CPU m\u00e1ximo de 147 mm.","2":"","3":"","4":""},"description_short":{"1":"Mini torre, Micro ATX \u00b7 ITX, Cooler CPU: 147 mm (M\u00e1x.), VGA: 315 mm (M\u00e1x.), Acero SPCC 0.4 mm \/ Pl\u00e1stico ABS, 2x USB 3.0 \/ HD audio","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":31.4976,"unit_price_tax":31.4976,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"NOX","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/237\/89228\/64624256\/bg\/caja-nox-micro-atx-nox-tau-2-x-usb-3-0.jpg"],"wholesale_price":27.88}}},"8436587973536":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587973536",false],"wholesale_price":[27.87,false],"price":[31.4874,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185604","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/bf598517d21e402190e4fc118e97ed53.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ11356654","unit_price":31.4874,"category":"Cajas y fuentes","brand":"NOX","name_pt":"CAJA NOX Micro ATX NOX ARCA 2X USB 3.0","quantity":0,"ean13":"8436587973536","description_short_pt":"Micro-ATX, Panel frontal con acabado cepillado, USB 3.0, Mini torre, Cooler CPU: 147 mm (M\u00e1x.),  VGA: 315 mm (M\u00e1x.), Acero SPCC 0.4 mm \/ Pl\u00e1stico ABS","description_pt":"RENDIMIENTO Y DISE\u00d1OLa Nox Arca es una elegante minitorre con buena capacidad de enfriamiento que permite instalar hasta tres ventiladores y un cooler CPU. Adem\u00e1s, cuenta con buen acceso a las conexiones principales y admite gr\u00e1ficas de hasta 315 mm.TAMA\u00d1O COMPACTOConstruida en pl\u00e1stico ABS y acero SPCC de 0,4 mm, tiene unas medidas de 377 x 186 x 360 mm y cuenta con un frontal en acabado cepillado, presentando un dise\u00f1o minimalista en color negro, ideal para el d\u00eda a d\u00eda.CONEXIONES ESTRAT\u00c9GICASEn su parte superior, esta minitorre de Nox incluye dos USB 3.0 de alta velocidad y las conexiones HD de audio, tanto para el micr\u00f3fono como para los auriculares, accediendo as\u00ed a las conexiones m\u00e1s importantes c\u00f3modamente.DISTINTAS OPCIONES DE ALMACENAMIENTOCon buena capacidad interior, es compatible con las placas base Micro ATX e ITX. Adem\u00e1s, admite tarjetas gr\u00e1ficas de hasta 315 mm.BUEN CAUDAL DE AIREPermite montar hasta tres ventiladores para disipar el calor del interior y mantener los componentes a la temperatura m\u00e1s adecuada. As\u00ed, posibilita integrar uno en su frontal y otro en el lateral de 120 mm y un tercero en la zona trasera de 80 mm. Adem\u00e1s, para proteger de las altas temperaturas la CPU, permite a\u00f1adir un cooler de 147 mm.","images":"https:\/\/www.dmi.es\/photo\/237\/89229\/64624220\/bg\/caja-nox-micro-atx-nox-arca-2x-usb-3-0.jpg","wholesale_price":"27.87","unit_price_tax":31.4874},"product_model":{"product_data":{"ean13":["8436587973536"],"reference":"CJ11356654","name":{"1":"CAJA NOX Micro ATX NOX ARCA 2X USB 3.0","2":"","3":"","4":""},"description":{"1":"RENDIMIENTO Y DISE\u00d1OLa Nox Arca es una elegante minitorre con buena capacidad de enfriamiento que permite instalar hasta tres ventiladores y un cooler CPU. Adem\u00e1s, cuenta con buen acceso a las conexiones principales y admite gr\u00e1ficas de hasta 315 mm.TAMA\u00d1O COMPACTOConstruida en pl\u00e1stico ABS y acero SPCC de 0,4 mm, tiene unas medidas de 377 x 186 x 360 mm y cuenta con un frontal en acabado cepillado, presentando un dise\u00f1o minimalista en color negro, ideal para el d\u00eda a d\u00eda.CONEXIONES ESTRAT\u00c9GICASEn su parte superior, esta minitorre de Nox incluye dos USB 3.0 de alta velocidad y las conexiones HD de audio, tanto para el micr\u00f3fono como para los auriculares, accediendo as\u00ed a las conexiones m\u00e1s importantes c\u00f3modamente.DISTINTAS OPCIONES DE ALMACENAMIENTOCon buena capacidad interior, es compatible con las placas base Micro ATX e ITX. Adem\u00e1s, admite tarjetas gr\u00e1ficas de hasta 315 mm.BUEN CAUDAL DE AIREPermite montar hasta tres ventiladores para disipar el calor del interior y mantener los componentes a la temperatura m\u00e1s adecuada. As\u00ed, posibilita integrar uno en su frontal y otro en el lateral de 120 mm y un tercero en la zona trasera de 80 mm. Adem\u00e1s, para proteger de las altas temperaturas la CPU, permite a\u00f1adir un cooler de 147 mm.","2":"","3":"","4":""},"description_short":{"1":"Micro-ATX, Panel frontal con acabado cepillado, USB 3.0, Mini torre, Cooler CPU: 147 mm (M\u00e1x.),  VGA: 315 mm (M\u00e1x.), Acero SPCC 0.4 mm \/ Pl\u00e1stico ABS","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":31.4874,"unit_price_tax":31.4874,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"NOX","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/237\/89229\/64624220\/bg\/caja-nox-micro-atx-nox-arca-2x-usb-3-0.jpg"],"wholesale_price":27.87}}},"2529122113026":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["2529122113026",false],"wholesale_price":[38.36,false],"price":[42.1872,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185605","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/729b5a3746cbd998c39249a209850711.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ11356655","unit_price":42.1872,"category":"Cajas y fuentes","brand":"NOX","name_pt":"CAJA NOX Caja Slim con Fuente 500W M-ATX Nox Lite070","quantity":5,"ean13":"2529122113026","description_short_pt":"Slim, Micro ATX \/ ITX, 2x USB 3.0, HD audio, Cooler CPU 75 mm, VGA 256 mm, Chasis de acero SPCC 0.5 mmm \/ Pl\u00e1stico ABS","description_pt":"LITE070Nox Lite070 es una caja slim USB 3.0 que destaca por un dise\u00f1o compacto, minimalista y elegante. Compatible con placas base tanto Micro ATX como Mini ITX, incluye una fuente de alimentaci\u00f3n de 500W.C\u00d3MODA ACCESIBILIDADLas conexiones principales se sit\u00faan en la parte frontal. Adem\u00e1s de dos USB 3.0 de alta velocidad, tambi\u00e9n cuenta con conectores HD audio para micr\u00f3fono y auriculares.DISE\u00d1O COMPACTOConstruida en los materiales ABS de calidad y robusto acero SPCC de 0,5 mm, con un elegante frontal con acabado cepillado, la caja Nox Lite070 es perfecta para cualquier entorno gracias a un dise\u00f1o sobrio en color negro y un tama\u00f1o compacto que se adapta a todo espacio, pudi\u00e9ndose colocar tanto en vertical como en horizontal.Este ligero chasis cuenta con una bah\u00eda externa de 5.25'' y dos internas de 3.5'' y de 2.5''. Por otro lado, admite gr\u00e1ficas de hasta 256 mm y posee cuatro slots de expansi\u00f3n.REFRIGERACI\u00d3N EFICIENTENox Lite070 incluye un ventilador de 80 mm. Adem\u00e1s, para optimizar el flujo de aire, permite integrar un CPU cooler de 75 mm para disipar adecuadamente el calor, manteniendo los componentes a una temperatura perfecta.COMPATIBILIDADNox Lite 070 es una caja funcional y vers\u00e1til perfecta para un PC profesional o de uso dom\u00e9stico compatible con Micro ATX y Mini ITX: posibilita montar configuraciones potentes en un reducido espacio.","images":"https:\/\/www.dmi.es\/photo\/237\/89230\/64625589\/bg\/caja-nox-caja-slim-con-fuente-500w-m-atx-nox-lite070.jpg","wholesale_price":"38.36","unit_price_tax":42.1872},"product_model":{"product_data":{"ean13":["2529122113026"],"reference":"CJ11356655","name":{"1":"CAJA NOX Caja Slim con Fuente 500W M-ATX Nox Lite070","2":"","3":"","4":""},"description":{"1":"LITE070Nox Lite070 es una caja slim USB 3.0 que destaca por un dise\u00f1o compacto, minimalista y elegante. Compatible con placas base tanto Micro ATX como Mini ITX, incluye una fuente de alimentaci\u00f3n de 500W.C\u00d3MODA ACCESIBILIDADLas conexiones principales se sit\u00faan en la parte frontal. Adem\u00e1s de dos USB 3.0 de alta velocidad, tambi\u00e9n cuenta con conectores HD audio para micr\u00f3fono y auriculares.DISE\u00d1O COMPACTOConstruida en los materiales ABS de calidad y robusto acero SPCC de 0,5 mm, con un elegante frontal con acabado cepillado, la caja Nox Lite070 es perfecta para cualquier entorno gracias a un dise\u00f1o sobrio en color negro y un tama\u00f1o compacto que se adapta a todo espacio, pudi\u00e9ndose colocar tanto en vertical como en horizontal.Este ligero chasis cuenta con una bah\u00eda externa de 5.25'' y dos internas de 3.5'' y de 2.5''. Por otro lado, admite gr\u00e1ficas de hasta 256 mm y posee cuatro slots de expansi\u00f3n.REFRIGERACI\u00d3N EFICIENTENox Lite070 incluye un ventilador de 80 mm. Adem\u00e1s, para optimizar el flujo de aire, permite integrar un CPU cooler de 75 mm para disipar adecuadamente el calor, manteniendo los componentes a una temperatura perfecta.COMPATIBILIDADNox Lite 070 es una caja funcional y vers\u00e1til perfecta para un PC profesional o de uso dom\u00e9stico compatible con Micro ATX y Mini ITX: posibilita montar configuraciones potentes en un reducido espacio.","2":"","3":"","4":""},"description_short":{"1":"Slim, Micro ATX \/ ITX, 2x USB 3.0, HD audio, Cooler CPU 75 mm, VGA 256 mm, Chasis de acero SPCC 0.5 mmm \/ Pl\u00e1stico ABS","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":42.1872,"unit_price_tax":42.1872,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"NOX","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/237\/89230\/64625589\/bg\/caja-nox-caja-slim-con-fuente-500w-m-atx-nox-lite070.jpg"],"wholesale_price":38.36}}},"8436587973109":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587973109",false],"wholesale_price":[61.36,false],"price":[65.6472,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185606","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/14e698a2ce4a13f578e01119ef05910e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ11356658","unit_price":65.6472,"category":"Cajas y fuentes","brand":"NOX","name_pt":"CAJA NOX Semitorre ARGB ATX Nox Hummer Nemesis Blanca","quantity":5,"ean13":"8436587973109","description_short_pt":"Semitorre, ATX \/ M-ATX, 1x 3.5\" + 3x 2.5\" \/ 2x 3.5 + 2x 2.5\" \/ 3x 3.5\" + 1x 2.5\", CPU cooler: 166 mm, VGA: 350 mm, Chasis de acero SPCC 0.8 y 0.6 mm","description_pt":"HUMMER NEMESISNox Hummer Nemesis es una semitorre premium con un impactante dise\u00f1o minimal con doble cristal templado. Este chasis de acero es compatible con gr\u00e1ficas de gran tama\u00f1o, de hasta 350 mm, y sistemas de refrigeraci\u00f3n l\u00edquida. Adem\u00e1s, incluye dos ventiladores LED ARGB que garantizan un buen flujo de aire, pudiendo montar hasta un total de ocho ventiladores. En esta semitorre de Nox, todo ha sido pensado para el m\u00e1ximo rendimiento.UN ESTILO \u00daNICODisponible en dos colores, blanco o negro, con una est\u00e9tica incre\u00edble, la Nox Hummer Nemesis presenta un dise\u00f1o gaming minimalista. Con doble cristal, uno en su frontal y otro en el lateral, el interior del equipo queda a la vista, disfrutando de la configuraci\u00f3n avanzada y de la iluminaci\u00f3n ARGB como nunca.Construida en acero s\u00f3lido de 0,6 mm y 0,8 mm, que contribuye a protegerla de ara\u00f1azos o golpes, posee excelentes acabados gracias a unos materiales de alta calidad. Las patas de la Nox Hummer Nemesis cuentan con base de goma para evitar las molestas vibraciones.Por otro lado, para un excelente mantenimiento de los componentes, cuenta con filtro antipolvo extra\u00edble en la parte superior que facilita la limpieza, as\u00ed como un excelente sistema de gesti\u00f3n del cableado que favorece un montaje f\u00e1cil y ayuda a que el flujo de aire se distribuya de manera uniforme.ALCANZA LA VICTORIAPara que no tengas que preocuparte de nada y puedas centrarte en hacerte con la partida, esta caja de Nox concentra los accesos principales en su parte superior. Aqu\u00ed encontrar\u00e1s dos puertos dedicados a los USB 3.0 y tambi\u00e9n dos USB 2.0, adem\u00e1s de las conexiones HD audio y micr\u00f3fono.CAPACIDAD M\u00c1XIMACompatible con sistemas de refrigeraci\u00f3n l\u00edquida, la Nox Hummer Nemesis permite montar una tarjeta gr\u00e1fica de 350 mm y, adem\u00e1s, cuenta con siete ranuras de expansi\u00f3n para adaptar el equipo a las distintas necesidades que puedan ir surgiendo.GRAN CAUDAL DE AIRETrae instalados dos ventiladores infinitos LED ARGB en su frontal, permitiendo integrar hasta un total de ocho, logrando un gran caudal de aire. Los componentes se mantendr\u00e1n fr\u00edos, rindiendo de manera eficiente.Podr\u00e1s instalar tres ventiladores de 120 mm o dos de 140 mm en su frontal, uno de 120 mm en la parte trasera o dos de 120 mm o 140 mm en la zona superior. Por otro lado, esta torre de Nox pensada para equipos de altas exigencias, admite un CPU cooler de 166 mm para disipar el calor.M\u00daLTIPLES PRESTACIONESNox Hummer Nemesis es compatible con los formatos ATX y Micro ATX. Tambi\u00e9n admite m\u00faltiples combinaciones de hasta cuatro discos duros: podr\u00e1s instalar 1x 3.5 y 3x 2.5\" \u00f3 2x 3.5 y 2x 2.5\" \u00f3 3x 3.5\" y 1x 2.5\".","images":"https:\/\/www.dmi.es\/photo\/237\/89233\/64624582\/bg\/caja-nox-semitorre-argb-atx-nox-hummer-nemesis-blanca.jpg","wholesale_price":"61.36","unit_price_tax":65.6472},"product_model":{"product_data":{"ean13":["8436587973109"],"reference":"CJ11356658","name":{"1":"CAJA NOX Semitorre ARGB ATX Nox Hummer Nemesis Blanca","2":"","3":"","4":""},"description":{"1":"HUMMER NEMESISNox Hummer Nemesis es una semitorre premium con un impactante dise\u00f1o minimal con doble cristal templado. Este chasis de acero es compatible con gr\u00e1ficas de gran tama\u00f1o, de hasta 350 mm, y sistemas de refrigeraci\u00f3n l\u00edquida. Adem\u00e1s, incluye dos ventiladores LED ARGB que garantizan un buen flujo de aire, pudiendo montar hasta un total de ocho ventiladores. En esta semitorre de Nox, todo ha sido pensado para el m\u00e1ximo rendimiento.UN ESTILO \u00daNICODisponible en dos colores, blanco o negro, con una est\u00e9tica incre\u00edble, la Nox Hummer Nemesis presenta un dise\u00f1o gaming minimalista. Con doble cristal, uno en su frontal y otro en el lateral, el interior del equipo queda a la vista, disfrutando de la configuraci\u00f3n avanzada y de la iluminaci\u00f3n ARGB como nunca.Construida en acero s\u00f3lido de 0,6 mm y 0,8 mm, que contribuye a protegerla de ara\u00f1azos o golpes, posee excelentes acabados gracias a unos materiales de alta calidad. Las patas de la Nox Hummer Nemesis cuentan con base de goma para evitar las molestas vibraci