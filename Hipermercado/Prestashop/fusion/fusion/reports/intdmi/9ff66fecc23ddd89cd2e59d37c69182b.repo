ara ba\u00f1arse).","2":"","3":"","4":""},"description_short":{"1":"Leotec Smartwatch MultiSport Walea","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Leotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":22.7664,"unit_price_tax":22.7664,"tax_rules_group":null,"category":"Relojes Inteligentes","brand":"Leotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/2647\/102051\/81871195\/bg\/leotec-smartwatch-multisport-con-llamadas-walea-negro.jpg"],"wholesale_price":19.32}}},"0194644151942":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194644151942",false],"wholesale_price":[148.75,false],"price":[154.785,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187929","Cat. IDs: 101","Associated Categories","Cat. Default: 101","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/724a1ae3d35ce0cd4001381337cfb005.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CM50511287","unit_price":154.785,"category":"Smarthome y Seguridad","brand":"Eufy","name_pt":"VIDEOPORTERO INTELIGENTE EUFY E340 CON TIMBRE","quantity":5,"ean13":"0194644151942","description_short_pt":"eufy Security Video Doorbell E340, c\u00e1mara doble con sistema de control de entregas, 2K Full HD y visi\u00f3n nocturna a color, por cable o con bater\u00eda, timbre inal\u00e1mbrico, almacenamiento local ampliable hasta 128 GB, sin cuotas mensuales","description_pt":"Doble c\u00e1mara: vea todo lo que i mporta, desde la puerta hasta el suelo1. La c\u00e1mara doble mejora la coberturaLas dos c\u00e1maras funcionan conjuntamente para ofrecerle una visualizaci\u00f3n avanzada. La c\u00e1mara frontal enfoca a las personas, mientras que la c\u00e1mara orientada hacia abajo llega a todo s los rincones con una imagen del suelo frente a la puerta.2. Vigile las entregas con la inteligencia artificialSepa de inmediato cu\u00e1ndo recibe un paquete y reciba alertas si alguien se acerca alpaquete antes de que usted lo recoja.3. Vea todo con nitidez en 2K Full HDLa claridad en 2K revela m\u00e1s detalles. Vea im\u00e1genes claras y detalladas de la entrada y a cualquier persona que pase por all\u00ed.4. A color d\u00eda y nocheLa visi\u00f3n nocturna a color detecta los rostros con mayor claridad y aumenta la distancia visibl e por la noche.5. El primer sistema con luz doble de la industriaLas luces dobles en la parte superior e inferior son sensibles al movimiento e iluminan el camino cuando alguien se acerca de noche. Dan mayor seguridad y mejor visi\u00f3n en el camino hacia la pu erta.","images":"https:\/\/www.dmi.es\/photo\/1557\/101820\/84910539\/bg\/videoportero-inteligente-eufy-e340-con-timbre.jpg","wholesale_price":"148.75","unit_price_tax":154.785},"product_model":{"product_data":{"ean13":["0194644151942"],"reference":"CM50511287","name":{"1":"VIDEOPORTERO INTELIGENTE EUFY E340 CON TIMBRE","2":"","3":"","4":""},"description":{"1":"Doble c\u00e1mara: vea todo lo que i mporta, desde la puerta hasta el suelo1. La c\u00e1mara doble mejora la coberturaLas dos c\u00e1maras funcionan conjuntamente para ofrecerle una visualizaci\u00f3n avanzada. La c\u00e1mara frontal enfoca a las personas, mientras que la c\u00e1mara orientada hacia abajo llega a todo s los rincones con una imagen del suelo frente a la puerta.2. Vigile las entregas con la inteligencia artificialSepa de inmediato cu\u00e1ndo recibe un paquete y reciba alertas si alguien se acerca alpaquete antes de que u