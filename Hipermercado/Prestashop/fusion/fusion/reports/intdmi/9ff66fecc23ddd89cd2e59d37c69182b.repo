rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Belkin","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":28.7946,"unit_price_tax":28.7946,"tax_rules_group":null,"category":"Electricidad","brand":"Belkin","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1388\/75126\/15834758\/bg\/regleta-belkin-surgerstrip-8-tomas-2x-usb--a-proteccion-antipicos-blanco-montabl.jpg"],"wholesale_price":25.23}}},"8435484039888":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484039888",false],"wholesale_price":[26.16,false],"price":[29.7432,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189308","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c1ded59f4d94d652a1f07e8555e6645b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO17330127","unit_price":29.7432,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"POWER TITANIUM 650 EASYGO INOX","quantity":0,"ean13":"8435484039888","description_short_pt":"650 W, 2 x 600 ml, 2 tapas","description_pt":"Batidora de smoothies con vaso port\u00e1tilM\u00e1xima eficiencia con 650 W.El potente motor de 650 W permite obtener resultados finos y homog\u00e9neos en cuesti\u00f3n de segundos. Tritura hasta los alimentos m\u00e1s resistentes como frutos secos o hielo y disfruta de mezclas y tus sabores preferidos.Texturas cremosas a diario.Sus cuchillas de 4 hojas con recubrimiento de titanio negro permite mantener el acero afilado durante m\u00e1s tiempo. Con ellas podr\u00e1s conseguir las texturas m\u00e1s cremosas y saludables para tu d\u00eda a d\u00eda. Disfruta de una gran variedad de bebidas refrescantes, desde deliciosos batidos y smoothies, hasta frapp\u00e9s o granizados.Donde y cuando t\u00fa quieras.Cuenta con dos tapas especialmente dise\u00f1adas para poder hacer el vac\u00edo y conservar los nutrientes y propiedades de tus batidos durante mucho m\u00e1s tiempo. Prepara tu batido y ll\u00e9vatelo al trabajo con la seguridad de que se mantendr\u00e1 intacto y lleno de sabor. Adem\u00e1s, gracias a su c\u00f3moda asa de transporte, podr\u00e1s llevarte tus batidos all\u00e1 donde vayas.Bebidas siempre fr\u00edas.No importa el d\u00f3nde ni el cu\u00e1ndo, tus batidos se mantendr\u00e1n fr\u00edos durante m\u00e1s tiempo gracias a los dos tubos refrigeradores. Es tan sencillo como llenar el tubo de agua, introducirlo en el congelador, y cuando tengas tu batido listo, colocarlo adecuadamente en la tapa. Al contar con dos tubos podr\u00e1s preparar hasta dos de tus batidos preferidos y llevarlos donde quieras para tomarte tu batido fr\u00edo cuando quieras. Refr\u00e9scate y disfruta de cada momento del d\u00eda.Conserva sus propiedades durante m\u00e1s tiempo.Cuenta con dos tapas especialmente dise\u00f1adas para poder hacer el vac\u00edo y conservar los nutrientes y propiedades de tus batidos durante mucho m\u00e1s tiempo. Podr\u00e1s preparar tu batido por la ma\u00f1ana y llevarlo al trabajo con la seguridad de que se mantendr\u00e1 intacto y lleno de sabor, o guardarlo en la nevera para beberlo cuando llegues a casa. Tambi\u00e9n disponen de un asa para facilitar su transporte y su boquilla permite beber directamente de forma c\u00f3moda.Uso sencillo e intuitivo.Power Titanium 650 Fresh&Go Inox incluye un molinillo para caf\u00e9 o especias con doble cuchilla plana, para moler c\u00f3modamente tu propio caf\u00e9, especias, cereales o sal y hacer combinaciones de frutos secos para tus postres. Con un solo toque, podr\u00e1s disfrutar de todas tus mezclas c\u00f3modamente.","images":"https:\/\/www.dmi.es\/photo\/1392\/105492\/89677784\/bg\/power-titanium-650-easygo-inox.jpg","wholesale_price":"26.16","unit_price_tax":29.7432},"product_model":{"product_data":{"ean13":["8435484039888"],"reference":"CO17330127","name":{"1":"POWER TITANIUM 650 EASYGO INOX","2":"","3":"","4":""},"description":{"1":"Batidora de smoothies con vaso port\u00e1tilM\u00e1xima eficiencia con 650 W.El potente motor de 650 W permite obtener resultados finos y homog\u00e9neos en cuesti\u00f3n de segundos. Tritura hasta los alimentos m\u00e1s resistentes como frutos secos o hielo y disfruta de mezclas y tus sabores preferidos.Texturas cremosas a diario.Sus cuchillas de 4 hojas con recubrimiento de titanio negro permite mantener el acero afilado durante m\u00e1s tiempo. Con ellas podr\u00e1s conseguir las texturas m\u00e1s cremosas y saludables para tu d\u00eda a d\u00eda. Disfruta de una gran variedad de bebidas refrescantes, desde deliciosos batidos y smoothies, hasta frapp\u00e9s o granizados.Donde y cuando t\u00fa quieras.Cuenta con dos tapas especialmente dise\u00f1adas para poder hacer el vac\u00edo y conservar los nutrientes y propiedades de tus batidos durante mucho m\u00e1s tiempo. Prepara tu batido y ll\u00e9vatelo al trabajo con la seguridad de que se mantendr\u00e1 intacto y lleno de sabor. Adem\u00e1s, gracias a su c\u00f3moda asa de transporte, podr\u00e1s llevarte tus batidos all\u00e1 donde vayas.Bebidas siempre fr\u00edas.No importa el d\u00f3nde ni el cu\u00e1ndo, tus batidos se mantendr\u00e1n fr\u00edos durante m\u00e1s tiempo gracias a los dos tubos refrigeradores. Es tan sencillo como llenar el tubo de agua, introducirlo en el congelador, y cuando tengas tu batido listo, colocarlo adecuadamente en la tapa. Al contar con dos tubos podr\u00e1s preparar hasta dos de tus batidos preferidos y llevarlos donde quieras para tomarte tu batido fr\u00edo cuando quieras. Refr\u00e9scate y disfruta de cada momento del d\u00eda.Conserva sus propiedades durante m\u00e1s tiempo.Cuenta con dos tapas especialmente dise\u00f1adas para poder hacer el vac\u00edo y conservar los nutrientes y propiedades de tus batidos durante mucho m\u00e1s tiempo. Podr\u00e1s preparar tu batido por la ma\u00f1ana y llevarlo al trabajo con la seguridad de que se mantendr\u00e1 intacto y lleno de sabor, o guardarlo en la nevera para beberlo cuando llegues a casa. Tambi\u00e9n disponen de un asa para facilitar su transporte y su boquilla permite beber directamente de forma c\u00f3moda.Uso sencillo e intuitivo.Power Titanium 650 Fresh&Go Inox incluye un molinillo para caf\u00e9 o especias con doble cuchilla plana, para moler c\u00f3modamente tu propio caf\u00e9, especias, cereales o sal y hacer combinaciones de frutos secos para tus postres. Con un solo toque, podr\u00e1s disfrutar de todas tus mezclas c\u00f3modamente.","2":"","3":"","4":""},"description_short":{"1":"650 W, 2 x 600 ml, 2 tapas","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":29.7432,"unit_price_tax":29.7432,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1392\/105492\/89677784\/bg\/power-titanium-650-easygo-inox.jpg"],"wholesale_price":26.16}}},"0195892080718":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195892080718",false],"wholesale_price":[7.76,false],"price":[10.9752,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},