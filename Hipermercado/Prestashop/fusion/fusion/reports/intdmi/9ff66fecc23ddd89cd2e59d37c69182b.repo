:["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186965","Cat. IDs: 478","Associated Categories","Cat. Default: 478","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3bf090f999e68b52ae383876d5671a5c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PE40496089","unit_price":191.811,"category":"Altavoces","brand":"Jabra","name_pt":"ALTAVOZ BLUETOOTH JABRA SPEAK 710 MS USB BT","quantity":0,"ean13":"5706991020359","description_short_pt":"Jabra Speak 710","description_pt":"Disfrute de una gran calidad de sonido en un dise\u00f1o port\u00e1til premium para llamadas y m\u00fasica con el altavoz Speak 710. El primer dispositivo de conferencia profesional y personal con un altavoz HiFi para conversaci\u00f3n y m\u00fasica n\u00edtidas.El modelo Speak 710, dise\u00f1ado para ofrecer la mejor calidad de sonido en un altavoz profesional port\u00e1til, est\u00e1 creado para usuarios que buscan un sonido incre\u00edble para conferencias telef\u00f3nicas. Conexi\u00f3n con dispositivos inteligentes u ordenadores port\u00e1tiles mediante USB o Bluetooth\u00ae. Un alcance inal\u00e1mbrico de 30 m desde su ordenador port\u00e1til o smartphone, 15 horas de bater\u00eda y cobertura para hasta 6 personas en la sala. Bot\u00f3n inteligente para acceder con un toque a MS Cortana, Siri o Google Assistant?*. Compatible con las principales plataformas de CU","images":"https:\/\/www.dmi.es\/photo\/1687\/90401\/55806591\/bg\/altavoz-bluetooth-jabra-speak-710-ms-usb-bt.jpg","wholesale_price":"185.05","unit_price_tax":191.811},"product_model":{"product_data":{"ean13":["5706991020359"],"reference":"PE40496089","name":{"1":"ALTAVOZ BLUETOOTH JABRA SPEAK 710 MS USB BT","2":"","3":"","4":""},"description":{"1":"Disfrute de una gran calidad de sonido en un dise\u00f1o port\u00e1til premium para llamadas y m\u00fasica con el altavoz Speak 710. El primer dispositivo de conferencia profesional y personal con un altavoz HiFi para conversaci\u00f3n y m\u00fasica n\u00edtidas.El modelo Speak 710, dise\u00f1ado para ofrecer la mejor calidad de sonido en un altavoz profesional port\u00e1til, est\u00e1 creado para usuarios que buscan un sonido incre\u00edble para conferencias telef\u00f3nicas. Conexi\u00f3n con dispositivos inteligentes u ordenadores port\u00e1tiles mediante USB o Bluetooth\u00ae. Un alcance inal\u00e1mbrico de 30 m desde su ordenador port\u00e1til o smartphone, 15 horas de bater\u00eda y cobertura para hasta 6 personas en la sala. Bot\u00f3n inteligente para acceder con un toque a MS Cortana, Siri o Google Assistant?*. Compatible con las principales plataformas de CU","2":"","3":"","4":""},"description_short":{"1":"Jabra Speak 710","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Jabra","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":191.811,"unit_price_tax":191.811,"tax_rules_group":null,"category":"Altavoces","brand":"Jabra","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1687\/90401\/55806591\/bg\/altavoz-bluetooth-jabra-speak-710-ms-usb-bt.jpg"],"wholesale_price":185.05}}},"5051794027297":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5051794027297",false],"wholesale_price":[25.5,false],"price":[29.07,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186966","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/9167b2f94b6e183e8a817a0db4b664b4.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"VE40131014","unit_price":29.07,"category":"Accesorios port\u00e1tiles","brand":"Targus","name_pt":"BASE REFRIGERADORA PARA PORTATIL TARGUS 15-17\" GRIS","quantity":5,"ean13":"5051794027297","description_short_pt":"Lap chill mat- Ventilador para ordenador port\u00e1til","description_pt":"La alfombrilla refrigeradora Chill Mat de Targus proporciona una superficie c\u00f3moda y ergon\u00f3mica para mantener la refrigeraci\u00f3n de su port\u00e1til o la suya propia en caso de utilizarlo en su regazo. La alfombrilla es perfecta para colocarla sobre sus piernas y dispersa el calor generado por el port\u00e1til mediante dos ventiladores. Esta ventilaci\u00f3n puede obstruirse si se usa el port\u00e1til encima de un coj\u00edn o cubierta. S\u00f3lo necesita conectar el conector USB al port\u00e1til para iniciar la refrigeraci\u00f3n. La inclinaci\u00f3n ergon\u00f3mica facilita el tecleado y el material de neopreno blando proporciona un coj\u00edn confortable para el regazo. El dise\u00f1o abierto permite que los ventiladores no hagan ruido y estimulan un flujo de aire constante. Cuatro pivotes de pl\u00e1stico en la cara superior del Chill Mat evitan que el port\u00e1til se resbale. El dise\u00f1o inclinado combinado con un material de neopreno blando garantizan un confort m\u00e1ximo durante largos periodos de uso y hacen que usar el port\u00e1til sea una experiencia agradable.","images":"https:\/\/www.dmi.es\/photo\/1689\/72134\/33355135\/bg\/base-refrigeradora-para-portatil-targus-15-17--gris.jpg","wholesale_price":"25.50","unit_price_tax":29.07},"product_model":{"product_data":{"ean13":["5051794027297"],"reference":"VE40131014","name":{"1":"BASE REFRIGERADORA PARA PORTATIL TARGUS 15-17\" GRIS","2":"","3":"","4":""},"description":{"1":"La alfombrilla refrigeradora Chill Mat de Targus proporciona una superficie c\u00f3moda y ergon\u00f3mica para mantener la refrigeraci\u00f3n de su port\u00e1til o la suya propia en caso de utilizarlo en su regazo. La alfombrilla es perfecta para colocarla sobre sus piernas y dispersa el calor generado por el port\u00e1til mediante dos ventiladores. Esta ventilaci\u00f3n puede obstruirse si se usa el port\u00e1til encima de un coj\u00edn o cubierta. S\u00f3lo necesita conectar el conector USB al port\u00e1til para iniciar la refrigeraci\u00f3n. La inclinaci\u00f3n ergon\u00f3mica facilita el tecleado y el material de neopreno blando proporciona un coj\u00edn confortable para el regazo. El dise\u00f1o abierto permite que los ventiladores no hagan ruido y estimulan un flujo de aire constante. Cuatro pivotes de pl\u00e1stico en la cara superior del Chill Mat evitan que el port\u00e1til se resbale. El dise\u00f1o inclinado combinado con un material de neopreno blando garantizan un confort m\u00e1ximo durante largos periodos de uso y hacen que usar el port\u00e1til sea una experiencia agradable.","2":"","3":"","4":""},"description_short":{"1":"Lap chill mat- Ventilador para ordenador port\u00e1til","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Targus","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":29.07,"unit_price_tax":29.07,"tax_rules_group":null,"category":"Accesorios port\u00e1tiles","brand":"Targus","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/1689\/72134\/33355135\/bg\/base-refrigeradora-para-portatil-targus-15-17--gris.jpg"],"wholesale_price":25.5}}},"5901969410235":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"