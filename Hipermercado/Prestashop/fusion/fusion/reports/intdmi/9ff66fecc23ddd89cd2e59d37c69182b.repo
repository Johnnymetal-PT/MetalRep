"product":["",false],"ean13":["8435484015332",false],"wholesale_price":[56.12,false],"price":[60.3024,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190423","Cat. IDs: 355","Associated Categories","Cat. Default: 355","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/667045afd5ee174b169033e75bcc7152.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CO28330056","unit_price":60.3024,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","name_pt":"MICROONDAS PROCLEAN 5120 INOX","quantity":0,"ean13":"8435484015332","description_short_pt":"ProClean 5120, 20L, 700\/800W, Ready2Clean, 3DWave , LED","description_pt":"El microondas ProClean 5120 Mirror de 20 litros con dise\u00f1o elegante y frontal MirrorDoor marcar\u00e1 la diferencia en tu cocina. Dispone de la tecnolog\u00eda 3DWave, un sistema de ondas altamente eficiente que envuelve al completo los alimentos. Sus 700 W de potencia repartidos en 5 niveles se ajustan a todo tipo de platos. Adem\u00e1s, cuenta con un grill de 800 W de potencia que permite asar, dorar y cocinar. Sus 8 programas predeterminados cocinan diferentes alimentos con los mejores resultados. El revestimiento de su interior es Ready2Clean para agilizarte una limpieza impecable. No tendr\u00e1s que estar pendiente del final del cocinado, ya que su avisador ac\u00fastico te informar\u00e1 cuando est\u00e9 la comida. La pantalla LED muestra el programa seleccionado y el tiempo exacto. Adem\u00e1s, su programa de Inicio autom\u00e1tico te calentar\u00e1 la comida justo a la hora que deseas comer. Y protege a los m\u00e1s peque\u00f1os con su seguro infantil.- Microondas de acero inoxidable de 20 litros de capacidad.- Interior con revestimiento Ready2Clean m\u00e1s f\u00e1cil de limpiar, ya que repele la suciedad.- Dise\u00f1o elegante con frontal MirrorDoor efecto espejo y panel y tirador de acero inoxidable.- Tecnolog\u00eda 3DWave con un sistema de ondas m\u00e1s eficiente que envuelve al 100 % los alimentos. 8 programas predeterminados para diferentes alimentos.- Pantalla LED con reloj que muestra el tiempo de cocinado y la hora. 700 W de potencia microondas en 5 niveles.- Grill de 800 W con resistencias hal\u00f3genas m\u00e1s eficientes.- Modo de descongelaci\u00f3n que se adapta a todos los alimentos.- Inicio autom\u00e1tico: programa el microondas para que se ponga en marcha a la hora de comer.- Temporizador hasta 60 minutos con avisador ac\u00fastico de final de cocci\u00f3n.- Seguro infantil para proteger a los m\u00e1s peque\u00f1os.","images":"https:\/\/www.dmi.es\/photo\/1325\/105509\/73172468\/bg\/microondas-proclean-5120-inox.jpg","wholesale_price":"56.12","unit_price_tax":60.3024},"product_model":{"product_data":{"ean13":["8435484015332"],"reference":"CO28330056","name":{"1":"MICROONDAS PROCLEAN 5120 INOX","2":"","3":"","4":""},"description":{"1":"El microondas ProClean 5120 Mirror de 20 litros con dise\u00f1o elegante y frontal MirrorDoor marcar\u00e1 la diferencia en tu cocina. Dispone de la tecnolog\u00eda 3DWave, un sistema de ondas altamente eficiente que envuelve al completo los alimentos. Sus 700 W de potencia repartidos en 5 niveles se ajustan a todo tipo de platos. Adem\u00e1s, cuenta con un grill de 800 W de potencia que permite asar, dorar y cocinar. Sus 8 programas predeterminados cocinan diferentes alimentos con los mejores resultados. El revestimiento de su interior es Ready2Clean para agilizarte una limpieza impecable. No tendr\u00e1s que estar pendiente del final del cocinado, ya que su avisador ac\u00fastico te informar\u00e1 cuando est\u00e9 la comida. La pantalla LED muestra el programa seleccionado y el tiempo exacto. Adem\u00e1s, su programa de Inicio autom\u00e1tico te calentar\u00e1 la comida justo a la hora que deseas comer. Y protege a los m\u00e1s peque\u00f1os con su seguro infantil.- Microondas de acero inoxidable de 20 litros de capacidad.- Interior con revestimiento Ready2Clean m\u00e1s f\u00e1cil de limpiar, ya que repele la suciedad.- Dise\u00f1o elegante con frontal MirrorDoor efecto espejo y panel y tirador de acero inoxidable.- Tecnolog\u00eda 3DWave con un sistema de ondas m\u00e1s eficiente que envuelve al 100 % los alimentos. 8 programas predeterminados para diferentes alimentos.- Pantalla LED con reloj que muestra el tiempo de cocinado y la hora. 700 W de potencia microondas en 5 niveles.- Grill de 800 W con resistencias hal\u00f3genas m\u00e1s eficientes.- Modo de descongelaci\u00f3n que se adapta a todos los alimentos.- Inicio autom\u00e1tico: programa el microondas para que se ponga en marcha a la hora de comer.- Temporizador hasta 60 minutos con avisador ac\u00fastico de final de cocci\u00f3n.- Seguro infantil para proteger a los m\u00e1s peque\u00f1os.","2":"","3":"","4":""},"description_short":{"1":"ProClean 5120, 20L, 700\/800W, Ready2Clean, 3DWave , LED","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":60.3024,"unit_price_tax":60.3024,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1325\/105509\/73172468\/bg\/microondas-proclean-5120-inox.jpg"],"wholesale_price":56.12}}},"8435484015271":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484015271",false],"wholesale_price":[46.09,false],"price":[50.0718,false],"id_tax_rules_group":[1,fa