thout combinations",true]},"need_alert":true,"errors":["Create product ID:188980","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5e41f9c6ce81dfe1e885658ea0219aee.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CA11267306","unit_price":15.4836,"category":"Adaptadores y Convertidores","brand":"Digitus","name_pt":"ADAPTADOR DIGITUS USB 3.0 - VGA ADAPTADOR INPUT USB OUTPUT VGA 1080p","quantity":0,"ean13":"4016032390725","description_short_pt":"USB 3.0 to VGA Adapter, 1080p Input USB, Output VGA","description_pt":"Ampl\u00ede su espacio de trabajo (pantalla doble), conecte un monitor, televisor o proyector mediante la interfaz USB.- Conforme a las especificaciones de USB 3.0- Resoluci\u00f3n de v\u00eddeo con calidad Full HD de hasta 1080 p- Presenta varios modos de reproducci\u00f3n: Pantalla principal o externa, modo espejo- Agregue o desinstale el monitor sin reiniciar el sistema- Se pueden utilizar hasta 2 adaptadores gr\u00e1ficos para ordenador simult\u00e1neamente- Reanudaci\u00f3n autom\u00e1tica del modo hibernaci\u00f3n o en suspensi\u00f3nEl adaptador de pantalla USB 3.0 es un dispositivo que permite conectar un segundo dispositivo de pantalla a un ordenador mediante el puerto USB 3.0. Con este dise\u00f1o conveniente, se pueden conectar hasta 2 dispositivos de pantalla a un ordenador sin necesidad de instalar tarjetas de video adicionales. Una vez instalado el controlador, el monitor USB conectado se activar\u00e1 inmediatamente. Sin tecla de funci\u00f3n en el adaptador y sin necesidad de reiniciar el sistema operativo despu\u00e9s de desconectar el adaptador USB. El rendimiento del sistema es un tema importante cuando se utilizan m\u00faltiples monitores. Otra de las ventajas de este adaptador es que ocupa pocos recursos del ordenador, asegurando que los usuarios obtengan la calidad de visualizaci\u00f3n sin comprometer el rendimiento del ordenador.","images":"https:\/\/www.dmi.es\/photo\/2939\/72970\/55665037\/bg\/adaptador-digitus-usb-3-0---vga-adaptador-input-usb-output-vga-1080p.jpg","wholesale_price":"12.18","unit_price_tax":15.4836},"product_model":{"product_data":{"ean13":["4016032390725"],"reference":"CA11267306","name":{"1":"ADAPTADOR DIGITUS USB 3.0 - VGA ADAPTADOR INPUT USB OUTPUT VGA 1080p","2":"","3":"","4":""},"description":{"1":"Ampl\u00ede su espacio de trabajo (pantalla doble), conecte un monitor, televisor o proyector mediante la interfaz USB.- Conforme a las especificaciones de USB 3.0- Resoluci\u00f3n de v\u00eddeo con calidad Full HD de hasta 1080 p- Presenta varios modos de reproducci\u00f3n: Pantalla principal o externa, modo espejo- Agregue o desinstale el monitor sin reiniciar el sistema- Se pueden utilizar hasta 2 adaptadores gr\u00e1ficos para ordenador simult\u00e1neamente- Reanudaci\u00f3n autom\u00e1tica del modo hibernaci\u00f3n o en suspensi\u00f3nEl adaptador de pantalla USB 3.0 es un dispositivo que permite conectar un segundo dispositivo de pantalla a un ordenador mediante el puerto USB 3.0. Con este dise\u00f1o conveniente, se pueden conectar hasta 2 dispositivos de pantalla a un ordenador sin necesidad de instalar tarjetas de video adicionales. Una vez instalado el controlador, el monitor USB conectado se activar\u00e1 inmediatamente. Sin tecla de funci\u00f3n en el adaptador y sin necesidad de reiniciar el sistema operativo despu\u00e9s de desconectar el adaptador USB. El rendimiento del sistema es un tema importante cuando se utilizan m\u00faltiples monitores. Otra de las ventajas de este adaptador es que ocupa pocos recursos del ordenador, asegurando que los usuarios obtengan la calidad de visualizaci\u00f3n sin comprometer el rendimiento del ordenador.","2":"","3":"","4":""},"description_short":{"1":"USB 3.0 to VGA Adapter, 1080p Input USB, Output VGA","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1"