ct":["",false],"ean13":["4044951033706",false],"wholesale_price":[10.54,false],"price":[13.8108,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186786","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/702d04311b3beed83a89e1dfe59f6ac0.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ12312031","unit_price":13.810799999999999,"category":"Perif\u00e9ricos","brand":"Sharkoon","name_pt":"SWITCH SET SHARKOON KAILH BOX MARRON","quantity":0,"ean13":"4044951033706","description_short_pt":"Tactile Kailh Box BROWN, 35 interruptores (switches) de teclado, 80 millones de pulsaciones, marr\u00f3n","description_pt":"Los interruptores t\u00e1ctiles ofrecen las propiedades de los \"clicky\" sin clics ruidosos. La respuesta h\u00e1ptica da seguridad sobre la actuaci\u00f3n del interruptor, adem\u00e1s de proporcionar una agradable sensaci\u00f3n al teclear. La ausencia de ruido tambi\u00e9n favorece la comunicaci\u00f3n durante la partida.Los interruptores Kailh BOX Brown est\u00e1n pensados para los jugadores y cualquier persona que quiera utilizar su teclado para trabajar, as\u00ed como para aquellos que prefieren un teclado con respuesta h\u00e1ptica. Gracias a la baja fuerza operativa de 45 g y a la corta distancia hasta el punto de actuaci\u00f3n (de 1,8 mil\u00edmetros), los interruptores son perfectos tanto para trabajar como para jugar. Gracias al dise\u00f1o de su carcasa, no solo son resistentes al polvo y al agua, sino tambi\u00e9n especialmente duraderos.Todos los interruptores cuentan con tres conectores para una amplia oferta de compatibilidad. Tambi\u00e9n son compatibles con teclas disponibles en el mercado. Se incluyen 35 interruptores por paquete, lo que ofrece una cantidad adecuada para cualquier tama\u00f1o de teclado. Adem\u00e1s, sobrar\u00e1n algunos que se pueden usar como repuestos en caso de que sea necesario.","images":"https:\/\/www.dmi.es\/photo\/1540\/90108\/63597943\/bg\/switch-set-sharkoon-kailh-box-marron.jpg","wholesale_price":"10.54","unit_price_tax":13.810799999999999},"product_model":{"product_data":{"ean13":["4044951033706"],"reference":"CJ12312031","name":{"1":"SWITCH SET SHARKOON KAILH BOX MARRON","2":"","3":"","4":""},"description":{"1":"Los interruptores t\u00e1ctiles ofrecen las propiedades de los \"clicky\" sin clics ruidosos. La respuesta h\u00e1ptica da seguridad sobre la actuaci\u00f3n del interruptor, adem\u00e1s de proporcionar una agradable sensaci\u00f3n al teclear. La ausencia de ruido tambi\u00e9n favorece la comunicaci\u00f3n durante la partida.Los interruptores Kailh BOX Brown est\u00e1n pensados para los jugadores y cualquier persona que quiera utilizar su teclado para trabajar, as\u00ed como para aquellos que prefieren un teclado con respuesta h\u00e1ptica. Gracias a la baja fuerza operativa de 45 g y a la corta distancia hasta el punto de actuaci\u00f3n (de 1,8 mil\u00edmetros), los interruptores son perfectos tanto para trabajar como para jugar. Gracias al dise\u00f1o de su carcasa, no solo son resistentes al polvo y al agua, sino tambi\u00e9n especialmente duraderos.Todos los interruptores cuentan con tres conectores para una amplia oferta de compatibilidad. Tambi\u00e9n son compatibles con teclas disponibles en el mercado. Se incluyen 35 interruptores por paquete, lo que ofrece una cantidad adecuada para cualquier tama\u00f1o de teclado. Adem\u00e1s, sobrar\u00e1n algunos que se pueden usar como repuestos en caso de que sea necesario.","2":"","3":"","4":""},"description_short":{"1":"Tactile Kailh Box BROWN, 35 interruptores (switches) de teclado, 80 millones de pulsaciones, marr\u00f3n","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Sharkoon","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":13.8108,"unit_price_tax":13.8108,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Sharkoon","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1540\/90108\/63597943\/bg\/switch-set-sharkoon-kailh-box-marron.jpg"],"wholesale_price":10.54}}},"4044951033720":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4044951033720",false],"wholesale_price":[8.1,false],"price":[11.322,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186787","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/bc260d642fff0baf9d41fe143e67a967.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ12312033","unit_price":11.322,"category":"Perif\u00e9ricos","brand":"Sharkoon","name_pt":"SWITCH SET SHARKOON GATERON PRO MARRON","quantity":0,"ean13":"4044951033720","description_short_pt":"Tactile Gateron PRO BROWN, 35 interruptores (switches) de teclado, 50 millones de pulsaciones, marr\u00f3n","description_pt":"Los interruptores t\u00e1ctiles ofrecen las propiedades de los \"clicky\" sin clics ruidosos. La respuesta h\u00e1ptica da seguridad sobre la actuaci\u00f3n del interruptor, adem\u00e1s de proporcionar una agradable sensaci\u00f3n al teclear. La ausencia de ruido tambi\u00e9n favorece la comunicaci\u00f3n durante la partida.Los interruptores Gateron PRO Brown lubricados de f\u00e1brica son ideales para usuarios que utilizan teclado en el trabajo o que escriben mucho. Pero tambi\u00e9n son adecuados para los usuarios que buscan un interruptor con retroalimentaci\u00f3n h\u00e1ptica, pero sin clics ruidosos. Con una fuerza operativa de 55 g y una distancia de 2 mil\u00edmetros hasta el punto de actuaci\u00f3n, permiten una agradable sensaci\u00f3n al teclear.Todos los interruptores cuentan con tres conectores para una amplia oferta de compatibilidad. Tambi\u00e9n son COMPATIBLES CON TECLAS DISPONIBLES EN EL MERCADO .Se incluyen 35 interruptores por paquete, lo que ofrece una cantidad adecuada para cualquier tama\u00f1o de teclado. Adem\u00e1s, sobrar\u00e1n algunos que se pueden usar como repuestos en caso de que sea necesario.","images":"https:\/\/www.dmi.es\/photo\/1540\/90110\/63598009\/bg\/switch-set-sharkoon-gateron-pro-marron.jpg","wholesale_price":"8.10","unit_price_tax":11.322},"product_model":{"product_data":{"ean13":["4044951033720"],"reference":"CJ12312033","name":{"1":"SWITCH SET SHARKOON GATERON PRO MARRON","2":"","3":"","4":""},"description":{"1":"Los interruptores t\u00e1ctiles ofrecen las propiedades de los \"clicky\" sin clics ruidosos. La respuesta h\u00e1ptica da seguridad sobre la actuaci\u00f3n del interruptor, adem\u00e1s de proporcionar una agradable sensaci\u00f3n al teclear. La ausencia de ruido tambi\u00e9n favorece la comunicaci\u00f3n durante la partida.Los interruptores Gateron PRO Brown lubricados de f\u00e1brica son ideales para usuarios que utilizan teclado en el trabajo o que escriben mucho. Pero tambi\u00e9n son adecuados para los usuarios que buscan un interruptor con retroalimentaci\u00f3n h\u00e1ptica, pero sin clics ruidosos. Con una fuerza operativa de 55 g y una distancia de 2 mil\u00edmetros hasta el punto de actuaci\u00f3n, permiten una agradable sensaci\u00f3n al teclear.Todos los interruptores cuentan con tres conectores para una amplia oferta de compatibilidad. Tambi\u00e9n son COMPATIBLES CON TECLAS DISPONIBLES EN EL MERCADO .Se incluyen 35 interruptores por paquete, lo que ofrece una cantidad adecuada para cualquier tama\u00f1o de teclado. Adem\u00e1s, sobrar\u00e1n algunos que se pueden usar como repuestos en caso de que sea necesario.","2":"","3":"","4":""},"description_short":{"1":"Tactile Gateron PRO BROWN, 35 interruptores (switches) de teclado, 50 millones de pulsaciones, marr\u00f3n","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Sharkoon","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":11.322,"unit_price_tax":11.322,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Sharkoon","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1540\/90110\/63598009\/bg\/switch-set-sharkoon-gateron-pro-marron.jpg"],"wholesale_price":8.1}}},"4044951033737":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4044951033737",false],"wholesale_price":[7.4,false],"price":[10.608,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186788","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/33f93d3d8dc61f26aff9394f4239b719.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ12312034","unit_price":10.608,"category":"Perif\u00e9ricos","brand":"Sharkoon","name_pt":"SWITCH SET SHARKOON GATERON PRO PLATA","quantity":0,"ean13":"4044951033737","description_short_pt":"Linear Gateron PRO SILVER, 35 interruptores (switches) de teclado, 80 millones de pulsaciones, plata","description_pt":"Los interruptores Gateron PRO Silver lubricados de f\u00e1brica est\u00e1n dirigidos a jugadores profesionales que exigen mucho a sus teclados. Gracias a sus propiedades lineales y a la corta distancia hasta el punto de actuaci\u00f3n, de solo 1,2 mil\u00edmetros, as\u00ed como a una fuerza operativa de 45 g, responder con rapidez no es ning\u00fan problema. Con una vida \u00fatil operativa de 80 millones de pulsaciones por tecla, pueden disfrutarse durante mucho tiempo.","images":"https:\/\/www.dmi.es\/photo\/1540\/90111\/63598293\/bg\/switch-set-sharkoon-gateron-pro-plata.jpg","wholesale_price":"7.40","unit_price_tax":10.608},"product_model":{"product_data":{"ean13":["4044951033737"],"reference":"CJ12312034","name":{"1":"SWITCH SET SHARKOON GATERON PRO PLATA","2":"","3":"","4":""},"description":{"1":"Los interruptores Gateron PRO Silver lubricados de f\u00e1brica est\u00e1n dirigidos a jugadores profesionales que exigen mucho a sus teclados. Gracias a sus propiedades lineales y a la corta distancia hasta el punto de actuaci\u00f3n, de solo 1,2 mil\u00edmetros, as\u00ed como a una fuerza operativa de 45 g, responder con rapidez no es ning\u00fan problema. Con una vida \u00fatil operativa de 80 millones de pulsaciones por tecla, pueden disfrutarse durante mucho tiempo.","2":"","3":"","4":""},"description_short":{"1":"Linear Gateron PRO SILVER, 35 interruptores (switches) de teclado, 80 millones de pulsaciones, plata","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Sharkoon","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":10.608,"unit_price_tax":10.608,"tax_rules_group":null,"categ