ght":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188806","Cat. IDs: 145","Associated Categories","Cat. Default: 145","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/31f6f964164779b103a18f24afab1709.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO02330214","unit_price":71.91,"category":"Limpieza","brand":"Cecotec","name_pt":"CONGA ROCKSTAR MULTICYCLONIC XL ANIMAL PLUS","quantity":0,"ean13":"8435484085861","description_short_pt":"MultiCyclonic, 4 L, 20 kPa, 800 W, 9 m","description_pt":"Limpieza multicicl\u00f3nica sin bolsa.Aspira todo tu hogar de forma r\u00e1pida y eficaz gracias a la tecnolog\u00eda multicicl\u00f3nica que aporta una mayor potencia y durabilidad. Adem\u00e1s, su tanque sin bolsa facilita todav\u00eda m\u00e1s la limpieza.Potencia constante que arrasa.El aspirador cuenta con la tecnolog\u00eda TimeCyclonic Pro, un sistema cicl\u00f3nico de varias etapas simult\u00e1neas que mantiene la potencia de succi\u00f3n para acabar con la suciedad de la forma m\u00e1s eficaz.800 W que pueden con todo.Su gran poder de succi\u00f3n de hasta 20 kPa consigue resultados incre\u00edbles con un consumo de 800 W para limpiar la suciedad m\u00e1s dif\u00edcil sin esfuerzo.Filtrado de aire.Disfruta de una limpieza que te da un respiro gracias a su filtro de aire que retiene gran porcentaje de las part\u00edculas y al\u00e9rgenos. Adem\u00e1s, incluye un filtro extra. lockGran capacidad.Su dep\u00f3sito de 4 L permite limpiar toda tu casa sin que tengas que preocuparte por ir vaciando el dep\u00f3sito.Apto para todas las superficiesDisfruta de una limpieza detallada sobre cualquier superficie gracias a sus diferentes accesorios que permiten limpiar de forma eficaz tapicer\u00edas, esquinas y muebles.Accesorio para mascotasLimpia tu casa en profundidad y deshazte de los pelos de tu mascota.Amplio radio de acci\u00f3n.Disfruta de un radio de acci\u00f3n de hasta 9 metros para llegar a cualquier sitio.","images":"https:\/\/www.dmi.es\/photo\/1234\/104609\/87934006\/bg\/conga-rockstar-multicyclonic-xl-animal-plus.jpg","wholesale_price":"67.50","unit_price_tax":71.91},"product_model":{"product_data":{"ean13":["8435484085861"],"reference":"HO02330214","name":{"1":"CONGA ROCKSTAR MULTICYCLONIC XL ANIMAL PLUS","2":"","3":"","4":""},"description":{"1":"Limpieza multicicl\u00f3nica sin bolsa.Aspira todo tu hogar de forma r\u00e1pida y eficaz gracias a la tecnolog\u00eda multicicl\u00f3nica que aporta una mayor potencia y durabilidad. Adem\u00e1s, su tanque sin bolsa facilita todav\u00eda m\u00e1s la limpieza.Potencia constante que arrasa.El aspirador cuenta con la tecnolog\u00eda TimeCyclonic Pro, un sistema cicl\u00f3nico de varias etapas simult\u00e1neas que mantiene la potencia de succi\u00f3n para acabar con la suciedad de la forma m\u00e1s eficaz.800 W que pueden con todo.Su gran poder de succi\u00f3n de hasta 20 kPa consigue resultados incre\u00edbles con un consumo de 800 W para limpiar la suciedad m\u00e1s dif\u00edcil sin esfuerzo.Filtrado de aire.Disfruta de una limpieza que te da un respiro gracias a su filtro de aire que retiene gran porcentaje de las part\u00edculas y al\u00e9rgenos. Adem\u00e1s, incluye un filtro extra. lockGran capacidad.Su dep\u00f3sito de 4 L permite limpiar toda tu casa sin que tengas que preocuparte por ir vaciando el dep\u00f3sito.Apto para todas las superficiesDisfruta de una limpieza detallada sobre cualquier superficie gracias a sus diferentes accesorios que permiten limpiar de forma eficaz tapicer\u00edas, esquinas y muebles.Accesorio para mascotasLimpia tu casa en profundidad y deshazte de los pelos de tu mascota.Amplio radio de acci\u00f3n.Disfruta de un radio de acci\u00f3n de hasta 9 metros para llegar a cualquier