],"price":[13.821,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189896","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/bebb4503611d7db5278e963a4177204a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA90416259","unit_price":13.821000000000002,"category":"Perif\u00e9ricos","brand":"GENESIS","name_pt":"ALFOMBRILLA GENESIS CARBON 500 MAXI WOWS ARMADA 900X450 MM","quantity":0,"ean13":"5901969431070","description_short_pt":"900x450x2.5mm, Fabric, Rubber, Multicolor","description_pt":"SERIE \u00daNICACada alfombrilla viene con un c\u00f3digo de invitaci\u00f3n \u00fanico que se puede usar para una cuenta nueva o un c\u00f3digo de bonificaci\u00f3n para usar con una cuenta existente. Ambos c\u00f3digos ofrecen bonificaciones atractivas para los jugadores de World of Warships. \u00a1Apuesta por la singularidad y gana con estilo!SUPERFICIE SPEEDLa alfombrilla est\u00e1 cubierta con una superficie lisa de \"velocidad\", lo que garantiza un deslizamiento extremadamente suave y uniforme y una reacci\u00f3n inmediata del mouse. Gracias a esto, la alfombrilla acelerar\u00e1 los movimientos planificados y garantizar\u00e1 una alta precisi\u00f3n. La serie Carbon 500 World of Warships es compatible con todo tipo de ratones.PARTE INFERIOR ANTIDESLIZANTELa parte inferior de la alfombrilla est\u00e1 hecha de goma antideslizante de alta calidad. Esto asegura que el Carbon 500 WOWS ser\u00e1 estable en cualquier terreno y permanecer\u00e1 en su lugar incluso durante los movimientos m\u00e1s vigorosos.BORDES COSIDOSLos bordes de la alfombrilla se han protegido adicionalmente con un dobladillo de alta calidad para proteger contra el deshilachado. Los bordes cosidos aumentan significativamente la longevidad y mantendr\u00e1n la alfombrilla en perfectas condiciones durante muchos a\u00f1os.RESISTENTE A LA HUMEDADLa alfombrilla ha sido completamente impregnada, gracias a lo cual no absorbe la humedad y garantiza la resistencia al agua. \u00a1Pon tu bebida favorita en el escritorio y disfruta de un juego emocionante!","images":"https:\/\/www.dmi.es\/photo\/204\/86650\/58173124\/bg\/alfombrilla-genesis-carbon-500-maxi-wows-armada-900x450-mm.jpg","wholesale_price":"10.55","unit_price_tax":13.821000000000002},"product_model":{"product_data":{"ean13":["5901969431070"],"reference":"GA90416259","name":{"1":"ALFOMBRILLA GENESIS CARBON 500 MAXI WOWS ARMADA 900X450 MM","2":"","3":"","4":""},"description":{"1":"SERIE \u00daNICACada alfombrilla viene con un c\u00f3digo de invitaci\u00f3n \u00fanico que se puede usar para una cuenta nueva o un c\u00f3digo de bonificaci\u00f3n para usar con una cuenta existente. Ambos c\u00f3digos ofrecen bonificaciones atractivas para los jugadores de World of Warships. \u00a1Apuesta por la singularidad y gana con estilo!SUPERFICIE SPEEDLa alfombrilla est\u00e1 cubierta con una superficie lisa de \"velocidad\", lo que garantiza un deslizamiento extremadamente suave y uniforme y una reacci\u00f3n inmediata del mouse. Gracias a esto, la alfombrilla acelerar\u00e1 los movimientos planificados y garantizar\u00e1 una alta precisi\u00f3n. La serie Carbon 500 World of Warships es compatible con todo tipo de ratones.PARTE INFERIOR ANTIDESLIZANTELa parte inferior de la alfombrilla est\u00e1 hecha de goma antideslizante de alta calidad. Esto asegura que el Carbon 500 WOWS ser\u00e1 estable en cualquier terreno y permanecer\u00e1 en su lugar incluso durante los movimientos m\u00e1s vigorosos.BORDES COSIDOSLos bordes de la alfombrilla se han protegido adicionalmente con un dobladillo de alta calidad para proteger contra el deshilachado. Los bordes cosidos aumentan significativamente la longevidad y mantendr\u00e1n la alfombrilla en perfectas condiciones durante muchos a\u00f1os.RESISTENTE A LA HUMEDADLa alfombrilla ha sido completamente impregnada, gracias a lo cual no absorbe la humedad y garantiza la resistencia al agua. \u00a1Pon tu bebida favorita en el escritorio y disfruta de un juego emocionante!","2":"","3":"","4":""},"description_short":{"1":"900x450x2.5mm, Fabric, Rubber, Multicolor","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GENESIS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":13.821,"unit_price_tax":13.821,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"GENESIS","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/204\/86650\/58173124\/bg\/alfombrilla-genesis-carbon-500-maxi-wows-armada-900x450-mm.jpg"],"wholesale_price":10.55}}},"4039621922442":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4039621922442",false],"wholesale_price":[23.61,false],"price":[27.1422,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189897","Cat. IDs: 7","Associated Categories","Cat. Default: 7","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d4e4c9d4e9fa29f9325adc7273dd7d1f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA10538206","unit_price":27.1422,"category":"Videojuegos, Consolas y Accesorios","brand":"Snakebyte","name_pt":"GAMEPAD SNAKEBYTE BASE X PAR