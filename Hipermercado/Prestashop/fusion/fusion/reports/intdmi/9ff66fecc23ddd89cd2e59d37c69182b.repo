es":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186762","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/618050c580757d63397053bac45c8d9e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"LB12165247","unit_price":19.737000000000002,"category":"Adaptadores bah\u00eda","brand":"Salicru","name_pt":"SAI SALICRU SPS.8F.PDU SCH\/SCH","quantity":0,"ean13":"8436035929320","description_short_pt":"Regleta Salicru SPS PDU - Unidad de distribuci\u00f3n de energ\u00eda con 8 tomas tipo schuko","description_pt":"Las Unidades de Distribuci\u00f3n de Energ\u00eda (SPS PDU) de Salicru est\u00e1n dise\u00f1adas para distribuir energ\u00eda proviniente de un SAI (Sistema de Alimentaci\u00f3n Ininterrumpida), un generador o la red a m\u00faltiples dispositivos, tales como racks de redes y servidores en data centers y salas de ordenadores. Los modelos SPS PDU incorporan un interruptor de encendido\/apagado con iluminaci\u00f3n y tapa de protecci\u00f3n para evitar acciones no deseadas. Las tipos de bases de toma disponibles son schuko, IEC, UK y combinaciones entre ellas. La carcasa es de aluminio, lo que confiere robustez y, a la vez, ligereza en peso. El sistema multiposici\u00f3n permite la instalaci\u00f3n de los soportes de fijaci\u00f3n en m\u00faltiples combinaciones, tanto en profundidad (6 posiciones) como en inclinaci\u00f3n (5 posiciones). Toda la gama es en formato 1U de 19' y las opciones de instalaci\u00f3n horizontal o vertical en el bastidor\/rack.","images":"https:\/\/www.dmi.es\/photo\/1532\/83565\/52055324\/bg\/sai-salicru-sps-8f-pdu-sch-sch.jpg","wholesale_price":"16.35","unit_price_tax":19.737000000000002},"product_model":{"product_data":{"ean13":["8436035929320"],"reference":"LB12165247","name":{"1":"SAI SALICRU SPS.8F.PDU SCH\/SCH","2":"",