:""},"description_short":{"1":"2.4\" (240x320), DualSim, 2MP Camera, Bluetooth 3.0, Li-Ion 800 mAh, MicroSD, 126g","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Doro","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":31.7424,"unit_price_tax":31.7424,"tax_rules_group":null,"category":"Telefon\u00eda","brand":"Doro","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/119\/29686\/26120274\/bg\/telefono-movil-doro-1361-rojo.jpg"],"wholesale_price":28.12}}},"3700601419542":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["3700601419542",false],"wholesale_price":[21.22,false],"price":[24.7044,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185127","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/01949f2c7163fd2d63e3ce48b7b3a136.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"TF20324211","unit_price":24.7044,"category":"Telefon\u00eda","brand":"SwissVoice","name_pt":"TELEFONO MOVIL SWISSVOICE S24 2G EU BLACK WITH HEADSET 5 LANGUAGES CG2","quantity":5,"ean13":"3700601419542","description_short_pt":"2.4\" (240 x 320), Tecla SOS, 0.3 MP, 2G (GSM), Nano SIM, MicroSD, Micro-USB, 3.5 mm, 800 mAh (Li-Ion)","description_pt":"S24 el tel\u00e9fono plegable f\u00e1cil de usar para m\u00e1s serenidad.S24 est\u00e1 equipado con una pantalla color de 2,4 pulgadas y con un indicador luminoso externo para visualizar las llamadas entrantes, el nivel de bater\u00eda y la llegada de nuevos mensajes. Referente al sonido, el S24 dispone de timbres fuertes para que no se pierda ninguna llamada. 3 funciones exclusivas de Swissvoice : el timbre m\u00e1s fuerte en caso de segunda llamada inmediata de la misma persona, el env\u00edo de un SMS a los contactos elegidos previamente en caso de bater\u00eda baja o de varias llamadas p\u00e9rdidas y el env\u00edo de un SMS a los contactos elegidos en caso de ausencia de actividad del m\u00f3vil. Y para una mayor seguridad, la tecla SOS permite avisar por SMS y por llamadas vocales hasta 5 personas.S24 est\u00e1 disponible en negro o en blanco.Indicador luminoso externoPara avisar de una llamada entrante, del nivel de la bater\u00eda o de un mensaje en espera en una sola mirada.Soporte de carga f\u00e1cil\u00a1S\u00f3lo hace falta colocar el tel\u00e9fono en la base!Exclusividad SwissvoiceEnv\u00edo de un SMS a sus contactos preferidos en caso de bater\u00eda baja o de varias llamadas p\u00e9rdidasTecla SOS\u00a1Avisar de una sola pulsaci\u00f3n a sus contactos en caso de emergencia!","images":"https:\/\/www.dmi.es\/photo\/119\/82124\/53180551\/bg\/telefono-movil-swissvoice-s24-2g-eu-black-with-headset-5-languages-cg2.jpg","wholesale_price":"21.22","unit_price_tax":24.7044},"product_model":{"product_data":{"ean13":["3700601419542"],"reference":"TF20324211","name":{"1":"TELEFONO MOVIL SWISSVOICE S24 2G EU BLACK WITH HEADSET 5 LANGUAGES CG2","2":"","3":"","4":""},"description":{"1":"S24 el tel\u00e9fono plegable f\u00e1cil de usar para m\u00e1s serenidad.S24 est\u00e1 equipado con una pantalla color de 2,4 pulgadas y con un indicador luminoso externo para visualizar las llamadas entrantes, el nivel de bater\u00eda y la llegada de nuevos mensajes. Referente al sonido, el S24 dispone de timbres fuertes para que no se pierda ninguna llamada. 3 funciones exclusivas de Swissvoice : el timbre m\u00e1s fuerte en caso de segunda llamada inmediata de la mi