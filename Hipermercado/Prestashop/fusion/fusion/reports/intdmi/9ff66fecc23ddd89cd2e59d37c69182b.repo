enesis-argon-100-rojos.jpg","wholesale_price":"4.51","unit_price_tax":7.6602},"product_model":{"product_data":{"ean13":["5901969420104"],"reference":"GA02416269","name":{"1":"AURICULARES GAMING GENESIS ARGON 100 ROJOS","2":"","3":"","4":""},"description":{"1":"GENESIS ARGON 100. Tipo de producto: Auriculares. Tecnolog\u00eda de conectividad: Al\u00e1mbrico. Uso recomendado: Juego. Frecuencia de auricular: 20 - 20000 Hz. Longitud de cable: 1,8 m, Color del producto: Negro, Rojo","2":"","3":"","4":""},"description_short":{"1":"GENESIS ARGON 100, Al\u00e1mbrico, Juego, 20 - 20000 Hz, Auriculares, Negro, Rojo","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GENESIS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":7.6602,"unit_price_tax":7.6602,"tax_rules_group":null,"category":"Auriculares","brand":"GENESIS","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/1637\/77179\/38060649\/bg\/auriculares-gaming-genesis-argon-100-rojos.jpg"],"wholesale_price":4.51}}},"5901969420142":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5901969420142",false],"wholesale_price":[4.75,false],"price":[7.905,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188749","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c81835b5174e07fed7b53b6baf12894e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA02416270","unit_price":7.904999999999999,"category":"Auriculares","brand":"GENESIS","name_pt":"AURICULARES GAMING GENESIS ARGON 110","quantity":5,"ean13":"5901969420142","description_short_pt":"20 - 20000 Hz, 108 dB, 32 Ohm, 2 x Mini Jack, 1.8 m, 261 g","description_pt":"AURICULARES PARA JUGADORESGenesis Argon 110 son auriculares con sistema de sonido est\u00e9reo 2.0 dise\u00f1ados para jugadores y m\u00e1s. Materiales ligeros pero duraderos, cable trenzado de gran longitud, micr\u00f3fono, gran calidad de sonido, son las principales ventajas de los Argon 110.STEREO 2.0Los auriculares con altavoces de 40 mm proporcionan una intensidad del sonido de 108 dB y un sistema de audio est\u00e9reo, que asegura una fant\u00e1stica profundidad de campo y un mayor realismo en la reproducci\u00f3n del audio. Los auriculares son ideales para cualquier tipo de sonido, ya sea un juego o una pel\u00edcula.COMODIDAD Y DURABILIDADLa construcci\u00f3n del Argon 110 tiene como base una diadema flexible pero duradera y unas grandes y c\u00f3modas almohadillas revestidas de un tejido resistente al sobrecalentamiento y al sudor de las orejas. Los materiales utilizados son de alta calidad y los auriculares est\u00e1n acabados con atenci\u00f3n en los detalles. El cable de los auriculares tiene la longitud id\u00f3nea y es especialmente duradero gracias al trenzado textil. Adem\u00e1s, dispone de un control de volumen incorporado en el cable.","images":"https:\/\/www.dmi.es\/photo\/1637\/77180\/46450268\/bg\/auriculares-gaming-genesis-argon-110.jpg","wholesale_price":"4.75","unit_price_tax":7.904999999999999},"product_model":{"product_data":{"ean13":["5901969420142"],"reference":"GA02416270","name":{"1":"AURICULARES GAMING GENESIS ARGON 110","2":"","3":"","4":""},"description":{"1":"AURICULARES PARA JUGADORESGenesis Argon 110 son auriculares con sistema de sonido est\u00e9reo 2.0 dise\u00f1ados para jugadores y m\u00e1s. Materiales ligeros pero duraderos, cable trenzado de gran longitud, micr\u00f3fono, gran calidad de sonido, son las principales ventajas de los Argon 110.STEREO 2.0Los auriculares con altavoces de 40 mm proporcionan una intensidad del sonido de 108 dB y un sistema de audio est\u00e9reo, que asegura una fant\u00e1stica profundidad de campo y un mayor realismo en la reproducci\u00f3n del audio. Los auriculares son ideales para cualquier tipo de sonido, ya sea un juego o una pel\u00edcula.COMODIDAD Y DURABILIDADLa construcci\u00f3n del Argon 110 tiene como base una diadema flexible pero duradera y unas grandes y c\u00f3modas almohadillas revestidas de un tejido resistente al sobrecalentamiento y al sudor de las orejas. Los materiales utilizados son de alta calidad y los auriculares est\u00e1n acabados con atenci\u00f3n en los detalles. El cable de los auriculares tiene la longitud id\u00f3nea y es especialmente duradero gracias al trenzado textil. Adem\u00e1s, dispone de un control de volumen incorporado en el cable.","2":"","3":"","4":""},"description_short":{"1":"20 - 20000 Hz, 108 dB, 32 Ohm, 2 x Mini Jack, 1.8 m, 261 g","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"GENESIS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":7.905,"unit_price_tax":7.905,"tax_rules_group":null,"category":"Auriculares","brand":"GENESIS","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/1637\/77180\/46450268\/bg\/auriculares-gaming-genesis-argon-110.jpg"],"wholesale_price":4.75}}},"0194252707739":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0194252707739",false],"wholesale_price":[503.25,false],"price":[516.375,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Produ