:[35.3,false],"price":[39.066,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185907","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cd5f6dd431646676afcd37bf414914a2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"AC18131000","unit_price":39.065999999999995,"category":"Accesorios port\u00e1tiles","brand":"Targus","name_pt":"MOCHILA TARGUS ATMOSPHERE 18\" NEGRO","quantity":5,"ean13":"5024442954801","description_short_pt":"XL Laptop Backpack","description_pt":"Targus XL Laptop Backpack es perfecta para el usuario de poratil que necesita transportar gran cantidad de articulos. Dispone de un gran compartimento acolchado individual con capacidad para un portatil con pantalla de hasta 18.4 pulgadas. Esta mochila proporciona un amplio espacio para portatiles con pantalla de hasta 18.4 pulgadas e incluye tambien un compartimiento para documentos y muchas otras areas de almacenamiento. En la estacion de trabajo frontal estan integrados un bolsillo para PDA\/movil y un portatarjetas de visita. Cuenta con una funda impermeable integrada que se puede guardar en un bolsillo oculto, para proteger el portatil cuando llueve. Su asa anatomica, correa de cintura, acolchado lumbar adicional y robustos enganches de niquel le proporcionaran la maxima proteccion al transportar su portatil de pantalla grande y le permitiran llegar descansado a su destino.- Compartimento acolchado para el portatil - Para portatiles con pantalla de hasta 18 pulgadas- Estaci\u00f3n de trabajo para accesorios ? Dise\u00f1ada para transportar los elementos esenciales para el trabajo diario: PDA\/m