03910\/81782609\/bg\/ssd-msi-spatium-m480-pro-2tb-pcie4-nvme-m2.jpg","wholesale_price":"121.42","unit_price_tax":126.9084},"product_model":{"product_data":{"ean13":["4711377105613"],"reference":"HD34271119","name":{"1":"SSD MSI SPATIUM M480 PRO 2TB PCIE4 NVME M2","2":"","3":"","4":""},"description":{"1":"MSI SPATIUM M480 PRO PCIE 4.0 NVME M.2 2TB. SDD, capacidad: 2 TB, Factor de forma de disco SSD: M.2, Velocidad de lectura: 7400 MB\/s, Velocidad de escritura: 7000 MB\/s, Componente para: PC\/ordenador port\u00e1til","2":"","3":"","4":""},"description_short":{"1":"MSI SPATIUM M480 PRO PCIE 4.0 NVME M.2 2TB, 2 TB, M.2, 7400 MB\/s","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MSI","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":126.9084,"unit_price_tax":126.9084,"tax_rules_group":null,"category":"Discos duros internos","brand":"MSI","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1563\/103910\/81782609\/bg\/ssd-msi-spatium-m480-pro-2tb-pcie4-nvme-m2.jpg"],"wholesale_price":121.42}}},"4713213519134":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4713213519134",false],"wholesale_price":[1085.55,false],"price":[1110.321,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189120","Cat. IDs: 193","Associated Categories","Cat. Default: 193","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e60106d452c12562af5988f578b346e2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CN11390571","unit_price":1110.321,"category":"Switches y Transceptores","brand":"QNAP","name_pt":"SWITCH QNAP QSW-M5216-1T L2 10G ETHERNET","quantity":0,"ean13":"4713213519134","description_short_pt":"16x 25GbE SFP28, 1x 10GbE RJ45, Web Managed, 100-240VAC, 50\/60 Hz, 43.5 x 285 x 237.7 mm, 2.15 kg","description_pt":"El QSW-M5216-1T es un Switch gestionado de fibra SFP28 de 16 puertos y 25 GbE con un puerto NBASE-T de 10 GbE. Admite la conmutaci\u00f3n de Capa 2 y la gesti\u00f3n de la red a trav\u00e9s de una interfaz de usuario web f\u00e1cil de usar. El QSW-M5216-1T proporciona una soluci\u00f3n de gesti\u00f3n de red de nivel b\u00e1sico que pueden utilizar incluso profesionales que no se dediquen al sector de las TI. Al ofrecer velocidades incre\u00edblemente altas de 25 GbE y una capacidad de conmutaci\u00f3n de red troncal de 820 Gbps, el QSW-M5216-1T puede servir como conmutador central para vincular a servidores 25G y NAS en salas de servidores o conectarse a conmutadores 25G\/10G para acelerar el almacenamiento de alta velocidad, la edici\u00f3n de v\u00eddeo, virtualizaci\u00f3n y aplicaciones de inteligencia artificial. El QSW-M5216-1T proporciona interfaces de red flexibles para una alta compatibilidad a un precio asequible, lo que permite a las peque\u00f1as empresas actualizarse r\u00e1pidamente a una red troncal de incre\u00edblemente alta velocidad al integrar a la infraestructura de red existente.\u00a1Actualice f\u00e1cilmente a la conectividad 25GbE de ultra-alta velocidad!Aunque la conectividad 10GbE constituye una base s\u00f3lida para la transmisi\u00f3n de red de alta velocidad, la conectividad 25GbE de ultra-alta velocidad ofrece unas ventajas de coste comparativas y compatibilidad con salas de servidores de Pymes para responder a las necesidades de las aplicaciones de computaci\u00f3n de datos.Alta capacidad de conmutaci\u00f3n de 820Gbps para redes b\u00e1sicasEl QSW-M5216-1T cuenta con diecis\u00e9is puertos de fibra SFP28 25GbE y ofrece una capacidad de conmutaci\u00f3n b\u00e1sica de 820Gbps, lo que garantiza el m\u00e1ximo potencial de cada puerto. El QSW-M5216-1T puede servir de switch b\u00e1sico para conectar con servidores 25G\/100G y NAS en salas de servidores o para conectar con vanguardistas switches de fibra 25G\/10G.Implementaci\u00f3n flexible con m\u00faltiples puertos 25GbE y 10GbEAdem\u00e1s de diecis\u00e9is puertos de fibra SFP28 25GbE, el QSW-M5216-1T tiene un puerto 10GBASE-T para permitir redes h\u00edbridas de alta velocidad. Sus interfaces SFP28 25GbE son retrocompatibles con SFP+ 10GbE \/ SFP 1GbE, y la interfaz RJ45 10GbE es compatible con tecnolog\u00edas NBASE-T para admitir cinco velocidades (10G \/ 5G \/ 2,5G \/ 1G \/ 100M).Sincronice con un NAS y una tarjeta de expansi\u00f3n de red 100GbE para operaciones inform\u00e1ticas de baja latencia y alto rendimientoUtilizando cables QSFP28 para (4) SFP28, podr\u00e1 conectar f\u00e1cilmente los cuatro puertos de 25GbE del QSW-M5216-1T con un NAS que tenga una tarjeta de expansi\u00f3n de red 100GbE de dos puertos QXG-100G2SF-E810. Tambi\u00e9n puede usar dos cables QSFP28 para (4) SFP28 para conectar el puerto de 100GbE del modelo QXG-100G2SF-E810 a los cuatro puertos de 25GbE del switch. Establezca un grupo de conexiones QSFP28 para (4) SFP28 como la ruta principal y el otro como ruta de respaldo.QSS: Software de administraci\u00f3n de red intuitivoEl QNAP Switch System (QSS) incluye una GUI web f\u00e1cil de usar con funciones de valor a\u00f1adido para simplificar la configuraci\u00f3n y la administraci\u00f3n de la red.QSS: Gu\u00eda de configuraci\u00f3n centrada en las personasQSS ofrece un panel general, un sistema de administraci\u00f3n de puertos y una gu\u00eda de configuraci\u00f3n para ayudar a controlar las redes de Capa 2.Optimice el rendimiento de la red con control de paquetes y ancho de bandaEl QSW-M5216-1T ofrece funciones de control de paquetes y ancho de banda (como LACP, VLAN, QoS e IGMP Snooping) para mejorar el rendimiento de red a trav\u00e9s de la agrupaci\u00f3n de IP y la gesti\u00f3n del ancho de banda.Funciones avanzadas de seguridad y sistemaEl QSW-M5216-1T cuenta con funciones avanzadas de seguridad y sistema (que incluyen ACL, LLDP, RSTP y control de flujo) para mejorar la fiabilidad de la red gracias a los controles de acceso, la resoluci\u00f3n de problemas, la prevenci\u00f3n de bucles y el evitar la p\u00e9rdida de paquetes.Con un funcionamiento casi silencioso y que ahorra energ\u00edaGracias a su sistema de refrigeraci\u00f3n inteligente, el QSW-M5216-1T garantiza un rendimiento de red de alta velocidad sin generar un ruido de fondo que distraiga. La compatibilidad con IEEE 802.3az (EEE) tambi\u00e9n reduce el consumo de energ\u00eda sin sacrificar el rendimiento o la funcionalidad. Al detectar y ajustar din\u00e1micamente las actividades y velocidades de conexi\u00f3n, el QSW-M5216-1T ofrece un ahorro de energ\u00eda de hasta el 50 % para minimizar los costes operativos.","images":"https:\/\/www.dmi.es\/photo\/258\/94236\/63140256\/bg\/switch-qnap-qsw-m5216-1t-l2-10g-ethernet.jpg","wholesale_price":"1085.55","unit_price_tax":1110.321},"product_model":{"product_data":{"ean13":["4713213519134"],"reference":"CN11390571","name":{"1":"SWITCH QNAP QSW-M5216-1T L2 10G ETHERNET","2":"","3":"","4":""},"description":{"1":"El QSW-M5216-1T es un Switch gestionado de fibra SFP28 de 16 puertos y 25 GbE con un puerto NBASE-T de 10 GbE. Admite la conmutaci\u00f3n de Capa 2 y la gesti\u00f3n de la red a trav\u00e9s de una interfaz de usuario web f\u00e1cil de usar. El QSW-M5216-1T proporciona una soluci\u00f3n de gesti\u00f3n de red de nivel b\u00e1sico que pueden utilizar incluso profesionales que no se dediquen al sector de las TI. Al ofrecer velocidades incre\u00edblemente altas de 25 GbE y una capacidad de conmutaci\u00f3n de red troncal de 820 Gbps, el QSW-M5216-1T puede servir como conmutador central para vincular a servidores 25G y NAS en sal