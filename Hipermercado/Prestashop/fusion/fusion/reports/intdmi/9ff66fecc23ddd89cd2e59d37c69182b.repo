arga en la p\u00e1gina web de Soporte de WD, permite copiar todos los datos en un nuevo disco para que no sea necesario reinstalar el sistema operativo para tener todas las ventajas de un nuevo disco.Uso recomendadoLos discos duros WD Blue est\u00e1n probados y recomendados para su uso en ordenadores personales todo en uno, aplicaciones industriales, ordenadores port\u00e1tiles, netbooks y gabinetes externos donde no se necesite capacidad. Si necesita capacidad adicional, mire los discos de almacenamiento WD Green.","2":"","3":"","4":""},"description_short":{"1":"1TB, 3.5\", SATA 6Gb\/s, 7200 RPM, 64MB","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Western Digital","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":50.3268,"unit_price_tax":50.3268,"tax_rules_group":null,"category":"Discos duros internos","brand":"Western Digital","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/219\/2927\/22900959\/bg\/disco-wd-blue-1tb-sata3-64mb.jpg"],"wholesale_price":46.34}}},"8436035923243":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436035923243",false],"wholesale_price":[309.38,false],"price":[318.6276,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189599","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5bf685307fe66b3a8fe976fd29103225.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"LB12165151","unit_price":318.6276,"category":"Electricidad","brand":"Salicru","name_pt":"SAI SALICRU SPS 1100 ADV RT2","quantity":0,"ean13":"8436035923243","description_short_pt":"Salicru SPS 1100 ADVANCE RT2 ? Sistema de Alimentaci\u00f3n Ininterrumpida (SAI\/UPS) de 1100 VA Line-interactive senoidal formato torre\/rack","description_pt":"La serie SPS ADVANCE RT2 de Salicru es una gama de SAIs de tecnolog\u00eda Line-interactive con tensi\u00f3n de salida senoidal y formato convertible torre\/rack, siendo la altura de solo 2U para todas las potencias. Asimismo, el factor de potencia de salida 0,9 y la compatibilidad con cargas del tipo APFC (Active Power Factor Correction) lo convierten en la mejor opci\u00f3n para cualquier tipo de carga a proteger. En cuanto a las comunicaciones, dispone de interface RS-232\/USB (compatible con protocolo HID) y de un slot inteligente que puede alojar, opcionalmente, una tarjeta SNMP, MODBUS o contactos libres de potencial, tambi\u00e9n est\u00e1n disponibles paquetes de software para la monitorizaci\u00f3n y gesti\u00f3n, local o virtual, de los equipos protegidos. Y como otras caracter\u00edsticas destacables podemos citar: soluciones para aplicaciones con larga autonom\u00eda (mediante equipos con cargadores extra y m\u00f3dulos de bater\u00edas adicionales), pantalla orientable y adaptadores (pedestal y orejas) para colocaci\u00f3n en formato torre o rack, salidas programables (cargas cr\u00edticas\/cargas no-cr\u00edticas) para alargar la autonom\u00eda disponible,... La gama de potencias para la serie SPS ADVANCE RT2 es: 800, 1.100, 1500, 2.000 y 3.000 VA.","images":"https:\/\/www.dmi.es\/photo\/817\/30968\/52055467\/bg\/sai-salicru-sps-1100-adv-rt2.jpg","wholesale_price":"309.38","unit_price_tax":318.6276},"product_model":{"product_data":{"ean13":["8436035923243"],"reference":"LB12165151","name":{"1":"SAI SALICRU SPS 1100 ADV RT2","2":"","3":"","4":""},"description":{"1":"La serie SPS ADVANCE RT2 de Salicru es una gama de SAIs de tecnolog\u00eda Line-interactive con tensi\u00f3n de salida senoidal y formato convertible torre\/rack, siendo la altura de solo 2U para todas las potencias. Asimismo, el factor de potencia de salida 0,9 y la compatibilidad con cargas del tipo APFC (Active Power Factor Correction) lo convierten en la mejor opci\u00f3n para cualquier tipo de carga a proteger. En cuanto a las comunicaciones, dispone de interface RS-232\/USB (compatible con protocolo HID) y de un slot inteligente que puede alojar, opcionalmente, una tarjeta SNMP, MODBUS o contactos libres de potencial, tambi\u00e9n est\u00e1n disponibles paquetes de software para la monitorizaci\u00f3n y gesti\u00f3n, local o virtual, de los equipos protegidos. Y como otras caracter\u00edsticas destacables podemos citar: soluciones para aplicaciones con larga autonom\u00eda (mediante equipos con cargadores extra y m\u00f3dulos de bater\u00edas adicionales), pantalla orientable y adaptadores (pedestal y orejas) para colocaci\u00f3n en formato torre o rack, salidas programables (cargas cr\u00edticas\/cargas no-cr\u00edticas) para alargar la autonom\u00eda disponible,... La gama de potencias para la serie SPS ADVANCE RT2 es: 800, 1.100, 1500, 2.000 y 3.000 VA.","2":"","3":"","4":""},"description_short":{"1":"Salicru SPS 1100 ADVANCE RT2 ? Sistema de Alimentaci\u00f3n Ininterrumpida (SAI\/UPS) de 1100 VA Line-interactive senoidal formato torre\/rack","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Salicru","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":318.6276,"unit_price_tax":318.6276,"tax_rules_group":null,"category":"Electricidad","brand":"Salicru","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/817\/30968\/52055467\/bg\/sai-salicru-sps-1100-adv-rt2.jpg"],"wholesale_price":309.38}}},"