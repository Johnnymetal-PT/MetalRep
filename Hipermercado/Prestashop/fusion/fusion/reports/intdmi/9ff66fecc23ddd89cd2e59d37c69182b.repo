55e27c09e87d480a740.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"OP1232595","unit_price":7.5786,"category":"Perif\u00e9ricos","brand":"Gembird","name_pt":"RATON GAMING GEMBIRD USB NEGRO\/ROJO","quantity":5,"ean13":"8716309081900","description_short_pt":"Rat\u00f3n GAMING, verde","description_pt":"6 botones 2400 DPI rat\u00f3n para juegosBot\u00f3n Quick DPI (600-2400 dpi)Rueda de desplazamiento, logo y el lado acentos todos iluminadosDise\u00f1o confortable y ergon\u00f3micoCaucho revestido superior para un mayor agarre y controlCable de malla de nylon = libre de enredos","images":"https:\/\/www.dmi.es\/photo\/195\/19092\/15519545\/bg\/raton-gaming-gembird-usb-negro-rojo.jpg","wholesale_price":"4.43","unit_price_tax":7.5786},"product_model":{"product_data":{"ean13":["8716309081900"],"reference":"OP1232595","name":{"1":"RATON GAMING GEMBIRD USB NEGRO\/ROJO","2":"","3":"","4":""},"description":{"1":"6 botones 2400 DPI rat\u00f3n para juegosBot\u00f3n Quick DPI (600-2400 dpi)Rueda de desplazamiento, logo y el lado acentos todos iluminadosDise\u00f1o confortable y ergon\u00f3micoCaucho revestido superior para un mayor agarre y controlCable de malla de nylon = libre de enredos","2":"","3":"","4":""},"description_short":{"1":"Rat\u00f3n GAMING, verde","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Gembird","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":7.5786,"unit_price_tax":7.5786,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Gembird","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/195\/19092\/15519545\/bg\/raton-gaming-gembird-usb-negro-rojo.jpg"],"wholesale_price":4.43}}},"8436588882219":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436588882219",false],"wholesale_price":[48.34,false],"price":[52.3668,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185314","Cat. IDs: 76","Associated Categories","Cat. Default: 76","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c70b82d1c20cb7a81acceeef98bb76f9.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"WE01230337","unit_price":52.366800000000005,"category":"Relojes Inteligentes","brand":"Leotec","name_pt":"LEOTEC SMARTWATCH KIDS ALLO PLUS 4G GPS ANTI-PERDIDA NEGRO","quantity":0,"ean13":"8436588882219","description_short_pt":"LEOTEC KIDS ALLO GPS ANTIP\u00c9RDIDA PLUS 4G","description_pt":"Dispositivo inteligente con GPS real y llamadas para ni\u00f1osOs presentamos el que va a ser vuestro pr\u00f3ximo regalo, el nuevo dispositivo inteligente dise\u00f1ado utilizando la tecnolog\u00eda m\u00e1s avanzada del mundo para que siempre puedas estar comunicado all\u00e1 donde vayas y tus padres sepan en cada momento d\u00f3nde te encuentras y as\u00ed no tener que estar envi\u00e1ndoles mensajes de WhatsApp cada dos por tres o tener que cargar el tel\u00e9fono en la mochila para llamarlos.El nuevo Kids Allo GPS Plus 4G cuenta con una estructura de materiales ligeros y resistentes que te permitir\u00e1 llevarlo todo el d\u00eda sin que te moleste o notes que lo tienes en la mu\u00f1eca.Incorpora una correa hipoalerg\u00e9nica ajustable por medio de hebilla met\u00e1lica y reemplazable por cualquier otra de ancho equivalente, resistente y duradera.La caja del reloj la conforma un extraordinario panel de 1.4 pulgadas de diagonal a todo color, IPS Full-Touch de alta resoluci\u00f3n con una densidad de 240 x 240 p\u00edxeles que te permitir\u00e1 visualizar im\u00e1genes mucho m\u00e1s n\u00edtidas, brillantes y desde cualquier \u00e1ngulo ya sea en espacios interiores con luz artificial como a plena luz del d\u00eda en exteriores. Un panel de gran calidad con aristas curvadas y acabado 2.5D.Captura tus mejores recuerdos por medio de su c\u00e1mara frontal integrada y comp\u00e1rtelos con quien quieras o bien env\u00edalos al tel\u00e9fono vinculado para almacenarlos en el tiempo. Utiliza su c\u00e1mara frontal tambi\u00e9n para realizar y recibir videollamadas de gran calidad.En su interior, el nuevo Kids Allo GPS Plus 4G de Leotec cuenta con un potente procesador capaz de mover de forma fluida todas las aplicaciones que lleva instaladas, proporcionando una experiencia \u00fanica y sencilla para que el ni\u00f1o siempre sepa a qu\u00e9 corresponde cada icono.Le hemos puesto en su interior un peque\u00f1o chip GPS real con aGPS que permite de forma r\u00e1pida y eficiente obtener la localizaci\u00f3n casi exacta del ni\u00f1o que lo lleva puesto. As\u00ed mismo y como ayuda, cuenta tambi\u00e9n con WiFi y LBS para situaciones en las que pueda encontrarse en espacios interiores donde no alcance la se\u00f1al satelital.Los padres disponen de una aplicaci\u00f3n recomendada gratuita que se pueden descargar directamente desde la tienda de aplicaciones de Google o bien desde la de Apple por medio de la cual, una vez emparejado el reloj del ni\u00f1o, tienen acceso a:- conocer su posici\u00f3n por medio de un mapa visual a color- establecer vallas virtuales que delimiten el espacio por el que se mueve habitualmente y les avise en caso que salga del mismo- establecer una comunicaci\u00f3n v\u00eda chat o chat de voz con el ni\u00f1o por medio del reloj- realizar y recibir videollamadas- configurar alertas y much\u00edsimas otras opciones que les ser\u00e1n de gran utilidad.Este reloj cuenta con tecnolog\u00eda 4G-LTE y es compatible con todas las operadoras m\u00f3viles espa\u00f1olas, simplemente tienes que introducir la tarjeta nanoSIM (con el PIN desactivado previamente) para poder realizar y recibir llamadas (a n\u00fameros per-establecidos\/autorizados y en la agenda de contactos), SMS, realizar videollamadas con la m\u00e1xima calidad de imagen y sonido (VolTe disponible en funci\u00f3n del operador).Con un peso de tan s\u00f3lo 55 gramos y una dimensiones m\u00e1ximas de 23,6 x 4,3 x 1,5 cm, cuenta con una bater\u00eda interna no removible de 700mAh con sistema de recarga magn\u00e9tica, correas intercambiables y bot\u00f3n S.O.S. que al pulsar permite establecer una comunicaci\u00f3n directa con un n\u00famero preconfigurado en caso de emergencia.OTRAS FUNCIONES- Pod\u00f3metro- Monitor de sue\u00f1o- Alertas- Notificaciones- Apagado remoto- Mensajes de audio- Mensajes de textoINFORMACI\u00d3N IMPORTANTE:Este producto incorpora un chip GPS real que le permite ser geolocalizado en tiempo real, as\u00ed como una tarjeta de telefon\u00eda compatible con redes 4G-LTE. Dependiendo del uso que se haga del dispositivo as\u00ed como de la configuraci\u00f3n que se establezca por medio de la aplicaci\u00f3n vinculada, la duraci\u00f3n de la bater\u00eda ser\u00e1 mayor o menor. Le recomendamos lea con detenimiento el manual de usuario de este producto para conocer al detalle todas sus opciones y poder sacar el m\u00e1ximo rendimiento al mismo.","images":"https:\/\/www.dmi.es\/photo\/2647\/99742\/75672641\/bg\/leotec-smartwatch-kids-allo-plus-4g-gps-anti-perdida-negro.jpg","wholesale_price":"48.34","unit_price_tax":52.366800000000005},"product_model":{"product_data":{"ean13":["8436588882219"],"reference":"WE01230337","name":{"1":"LEOTEC SMARTWATCH KIDS ALLO PLUS 4G GPS ANTI-PERDIDA NEGRO","2":"","3":"","4":""},"description":{"1":"Dispositivo inteligente con GPS real y llamadas para ni\u00f1osOs presentamos el que va a ser vuestro pr\u00f3ximo regalo, el nuevo dispositivo inteligente dise\u00f1ado utilizando la tecnolog\u00eda m\u00e1s avanzada del mundo