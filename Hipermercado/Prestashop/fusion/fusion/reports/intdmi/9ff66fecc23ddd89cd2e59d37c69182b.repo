t":["",false],"ean13":["8435602906481",false],"wholesale_price":[771.93,false],"price":[790.4286,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185473","Cat. IDs: 90","Associated Categories","Cat. Default: 90","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/21dd44d50f96dc8dc55923b99a190a7c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"TP10381248","unit_price":790.4286,"category":"TPV, Lectores e Impresoras","brand":"Posiflex","name_pt":"TERMINAL TACTIL FANLESS IP65 RT2015 15\" J6412 8GB RAM DDR4 128GB SSD, W10 IOT N","quantity":0,"ean13":"8435602906481","description_short_pt":"Terminal T\u00e1ctil Fanless IP65 RT2015 Negro, 15\", Intel J6412, 8Gb RAM DDR4, 128Gb SSD, Windows 10 IoT","description_pt":"Dise\u00f1o delgado y elegante.Con un dise\u00f1o elegante, fluido y rectil\u00edneo, la Serie RT-2015 equipa una pantalla t\u00e1ctil PCAP de 15\" y un conjunto completo de puertos que est\u00e1n escondidos en la cubierta trasera de forma m\u00e1s limpia y disimulada. No se pueden encontrar tornillos en su superficie manteniendo un aspecto sencillo y elegante.Tecnolog\u00eda Fanless patentada.La serie RT-2015 est\u00e1 dise\u00f1ada para funcionar en entornos hostiles en los que puede haber polvo y derrames de l\u00edquidos. Su tecnolog\u00eda patentada sin ventilador permite que la unidad funcione silenciosamente y elimina un posible punto de falla, lo que reduce los costos de servicio y energ\u00eda, y alarga su vida \u00fatil.Gesti\u00f3n de cableadoUn sistema de cableado \u00fanico (la expansi\u00f3n de E \/ S est\u00e1 centralizada y oculta en la cubierta posterior) ofrece una instalaci\u00f3n perfectamente ordenada. La base est\u00e1ndar puede albergar el m\u00f3dulo de extensi\u00f3n Powered USB o USB opcional, a la vez que conserva su elegante apariencia. Todo el cableado va canalizado a trav\u00e9s de su base.Mantenimiento y env\u00edoSu cubierta posterior se puede quitar f\u00e1cilmente y sin necesidad de herramientas, lo que permite una f\u00e1cil instalaci\u00f3n, mantenimiento y actualizaci\u00f3n. La unidad se puede enviar con una segunda pantalla LCD orientada al cliente de 9,7 \" unida y plegada para reducir el esfuerzo de despliegue, al mismo tiempo que se ahorra el volumen del embalaje.","images":"https:\/\/www.dmi.es\/photo\/159\/101491\/82146232\/bg\/terminal-tactil-fanless-ip65-rt2015-15--j6412-8gb-ram-ddr4-128gb-ssd--w10-iot-n.jpg","wholesale_price":"771.93","unit_price_tax":790.4286},"product_model":{"product_data":{"ean13":["8435602906481"],"reference":"TP10381248","name":{"1":"TERMINAL TACTIL FANLESS IP65 RT2015 15\" J6412 8GB RAM DDR4 128GB SSD, W10 IOT N","2":"","3":"","4":""},"description":{"1":"Dise\u00f1o delgado y elegante.Con un dise\u00f1o elegante, fluido y rectil\u00edneo, la Serie RT-2015 equipa una pantalla t\u00e1ctil PCAP de 15\" y un conjunto completo de puertos que est\u00e1n escondidos en la cubierta trasera de forma m\u00e1s limpia y disimulada. No se pueden encontrar tornillos en su superficie manteniendo un aspecto sencillo y elegante.Tecnolog\u00eda Fanless patentada.La serie RT-2015 est\u00e1 dise\u00f1ada para funcionar en entornos hostiles en los que puede haber polvo y derrames de l\u00edquidos. Su tecnolog\u00eda patentada sin ventilador permite que la unidad funcione silenciosamente y elimina un posible punto de falla, lo que reduce los costos de servicio y energ\u00eda, y alarga su vida \u00fatil.Gesti\u00f3n de cableadoUn sistema de cableado \u00fanico (la expansi\u00f3n de E \/ S est\u00e1 centralizada y oculta en la cubierta posterior) ofrece una instalaci\u00f3n perfectamente ordenada. La base est\u00e1ndar puede albergar el m\u00f3dulo de extensi\u00f3n Powered USB o USB opcional, a la vez que conserva su elegante apariencia. Todo el cableado va canalizado a trav\u00e9s de su base.Mantenimiento y env\u00edoSu cubierta posterior se puede quitar f\u00e1cilmente y sin necesidad de herramientas, lo que permite una f\u00e1cil instalaci\u00f3n, mantenimiento y actualizaci\u00f3n. La unidad se puede enviar con una segunda pantalla LCD orientada al cliente de 9,7 \" unida y plegada para reducir el esfuerzo de despliegue, al mismo tiempo que se ahorra el volumen del embalaje.","2":"","3":"","4":""},"description_short":{"1":"Terminal T\u00e1ctil Fanless IP65 RT2015 Negro, 15\", Intel J6412, 8Gb RAM DDR4, 128Gb SSD, Windows 10 IoT","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Posiflex","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":790.4286,"unit_price_tax":790.4286,"tax_rules_group":null,"category":"TPV, Lectores e Impresoras","brand":"Posiflex","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/159\/101491\/82146232\/bg\/terminal-tactil-fanless-ip65-rt2015-15--j6412-8gb-ram-ddr4-128gb-ssd--w10-iot-n.jpg"],"wholesale_price":771.93}}},"0810010074386":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0810010074386",false],"wholesale_price":[407.62,false],"price":[418.8324,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185474","Cat. IDs: 193","Associated Categories","Cat. Default: 193","Deleted old images","New images created","Add: \/home\/hipe