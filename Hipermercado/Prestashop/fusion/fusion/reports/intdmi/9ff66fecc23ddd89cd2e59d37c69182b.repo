res":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185061","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/8a8b54bd76dbbf8febab1fcdff92f115.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ12356049","unit_price":9.5166,"category":"Refrigeraci\u00f3n","brand":"NOX","name_pt":"VENTILADOR NOX HUMMER H-FAN PRO LED WHITE 120MM PWM","quantity":5,"ean13":"8436587972331","description_short_pt":"WHITE PWM 120mm Silent Fan","description_pt":"H-FAN PROEl Nox Hummer H-Fan Pro es un ventilador PWM de 120 mm que ofrece una refrigeraci\u00f3n silenciosa y eficiente, evitando el sobrecalentamiento de los componentes del ordenador, manteni\u00e9ndolos siempre a la temperatura m\u00e1s adecuada.Refrigeraci\u00f3n sobresalienteNox Hummer H-Fan Pro ofrece una ventilaci\u00f3n excelente a una velocidad de 600-2200 RPM. Con unas dimensiones de 120 x 120 x 25 mm, sus siete aspas aerodin\u00e1micas ofrecen un buen flujo de aire de 71,2 CFM.Iluminaci\u00f3n LEDCon una est\u00e9tica atractiva con aspas trasl\u00facidas que dejan pasar la luz, al tiempo que aseguran el mejor caudal de aire en el interior del equipo, el ventilador de Nox es perfecto para personalizar el PC.Rendimiento silenciosoGracias a un rodamiento hidr\u00e1ulico, Nox Hummer H-Fan Pro posee un muy bajo nivel sonoro que se sit\u00faa entre los 14 dB, con la velocidad m\u00e1s baja, y los 35 dB, con la velocidad m\u00e1s alta. El ruido es apenas imperceptible gracias a los soportes de goma antivibraci\u00f3n, cada uno del color del ventilador, que absorben el ruido.Con control PWMNo tendr\u00e1s nada de lo que preocuparte, ya que el Nox Hummer H-Fan Pro es un ventilador para PC con conector de 4 pines que posibilita controlar y regular la velocidad de rotaci\u00f3n. La tecnolog\u00eda PWM permite que se adapte a lo que vaya necesitando el equipo en cada momento.","images":"https:\/\/www.dmi.es\/photo\/921\/99631\/64253599\/bg\/ventilador-nox-hummer-h-fan-pro-led-white-120mm-pwm.jpg","wholesale_price":"6.33","unit_price_tax":9.5166},"product_model":{"product_data":{"ean13":["8436587972331"],"reference":"CJ12356049","name":{"1":"VENTILADOR NOX HUMMER H-FAN PRO LED WHITE 120MM PWM","2":"","3":"","4":""},"description":{"1":"H-FAN PROEl Nox Hummer H-Fan Pro es un ventilador PWM de 120 mm que ofrece una refrigeraci\u00f3n silenciosa y eficiente, evitando el sobrecalentamiento de los componentes del ordenador, manteni\u00e9ndolos siempre a la temperatura m\u00e1s adecuada.Refrigeraci\u00f3n sobresalienteNox Hummer H-Fan Pro ofrece una ventilaci\u00f3n excelente a una velocidad de 600-2200 RPM. Con unas dimensiones de 120 x 120 x 25 mm, sus siete aspas aerodin\u00e1micas ofrecen un buen flujo de aire de 71,2 CFM.Iluminaci\u00f3n LEDCon una est\u00e9tica atractiva con aspas trasl\u00facidas que dejan pasar la luz, al tiempo que aseguran el mejor caudal de aire en el interior del equipo, el ventilador de Nox es perfecto para personalizar el PC.Rendimiento silenciosoGracias a un rodamiento hidr\u00e1ulico, Nox Hummer H-Fan Pro posee un muy bajo nivel sonoro que se sit\u00faa entre los 14 dB, con la velocidad m\u00e1s baja, y los 35 dB, con la velocidad m\u00e1s alta. El ruido es apenas imperceptible gracias a los soportes de goma antivibraci\u00f3n, cada uno del color del ventilador, que absorben el ruido.Con control PWMNo tendr\u00e1s nada de lo que preocuparte, ya que el Nox Hummer H-Fan Pro es un ventilador para PC con conector de 4 pines que posibilita controlar y regular la velocidad de rotaci\u00f3n. La tecnolog\u00eda PWM permite que se adapte a lo que vaya necesitando el equipo en cada momento.","2":"","3":"","4":""},"description_short":{"1":"WHITE PWM 120mm Silent Fan","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"