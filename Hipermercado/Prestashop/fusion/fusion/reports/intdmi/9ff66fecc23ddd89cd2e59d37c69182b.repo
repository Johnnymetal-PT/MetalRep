rite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MSI","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":1576.92,"unit_price_tax":1576.92,"tax_rules_group":null,"category":"Tarjetas","brand":"MSI","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/170\/103912\/82231934\/bg\/tarjeta-grafica-msi-rtx-4090-gaming-x-slim-24gb.jpg"],"wholesale_price":1543}}},"0195348192095":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0195348192095",false],"wholesale_price":[132.66,false],"price":[138.3732,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188788","Cat. IDs: 68","Associated Categories","Cat. Default: 68","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fc705abe64433a060369af4877283a06.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PT9101122","unit_price":138.3732,"category":"Accesorios port\u00e1tiles","brand":"Lenovo","name_pt":"DOCKING STATION LENOVO THINKPAD UNIVERSAL USB-C DOCK USB 3.2","quantity":0,"ean13":"0195348192095","description_short_pt":"2 x DisplayPort, 1 x HDMI, 3 x USB 3.1, 2 x USB 2.0, 1 x USB Type C, 1 x Gigabit LAN, 90W","description_pt":"LA FORMA M\u00c1S INTELIGENTE DE TRABAJAR Presentamos la estaci\u00f3n de acoplamiento Universal USB-C ThinkPad. Esta avanzada soluci\u00f3n de estaci\u00f3n de acoplamiento con un cable universalmente compatible le permite trabajar de forma m\u00e1s inteligente, no m\u00e1s dura. Viene con una gran variedad de puertos, funcionalidades plug and play de \u00faltima generaci\u00f3n y capacidades de carga r\u00e1pida (hasta 100 W para la mayor\u00eda de los equipos port\u00e1tiles USB-C*). Es lo suficientemente inteligente como para instalar actualizaciones de firmware cr\u00edticas autom\u00e1ticamente, es ideal para cualquier entorno de PC mixto y para el trabajo en el hogar, y le brinda la libertad y el poder para hacer m\u00e1s. ,, * El adaptador de alimentaci\u00f3n de 90 W incorporado carga ThinkPad y otros equipos port\u00e1tiles USB-C hasta 65 W. Para carga de 100 W, se requiere un adaptador de alimentaci\u00f3n de 135 W con punta delgada opcional (PN: 4X20E50558 (US)\/4X20E505xx). Se vende por separado.","images":"https:\/\/www.dmi.es\/photo\/152\/84888\/88445442\/bg\/docking-station-lenovo-thinkpad-universal-usb-c-dock-usb-3-2.jpg","wholesale_price":"132.66","unit_price_tax":138.3732},"product_model":{"product_data":{"ean13":["0195348192095"],"reference":"PT9101122","name":{"1":"DOCKING STATION LENOVO THINKPAD UNIVERSAL USB-C DOCK USB 3.2","2":"","3":"","4":""},"description":{"1":"LA FORMA M\u00c1S INTELIGENTE DE TRABAJAR Presentamos la estaci\u00f3n de acoplamiento Universal USB-C ThinkPad. Esta avanzada soluci\u00f3n de estaci\u00f3n de acoplamiento con un cable universalmente compatible le permite trabajar de forma m\u00e1s inteligente, no m\u00e1s dura. Viene con una gran variedad de puertos, funcionalidades plug and play de \u00faltima generaci\u00f3n y capacidades de carga r\u00e1pida (hasta 100 W para la mayor\u00eda de los equipos port\u00e1tiles USB-C*). Es lo suficientemente inteligente como para instalar actualizaciones de firmware cr\u00edticas autom\u00e1ticamente, es ideal para cualquier entorno de PC mixto y para el trabajo en el hogar, y le brinda la libertad y el poder para hacer m\u00e1s. ,, * El adaptador de alimentaci\u00f3n de 90 W incorporado carga ThinkPad y otros equipos port\u00e1tiles USB-C hasta 65 W. Para carga de 100 W, se requiere un adaptador de alimentaci\u00f3n de 135 W con punta delgada opcional (PN: 4X20E50558 (US)\/4X20E505xx). Se vende por separado.","2":"","3":"","4":""},"description_s