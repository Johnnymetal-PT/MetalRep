rue],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:190425","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5887e91e06233e7149adb5b45349796f.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO21330014","unit_price":61.760999999999996,"category":"Control de clima","brand":"Cecotec","name_pt":"DESHUMIFDIFICADOR BIGDRY 2500 PURE LIGHT","quantity":0,"ean13":"8435484056045","description_short_pt":"Big Dry 2500 Pure Light","description_pt":"OLV\u00cdDATE DE LA HUMEDAD Y SUS PROBLEMASGran poder de deshumidificaci\u00f3n de hasta 750 ml\/d\u00eda que disminuye en gran medida la concentraci\u00f3n de humedad en el ambiente para generar un mayor bienestar y evitar el posible deterioro de muebles o la aparici\u00f3n de enfermedades provocadas por la humedad.DEP\u00d3SITO EXTRA\u00cdBLE DE GRAN CAPACIDADDep\u00f3sito extra\u00edble que facilita su vaciado con una gran capacidad de 1 litro para m\u00e1xima comodidad.PURIFICA TU AIREFunci\u00f3n de purificador, con filtro de alta eficiencia, que permite filtrar cerca del 100% de part\u00edculas presentes en el aire como polvo, polen o humo, que pueden provocar alergias o sensaci\u00f3n de malestar.IDEAL PARA ESTUDIOS U OFICINAS M\u00c1XIMA ELEGANCIAIdeal para estancias de hasta 25 m2 como oficinas, salas de estar, comedores? Dise\u00f1o elegante y limpio con l\u00edneas suaves e iluminaci\u00f3n que decorar\u00e1 cualquier parte del hogar.SELECCI\u00d3N DE VELOCIDADES Y AUTOAPAGADO CON DEP\u00d3SITO LLENOPermite seleccionar entre dos niveles de deshumidificaci\u00f3n para adecuar la intensidad a cualquier situaci\u00f3n. Apagado autom\u00e1tico con dep\u00f3sito lleno para evitar desbordamientos y conseguir un menor consumo energ\u00e9tico. M\u00ednimo consumo de 45W para ahorrar en la factura de la luz. Luz de aviso de llenado de dep\u00f3sito.USO SENCILLO Y LIGEROBajo peso para ser transportado entre distintas estancias o espacios c\u00f3modamente. Uso muy sencillo mediante botones t\u00e1ctiles que facilitan su manejo y control.","images":"https:\/\/www.dmi.es\/photo\/1436\/105480\/51883548\/bg\/deshumifdificador-bigdry-2500-pure-light.jpg","wholesale_price":"57.55","unit_price_tax":61.760999999999996},"product_model":{"product_data":{"ean13":["8435484056045"],"reference":"HO21330014","name":{"1":"DESHUMIFDIFICADOR BIGDRY 2500 PURE LIGHT","2":"","3":"","4":""},"description":{"1":"OLV\u00cdDATE DE LA HUMEDAD Y SUS PROBLEMASGran poder de deshumidificaci\u00f3n de hasta 750 ml\/d\u00eda que disminuye en gran medida la concentraci\u00f3n de humedad en el ambiente para generar un mayor bienestar y evitar el posible deterioro de muebles o la aparici\u00f3n de enfermedades provocadas por la humedad.DEP\u00d3SITO EXTRA\u00cdBLE DE GRAN CAPACIDADDep\u00f3sito extra\u00edble que facilita su vaciado con una gran capacidad de 1 litro para m\u00e1xima comodidad.PURIFICA TU AIREFunci\u00f3n de purificador, con filtro de alta eficiencia, que permite filtrar cerca del 100% de part\u00edculas presentes en el aire como polvo, polen o humo, que pueden provocar alergias o sensaci\u00f3n de malestar.IDEAL PARA ESTUDIOS U OFICINAS M\u00c1XIMA ELEGANCIAIdeal para estancias de hasta 25 m2 como oficinas, salas de estar, comedores? Dise\u00f1o elegante y limpio con l\u00edneas suaves e iluminaci\u00f3n que decorar\u00e1 cualquier parte del hogar.SELECCI\u00d3N DE VELOCIDADES Y AUTOAPAGADO CON DEP\u00d3SITO LLENOPermite seleccionar entre dos niveles de deshumidificaci\u00f3n para adecuar la intensidad a cualquier situaci\u00f3n. Apagado autom\u00e1tico con dep\u00f3sito lleno para evitar desbordamientos y conseguir un menor consumo energ\u00e9tico. M\u00ednimo consumo de 45W para ahorrar en la factura de la 