s_group":null,"category":"Refrigeraci\u00f3n","brand":"CoolBox","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/921\/67413\/28357742\/bg\/ventilador-caja-coolbox-80mm-3-pin-1600rpm.jpg"],"wholesale_price":1.88}}},"8436532168338":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436532168338",false],"wholesale_price":[31,false],"price":[34.68,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186263","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/04dd385fe9d11765612eb7fd963c7319.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"VE10356039","unit_price":34.68,"category":"Refrigeraci\u00f3n","brand":"NOX","name_pt":"VENTILADOR CAJA NOX HUMMER H-SYNC RGB 120MM PACK 3","quantity":0,"ean13":"8436532168338","description_short_pt":"120 mm, 900 - 2000 rpm, 56.5 CFM, PWM, Iluminaci\u00f3n LED RGB, 31.5 dB, 630 g","description_pt":"LA UNI\u00d3N HACE LA FUERZAHummer presenta su kit de tres ventiladores cuyo objetivo es ofrecerle a tu equipo una \u00f3ptima ventilaci\u00f3n y garantizar un continuo flujo de aire en el interior de tu PC.VENTILACI\u00d3N EFICIENTETriplica la ventilaci\u00f3n de tu equipo gracias a Hummer H-Sync, un kit de 3 ventiladores de 120 mm que alcanzan una velocidad de hasta 2000 RPM a un bajo nivel sonoro.Cada ventilador cuenta con 9 aspas aerodin\u00e1micas que consiguen el flujo \u00f3ptimo de aire que tu equipo necesita para rendir al m\u00e1ximo durante largas horas.Adem\u00e1s, Hummer H-Sync dispone de control PWM para adaptarse a las necesidades del equipo en cada momento, creando un equilibrio perfecto entre rendimiento y eficiencia.DISE\u00d1O E ILUMINACI\u00d3NMultiplica por tres su dise\u00f1o innovador y su iluminaci\u00f3n LED RGB que te permitir\u00e1 crear diferentes ambientes y sincronizarlos con los colores del resto del equipo.Adem\u00e1s, para darte la m\u00e1xima estabilidad, cada ventilador cuenta con 4 pads de goma antivibraci\u00f3n para prevenir molestos ruidos generados por las vibraciones.ALTA COMPATIBILIDADEl kit H-Sync est\u00e1 dotado con una iluminaci\u00f3n RGB compatible con tecnolog\u00edas de sincronizaci\u00f3n de los fabricantes de placas base de referencia como Asus Aura Sync, Gigabyte RGB Fusion, MSI Mystic Light Sync y Asrock RGB Led, ofreci\u00e9ndote as\u00ed un amplio abanico de posibilidades en la iluminaci\u00f3n de tu equipo. Adem\u00e1s, posee un controlador remoto con el que podr\u00e1s ajustar la velocidad de los ventiladores y personalizar los efectos de iluminaci\u00f3n.","images":"https:\/\/www.dmi.es\/photo\/921\/67233\/27882865\/bg\/ventilador-caja-nox-hummer-h-sync-rgb-120mm-pack-3.jpg","wholesale_price":"31.00","unit_price_tax":34.68},"product_model":{"product_data":{"ean13":["8436532168338"],"reference":"VE10356039","name":{"1":"VENTILADOR CAJA NOX HUMMER H-SYNC RGB 120MM PACK 3","2":"","3":"","4":""},"description":{"1":"LA UNI\u00d3N HACE LA FUERZAHummer presenta su kit de tres ventiladores cuyo objetivo es ofrecerle a tu equipo una \u00f3ptima ventilaci\u00f3n y garantizar un continuo flujo de aire en el interior de tu PC.VENTILACI\u00d3N EFICIENTETriplica la ventilaci\u00f3n de tu equipo gracias a Hummer H-Sync, un kit de 3 ventiladores de 120 mm que alcanzan una velocidad de hasta 2000 RPM a un bajo nivel sonoro.Cada ventilador cuenta con 9 aspas aerodin\u00e1micas que consiguen el flujo \u00f3ptimo de aire que tu equipo necesita para rendir al m\u00e1ximo durante largas horas.Adem\u00e1s, Hummer H-Sync dispone de control PWM para adaptarse a las necesidades del equipo en cada momento, creando un equilibrio perfecto entre rendimiento y eficiencia.DISE\u00d1O E ILUMINACI\u00d3NMultiplica por tres su dise\u00f1o innovador y su iluminaci\u00f3n LED RGB que te permitir\u00e1 crear diferentes ambientes y sincronizarlos con los colores del resto del equipo.Adem\u00e1s, para darte la m\u00e1xima estabilidad, cada ventilador cuenta con 4 pads de goma antivibraci\u00f3n para prevenir molestos ruidos generados por las vibraciones.ALTA COMPATIBILIDADEl kit H-Sync est\u00e1 dotado con una iluminaci\u00f3n RGB compatible con tecnolog\u00edas de sincronizaci\u00f3n de los fabricantes de placas base de referencia como Asus Aura Sync, Gigabyte RGB Fusion, MSI Mystic Light Sync y Asrock RGB Led, ofreci\u00e9ndote as\u00ed un amplio abanico de posibilidades en la iluminaci\u00f3n de tu equipo. Adem\u00e1s, posee un controlador remoto con el que podr\u00e1s ajustar la velocidad de los ventiladores y personalizar los efectos de iluminaci\u00f3n.","2":"","3":"","4":""},"description_short":{"1":"120 mm, 900 - 2000 rpm, 56.5 CFM, PWM, Iluminaci\u00f3n LED RGB, 31.5 dB, 630 g","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":34.68,"unit_price_tax":34.68,"tax_rules_group":null,"category":"Refrigeraci\u00f3n","brand":"NOX","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/921\/67233\/27882865\/bg\/ventilador-caja-nox-hummer-h-sync-rgb-120mm-pack-3.jpg"],"wholesale_price":31}}},"8032958189041":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8032958189041",false],"wholesale_price":[1.41,false],"price":[4.4982,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags"