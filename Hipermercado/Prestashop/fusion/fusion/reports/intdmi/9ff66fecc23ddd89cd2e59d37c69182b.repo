817\/67618\/25972444\/bg\/sai-vertiv-liebert-gxt-mt+-2kva-g2.jpg","wholesale_price":"572.94","unit_price_tax":587.4588000000001},"product_model":{"product_data":{"ean13":["0767041019544"],"reference":"LB12372179","name":{"1":"SAI VERTIV LIEBERT GXT-MT+ 2KVA G2","2":"","3":"","4":""},"description":{"1":"SISTEMAS DE ALIMENTACI\u00d3N ININTERRUMPIDA (SAI) LIEBERT GXT-MT+ 2 kVA G2 ES 230 V Liebert\u00ae GXT MT+ cuenta con aut\u00e9ntica tecnolog\u00eda de doble conversi\u00f3n online y brinda la mejor protecci\u00f3n de alimentaci\u00f3n de su clase para aplicaciones cr\u00edticas. Se ha dise\u00f1ado para proporcionar un alto nivel de disponibilidad para equipamiento inform\u00e1tico conectado a la vez que brinda elevados niveles de eficiencia, que llevan a ventajas de optimizaci\u00f3n del coste total de propiedad (TCO) gracias a su funci\u00f3n de modo ECO.","2":"","3":"","4":""},"description_short":{"1":"Vertiv LIEBERT GXT-MT+ 2\u00a0kVA G2","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Vertiv","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":587.4588,"unit_price_tax":587.4588,"tax_rules_group":null,"category":"Electricidad","brand":"Vertiv","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/817\/67618\/25972444\/bg\/sai-vertiv-liebert-gxt-mt+-2kva-g2.jpg"],"wholesale_price":572.94}}},"4016032387756":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4016032387756",false],"wholesale_price":[1.15,false],"price":[4.233,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185866","Cat. IDs: 122","Associated Categories","Cat. Default: 122","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/d214f52854e607d7b0cef7031aab425c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CA22267140","unit_price":4.2330000000000005,"category":"Cables y Conectores","brand":"Digitus","name_pt":"CABLE DIGITUS CAT 6 U-UTP PCABLE CU LSZH  2M","quantity":5,"ean13":"4016032387756","description_short_pt":"CAT 6 U-UTP patch cord, Cu, LSZH AWG 26\/7, length 2 m, color grey","description_pt":"Optimiza el rendimiento y la calidad de las conexiones de su red.- Con envoltura exterior LSZH (Low Smoke Zero Halogen) para un comportamiento mejor frente al fuego y una menor emisi\u00f3n de humo.- Conector de color rojo transparente para identificar f\u00e1cilmente la categor\u00eda 6 (250 MHz).- Conductor interior: Cobre (Cu)- Compatible con PoE+Los cables de conexi\u00f3n DIGITUS\u00ae categor\u00eda 6 clase E se fabrican y verifican conforme a las normas ISO\/IEC 11801 y DIN EN 50173 CAT 6. Garantizan que la instalaci\u00f3n de del cable cumple las especificaciones de la ISO & EN Channel y ofrecen un rendimiento sobresaliente en el cableado DIGITUS\u00ae CAT 6. Se ha verificado el rendimiento hasta 250 MHz, incluidas caracter\u00edsticas como por ejemplo la paradifon\u00eda (?NEXT?). Los cables de conexi\u00f3n DIGITUS\u00ae han sido espec\u00edficamente desarrollados para cumplir totalmente todos los requisitos en todos los sectores de utilizaci\u00f3n. Todos los cables est\u00e1n equipados con una envoltura de protecci\u00f3n anti dobleces inyectada con descarga de presi\u00f3n. La envoltura dispone adem\u00e1s de una protecci\u00f3n de pesta\u00f1a de retenci\u00f3n que evita que se enganche el cable y que se rompa la pesta\u00f1a de retenci\u00f3n del conector. La categor\u00eda 6 se puede identificar f\u00e1cilmente gracias al color rojo del conector.","images":"https:\/\/www.dmi.es\/photo\/883\/83046\/55667509\/bg\/cable-digitus-cat-6-u-utp-pcable-cu-lszh--2m.jpg","wholesale_price":"1.15","unit_price_tax":4.2330000000000005},"product_model":{"product_data":{"ean13":["4016032387756"],"reference":"CA22267140","name":{"1":"CABLE DIGITUS CAT 6 U-UTP PCABLE CU LSZH  2M","2":"","3":"","4":""},"description":{"1":"Optimiza el rendimiento y la calidad de las conexiones de su red.- Con envoltura exterior LSZH (Low Smoke Zero Halogen) para un comportamiento mejor frente al fuego y una menor emisi\u00f3n de humo.- Conector de color rojo transparente para identificar f\u00e1cilmente la categor\u00eda 6 (250 MHz).- Conductor interior: Cobre (Cu)- Compatible con PoE+Los cables de conexi\u00f3n DIGITUS\u00ae categor\u00eda 6 clase E se fabrican y verifican conforme a las normas ISO\/IEC 11801 y DIN EN 50173 CAT 6. Garantizan que la instalaci\u00f3n de del cable cumple las especificaciones de la ISO & EN Channel y ofrecen un rendimiento sobresaliente en el cableado DIGITUS\u00ae CAT 6. Se ha verificado el rendimiento hasta 250 MHz, incluidas caracter\u00edsticas como por ejemplo la paradifon\u00eda (?NEXT?). Los cables de conexi\u00f3n DIGITUS\u00ae han sido espec\u00edficamente desarrollados para cumplir totalmente todos los requisitos en todos los sectores de utilizaci\u00f3n. Todos los cables est\u00e1n equipados con una envoltura de protecci\u00f3n anti dobleces inyectada con descarga de presi\u00f3n. La envoltura dispone adem\u00e1s de una protecci\u00f3n de pesta\u00f1a de retenci\u00f3n que evita que se enganche el cable y que se rompa la pesta\u00f1a de retenci\u00f3n del conector. La categor\u00eda 6 se puede identificar f\u00e1cilmente gracias al color rojo del conector.","2":"","3":"","4":""},"description_short":{"1":"CAT 6 U-UTP patch cord, Cu, LSZH AWG 26\/7, length 2 m, color grey","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Digitus","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":4.233,"unit_price_tax":4.233,"tax_rules_group":null,"category":"Cables y Conectores","brand":"Digitus","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/883\/83046\/55667509\/bg\/cable-digitus-cat-6-u-utp-pcable-cu-lszh--2m.jpg"],"wholesale_price":1.15}}},"4016032434696":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4016032434696",false],"wholesale_price":[2.08,false],"price":[5.1816,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185867","Cat. IDs: 122","Associated Categories","Cat. Default: 122","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/3ff905d069bedc4d4761ed27ce595fbc.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CA11267582","unit_price":5.1815999999999995,"category":"Cables y Conectores","brand":"Digitus","name_pt":"CABLE DIGITUS 1M  CAT6A S\/FTP (S-STP) RJ-45","quantity":0,"ean13":"4016032434696","description_short_pt":"Cable de conexi\u00f3n CAT 6A S-FTP, Cu, PUR AWG 26\/7, 1,00\u00a0m, verde (similar a RAL 6018)","description_pt":"Optimiza el rendimiento y la calidad de las conexiones de su red. Ideal para uso industrial.- Con revestimiento exterior PUR (poliuretano) para la resistencia a los aceites y rayos UV- Conductor interior: Cobre (Cu)- Compatible con PoE+- Compatible con PoE+Los cables de conexi\u00f3n S\/FTP de la categor\u00eda 6A ofrecen con su cubierta de PUR una buena resistencia frente al aceite, por lo cual son apropiados para el uso industrial. Otras caracter\u00edsticas de la cubierta de PUR son la resistencia a la radiaci\u00f3n UV y la autoextinci\u00f3n en caso de incendio. Los cables de conexi\u00f3n de la categor\u00eda 6A, clase EA de DIGITUS\u00ae est\u00e1n fabricados y comprobados seg\u00fan las normas ISO\/IEC 11801 y DIN EN 50173 CAT 6A. Esto garantiza que la instalaci\u00f3n de cables corresponde a la especificaci\u00f3n ISO y EN Channel y ofrece un excelente rendimiento en el cableado DIGITUS\u00ae CAT 6A. La potencia ha sido ensayada hasta 500\u00a0MHz, incluyendo caracter\u00edsticas de rendimiento como, por ejemplo, la paradiafon\u00eda (\u00abNEXT\u00bb). Han sido desarrollados espec\u00edficamente para satisfacer plenamente todas las exigencias en los distintos \u00e1mbitos de aplicaci\u00f3n. Cada cable est\u00e1 dotado de un manguito de protecci\u00f3n moldeado con descarga de tracci\u00f3n. Adem\u00e1s, el manguito posee una protecci\u00f3n para la palanca de enclavamiento que evita que los cables se enganchen y se rompa la palanca de enclavamiento del conector.","images":"https:\/\/www.dmi.es\/photo\/883\/96239\/55671827\/bg\/cable-digitus-1m--cat6a-s-ftp--s-stp--rj-45.jpg","wholesale_price":"2.08","unit_price_tax":5.1815999999999995},"product_model":{"product_data":{"ean13":["4016032434696"],"reference":"CA11267582","name":{"1":"CABLE DIGITUS 1M  CAT6A S\/FTP (S-STP) RJ-45","2":"","3":"","4":""},"description":{"1":"Optimiza el rendimiento y la calidad de las conexiones de su red. Ideal para uso industrial.- Con revestimiento exterior PUR (poliuretano) para la resistencia a los aceites y rayos UV- Conductor interior: Cobre (Cu)- Compatible con PoE+- Compatible con PoE+Los cables de conexi\u00f3n S\/FTP de la categor\u00eda 6A ofrecen con su cubierta de PUR una buena resistencia frente al aceite, por lo cual son apropiados para el uso industrial. Otras caracter\u00edsticas de la cubierta de PUR son la resistencia a la radiaci\u00f3n UV y la autoextinci\u00f3n en caso de incendio. Los cables de conexi\u00f3n de la categor\u00eda 6A, clase EA de DIGITUS\u00ae est\u00e1n fabricados y comprobados seg\u00fan las normas ISO\/IEC 11801 y DIN EN 50173 CAT 6A. Esto garantiza que la instalaci\u00f3n de cables corresponde a la especificaci\u00f3n ISO y EN Channel y ofrece un excelente rendimiento en el cableado DIGITUS\u00ae CAT 6A. La potencia ha sido ensayada hasta 500\u00a0MHz, incluyendo caracter\u00edsticas de rendimiento como, por ejemplo, la paradiafon\u00eda (\u00abNEXT\u00bb). Han sido desarrollados espec\u00edficamente para satisfacer plenamente todas las exigencias en los distintos \u00e1mbitos de aplicaci\u00f3n. Cada cable est\u00e1 dotado de un manguito de protecci\u00f3n moldeado con descarga de tracci\u00f3n. Adem\u00e1s, el manguito posee una protecci\u00f3n para la palanca de enclavamiento que evita que los cables se enganchen y se rompa la palanca de enclavamiento del conector.","2":"","3":"","4":""},"description_short":{"1":"Cable de conexi\u00f3n CAT 6A S-FTP, Cu, PUR AWG 26\/7, 1,00\u00a0m, verde (similar a RAL 6018)","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Digitus","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":5.1816,"unit_price_tax":5.1816,"tax_rules_group":null,"category":"Cables y Conectores","brand":"Digitus","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/883\/96239\/55671827\/bg\/cable-digitus-1m--cat6a-s-ftp--s-stp--rj-45.jpg"],"wholesale_price":2.08}}},"0740617318388":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0740617318388",false],"wholesale_price":[60.93,false],"price":[65.2086,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product w