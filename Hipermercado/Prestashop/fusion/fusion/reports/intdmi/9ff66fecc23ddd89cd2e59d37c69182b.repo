s del entorno y de los dispositivos.Contenido del empaque:? Teclado Bluetooth multidispositivo? Dos pilas AAA (preinstaladas)? Documentaci\u00f3n del usuario? Dos a\u00f1os de garant\u00eda del fabricante","2":"","3":"","4":""},"description_short":{"1":"Logitech K380 Teclado Inal\u00e1mbrico Multi-Dispositivos para Windows\/Apple iOS\/Android\/Chrome, Bluetooth, Dise\u00f1o Compacto, PC\/Mac\/Port\u00e1til\/Smartphone\/Tablet\/Apple TV, Disposici\u00f3n QWERTY Espa\u00f1ol - Negro","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Logitech","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":38.2806,"unit_price_tax":38.2806,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Logitech","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/194\/3947\/21581646\/bg\/teclado-logitech-k380-inalambrico-negro.jpg"],"wholesale_price":34.53}}},"8716309092845":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8716309092845",false],"wholesale_price":[2.78,false],"price":[5.8956,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185266","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/14abcd90163378f88ebeacedc1229920.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PE1032024","unit_price":5.8956,"category":"Perif\u00e9ricos","brand":"Gembird","name_pt":"TECLADO GEMBIRD USB NEGRO","quantity":5,"ean13":"871630