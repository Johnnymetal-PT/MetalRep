grafica-asus-proart-rtx-4070ti-12gb-gddr6-bulk-+-soporte.jpg","wholesale_price":"712.00","unit_price_tax":729.3},"product_model":{"product_data":{"ean13":["4711387182819"],"reference":"TG211061076","name":{"1":"TARJETA GRAFICA ASUS PROART RTX 4070TI 12GB GDDR6 BULK + SOPORTE","2":"","3":"","4":""},"description":{"1":"ASUS ProArt -RTX4070TI-12G. Familia de procesadores de gr\u00e1ficos: NVIDIA, Procesador gr\u00e1fico: GeForce RTX 4070 Ti. Capacidad memoria de adaptador gr\u00e1fico: 12 GB, Tipo de memoria de adaptador gr\u00e1fico: GDDR6X, Ancho de datos: 192 bit. M\u00e1xima resoluci\u00f3n: 7680 x 4320 Pixeles. Versi\u00f3n DirectX: 12 Ultimate, Versi\u00f3n OpenGL: 4.6. Tipo de interfaz: PCI Express 4.0. Tipo de enfriamiento: Activo, N\u00famero de ventiladores: 3 Ventilador(es)","2":"","3":"","4":""},"description_short":{"1":"ASUS ProArt -RTX4070TI-12G, GeForce RTX 4070 Ti, 12 GB, GDDR6X, 192 bit, 7680 x 4320 Pixeles, PCI Express 4.0","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ASUS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":729.3,"unit_price_tax":729.3,"tax_rules_group":null,"category":"Tarjetas","brand":"ASUS","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/170\/102668\/75279649\/bg\/tarjeta-grafica-asus-proart-rtx-4070ti-12gb-gddr6-bulk-+-soporte.jpg"],"wholesale_price":712}}},"8436587974090":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587974090",false],"wholesale_price":[143.94,false],"price":[149.8788,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189386","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/dbeee49ad8e69ed711df93a4454198ca.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"MN53355360","unit_price":149.8788,"category":"Perif\u00e9ricos","brand":"Krom","name_pt":"MONITOR GAMING KROM KERTZ 24\" RGB 200HZ HDMI DP","quantity":5,"ean13":"8436587974090","description_short_pt":"23.8\", 1920 x 1080, 200 Hz, 1 ms, AMD Freesync & Nvidia G-Sync, 1 x HDMI, 1 x Display Port, 2.95 kg","description_pt":"KERTZKertz es el primer monitor que se incorpora al cat\u00e1logo de Krom. Completa tu setup con este monitor gamer de 23.8? frameless. Con dise\u00f1o ergon\u00f3mico, consigue la inmersi\u00f3n perfecta para todas tus partidas, adem\u00e1s disfrutar\u00e1s de im\u00e1genes n\u00edtidas y fluidas gracias a su tasa de respuesta de 1ms y su tasa de refresco de 200 Hz.Con las dos tiras LED RGB que incorpora en su parte posterior consigue el toque de color que tu setup necesitaComodidad extraordinariaKertz es un monitor gaming frameless extraplano de 23.8? que incorpora retroiluminaci\u00f3n LED. Dise\u00f1ado para ofrecer una inmersi\u00f3n completa en la partida, su dise\u00f1o es completamente en negro.Creado con un tama\u00f1o que lo hace perfecto para el entorno multipantalla, pudiendo ser, adem\u00e1s, anclado a la pared gracias al sistema VESA 75x75, maximizando as\u00ed el espacio de tu escritorio o mesa gaming.Adem\u00e1s, esta pantalla integra las tecnolog\u00edas Low Blue Light y Flicker Free que te ayudan a cuidar tu vista.Gran resoluci\u00f3nEl monitor Kertz tiene una gran resoluci\u00f3n FHD de 1920 x 1080 p\u00edxeles y tambi\u00e9n ofrece compatibilidad HDR, lo cual brinda un mayor nivel de contraste entre las im\u00e1genes claras y oscuras, dej\u00e1ndote ver al enemigo en cualquier parte.Gran ConectividadEn la parte trasera encontrar\u00e1s los distintos botones que te permiten ajustar el brillo y el contraste, entre otras caracter\u00edsticas. Tambi\u00e9n podr\u00e1s elegir los ajustes del color, seleccionando entre los diferentes modos incluidos, como el modo juego o el FPS.Este monitor gaming cuenta con dos entradas HDMI y una entrada DisplayPort, incluyendo un cable HDMI 2.0 y un cable Display Port 1.2. Adem\u00e1s, Kertz posee una salida de audioCapacidad de respuesta y tasa de refrescoCon Kertz no importar\u00e1 lo r\u00e1pido que sea el movimiento durante la partida, la imagen permanecer\u00e1 n\u00edtida en todo momento gracias a su asombroso tiempo de respuesta de 1 ms. Di adi\u00f3s a las im\u00e1genes borrosas y al tearing con la tasa de refresco de 200 Hz con la que cuenta este monitor gamer. No habr\u00e1 juego que se resista y disfrutar\u00e1s siempre de una imagen fluida.Un chasis sin igualEste monitor de Krom cuenta con una robusta peana para garantizar la estabilidad en cualquier movimiento, adem\u00e1s, podr\u00e1s ajustar el \u00e1ngulo de inclinaci\u00f3n para que se adapte a ti, y evitar de este modo fatigas en el cuello o la vista cuando disfrutes de tus largas sesiones de juego.Este elegante monitor sin marcos Full HD es ideal para obtener un mayor grado de inmersi\u00f3n, envolvi\u00e9ndote y traslad\u00e1ndote al campo de batalla, fomentando la concentraci\u00f3n y consiguiendo la m\u00e1xima visualizaci\u00f3n de todo el terreno de juego","images":"https:\/\/www.dmi.es\/photo\/222\/99544\/77066673\/bg\/monitor-gaming-krom-kertz-24--rgb-200hz-hdmi-dp.jpg","wholesale_price":"143.94","unit_price_tax":149.8788},"product_model":{"product_data":{"ean13":["8436587974090"],"reference":"MN53355360","name":{"1":"MONITOR GAMING KROM KERTZ 24\" RGB 200HZ HDMI DP","2":"","3":"","4":""},"description":{"1":"KERTZKertz es el primer monitor que se incorpora al cat\u00e1logo de Krom. Completa tu setup con este monitor gamer de 23.8? frameless. Con dise\u00f1o ergon\u00f3mico, consigue la inmersi\u00f3n perfecta para todas tus partidas, adem\u00e1s disfrutar\u00e1s de im\u00e1genes n\u00edtidas y fluidas gracias a su tasa de respuesta de 1ms y su tasa de refresco de 200 Hz.Con las dos tiras LED RGB que incorpora en su parte posterior consigue el toque de color que tu setup necesitaComodidad extraordinariaKertz es un monitor gaming frameless extraplano de 23.8? que incorpora retroiluminaci\u00f3n LED. Dise\u00f1ado para ofrecer una inmersi\u00f3n completa en la partida, su dise\u00f1o es completamente en negro.Creado con un tama\u00f1o que lo hace perfecto para el entorno multipantalla, pudiendo ser, adem\u00e1s, anclado a la pared gracias al sistema VESA 75x75, maximizando as\u00ed el espacio de tu escritorio o mesa gaming.Adem\u00e1s, esta pantalla integra las tecnolog\u00edas Low Blue Light y Flicker Free que te ayudan a cuidar tu vista.Gran resoluci\u00f3nEl monitor Kertz tiene una gran resoluci\u00f3n FHD de 1920 x 1080 p\u00edxeles y tambi\u00e9n ofrece compatibilidad HDR, lo cual brinda un mayor nivel de contraste entre las im\u00e1genes claras y oscuras, dej\u00e1ndote ver al enemigo en cualquier parte.Gran ConectividadEn la parte trasera encontrar\u00e1s los distintos botones que te permiten ajustar el brillo y el contraste, entre otras caracter\u00edsticas. Tambi\u00e9n podr\u00e1s elegir los ajustes del color, seleccionando entre los diferentes modos incluidos, como el modo juego o el FPS.Este monitor gaming cuenta con dos entradas HDMI y una entrada DisplayPort, incluyendo un cable HDMI 2.0 y un cable Display Port 1.2. Adem\u00e1s, Kertz posee una salida de audioCapacidad de respuesta y tasa de refrescoCon Kertz no importar\u00e1 lo r\u00e1pido que sea el movimiento durante la partida, la imagen permanecer\u00e1 n\u00edtida en todo momento gracias a su asombroso tiempo de respuesta de 1 ms. Di adi\u00f3s a las im\u00e1genes borrosas y al tearing con la tasa de refresco de 200 Hz con la que cuenta este monitor gamer. No habr\u00e1 juego que se resista y disfrutar\u00e1s siempre de una imagen fluida.Un chasis sin igualEste monitor de Krom cuenta con una robusta peana para garantizar la estabilidad en cualquier movimiento, adem\u00e1s, podr\u00e1s ajustar el \u00e1ngulo de inclinaci\u00f3n para que se adapte a ti, y evitar de este modo fatigas en el cuello o la vista cuando disfrutes de tus largas sesiones de juego.Este elegante monitor sin marcos Full HD es ideal para obtener un mayor grado de inmersi\u00f3n, envolvi\u00e9ndote y traslad\u00e1ndote al campo de batalla, fomentando la concentraci\u00f3n y consiguiendo la m\u00e1xima visualizaci\u00f3n de todo el terreno de juego","2":"","3":"","4":""},"description_short":{"1":"23.8\", 1920 x 1080, 200 Hz, 1 ms, AMD Freesync & Nvidia G-Sync, 1 x HDMI, 1 x Display Port, 2.95 kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Krom","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":149.8788,"unit_price_tax":149.8788,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Krom","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/222\/99544\/77066673\/bg\/monitor-gaming-krom-kertz-24--rgb-200hz-hdmi-dp.jpg"],"wholesale_price":143.94}}},"4719331807979":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4719331807979",false],"wholesale_price":[207.1,false],"price":[214.302,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189387","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old