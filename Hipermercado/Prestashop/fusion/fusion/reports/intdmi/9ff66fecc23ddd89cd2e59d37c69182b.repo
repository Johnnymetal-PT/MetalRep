byte-a620i-ax-am5-mitx-2xddr5.jpg"],"wholesale_price":133.93}}},"6927433603377":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6927433603377",false],"wholesale_price":[695.29,false],"price":[712.2558,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185041","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/f7c74a189a61753e62d8d64228cea7ca.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CM9058251","unit_price":712.2557999999999,"category":"V\u00eddeo","brand":"MAXHUB","name_pt":"CAMARA PTZ MAXHUB UC P25","quantity":0,"ean13":"6927433603377","description_short_pt":"C\u00e1mara 4K UHD PTZ, 8MP, Sony 1\/2.5\" CMOS, 12X optical zoom,  16X digital zoom, USB, HDMI, BNC, Gigabit Ethernet","description_pt":"Las reuniones nunca han sido tan buenasIm\u00e1genes premiumLa inigualable tecnolog\u00eda de im\u00e1genes UHD ofrece una imagen de v\u00eddeo sensacional y vibrante para cada reuni\u00f3n. La c\u00e1mara UC P25 8MP destaca a cada miembro de su reuni\u00f3n con detalles n\u00edtidos. Con un zoom 192x, puede preservar la claridad de imagen sin importar cu\u00e1ntas personas participen en la conversaci\u00f3n.Claridad completa en cualquier lugarIlumine las posibilidades con tecnolog\u00eda inteligente MAXHUB de lux baja. Los algoritmos de \u00faltima generaci\u00f3n mantienen el color y los detalles en condiciones de iluminaci\u00f3n reducida para mejorar el enfoque. WDR y una SNR alta neutralizan el brillo y las sombras, creando una imagen equilibrada en condiciones de iluminaci\u00f3n complejas.Inteligente, adaptativo y vers\u00e1tilSilencioso y extremadamente suave, el sistema PTZ adaptativo dentro de la UC P25 captura v\u00eddeo de forma r\u00e1pida y precisa para una reuni\u00f3n sin distracciones. Un sensacional campo de visi\u00f3n diagonal de 82,8 mantiene a todos los miembros del equipo a la vista, mientras que un sensor de gravedad integrado ajusta autom\u00e1ticamente la c\u00e1mara para que coincida con su elecci\u00f3n de montaje.La vista perfecta siempreAdapte su reuni\u00f3n para que se adec\u00fae a sus necesidades. La funcionalidad de mando a distancia implica que puede ajustar su enfoque en segundos con solo tocar un bot\u00f3n. El UC P25 puede integrarse con una serie de protocolos comunes, combin\u00e1ndose perfectamente con su espacio de conferencias.F\u00e1cil de controlar:Control remoto a trav\u00e9s del mando a distancia IR, navegador web, software, controlador serie y control UVCFlexible de integrar:Soportar varios tipos de integraci\u00f3n mediante un protocolo com\u00fan: VISCA, PELCO, UVC y ONVIFSimplicidad Conectar y listo (Plug-and-Play)Calidad suprema simplificada. Las conferencias de alta calidad no deber\u00edan ser complicadas. El UC P25 trabaja con todas las principales plataformas UC, con compatibilidad USB. Tambi\u00e9n puede conectarse a trav\u00e9s de puertos HDMI y LAN, de manera que est\u00e9 preparado para cualquier tipo de reuni\u00f3n.Una cable para todoEl UC P25 exige un \u00fanico cable para la instalaci\u00f3n, reduciendo el TCO y el tiempo de instalaci\u00f3n. Una soluci\u00f3n PoE integrada le asegura que pueda configurar su sala de reuniones en cuesti\u00f3n de segundos.Tranquilidad premiumNo se pierda nunca una reuni\u00f3n crucial El potente UC P25 inlcuye una garant\u00eda de intercambio en caliente de 3 a\u00f1os, la primera en la industria, para una tranquilidad absoluta. Con una calidad fenomenal y una garant\u00eda fant\u00e1stica, puede mantener una reuni\u00f3n con tranquilidad.","images":"https:\/\/www.dmi.es\/photo\/5744\/98565\/75732593\/bg\/camara-ptz-maxhub-uc-p25.jpg","wholesale_price":"695.29","unit_price_tax":712.2557999999999},"product_model":{"product_data":{"ean13":["6927433603377"],"reference":"CM9058251","name":{"1":"CAMARA PTZ MAXHUB UC P25","2":"","3":"","4":""},"description":{"1":"Las reuniones nunca han sido tan buenasIm\u00e1genes premiumLa inigualable tecnolog\u00eda de im\u00e1genes UHD ofrece una imagen de v\u00eddeo sensacional y vibrante para cada reuni\u00f3n. La c\u00e1mara UC P25 8MP destaca a cada miembro de su reuni\u00f3n con detalles n\u00edtidos. Con un zoom 192x, puede preservar la claridad de imagen sin importar cu\u00e1ntas personas participen en la conversaci\u00f3n.Claridad completa en cualquier lugarIlumine las posibilidades con tecnolog\u00eda inteligente MAXHUB de lux baja. Los algoritmos de \u00faltima generaci\u00f3n mantienen el color y los detalles en condiciones de iluminaci\u00f3n reducida para mejorar el enfoque. WDR y una SNR alta neutralizan el brillo y las sombras, creando una imagen equilibrada en condiciones de iluminaci\u00f3n complejas.Inteligente, adaptativo y vers\u00e1tilSilencioso y extremadamente suave, el sistema PTZ adaptativo dentro de la UC P25 captura v\u00eddeo de forma r\u00e1pida y precisa para una reuni\u00f3n sin distracciones. Un sensacional campo de visi\u00f3n diagonal de 82,8 mantiene a todos los miembros del equipo a la vista, mientras que un sensor de gravedad integrado ajusta autom\u00e1ticamente la c\u00e1mara para que coincida con su elecci\u00f3n de montaje.La vista perfecta siempreAdapte su reuni\u00f3n para que se adec\u00fae a sus necesidades. La funcionalidad de mando a distancia implica que puede ajustar su enfoque en segundos con solo tocar un bot\u00f3n. El UC P25 puede integrarse con una serie de protocolos comunes, combin\u00e1ndose perfectamente con su espacio de conferencias.F\u00e1cil de controlar:Control remoto a trav\u00e9s del mando a distancia IR, navegador web, software, controlador serie y control UVCFlexible de integrar:Soportar varios tipos de integraci\u00f3n mediante un protocolo com\u00fan: VISCA, PELCO, UVC y ONVIFSimplicidad Conectar y listo (Plug-and-Play)Calidad suprema simplificada. Las conferencias de alta calidad no deber\u00edan ser complicadas. El UC P25 trabaja con todas las principales plataformas UC, con compatibilidad USB. Tambi\u00e9n puede conectarse a trav\u00e9s de puertos HDMI y LAN, de manera que est\u00e9 preparado para cualquier tipo de reuni\u00f3n.Una cable para todoEl UC P25 exige un \u00fanico cable para la instalaci\u00f3n, reduciendo el TCO y el tiempo de instalaci\u00f3n. Una soluci\u00f3n PoE integrada le asegura que pueda configurar su sala de reuniones en cuesti\u00f3n de segundos.Tranquilidad premiumNo se pierda nunca una reuni\u00f3n crucial El potente UC P25 inlcuye una garant\u00eda de intercambio en caliente de 3 a\u00f1os, la primera en la industria, para una tranquilidad absoluta. Con una calidad fenomenal y una garant\u00eda fant\u00e1stica, puede mantener una reuni\u00f3n con tranquilidad.","2":"","3":"","4":""},"description_short":{"1":"C\u00e1mara 4K UHD PTZ, 8MP, Sony 1\/2.5\" CMOS, 12X optical zoom,  16X digital zoom, USB, HDMI, BNC, Gigabit Ethernet","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"MAXHUB","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":712.2558,"unit_price_tax":712.2558,"tax_rules_group":null,"category":"V\u00eddeo","brand":"MAXHUB","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/5744\/98565\/75732593\/bg\/camara-ptz-maxhub-uc-p25.jpg"],"wholesale_price":695.29}}},"6927433603902":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6927433603902",false],"wholesale_price":[498.51,false],"price":[511.5402,false],"id_tax_rules_group