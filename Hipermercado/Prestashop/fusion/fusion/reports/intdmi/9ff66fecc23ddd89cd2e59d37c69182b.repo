5076\/bg\/caja-natec-cabassu-g2-midi-torre-atx-lector-tarjetas-2usb3-0-2usb2-0-sin-fuente.jpg","wholesale_price":"26.68","unit_price_tax":30.2736},"product_model":{"product_data":{"ean13":["5901969438918"],"reference":"CJ11415754","name":{"1":"CAJA NATEC CABASSU G2 MIDI TORRE ATX LECTOR TARJETAS 2USB3.0 2USB2.0 SIN FUENTE","2":"","3":"","4":""},"description":{"1":"NATEC Cabassu G2. Factor de forma: Midi Tower, Tipo: PC, Color del producto: Negro. Ventiladores frontales instalados: 1x 80 mm, Di\u00e1metro de ventiladores frontales soportados: 120 mm, Ventiladores laterales instalados: 1x 120 mm. Tama\u00f1os de disco duro soportados: 2.5,3.5\". Ancho: 197 mm, Profundidad: 403 mm, Altura: 414 mm","2":"","3":"","4":""},"description_short":{"1":"NATEC Cabassu G2, Midi Tower, PC, Negro, ATX, micro ATX, Mini-ITX, ABS, Malla, Metal, Pl\u00e1stico, 16 cm","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NATEC","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":30.2736,"unit_price_tax":30.2736,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"NATEC","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/237\/100601\/80595076\/bg\/caja-natec-cabassu-g2-midi-torre-atx-lector-tarjetas-2usb3-0-2usb2-0-sin-fuente.jpg"],"wholesale_price":26.68}}},"4044951039098":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4044951039098",false],"wholesale_price":[51.55,false],"price":[55.641,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:189330","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/08bdc48fb7acc4fbe1952ee539b38807.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CJ11312746","unit_price":55.641,"category":"Cajas y fuentes","brand":"Sharkoon","name_pt":"CAJA SHARKOON ATX MIDI VS8 RGB BLANCA","quantity":0,"ean13":"4044951039098","description_short_pt":"Mini-ITX\/Micro-ATX\/ATX, 2x3.5\", 6x2.5\", 2xUSB3.0, 1xUSB3.2 TIPO C, 423 x 205 x 485 mm, 3 ventiladores incluidos (1 ARGB), 6.3 Kg","description_pt":"Todo aquel que desee mostrar un buen rendimiento, ya sea en pantalla o dentro de la caja, encontrar\u00e1 la caja ATX MIDI ideal con la VS8 RGB. A pesar de sus dimensiones compactas, esta caja de PC es compatible con hardware de alto rendimiento gracias a su generoso interior y a un espacio de instalaci\u00f3n para un total de seis ventiladores o dos radiadores a la vez. Adem\u00e1s, gracias a un interior inteligentemente dise\u00f1ado, tambi\u00e9n hay espacio para tarjetas gr\u00e1ficas m\u00e1s grandes, refrigeradores de CPU y fuentes de alimentaci\u00f3n. Por otro lado, hay espacio para hasta seis SSD de 2,5 pulgadas, con el fin de contar con un almacenamiento de miles de gigabites.Opciones para una refrigeraci\u00f3n inteligente: por aire o por aguaYa hay preinstalados dos ventiladores de 120 mm tras el panel frontal. En el panel posterior hay otro ventilador preinstalado de 120 mm con LED RGB direccionables que disipa el calor a trav\u00e9s de la parte posterior de la caja. Se puede instalar otro ventilador de 120 mm tras el panel frontal, y bajo el panel superior hay espacio para instalar otros dos ventiladores de 120 mm o 140 mm. Otra opci\u00f3n permite el uso de dos radiadores en la VS8 RGB: un radiador de 360 mm tendr\u00e1 cabida en la parte frontal de la caja, mientras, al mismo tiempo, se puede instalar un radiador de 280 mm bajo el panel superior.Un dise\u00f1o enfocado en el hardwareGracias a un panel frontal con un dise\u00f1o sencillo y elegante y a un panel lateral fabricado en cristal templado, la VS8 RGB centra la atenci\u00f3n en el hardware montado. Gracias al controlador RGB, el ventilador LED RGB preinstalado y un componente LED adicional pueden iluminarse con el software de la placa base. O bien se puede controlar la iluminaci\u00f3n de manera manual con 14 efectos de iluminaci\u00f3n.Mucho espacio para componentes grandesA pesar de sus dimensiones compactas de 42,3 x 20,5 x 48,5 cm, esta caja de PC tiene espacio para elementos de hardware de gran tama\u00f1o. La tarjeta gr\u00e1fica puede, por ejemplo, medir hasta 35 cm de largo y el refrigerador de CPU puede tener hasta 15,8 cm de alto. Tambi\u00e9n hay espacio para una fuente de alimentaci\u00f3n de hasta 21 cm de alto. Todos los componentes de hardware estar\u00e1n totalmente protegidos gracias a tres filtros de polvo, situados en los paneles frontal, superior y posterior. Todos los filtros se pueden retirar f\u00e1cilmente para su limpieza cuando sea necesario.Opciones modulares para discos duros y SSDSe pueden instalar hasta dos HDD de 3,5 pulgadas y hasta cuatro SSD de 2,5 pulgadas en el interior de la VS8 RGB. Hay disponibles varias opciones de montaje para los discos duros y los SSD, ya sea detr\u00e1s de la bandeja de la placa base, en el t\u00fanel para fuente de alimentaci\u00f3n o en la caja para HDD\/SSD integrada.Opciones modernas de conexi\u00f3n por encima de todoEn lo que a conectividad se refiere, la VS8 RGB est\u00e1 equipada con dos puertos USB-A 3.0 con f\u00e1cil acceso desde la parte superior de la caja. Cerca de estos, tambi\u00e9n hay un puerto USB-C para transferencias de datos megarr\u00e1pidas. Por otro lado, la caja cuenta con puertos de audio para micr\u00f3fono y cascos, o para auriculares.","images":"https:\/\/www.dmi.es\/photo\/237\/99883\/79752685\/bg\/caja-sharkoon-atx-midi-vs8-rgb-blanca.jpg","wholesale_price":"51.55","unit_price_tax":55.641},"product_model":{"product_data":{"ean13":["4044951039098"],"reference":"CJ11312746","name":{"1":"CAJA SHARKOON ATX MIDI VS8 RGB BLANCA","2":"","3":"","4":""},"description":{"1":"Todo aquel que desee mostrar un buen rendimiento, ya sea en pantalla o dentro de la caja, encontrar\u00e1 la caja ATX MIDI ideal con la VS8 RGB. A pesar de sus dimensiones compactas, esta caja de PC es compatible con hardware de alto rendimiento gracias a su generoso interior y a un espacio de instalaci\u00f3n para un total de seis ventiladores o dos radiadores a la vez. Adem\u00e1s, gracias a un interior inteligentemente dise\u00f1ado, tambi\u00e9n hay espacio para tarjetas gr\u00e1ficas m\u00e1s grandes, refrigeradores de CPU y fuentes de alimentaci\u00f3n. Por otro lado, hay espacio para hasta seis SSD de 2,5 pulgadas, con el fin de contar con un almacenamiento de miles de gigabites.Opciones para una refrigeraci\u00f3n inteligente: por aire o por aguaYa hay preinstalados dos ventiladores de 120 mm tras el panel frontal. En el panel posterior hay otro ventilador preinstalado de 120 mm con LED RGB direccionables que disipa el calor a trav\u00e9s de la parte posterior de la caja. Se puede instalar otro ventilador de 120 mm tras el panel frontal, y bajo el panel superior hay espacio para instalar otros dos ventiladores de 120 mm o 140 mm. Otra opci\u00f3n permite el uso de dos radiadores en la VS8 RGB: un radiador de 360 mm tendr\u00e1 cabida en la parte frontal de la caja, mientras, al mismo tiempo, se puede instalar un radiador de 280 mm bajo el panel superior.Un dise\u00f1o enfocado en el hardwareGracias a un panel frontal con un dise\u00f1o sencillo y elegante y a un panel lateral fabricado en cristal templado, la VS8 RGB centra la atenci\u00f3n en el hardware montado. Gracias al controlador RGB, el ventilador LED RGB preinstalado y un componente LED adicional pueden iluminarse con el software de la placa base. O bien se puede controlar la iluminaci\u00f3n de man