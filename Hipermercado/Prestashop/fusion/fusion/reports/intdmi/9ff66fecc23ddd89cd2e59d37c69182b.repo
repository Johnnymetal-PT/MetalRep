M. Fabricante de procesador: AMD, Socket de procesador: Z\u00f3calo AM5, Procesador compatible: AMD Ryzen 7 7th Gen, AMD Ryzen 9 7th Gen. tipos de memoria compatibles: DDR5-SDRAM, Memoria interna m\u00e1xima: 128 GB, Tipo de ranuras de memoria: DIMM. Interfaces de disco de almacenamiento soportados: M.2, SATA III, Tipos de unidades de almacenamiento admitidas: HDD & SSD, Niveles RAID: 0, 1, 10. M\u00e1xima resoluci\u00f3n: 7680 x 4320 Pixeles. Tipo de interfaz ethernet: 2.5 Gigabit Ethernet, Ethernet r\u00e1pido, Gigabit Ethernet","images":"https:\/\/www.dmi.es\/photo\/164\/103852\/69506369\/bg\/placa-base-asus-prime-x670-p-csm-am5-atx-4xddr5.jpg","wholesale_price":"181.72","unit_price_tax":188.4144},"product_model":{"product_data":{"ean13":["4711081892847"],"reference":"PB11106540","name":{"1":"PLACA BASE ASUS PRIME X670-P-CSM AM5 ATX 4XDDR5","2":"","3":"","4":""},"description":{"1":"ASUS PRIME X670-P-CSM. Fabricante de procesador: AMD, Socket de procesador: Z\u00f3calo AM5, Procesador compatible: AMD Ryzen 7 7th Gen, AMD Ryzen 9 7th Gen. tipos de memoria compatibles: DDR5-SDRAM, Memoria interna m\u00e1xima: 128 GB, Tipo de ranuras de memoria: DIMM. Interfaces de disco de almacenamiento soportados: M.2, SATA III, Tipos de unidades de almacenamiento admitidas: HDD & SSD, Niveles RAID: 0, 1, 10. M\u00e1xima resoluci\u00f3n: 7680 x 4320 Pixeles. Tipo de interfaz ethernet: 2.5 Gigabit Ethernet, Ethernet r\u00e1pido, Gigabit Ethernet","2":"","3":"","4":""},"description_short":{"1":"ASUS PRIME X670-P-CSM, AMD, Z\u00f3calo AM5, AMD Ryzen 7 7th Gen, AMD Ryzen 9 7th Gen, Z\u00f3calo AM5, DDR5-SDRAM, 128 GB","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ASUS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":188.4144,"unit_price_tax":188.4144,"ta