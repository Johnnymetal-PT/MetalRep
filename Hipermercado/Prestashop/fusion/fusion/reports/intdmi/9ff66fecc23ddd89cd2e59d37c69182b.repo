e llover para que puedas programar una salida en bicicleta. Adem\u00e1s, si planificas tus recorridos en sitios como Strava Summit, Komoot o Wikiloc, puedes descargar estas aplicaciones para importar tus rutas favoritas directamente a tu Edge. Si buscas una cafeter\u00eda o tienda de ciclismo cercanas, utiliza la aplicaci\u00f3n Yelp para descargar la ubicaci\u00f3n y la ruta directa hasta ellas en tu dispositivo Edge.","2":"","3":"","4":""},"description_short":{"1":"3.0\", 240 x 400 pix, TouchScreen, 16 GB, GPS, Aceler\u00f3metro, negro\/blanco","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Garmin","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":143.9118,"unit_price_tax":143.9118,"tax_rules_group":null,"category":"Equipos de navegaci\u00f3n","brand":"Garmin","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/910\/85524\/60761045\/bg\/gps-garmin-edge-explore.jpg"],"wholesale_price":138.09}}},"5901969436631":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["5901969436631",false],"wholesale_price":[8.2,false],"price":[11.424,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:186198","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cb749fe6eca6c6774b7408aff43622fb.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PE21415253","unit_price":11.424,"category":"Perif\u00e9ricos","brand":"NATEC","name_pt