duct weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:188098","Cat. IDs: 50","Associated Categories","Cat. Default: 50","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/0312083ace14150fa75e16cbf205841b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CP11330047","unit_price":30.6,"category":"Cuidado personal","brand":"Cecotec","name_pt":"PLANCHA DE PELO INALAMBRICO BAMBA RITUALCARE LIBERTY","quantity":0,"ean13":"8435484034609","description_short_pt":"180 \u00baC, Cer\u00e1mica, 2600 mAh","description_pt":"La libertad es inal\u00e1mbrica.Podr\u00e1s llevarte tu plancha Liberty all\u00e1 donde quieras y utilizarla de manera inal\u00e1mbrica gracias a sus 30 minutos de autonom\u00eda.Respetuosa con tu cabello.El suministro de temperatura constante y homog\u00e9nea a 180 \u00baC favorece el cuidado de tu cabello y deja tu pelo perfecto.Melena perfecta y cuidada.Las placas de la plancha disponen de un revestimiento de cer\u00e1mica que proporciona un calor uniforme y r\u00e1pido sobre el cabello, disminuyendo el da\u00f1o en cada pasada.Bater\u00eda recargable.Con su bater\u00eda recargable de 2600 mAh, podr\u00e1s disfrutar de una gran libertad de movimientos y usar la plancha sin ninguna complicaci\u00f3n.No te preocupes por nada.La plancha dispone de un bloqueo de placas que te aportar\u00e1 una mayor seguridad a la hora de guardar la plancha despu\u00e9s de su uso. Adem\u00e1s, podr\u00e1s colocar la protecci\u00f3n del cable de carga y as\u00ed guardar la plancha en tu bolso sin complicaciones.Peinado listo sin esperas.EL r\u00e1pido calentamiento de la plancha te permitir\u00e1 usarla cuando quieras sin tener que esperar para que est\u00e9 lista.","images":"https:\/\/www.dmi.es\/photo\/1414\/105477\/89696187\/bg\/plancha-de-pelo-inalambrico-bamba-ritualcare-liberty.jpg","wholesale_price":"27.00","unit_price_tax":30.6},"product_model":{"product_data":{"ean13":["8435484034609"],"reference":"CP11330047","name":{"1":"PLANCHA DE PELO INALAMBRICO BAMBA RITUALCARE LIBERTY","2":"","3":"","4":""},"description":{"1":"La libertad es inal\u00e1mbrica.Podr\u00e1s llevarte tu plancha Liberty all\u00e1 donde quieras y utilizarla de manera inal\u00e1mbrica gracias a sus 30 minutos de autonom\u00eda.Respetuosa con tu cabello.El suministro de temperatura constante y homog\u00e9nea a 180 \u00baC favorece el cuidado de tu cabello y deja tu pelo perfecto.Melena perfecta y cuidada.Las placas de la plancha disponen de un revestimiento de cer\u00e1mica que proporciona un calor uniforme y r\u00e1pido sobre el cabello, disminuyendo el da\u00f1o en cada pasada.Bater\u00eda recargable.Con su bater\u00eda recargable de 2600 mAh, podr\u00e1s disfrutar de una gran libertad de movimientos y usar la plancha sin ninguna complicaci\u00f3n.No te preocupes por nada.La plancha dispone de un bloqueo de placas que te aportar\u00e1 una mayor seguridad a la hora de guardar la plancha despu\u00e9s de su uso. Adem\u00e1s, podr\u00e1s colocar la protecci\u00f3n del cable de carga y as\u00ed guardar la plancha en tu bolso sin complicaciones.Peinado listo sin esperas.EL r\u00e1pido calentamiento de la plancha te permitir\u00e1 usarla cuando quieras sin tener que esperar para que est\u00e9 lista.","2":"","3":"","4":""},"description_short":{"1":"180 \u00baC, Cer\u00e1mica, 2600 mAh","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":30.6,"unit_price_tax":30.6,"tax_rules_group":null,"category":"Cuidado personal","brand":"Cecotec",