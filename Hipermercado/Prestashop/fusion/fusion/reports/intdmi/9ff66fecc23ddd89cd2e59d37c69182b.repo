home\/hipermercado\/public_html\/img\/tmp\/df79c8ba11ad97383654fc4a395adf0a.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PC13230271","unit_price":399.0648,"category":"PCs Sobremesa","brand":"Leotec","name_pt":"LEOTEC MINI PC INTEL I5-1235U+16GB DDR4+512GB SSD NEGRO","quantity":0,"ean13":"8436588882677","description_short_pt":"LEOTEC Mini PC GYORS i5 16GB 512GB","description_pt":"TU ORDENADOR PERSONALTanto si lo que est\u00e1s buscando es ordenador personal para iniciarte en el mundo de la inform\u00e1tica como si eres un estudiante y buscas un equipo que puedas transportar de forma r\u00e1pida y sencilla sin renunciar a todo el potencial que te ofrece la \u00faltima tecnolog\u00eda de Intel en cuanto a procesadores, el nuevo Gyors de Leotec se antoja una soluci\u00f3n ideal para todos gracias a sus reducidas dimensiones y peso. Un miniPC que en su interior opta por incorporar uno de los procesadores m\u00e1s potentes del mercado fabricado por Intel, un i5 de 12\u00aa generaci\u00f3n que viene acompa\u00f1ado por un m\u00f3dulo de 16GB de memoria RAM (ampliable hasta 32GB m\u00e1ximo) que te permitir\u00e1n ejecutar cualquier tipo de aplicaci\u00f3n de forma inmediata. Un dispositivo que adem\u00e1s cuenta con una gran capacidad de almacenamiento interno por medio de un  M.2 SSD SATA de 512GB en el que podr\u00e1s almacenar tus fotograf\u00edas favoritas, pel\u00edculas y series y reproducirlas f\u00e1cilmente all\u00e1 donde lo lleves.Tu centro multimedia perfecto. Un producto fant\u00e1stico para disfrutar en alta resoluci\u00f3n de tus pel\u00edculas y series favoritas con la mejor resoluci\u00f3n del mercado gracias a su salida 4K HDMI 2.0 y a su salida de audio para auriculares\/altavoces.PEQUE\u00d1O Y POTENTECon unas dimensiones de tan s\u00f3lo 125 x 125 x 45 mm, el nuevo miniPC Gyors de Leotec cuenta con 2 salidas HDMI 2.0 as\u00ed como salida VGA para conectar hasta 3 monitores al mismo tiempo y as\u00ed ampliar las posibilidades de trabajo, 4 puertos USB 3.0 de alta velocidad y tecnolog\u00eda inal\u00e1mbrica Bluetooth para que puedas conectarle un teclado, gamepad o rat\u00f3n sin cables de forma r\u00e1pida y segura.Con\u00e9ctalo a la red por medio del puerto Gigalan o bien de forma inal\u00e1mbrica WiFi para navegar a toda velocidad, descargar archivos en segundos, etc.Asi mismo, podr\u00e1s ponerlo detr\u00e1s del monitor dado que es VESA compatible, cuenta con sistema de seguridad Kensington y viene con el sistema operativo Microsoft Windows 11 Pro instalado de f\u00e1brica y en espa\u00f1ol (requiere de una clave de licencia v\u00e1lida para su funcionamiento ? no incluida -).Un ordenador personal \u00fanico con posibilidades multimedia infinitas y una gran capacidad de almacenamiento y procesamiento que te permitir\u00e1 exprimir al m\u00e1ximo cualquier programa que le instales y disfrutar de una experiencia sin igual.Descubre todo el potencial del nuevo miniPC Leotec Gyors. Producto a la venta en tiendas especializadas, grandes superficies y tiendas online de Espa\u00f1a con garant\u00eda de 3 a\u00f1os.CPUIntel\u00ae 12th Gen i5-1235U3.4GhzRAM16GB DDR4 (1 slot libre)HDD\/SSDM.2 SATA 512GBGPUIntel\u00ae Iris\u00ae Plus GraphicsWiFiS\u00edLANGigabit LANHDMI2 puertos 2.0VGA1 puertoUSB 3.04 puertosBluetoothS\u00edMicroSD1 puertoCierre KensingtonS\u00edPuerto Type CS\u00edMicr\u00f3fono1 x 3.5 mmSalida sonidoS\u00edInput100-240V ACOutput19V3.42A DCTama\u00f1o125 x 125 x 45 mmChasisPl\u00e1sticoVESA70x70 \/ 100x100Sistema OperativoWindows 11 pre-instalado (requiere de una licencia v\u00e1lida - no incluida)","images":"https:\/\/www.dmi.es\/photo\/1062\/105024\/86226971\/bg\/leotec-mini-pc-intel-i5-1235u+16gb-ddr4+512gb-ssd-negro.jpg","wholesale_price":"388.24","unit_price_tax":399.0648},"product_model":{"product_data":{"ean13":["8436588882677"],"reference":"PC13230271","name":{"1":"LEOTEC MINI PC INTEL I5-1235U+16GB DDR4+512GB SSD NEGRO","2":"","3":"","4":""},"description":{"1":"TU ORDENADOR PERSONALTanto si lo que est\u00e1s buscando es ordenador personal para iniciarte en el mundo de la inform\u00e1tica como si eres un estudiante y buscas un equipo que puedas transportar de forma r\u00e1pida y sencilla sin renunciar a todo el potencial que te ofrece la \u00faltima tecnolog\u00eda de Intel en cuanto a procesadores, el nuevo Gyors de Leotec se antoja una soluci\u00f3n ideal para todos gracias a sus reducidas dimensiones y peso. Un miniPC que en su interior opta por incorporar uno de los procesadores m\u00e1s potentes del mercado fabricado por Intel, un i5 de 12\u00aa generaci\u00f3n que viene acompa\u00f1ado por un m\u00f3dulo de 16GB de memoria RAM (ampliable hasta 32GB m\u00e1ximo) que te permitir\u00e1n ejecutar cualquier tipo de aplicaci\u00f3n de forma inmediata. Un dispositivo que adem\u00e1s cuenta con una gran capacidad de almacenamiento interno por medio de un  M.2 SSD SATA de 512GB en el que podr\u00e1s almacenar tus fotograf\u00edas favoritas, pel\u00edculas y series y reproducirlas f\u00e1cilmente all\u00e1 donde lo lleves.Tu centro multimedia perfecto. Un producto fant\u00e1stico para disfrutar en alta resoluci\u00f3n de tus pel\u00edculas y series favoritas con la mejor resoluci\u00f3n del mercado gracias a su salida 4K HDMI 2.0 y a su salida de audio para auriculares\/altavoces.PEQUE\u00d1O Y POTENTECon unas dimensiones de tan s\u00f3lo 125 x 125 x 45 mm, el nuevo miniPC Gyors de Leotec cuenta con 2 salidas HDMI 2.0 as\u00ed como salida VGA para conectar hasta 3 monitores al mismo tiempo y as\u00ed ampliar las posibilidades de trabajo, 4 puertos USB 3.0 de alta velocidad y tecnolog\u00eda inal\u00e1mbrica Bluetooth para que puedas conectarle un teclado, gamepad o rat\u00f3n sin cables de forma r\u00e1pida y segura.Con\u00e9ctalo a la red por medio del puerto Gigalan o bien de forma inal\u00e1mbrica WiFi para navegar a toda velocidad, descargar archivos en segundos, etc.Asi mismo, podr\u00e1s ponerlo detr\u00e1s del monitor dado que es VESA compatible, cuenta con sistema de seguridad Kensington y viene con el sistema operativo Microsoft Windows 11 Pro instalado de f\u00e1brica y en espa\u00f1ol (requiere de una clave de licencia v\u00e1lida para su funcionamiento ? no incluida -).Un ordenador personal \u00fanico con posibilidades multimedia infinitas y una gran capacidad de almacenamiento y procesamiento que te permitir\u00e1 exprimir al m\u00e1ximo cualquier programa que le instales y disfrutar de una experiencia sin igual.Descubre todo el potencial del nuevo miniPC Leotec Gyors. Producto a la venta en tiendas especializadas, grandes superficies y tiendas online de Espa\u00f1a con garant\u00eda de 3 a\u00f1os.CPUIntel\u00ae 12th Gen i5-1235U3.4GhzRAM16GB DDR4 (1 slot libre)HDD\/SSDM.2 SATA 512GBGPUIntel\u00ae Iris\u00ae Plus GraphicsWiFiS\u00edLANGigabit LANHDMI2 puertos 2.0VGA1 puertoUSB 3.04 puertosBluetoothS\u00edMicroSD1 puertoCierre KensingtonS\u00edPuerto Type CS\u00edMicr\u00f3fono1 x 3.5 mmSalida sonidoS\u00edInput100-240V ACOutput19V3.42A DCTama\u00f1o125 x 125 x 45 mmChasisPl\u00e1sticoVESA70x70 \/ 100x100Sistema OperativoWindows 11 pre-instalado (requiere de una licencia v\u00e1lida - no incluida)","2":"","3":"","4":""},"description_short":{"1":"LEOTEC Mini PC GYORS i5 16GB 512GB","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Leotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":399.0648,"unit_price_tax":399.0648,"tax_rules_group":null,"category":"PCs Sobremesa","brand":"Leotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1062\/105024\/86226971\/bg\/leotec-mini-pc-intel-i5-1235u+16gb-ddr4+512gb-ssd-negro.jpg"],"wholesale_price":388.24}}},"4719331855680":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"e