th":null,"height":null,"depth":null,"weight":null,"unit_price":77.4996,"unit_price_tax":77.4996,"tax_rules_group":null,"category":"Peque\u00f1os electrodom\u00e9sticos","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1175\/96177\/52767843\/bg\/ventilador-tripode-cecotec-energysilence-1600-woody-smart.jpg"],"wholesale_price":72.98}}},"8436587974533":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587974533",false],"wholesale_price":[133.81,false],"price":[139.5462,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187774","Cat. IDs: 190","Associated Categories","Cat. Default: 190","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/ffc7d00c5421595d153f4fe7f1f04e3b.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"FA11356033","unit_price":139.5462,"category":"Cajas y fuentes","brand":"NOX","name_pt":"NOX HUMMER P1000W Fuente PCIE 5.0 ATX 3.0 Platinum","quantity":5,"ean13":"8436587974533","description_short_pt":"80 Plus Platinum, 1000W, ATX 3.0, PCIE 5.0, 140mm, 100 - 240V, 50\/60Hz, 8 - 15A, Negro, 2.25kg","description_pt":"HUMMER P 1000WNox Hummer P 1000W Platinum Edition es una fuente que ha sido creada para aquellas configuraciones de alto rendimiento equipadas con las nuevas generaciones de tarjetas gr\u00e1ficas. Con Certificaci\u00f3n 80 Plus Platinum, esta fuente de alimentaci\u00f3n completamente modular cuenta con un ultrasilencioso ventilador de 140 mm que incorpora un controlador de velocidad.CERTIFICACI\u00d3N 80 PLUS PLATINUMLa fuente de alimentaci\u00f3n Nox Hummer P 1000W Platinum Edition es una fuente dise\u00f1ada para tarjetas gr\u00e1ficas de gran consumo. Cuenta con condensadores electrol\u00edticos taiwaneses de alta gama, unos componentes de alta calidad que permiten una potencia real con voltaje estable y fiabilidad en el tiempo. Traduci\u00e9ndose esto una menor resistencia al paso de corriente y por lo tanto un menor calentamiento del equipo.Construida en materiales premium, Nox Hummer P 1000W Platinum cuenta con Certificaci\u00f3n 80 Plus Platinum, que garantiza una eficiencia m\u00ednima del 90 %, siendo el m\u00e1ximo el 94% cuando la carga se encuentra al 50 por ciento, ayudando a reducir el consumo energ\u00e9tico, contribuyendo de esta forma al ahorro.PREPARADA PARA EL FUTURONox Hummer P 1000W es una unidad de alimentaci\u00f3n ATX 3.0 compatible con la plataforma PCIe Gen 5 de \u00faltima generaci\u00f3n. Esto hace que esta fuente de alimentaci\u00f3n sea extremadamente vers\u00e1til y la opci\u00f3n ideal para las configuraciones de alta gama.POTENCIA ULTRASILENCIOSAEsta fuente de 1000 vatios completamente modular presenta un gran control del voltaje y un funcionamiento ultrasilencioso. Nox Hummer P 1000W incluye un potente ventilador de 140 mm de baja sonoridad, que reduce de manera eficiente el calor, garantizando un rendimiento excelente.El ventilador que integra esta fuente de alimentaci\u00f3n incorpora un controlador de velocidad, para que puedas regular de manera \u00f3ptima la temperatura que mejor se adapta a tu equipo.COMPLETAMENTE MODULARNox Hummer P 1000W Platinum Edition ha sido dise\u00f1ada para montajes r\u00e1pidos y limpios en equipos de alto rendimiento. Su cableado es totalmente modular, facilitando el ensamblaje y brindando una apropiada gesti\u00f3n del interior del chasis, manteniendo el equipo la temperatura adecuada, favoreciendo el flujo de aire.Se trata, adem\u00e1s, de una fuente para PC con protecciones OVP, SCP, OPP y UVP que garantizan un funcionamiento seguro en diferentes circunstancias.","images":"https:\/\/www.dmi.es\/photo\/963\/103118\/84962868\/bg\/nox-hummer-p1000w-fuente-pcie-5-0-atx-3-0-platinum.jpg","wholesale_price":"133.81","unit_price_tax":139.5462},"product_model":{"product_data":{"ean13":["8436587974533"],"reference":"FA11356033","name":{"1":"NOX HUMMER P1000W Fuente PCIE 5.0 ATX 3.0 Platinum","2":"","3":"","4":""},"description":{"1":"HUMMER P 1000WNox Hummer P 1000W Platinum Edition es una fuente que ha sido creada para aquellas configuraciones de alto rendimiento equipadas con las nuevas generaciones de tarjetas gr\u00e1ficas. Con Certificaci\u00f3n 80 Plus Platinum, esta fuente de alimentaci\u00f3n completamente modular cuenta con un ultrasilencioso ventilador de 140 mm que incorpora un controlador de velocidad.CERTIFICACI\u00d3N 80 PLUS PLATINUMLa fuente de alimentaci\u00f3n Nox Hummer P 1000W Platinum Edition es una fuente dise\u00f1ada para tarjetas gr\u00e1ficas de gran consumo. Cuenta con condensadores electrol\u00edticos taiwaneses de alta gama, unos componentes de alta calidad que permiten una potencia real con voltaje estable y fiabilidad en el tiempo. Traduci\u00e9ndose esto una menor resistencia al paso de corriente y por lo tanto un menor calentamiento del equipo.Construida en materiales premium, Nox Hummer P 1000W Platinum cuenta con Certificaci\u00f3n 80 Plus Platinum, que garantiza una eficiencia m\u00ednima del 90 %, siendo el m\u00e1ximo el 94% cuando la carga se encuentra al 50 por ciento, ayudando a reducir el consumo energ\u00e9tico, contribuyendo de esta forma al ahorro.PREPARADA PARA EL FUTURONox Hummer P 1000W es una unidad de alimentaci\u00f3n ATX 3.0 compatible con la plataforma PCIe Gen 5 de \u00faltima generaci\u00f3n. Esto hace que esta fuente de alimentaci\u00f3n sea extremadamente vers\u00e1til y la opci\u00f3n ideal para las configuraciones de alta gama.POTENCIA ULTRASILENCIOSAEsta fuente de 1000 vatios completamente modular presenta un gran control del voltaje y un funcionamiento ultrasilencioso. Nox Hummer P 1000W incluye un potente ventilador de 140 mm de baja sonoridad, que reduce de manera eficiente el calor, garantizando un rendimiento excelente.El ventilador que integra esta fuente de alimentaci\u00f3n incorpora un controlador de velocidad, para que puedas regular de manera \u00f3ptima la temperatura que mejor se adapta a tu equipo.COMPLETAMENTE MODULARNox Hummer P 1000W Platinum Edition ha sido dise\u00f1ada para montajes r\u00e1pidos y limpios en equipos de alto rendimiento. Su cableado es totalmente modular, facilitando el ensamblaje y brindando una apropiada gesti\u00f3n del interior del chasis, manteniendo el equipo la temperatura adecuada, favoreciendo el flujo de aire.Se trata, adem\u00e1s, de una fuente para PC con protecciones OVP, SCP, OPP y UVP que garantizan un funcionamiento seguro en diferentes circunstancias.","2":"","3":"","4":""},"description_short":{"1":"80 Plus Platinum, 1000W, ATX 3.0, PCIE 5.0, 140mm, 100 - 240V, 50\/60Hz, 8 - 15A, Negro, 2.25kg","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NOX","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":139.5462,"unit_price_tax":139.5462,"tax_rules_group":null,"category":"Cajas y fuentes","brand":"NOX","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/963\/103118\/84962868\/bg\/nox-hummer-p1000w-fuente-pcie-5-0-atx-3-0-platinum.jpg"],"wholesale_price":133.81}}},"8436587974489":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8436587974489",false],"wholesale_price":[25.13,false],"price":[28.6926,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187775","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/88f1c5c83c902ac5e6cac2723fc405e1.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA00355185","unit_price":28.6926,"category":"Perif\u00e9ricos","brand":"Krom","name_pt":"KROM KREATOR MINI TECLADO MEC\u00c1NICO RGB","quantity":0,"ean13":"8436587974489","description_short_pt":"USB Type-C, 64 teclas, RGB, Mec\u00e1nico (switches lubricados), Hot-Swap, 300 x 145 x 43mm, Negro, 660g","description_pt":"Krom Kreator es el teclado 60% que viene a revolucionar el mercado. Krom Kreator es un teclado gaming ultracompacto que incluye teclas de doble inyecci\u00f3n, que te permitir\u00e1 ganar espacio mientras te alzas con la victoria gracias a su formato 60%. Este mini teclado mec\u00e1nico con RGB incorpora switches mec\u00e1nicos lubricados, lo que hace que sus teclas se accionen de una manera m\u00e1s r\u00e1pida al tener menos rozamiento, mientras minimizas el ruido, haci\u00e9ndote ganar ventaja sobre tus enemigos.Dise\u00f1o mini, m\u00e1xima comodidadKrom Kreator es un teclado gamer que te permitir\u00e1 liberar espacio en tu escritorio o mesa gamer. Su compacto dise\u00f1o se traduce en comodidad garantizada, habiendo sido dise\u00f1ado para convertirse en tu support perfecto, ayud\u00e1ndote en cualquier desaf\u00edo que se te ponga por delante.Su tama\u00f1o lo hace el teclado mec\u00e1nico mini perfecto para jugar, aunque tambi\u00e9n para estudiar o trabajar, ya que, lo podr\u00e1s transportar f\u00e1cilmente de un lado a otro. Adem\u00e1s, con su cuidado dise\u00f1o se adapta a cualquier setup.Switches mec\u00e1nicos lubricadosEste teclado mini incluye switches mec\u00e1nicos lubricados, lo que supone una ventaja ya que es m\u00e1s silencioso y suaviza las sensaciones de fricci\u00f3n que se presentan en las partes internas como los switches y los estabilizadores, al tener menos rozamiento. Esto supone alargar la vida \u00fatil de los switches que incorpora el teclado Krom Kreator. Tambi\u00e9n, incorpora la tecnolog\u00eda Hot Swap, que te permite cambiar tus switches una vez lleguen al final de su vida \u00fatil. (Switches no incluidos).Creado para ganarCon su funci\u00f3n full anti-ghosting, dejar\u00e1s atr\u00e1s el miedo a que tu teclado se bloquee al pulsar varias teclas a la vez para derrotar a tu contrincante, de este modo conseguir\u00e1s sensaciones de juego s\u00faper fluidas.Tambi\u00e9n, su Modo Gaming te permitir\u00e1 desactivar la, en ocasiones, inc\u00f3moda tecla de Windows, evitando as\u00ed desagradables interrupciones de tu partida.Krom Kreator cuenta con una alta compatibilidad, ya que, podr\u00e1s usarlos en equipos y dispositivos Windows, Android y Mac.Retroiluminaci\u00f3n RGBEscoge entre el total de sus 20 efectos de iluminaci\u00f3n totalmente personalizables el que mejor se adapta a tu configuraci\u00f3n, pudiendo escoger la velocidad e intensidad de cada uno de ellos de manera f\u00e1cil. Adem\u00e1s, cada una de las 62 potentes teclas del Krom Kreator, cuenta con retroiluminaci\u00f3n RGB.","images":"https:\/\/www.dmi.es\/photo\/194\/103119\/84962456\/bg\/krom-kreator-mini-teclado-mecanico-rgb.jpg","wholesale_price":"25.13","unit_price_tax":28.6926},"product_model":{"product_data":{"ean13":["8436587974489"],"reference":"GA00355185","name":{"1":"KROM KREATOR MINI TECLADO MEC\u00c1NICO RGB","2":"","3":"","4":""},"description":{"1":"Krom Kreator es el teclado 60% que viene a revolucionar el mercado. Krom Kreator es un teclado gaming ultracompacto que incluye teclas de doble inyecci\u00f3n, que te permitir\u00e1 ganar espacio mientras te alzas con la victoria gracias a su formato 60%. Este mini teclado mec\u00e1nico con RGB incorpora switches mec\u00e1nicos lubricados, lo que hace que sus teclas se accionen de una manera m\u00e1s r\u00e1pida al tener menos rozamiento, mientras minimizas el ruido, haci\u00e9ndote ganar ventaja sobre tus enemigos.Dise\u00f1o mini, m\u00e1xima comodidadKrom Kreator es un teclado gamer que te permitir\u00e1 liberar espacio en tu escritorio o mesa gamer. Su compacto dise\u00f1o se traduce en comodidad garantizada, habiendo sido dise\u00f1ado para convertirse en tu support perfecto, ayud\u00e1ndote en cualquier desaf\u00edo que se te ponga por delante.Su tama\u00f1o lo hace el teclado mec\u00e1nico mini perfecto para jugar, aunque tambi\u00e9n para estudiar o trabajar, ya que, lo podr\u00e1s transportar f\u00e1cilmente de un lado a otro. Adem\u00e1s, con su cuidado dise\u00f1o se adapta a cualquier setup.Switches mec\u00e1nicos lubricadosEste teclado mini incluye switches mec\u00e1nicos lubricados, lo que supone una ventaja ya que es m\u00e1s silencioso y suaviza las sensaciones de fricci\u00f3n que se presentan en las partes internas como los switches y los estabilizadores, al tener menos rozamiento. Esto supone alargar la vida \u00fatil de los switches que incorpora el teclado Krom Kreator. Tambi\u00e9n, incorpora la tecnolog\u00eda Hot Swap, que te permite cambiar tus switches una vez lleguen al final de su vida \u00fatil. (Switches no incluidos).Creado para ganarCon su funci\u00f3n full anti-ghosting, dejar\u00e1s atr\u00e1s el miedo a que tu teclado se bloquee al pulsar varias teclas a la vez para derrotar a tu contrincante, de este modo conseguir\u00e1s sensaciones de juego s\u00faper fluidas.Tambi\u00e9n, su Modo Gaming te permitir\u00e1 desactivar la, en ocasiones, inc\u00f3moda tecla de Windows, evitando as\u00ed desagradables interrupciones de tu partida.Krom Kreator cuenta con una alta compatibilidad, ya que, podr\u00e1s usarlos en equipos y dispositivos Windows, Android y Mac.Retroiluminaci\u00f3n RGBEscoge entre el total de sus 20 efectos de iluminaci\u00f3n totalmente personalizables el que mejor se adapta a tu configuraci\u00f3n, pudiendo escoger la velocidad e intensidad de cada uno de ellos de manera f\u00e1cil. Adem\u00e1s, cada una de las 62 potentes teclas del Krom Kreator, cuenta con retroiluminaci\u00f3n RGB.","2":"","3":"","4":""},"description_short":{"1":"USB Type-C, 64 teclas, RGB, Mec\u00e1nico (switches lubricados), Hot-Swap, 300 x 145 x 43mm, Negro, 660g","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Krom","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":28.6926,"unit_price_tax":28.6926,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Krom","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/194\/103119\/84962456\/bg\/krom-kreator-mini-teclado-mecanico-rgb.jpg"],"wholesale_price":25.13}}},"6923172527806":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6923172527806",false],"wholesale_price":[51.3,false],"price":[55.386,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187776","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/aaa792668bdb8cd8b07c3ffa4c34d51e.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HD34561006","unit_price":55.385999999999996,"category":"Discos Duros Externos","brand":"Dahua Technology","name_pt":"SSD EXT DAHUA T70 1TB TIPO-C NEGRO","quantity":5,"ean13":"6923172527806","description_short_pt":"Dahua Technology PSSD-T70-1TB, 1 TB, USB Tipo C, 3.2 Gen 2 (3.1 Gen 2), 510 MB\/s, Negro","description_pt":"Dahua Technology PSSD-T70-1TB. SDD, capacidad: 1 T