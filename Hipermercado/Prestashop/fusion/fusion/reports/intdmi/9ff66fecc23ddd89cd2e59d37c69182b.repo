 colocarlo sobre los pines traseros de conexi\u00f3n.Gracias a su fant\u00e1stica c\u00e1mara integrada de 30 UltraPixel, el ni\u00f1o puede realizar fotograf\u00edas de forma sencilla y r\u00e1pida, solo tiene que enfocar el objeto o persona y hacer click para almacenarla en su memoria interna.","2":"","3":"","4":""},"description_short":{"1":"Leotec Smartwatch GPS Kids Allo Rosa","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Leotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":32.9766,"unit_price_tax":32.9766,"tax_rules_group":null,"category":"Relojes Inteligentes","brand":"Leotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/2647\/86102\/53537653\/bg\/smartwatch-leotec-1-3--kids-allo-gps-anti-perdida-rosa.jpg"],"wholesale_price":29.33}}},"0810354024788":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0810354024788",false],"wholesale_price":[326.47,false],"price":[336.0594,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187125","Cat. IDs: 193","Associated Categories","Cat. Default: 193","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/2a5089f69a04359b70ecd91e931135d2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CN11316140","unit_price":336.05940000000004,"category":"Switches y Transceptores","brand":"Ubiquiti","name_pt":"SWITCH UBIQUITI US-48 UNIFI SWITCH 48","quantity":0,"ean13":"0810354024788","description_short_pt":"Ubiquiti UniF