e9ricos","brand":"Viewsonic","name_pt":"MONITOR VIEWSONIC TD1630-3 15,6\" HD VGA HDMI ALTAVOCES TACTIL NEGRO","quantity":0,"ean13":"0766907985511","description_short_pt":"Monitor de 16\" con pantalla t\u00e1ctil de 10 puntos","description_pt":"El monitor ViewSonic TD1630-3 es una pantalla de 16\" (15.6\" visibles) con funcionalidad multit\u00e1ctil de 10 puntos. Con un dise\u00f1o ergon\u00f3mico avanzado, el TD1630-3 puede inclinarse o quedar plano para brindar a los usuarios la m\u00e1xima comodidad. Ofreciendo versatilidad de pantalla t\u00e1ctil, esta pantalla ofrece una flexibilidad fant\u00e1stica para la configuraci\u00f3n comercial o de negocios, mientras que las entradas VGA y HDMI brindan una amplia conectividad. La compatibilidad con una amplia gama de sistemas operativos, incluidas las versiones de Windows 10 y Linux*, junto con los altavoces integrados duales, hacen que esta pantalla t\u00e1ctil intuitiva sea altamente precisa. Una experiencia t\u00e1ctil ultra sensible que es ideal para la interactividad en un entorno de negocios o de retail.","images":"https:\/\/www.dmi.es\/photo\/222\/79989\/51070332\/bg\/monitor-viewsonic-td1630-3-15-6--hd-vga-hdmi-altavoces-tactil-negro.jpg","wholesale_price":"184.24","unit_price_tax":190.9848},"product_model":{"product_data":{"ean13":["0766907985511"],"reference":"MN42175025","name":{"1":"MONITOR VIEWSONIC TD1630-3 15,6\" HD VGA HDMI ALTAVOCES TACTIL NEGRO","2":"","3":"","4":""},"description":{"1":"El monitor ViewSonic TD1630-3 es una pantalla de 16\" (15.6\" visibles) con funcionalidad multit\u00e1ctil de 10 puntos. Con un dise\u00f1o ergon\u00f3mico avanzado, el TD1630-3 puede inclinarse o quedar plano para brindar a los usuarios la m\u00e1xima comodidad. Ofreciendo versatilidad de pantalla t\u00e1ctil, esta pantalla ofrece una flexibilidad fant\u00e1stica para la configuraci\u00f3n comercial o de negocios, mientras que las entradas VGA y HDMI brindan una amplia conectividad. La compatibilidad con una amplia gama de sistemas operativos, incluidas las versiones de Windows 10 y Linux*, junto con los altavoces integrados duales, hacen que esta pantalla t\u00e1ctil intuitiva sea altamente precisa. Una experiencia t\u00e1ctil ultra sensible que es ideal para la interactividad en un entorno de negocios o de retail.","2":"","3":"","4":""},"description_short":{"1":"Monitor de 16\" con pantalla t\u00e1ctil de 10 puntos","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Viewsonic","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":190.9848,"unit_price_tax":190.9848,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Viewsonic","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/222\/79989\/51070332\/bg\/monitor-viewsonic-td1630-3-15-6--hd-vga-hdmi-altavoces-tactil-negro.jpg"],"wholesale_price":184.24}}},"0766907846911":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["0766907846911",false],"wholesale_price":[238.55,false],"price":[246.381,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:185501","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/773e73a051efac65f7d30bee53447764.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"MN42175027","unit_price":246.381,"category":"Perif\u00e9ricos","brand":"Viewsonic","name_pt":"MONITOR VIEWSONIC TD2430 23,6\" FHD VGA HDMI DP ALTAVOCES TACTIL NEGRO","quantity":5,"ean13":"0766907846911","description_short_pt":"Monitor t\u00e1ctil de 24\" y 10 puntos de contacto","description_pt":"La pantalla plana ofrece una fant\u00e1stica flexibilidad para el retail, la educaci\u00f3n o a la hora de hacer negocios. La TD2430 de ViewSonic\u00ae es una pantalla Full HD de 24\" (23.6\" visibles) con panel multit\u00e1ctil de 10 puntos. Con un posicionamiento ajustable, gran angular y un dise\u00f1o duradero, el modelo TD2430 tiene todo lo necesario para satisfacer sus necesidades \u00fanicas. Es compatibe con una amplia gama de sistemas operativos, incluyendo Windows 10, y ciertos Android y Versiones de Linux.* Con una elegante pantalla de borde a borde y un marco sin bisel, esta pantalla t\u00e1ctil intuitiva funciona como su tableta o tel\u00e9fono inteligente favorito para ofrecer una experiencia t\u00e1ctil altamente precisa y ultra sensible, ideal para la interactividad en entornos p\u00fablicos, quioscos y aplicaciones de orientaci\u00f3n y se\u00f1alizaci\u00f3n, aulas, y m\u00e1s.","images":"https:\/\/www.dmi.es\/photo\/222\/79991\/51076559\/bg\/monitor-viewsonic-td2430-23-6--fhd-vga-hdmi-dp-altavoces-tactil-negro.jpg","wholesale_price":"238.55","unit_price_tax":246.381},"product_model":{"product_data":{"ean13":["0766907846911"],"reference":"MN42175027","name":{"1":"MONITOR VIEWSONIC TD2430 23,6\" FHD VGA HDMI DP ALTAVOCES TACTIL NEGRO","2":"","3":"","4":""},"description":{"1":"La pantalla plana ofrece una fant\u00e1stica flexibilidad para el retail, la educaci\u00f3n o a la hora de hacer negocios. La TD2430 de ViewSonic\u00ae es una pantalla Full HD de 24\" (23.6\" visibles) con panel multit\u00e1ctil de 10 puntos. Con un posicionamiento ajustable, gran angular y un dise\u00f1o duradero, el modelo TD2430 tiene todo lo necesario para satisfacer sus necesidades \u00fanicas. Es compatibe con una amplia gama de sistemas operativos, incluyendo Windows 10, y ciertos Android y Versiones de Linux.* Con una elegante pantalla de borde a borde y un mar