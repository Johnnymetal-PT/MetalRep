a_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Dahua Technology","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":93.7584,"unit_price_tax":93.7584,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Dahua Technology","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/222\/102124\/82446876\/bg\/monitor-dahua-24--dhi-lm24-b201a-ips-fhd-100hz-6ms-vga-hdmi-dp-regulable-ajust.jpg"],"wholesale_price":88.92}}},"8032958189607":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8032958189607",false],"wholesale_price":[346.19,false],"price":[356.1738,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:187931","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/31bae576b8c1732505420e22cdb1c9a2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"AR09535038","unit_price":356.17379999999997,"category":"Rack","brand":"WP","name_pt":"ARMARIO RACK WP 19\" 42U SERIE RNA 600X600 MM DESMONTADO, NEGRO","quantity":0,"ean13":"8032958189607","description_short_pt":"BASTIDOR PARA REDES DE 19\" 42U 600x600mm, NEGRO DESMONTADO","description_pt":"La serie RNA de armarios bastidores para la instalaci\u00f3n en el suelo le permite crear cualquier configuraci\u00f3n que desee gracias a su gran variedad de tama\u00f1os disponibles.La puerta de cristal templado, el armaz\u00f3n de acero de 2 mm, los cierres (tambi\u00e9n en los paneles laterales desmontables), las 4 ruedas y las 4 patas de nivelaci\u00f3n convierten esta serie en una soluci\u00f3n sencilla y con todo lo necesario para su instalaci\u00f3n.Adem\u00e1s, tiene la posibilidad de adquirirlo montado o desmontado, lo que facilita el desplazamiento y reduce el riesgo de da\u00f1os durante el transporte a su lugar de destino.- Se vende totalmente desmontado en una caja de cart\u00f3n reforzado- Estructura principal de acero s\u00f3lido de 2 mm y laterales de acero de 1,5 mm- Su puerta de cristal templado se abre en un \u00e1ngulo de 180\u00b0, dispone de un armaz\u00f3n met\u00e1lico de 1,5 mm e incluye un asa y un cierre con llave- Paneles laterales desmontables, adem\u00e1s de cierres y llaves, para una f\u00e1cil instalaci\u00f3n del equipo- Entrada de cable tanto en la parte superior como en la inferior (con tapa)- Carcasa para ventiladores de 120 mm o kits de ventilaci\u00f3n especiales en la parte superior.- Soporta una capacidad de hasta 800kg- Completo con 4 puntales delanteros numerados con profundidad ajustable- Completo con patas de nivelaci\u00f3n y 4 ruedas (2 con freno)- Kit para el montaje en el suelo incluido- Dimensiones An x Pr x Al: 600x600x2055mm- 20 sets de tornillos incluidos (tornillos + tuercas enjauladas)- Color: Negro, RAL 9005- Unidad: 42- Clase de protecci\u00f3n IP 20","images":"https:\/\/www.dmi.es\/photo\/240\/102874\/15787227\/bg\/armario-rack-wp-19--42u-serie-rna-600x600-mm-desmontado--negro.jpg","wholesale_price":"346.19","unit_price_tax":356.17379999999997},"product_model":{"product_data":{"ean13":["8032958189607"],"reference":"AR09535038","name":{"1":"ARMARIO RACK WP 19\" 42U SERIE RNA 600X600 MM DESMONTADO, NEGRO","2":"","3":"","4":""},"description":{"1":"La serie RNA de armarios bastidores para la instalaci\u00f3n en el suelo le permite crear cualquier configuraci\u00f3n que desee gracias a su gran variedad de tama\u00f1os disponibles.La puerta de cristal templado, el armaz\u00f3n de acero de 2 mm, los cierres (tambi\u00e9n en los paneles laterales desmontables), las 4 ruedas y las 4 patas de nivelaci\u00f3n c