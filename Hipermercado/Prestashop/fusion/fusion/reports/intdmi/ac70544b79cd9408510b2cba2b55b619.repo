n":{"1":"Cecotec ReadyWarm 2000 Thermal Connected. Tipo: Convector. Adecuado para: Interior, Opciones de colocaci\u00f3n: Piso, Pared, Color del producto: Blanco. Potencia de calentamiento: 1500 W, Adecuado para habitaciones hasta: 20 m\u00b2, Tipo de control del termostato: Digital. Potencia: 1500 W, Voltaje de entrada AC: 220 - 240 V, Frecuencia de entrada AC: 50 - 60 Hz. Ancho: 830 mm, Profundidad: 260 mm, Altura: 630 mm","2":"","3":"","4":""},"description_short":{"1":"Cecotec ReadyWarm 2000 Thermal Connected, Convector, Interior, Piso, Pared, Blanco, LED, 1500 W","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":108.09,"unit_price_tax":108.09,"tax_rules_group":null,"category":"Control de clima","brand":"Cecotec","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/1658\/90858\/66818595\/bg\/emisor-termico-cecotec-ready-warm-2000-thermal-connected.jpg"],"wholesale_price":101.09}}},"8435484053730":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484053730",false],"wholesale_price":[80.74,false],"price":[87.74,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:225586","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/c00534a5c7f099a137f32f141042b70d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO01330014","unit_price":87.74,"category":"Control de clima","brand":"Cecotec","name_pt":"EMISOR TERMICO CECOTEC READY WARM 1200 THERMAL CONNECTED","quantity":5,"ean13":"8435484053730","description_short_pt":"Emisor t\u00e9rmico 900 W,  Wi-Fi, pantalla LED, 10m2","description_pt":"Emisor t\u00e9rmico con 6 elementos y 900 W, control por Wi-Fi, pantalla LED, mando a distancia, temporizador programable, selecci\u00f3n de temperatura, cobertura de 10 m\u00b2 y m\u00e1xima seguridad.C A R AC T E R \u00cd S T I C A S :? El emisor t\u00e9rmico cuenta con 6 elementos y una gran potencia de 900 W con los que calentar r\u00e1pidamente la estancia en la cual seaubicado.? Su gran \u00e1rea de cobertura de hasta 10 m\u00b2 permite alcanzar la temperatura deseada en un breve periodo de tiempo en una estanciacon dicho tama\u00f1o.? Su control por Wi-Fi mediante un Smartphone permite seleccionar las distintas configuraciones de funcionamiento del emisor.? Gracias a su pantalla LED y su mando a distancia el emisor ofrece un control total de manera inteligente y c\u00f3moda.? Cuenta con un temporizador programable, gracias al cual se puede establecer la hora y el tiempo concreto que se desea que funcioneel emisor.? Gracias a su termostato, el emisor detecta la temperatura actual de la estancia y es posible seleccionar la temperatura deseadaentre un rango de 5\u00ba a 40\u00ba.? Maxima adaptabilidad ya que el emisor puede ser ubicado tanto en la pared de manera fija o gracias a sus patas, de manera port\u00e1tilpor todo el hogar.? Posee 2 sistemas de seguridad, seguridad contra sobrecalentamiento (protege tu hogar) y seguro para ni\u00f1os (evita que estoscambien la configuraci\u00f3n)","images":"https:\/\/www.dmi.es\/photo\/1658\/90856\/66817622\/bg\/emisor-termico-cecotec-ready-warm-1200-thermal-connected.jpg","wholesale_price":"80.74","unit_price_tax":87.74},"product_model":{"product_data":{"ean13":["8435484053730"],"reference":"HO01330014","name":{"1":"EMISOR TERMICO CECOTEC READY WARM 1200 THERMAL CONNECTED","2":"","3":"","4":""},"description":{"1":"Emisor t\u00e9rmico con 6 elementos y 900 W, control por Wi-Fi, pantalla LED, mando a distancia, temporizador programable, selecci\u00f3n de temperatura, cobertura de 10 m\u00b2 y m\u00e1xima seguridad.C A R AC T E R \u00cd S T I C A S :? El emisor t\u00e9rmico cuenta con 6 elementos y una gran potencia de 900 W con los que calentar r\u00e1pidamente la estancia en la cual seaubicado.? Su gran \u00e1rea de cobertura de hasta 10 m\u00b2 permite alcanzar la temperatura deseada en un breve periodo de tiempo en una estanciacon dicho tama\u00f1o.? Su control por Wi-Fi mediante un Smartphone permite seleccionar las distintas configuraciones de funcionamiento del emisor.? Gracias a su pantalla LED y su mando a distancia el emisor ofrece un control total de manera inteligente y c\u00f3moda.? Cuenta con un temporizador programable, gracias al cual se puede establecer la hora y el tiempo concreto que se desea que funcioneel emisor.? Gracias a su termostato, el emisor detecta la temperatura actual de la estancia y es posible seleccionar la temperatura deseadaentre un rango de 5\u00ba a 40\u00ba.? Maxima adaptabilidad ya que el emisor puede ser ubicado tanto en la pared de manera fija o gracias a sus patas, de manera port\u00e1tilpor todo el hogar.? Posee 2 sistemas de seguridad, seguridad contra sobrecalentamiento (protege tu hogar) y seguro para ni\u00f1os (evita que estoscambien la configuraci\u00f3n)","2":"","3":"","4":""},"description_short":{"1":"Emisor t\u00e9rmico 900 W,  Wi-Fi, pantalla LED, 10m2","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":87.74,"unit_price_tax":87.74,"tax_rules_group":null,"category":"Control de clima","brand":"Cecotec","quantity"