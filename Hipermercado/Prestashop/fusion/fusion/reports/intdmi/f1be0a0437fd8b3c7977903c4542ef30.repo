":"","3":"","4":""},"visibility":"both","manufacturer_name":"Ewent","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":162.61,"unit_price_tax":162.61,"tax_rules_group":null,"category":"TV","brand":"Ewent","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1056\/106321\/89464482\/bg\/soporte-pared-ewent-tv-55-100--negro.jpg"],"wholesale_price":159.61}}},"8052101433388":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8052101433388",false],"wholesale_price":[66.02,false],"price":[69.02,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:192663","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/def71c901e71f1ea96aa25a8a08c16e9.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"VC125341134","unit_price":69.02,"category":"Perif\u00e9ricos","brand":"Ewent","name_pt":"SOPORTE EWENT MONITOR  49\" NEGRO, GRIS CLARO ESCRITORIO","quantity":0,"ean13":"8052101433388","description_short_pt":"Brazo de soporte robusto para monitor individual de escritorio para monitor plano\/curvo\/ultraancho de hasta 49\" y 20 kg, VESA completo 75x75 \/ 100x100, luz RGB, negro mate y gris claro.","description_pt":"No din\u00e2mico mundo do trabalho, gaming e entretenimento, o nosso suporte para monitor EW1509 emerge como o ep\u00edtome de eleg\u00e2ncia e funcionalidade avan\u00e7ada. Com um robusto mecanismo de inclina\u00e7\u00e3o e rota\u00e7\u00e3o, este suporte foi projetado para acomodar telas curvas ou planas de at\u00e9 49 polegadas, com um peso m\u00e1ximo de 20 kg, oferecendo uma solu\u00e7\u00e3o vers\u00e1til adequada para uma ampla gama de monitores, incluindo aqueles que n\u00e3o s\u00e3o estritamente destinados ao gaming.O design sofisticado e a ilumina\u00e7\u00e3o ambiente cativante, aprimorada por 7 efeitos de ilumina\u00e7\u00e3o din\u00e2micos, transformam o suporte em um elemento decorativo que se integra perfeitamente em qualquer ambiente. Uma fus\u00e3o de estilo e funcionalidade avan\u00e7ada que complementa perfeitamente os espa\u00e7os de trabalho modernos ou as \u00e1reas de entretenimento.A adaptabilidade deste suporte vai al\u00e9m da sua est\u00e9tica. Com a liberdade de mover e posicionar facilmente monitores curvos ultrawide, incluindo o renomado Samsung Odyssey G9, estamos prontos para atender \u00e0s necessidades de profissionais de escrit\u00f3rio que buscam um espa\u00e7o de trabalho ergon\u00f4mico e de jogadores em busca de uma experi\u00eancia de jogo imersiva. A versatilidade encontra a excel\u00eancia em um \u00fanico acess\u00f3rio, projetado para atender \u00e0s demandas do estilo de vida de trabalho moderno e do puro desfrute digital.","images":"https:\/\/www.dmi.es\/photo\/942\/106320\/89460901\/bg\/soporte-ewent-monitor--49--negro--gris-claro-escritorio.jpg","wholesale_price":"66.02","unit_price_tax":69.02},"product_model":{"product_data":{"ean13":["8052101433388"],"reference":"VC125341134","name":{"1":"SOPORTE EWENT MONITOR  49\" NEGRO, GRIS CLARO ESCRITORIO","2":"","3":"","4":""},"description":{"1":"No din\u00e2mico mundo do trabalho, gaming e entretenimento, o nosso suporte para monitor EW1509 emerge como o ep\u00edtome de eleg\u00e2ncia e funcionalidade avan\u00e7ada. Com um robusto mecanismo de inclina\u00e7\u00e3o e rota\u00e7\u00e3o, este suporte foi projetado para acomodar telas curvas ou planas de at\u00e9 49 polegadas, com um peso m\u00e1ximo de 20 kg, oferecendo uma solu\u00e7\u00e3o vers\u00e1til adequada para uma ampla gama de monitores, incluindo aqueles que n\u00e3o s\u00e3o estritamente destinados ao gaming.O design sofisticado