2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Ewent","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":21.9,"unit_price_tax":21.9,"tax_rules_group":null,"category":"Accesorios telefon\u00eda","brand":"Ewent","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1399\/107151\/92258064\/bg\/cargador-rapido-ewent-2puertos--usb-c-a--65w.jpg"],"wholesale_price":14.9}}},"8052101433661":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8052101433661",false],"wholesale_price":[31.08,false],"price":[38.08,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:212250","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/6047e1dc91f05e5aee10f18e02c83f71.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"TV90534350","unit_price":38.08,"category":"Perif\u00e9ricos","brand":"Ewent","name_pt":"SOPORTE EWENT PARA MONITOR DE ESCRITORIO 45\"Y 15 KG","quantity":0,"ean13":"8052101433661","description_short_pt":"Soporte para Monitor para Escritorio - Compatible con Monitores Planos, Curvos y Ultra Anchos hasta 45? y 15 Kg - VESA Completo 75x75 \/ 100x100","description_pt":"Descubre la soluci\u00f3n definitiva para tus necesidades de configuraci\u00f3n de monitor con nuestro brazo para monitor individual premium. Dise\u00f1ado para soportar monitores est\u00e1ndar y ultra anchos de hasta 45 pulgadas y 15 kg, este brazo para monitor combina versatilidad, ajuste ergon\u00f3mico y un dise\u00f1o elegante y organizado.Capacidad de Montaje Vers\u00e1tilEl brazo para monitor incluye una abrazadera VESA de liberaci\u00f3n r\u00e1pida que soporta patrones de montaje de 75x75 mm y 100x100 mm para una compatibilidad f\u00e1cil. Se fija a escritorios de hasta 80 mm de grosor con una abrazadera en C resistente e incluye un montaje de goma para mayor flexibilidad.Ajuste Ergon\u00f3micoEquipado con un brazo asistido por resorte mec\u00e1nico, el brazo para monitor contrarresta perfectamente el peso de su monitor, permitiendo ajustes de altura sin esfuerzo. Ideal tanto para configuraciones de juego como profesionales, reposiciona f\u00e1cilmente pantallas grandes con solo un toque, mejorando tanto la experiencia de juego como de trabajo.Movimiento FlexibleLa estructura de la cabeza inclinable ofrece ajustes suaves con un rango de inclinaci\u00f3n de +90\u00b0 a -90\u00b0. Proporciona un giro de 180\u00b0 y una rotaci\u00f3n de 360\u00b0 para la m\u00e1xima flexibilidad, junto con 536 mm de ajuste de altura suave utilizando el levantamiento de resorte mec\u00e1nico.Dise\u00f1o Limpio y OrganizadoLas cubiertas de gesti\u00f3n de cables integradas mantienen los cables ordenadamente fuera del camino, manteniendo una apariencia ordenada y profesional.Instalaci\u00f3n F\u00e1cilLa placa VESA desmontable simplifica el proceso de montaje de su monitor. Todo el hardware necesario y las instrucciones detalladas est\u00e1n incluidas para un montaje sencillo.Mejora tu espacio de trabajo con nuestro brazo para monitor individual, la combinaci\u00f3n perfecta de construcci\u00f3n robusta, ajuste f\u00e1cil y dise\u00f1o limpio. Ya sea para uso en juegos o profesional, este brazo para monitor asegura una configuraci\u00f3n ergon\u00f3mica, ordenada y flexible, mejorando tu experiencia en general.","images":"https:\/\/www.dmi.es\/photo\/942\/107152\/93110448\/bg\/soporte-ewent-para-monitor-de-escritorio-45-y-15-kg.jpg","wholesale_price":"31.08","unit_price_tax":38.08},"product_model":{"product_data":{"ean13":["8052101433661"],"reference":"TV90534350","name":{"1":"SOPORTE EWENT PARA MONITOR DE ESCRITORIO 45\"Y 15 KG","2":"","3":"","4":""},"description":{"1":"Descubre la soluci\u00f3n definitiva para tus necesidades de configuraci\u00f3n de monitor con nuestro brazo para monitor individual premium. Dise\u00f1ado para soportar monitores est\u00e1ndar y ultra anchos de hasta 45 pulgadas y 15 kg, este brazo para monitor combina versatilidad, ajuste ergon\u00f3mico y un dise\u00f1o elegante y organizado.Capacidad de Montaje Vers\u00e1tilEl brazo para monitor incluye una abrazadera VESA de liberaci\u00f3n r\u00e1pida que soporta patrones de montaje de 75x75 mm y 100x100 mm para una compatibilidad f\u00e1cil. Se fija a escritorios de hasta 80 mm de grosor con una abrazadera en C resistente e incluye un montaje de goma para mayor flexibilidad.Ajuste Ergon\u00f3micoEquipado con un brazo asistido por resorte mec\u00e1nico, el brazo para monitor contrarresta perfectamente el peso de su monitor, permitiendo ajustes de altura sin esfuerzo. Ideal tanto para configuraciones de juego como profesionales, reposiciona f\u00e1cilmente pantallas grandes con solo un toque, mejorando tanto la experiencia de juego como de trabajo.Movimiento FlexibleLa estructura de la cabeza inclinable ofrece ajustes suaves con un rango de inclinaci\u00f3n de +90\u00b0 a -90\u00b0. Proporciona un giro de 180\u00b0 y una rotaci\u00f3n de 360\u00b0 para la m\u00e1xima flexibilidad, junto con 536 mm de ajuste de altura suave utilizando el levantamiento de resorte mec\u00e1nico.Dise\u00f1o Limpio y OrganizadoLas cubiertas de gesti\u00f3n de cables integradas mantienen los cables ordenadamente fuera del camino, manteniendo una apariencia ordenada y profesional.Instalaci\u00f3n F\u00e1cilLa placa VESA desmontable simplifica el proceso de montaje de su monitor. Todo el hardware necesario y las instrucciones detalladas est\u00e1n incluidas para un montaje sencillo.Mejora tu espacio de trabajo con nuestro brazo para monitor individual, la combinaci\u00f3n perfecta de construcci\u00f3n robusta, ajuste f\u00e1cil y dise\u00f1o limpio. Ya sea para uso en juegos o profesional, este brazo para monitor asegura una configuraci\u00f3n ergon\u00f3mica, ordenada y flexible, mejorando tu experiencia en general.","2":"","3":"","4":""},"description_short":{"1":"Soporte para Monitor para Escritorio - Compatible con Monitores Planos, Curvos y Ultra Anchos hasta 45? y 15 Kg - VESA Completo 75x75 \/ 100x100","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Ewent","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":38.08,"unit_price_tax":38.08,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Ewent","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/942\/107152\/93110448\/bg\/soporte-ewent-para-monitor-de-escritorio-45-y-15-kg.jpg"],"wholesale_price":31.08}}},"8052101433678":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8052101433678",false],"wholesale_price":[47.13,false],"price":[54.13,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:212251","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/32957b67c48dcace1419cb877a259a1c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"TV90534351","unit_price":54.13,"category":"Perif\u00e9ricos","brand":"Ewent","name_pt":"SOPORTE EWENT PARA DOBLE MONITOR 35\" Y 15KG","quantity":0,"ean13":"8052101433678","description_short_pt":"Soporte de Escritorio para Doble Monitor Plano\/Curvo\/Ultrawide hasta 35\" y 15 Kg - Compatible con VESA 75x75 \/ 100x100","description_pt":"Mejora Tu Estaci\u00f3n de TrabajoMejora tu estaci\u00f3n de trabajo con nuestro robusto soporte de escritorio para doble monitor, dise\u00f1ado para acomodar monitores planos, curvos y ultra-ancho de hasta 45 pulgadas y 15 kg. Este soporte para doble monitor combina versatilidad, ajuste ergon\u00f3mico y un dise\u00f1o elegante y organizado, lo que lo hace perfecto para cualquier configuraci\u00f3n profesional o de juego.Capacidad de Montaje Vers\u00e1tilNuestro soporte para doble monitor est\u00e1 dise\u00f1ado para soportar monitores est\u00e1ndar y ultra-ancho de hasta 35 pulgadas y 15 kg. El soporte VESA de liberaci\u00f3n r\u00e1pida soporta patrones de montaje de 75x75 mm y 100x100 mm para una f\u00e1cil compatibilidad. Se fija a escritorios de hasta 80 mm de grosor con una abrazadera en C resistente e incluye un soporte de ojal para mayor flexibilidad.Ajuste Ergon\u00f3micoEquipado con brazos asistidos por resorte mec\u00e1nico de alta calidad, este soporte para doble monitor contrarresta perfectamente el peso de tus monitores, permitiendo ajustes de altura sin esfuerzo. Ya sea que est\u00e9s configurando para jugar o para trabajar, este soporte robusto reposiciona f\u00e1cilmente las pantallas grandes con un simple toque, mejorando tanto las experiencias de juego como de trabajo.Movimiento FlexibleLa estructura de cabeza inclinable optimizada ofrece ajustes suaves con un rango de inclinaci\u00f3n de +90\u00b0 a -90\u00b0, una rotaci\u00f3n de 180\u00b0 y una rotaci\u00f3n de 360\u00b0. Con 536 mm de ajuste en altura con el elevador de resorte mec\u00e1nico, este soporte para doble monitor ofrece la m\u00e1xima flexibilidad para adaptarse a tus preferencias de visualizaci\u00f3n.Dise\u00f1o Limpio y OrganizadoLas cubiertas de gesti\u00f3n de cables integradas mantienen los cables ordenados, manteniendo una apariencia limpia y profesional. Di adi\u00f3s al desorden y disfruta de una estaci\u00f3n de trabajo m\u00e1s organizada.Instalaci\u00f3n F\u00e1cilMontar tus monitores es un proceso simple con las placas VESA desmontables. Proporcionamos todo el hardware necesario e instrucciones detalladas para un montaje sencillo, asegurando una instalaci\u00f3n sin problemas.Mejora Tu Estaci\u00f3n de TrabajoEl soporte pesado de escritorio para doble monitor es la combinaci\u00f3n perfecta de construcci\u00f3n robusta, f\u00e1cil ajuste y dise\u00f1o limpio. Ya sea para jugar o para uso profesional, este soporte para doble monitor asegura una configuraci\u00f3n ergon\u00f3mica, organizada y flexible, mejorando tu experiencia en general.","images":"https:\/\/www.dmi.es\/photo\/942\/107153\/93110464\/bg\/soporte-ewent-para-doble-monitor-35--y-15kg.jpg","wholesale_price":"47.13","unit_price_tax":54.13},"product_model":{"product_data":{"ean13":["8052101433678"],"reference":"TV90534351","name":{"1":"SOPORTE EWENT PARA DOBLE MONITOR 35\" Y 15KG","2":"","3":"","4":""},"description":{"1":"Mejora Tu Estaci\u00f3n de TrabajoMejora tu estaci\u00f3n de trabajo con nuestro robusto soporte de escritorio para doble monitor, dise\u00f1ado para acomodar monitores planos, curvos y ultra-ancho de hasta 45 pulgadas y 15 kg. Este soporte para doble monitor combina versatilidad, ajuste ergon\u00f3mico y un dise\u00f1o elegante y organizado, lo que lo hace perfecto para cualquier configuraci\u00f3n profesional o de juego.Capacidad de Montaje Vers\u00e1tilNuestro soporte para doble monitor est\u00e1 dise\u00f1ado para soportar monitores est\u00e1ndar y ultra-ancho de hasta 35 pulgadas y 15 kg. El soporte VESA de liberaci\u00f3n r\u00e1pida soporta patrones de montaje de 75x75 mm y 100x100 mm para una f\u00e1cil compatibilidad. Se fija a escritorios de hasta 80 mm de grosor con una abrazadera en C resistente e incluye un soporte de ojal para mayor flexibilidad.Ajuste Ergon\u00f3micoEquipado con brazos asistidos por