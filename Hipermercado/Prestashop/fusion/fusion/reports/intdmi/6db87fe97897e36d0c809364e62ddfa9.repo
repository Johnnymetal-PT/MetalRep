holesale_price":61.98}}},"8435484053808":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484053808",false],"wholesale_price":[109.6,false],"price":[116.6,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:222275","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/acae6a80ca32bf7b1c64850db75a35fe.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO01330224","unit_price":116.6,"category":"Sistemas de fontaner\u00eda y calefacci\u00f3n","brand":"Cecotec","name_pt":"RADIADOR ELECTRICO BAJO CONSUMO CECOTEC READY WARM 6770 CRYSTAL WIFI 2000W","quantity":0,"ean13":"8435484053808","description_short_pt":"750 W, Pantalla LED, Control t\u00e1ctil, Temporizador, 3 Modos de Funcionamiento, 2 Sistemas de Seguridad","description_pt":"TOALLERO EL\u00c9CTRICO DE 750 WEl toallero el\u00e9ctrico de fluido cuenta con una gran potencia de 750 W capaces de calentar r\u00e1pidamente tus toallas e incluso aumentar la temperatura del ba\u00f1o.ELIGE TU TEMPERATURASelecci\u00f3n de temperatura, dependiendo del modo de funcionamiento, entre un rango de 10\u00ba a 35\u00ba aproximadamente, permite un confort m\u00e1ximo y personalizado en tu ba\u00f1o.3 MODOS DE FUNCIONAMIENTOCuenta con 3 modos de funcionamiento para adaptarse a las necesidades de cada momento, modo Confort, modo Eco y modo Ventana abierta.PROGRAMADOR SEMANALCuenta con un programador semanal, gracias al cual se pueden establecer los d\u00edas de la semana as\u00ed como la franja horaria que se desee para encender autom\u00e1ticamente el toallero.PANTALLA LED Y CONTROL T\u00c1CTILSu pantalla LED muestra la temperatura actual de la estancia y gracias a ella se podr\u00e1n seleccionar otras funciones del calefactor, como su temperatura y sus modos. Su panel de control t\u00e1ctil facilita el control del toallero adem\u00e1s de hacerlo m\u00e1s atractivo y aumentar su comodidad durante la configuraci\u00f3n del funcionamiento.M\u00c1XIMA SEGURIDAD CON PROTECCI\u00d3N IP24Uso ideal para ba\u00f1os gracias a su IP24, es decir, resistencia a motas de polvo de tama\u00f1o medio y chorros de agua que puedan salpicar al toallero. Posee 2 sistemas de seguridad, seguridad contra sobrecalentamiento (protege tu ba\u00f1o y tu hogar) y sistema antihelada (protege tu toallero en caso de temperaturas muy bajas cercanas a los 0\u00ba).","images":"https:\/\/www.dmi.es\/photo\/2067\/107571\/73483740\/bg\/radiador-electrico-bajo-consumo-cecotec-ready-warm-6770-crystal-wifi-2000w.jpg","wholesale_price":"109.60","unit_price_tax":116.6},"product_model":{"product_data":{"ean13":["8435484053808"],"reference":"HO01330224","name":{"1":"RADIADOR ELECTRICO BAJO CONSUMO CECOTEC READY WARM 6770 CRYSTAL WIFI 2000W","2":"","3":"","4":""},"description":{"1":"TOALLERO EL\u00c9CTRICO DE 750 WEl toallero el\u00e9ctrico de fluido cuenta con una gran potencia de 750 W capaces de calentar r\u00e1pidamente tus toallas e incluso aumentar la temperatura del ba\u00f1o.ELIGE TU TEMPERATURASelecci\u00f3n de temperatura, dependiendo del modo de funcionamiento, entre un rango de 10\u00ba a 35\u00ba aproximadamente, permite un confort m\u00e1ximo y personalizado en tu ba\u00f1o.3 MODOS DE FUNCIONAMIENTOCuenta con 3 modos de funcionamiento para adaptarse a las necesidades de cada momento, modo Confort, modo Eco y modo Ventana abierta.PROGRAMADOR SEMANALCuenta con un programador semanal, gracias al cual se pueden establecer los d\u00edas de la semana as\u00ed como la franja horaria que se desee para encender autom\u00e1ticamente el toallero.PANTALLA LED Y CONTROL T\u00c1CTILSu pantalla LED mue