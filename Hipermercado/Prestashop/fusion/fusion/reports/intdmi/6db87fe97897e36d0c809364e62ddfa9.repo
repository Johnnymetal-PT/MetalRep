f7e672.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO01330213","unit_price":57.26,"category":"Control de clima","brand":"Cecotec","name_pt":"CALEFACTOR BAJO CONSUMO CECOTEC READY WARM 8400 BLADELESS CONNECTED 1500 W","quantity":0,"ean13":"8435484053716","description_short_pt":"1500 W, Wifi, Mando a Distancia, Pantalla LED, T\u00e1ctil, 3 Modos, Oscilaci\u00f3n, Temporizador, Triple Sistema de Seguridad","description_pt":"Dise\u00f1ado para tu comodidadTecnolog\u00eda Bladeless con control Wi-FIM\u00c1XIMA POTENCIA CON 3 MODOSEl calefactor cuenta con una gran potencia de 1500 W con los que calentar r\u00e1pidamente la estancia en la cual sea ubicado. Cuenta con 3 modos de funcionamiento: modo Ventilador, modo Low (reduce el consumo a 750 W) y modo High (consumo m\u00e1ximo de 1500 W).TECNOLOG\u00cdA BLADELESSSu tecnolog\u00eda Bladeless aporta al calefactor una gran distribuci\u00f3n del calor y seguridad en dicho proceso, adem\u00e1s de ser m\u00e1s silencioso y f\u00e1cilmente lavable. Seguridad total gracias a su triple sistema de seguridad: autoapagado en caso de vuelco, protecci\u00f3n contra sobrecalentamiento y sin aspas, ideal para ni\u00f1os.CONTROL POR WI-FIC\u00f3modo control gracias a su conectividad Wi-Fi que permite controlar el calefactor desde tu smartphone.T\u00c1CTIL, MANDO A DISTANCIA Y PANTALLA LEDC\u00f3modo control gracias a su panel t\u00e1ctil en el cual seleccionar el funcionamiento del calefactor o gracias a su mando a distancia. Su pantalla LED muestra la temperatura actual de la estancia y gracias a ella se podr\u00e1n seleccionar otras funciones del calefactor.","images":"https:\/\/www.dmi.es\/photo\/1658\/107560\/73484454\/bg\/calefactor-bajo-consumo-cecotec-ready-warm-8400-bladeless-connected-1500-w.jpg","wholesale_price":"50.26","unit_price_tax":57.26},"product_model":{"product_data":{"ean13":["8435484053716"],"reference":"HO01330213","name":{"1":"CALEFACTOR BAJO CONSUMO CECOTEC READY WARM 8400 BLADELESS CONNECTED 1500 W","2":"","3":"","4":""},"description":{"1":"Dise\u00f1ado para tu comodidadTecnolog\u00eda Bladeless con control Wi-FIM\u00c1XIMA POTENCIA CON 3 MODOSEl calefactor cuenta con una gran potencia de 1500 W con los que calentar r\u00e1pidamente la estancia en la cual sea ubicado. Cuenta con 3 modos de funcionamiento: modo Ventilador, modo Low (reduce el consumo a 750 W) y modo High (consumo m\u00e1ximo de 1500 W).TECNOLOG\u00cdA BLADELESSSu tecnolog\u00eda Bladeless aporta al calefactor una gran distribuci\u00f3n del calor y seguridad en dicho proceso, adem\u00e1s de ser m\u00e1s silencioso y f\u00e1cilmente lavable. Seguridad total gracias a su triple sistema de seguridad: autoapagado en caso de vuelco, protecci\u00f3n contra sobrecalentamiento y sin aspas, ideal para ni\u00f1os.CONTROL POR WI-FIC\u00f3modo control gracias a su conectividad Wi-Fi que permite controlar el calefactor desde tu smartphone.T\u00c1CTIL, MANDO A DISTANCIA Y PANTALLA LEDC\u00f3modo control gracias a su panel t\u00e1ctil en el cual seleccionar el funcionamiento del calefactor o gracias a su mando a distancia. Su pantalla LED muestra la temperatura actual de la estancia y gracias a ella se podr\u00e1n seleccionar otras funciones del calefactor.","2":"","3":"","4":""},"description_short":{"1":"1500 W, Wifi, Mando a Distancia, Pantalla LED, T\u00e1ctil, 3 Modos, Oscilaci\u00f3n, Temporizador, Triple Sistema de Seguridad","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Cecotec","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":57.26,"unit_price_tax":57.26,"tax_rules_group":null,"category":"Control de clima","brand":"Cecotec","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1658\/107560\/73484454\/bg\/calefactor-bajo-consumo-cecotec-ready-warm-8400-bladeless-connected-1500-w.jpg"],"wholesale_price":50.26}}},"8435484053143":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435484053143",false],"wholesale_price":[40.88,false],"price":[47.88,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:222264","Cat. IDs: 195","Associated Categories","Cat. Default: 195","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/fae8e4e8662335c599c77bf33ae58b43.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"HO01330214","unit_price":47.88,"category":"Control de clima","brand":"Cecotec","name_pt":"CALEFACTOR BANO CERAMICO CECOTEC READY WARM 10100 SMART CERAMIC VERTICAL 2000W","quantity":0,"ean13":"8435484053143","description_short_pt":"2200 W, 22 m\u00b2, LED, 30 dB","description_pt":"AJUSTA LA POTENCIA Y LA TEMPERATURA A TUS NECESIDADESGracias a su tecnolog\u00eda ?Max Warm? y a su doble termostato regulable podr\u00e1s ajustar el nivel de potencia y la temperatura seg\u00fan las necesidades que tengas en cada circunstancia y en cada habitaci\u00f3n de tu hogar Este calefactor cer\u00e1mico ofrece una potencia m\u00e1xima de 2200 W. Podr\u00e1s seleccionar entre sus dos potencias (1200 W y 2200 W) Adem\u00e1s, tambi\u00e9n podr\u00e1s ajustar de forma precisa la temperatura.TECNOLOG\u00cdA CER\u00c1MICA PARA CALENTAR DE FORMA R\u00c1PIDA Y EFICIENTEGracias a su tecnolog\u00eda cer\u00e1mica podr\u00e1s calentar cualquier estancia de tu hogar de forma r\u00e1pida y eficiente. Este tipo de tecnolog\u00eda proporciona mayor eficiencia y seguridad gracias a su capacidad de PTC de autorregular la potencia de salida seg\u00fan el aumento de la temperatura. Adem\u00e1s, el calor se extiende r\u00e1pidamente hacia el punto que desees.SMART CONTROL: MANDO A DISTANCIA Y PANTALLA LCDEste calefactor cer\u00e1mico Ready Warm 10100 Smart Ceramic cuenta con un mando a distancia para que puedas controlarlo de manera f\u00e1cil e intuitiva. Podr\u00e1s encender o apagar el calefactor, seleccionar el modo que desees, escoger la opci\u00f3n de oscilaci\u00f3n y realizar la configuraci\u00f3n del temporizador. Adem\u00e1s, cuenta con una pantalla LCD para que puedas observar el modo y la temperatura utilizada.CONFIGURALO Y OLVIDATEGracias a su ?Warm Timer?, este calefactor cer\u00e1mico cuenta con un temporizador programable hasta 8 horas, transcurridas las cuales el dispositivo se apaga autom\u00e1ticamente. Gracias a esta acci\u00f3n de auto apagado, podr\u00e1s ahorrar en tu factura anual y adem\u00e1s tendr\u00e1s la estancia caldeada el tiempo que desees.3 MODOS REGULABLES PARA CADA MOMENTOSelecciona el nivel de temperatura que desees. Cuenta con 3 modos de funcionamiento (eco, turbo y ventilador) para poder adaptar la intensidad seg\u00fan tus necesidades. Gracias al modo eco podr\u00e1s disfrutar de una potencia de hasta 1200W, reduciendo al m\u00ednimo el consumo energ\u00e9tico. Con el modo turbo, calentar\u00e1s r\u00e1pidamente una estancia con una potencia m\u00e1xima de hasta 2200 W. Y finalmente podr\u00e1s seleccionar tambi\u00e9n el modo ventilador. Es decir, podr\u00e1s seleccionar entre varios niveles de potencia totalmente ajustables a las necesidades de cada usuario y de cada circunstancia.GRAN \u00c1NGULO DE CALEFACCI\u00d3NEl calefactor cer\u00e1mico Ready Warm 10100 Smart Ceramic cuenta con el sistema Rotate Wind para ofrecer una oscilaci\u00f3n autom\u00e1tica de 90\u00ba. Gracias a este sistema se aumenta el \u00e1ngulo de calefacci\u00f3n para poder calentar las estancias aun m\u00e1s r\u00e1pido, ofreciendo una cobertura total. Distribuye el calor por toda tu estancia, proporcionando una amplia zona de confort.DIFUSI\u00d3N DEL CALOR POR TODA LA ESTANCIAGracias a su m\u00e1xima potencia de 2200 W en conjunto con su dise\u00f1o compacto hacen del Ready Warm 10100 Smart Ceramic el calefactor cer\u00e1mico perfecto para calentar r\u00e1pidamente estancias de entorno a los 22 m2, de forma eficiente.SISTEMA DE SEGURIDAD INTEGRALLa gama de calefactor cer\u00e1micos de Cecotec se caracteriza por ser un producto seguro en cualquier circunstancia. Toda la gama cuenta con el sistema ?Overprotect System? preparado para apagar el dispositivo en caso de detectar un sobrecalentamiento de este. Gracias a este sistema se evitar\u00e1n da\u00f1os tanto en el propio calefactor cer\u00e1mico como en la estancia en la cual se est\u00e9 utilizando. Adem\u00e1s, este calefactor cer\u00e1mico cuenta con el sistema de seguridad ?Tip-Over Safety System?. Integra en la parte posterior del dispositivo un peque\u00f1o sensor antivuelco, que en caso de desplazarse a una posici\u00f3n no habitual o caerse detiene el dispositivo al instante. Gracias a este sistema de seguridad evitar\u00e1s que en caso de caerse se provoque un posible incendio o problemas en el mismo dispositivo.CALIENTA TUS ESTANCIAS CON EL M\u00c1XIMO SILENCIO Y CONFORTDisfruta de tus estancias siempre a la temperatura que tu desees con un m\u00ednimo nivel sonoro de 30 dB, en la posici\u00f3n eco con una potencia de 1200 W. Podr\u00e1s mantener caldeadas tus estancias mientras descansas, te duchas, escuchas m\u00fasica?F\u00c1CIL DE TRANSPORTARNuestra nueva gama de calefactor cer\u00e1micos est\u00e1n dise\u00f1ados con el sistema ?Easy Go? para que puedas transportar f\u00e1cilmente el dispositivo a la estancia que desees calentar. Gracias a tu asa ergon\u00f3mica, su dise\u00f1o compacto y su ligereza podr\u00e1s desplazarlo y permanecer siempre con la estancia a la temperatura que desees.Calefactor cer\u00e1mico vertical de dise\u00f1o 2200 W. Digital. Mando a distancia. Pantalla LED. Temporizador. Potente. Termostato regulable. 3 modos. Protecci\u00f3n sobrecalentamiento y antivuelco. Silencioso. Ready Warm 10100 Smart Ceramic.- Calefactor cer\u00e1mico con gran potencia de 2200 W.- Termostato regulable con dos niveles de potencia para optimizar el consumo de energ\u00eda: m\u00ednima (1200 W) y m\u00e1xima (2200 W).- Dise\u00f1ado con Ceramic Technology que proporciona mayor eficiencia y seguridad gracias a su capacidad de PTC de autorregular la potencia de salida seg\u00fan el aumento de la temperatura. Adem\u00e1s, el calor se extiende r\u00e1pidamente hacia el punto que desees.- 3 modos de funcionamiento: Eco (1200 W), Turbo (2200 W) y Cool (funci\u00f3n ventilador).- Varios niveles de potencia totalmente ajustables a las necesidades de cada usuario.- Pantalla LED SmartControl y mando a distancia pr\u00e1ctico e intuitivo para controlar el calefactor de la forma m\u00e1s sencilla.- Warm Timer: temporizador programable hasta 8 horas transcurridas las cuales el calefactor se apaga autom\u00e1ticamente.- Su tecnolog\u00eda Warm Space es capaz de calentar 22 m\u00b2 de forma eficiente.- Filtro de part\u00edculas de polvo para atrapar las micropart\u00edculas y mantener limpios todos los componentes del calefactor ayudando a alargar la vida \u00fatil del dispositivo.- Protecci\u00f3n contra sobrecalentamiento Overprotect System y sistema AutoOff que apaga el calefactor autom\u00e1ticamente en caso de sobrecaliento para evitar da\u00f1os en el calefactor y la estancia.- Tecnolog\u00eda OnlySilence para disfrutar de un ambiente agradable con solo 30 dB.- Tip-over safety system: sensor antivuelco que en caso de desplazarse a una posici\u00f3n no habitual o caerse se detiene autom\u00e1ticamente.- Sistema EasyGo para un f\u00e1cil transporte. Cuenta con un mango ergon\u00f3mico para poder desplazarlo f\u00e1cilmente seg\u00fan tus necesidades y un ligero peso de 2,68 kg.- Adecuado para cada situaci\u00f3n, cuenta con VerticalDesign, que dota al producto de gran estabilidad, ligereza, tama\u00f1o reducido y buena manejabilidad.- Indicador luminoso de encendido.- Security yistem: rejilla de seguridad que impide el acceso al interior del calefactor cer\u00e1mico.","images":"https:\/\/www.dmi.es\/photo\/1658\/107561\/71231376\/bg\/calefactor-bano-ceramico-cecotec-ready-warm-10100-smart-ceramic-vertical-2000w.jpg","wholesale_price":"40.88","unit_price_tax":47.88},"product_model":{"product_data":{"ean13":["8435484053143"],"reference":"HO01330214","name":{"1":"CALEFACTOR BANO CERAMICO CECOTEC READY WARM 10100 SMART CERAMIC VERTICAL 2000W","2":"","3":"","4":""},"description":{"1":"AJUSTA LA POTENCIA Y LA TEMPERATURA A TUS NECESIDADESGracias a su tecnolog\u00eda ?Max Warm? y a su doble termostato regulable podr\u00e1s ajustar el nivel de potencia y la temperatura seg\u00fan las necesidades que tengas en cada circunstancia y en cada habitaci\u00f3n de tu hogar Este calefactor cer\u00e1mico ofrece una potencia m\u00e1xima de 2200 W. Podr\u00e1s seleccionar entre sus dos potencias (1200 W y 2200 W) Adem\u00e1s, tambi\u00e9n podr\u00e1s ajustar de forma precisa la temperatura.TECNOLOG\u00cdA CER\u00c1MICA PARA CALENTAR DE FORMA R\u00c1PIDA Y EFICIENTEGracias a su tecnolog\u00eda cer\u00e1mica podr\u00e1s calentar cualquier estancia de tu hogar de forma r\u00e1pida y eficiente. Este tipo de tecnolog\u00eda proporciona mayor eficiencia y seguridad gracias a su capacidad de PTC de autorregular la potencia de salida seg\u00fan el aumento de la temperatura. Adem\u00e1s, el calor se extiende r\u00e1pidamente hacia el punto que desees.SMART CONTROL: MANDO A DISTANCIA Y PANTALLA LCDEste calefactor cer\u00e1mico Ready Warm 10100 Smart Ceramic cuenta con un mando a distancia para que puedas controlarlo de manera f\u00e1cil e intuitiva. Podr\u00e1s encender o apagar el calefactor, seleccionar el modo que desees, escoger la opci\u00f3n de oscilaci\u00f3n y realizar la configuraci\u00f3n del temporizador. Adem\u00e1s, cuenta con una pantalla LCD para que puedas observar