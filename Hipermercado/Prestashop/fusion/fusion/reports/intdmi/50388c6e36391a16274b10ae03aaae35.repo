a para proteger la integridad de sus datos. La temperatura disminuye si se detecta un sobrecalentamiento, asegurando as\u00ed la m\u00e1xima protecci\u00f3n de su equipo.Instalaci\u00f3n sencillaGracias al software One-stop Install Navigator, podr\u00e1 migrar todos sus datos y aplicaciones desde donde est\u00e9n a los SSD 850 EVO. Y gracias al software Samsung Magician optimizar\u00e1 y gestionar\u00e1 su sistema de la forma m\u00e1s eficiente.Componentes de la mayor calidadSamsung es el \u00fanico fabricante de unidades SSD que dise\u00f1a y fabrica directamente todos los componentes. As\u00ed, sus tarjetas ofrecen un incre\u00edble rendimiento y menores fallos de compatibilidad.","2":"","3":"","4":""},"description_short":{"1":"250GB mSATA, SATA 6Gb\/s, 32 layer 3D V-NAND, 540 MB\/s Lectura, 520 MB\/s Escritura","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Samsung","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":111.27,"unit_price_tax":111.27,"tax_rules_group":null,"category":"Discos duros internos","brand":"Samsung","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/1563\/2338\/27325241\/bg\/ssd-samsung-850-evo-250gb-m-sata.jpg"],"wholesale_price":104.27}}},"6935364006167":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6935364006167",false],"wholesale_price":[17.99,false],"price":[24.99,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:214668","Cat. IDs: 125","Associated Categories","Cat. Default: 125","Deleted old image