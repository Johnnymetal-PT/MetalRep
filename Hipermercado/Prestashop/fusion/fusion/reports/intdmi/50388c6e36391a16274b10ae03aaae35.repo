r_name":"TP-Link","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":4005.84,"unit_price_tax":4005.84,"tax_rules_group":null,"category":"Switches y Transceptores","brand":"TP-Link","quantity":0,"images":["https:\/\/www.dmi.es\/photo\/258\/104952\/86111030\/bg\/omada-48-port-gigabit-stackable-l3-managed-poe+-switch-with-6-10g-slots.jpg"],"wholesale_price":3998.84}}},"6935364030421":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["6935364030421",false],"wholesale_price":[21.05,false],"price":[28.05,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:214679","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/1d323293009bae9a89ef58acf55026f5.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"CN44164008","unit_price":28.05,"category":"Adaptadores y Convertidores","brand":"TP-Link","name_pt":"CONVERTIDOR TP-LINK RJ45 10\/100 A FIBRA MONOMODO SC","quantity":5,"ean13":"6935364030421","description_short_pt":"MC112CS 1x 100M SC, 1x 100M RJ45, IEEE 802.3, IEEE 802.3u, IEEE 802.3x","description_pt":"- Cumple las normas 802.3u 10\/100Base-TX, 100Base-FX.- Adopta la tecnolog\u00eda WDM, transmite y recibe datos sobre una sola fibra \u00f3pticaEl MC112CS es un convertidor multimedia dise\u00f1ado para convertir fibra 100BASE-FX a cable 100Base-TX o viceversa.Con la tecnolog\u00eda WDM, el MC112CS solamente necesita un cable de fibra \u00f3ptica para transmitir y recibir datos, lo que le ahorra la mitad del coste del cableado.Dise\u00f1ado conforme a las normas IEEE 802.3u 10\/100Base-TX y 100Base-FX, el MC112CS se utiliza con fibra \u00f3ptica monomodo utilizando el conector SC.El MC112CS soporta l\u00e1ser de onda corta (SX) a una tasa de transferencia de velocidad completa de cable.Funciona a 1310nm transmitiendo datos y a 1550nm recibiendo datos.Por tanto, el aparato conectado al MC112CS debe funcionar a 1550nm transfiriendo datos y a 1310nm recibiendo datos.El convertidor multimedia MC111CS de TP-LINK es uno de los modelos que puede conectarse al MC112CS. Otras caracter\u00edsticas de este m\u00f3dulo son la posibilidad de uso como dispositivo independiente (sin necesidad de bastidor), Auto MDI\/MDI-X para el puerto TX, Autonegociaci\u00f3n de modo duplex en el puerto TX, y LEDs de estado en el panel frontal.El MC112CS transmite mediante fibra \u00f3ptica monomodo aumentando la distancia de la fibra hasta 20 kil\u00f3metros.","images":"https:\/\/www.dmi.es\/photo\/1008\/1950\/84144444\/bg\/convertidor-tp-link-rj45-10-100-a-fibra-monomodo-sc.jpg","wholesale_price":"21.05","unit_price_tax":28.05},"product_model":{"product_data":{"ean13":["6935364030421"],"reference":"CN44164008","name":{"1":"CONVERTIDOR TP-LINK RJ45 10\/100 A FIBRA MONOMODO SC","2":"","3":"","4":""},"description":{"1":"- Cumple las normas 802.3u 10\/100Base-TX, 100Base-FX.- Adopta la tecnolog\u00eda WDM, transmite y recibe datos sobre una sola fibra \u00f3pticaEl MC112CS es un convertidor multimedia dise\u00f1ado para convertir fibra 100BASE-FX a cable 100Base-TX o viceversa.Con la tecnolog\u00eda WDM, el MC112CS solamente necesita un cable de fibra \u00f3ptica para transmitir y recibir datos, lo que le ahorra la mitad del coste del cableado.Dise\u00f1ado conforme a las normas IEEE 802.3u 10\/100Base-TX y 100Base-FX, el MC112CS se utiliza con fibra \u00f3ptica monomodo utilizando el conector SC.El MC112CS soporta l\u00e1ser de onda corta (SX) a una tasa de transferencia de velocidad completa de cable.Funciona a 1310nm transmitiendo datos y a 1550nm recibiendo datos.Por tanto, el aparato conectado al MC112CS debe funcionar a 1550nm transfiriendo datos y a 1310nm recibiendo datos.El convertidor multimedia MC111CS de TP-LINK es uno de los modelos que puede conectarse al MC112CS. Otras caracter\u00edsticas de este m\u00f3dulo son la posibilidad de uso como dispositivo independiente (sin necesidad de bastidor), Auto MDI\/MDI-X para el puerto TX, Autonegociaci\u00f3n de modo duplex en el puerto TX, y LEDs de estado en el panel frontal.El MC112CS transmite mediante fibra \u00f3ptica monomodo aumentando la distancia de la fibra hasta 20 kil\u00f3metros.","2":"","3":"","4":""},"description_short":{"1":"MC112CS 1x 100M SC, 1x 100M RJ45, IEEE 802.3, IEEE 802.3u, IEEE 802.3x","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TP-Link","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":28.05,"unit_price_tax":28.05,"tax_rules_group":null,"category":"Adaptadores y Convertidores","brand":"TP-Link","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/1008\/1950\/84144444\/bg\/convertidor-tp-link-rj45-10-100-a-fibra-monomodo-sc.jpg"],"wholesale_price":21.05}}},"4897098683897":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4897098683897",false],"wholesale_price":[33.68,false],"price":[40.68,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:214680","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cd07cd2aefe26e26400ffe540d1e95cb.jpg; <br>---------------------