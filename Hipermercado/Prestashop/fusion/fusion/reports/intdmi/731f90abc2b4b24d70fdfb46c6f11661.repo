ut features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:196151","Cat. IDs: 89","Associated Categories","Cat. Default: 89","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/5d57ed93dcca5f04f7270120ea158c7c.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"GA30536054","unit_price":27.05,"category":"Perif\u00e9ricos","brand":"Deep Gaming","name_pt":"PACK GAMING DEEPX-WING2 SETUP 4 EN 1 TECLADO+RATON+AURICULARES MICRO+ALFOMBRILLA","quantity":5,"ean13":"8437011128188","description_short_pt":"Pack gaming DeepX-Wing 2","description_pt":"Setup gaming completo 4 en 1Incluye teclado de membrana, rat\u00f3n con DPI ajustable, auriculares con micr\u00f3fono y alfombrilla antideslizante.Combo gaming con excelente relaci\u00f3n calidad precio y todos los elementos necesarios para una \u00f3ptima experiencia en videojuegos: teclado con tecnolog\u00eda de membrana y teclado num\u00e9rico, auriculares de diadema con micr\u00f3fono flexible y control de volumen, rat\u00f3n \u00f3ptico RGB con resoluci\u00f3n ajustable y alfombrilla con base de goma antideslizante.AuricularesDisfruta de tus videojuegos en l\u00ednea favoritos como Fornite, Valorant, LoL o WoW con una comunicaci\u00f3n fluida con tus compa\u00f1eros de equipo. Con diadema acolchada ajustable, iluminaci\u00f3n LED con efecto rainbow, control de volumen y bot\u00f3n silenciador de micr\u00f3fono. Incluye adem\u00e1s conversor 2 en 1 para su uso en consolasRat\u00f3nEl rat\u00f3n cuenta con tecnolog\u00eda \u00f3ptica y 7 botones para poder asignar diferentes comandos en tus juegos. Resoluci\u00f3n ajustable de hasta 7200 DPI para adaptarse al control de cada usuario y 13 modos de iluminaci\u00f3n RGB para dar un toque de color a tu setup.Teclado + AlfombrillaTeclado con tecnolog\u00eda de membrana y distribuci\u00f3n ISO espa\u00f1ola de 105 teclas. Cuenta con iluminaci\u00f3n LED con ajuste de color y teclas WASD anti-ghosting.Mousepad antideslizante para el rat\u00f3n de 350 x 250 x 3 mm. De textura suave y de gran comodidad para un \u00f3ptimo desplazamiento del rat\u00f3n.","images":"https:\/\/www.dmi.es\/photo\/194\/105926\/82839464\/bg\/pack-gaming-deepx-wing2-setup-4-en-1-teclado+raton+auriculares-micro+alfombrilla.jpg","wholesale_price":"17.05","unit_price_tax":27.05},"product_model":{"product_data":{"ean13":["8437011128188"],"reference":"GA30536054","name":{"1":"PACK GAMING DEEPX-WING2 SETUP 4 EN 1 TECLADO+RATON+AURICULARES MICRO+ALFOMBRILLA","2":"","3":"","4":""},"description":{"1":"Setup gaming completo 4 en 1Incluye teclado de membrana, rat\u00f3n con DPI ajustable, auriculares con micr\u00f3fono y alfombrilla antideslizante.Combo gaming con excelente relaci\u00f3n calidad precio y todos los elementos necesarios para una \u00f3ptima experiencia en videojuegos: teclado con tecnolog\u00eda de membrana y teclado num\u00e9rico, auriculares de diadema con micr\u00f3fono flexible y control de volumen, rat\u00f3n \u00f3ptico RGB con resoluci\u00f3n ajustable y alfombrilla con base de goma antideslizante.AuricularesDisfruta de tus videojuegos en l\u00ednea favoritos como Fornite, Valorant, LoL o WoW con una comunicaci\u00f3n fluida con tus compa\u00f1eros de equipo. Con diadema acolchada ajustable, iluminaci\u00f3n LED con efecto rainbow, control de volumen y bot\u00f3n silenciador de micr\u00f3fono. Incluye adem\u00e1s conversor 2 en 1 para su uso en consolasRat\u00f3nEl rat\u00f3n cuenta con tecnolog\u00eda \u00f3ptica y 7 botones para poder asignar diferentes comandos en tus juegos. Resoluci\u00f3n ajustable de hasta 7200 DPI para adaptarse al control de cada usuario y 13 modos de iluminaci\u00f3n RGB para dar un toque de color a tu setup.Teclado + AlfombrillaTeclado con tecnolog\u00eda de membrana y distribuci\u00f3n ISO espa\u00f1ola de 105 teclas. Cuenta con iluminaci\u00f3n LED con ajuste de color y teclas WASD anti-ghosting.Mousepad antideslizante para el rat\u00f3n de 350 x 250 x 3 mm. De textura suave y de gran comodidad para un \u00f3ptimo desplazamiento del rat\u00f3n.","2":"","3":"","4":""},"description_short":{"1":"Pack gaming DeepX-Wing 2","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"Deep Gaming","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":27.05,"unit_price_tax":27.05,"tax_rules_group":null,"category":"Perif\u00e9ricos","brand":"Deep Gaming","quantity":5,"images":["https:\/\/www.dmi.es\/photo\/194\/105926\/82839464\/bg\/pack-gaming-deepx-wing2-setup-4-en-1-teclado+raton+auriculares-micro+alfombrilla.jpg"],"wholesale_price":17.05}}},"4719331759148":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4719331759148",false],"wholesale_price":[1656,false],"price":[1666,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:196152","Cat. IDs: 88","Associated Categories","Cat. Default: 88","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/1bb671f7d126ff5deb735d49ce973bab.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"PT051541161","unit_price":1666,"category":"Port\u00e1tiles","brand":"Gigabyte","name_pt":"PORTATIL GIGABYTE AORUS 16X ASG-53ESC54SH I7-14650HX 4070 16GB 1TB+16\"W11H","quantity":0,"ean13":"4719331759148","description_short_pt":"Gigabyte AORUS 16X ASG-53ESC54SH, Intel\u00ae Core? i7, 40,6 cm (16\"), 2560 x 1600 Pixeles, 32 GB, 1 TB, Windows 11 Home","description_pt":"