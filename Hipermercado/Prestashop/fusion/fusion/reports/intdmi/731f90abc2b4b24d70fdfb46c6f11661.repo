_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:196083","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/cb4710fb35c905d053b96f1cdbfa5d50.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"AU01243544","unit_price":45.19,"category":"Auriculares","brand":"Motorola","name_pt":"AURICULARES MOTOROLA MOTO BUDS GREEN","quantity":5,"ean13":"0840023266218","description_short_pt":"50\u00a0dB, Dolby Atmos, Hi-Res Audio, Bluetooth 5.3, kiwi green","description_pt":"Siente la m\u00fasica\u00bfEst\u00e1s preparado para escuchar y sentir la diferencia con los moto buds? Disfruta del sonido equilibrado con graves mejorados gracias a un controlador din\u00e1mico de gran tama\u00f1o, Dolby Atmos\u00ae1 y sonido de alta resoluci\u00f3n2. Elige el nivel de reducci\u00f3n de ruido y configura, personaliza y controla f\u00e1cilmente tu experiencia auditiva. No se te escapar\u00e1 ni un sonido con los moto buds.Sonido equilibrado y audaz. Graves excepcionales.Sube el volumen cuando escuches tus canciones favoritas con un controlador din\u00e1mico de 12,4 mm y sum\u00e9rgete en el sonido multidimensional de Dolby Atmos.Siente el sonido como t\u00fa quierasBloquea los sonidos del exterior con la reducci\u00f3n avanzada de ruido o escucha m\u00fasica y lo que te rodea con el modo de transparencia.Configuraci\u00f3n perfectaUtiliza la aplicaci\u00f3n de Moto Buds para vincular los auriculares, personalizar los controles y los ajustes de la reducci\u00f3n de ruido, etc.Que el ritmo no parePodr\u00e1s escuchar m\u00fasica durante un m\u00e1ximo de 9 horas en una \u00fanica sesi\u00f3n3 y disfrutar de hasta 42 horas de reproducci\u00f3n con la funda totalmente cargada.Sonido siempre ultran\u00edtidoCon el sistema de micr\u00f3fono triple en cada moto bud y un algoritmo de antisaturaci\u00f3n, escuchar\u00e1s tu voz, incluso en entornos ruidosos o cuando las condiciones climatol\u00f3gicas sean adversas.Dise\u00f1o impresionante y avanzadoPodr\u00e1s caminar en d\u00edas de lluvia o realizar entrenamientos intensos gracias a su moderno dise\u00f1o repelente al agua4. Adem\u00e1s, podr\u00e1s elegir entre una variedad de colores divertidos y llamativos.","images":"https:\/\/www.dmi.es\/photo\/1637\/106208\/91873554\/bg\/auriculares-motorola-moto-buds-green.jpg","wholesale_price":"35.19","unit_price_tax":45.19},"product_model":{"product_data":{"ean13":["0840023266218"],"reference":"AU01243544","name":{"1":"AURICULARES MOTOROLA MOTO BUDS GREEN","2":"","3":"","4":""},"description":{"1":"Siente la m\u00fasica\u00bfEst\u00e1s preparado para escuchar y sentir la diferencia con los moto buds? Disfruta del sonido equilibrado con graves mejorados gracias a un controlador din\u00e1mico de gran tama\u00f1o, Dolby Atmos\u00ae1 y sonido de alta resoluci\u00f3n2. Elige el nivel de reducci\u00f3n de ruido y configura, personaliza y controla f\u00e1cilmente tu experiencia auditiva. No se te escapar\u00e1 ni un sonido con los moto buds.Sonido equilibrado y audaz. Graves excepcionales.Sube el volumen cuando escuches tus canciones favoritas con un controlador din\u00e1mico de 12,4 mm y sum\u00e9rgete en el sonido multidimensional de Dolby Atmos.Siente el sonido como t\u00fa quierasBloquea los sonidos del exterior con la reducci\u00f3n avanzada de ruido o escucha m\u00fasica y lo que te rodea con el modo de transparencia.Configuraci\u00f3n perfectaUtiliza la aplicaci\u00f3n de Moto Buds para vincular los auriculares, personalizar los controles y los ajustes de la reducci\u00f3n de ruido, etc.Que el ritmo no parePodr\u00e1s escuchar m\u00fasica durante un m\u00e1ximo de 9 horas en una \