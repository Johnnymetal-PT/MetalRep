o.pt\/img\/p\/4\/1\/9\/9\/4\/4\/419944.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/4\/1\/9\/9\/4\/4\/419944.jpg","quantity":0,"images":["https:\/\/experteletro.pt\/img\/p\/4\/1\/9\/9\/4\/4\/419944.jpg"],"sub_category":"Fornos","wholesale_price":529.43}}},"7332543681808":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["7332543681808",false],"wholesale_price":[1406.77,false],"price":[1416.77,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:82272","Cat. IDs: 4,42","Associated Categories","Cat. Default: 4","Deleted old images","New images created","Add: \/home\/users\/hipermercado\/www\/hipermercado.pt\/img\/tmp\/4df860701708f26fcd9eefdfe643cb7d.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"02.652.004.00079","ean13":"7332543681808","category":"Eletrodom\u00e9sticos","brand":"AEG","name_pt":"AEG - Forno BSK999330M","description_pt":"<b>DETALHES DO PRODUTO<\/b>\nForno a vapor CookView com Comando Mastery, 24 fun\u00e7\u00f5es de aquecimento (4 a Vapor), Sensor de humidade Steamify, Cozedura a V\u00e1cuo, Sonda T\u00e9rmica, Display TFT, Fecho Suave da Porta, Calhas telesc\u00f3picas de 1 n\u00edvel, INOX Anti dedadas <b>VEJA SE O SEU ASSADO EST\u00c1 PRONTO<\/b>\nPara saber quando o seu prato est\u00e1 cozinhado s\u00f3 precisa de olhar para ele. E pode faz\u00ea-lo a qualquer momento, mesmo estando fora da cozinha. Com a c\u00e2mara CookView da AEG, \u00e9 poss\u00edvel acompanhar remotamente a evolu\u00e7\u00e3o do seu assado a partir do seu smartphone. <b>TECNOLOGIA STEAMIFY, A QUANTIDADE CERTA DE VAPOR AUTOMATICAMENTE<\/b>\nCom a fun\u00e7\u00e3o Steamify, defina a temperatura e o forno ajustar\u00e1 o n\u00edvel de vapor automaticamente. Para alimentos mais saud\u00e1veis e saborosos. A cozedura a vapor eleva os sabores e preserva os nutrientes. Com Steamify, \u00e9 f\u00e1cil cozinhar com vapor. <b>FUN\u00c7\u00c3O DE COZEDURA EM V\u00c1CUO, TEXTURA E SABOR \u00daNICOS<\/b>\nA fun\u00e7\u00e3o SousVide d\u00e1-lhe o poder da t\u00e9cnica cozedura em v\u00e1cuo usada por chefs profissionais para que a comida fique mais saborosa, tenra e cozinhada na perfei\u00e7\u00e3o. <b>APP MY AEG KITCHEN, A SUA ASSISTENTE DE COZINHA<\/b>\nMonitorize o forno remotamente, explore receitas e menus, tudo atrav\u00e9s da aplica\u00e7\u00e3o My AEG Kitchen. \u00c9 uma forma conveniente e f\u00e1cil de elevar a sua experi\u00eancia culin\u00e1ria a outro n\u00edvel. <b>COZINHE DE FORMA MAIS INTELIGENTE<\/b>\nControlo intuitivo das fun\u00e7\u00f5es do forno no display atrav\u00e9s do comando rotativo. Navegue pelos programas, defina a dura\u00e7\u00e3o e selecione fun\u00e7\u00f5es e programas com a ajuda dos intuitivos controlos do forno. E receba todos dos updates do processo culin\u00e1rio atrav\u00e9s do seu smartphone, gra\u00e7as \u00e0 conetividade WiFi.","unit_price":1416.77,"description_short_pt":" <b>PRINC. CARACTER\u00cdSTICAS: <\/b><br\/><b>Cap. (L):<\/b> 70<br\/><b>Cor:<\/b> Inox + Preto<br\/><b>Efic. Energ.:<\/b> A++<br\/><b>Pot\u00eancia:<\/b> 3500<br\/><b>Auto-Limpeza:<\/b> VaporClean","image":"https:\/\/experteletro.pt\/img\/p\/4\/1\/9\/9\/4\/5\/419945.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/4\/1\/9\/9\/4\/5\/419945.jpg","quantity":0,"images":["https:\/\/experteletro.pt\/img\/p\/4\/1\/9\/9\/4\/5\/419945.jpg"],"sub_category":"Fornos","wholesale_price":"1406.77","unit_price_tax":1416.77},"product_model":{"product_data":{"ean13":["7332543681808"],"reference":"02.652.004.00079","name":{"1":"AEG - Forno BSK999330M","2":"","3":"","4":""},"description":{"1":"<b>DETALHES DO PRODUTO<\/b>\nForno a vapor CookView com Comando Mastery, 24 fun\u00e7\u00f5es de aquecimento (4 a Vapo