---"],"result":true},"feed_data":{"reference":"01.805.003.00275","ean13":"3420744772600","category":"TV, Audio e V\u00eddeo","brand":"METRONIC","name_pt":"METRONIC - R\u00e1dio Internet WiFi 477260","description_pt":"","unit_price":53.7,"description_short_pt":" <b>PRINC. CARACTER\u00cdSTICAS: <\/b><br \/><b>Cor:<\/b> Cinzento<br \/><b>Tipo:<\/b> R\u00e1dio Despertador","image":"https:\/\/experteletro.pt\/img\/p\/2\/0\/4\/0\/9\/8\/204098.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/2\/0\/4\/0\/9\/8\/204098.jpg","quantity":2,"images":["https:\/\/experteletro.pt\/img\/p\/2\/0\/4\/0\/9\/8\/204098.jpg"],"sub_category":"R\u00e1dios e Despertadores","wholesale_price":"48.70","unit_price_tax":53.7},"product_model":{"product_data":{"ean13":["3420744772600"],"reference":"01.805.003.00275","name":{"1":"METRONIC - R\u00e1dio Internet WiFi 477260","2":"","3":"","4":""},"description":{"1":"","2":"","3":"","4":""},"description_short":{"1":" <b>PRINC. CARACTER\u00cdSTICAS: <\/b><br \/><b>Cor:<\/b> Cinzento<br \/><b>Tipo:<\/b> R\u00e1dio Despertador","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"METRONIC","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":53.7,"unit_price_tax":53.7,"tax_rules_group":null,"category":"TV, Audio e V\u00eddeo","brand":"METRONIC","image":"https:\/\/experteletro.pt\/img\/p\/2\/0\/4\/0\/9\/8\/204098.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/2\/0\/4\/0\/9\/8\/204098.jpg","quantity":2,"images":["https:\/\/experteletro.pt\/img\/p\/2\/0\/4\/0\/9\/8\/204098.jpg"],"sub_category":"R\u00e1dios e Despertadores","wholesale_price":48.7}}},"8435430611755":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8435430611755",false],"wholesale_price":[10.77,false],"price":[15.77,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 6 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:217821","Cat. IDs: 64","Associated Categories","Cat. Default: 64","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/e183b787f1d083906463a1a186301738.jpg; <br>Add: \/home\/hipermercado\/public_html\/img\/tmp\/abdc196c410cab5c7a55c4ee00c60b1e.jpg; <br>Add: \/home\/hipermercado\/public_html\/img\/tmp\/1e5293b352a790bb19fa841eb0c6ff9e.jpg; <br>Add: \/home\/hipermercado\/public_html\/img\/tmp\/6f6ddd26d855180ab1dc4fb717a70fab.jpg; <br>Add: \/home\/hipermercado\/public_html\/img\/tmp\/f3334c86514ae8de54822d256ca71736.jpg; <br>Add: \/home\/hipermercado\/public_html\/img\/tmp\/9957a32529e98524e09326eccc5cca61.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"01.805.003.00322","ean13":"8435430611755","category":"TV, Audio e V\u00eddeo","brand":"NGS","name_pt":"NGS - R\u00e1dio Despertador SUNRISEHIT","description_pt":"Torne as suas manh\u00e3s menos dif\u00edceis, combinando as caracter\u00edsticas essenciais de um dispositivo de mesa-de-cabeceira com um som claro, tudo num design compacto.\\n\\nO NGS Sunrise Hit, um \u00e9 um r\u00e1dio despertador digital ideal para o uso di\u00e1rio, desde o ecr\u00e3 LED azul aos bot\u00f5es f\u00e1ceis de usar que ajustam o volume, procuram esta\u00e7\u00f5es de r\u00e1dio e programam o alarme. \\n\\nO grande ecr\u00e3 LED de 0,6'' permite f\u00e1cil leitura do conte\u00fado do ecr\u00e3. Agora pode ver as horas e o alarme facilmente, mesmo \u00e0 dist\u00e2ncia.\\n\\nAcorde com o tradicional alarme sonoro incorporado ou com a sua esta\u00e7\u00e3o de r\u00e1dio AM\/FM favorita. Basta definir o alarme no seu r\u00e1dio NGS Sunrise Hit para acordar com a esta\u00e7\u00e3o de r\u00e1dio que ouviu pela \u00faltima vez ou optar por acordar com um alarme sonoro.\\n\\nQuando chega a hora de despertar, o r\u00e1dio liga-se automaticamente na esta\u00e7\u00e3o de r\u00e1dio ou ativa o alarme sonoro.\\n\\nO NGS Sunrise Hit permite-lhe selecionar rapidamente at\u00e9 20 esta\u00e7\u00f5es \u00e0 sua escolha (10 FM\/10 AM). Basta sintonizar a esta\u00e7\u00e3o que deseja programar, premir e manter premido o bot\u00e3o de programa\u00e7\u00e3o para memorizar a frequ\u00eancia.\\n\\nCom esta\u00e7\u00f5es de r\u00e1dio pr\u00e9-programadas que podem ser armazenadas, pode aceder rapidamente \u00e0 sua esta\u00e7\u00e3o de r\u00e1dio favorita sem ter de sintonizar as frequ\u00eancias manualmente a cada vez. FM 88-108 MHz e AM 522-1620 kHz\\n\\nO radiodespertador digital tem capacidade de alarme dupla, recurso que permite configurar dois alarmes para horas diferentes.\\n\\nA fun\u00e7\u00e3o Sleep permite-lhe decidir durante quanto tempo deseja ouvir m\u00fasica ou uma esta\u00e7\u00e3o de r\u00e1dio antes de adormecer. Com o bot\u00e3o Sleep, pode colocar o seu r\u00e1dio em suspens\u00e3o ap\u00f3s um per\u00edodo de tempo definido.\\n\\nO NGS Sunrise Hit continuar\u00e1 a tocar durante o tempo selecionado (90, 80, 70, 60, 50, 40, 30, 20, 10 min) e depois desligar-se-\u00e1 automaticamente.\\n\\nSe quiser dormir um pouco mais, o radiodespertador tamb\u00e9m tem a fun\u00e7\u00e3o Snooze. Se o alarme tocar e quiser continuar a dormir, basta premir o bot\u00e3o Snooze uma vez e voltar a dormir. Nove minutos depois, o alarme tocar\u00e1 novamente.\\n\\nPode continuar a premir o bot\u00e3o Snooze a cada nove minutos, ou premir o bot\u00e3o POWER para desligar o alarme definitivamente.\\n\\nAl\u00e9m disso, em caso de falha de energia, o r\u00e1dio-despertador possui um sistema de reserva de bateria (DC 1x CR2032) que mant\u00e9m as configura\u00e7\u00f5es de hora e alarme.","unit_price":15.77,"description_short_pt":" <b>PRINC. CARACTER\u00cdSTICAS: <\/b><br \/><b>Cor:<\/b> Preto<br \/><b>Tipo:<\/b> R\u00e1dio Despertador","image":"https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/0\/326620.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/0\/326620.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/1\/326621.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/2\/326622.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/3\/326623.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/4\/326624.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/5\/326625.jpg","quantity":2,"images":["https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/0\/326620.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/1\/326621.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/2\/326622.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/3\/326623.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/4\/326624.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/5\/326625.jpg"],"sub_category":"R\u00e1dios e Despertadores","wholesale_price":"10.77","unit_price_tax":15.77},"product_model":{"product_data":{"ean13":["8435430611755"],"reference":"01.805.003.00322","name":{"1":"NGS - R\u00e1dio Despertador SUNRISEHIT","2":"","3":"","4":""},"description":{"1":"Torne as suas manh\u00e3s menos dif\u00edceis, combinando as caracter\u00edsticas essenciais de um dispositivo de mesa-de-cabeceira com um som claro, tudo num design compacto.\\n\\nO NGS Sunrise Hit, um \u00e9 um r\u00e1dio despertador digital ideal para o uso di\u00e1rio, desde o ecr\u00e3 LED azul aos bot\u00f5es f\u00e1ceis de usar que ajustam o volume, procuram esta\u00e7\u00f5es de r\u00e1dio e programam o alarme. \\n\\nO grande ecr\u00e3 LED de 0,6'' permite f\u00e1cil leitura do conte\u00fado do ecr\u00e3. Agora pode ver as horas e o alarme facilmente, mesmo \u00e0 dist\u00e2ncia.\\n\\nAcorde com o tradicional alarme sonoro incorporado ou com a sua esta\u00e7\u00e3o de r\u00e1dio AM\/FM favorita. Basta definir o alarme no seu r\u00e1dio NGS Sunrise Hit para acordar com a esta\u00e7\u00e3o de r\u00e1dio que ouviu pela \u00faltima vez ou optar por acordar com um alarme sonoro.\\n\\nQuando chega a hora de despertar, o r\u00e1dio liga-se automaticamente na esta\u00e7\u00e3o de r\u00e1dio ou ativa o alarme sonoro.\\n\\nO NGS Sunrise Hit permite-lhe selecionar rapidamente at\u00e9 20 esta\u00e7\u00f5es \u00e0 sua escolha (10 FM\/10 AM). Basta sintonizar a esta\u00e7\u00e3o que deseja programar, premir e manter premido o bot\u00e3o de programa\u00e7\u00e3o para memorizar a frequ\u00eancia.\\n\\nCom esta\u00e7\u00f5es de r\u00e1dio pr\u00e9-programadas que podem ser armazenadas, pode aceder rapidamente \u00e0 sua esta\u00e7\u00e3o de r\u00e1dio favorita sem ter de sintonizar as frequ\u00eancias manualmente a cada vez. FM 88-108 MHz e AM 522-1620 kHz\\n\\nO radiodespertador digital tem capacidade de alarme dupla, recurso que permite configurar dois alarmes para horas diferentes.\\n\\nA fun\u00e7\u00e3o Sleep permite-lhe decidir durante quanto tempo deseja ouvir m\u00fasica ou uma esta\u00e7\u00e3o de r\u00e1dio antes de adormecer. Com o bot\u00e3o Sleep, pode colocar o seu r\u00e1dio em suspens\u00e3o ap\u00f3s um per\u00edodo de tempo definido.\\n\\nO NGS Sunrise Hit continuar\u00e1 a tocar durante o tempo selecionado (90, 80, 70, 60, 50, 40, 30, 20, 10 min) e depois desligar-se-\u00e1 automaticamente.\\n\\nSe quiser dormir um pouco mais, o radiodespertador tamb\u00e9m tem a fun\u00e7\u00e3o Snooze. Se o alarme tocar e quiser continuar a dormir, basta premir o bot\u00e3o Snooze uma vez e voltar a dormir. Nove minutos depois, o alarme tocar\u00e1 novamente.\\n\\nPode continuar a premir o bot\u00e3o Snooze a cada nove minutos, ou premir o bot\u00e3o POWER para desligar o alarme definitivamente.\\n\\nAl\u00e9m disso, em caso de falha de energia, o r\u00e1dio-despertador possui um sistema de reserva de bateria (DC 1x CR2032) que mant\u00e9m as configura\u00e7\u00f5es de hora e alarme.","2":"","3":"","4":""},"description_short":{"1":" <b>PRINC. CARACTER\u00cdSTICAS: <\/b><br \/><b>Cor:<\/b> Preto<br \/><b>Tipo:<\/b> R\u00e1dio Despertador","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"NGS","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":15.77,"unit_price_tax":15.77,"tax_rules_group":null,"category":"TV, Audio e V\u00eddeo","brand":"NGS","image":"https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/0\/326620.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/0\/326620.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/1\/326621.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/2\/326622.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/3\/326623.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/4\/326624.jpg,https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/5\/326625.jpg","quantity":2,"images":["https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/0\/326620.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/1\/326621.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/2\/326622.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/3\/326623.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/4\/326624.jpg","https:\/\/experteletro.pt\/img\/p\/3\/2\/6\/6\/2\/5\/326625.jpg"],"sub_category":"R\u00e1dios e Despertadores","wholesale_price":10.77}}},"8007403072711":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8007403072711",false],"wholesale_price":[29.37,false],"price":[34.37,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["Create 1 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_al