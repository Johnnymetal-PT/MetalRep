4\/1\/5\/2\/4\/3\/415243.jpg,https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/4\/415244.jpg,https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/5\/415245.jpg,https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/6\/415246.jpg","quantity":0,"images":["https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/3\/415243.jpg","https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/4\/415244.jpg","https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/5\/415245.jpg","https:\/\/experteletro.pt\/img\/p\/4\/1\/5\/2\/4\/6\/415246.jpg"],"sub_category":"Outros Acess\u00f3rios","wholesale_price":31.66}}},"4897098685686":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["4897098685686",false],"wholesale_price":[92.47,false],"price":[97.47,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 2 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:173972","Cat. IDs: 3","Associated Categories","Cat. Default: 3","Deleted old images","New images created","Add: \/home\/hipermercado\/public_html\/img\/tmp\/171e1adb182224b4470d8d50f890ece9.jpg; <br>Add: \/home\/hipermercado\/public_html\/img\/tmp\/853f84764ec5070b0c95a8d21e5228a2.jpg; <br>-------------------------------"],"result":true},"feed_data":{"reference":"04.697.001.00004","ean13":"4897098685686","category":"Inform\u00e1tica","brand":"TP-LINK","name_pt":"TP-LINK - V\u00eddeo Porteiro TAPO D230S1","description_pt":"<b>Inteligente. Seguro. F\u00e1cil.<\/b><br>Saber sempre quem est\u00e1 l\u00e1<br>Tapo Kit V\u00eddeo Porteiro Inteligente a Bateria<br><br><b>2K 5MP Visualiza\u00e7\u00e3o ao Vivo<\/b><br>Saiba sempre o que acontece em frente \u00e0 sua porta atrav\u00e9s da aplica\u00e7\u00e3o Tapo. Com o sensor de luz inteligente e a resolu\u00e7\u00e3o de 2K 5MP, verifique todos os pequenos detalhes capturados mesmo em ambientes com pouca luz.<br><br><b>Vis\u00e3o Noturna a Cores<\/b><br>Com o miniprojector incorporado e o sensor de luz inteligente, o Tapo D230S1 revela detalhes de alta-fidelidade e a cores mesmo \u00e0 noite.<br><br><b>Visibilidade Integral<\/b><br>Com uma lente ultra-wide FOV(160\u00b0 Diagonal) da c\u00e2mara, a vista 4:3 ao vivo na aplica\u00e7\u00e3o Tapo, assegura que pode visualizar os visitantes da cabe\u00e7a aos p\u00e9s t\u00e3o perto como 1m\u2020, que mostra mais detalhes verticais do que outros 16:9 campainhas de porta'.<br><br><b>Coloca\u00e7\u00e3o Flex\u00edvel, Vistas Flex\u00edveis<\/b><br>As diferentes escolhas de instala\u00e7\u00e3o, permite aos utilizadores ter uma campainha de porta nos mais diversos cen\u00e1rios. Os utilizadores podem utilizar as Base de instala\u00e7\u00e3o para ajustar o que for necess\u00e1rio para o local ideal.<br><br><b>Longer Battery Life<\/b><br>A bateria recarreg\u00e1vel e amov\u00edvel com um protocolo de baixo consumo prolonga a sua utiliza\u00e7\u00e3o.<br><br><b>Person and Vehicles Detection<\/b><br>Powerful Al identifies people or vehicles, notifying users with filtered notifications.<br><br><b>Multiple Ways to Answer<\/b><br>With two-way audio or a recorded quick response, communicate directly with your deliveries through the Tapo app.<br><br><b>Indoor Chime Provided<\/b><br>Choose from a variety of ringtones to get alerted immediately when you are at home.<br><br><b>Flexible Storage Choice<\/b><br>Save recorded videos on the hub-installed microSD card\u00a7 (up to 512 GB) or by using Tapo Care\u25b3 cloud storage services.<br><br><b>Anti-theft Alarm<\/b><br>Be alerted when someone tries to take the doorbell off with the anti-theft alarm function.","unit_price":97.47,"description_short_pt":"","image":"https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/1\/537881.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/1\/537881.jpg,https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/2\/537882.jpg","quantity":0,"images":["https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/1\/537881.jpg","https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/2\/537882.jpg"],"sub_category":"C\u00e2maras","wholesale_price":"92.47","unit_price_tax":97.47},"product_model":{"product_data":{"ean13":["4897098685686"],"reference":"04.697.001.00004","name":{"1":"TP-LINK - V\u00eddeo Porteiro TAPO D230S1","2":"","3":"","4":""},"description":{"1":"<b>Inteligente. Seguro. F\u00e1cil.<\/b><br>Saber sempre quem est\u00e1 l\u00e1<br>Tapo Kit V\u00eddeo Porteiro Inteligente a Bateria<br><br><b>2K 5MP Visualiza\u00e7\u00e3o ao Vivo<\/b><br>Saiba sempre o que acontece em frente \u00e0 sua porta atrav\u00e9s da aplica\u00e7\u00e3o Tapo. Com o sensor de luz inteligente e a resolu\u00e7\u00e3o de 2K 5MP, verifique todos os pequenos detalhes capturados mesmo em ambientes com pouca luz.<br><br><b>Vis\u00e3o Noturna a Cores<\/b><br>Com o miniprojector incorporado e o sensor de luz inteligente, o Tapo D230S1 revela detalhes de alta-fidelidade e a cores mesmo \u00e0 noite.<br><br><b>Visibilidade Integral<\/b><br>Com uma lente ultra-wide FOV(160\u00b0 Diagonal) da c\u00e2mara, a vista 4:3 ao vivo na aplica\u00e7\u00e3o Tapo, assegura que pode visualizar os visitantes da cabe\u00e7a aos p\u00e9s t\u00e3o perto como 1m\u2020, que mostra mais detalhes verticais do que outros 16:9 campainhas de porta'.<br><br><b>Coloca\u00e7\u00e3o Flex\u00edvel, Vistas Flex\u00edveis<\/b><br>As diferentes escolhas de instala\u00e7\u00e3o, permite aos utilizadores ter uma campainha de porta nos mais diversos cen\u00e1rios. Os utilizadores podem utilizar as Base de instala\u00e7\u00e3o para ajustar o que for necess\u00e1rio para o local ideal.<br><br><b>Longer Battery Life<\/b><br>A bateria recarreg\u00e1vel e amov\u00edvel com um protocolo de baixo consumo prolonga a sua utiliza\u00e7\u00e3o.<br><br><b>Person and Vehicles Detection<\/b><br>Powerful Al identifies people or vehicles, notifying users with filtered notifications.<br><br><b>Multiple Ways to Answer<\/b><br>With two-way audio or a recorded quick response, communicate directly with your deliveries through the Tapo app.<br><br><b>Indoor Chime Provided<\/b><br>Choose from a variety of ringtones to get alerted immediately when you are at home.<br><br><b>Flexible Storage Choice<\/b><br>Save recorded videos on the hub-installed microSD card\u00a7 (up to 512 GB) or by using Tapo Care\u25b3 cloud storage services.<br><br><b>Anti-theft Alarm<\/b><br>Be alerted when someone tries to take the doorbell off with the anti-theft alarm function.","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"TP-LINK","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":97.47,"unit_price_tax":97.47,"tax_rules_group":null,"category":"Inform\u00e1tica","brand":"TP-LINK","image":"https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/1\/537881.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/1\/537881.jpg,https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/2\/537882.jpg","quantity":0,"images":["https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/1\/537881.jpg","https:\/\/experteletro.pt\/img\/p\/5\/3\/7\/8\/8\/2\/537882.jpg"],"sub_category":"C\u00e2maras","wholesale_price":92.47}}},"8806095085937":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8806095085937",false],"wholesale_price":[84.53,false],"price":[89.53,false],"id_tax_rules_group":[1,false],"categorys":["1 categorys",false],"weight":["Product weight is 0",true],"images":["Create 3 images",false],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:17397