ca lateral de modo a ajustar a inclina\u00e7\u00e3o do encosto para um posicionamento at\u00e9 180 graus. Tamb\u00e9m podes ajustar a altura do assento at\u00e9 7 cm, trancando-o na tua posi\u00e7\u00e3o preferida. Independentemente da tua altura, a Alegra adapta-se a ti.","2":"","3":"","4":""},"description_short":{"1":"","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"ALPHA GAMER","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":215.49,"unit_price_tax":215.49,"tax_rules_group":null,"category":"Inform\u00e1tica","brand":"ALPHA GAMER","image":"https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/3\/129563.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/3\/129563.jpg,https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/4\/129564.jpg,https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/5\/129565.jpg,https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/6\/129566.jpg,https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/7\/129567.jpg","quantity":2,"images":["https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/3\/129563.jpg","https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/4\/129564.jpg","https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/5\/129565.jpg","https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/6\/129566.jpg","https:\/\/experteletro.pt\/img\/p\/1\/2\/9\/5\/6\/7\/129567.jpg"],"sub_category":"Cadeiras Gaming","wholesale_price":210.49}}},"12973000A0896":{"result":false,"need_alert":false,"report":{"notes":{"product":["",false],"ean13":["12973000A0896",false],"wholesale_price":[97.1,false],"price":[100.1,false],"id_tax_rules_group":[1,false],"categorys":["",false],"weight":["",false],"images":["",false],"tags":["",false],"features":["",false],"combinations":["",false]},"need_alert":false,"errors":["A propriedade Product->ean13 n\u00e3o \u