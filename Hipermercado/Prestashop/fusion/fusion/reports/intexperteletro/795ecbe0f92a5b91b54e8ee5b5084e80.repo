n<b>Miniaturas animadas<\/b>\\nAs miniaturas animadas simplificam a selec\u00e7\u00e3o de ficheiros. Assim que selecciona uma miniatura, a imagem come\u00e7a a animar, o que lhe permite ver o que est\u00e1 no ficheiro, sem ter que entrar no modo de reprodu\u00e7\u00e3o.","2":"","3":"","4":""},"description_short":{"1":" <b>PRINC. CARACTER\u00cdSTICAS: <\/b><br \/><b>Cor:<\/b> Preto<br \/><b>Sup. Escrita:<\/b> Cart\u00e3o SD<br \/><b>Resolu\u00e7\u00e3o:<\/b> 0.8 MP","2":"","3":"","4":""},"meta_description":{"1":"","2":"","3":"","4":""},"meta_keywords":{"1":"","2":"","3":"","4":""},"meta_title":{"1":"","2":"","3":"","4":""},"link_rewrite":{"1":"","2":"","3":"","4":""},"visibility":"both","manufacturer_name":"SAMSUNG","supplier":null,"width":null,"height":null,"depth":null,"weight":null,"unit_price":111.51,"unit_price_tax":111.51,"tax_rules_group":null,"category":"TV, Audio e V\u00eddeo","brand":"SAMSUNG","image":"https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/1\/251971.jpg","galeria":"https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/1\/251971.jpg,https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/2\/251972.jpg,https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/3\/251973.jpg","quantity":2,"images":["https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/1\/251971.jpg","https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/2\/251972.jpg","https:\/\/experteletro.pt\/img\/p\/2\/5\/1\/9\/7\/3\/251973.jpg"],"sub_category":"C\u00e2maras de V\u00eddeo","wholesale_price":106.51}}},"8712836992269":{"result":true,"need_alert":true,"report":{"notes":{"product":["",false],"ean13":["8712836992269",false],"wholesale_price":[16.84,false],"price":[21.84,false],"id_tax_rules_group":[1,false],"categorys":["2 categorys",false],"weight":["Product weight is 0",true],"images":["No images",true],"tags":["Product without tags",false],"features":["Product without features",true],"combinations":["Product without combinations",true]},"need_alert":true,"errors":["Create product ID:200317","Cat. IDs: 4,4