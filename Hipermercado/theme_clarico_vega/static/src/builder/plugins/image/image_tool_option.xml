<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="theme_clarico_vega.ImageToolOptionExt" t-inherit="html_builder.ImageToolOption" t-inherit-mode="extension">
    <xpath expr="." position="inside">
        <BuilderRow label.translate="Hotspot">
            <BuilderButtonGroup>
                <BuilderButton title.translate="On" action="'onHotspot'" id="'hotspot_on'">ON</BuilderButton>
                <BuilderButton title.translate="Off" action="'offHotspot'" id="'hotspot_off'">OFF</BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>

    </xpath>
</t>

</templates>
