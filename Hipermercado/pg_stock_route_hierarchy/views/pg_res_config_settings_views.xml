<odoo>
    <record id="pg_view_res_config_settings_stock_route_hierarchy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pg.stock.route.hierarchy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="PG Stock Hierarchy">
                    <setting string="Primary Sales Warehouse">
                        <field name="pg_sale_primary_warehouse_id"/>
                    </setting>
                    <setting string="Secondary Sales Warehouse">
                        <field name="pg_sale_secondary_warehouse_id"/>
                    </setting>
                    <setting string="Store Warehouse">
                        <field name="pg_sale_store_warehouse_id"/>
                    </setting>
                    <setting string="Virtual Supplier Warehouse">
                        <field name="pg_supplier_virtual_warehouse_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
