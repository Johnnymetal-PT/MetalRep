<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_projects_button" model="ir.ui.view">
        <field name="name">product.template.form.projects.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button name="action_view_related_projects"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-folder-open"
                        >
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="project_usage_count" widget="statinfo"/>
                        </span>
                        <span class="o_stat_text">Projetos</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_form_projects_button" model="ir.ui.view">
        <field name="name">product.product.form.projects.button</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button name="action_view_related_projects"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-folder-open"
                        >
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="project_variant_usage_count" widget="statinfo"/>
                        </span>
                        <span class="o_stat_text">Projetos</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
