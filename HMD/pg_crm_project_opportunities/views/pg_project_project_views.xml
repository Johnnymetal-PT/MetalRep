<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pg_project_project_view_form_inherit_crm_opportunities" model="ir.ui.view">
        <field name="name">project.project.form.inherit.pg.crm.opportunities</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    name="action_pg_view_crm_opportunities"
                    icon="fa-briefcase"
                    groups="sales_team.group_sale_salesman"
                >
                    <field name="pg_crm_opportunity_count" widget="statinfo" string="CRM Opportunities"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

