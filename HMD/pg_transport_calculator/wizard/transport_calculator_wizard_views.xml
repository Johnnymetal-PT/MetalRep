<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pg_transport_calculator_wizard_form" model="ir.ui.view">
        <field name="name">pg.transport.calculator.wizard.form</field>
        <field name="model">pg.transport.calculator.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculadora de Transporte">
                <field name="order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="country_name"/>
                        <field name="zone_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="target_line_id"/>
                        <field name="fuel_surcharge"/>
                        <field name="client_margin" readonly="1"/>
                        <field name="pallet_fee" readonly="1"/>
                    </group>
                </group>
                <separator string="Embalagens"/>
                <field name="package_line_ids">
                    <list editable="bottom">
                        <field name="package_type"/>
                        <field name="width"/>
                        <field name="length"/>
                        <field name="height"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <div class="oe_right">
                    <button name="action_calculate" type="object" string="Calcular / Comparar" class="btn-primary"/>
                </div>
                <field name="info" invisible="not info" readonly="1" nolabel="1"/>
                <separator string="Comparacao de Transportadoras" invisible="not result_line_ids"/>
                <field name="result_line_ids" invisible="not result_line_ids">
                    <list create="false" edit="false" decoration-success="is_cheapest and not has_error" decoration-danger="has_error">
                        <field name="carrier_id"/>
                        <field name="mode"/>
                        <field name="total_m3" optional="hide"/>
                        <field name="total_ldm" optional="hide"/>
                        <field name="total_weight"/>
                        <field name="scaled_weight" string="Peso tarif." optional="hide"/>
                        <field name="rate_label" string="Escalão"/>
                        <field name="rate_value" string="Valor escalão" optional="hide"/>
                        <field name="cost" string="Custo Base"/>
                        <field name="fuel_surcharge_pct" string="Sobretaxa %" optional="hide"/>
                        <field name="operational_cost" string="Custo Oper." optional="hide"/>
                        <field name="pallet_total" string="Paletes" optional="hide"/>
                        <field name="is_cheapest" string="Melhor"/>
                        <field name="cost_money" string="Valor Final"/>
                        <field name="messages" string="Avisos / Notas"/>
                        <field name="has_error" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <button name="action_apply" type="object" string="Aplicar" class="btn-link" icon="fa-check" invisible="has_error"/>
                    </list>
                </field>
                <footer>
                    <button string="Fechar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pg_transport_calculator_wizard" model="ir.actions.act_window">
        <field name="name">Calculadora de Transporte</field>
        <field name="res_model">pg.transport.calculator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
