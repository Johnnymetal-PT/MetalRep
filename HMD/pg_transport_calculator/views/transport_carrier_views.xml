<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Transportadora ============ -->
    <record id="view_pg_transport_carrier_list" model="ir.ui.view">
        <field name="name">pg.transport.carrier.list</field>
        <field name="model">pg.transport.carrier</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="carrier_type"/>
                <field name="conv_m3"/>
                <field name="conv_ldm"/>
                <field name="rate_count"/>
            </list>
        </field>
    </record>

    <record id="view_pg_transport_carrier_form" model="ir.ui.view">
        <field name="name">pg.transport.carrier.form</field>
        <field name="model">pg.transport.carrier</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_rates" class="oe_stat_button" icon="fa-list">
                            <field name="rate_count" widget="statinfo" string="Tarifas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nome da transportadora"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="carrier_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="conv_m3"/>
                            <field name="conv_ldm"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pg_transport_carrier" model="ir.actions.act_window">
        <field name="name">Transportadoras</field>
        <field name="res_model">pg.transport.carrier</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Tarifa por destino ============ -->
    <record id="view_pg_transport_rate_list" model="ir.ui.view">
        <field name="name">pg.transport.rate.list</field>
        <field name="model">pg.transport.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="carrier_id"/>
                <field name="country_name"/>
                <field name="zone_code"/>
                <field name="minimum"/>
            </list>
        </field>
    </record>

    <record id="view_pg_transport_rate_form" model="ir.ui.view">
        <field name="name">pg.transport.rate.form</field>
        <field name="model">pg.transport.rate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="carrier_id"/>
                            <field name="carrier_type"/>
                        </group>
                        <group>
                            <field name="country_name"/>
                            <field name="zone_code"/>
                            <field name="minimum"/>
                        </group>
                    </group>
                    <field name="tier_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="code"/>
                            <field name="weight_from"/>
                            <field name="weight_to"/>
                            <field name="price"/>
                            <field name="flat"/>
                            <field name="scale_floor"/>
                            <field name="scale_cap"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pg_transport_rate_search" model="ir.ui.view">
        <field name="name">pg.transport.rate.search</field>
        <field name="model">pg.transport.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="country_name"/>
                <field name="zone_code"/>
                <field name="carrier_id"/>
                <filter name="national" string="Nacional" domain="[('carrier_type','=','national')]"/>
                <filter name="international" string="Internacional" domain="[('carrier_type','=','international')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_carrier" string="Transportadora" context="{'group_by':'carrier_id'}"/>
                    <filter name="g_country" string="Pais" context="{'group_by':'country_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pg_transport_rate" model="ir.actions.act_window">
        <field name="name">Tarifas de Transporte</field>
        <field name="res_model">pg.transport.rate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pg_transport_rate_search"/>
    </record>

    <!-- ============ Avisos / regras configuraveis ============ -->
    <record id="view_pg_transport_warning_list" model="ir.ui.view">
        <field name="name">pg.transport.warning.list</field>
        <field name="model">pg.transport.warning</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level"/>
                <field name="carrier_id" placeholder="Todas"/>
                <field name="country_name" placeholder="Todos"/>
                <field name="zone_code" placeholder="Todas"/>
                <field name="text"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pg_transport_warning_form" model="ir.ui.view">
        <field name="name">pg.transport.warning.form</field>
        <field name="model">pg.transport.warning</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Quando aplicar">
                            <field name="carrier_id" placeholder="Todas as transportadoras"/>
                            <field name="country_name" placeholder="Todos os países"/>
                            <field name="zone_code" placeholder="Todas as zonas"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Mensagem"/>
                    <field name="text" placeholder="Texto do aviso mostrado no cálculo..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pg_transport_warning" model="ir.actions.act_window">
        <field name="name">Avisos / Regras</field>
        <field name="res_model">pg.transport.warning</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Menus ============ -->
    <menuitem id="menu_pg_transport_root" name="Transporte"
              parent="sale.menu_sale_config" sequence="50"
              groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_pg_transport_carrier" name="Transportadoras"
              parent="menu_pg_transport_root" action="action_pg_transport_carrier" sequence="10"/>
    <menuitem id="menu_pg_transport_rate" name="Tarifas"
              parent="menu_pg_transport_root" action="action_pg_transport_rate" sequence="20"/>
    <menuitem id="menu_pg_transport_warning" name="Avisos / Regras"
              parent="menu_pg_transport_root" action="action_pg_transport_warning" sequence="30"/>

</odoo>
