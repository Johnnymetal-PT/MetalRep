<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_pg_transport" model="ir.ui.view">
        <field name="name">res.config.settings.form.pg.transport</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="standardized_offers_setting" position="after">
                <setting id="pg_transport_product_setting"
                         string="Produto de Transporte"
                         help="Produto cuja linha recebe o valor calculado pela Calculadora de Transporte.">
                    <field name="pg_transport_product_id"/>
                </setting>
                <setting id="pg_transport_pricing_setting"
                         string="Calculadora de Transporte — Preço"
                         help="Parâmetros da cadeia de preço: sobretaxa de combustível (default), margem cliente e valor por palete.">
                    <div class="row">
                        <label string="Sobretaxa de Combustível (%) por defeito" for="pg_transport_fuel_surcharge" class="col-lg-8 o_light_label"/>
                        <field name="pg_transport_fuel_surcharge" class="col-lg-4"/>
                    </div>
                    <div class="row">
                        <label string="Margem Cliente (%)" for="pg_transport_client_margin" class="col-lg-8 o_light_label"/>
                        <field name="pg_transport_client_margin" class="col-lg-4"/>
                    </div>
                    <div class="row">
                        <label string="Valor por Palete (€)" for="pg_transport_pallet_fee" class="col-lg-8 o_light_label"/>
                        <field name="pg_transport_pallet_fee" class="col-lg-4"/>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
