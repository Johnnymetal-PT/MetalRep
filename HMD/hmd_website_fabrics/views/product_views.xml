<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Separador proprio em vez de encaixar o campo num grupo existente.

        Motivo: os grupos do formulario de produto sao alvo de heranca de meia
        duzia de modulos (website_sale, sale, purchase, os nossos), e um xpath
        para dentro deles e a coisa mais facil de partir num upgrade. Um
        <page> novo dentro do //notebook nao colide com ninguem.
    -->
    <record id="product_template_form_fabric" model="ir.ui.view">
        <field name="name">product.template.form.hmd.fabric</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tecido" name="hmd_fabric">
                    <group>
                        <field name="hmd_fabric_category"/>
                        <field name="hmd_fabric_family" readonly="1"/>
                        <field name="hmd_fabric_composition"
                               placeholder="Ex.: 100% linho"/>
                        <field name="hmd_fabric_care_image" widget="image"
                               options="{'size': [0, 120]}"/>
                    </group>
                    <p class="text-muted">
                        A categoria decide em que secção o tecido aparece na
                        página /fabrics. C.O.M. é tecido trazido pelo cliente e
                        não acresce ao preço do móvel.
                        A composição e as instruções de limpeza são da série:
                        as cores desta série partilham o que aqui estiver.
                        Aparecem nas especificações do tecido, na página do
                        tecido e na página de produto. A ficha técnica
                        anexa-se em Documentos, com "Publicar no site" ligado.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
