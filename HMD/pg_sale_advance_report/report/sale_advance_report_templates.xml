<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_advances">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page o_adv_report">
                    <style>
                        .o_adv_report h2 { margin-bottom: 2px; }
                        .o_adv_report .o_adv_meta { font-size: 10px; color: #444; margin-bottom: 6px; }
                        .o_adv_report table.o_adv_table { width: 100%; border-collapse: collapse; font-size: 8.5px; }
                        .o_adv_report table.o_adv_table th { background-color: #2F5496; color: #ffffff; padding: 4px 5px; text-align: right; font-weight: bold; }
                        .o_adv_report table.o_adv_table th.l { text-align: left; }
                        .o_adv_report table.o_adv_table td { padding: 3px 5px; border-bottom: 1px solid #e3e3e3; vertical-align: top; }
                        .o_adv_report table.o_adv_table tbody tr:nth-child(even) td { background-color: #f4f7fb; }
                        .o_adv_report .num { text-align: right; white-space: nowrap; }
                        .o_adv_report .col-cli { width: 22%; }
                        .o_adv_report .col-ord { width: 9%; white-space: nowrap; }
                        .o_adv_report table.o_adv_table tfoot td { font-weight: bold; border-top: 2px solid #000; background-color: #eef2f9; padding: 5px; }
                        .o_adv_report .o_adv_note { font-size: 8px; color: #777; margin-top: 8px; }
                    </style>

                    <h2>Controlo de Adiantamentos</h2>
                    <div class="o_adv_meta">
                        <strong>Empresa:</strong> <span t-out="company.name"/>
                        <t t-if="date_from or date_to">
                            &amp;nbsp;&amp;bull;&amp;nbsp;
                            <strong>Periodo:</strong>
                            <span t-out="date_from or '--'"/> a <span t-out="date_to or '--'"/>
                        </t>
                    </div>

                    <table class="o_adv_table">
                        <thead>
                            <tr>
                                <th class="l col-ord">Encomenda</th>
                                <th class="l col-cli">Cliente</th>
                                <th>Total s/IVA</th>
                                <th>Total c/IVA</th>
                                <th>Adiant. fat. s/IVA</th>
                                <th>Adiant. fat. c/IVA</th>
                                <th>Adiant. pagamento</th>
                                <th>Total adiantado</th>
                                <th>%</th>
                                <th>Por receber</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lines" t-as="l">
                                <td class="col-ord" t-out="l['order']"/>
                                <td class="col-cli" t-out="l['partner']"/>
                                <td class="num"><span t-out="l['untaxed']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="l['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="l['adv_inv_unt']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="l['adv_inv_tot']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="l['adv_paid']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="l['adv_total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="l['pct']" t-options="{'widget': 'float', 'precision': 1}"/>%</td>
                                <td class="num"><span t-out="l['residual']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="l" colspan="2">TOTAIS</td>
                                <td class="num"><span t-out="totals['untaxed']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="totals['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="totals['adv_inv_unt']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="totals['adv_inv_tot']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="totals['adv_paid']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"><span t-out="totals['adv_total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="num"></td>
                                <td class="num"><span t-out="totals['residual']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <p t-if="not lines" class="text-muted">Sem adiantamentos no periodo selecionado.</p>

                    <div class="o_adv_note">
                        "Adiant. fatura" = faturas de adiantamento emitidas (valor bruto, antes da regularizacao na fatura final).
                        "Adiant. pagamento" = adiantamentos registados via sale_advance_payment.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
