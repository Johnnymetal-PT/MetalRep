<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_pg_intrastat_hs_code" model="ir.ui.view">
        <field name="name">account.move.form.pg.intrastat.hs.code</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Coluna HS Code na lista de linhas (edição normal em rascunho) -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='quantity']" position="before">
                <field name="pg_intrastat_code_id"
                       string="Código HS"
                       optional="show"
                       options="{'no_create': True}"
                       domain="[('type', '=', 'commodity')]"/>
            </xpath>
            <!-- Campo HS Code no sub-formulário da linha -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="after">
                <field name="pg_intrastat_code_id"
                       string="Código HS"
                       options="{'no_create': True}"
                       domain="[('type', '=', 'commodity')]"/>
            </xpath>

            <!-- Aba "Intrastat": edição focada dos 3 campos, inclusive em faturas publicadas.
                 Não desbloqueia preço/conta/quantidade (não estão nesta lista). -->
            <xpath expr="//page[@id='invoice_tab']" position="after">
                <page id="pg_intrastat_tab"
                      string="Intrastat"
                      invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <field name="pg_intrastat_line_ids">
                        <list editable="bottom" create="0" delete="0" string="Linhas Intrastat">
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" readonly="1" optional="show"/>
                            <field name="name" readonly="1" optional="hide"/>
                            <field name="intrastat_transaction_id"
                                   string="Intrastat"
                                   options="{'no_create': True}"
                                   context="{
                                       'search_view_ref': 'account_intrastat.view_intrastat_code_restricted_type_search',
                                       'form_view_ref': 'account_intrastat.view_intrastat_code_restricted_type_form',
                                       'default_type': 'transaction'}"
                                   domain="[
                                       ('type', '=', 'transaction'),
                                       '|', ('expiry_date', '&gt;', parent.date or context_today().strftime('%Y-%m-%d')), ('expiry_date', '=', None),
                                       '|', ('start_date', '&lt;=', parent.date or context_today().strftime('%Y-%m-%d')), ('start_date', '=', None)
                                   ]"/>
                            <field name="intrastat_product_origin_country_id"
                                   string="País do Produto"
                                   options="{'no_create': True}"/>
                            <field name="pg_intrastat_code_id"
                                   string="Código HS"
                                   options="{'no_create': True}"
                                   domain="[('type', '=', 'commodity')]"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
