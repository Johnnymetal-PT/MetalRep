<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_phc_history" model="ir.ui.view">
        <field name="name">res.partner.form.phc.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="currency_id" invisible="1"/>
                <field name="phc_history_amount" groups="sales_team.group_sale_salesman"/>
                <field name="phc_customer_number" groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_phc_history" model="ir.ui.view">
        <field name="name">res.partner.list.phc.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="currency_id" column_invisible="True"/>
                <field name="phc_history_amount" optional="hide" sum="Total" groups="sales_team.group_sale_salesman"/>
                <field name="phc_customer_number" optional="hide" groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_phc_history" model="ir.ui.view">
        <field name="name">res.partner.search.phc.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter string="Com histórico PHC" name="with_phc_history"
                        domain="[('phc_history_amount', '!=', 0)]"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="phc_customer_number" groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
