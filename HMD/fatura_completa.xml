<t t-name="account.report_invoice_document_complete">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-if="o.source_billing" t-set="pt_certification_text" t-value="o.pt_get_certification_text()"/>
                <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
                <div class="row">
                    <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                        <div class="col-6">
                            <t t-set="information_block">
                                <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                    <strong class="d-block mt-3">Endereço de Envio</strong>
                                    <div t-field="o.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                                </div>
                            </t>
                        </div>
                        <div class="col-6" name="address_not_same_as_shipping">
                            <t t-set="address">
                                <address class="mb-0" t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                                <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping" t-att-style="'display: none;' if o.source_billing else ''">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                    <t t-else="">NIF</t>: <span t-field="o.partner_id.vat"/>
                                </div>
                                <div t-if="o.partner_id.country_code == 'MA' and o.partner_id.company_registry">
                                    ICE: <a t-field="o.partner_id.company_registry"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-elif="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
                        <div class="offset-col-6 col-6" name="address_same_as_shipping">
                            <t t-set="address">
                                <address class="mb-0" t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                                <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping" t-att-style="'display: none;' if o.source_billing else ''">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                    <t t-else="">NIF</t>: <span t-field="o.partner_id.vat"/>
                                </div>
                                <div t-if="o.partner_id.country_code == 'MA' and o.partner_id.company_registry">
                                    ICE: <a t-field="o.partner_id.company_registry"/>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="offset-col-6 col-6" name="no_shipping">
                            <t t-set="address">
                                <address class="mb-0" t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                                <div t-if="o.partner_id.vat" id="partner_vat_no_shipping" t-att-style="'display: none;' if o.source_billing else ''">
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                                    <t t-else="">NIF</t>: <span t-field="o.partner_id.vat"/>
                                </div>
                                <div t-if="o.partner_id.country_code == 'MA' and o.partner_id.company_registry">
                                    ICE: <a t-field="o.partner_id.company_registry"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
                <div class="clearfix invoice_main">
                    <div class="page mb-4">
                        <t t-set="layout_document_title" t-if="not o.source_billing">
                            <span t-if="not proforma"/>
                            <span t-else="">PROFORMA</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Fatura</span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Fatura em Rascunho</span>
                            <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Fatura Cancelada</span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Nota de Crédito</span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Nota de Crédito em Rascunho</span>
                            <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Nota de crédito cancelada</span>
                            <span t-elif="o.move_type == 'in_refund'">Nota de Crédito de Fornecedor</span>
                            <span t-elif="o.move_type == 'in_invoice'">Fatura de Fornecedor</span>
                            <span t-if="o.name and o.name != '/'" t-field="o.name">INV/2023/00001</span>
                        </t>
            <div t-if="o.source_billing" class="row pt_doc_name">
                <div class="col-10">
                    <h2>
                        <span t-out="o.pt_get_fullname(lang=o.partner_id.lang)"/>
                        <span t-if="o.state == 'cancel'" t-field="o.state" class="pt_cancelled"/>
                    </h2>
                </div>
                <div t-if="multiway_tag" class="col-2 text-end" style="padding-top: 3mm">
                    <span class="pt_multiway_tag" t-out="multiway_tag"/>
                </div>
            </div>
                        <div class="oe_structure">
      <br/></div>
                        <div id="informations" class="row mb-4" t-if="o.invoice_date or (o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted') or o.delivery_date or o.invoice_origin or o.partner_id.ref or o.ref or o.invoice_incoterm_id">
                            <div class="col" t-if="not o.source_billing" name="invoice_date">
                                <t t-if="o.move_type == 'out_invoice'"><strong>Data da Fatura</strong></t>
                                <t t-elif="o.move_type == 'out_refund'"><strong>Data da Nota de Crédito</strong></t>
                                <t t-elif="o.move_type == 'out_receipt'"><strong>Data de Recebimento</strong></t>
                                <t t-else=""><strong>Data</strong></t>
                                <div t-field="o.invoice_date">12-09-2023</div>
                            </div>
            <!-- Use label Invoice Date with plain Date -->
            <div class="col" t-if="o.source_billing and o.invoice_date">
                <strong>Data</strong>
                <div t-field="o.invoice_date"/>
            </div>
            <!-- Add Vat No. -->
            <div class="col" t-if="o.source_billing and o.partner_id.vat">
                <strong>
                    <t t-out="o.company_id.country_id.vat_label or 'Tax ID'"/>
                </strong>
                <div t-out="o.partner_id.pt_get_vat()"/>
            </div>
                            <div class="col" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                                <strong>Data Vencimento</strong>
                                <div t-field="o.invoice_date_due">31-10-2023</div>
                            </div>
                            <div class="col" t-if="o.delivery_date" name="delivery_date">
                                <strong>Data de Entrega</strong>
                                <div t-field="o.delivery_date">25-09-2023</div>
                            </div>
                            <div class="col" t-if="not o.source_billing" name="origin">
                                <strong>Origem:</strong>
                                <div t-field="o.invoice_origin">SO123</div>
                            </div>
            <div class="col" t-if="o.source_billing and o.invoice_origin" name="pt_origin">
                <strong>Origem:</strong>
                <t t-set="pt_pickings" t-value="o.picking_ids.filtered(lambda p: p.system_entry_date)"/>
                <div t-if="pt_pickings" t-out="', '.join(pt_pickings.mapped('name'))"/>
                <div t-else="" t-field="o.invoice_origin"/>
            </div>
                            <div class="col" t-if="o.partner_id.ref" name="customer_code">
                                <strong>Código do Cliente</strong>
                                <div t-field="o.partner_id.ref"/>
                            </div>
                            <div class="col" t-if="o.ref" name="reference">
                                <strong>Referência</strong>
                                <div t-field="o.ref">INV/2023/00001</div>
                            </div>
                            <div class="col" t-if="o.invoice_incoterm_id" name="incoterm_id">
                                <strong>Incoterm</strong>
                                <div t-if="o.incoterm_location">
                                    <span t-field="o.invoice_incoterm_id.code"/> <br/>
                                    <span t-field="o.incoterm_location"/>
                                </div>
                                <div t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                            </div>
                        </div>

                        <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
            <t t-set="display_origin" t-value="any(l.intrastat_product_origin_country_id for l in o.invoice_line_ids)"/>
            <t t-set="display_intrastat" t-value="any(l.intrastat_transaction_id for l in o.invoice_line_ids)"/>
            <t t-set="display_hs" t-value="any(l.pg_intrastat_code_id for l in o.invoice_line_ids)"/>
                        <div class="oe_structure">
      <br/></div>
                        <t t-set="has_long_desc" t-value="any(line.name and line.name.count('\n') &gt; 30 for line in o.invoice_line_ids if line.name)"/>
                        <table class="o_has_total_table table o_main_table table-borderless mb-0" name="invoice_line_table" style="font-size: 8pt;">
                            <thead t-attf-style="#{has_long_desc and 'display: table-row-group;' or ''}">
                                <tr>
                                    <th name="th_description" class="text-start"><span>Descrição </span></th>
                                    <th name="th_quantity" class="text-center"><span>Quantidade </span></th>
                                    <th name="th_priceunit" t-attf-class="text-center text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Preço Unitário </span></th>
                                    <th name="th_discount" t-if="display_discount" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span>Desc.%</span>
                                    </th>
                                    <th name="th_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Impostos</span></th>
                                    <th name="th_subtotal" class="text-center">
                                        <span>Montante</span>
                                    </th>
            <th name="th_origin" class="text-center" t-if="display_origin"><span>País do Produto</span></th>
            <th name="th_intrastat" class="text-center" t-if="display_intrastat"><span>Intrastat</span></th>
            <th name="th_hs" class="text-center" t-if="display_hs"><span>Código HS</span></th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="current_total" t-value="0"/>
                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                <t t-foreach="lines" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                    <t t-set="current_total" t-value="current_total + line.price_total"/>

                                    <tr t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="line.display_type == 'product' and (not o.source_billing or line.is_downpayment or (o.source_billing and line.price_subtotal &gt;= 0))" name="account_invoice_line_accountable">
                                            <td name="account_invoice_line_name">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Hambúrguer de bacon</span>
                                            </td>
                                            <td name="td_quantity" class="o_td_quantity text-center">
                                                <span t-field="line.quantity" class="text-nowrap">3,00</span>
                                                <span t-field="line.product_uom_id" groups="uom.group_uom">unidades</span>
                                            </td>
                                            <td name="td_price_unit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span class="text-nowrap" t-field="line.price_unit">9,00</span>
                                            </td>
                                            <td name="td_discount" t-if="display_discount" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                                <span class="text-nowrap" t-field="line.discount">0</span>
                                            </td>
                                            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                            <td name="td_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                <span t-out="taxes" id="line_tax_ids" t-if="not o.source_billing">Imposto de 15%</span>
            <span t-else="" class="pt_vat_list" t-foreach="line.tax_ids" t-as="tax">
                <span t-out="tax.invoice_label or tax.name"/>
                <span class="pt_vat_exemption_reason" t-if="tax.pt_vat_exemption_reason" t-out="tax.pt_vat_exemption_reason"/>
            </span>
                                            </td>
                                            <td name="td_subtotal" class="text-center o_price_total">
                                                <span class="text-nowrap" t-field="line.price_subtotal">27,00</span>
                                            </td>
            <td name="td_origin" class="text-center" t-if="display_origin">
                <span t-field="line.intrastat_product_origin_country_id"/>
            </td>
            <td name="td_intrastat" class="text-center" t-if="display_intrastat">
                <span t-if="line.intrastat_transaction_id" t-field="line.intrastat_transaction_id.code"/>
                <span t-else="">NA</span>
            </td>
            <td name="td_hs" class="text-center" t-if="display_hs">
                <span t-if="line.pg_intrastat_code_id" t-field="line.pg_intrastat_code_id.code"/>
                <span t-else="">NA</span>
            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td colspan="99">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Um título de seção</span>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td colspan="99">
                                                <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Uma anotação cujo conteúdo se aplica à seção ou artigo de produto acima.</span>
                                            </td>
                                        </t>
                                    </tr>

                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                        <tr class="is-subtotal text-end">
                                            <td colspan="99">
                                                <strong class="mr16">Subtotal </strong>
                                                <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}">31,05</span>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                        <div class="overflow-hidden">
                            <div id="right-elements" t-attf-class="#{'col-5 mt-5' if report_type == 'pdf' else 'col-12 col-md-5'} ms-5 d-inline-block float-end">
                                <div id="total" class="clearfix row">
                                    <div class="ms-auto">
            <t t-set="is_pt_pt" t-value="(lang or '').replace('-', '_') == 'pt_PT'"/>
            <t t-set="invoice_product_lines" t-value="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product' and (not o.source_billing or line.is_downpayment or line.price_subtotal &gt;= 0))"/>
            <t t-set="downpayment_lines" t-value="invoice_product_lines.filtered(lambda line: line.is_downpayment or any(sl.is_downpayment for sl in line.sale_line_ids) or 'down payment' in (line.name or '').lower() or 'adiantamento' in (line.name or '').lower())"/>
            <t t-set="has_downpayments" t-value="len(downpayment_lines) &gt; 0"/>
            <t t-set="all_invoice_lines_are_downpayments" t-value="len(invoice_product_lines) &gt; 0 and len(invoice_product_lines) == len(downpayment_lines)"/>
                                        <table class="o_total_table table table-borderless avoid-page-break-inside">

                                            <!-- Tax totals summary (invoice currency) -->
                                            <t t-if="o.source_billing">
                <t t-set="amount_without_discount" t-value="0"/>
                <t t-set="discount_amount" t-value="0"/>
                <t t-foreach="lines" t-as="discount_line">
                    <t t-if="discount_line.price_unit &gt;= 0">
                        <t t-set="amount_without_discount" t-value="amount_without_discount + discount_line.price_subtotal"/>
                    </t>
                    <t t-if="discount_line.price_unit &lt; 0 and not discount_line.is_downpayment">
                        <t t-set="discount_amount" t-value="discount_amount + discount_line.price_subtotal"/>
                    </t>
                </t>

                <tr t-if="discount_amount" class="border-black o_subtotal">
                    <td>
                        <strong>Subtotal</strong>
                    </td>
                    <td class="text-end">
                        <span t-out="amount_without_discount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </td>
                </tr>

                <t t-foreach="lines" t-as="discount_line">
                    <tr t-if="amount_without_discount &gt;= 0 and discount_line.price_subtotal &lt; 0 and not discount_line.is_downpayment">
                        <td>
                            <span t-esc="discount_line.name"/>
                            <span t-att-class="'pt_vat_list' if discount_line.tax_ids.filtered(lambda t: t.pt_vat_exemption_reason) else ''" t-foreach="discount_line.tax_ids" t-as="tax">
                                <span class="pt_vat_exemption_reason" t-if="tax.pt_vat_exemption_reason" t-out="tax.pt_vat_exemption_reason"/>
                            </span>
                        </td>
                        <td class="text-end o_price_total">
                            <span class="text-nowrap" t-out="discount_line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        </td>
                    </tr>
                </t>
            </t>

            <t t-if="has_downpayments">
                <t t-set="downpayment_total" t-value="sum(abs(line.price_total) for line in downpayment_lines)"/>
                <t t-set="order_total" t-value="o.amount_total + downpayment_total"/>

                <tr class="o_subtotal">
                    <td>
                        <span t-out="'Valor sem Impostos' if is_pt_pt else 'Untaxed Amount'"/>
                    </td>
                    <td class="text-end">
                        <span t-field="o.amount_untaxed"/>
                    </td>
                </tr>
                <tr>
                    <td>
                        <span t-out="'IVA' if is_pt_pt else 'VAT'"/>
                    </td>
                    <td class="text-end">
                        <span t-field="o.amount_tax"/>
                    </td>
                </tr>
                <tr class="border-black o_subtotal">
                    <td>
                        <strong t-out="'Total' if all_invoice_lines_are_downpayments else ('Total Restante' if is_pt_pt else 'Remaining Total')"/>
                    </td>
                    <td class="text-end">
                        <span t-field="o.amount_total"/>
                    </td>
                </tr>
                <tr t-if="not all_invoice_lines_are_downpayments">
                    <td>
                        <span t-out="'Total da Encomenda' if is_pt_pt else 'Order Total'"/>
                    </td>
                    <td class="text-end">
                        <span t-out="order_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </td>
                </tr>
            </t>
            <t t-if="not has_downpayments and o.tax_totals" t-call="account.document_tax_totals_copy_1">
                <t t-set="tax_totals" t-value="o.tax_totals"/>
                <t t-set="currency" t-value="o.currency_id"/>
            </t>
        <!--Payments-->
                                            <t t-if="print_with_payments">
                                                <t t-if="o.payment_state != 'invoicing_legacy'">
                                                    <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                                        <tr t-if="payment_vals['is_exchange'] == 0">
                                                            <td>
                                                                <i class="oe_form_field text-end oe_payment_label">
                                                                    <t t-if="payment_vals['is_refund']">Revertido em </t>
                                                                    <t t-else="">Paga em </t>
                                                                    <t t-out="payment_vals['date']" t-options="{&quot;widget&quot;: &quot;date&quot;}">19-09-2021</t>
                                                                </i>
                                                            </td>
                                                            <td class="text-end">
                                                                <span t-out="payment_vals['amount']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}">20,00</span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                    <t t-if="len(payments_vals) &gt; 0">
                                                        <tr class="fw-bold">
                                                            <td>Valor em Dívida</td>
                                                            <td class="text-end">
                                                                <span t-field="o.amount_residual">11.05</span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                        </table>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                                        Valor total por extenso: <br/>
                                        <small class="text-muted lh-sm"><span t-field="o.amount_total_words">Trinta e um dólares e cinco cêntimos</span></small>
                                    </p>
                                </div>

                                <!-- Tax totals summary (company currency) -->
                                <t t-if="o.tax_totals.get('display_in_company_currency')">
                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                    <t t-call="account.document_tax_totals_company_currency_template_copy_1"/>
                                </t>
                                <t t-else="">
                                    <div class="oe_structure">
      <br/></div>
                                </t>
