<odoo>
    <record id="view_sale_order_line_price_calculator" model="ir.ui.view">
        <field name="name">sale.order.line.price.calculator.form</field>
        <field name="model">sale.order.line.price.calculator</field>
        <field name="arch" type="xml">
            <form string="Calculadora de Preço">
                <group>
                    <field name="sale_line_id" invisible="1"/>
                    <field name="cost_price"/>
                    <field name="margin_type"/>
                    <field name="margin_value"/>
                    <field name="margin_amount" readonly="1"/>
                    <field name="computed_price" readonly="1"/>
                    <field name="observation" placeholder="Adicionar observação..."/>
                </group>
                <footer>
                    <button name="action_apply" string="Calcular" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
