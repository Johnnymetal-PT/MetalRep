<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="web_editor.toolbar" t-inherit-mode="extension">
        <xpath expr="//div[@id='font-size']" position="after">
            <div id="hmd-local-typography" t-if="!this.isSmall()" t-attf-class="btn-group {{ props.dropDirection }}">
                <button type="button"
                    class="btn dropdown-toggle"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    tabindex="-1"
                    data-bs-original-title="Local typography"
                    aria-expanded="false">
                    <i class="fa fa-text-width" title="Local typography"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end o_hmd_local_typography_menu p-3">
                    <div class="mb-3">
                        <label for="hmdFontFamilyCurrentValue" class="form-label">Font family</label>
                        <select id="hmdFontFamilyCurrentValue" class="form-select form-select-sm">
                            <option value="">Inherited</option>
                        </select>
                        <button type="button" id="hmdAddCustomFontButton" class="btn btn-outline-light btn-sm w-100 mt-2">
                            Add custom font
                        </button>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label for="hmdLocalFontSizeCurrentValue" class="form-label">Font size</label>
                            <input id="hmdLocalFontSizeCurrentValue" type="number" min="1" step="1" class="form-control form-control-sm"/>
                        </div>
                        <div class="col-6">
                            <label for="hmdLetterSpacingCurrentValue" class="form-label">Letter spacing</label>
                            <input id="hmdLetterSpacingCurrentValue" type="number" step="0.1" class="form-control form-control-sm"/>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label for="hmdLineHeightCurrentValue" class="form-label">Line height</label>
                        <input id="hmdLineHeightCurrentValue" type="number" min="0" step="0.05" class="form-control form-control-sm"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
