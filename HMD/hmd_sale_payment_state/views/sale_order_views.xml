<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_hmd_payment_state" model="ir.ui.view">
        <field name="name">sale.order.form.hmd.payment.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="hmd_payment_state" widget="badge"
                       decoration-success="hmd_payment_state == 'paid'"
                       decoration-warning="hmd_payment_state == 'partial'"
                       decoration-muted="hmd_payment_state == 'not_paid'"/>
            </xpath>
        </field>
    </record>

    <!-- Coluna opcional na lista de encomendas -->
    <record id="view_order_tree_hmd_payment_state" model="ir.ui.view">
        <field name="name">sale.order.list.hmd.payment.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="hmd_payment_state" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
