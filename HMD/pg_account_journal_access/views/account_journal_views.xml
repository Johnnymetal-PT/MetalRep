<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_pg_access" model="ir.ui.view">
        <field name="name">account.journal.form.pg.access</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Acesso por Utilizador (PG)"
                       name="pg_journal_access"
                       groups="account.group_account_manager">
                    <field name="pg_access_seeded" invisible="1"/>
                    <field name="pg_allowed_user_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="Vazio = diário aberto a todos os utilizadores"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
