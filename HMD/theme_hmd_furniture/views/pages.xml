    <!--
        Menu principal, pela ordem do desenho.

        O Odoo ja cria por defeito Home(10), Shop(20), Blog(40) e Contact us(60)
        em cada website novo. Nao repetimos Home nem Contact us aqui, senao
        aparecem a dobrar na navegacao. Shop e Blog nao constam do desenho —
        sao retirados na configuracao do site, nao pelo tema (o "Products" do
        desenho vive na coluna direita do cabecalho e aponta para /shop).

        O url tem de vir preenchido: theme.website.menu._convert_to_base_model
        copia 'url' tal e qual e NAO o deriva do page_id, pelo que um menu so
        com page_id fica com href vazio.
    -->
    <!-- Collection e o catalogo: aponta para /shop, sem pagina propria -->
    <record id="menu_collection" model="theme.website.menu">
        <field name="name">Collection</field>
        <field name="url">/shop</field>
        <field name="sequence" eval="20"/>
    </record>
    <record id="menu_portfolio" model="theme.website.menu">
        <field name="name">Portfolio</field>
        <field name="url">/portfolio</field>
        <field name="page_id" ref="theme_page_portfolio"/>
        <field name="sequence" eval="30"/>
    </record>
    <record id="menu_fabrics" model="theme.website.menu">
        <field name="name">Fabrics</field>
        <field name="url">/fabrics</field>
        <field name="page_id" ref="theme_page_fabrics"/>
        <field name="sequence" eval="40"/>
    </record>
    <record id="menu_materials" model="theme.website.menu">
        <field name="name">Materials</field>
        <field name="url">/materials</field>
        <field name="page_id" ref="theme_page_materials"/>
        <field name="sequence" eval="50"/>
    </record>
    <record id="menu_we_are" model="theme.website.menu">
        <field name="name">We are</field>
        <field name="url">/we-are</field>
        <field name="page_id" ref="theme_page_we_are"/>
        <field name="sequence" eval="70"/>
    </record>

