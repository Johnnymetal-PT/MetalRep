    <!--
        Pagina de resultados de pesquisa.

        Feedback Monica 18/09/2026, PDF "LUPA": o titulo "Search Results" sai
        (esta riscado, com "RETIRAR" ao lado). O que fica e a caixa de
        pesquisa com o termo e a contagem, que ja diz o mesmo.

        O nativo escreve-o como <div class="mt24 h3">Search Results</div>
        dentro do .container (website/views/website_templates.xml ~l.2721).
        Retira-se na vista e nao por CSS: o seletor teria de ser ".h3" dentro
        de um container generico, que apanha outras paginas.

        A classe hmd-search-page serve de ancora para a folha de estilos —
        sem ela nao ha nada nesta pagina que a distinga das restantes.
    -->
    <template id="page_search_hmd" inherit_id="website.list_hybrid" name="Search Results HMD">
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="hmd-search-page" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('h3')]" position="replace"/>
    </template>

    <template id="page_contact_hmd" inherit_id="website.contactus" name="Contact Us HMD">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure hmd-contact-page">

                <t t-call="theme_hmd_furniture.form_partner_request"/>

                <section class="hmd-formblock">
                    <h2 class="hmd-formblock__title">Can we help?</h2>
                    <p class="hmd-formblock__lead">
                        For any issues or quotation requests, please fill the form below.
                        Our team will do its best to answer as soon as possible.
                    </p>

                    <!-- A classe s_website_form NAO e decorativa: e o seletor a
                         que o widget do Odoo se liga
                         (.s_website_form form, form.s_website_form). Sem ela o
                         JavaScript nunca intercepta a submissao, o browser faz
                         um POST em bruto para a accao do <form> e o visitante
                         apanha uma pagina em branco, com o pedido perdido.

                         Apanhado a 17/09/2026 a testar no browser. Os testes
                         por HTTP nao o revelavam: chamavam /website/form/crm.lead
                         directamente, que e o que o JavaScript faria.

                         A accao TEM de terminar em "/website/form/", sem o
                         modelo: o widget concatena-a com o data-model_name

                             post(action + (force_action || model_name), ...)

                         (s_website_form/000.js, l.404). Por-lhe o modelo no
                         caminho — que eu tentei a 17/09 como rede de seguranca
                         para o caso de o JavaScript nao correr — submete para
                         "/website/form/crm.leadcrm.lead" e o Odoo responde "o
                         modelo de formulario especificado nao existe". -->
                    <form action="/website/form/" method="post"
                          enctype="multipart/form-data"
                          class="s_website_form hmd-form o_mark_required" data-mark="*"
                          data-model_name="crm.lead" data-success-mode="message">

                        <div class="hmd-form__row">
                            <label>Your Name <span class="s_website_form_mark">*</span></label>
                            <input type="text" name="contact_name" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Phone Number</label>
                            <input type="tel" name="phone" class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Your Email <span class="s_website_form_mark">*</span></label>
                            <input type="email" name="email_from" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Your Company <span class="s_website_form_mark">*</span></label>
                            <input type="text" name="partner_name" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Subject <span class="s_website_form_mark">*</span></label>
                            <input type="text" name="name" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Your Question <span class="s_website_form_mark">*</span></label>
                            <textarea name="description" rows="5" required="required"
                                      class="s_website_form_input"/>
                        </div>

                        <div class="hmd-form__actions">
                            <button type="submit" class="s_website_form_send">Submit</button>
                        </div>
                        <div id="s_website_form_result" class="s_website_form_result"/>
                    </form>
                </section>
            </div>
        </xpath>
    </template>

