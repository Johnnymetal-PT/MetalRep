    <!-- Formulario de pedido de conta de parceiro.

         Vive num template proprio porque aparece em dois sitios: na sua
         propria pagina (/partner-request, para onde aponta o bloco B2B da
         pagina de produto) e no topo da pagina de contactos, onde ja
         estava. Duas copias divergiriam a primeira vez que alguem mudasse
         um campo. -->
    <template id="form_partner_request" name="Partner Account Request Form">
                <section class="hmd-formblock">
                    <h1 class="hmd-formblock__title">Create your customer account</h1>
                    <p class="hmd-formblock__lead">
                        Create an account for our B2B platform to access your information,
                        exclusive files and catalogues, your orders and more.
                    </p>

                    <!-- A classe s_website_form NAO e decorativa: e o seletor a
                         que o widget do Odoo se liga
                         (.s_website_form form, form.s_website_form). Sem ela o
                         JavaScript nunca intercepta a submissao, o browser faz
                         um POST em bruto para a accao do <form> e o visitante
                         apanha uma pagina em branco, com o pedido perdido.

                         Apanhado a 17/09/2026 a testar no browser. Os testes
                         por HTTP nao o revelavam: chamavam /website/form/crm.lead
                         directamente, que e o que o JavaScript faria.

                         A accao TEM de terminar em "/website/form/", sem o
                         modelo: o widget concatena-a com o data-model_name

                             post(action + (force_action || model_name), ...)

                         (s_website_form/000.js, l.404). Por-lhe o modelo no
                         caminho — que eu tentei a 17/09 como rede de seguranca
                         para o caso de o JavaScript nao correr — submete para
                         "/website/form/crm.leadcrm.lead" e o Odoo responde "o
                         modelo de formulario especificado nao existe". -->
                    <form action="/website/form/" method="post"
                          enctype="multipart/form-data"
                          class="s_website_form hmd-form o_mark_required" data-mark="*"
                          data-model_name="crm.lead" data-success-mode="message">
                        <input type="hidden" name="name" class="s_website_form_input"
                               value="Pedido de conta B2B (website)"/>
                        <!-- E este campo que distingue o pedido de conta de um
                             lead qualquer; o hmd_partner_request le-o para
                             mostrar o botao de aprovacao. -->
                        <input type="hidden" name="hmd_is_account_request"
                               class="s_website_form_input" value="1"/>

                        <div class="hmd-form__row">
                            <label>Name <span class="s_website_form_mark">*</span></label>
                            <input type="text" name="contact_name" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Email <span class="s_website_form_mark">*</span></label>
                            <input type="email" name="email_from" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Phone Number</label>
                            <input type="tel" name="phone" class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Company <span class="s_website_form_mark">*</span></label>
                            <input type="text" name="partner_name" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Company Type <span class="s_website_form_mark">*</span></label>
                            <select name="Company Type" required="required" class="s_website_form_input">
                                <option value="Store / Showroom">Store / Showroom</option>
                                <option value="Architect / Interior Designer">Architect / Interior Designer</option>
                                <option value="Distributor">Distributor</option>
                                <option value="Hospitality">Hospitality</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="hmd-form__row">
                            <label>VAT Number <span class="s_website_form_mark">*</span></label>
                            <input type="text" name="hmd_vat" required="required"
                                   class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Website Link</label>
                            <input type="url" name="website" class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Street</label>
                            <input type="text" name="street" class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Postal Code</label>
                            <input type="text" name="zip" class="s_website_form_input"/>
                        </div>
                        <div class="hmd-form__row">
                            <label>Country</label>
                            <select name="country_id" class="s_website_form_input">
                                <option value="">—</option>
                                <t t-foreach="request.env['res.country'].sudo().search([], order='name')" t-as="pais">
                                    <option t-att-value="pais.id" t-out="pais.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="hmd-form__row">
                            <label>Notes</label>
                            <textarea name="description" rows="4" class="s_website_form_input"/>
                        </div>

                        <div class="hmd-form__actions">
                            <button type="submit" class="s_website_form_send">Submit</button>
                        </div>
                        <div id="s_website_form_result" class="s_website_form_result"/>
                    </form>
                </section>
    </template>

