<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Home — Website_Design/Desktop/SVG/Home.svg (1920x8047)
        Seccoes, por ordem de y:
          hero moodboard a sangrar, "SEND US YOUR IDEAS" (y=432) e
          "CONTRACT US" + lead (y=2071/2222)
          editorial "NEWS FROM PORTUGAL" (y=2619..4256)
          destaque CONGO em fundo mauve (y=4513..5785)
          dois projectos (y=6311..6964)
        O conteudo vai dentro de oe_structure para a HMD poder editar no
        construtor de website sem tocar no modulo.
    -->
    <template id="homepage_hmd" inherit_id="website.homepage" name="Home HMD">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure">

                <section class="hmd-hero"
                         style="background-image:url('/theme_hmd_furniture/static/src/img/home_hero.jpg')">
                    <!-- Quebra explicita: no XD sao duas linhas, "SEND US" e
                         "YOUR IDEAS". Depender de max-width em ch nao e fiavel
                         com a Prata, que tem maiusculas largas. -->
                    <h1 class="hmd-hero__kicker">Send us<br/>your ideas</h1>
                    <div class="hmd-hero__foot">
                        <h2 class="hmd-hero__title">Contract us</h2>
                        <p class="hmd-hero__lead">
                            For interior design visionaries, we present the Congo Table:
                            a seemingly simple piece that unveils itself as a masterpiece
                            for those with refined sensibilities.
                        </p>
                    </div>
                </section>

                <section class="hmd-editorial">
                    <div>
                        <figure class="hmd-figure">
                            <img src="/theme_hmd_furniture/static/src/img/editorial_interior.jpg"
                                 alt="Interior com peca HMD" class="img img-fluid"/>
                            <figcaption class="hmd-caption">legendas imagens</figcaption>
                        </figure>
                        <h2 class="hmd-editorial__title">News from Portugal</h2>
                        <p class="hmd-editorial__body">
                            We are grateful to the architects, designers and clients who
                            generously allow us to share their work. Every space reflects
                            a unique vision, and we are proud to have contributed with
                            pieces that become part of those stories.
                        </p>
                    </div>
                    <div>
                        <p class="hmd-standfirst">
                            We are grateful to the architects, designers and clients who
                            generously allow us to share their work.
                        </p>
                        <p class="hmd-editorial__note">
                            Every space reflects a unique vision, and we are proud to have
                            contributed with pieces that become part of those stories.
                        </p>
                        <figure class="hmd-figure mt-4">
                            <img src="/theme_hmd_furniture/static/src/img/editorial_sketch.jpg"
                                 alt="Desenho tecnico" class="img img-fluid"/>
                            <figcaption class="hmd-caption">legendas imagens</figcaption>
                        </figure>
                    </div>
                </section>

                <section class="hmd-feature">
                    <h2 class="hmd-feature__title">Congo</h2>
                    <p class="hmd-feature__sub">Coffee Tables</p>
                    <figure class="hmd-feature__media">
                        <img src="/theme_hmd_furniture/static/src/img/congo_detail.jpg"
                             alt="Congo" class="img img-fluid"/>
                        <figcaption class="hmd-caption text-start">legendas imagens</figcaption>
                    </figure>
                    <p class="hmd-feature__body">
                        We are grateful to the architects, designers and clients who
                        generously allow us to share their work. Every space reflects a
                        unique vision, and we are proud to have contributed with pieces
                        that become part of those stories.
                    </p>
                </section>

                <section class="hmd-projects">
                    <!-- No XD os dois cartoes trazem o paragrafo completo, nao
                         metade cada um. -->
                    <article class="hmd-project">
                        <img src="/theme_hmd_furniture/static/src/img/editorial_interior.jpg"
                             alt="Projecto" class="img img-fluid"/>
                        <p class="hmd-project__caption">Project by <strong>L'Elephant</strong></p>
                        <p class="hmd-project__body">
                            We are grateful to the architects, designers and clients who
                            generously allow us to share their work. Every space reflects a
                            unique vision, and we are proud to have contributed with pieces
                            that become part of those stories.
                        </p>
                    </article>
                    <article class="hmd-project">
                        <img src="/theme_hmd_furniture/static/src/img/editorial_interior.jpg"
                             alt="Projecto" class="img img-fluid"/>
                        <p class="hmd-project__caption">Project by <strong>L'Elephant</strong></p>
                        <p class="hmd-project__body">
                            We are grateful to the architects, designers and clients who
                            generously allow us to share their work. Every space reflects a
                            unique vision, and we are proud to have contributed with pieces
                            that become part of those stories.
                        </p>
                    </article>
                </section>

            </div>
        </xpath>
    </template>

    <!-- We are — We are.svg (1920x8047) -->
