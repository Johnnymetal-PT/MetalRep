<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pg_branch_create_wizard_form" model="ir.ui.view">
        <field name="name">pg.branch.create.wizard.form</field>
        <field name="model">pg.branch.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Criar branch em falta">
                <div class="alert alert-warning" role="alert">
                    A branch <field name="target_branch" readonly="1" nolabel="1" class="oe_inline"/> não existe no repositório.
                    Escolhe a branch existente a partir da qual queres criá-la (cópia).
                </div>
                <group>
                    <field name="project_id" invisible="1"/>
                    <field name="repository_id" invisible="1"/>
                    <field name="base_branch_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button
                        name="action_create_branch"
                        type="object"
                        string="Criar branch e sincronizar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
