<?xml version="1.0" ?>
<odoo>
    <data>
         <record id="res_partner_view" model="ir.ui.view">
            <field name="name">res.partner.product.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales_purchases']" position="inside" >
                    <notebook>
                        <page string="Products">    
                            <field name="product_ids">
                                <list string="Payments">
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="website_id"/>
                                    <field name="list_price"/>
                                    <field name="standard_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Product Variants">    
                            <field name="product_variant_ids">
                                <list string="Payments">
                                    <field name="default_code"/>
                                    <field name="name"/>
                                    <field name="website_id"/>
                                    <field name="product_template_variant_value_ids" widget="many2many_tags" string="Attribute Values"/>
                                    <field name="list_price"/>
                                    <field name="standard_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Products Category">   
                            <field name="product_categ_ids">
                                <list string="Payments">
                                    <field name="complete_name" string="Product Category"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </xpath>    
            </field>
        </record> 

        <record id="product_template_attribute_visibility_value" model="ir.ui.view">
            <field name="name">product.template.attribute.value.form</field>
            <field name="model">product.template.attribute.value</field>
            <field name="inherit_id" ref="product.product_template_attribute_value_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_extra']" position="after" >
                        <field name="attr_active" invisible="1"/>
                </xpath>    
            </field>
        </record>

        <record id="product_template_visibility_view" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='standard_price']" position="after" >
                        <field name="product_attr_active" invisible="1"/>
                </xpath>    
            </field>
        </record>

        <record id="res_config_inherrit_view" model="ir.ui.view">
            <field name="name">res.config.setting.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="website.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='website']" position="inside">
                    <block title="Visitor Products" id="website_product_visibility_settings">
                        <setting
                            id="website_product_visibility_setting"
                            string="Website Product Visibility"
                            help="Restrict the shop to selected products, variants, and categories for visitors."
                        >
                            <field name="is_website_product_visibility"/>
                            <div class="content-group" invisible="not is_website_product_visibility">
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" for="visitor_product_ids" string="Products"/>
                                    <field
                                        name="visitor_product_ids"
                                        domain="[('website_published', '=', True)]"
                                        widget="many2many_tags"
                                    />
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" for="visitor_product_variant_ids" string="Product Variants"/>
                                    <field
                                        name="visitor_product_variant_ids"
                                        domain="[('website_published', '=', True)]"
                                        widget="many2many_tags"
                                    />
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" for="visitor_product_categ_ids" string="Product Category"/>
                                    <field name="visitor_product_categ_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>   
    </data>
</odoo>
