<odoo>
    <template id="category_visibility_filter" inherit_id="website_sale.categories_recursive" priority="100">
        <xpath expr="//t[@t-name='website_sale.categories_recursive']/li" position="before">
            <t t-set="pg_apply_category_filter" t-value="vars.get('pg_apply_category_filter')"/>
            <t t-set="pg_visible_category_ids" t-value="vars.get('pg_visible_category_ids') or []"/>
        </xpath>

        <xpath expr="//t[@t-name='website_sale.categories_recursive']/li" position="attributes">
            <attribute name="t-if">not pg_apply_category_filter or c.id in pg_visible_category_ids</attribute>
        </xpath>
    </template>
</odoo>

