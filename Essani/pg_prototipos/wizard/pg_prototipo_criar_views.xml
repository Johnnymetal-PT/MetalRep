<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pg_prototipo_criar_form" model="ir.ui.view">
        <field name="name">pg.prototipo.criar.form</field>
        <field name="model">pg.prototipo.criar</field>
        <field name="arch" type="xml">
            <form string="Criar protótipo">
                <group>
                    <group>
                        <field name="nome"/>
                        <field name="categoria_raiz_id" invisible="1"/>
                        <field name="categoria_id" options="{'no_create': True}"/>
                        <field name="modelo_projeto_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="gestor_id" options="{'no_create': True}"/>
                        <field name="gestor_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="lead_id" invisible="1"/>
                    </group>
                </group>
                <!-- Os campos aqui dentro mudam conforme a categoria escolhida: a
                     definicao vem de product.category.product_properties_definition. -->
                <group string="Especificações pedidas pelo cliente">
                    <field name="especificacoes" nolabel="1" colspan="2"/>
                </group>
                <group string="Requisitos do cliente">
                    <field name="notas" nolabel="1" colspan="2"
                           placeholder="O que o cliente pediu, por palavras dele."/>
                </group>
                <footer>
                    <button name="action_criar" type="object" string="Criar protótipo"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pg_prototipo_criar" model="ir.actions.act_window">
        <field name="name">Criar protótipo</field>
        <field name="res_model">pg.prototipo.criar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
