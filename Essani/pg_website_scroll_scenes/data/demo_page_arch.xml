<t name="Cenas com scroll (demonstração)" t-name="website.pg_scroll_scenes_demo">
  <t t-call="website.layout">
    <div id="wrap" class="oe_structure oe_empty">

      <!-- 1. Abertura (secção "hero" da homepage) -->
      <section class="pg-scene" data-pg-scene="hero" data-pg-zoom="1.2" data-pg-veil="0.3,0.72">
        <div class="pg-scene__bg" style="background-image: url('/web/image/286594');"/>
        <div class="pg-scene__veil"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="center">
            <span class="pg-scene__eyebrow">Iluminação e Tecnologia LED</span>
            <h1>A luz cria o espaço</h1>
          </div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="center" data-pg-from="zoom">
            <p>Concebemos e produzimos iluminação e tecnologia LED. Os produtos são nossos — os ambientes são criados por si.</p>
          </div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-align="center">
            <ul class="pg-chips">
              <li>Residencial</li><li>Hotelaria</li><li>Retalho</li><li>Escritórios</li><li>Restauração</li><li>OEM</li><li>Exportação</li>
            </ul>
            <div class="pg-scene__actions">
              <a class="btn btn-primary" href="/shop">Ver catálogo</a>
              <a class="btn btn-outline-light" href="/contactus">Seja parceiro</a>
            </div>
          </div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 2. Famílias de produto: uma família por passo -->
      <section class="pg-scene" data-pg-scene="familias" data-pg-vh="0.7" data-pg-glow="right">
        <div class="pg-scene__glow"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__layers pg-scene__layers--contain">
            <figure class="pg-scene__layer" data-pg-step="1"><img src="/web/image/287134" alt="LED" loading="lazy"/><figcaption>LED</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="2"><img src="/web/image/287135" alt="Perfis" loading="lazy"/><figcaption>Perfis</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="3"><img src="/web/image/287136" alt="Sensores" loading="lazy"/><figcaption>Sensores</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="4"><img src="/web/image/287137" alt="Focos LED" loading="lazy"/><figcaption>Focos LED</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="5"><img src="/web/image/287138" alt="Comandos" loading="lazy"/><figcaption>Comandos</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="6"><img src="/web/image/287139" alt="Conectividade" loading="lazy"/><figcaption>Conectividade</figcaption></figure>
          </div>
          <div class="pg-scene__title">
            <span class="pg-scene__eyebrow">Range</span>
            <h2>Famílias de produto</h2>
          </div>
          <div class="pg-scene__step" data-pg-step="1" data-pg-from="left"><span class="pg-ghost pg-ghost--left">01</span><span class="pg-num">01</span><h3 data-pg-split="1">LED</h3><a class="pg-link" href="/shop/category/destaques-led-1818">Explorar →</a></div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-from="left"><span class="pg-ghost pg-ghost--left">02</span><span class="pg-num">02</span><h3 data-pg-split="1">Perfis</h3><a class="pg-link" href="/shop/category/destaques-perfis-1819">Explorar →</a></div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-from="left"><span class="pg-ghost pg-ghost--left">03</span><span class="pg-num">03</span><h3 data-pg-split="1">Sensores</h3><a class="pg-link" href="/shop/category/destaques-sensores-1826">Explorar →</a></div>
          <div class="pg-scene__step" data-pg-step="4" data-pg-from="left"><span class="pg-ghost pg-ghost--left">04</span><span class="pg-num">04</span><h3 data-pg-split="1">Focos LED</h3><a class="pg-link" href="/shop/category/destaques-focos-led-1827">Explorar →</a></div>
          <div class="pg-scene__step" data-pg-step="5" data-pg-from="left"><span class="pg-ghost pg-ghost--left">05</span><span class="pg-num">05</span><h3 data-pg-split="1">Comandos</h3><a class="pg-link" href="/shop/category/destaques-comandos-1828">Explorar →</a></div>
          <div class="pg-scene__step" data-pg-step="6" data-pg-from="left"><span class="pg-ghost pg-ghost--left">06</span><span class="pg-num">06</span><h3 data-pg-split="1">Conectividade</h3><a class="pg-link" href="/shop/category/destaques-conectividade-1829">Explorar →</a></div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 3. Para profissionais: título e etiquetas à esquerda, mensagem à direita -->
      <section class="pg-scene" data-pg-scene="b2b" data-pg-layout="split" data-pg-glow="right" data-pg-vh="0.8">
        <div class="pg-scene__glow"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__side">
            <span class="pg-scene__eyebrow">Para profissionais</span>
            <h2>Nós produzimos. Vocês criam os projetos.</h2>
            <span class="pg-rule"/>
            <ul class="pg-chips"><li>Revendedores</li><li>Parceiros</li><li>OEM</li><li>Exportação</li></ul>
          </div>
          <div class="pg-scene__step" data-pg-step="1" data-pg-from="up">
            <p class="pg-lead">Fornecemos a revendedores, parceiros, fabricantes de mobiliário, arquitetos e integradores — em Portugal e na exportação. Soluções OEM à medida da sua marca.</p>
          </div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-from="up">
            <span class="pg-rule"/>
            <h3 data-pg-split="1">Fale com a equipa</h3>
            <a class="btn btn-primary" href="/contactus?subject=B2B">Falar com a equipa</a>
          </div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 4. Acenda a luz: antes e depois, a luz acende com o scroll -->
      <section class="pg-scene" data-pg-scene="acenda">
        <div class="pg-scene__stage">
          <div class="pg-scene__layers">
            <figure class="pg-scene__layer" data-pg-step="1"><img src="/web/image/215285/1600x1000" alt="Sem luz" loading="lazy"/><figcaption>Sem luz</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="2" data-pg-dur="0.9"><img src="/web/image/215196/1600x1000" alt="Com luz Essani" loading="lazy"/><figcaption>Essani</figcaption></figure>
          </div>
          <div class="pg-scene__title">
            <span class="pg-scene__eyebrow">Veja a diferença</span>
            <h2>Acenda a luz</h2>
            <p>Faça scroll para comparar o antes e o depois.</p>
          </div>
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="bottom"><h3>Sem luz</h3></div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="bottom" data-pg-from="fade"><h3>Essani</h3></div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 5. Uma luz, infinitas cores: a mesma sala em cinco cores de LED -->
      <section class="pg-scene" data-pg-scene="cores" data-pg-vh="0.7">
        <div class="pg-scene__stage">
          <div class="pg-scene__layers">
            <figure class="pg-scene__layer" data-pg-step="1"><img src="/web/image/286680" alt="Sala com LED rosa" loading="lazy"/><figcaption>Rosa</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="2"><img src="/web/image/287807" alt="Sala com LED em branco quente" loading="lazy"/><figcaption>Branco quente</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="3"><img src="/web/image/287808" alt="Sala com LED azul" loading="lazy"/><figcaption>Azul</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="4"><img src="/web/image/287809" alt="Sala com LED violeta" loading="lazy"/><figcaption>Violeta</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="5"><img src="/web/image/287810" alt="Sala com LED verde" loading="lazy"/><figcaption>Verde</figcaption></figure>
          </div>
          <div class="pg-scene__title">
            <span class="pg-scene__eyebrow">O poder da luz</span>
            <h2>Uma luz, infinitas cores</h2>
            <p>Com controlo RGB e temperatura, a mesma divisão muda de atmosfera num toque. Escolha a cor certa para cada momento.</p>
            <a class="btn btn-primary" href="/shop/category/destaques-comandos-1828">Ver comandos</a>
          </div>
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="bottom" data-pg-from="left"><h3>Rosa</h3></div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="bottom" data-pg-from="left"><h3>Branco quente</h3></div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-align="bottom" data-pg-from="left"><h3>Azul</h3></div>
          <div class="pg-scene__step" data-pg-step="4" data-pg-align="bottom" data-pg-from="left"><h3>Violeta</h3></div>
          <div class="pg-scene__step" data-pg-step="5" data-pg-align="bottom" data-pg-from="left"><h3>Verde</h3></div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 6. Essanilight -->
      <section class="pg-scene" data-pg-scene="essanilight" data-pg-zoom="1.15" data-pg-veil="0.25,0.65" data-pg-vh="0.7">
        <div class="pg-scene__bg" style="background-image: url('/web/image/286833');"/>
        <div class="pg-scene__veil"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__step" data-pg-step="1">
            <span class="pg-scene__eyebrow">ESSANILIGHT</span>
            <h2>Possibilidades infinitas</h2>
          </div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-from="up">
            <p>Painéis de iluminação totalmente personalizados à sua forma, medida e cor de LED. Desenhe formas, ilumine superfícies, crie ambientes únicos.</p>
            <a class="btn btn-outline-light" href="/campanhas/essanilight">Discover</a>
          </div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 7. Números: o +700 sobe com o scroll -->
      <section class="pg-scene" data-pg-scene="numeros" data-pg-glow="center" data-pg-vh="0.6">
        <div class="pg-scene__glow"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="center" data-pg-from="zoom"><span class="pg-stat" data-pg-count="700" data-pg-prefix="+">+700</span><span class="pg-rule"/><p>Produtos</p></div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="center" data-pg-from="zoom"><span class="pg-stat">Design</span><span class="pg-rule"/><p>&amp; produção própria</p></div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-align="center" data-pg-from="zoom"><span class="pg-stat">OEM</span><span class="pg-rule"/><p>Soluções à medida</p></div>
          <div class="pg-scene__step" data-pg-step="4" data-pg-align="center" data-pg-from="zoom"><span class="pg-stat">Global</span><span class="pg-rule"/><p>Exportação</p></div>
          <ol class="pg-scene__index pg-scene__index--row">
            <li data-pg-index="1"><span class="it"><b>01</b>Produtos</span></li>
            <li data-pg-index="2"><span class="it"><b>02</b>Design</span></li>
            <li data-pg-index="3"><span class="it"><b>03</b>OEM</span></li>
            <li data-pg-index="4"><span class="it"><b>04</b>Global</span></li>
          </ol>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 8. Luz para cada espaço -->
      <section class="pg-scene" data-pg-scene="espacos" data-pg-vh="0.7">
        <div class="pg-scene__stage">
          <div class="pg-scene__layers">
            <figure class="pg-scene__layer" data-pg-step="1"><img src="/web/image/286654" alt="Hotelaria" loading="lazy"/><figcaption>Hotelaria</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="2"><img src="/web/image/286655" alt="Retalho" loading="lazy"/><figcaption>Retalho</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="3"><img src="/web/image/286656" alt="Restauração" loading="lazy"/><figcaption>Restauração</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="4"><img src="/web/image/286657" alt="Escritórios" loading="lazy"/><figcaption>Escritórios</figcaption></figure>
            <figure class="pg-scene__layer" data-pg-step="5"><img src="/web/image/286658" alt="Residencial" loading="lazy"/><figcaption>Residencial</figcaption></figure>
          </div>
          <div class="pg-scene__title">
            <span class="pg-scene__eyebrow">Espaços</span>
            <h2>Luz para cada espaço</h2>
          </div>
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="bottom" data-pg-from="right"><h3>Hotelaria</h3><a class="pg-link" href="/solucoes#hotelaria">Ver soluções →</a></div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="bottom" data-pg-from="right"><h3>Retalho</h3><a class="pg-link" href="/solucoes#retalho">Ver soluções →</a></div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-align="bottom" data-pg-from="right"><h3>Restauração</h3><a class="pg-link" href="/solucoes#restauracao">Ver soluções →</a></div>
          <div class="pg-scene__step" data-pg-step="4" data-pg-align="bottom" data-pg-from="right"><h3>Escritórios</h3><a class="pg-link" href="/solucoes#escritorios">Ver soluções →</a></div>
          <div class="pg-scene__step" data-pg-step="5" data-pg-align="bottom" data-pg-from="right"><h3>Residencial</h3><a class="pg-link" href="/solucoes#residencial">Ver soluções →</a></div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 9. A sua luz, à sua maneira: índice à esquerda, cada vantagem à direita -->
      <section class="pg-scene" data-pg-scene="controlo" data-pg-layout="split" data-pg-glow="right" data-pg-vh="0.75">
        <div class="pg-scene__glow"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__side">
            <span class="pg-scene__eyebrow">Controlo e domótica</span>
            <h2>A sua luz, à sua maneira</h2>
            <p>Controle a iluminação como preferir — interruptor, comando à distância, sensor ou integração. Componentes fáceis de instalar, pensados para profissionais e marceneiros.</p>
            <ol class="pg-scene__index">
              <li data-pg-index="1"><a href="/shop/category/destaques-comandos-1828"><b>01</b>Comandos</a></li>
              <li data-pg-index="2"><a href="/shop/category/destaques-sensores-1826"><b>02</b>Sensores</a></li>
              <li data-pg-index="3"><a href="/shop/category/destaques-conectividade-1829"><b>03</b>Conectividade</a></li>
              <li data-pg-index="4"><span class="it"><b>04</b>Fácil de instalar</span></li>
              <li data-pg-index="5"><span class="it"><b>05</b>Domótica</span></li>
            </ol>
          </div>
          <div class="pg-scene__step" data-pg-step="1" data-pg-from="up">
            <span class="pg-ghost">01</span><h2>Comandos</h2><span class="pg-rule"/>
            <p>Controlo à distância e regulação de intensidade e cor.</p>
            <a class="pg-link" href="/shop/category/destaques-comandos-1828">Ver →</a>
          </div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-from="up">
            <span class="pg-ghost">02</span><h2 data-pg-split="1">Sensores</h2><span class="pg-rule"/>
            <p>Ativação por movimento, presença ou abertura de porta.</p>
            <a class="pg-link" href="/shop/category/destaques-sensores-1826">Ver →</a>
          </div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-from="up">
            <span class="pg-ghost">03</span><h2 data-pg-split="1">Conectividade</h2><span class="pg-rule"/>
            <p>Ligação e integração dos sistemas de iluminação.</p>
            <a class="pg-link" href="/shop/category/destaques-conectividade-1829">Ver →</a>
          </div>
          <div class="pg-scene__step" data-pg-step="4" data-pg-from="up">
            <span class="pg-ghost">04</span><h2 data-pg-split="1">Fácil de instalar</h2><span class="pg-rule"/>
            <p>Soluções plug-and-play e apoio técnico para uma montagem simples.</p>
          </div>
          <div class="pg-scene__step" data-pg-step="5" data-pg-from="up">
            <span class="pg-ghost">05</span><h2 data-pg-split="1">Domótica</h2><span class="pg-rule"/>
            <p>Integração com sistemas de domótica e casa inteligente.</p>
          </div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 10. Citação: aspas enormes, a frase revela-se por palavras -->
      <section class="pg-scene" data-pg-scene="citacao" data-pg-glow="center" data-pg-vh="0.7">
        <div class="pg-scene__glow"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="center" data-pg-keep="1">
            <span class="pg-ghost pg-ghost--quote">“</span>
          </div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="center" data-pg-keep="1">
            <p class="pg-quote" data-pg-split="1">"Muito mais do que iluminação e tecnologia."</p>
          </div>
          <div class="pg-scene__step" data-pg-step="3" data-pg-align="bottom" data-pg-from="up">
            <span class="pg-scene__eyebrow">Essani</span>
          </div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

      <!-- 11. Catálogo -->
      <section class="pg-scene" data-pg-scene="catalogo" data-pg-glow="center" data-pg-vh="0.7">
        <div class="pg-scene__glow"/>
        <div class="pg-scene__stage">
          <div class="pg-scene__step" data-pg-step="1" data-pg-align="center">
            <span class="pg-scene__eyebrow">Catálogo</span>
            <h2>A gama completa, ao seu alcance</h2>
            <span class="pg-rule"/>
          </div>
          <div class="pg-scene__step" data-pg-step="2" data-pg-align="center" data-pg-from="up">
            <div class="pg-scene__actions">
              <a class="btn btn-primary" href="/shop">Ver catálogo</a>
              <a class="btn btn-outline-light" href="/contactus">Falar connosco</a>
            </div>
          </div>
        </div>
        <div class="pg-scene__dots"/>
        <div class="pg-scene__bar"><i/></div>
      </section>

    </div>
  </t>
</t>
