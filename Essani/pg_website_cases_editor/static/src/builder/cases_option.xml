    <BuilderRow label.translate="Setor">
        <BuilderSelect dataAttributeAction="'sector'">
            <BuilderSelectItem dataAttributeActionValue="'hotelaria'">Hotelaria</BuilderSelectItem>
            <BuilderSelectItem dataAttributeActionValue="'retalho'">Retalho</BuilderSelectItem>
            <BuilderSelectItem dataAttributeActionValue="'restauracao'">Restauração</BuilderSelectItem>
            <BuilderSelectItem dataAttributeActionValue="'escritorios'">Escritórios</BuilderSelectItem>
            <BuilderSelectItem dataAttributeActionValue="'residencial'">Residencial</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
</t>

</templates>
