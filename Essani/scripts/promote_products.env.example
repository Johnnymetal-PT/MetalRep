# Copy to scripts/.promote.env and fill the values. Never commit the real file.
# API keys are generated in:  Settings > Users > <your user> > Account Security > New API Key

# --- Staging (source) ---
SRC_URL=https://essani-test-XXXXX.dev.odoo.com
SRC_DB=essani-test-XXXXX
SRC_LOGIN=joao.barros@parametro.global
SRC_API_KEY=put-staging-api-key-here

# --- Production (destination) ---
DST_URL=https://essani.odoo.com
DST_DB=essani-main-XXXXX
DST_LOGIN=joao.barros@parametro.global
DST_API_KEY=put-production-api-key-here
