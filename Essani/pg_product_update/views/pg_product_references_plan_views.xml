<odoo>
    <record id="view_pg_product_references_plan_list" model="ir.ui.view">
        <field name="name">pg.product.references.plan.list</field>
        <field name="model">pg.product.references.plan</field>
        <field name="arch" type="xml">
            <list string="References plans" default_order="id desc" create="0">
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'building'" decoration-warning="state == 'applying'" decoration-success="state in ('built','applied')" decoration-danger="state == 'failed'"/>
                <field name="total_count"/>
                <field name="processed_count"/>
                <field name="pending_count"/>
                <field name="progress_percent" widget="progressbar"/>
                <field name="line_count"/>
                <field name="error_count"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>

    <record id="view_pg_product_references_plan_form" model="ir.ui.view">
        <field name="name">pg.product.references.plan.form</field>
        <field name="model">pg.product.references.plan</field>
        <field name="arch" type="xml">
            <form string="References plan" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-secondary"/>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary" invisible="state != 'built'" confirm="Aplicar as referencias do Drive a todas as variantes do plano de acordo com o modo selecionado?"/>
                    <field name="state" widget="statusbar" statusbar_visible="building,built,applying,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Progresso">
                            <field name="progress_percent" widget="progressbar" readonly="1"/>
                            <field name="total_count" readonly="1"/>
                            <field name="processed_count" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                        </group>
                        <group string="Estado">
                            <field name="mode" readonly="state != 'building'"/>
                            <field name="error_count" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="applied_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Erro" invisible="not last_error">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Resumo" invisible="not summary">
                        <field name="summary" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Linhas">
                            <field name="line_ids" readonly="1">
                                <list string="Linhas" decoration-success="status in ('applied','already_correct','fill')" decoration-warning="status == 'overwrite'" decoration-danger="status in ('conflict_other_variant','duplicated_drive_code','error','resolve_error')" decoration-muted="status in ('no_variant_match','drive_extra_variant','odoo_extra_variant')">
                                    <field name="template_name"/>
                                    <field name="variant_display"/>
                                    <field name="attributes_display"/>
                                    <field name="current_code"/>
                                    <field name="proposed_code"/>
                                    <field name="status"/>
                                    <field name="drive_folder_url" widget="url" string="Drive"/>
                                    <field name="drive_folder_id" optional="hide"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Input">
                            <group>
                                <field name="template_ids" widget="many2many_tags" readonly="1"/>
                                <field name="variant_filter_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                            <group string="Pendentes / Processados">
                                <field name="pending_template_ids" widget="many2many_tags" readonly="1"/>
                                <field name="processed_template_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pg_product_references_plan" model="ir.actions.act_window">
        <field name="name">References plans</field>
        <field name="res_model">pg.product.references.plan</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[(4, ref('pg_product_update.group_pg_references_sync_user'))]"/>
    </record>
</odoo>
