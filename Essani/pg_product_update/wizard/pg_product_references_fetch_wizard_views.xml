<odoo>
    <record id="view_pg_product_references_fetch_wizard_form" model="ir.ui.view">
        <field name="name">pg.product.references.fetch.wizard.form</field>
        <field name="model">pg.product.references.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Pescar referencias do Drive">
                <sheet>
                    <group>
                        <field name="template_ids" widget="many2many_tags" readonly="has_plan"/>
                        <field name="variant_ids" widget="many2many_tags" readonly="has_plan" options="{'no_create': True, 'no_open': True}"/>
                        <field name="mode"/>
                        <field name="has_plan" invisible="1"/>
                        <field name="has_applied" invisible="1"/>
                    </group>
                    <group string="Resumo" invisible="not has_plan">
                        <field name="summary" nolabel="1" readonly="1"/>
                    </group>
                    <notebook invisible="not has_plan">
                        <page string="Plano por variante">
                            <field name="line_ids" readonly="1">
                                <list string="Plano" decoration-success="status in ('applied','already_correct','fill')" decoration-warning="status == 'overwrite'" decoration-danger="status in ('conflict_other_variant','duplicated_drive_code','error','resolve_error')" decoration-muted="status in ('no_variant_match','drive_extra_variant','odoo_extra_variant')">
                                    <field name="template_name"/>
                                    <field name="variant_display"/>
                                    <field name="attributes_display"/>
                                    <field name="current_code"/>
                                    <field name="proposed_code"/>
                                    <field name="status"/>
                                    <field name="drive_folder_url" widget="url" string="Drive"/>
                                    <field name="drive_folder_id" optional="hide"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_generate_plan" type="object" string="Gerar plano (dry-run)" class="btn-primary" invisible="has_plan"/>
                    <button name="action_run_in_background" type="object" string="Correr em background" class="btn-secondary" invisible="has_plan"
                            help="Para batches grandes: cria um plan persistente que e processado por cron sem matar o worker."/>
                    <button name="action_generate_plan" type="object" string="Regerar plano" class="btn-secondary" invisible="not has_plan or has_applied"/>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary" invisible="not has_plan or has_applied" confirm="Aplicar as referencias do Drive de acordo com o modo selecionado?"/>
                    <button special="cancel" string="Fechar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pg_product_references_fetch_wizard" model="ir.actions.act_window">
        <field name="name">Pescar referencias do Drive</field>
        <field name="res_model">pg.product.references.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('pg_product_update.group_pg_references_sync_user'))]"/>
    </record>

    <record id="action_pg_product_references_fetch_wizard_variants" model="ir.actions.act_window">
        <field name="name">Pescar referencias do Drive</field>
        <field name="res_model">pg.product.references.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('pg_product_update.group_pg_references_sync_user'))]"/>
    </record>
</odoo>
