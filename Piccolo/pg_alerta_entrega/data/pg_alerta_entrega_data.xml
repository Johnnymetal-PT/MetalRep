<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Destinatarios dos alertas (IDs separados por virgula).
             Editar em Definicoes > Tecnico > Parametros do Sistema. -->
        <record id="pg_alerta_entrega_user_ids" model="ir.config_parameter">
            <field name="key">pg_alerta_entrega.user_ids</field>
            <field name="value">6,11</field>
        </record>

        <!-- Acao agendada diaria que cria os alertas de entrega. -->
        <record id="ir_cron_pg_alerta_entrega" model="ir.cron">
            <field name="name">PG: Alertas de entrega (Venda)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._pg_cron_alertas_entrega()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall">2026-07-03 06:00:00</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
