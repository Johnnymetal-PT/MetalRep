<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Adiciona o Nº de Encomenda no topo do cabecalho do cartao,
         acima do titulo (nome da OP/OT). -->
    <t t-name="pg_mrp_shopfloor_encomenda.MrpDisplayRecord"
       t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('card-title')]" position="before">
            <div t-if="pgEncomenda" class="o_pg_encomenda h5 mb-0 text-truncate">
                Nº Encomenda: <t t-esc="pgEncomenda"/>
            </div>
            <div t-if="pgClientOrderRef" class="o_pg_client_ref small text-muted mb-1 text-truncate">
                Ref. Cliente: <t t-esc="pgClientOrderRef"/>
            </div>
        </xpath>
    </t>
</templates>
