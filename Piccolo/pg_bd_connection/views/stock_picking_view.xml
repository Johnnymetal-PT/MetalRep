<odoo>
    <record id="view_picking_form_inherit_pg_bd_connection" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.pg.bd.connection</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="x_studio_community_delivery" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_sync_delivery"
                        type="object"
                        string="Community"
                        class="oe_highlight"
                        invisible="x_studio_community_delivery"
                        />
            </xpath>
        </field>
    </record>
</odoo>
