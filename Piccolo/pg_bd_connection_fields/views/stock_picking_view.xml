<odoo>
    <record id="view_picking_form_inherit_pg_bd_connection_fields" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.pg.bd.connection.fields</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_studio_zona"/>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="x_studio_volumes_3"/>
                <field name="x_studio_peso_kg_1"/>
                <field name="x_studio_cubicagem_1"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_form_inherit_pg_connection_fields" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.pg.connection.fields</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="x_studio_observaes_no_recibo"/>
            </xpath>
        </field>
    </record>
</odoo>
