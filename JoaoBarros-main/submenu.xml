<t name="Submenu" t-name="website.submenu">
    <t t-set="show_dropdown" t-value="(submenu.is_mega_menu and submenu.is_visible) or submenu.child_id.filtered(lambda menu: menu.is_visible)"/>
    <li t-if="submenu.is_visible and not (submenu.child_id or submenu.is_mega_menu)" t-attf-class="#{item_class or ''}" role="presentation">
        <a t-att-href="submenu._clean_url()" t-attf-class="#{link_class or ''} #{submenu._is_active() and 'active'}" role="menuitem" t-ignore="true" t-att-target="'_blank' if submenu.new_window else None">
            <span t-field="submenu.name"/>
        </a>
    </li>

    <li t-elif="show_dropdown" t-attf-class="#{item_class or ''} dropdown #{submenu.is_mega_menu and 'position-static'}" role="presentation">
        <a t-attf-class="#{link_class or ''} dropdown-toggle #{submenu.is_mega_menu and 'o_mega_menu_toggle'} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}" data-bs-toggle="dropdown" href="#" t-att-data-bs-display="'static' if submenu.is_mega_menu else None" role="menuitem">
            <span t-field="submenu.name"/>
        </a>

        <div t-if="submenu.is_mega_menu and not is_mobile" class="dropdown-menu o_mega_menu custom-mega-menu w-100 p-0" style="border-top: 1px solid #766F63;" role="menu">
            <div class="container-fluid px-0 py-4">
            <div class="row submenu">
                <t t-set="categories" t-value="request.env['product.public.category'].sudo().search([])"/>
                <t t-set="sections" t-value="[('LIVING ROOM', categories.filtered(lambda c: c.parent_id.name == 'LIVING ROOM')),                                                ('DINING ROOM', categories.filtered(lambda c: c.parent_id.name == 'DINING ROOM')),                                                ('BEDROOM', categories.filtered(lambda c: c.parent_id.name == 'BEDROOM'))]"/>

                <t t-foreach="sections" t-as="section">
                    <div class="col-2">
                        <h5 class="section-title mb-3"><t t-esc="section[0]"/></h5>
                        <ul class="list-unstyled">
                            <t t-foreach="section[1]" t-as="cat">
                                <li>
                                    <a t-att-href="'/shop/category/%s?category=%s' % (slug(cat), cat.id)" class="category-link d-block py-1" t-att-data-img="'/web/image/product.public.category/%s/image_1920' % cat.id" t-att-data-section="section[0]">
                                        <t t-esc="cat.name"/>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </div>
                </t>

                <div class="col-3">
                    <div class="preview-wrapper position-relative w-100 h-100">
                        <img id="hover-preview" src="/web/image/product.public.category/6/image_1920" class="img-fluid rounded shadow-sm" alt="preview" loading="lazy" style="opacity: 1; margin-left: 100%;"/>
                    </div>
                </div>
            </div>
            <div class="mt-3 mb-4">
                <a href="/shop" class="all-products-link">ALL PRODUCTS</a>
            </div>
            </div>
        </div>

        <!-- Fallback for mobile and non-mega menu cases -->
        <t t-elif="submenu.is_mega_menu"/>
        <div t-if="submenu.is_mega_menu" t-elif="False" class="dropdown-menu o_mega_menu" t-field="submenu.mega_menu_content" role="menuitem"/>
        <ul t-else="" class="dropdown-menu" role="menu">
            <t t-foreach="submenu.child_id" t-as="submenu">
                <t t-call="website.submenu">
                    <t t-set="item_class" t-value="None"/>
                    <t t-set="link_class" t-valuef="dropdown-item"/>
                </t>
            </t>
        </ul>
    </li>
    <!-- Style -->
<style>
    .custom-mega-menu {
        background-color: #514c44 !important;
        width: 100%;
        max-height: none !important;
        overflow: visible !important;
        padding-left: 125px !important;
        padding-right: 125px !important;
    }
    .custom-mega-menu h5 {
        font-weight: 400;
        font-size: 14px;
        color: #c4bdb0;
        text-transform: uppercase;
        margin-bottom: 1rem;
        font-family: Open Sans;
        padding-top:25px;
    }
    .custom-mega-menu a {
        font-weight: 300;
        font-size: 14px;
        color: #f0eae2 !important;
        transition: all 0.2s ease;
        display: inline-block;
        font-family: Open Sans;
        
    }
    .custom-mega-menu a:hover {
        font-weight: 500;
        color: #c4bdb0;
        text-decoration: none;
        
    }
    .all-products-link {
        font-size: 12px;
        color: #c4bdb0; !important;
        text-decoration: underline;
        padding-top: 50px;
        padding-bottom: 5px;
    }
    .all-products-link:hover {
        #color: #c4bdb0;
        border-color: #d2b48c;
    }
    .preview-wrapper {
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    #hover-preview {
        max-height: 260px;
        object-fit: contain;
        transition: opacity 0.3s ease-in-out;
    }
    .o_mega_menu {
        border-left: 0 !important;
        border-right: 0 !important;
        border-bottom: 0 !important;
    }
</style>

<!-- Script -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  // There can be multiple mega menus; support them all.
  document.querySelectorAll('.custom-mega-menu').forEach(function (menu) {
    const preview = menu.querySelector('#hover-preview');
    if (!preview) return;

    const defaultSrc = preview.getAttribute('src') || '';

    // Event delegation: react when a .category-link inside this menu is hovered
    menu.addEventListener('mouseover', function (ev) {
      const link = ev.target.closest('.category-link');
      if (!link || !menu.contains(link)) return;

      const img = link.getAttribute('data-img');
      if (!img) return;

      // Preload to avoid flicker
      const tmp = new Image();
      tmp.onload = function () {
        preview.style.opacity = 0;
        setTimeout(function () {
          preview.src = img;
          preview.style.opacity = 1;
        }, 120);
      };
      tmp.src = img;
    });

    // Optional: reset when leaving the menu
    menu.addEventListener('mouseleave', function () {
      if (defaultSrc) preview.src = defaultSrc;
    });
  });
});
</script>


</t>
