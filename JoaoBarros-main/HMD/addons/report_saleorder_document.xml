<t t-name="sale.report_saleorder_document">
    <t t-set="is_proforma" t-value="bool(         doc._context.get('proforma')         or env.context.get('proforma')         or doc._context.get('is_pro_forma')         or env.context.get('is_pro_forma')     )"/>
    <t t-set="document_title_text" t-value="('Pro-Forma # %s' % doc.name) if is_proforma else (               (                 ('%s # %s') % (                     'Cotação' if (doc.partner_id.country_id and doc.partner_id.country_id.code == 'PT') else 'Quotation',                     doc.name                 )               ) if doc.state in ['draft', 'sent'] else (                 'Encomenda # %s' % doc.name               )            )"/>
    <t t-set="layout_document_title" t-value="document_title_text"/>
    <t t-set="doc_name" t-value="document_title_text"/>

    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>
        <t t-set="address">
            <div t-field="doc.partner_id" t-options="{'widget': 'contact', 'fields': ['address','name'], 'no_marker': True}"/>
            <p t-if="doc.partner_id.vat" class="mb-0">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>:
                <span t-field="doc.partner_id.vat"/>
            </p>
            <p t-if="doc.partner_id.vat" class="mb-0">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>:
                <span t-field="doc.partner_id.vat"/>
            </p>

            <p t-if="doc.partner_id.phone or doc.partner_id.mobile" class="mb-0">
                <strong>Tel:</strong>
                <span t-if="doc.partner_id.phone" t-field="doc.partner_id.sudo().phone"/>
            </p>

            <p t-if="doc.partner_id.email" class="mb-0">
                <strong>Email:</strong>
                <span t-field="doc.partner_id.sudo().email"/>
            </p>
        </t>

        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id">
            <t t-set="information_block">
                <strong>
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">Invoicing and Shipping Address</t>
                    <t t-else="">Invoicing Address</t>
                </strong>
                <div t-field="doc.partner_invoice_id" t-options="{'widget': 'contact', 'fields': ['address','name','phone'], 'no_marker': True, 'phone_icons': True}"/>
                <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                    <strong>Shipping Address</strong>
                    <div t-field="doc.partner_shipping_id" t-options="{'widget': 'contact', 'fields': ['address','name','phone'], 'no_marker': True, 'phone_icons': True}"/>
                </t>
            </t>
        </t>

        <!-- PDF-safe global font shrink via inline style -->
        <div class="page" style="font-size:11px; line-height:1.25;">
            <div class="oe_structure"/>

            <h2 class="mt-4" style="font-size:16px; line-height:1.2;">
                <t t-out="document_title_text"/>
            </h2>

            <div class="row mb-4" id="informations">
                <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                    <strong>Your Reference</strong>
                    <div t-field="doc.client_order_ref">SO0000</div>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong t-if="is_proforma">Issued Date</strong>
                    <strong t-elif="doc.state in ['draft','sent']">Quotation Date</strong>
                    <strong t-else="">Order Date</strong>
                    <div t-field="doc.date_order" t-options="{'widget': 'date'}">2023-12-31</div>
                </div>
                <div t-if="doc.validity_date and doc.state in ['draft','sent']" class="col" name="expiration_date">
                    <strong>Expiration</strong>
                    <div t-field="doc.validity_date">2023-12-31</div>
                </div>
                <div t-if="doc.user_id.name" class="col">
                    <strong>Salesperson</strong>
                    <div t-field="doc.user_id">Mitchell Admin</div>
                </div>
            </div>

            <!-- Include all order lines so discount service lines also print -->
            <t t-set="lines_to_report" t-value="doc.order_line.sorted('sequence')"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

            <div class="oe_structure"/>

            <style>
                .sale_tbody tr.sale_line_odd {
                    background-color: #f6f6f6;
                }
                .o_main_table td, .o_main_table th {
                    padding-top: 2px !important;
                    padding-bottom: 2px !important;
                    vertical-align: top;
                    font-size: 11px;
                }
                .o_main_table thead th {
                    font-weight: bold;
                }
                .o_main_table td img {
                    max-width: 48px !important;
                    max-height: 48px !important;
                    width: 48px !important;
                    height: 48px !important;
                    object-fit: contain !important;
                    display: block !important;
                }

                /* remove normal borders from body cells */
                .o_main_table tbody.sale_tbody > tr > td {
                    border-bottom: none !important;
                    border-top: none !important;
                }

                /* keep only header line */
                .o_main_table thead tr {
                    border-bottom: 2px solid #000 !important;
                }

                /* ================================
                   FINAL PDF NUKES (wkhtmltopdf)
                   ================================ */
                table.o_main_table.o_has_total_table tbody.sale_tbody tr,
                table.o_main_table.o_has_total_table tbody.sale_tbody tr > td {
                    border: 0 !important;
                    border-bottom: 0 !important;
                    border-top: 0 !important;
                    box-shadow: none !important;     /* some themes use inset shadows as separators */
                    background-image: none !important;
                    outline: none !important;
                }
            </style>

            <table class="o_has_total_table table o_main_table table-borderless">
                <thead>
                    <tr>
                        <th name="th_description" class="text-start" style="font-weight:bold">Description</th>
                        <th name="th_quantity" class="text-end text-nowrap" style="font-weight:bold">Quantity</th>
                        <th name="th_priceunit" class="text-end text-nowrap" style="font-weight:bold">Unit Price</th>
                        <th name="th_discount" t-if="display_discount" class="text-end" style="font-weight:bold"><span>Disc.%</span></th>
                        <th name="th_taxes" class="text-end" style="font-weight:bold">Taxes</th>
                        <th name="th_subtotal" class="text-end" style="font-weight:bold"><span>Total</span></th>
                    </tr>
                </thead>

                <tbody class="sale_tbody">
                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                        <t t-set="row_classes" t-value="[]"/>
                        <t t-if="line.display_type == 'line_section'">
                            <t t-set="row_classes" t-value="row_classes + ['fw-bold o_line_section']"/>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <t t-set="row_classes" t-value="row_classes + ['fst-italic o_line_note']"/>
                        </t>
                        <t t-else="">
                            <t t-set="row_classes" t-value="row_classes + ['sale_line_%s' % ('even' if line_index % 2 == 0 else 'odd')]"/>
                        </t>

                        <!-- INLINE NUKING so no later asset can re-add separators -->
                        <tr t-att-class="' '.join(row_classes)"
                            style="border:0 !important; border-bottom:0 !important; border-top:0 !important; box-shadow:none !important;">

                            <t t-if="line.display_type == 'line_section'">
                                <td name="td_section_line" colspan="99"><span t-field="line.name"/></td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>

                            <t t-elif="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99"><span t-field="line.name"/></td>
                            </t>

                            <t t-else="">
                                <!-- PDF-safe image + text same row using inner table -->
                                <td name="td_name">
                                    <div style="display:flex; align-items:flex-start; gap:6px;">
                                        <div style="width:48px; min-width:48px;">
                                            <t t-if="line.product_id.image_128">
                                                <img t-att-src="image_data_uri(line.product_id.image_128)"
                                                     style="width:48px; height:48px; object-fit:contain; display:block;"/>
                                            </t>
                                        </div>
                                        <div style="flex:1 1 auto; min-width:0;">
                                            <t t-set="line_description" t-value="line.name or ''"/>
                                            <t t-set="contains_html" t-value="'&lt;' in line_description and '&gt;' in line_description"/>
                                            <t t-if="not contains_html">
                                                <t t-set="line_description" t-value="line_description.lstrip()"/>
                                            </t>
                                            <t t-set="line_description" t-value="line_description.replace('\r\n', '\n')"/>
                                            <t t-set="line_description" t-value="line_description.replace('\r', '\n')"/>
                                            <t t-set="line_description" t-value="line_description.replace('\n', '&lt;br/&gt;')"/>
                                            <t t-while="line_description.startswith('&lt;br/&gt;')">
                                                <t t-set="line_description" t-value="line_description[5:]"/>
                                            </t>
                                            <span t-raw="line_description"/>
                                        </div>
                                    </div>
                                </td>

                                <td name="td_quantity" class="text-end text-nowrap">
                                    <span t-field="line.product_uom_qty"/>
                                    <t t-if="line.product_uom">
                                        <span t-field="line.product_uom"/>
                                    </t>
                                </td>

                                <td name="td_priceunit" class="text-end text-nowrap">
                                    <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>

                                <td t-if="display_discount" class="text-end">
                                    <span t-field="line.sh_multi_discount"/>
                                </td>

                                <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                    <span t-out="taxes"/>
                                </td>

                                <td name="td_subtotal" class="text-end o_price_total">
                                    <span t-field="line.price_total"/>
                                </td>
                            </t>
                        </tr>

                        <t t-if="current_section and ( line_last or lines_to_report[line_index+1].display_type == 'line_section' or lines_to_report[line_index+1].product_type == 'combo' or ( line.combo_item_id and not lines_to_report[line_index+1].combo_item_id ) ) and not line.is_downpayment">
                            <t t-set="current_section" t-value="None"/>
                            <tr class="is-subtotal text-end">
                                <td name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-out="current_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}">31.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>

                <t t-set="global_discount_lines" t-value="doc.order_line.filtered(lambda l: l.price_unit &lt; 0 and not l.display_type)"/>
                <t t-foreach="global_discount_lines" t-as="line">
                    <tr class="o_global_discount_row">
                        <td colspan="3"><strong t-field="line.name"/></td>
                        <td t-if="display_discount" class="text-end"><span t-field="line.discount"/></td>
                        <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                        <td class="text-end"><span t-out="taxes"/></td>
                        <td class="text-end text-danger"><span t-field="line.price_total"/></td>
                    </tr>
                </t>
            </table>

            <div class="clearfix" name="so_total_summary">
                <div class="row mt-n3" name="total">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="o_total_table table table-borderless">

                            <!-- PRO-FORMA BREAKDOWN & REMAINING TO PAY -->
                            <t t-if="is_proforma">
                                <t t-set="base_total" t-value="doc.amount_total"/>
                                <t t-set="downpayments_incl" t-value="0.0"/>

                                <t t-foreach="doc.order_line" t-as="l">
                                    <t t-if="l.is_downpayment">
                                        <t t-if="l.price_total">
                                            <t t-set="dp_line_incl" t-value="abs(l.price_total)"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="tax_factor" t-value="1.0"/>
                                            <t t-foreach="l.tax_id" t-as="tx">
                                                <t t-if="tx.amount_type == 'percent'">
                                                    <t t-set="tax_factor" t-value="tax_factor * (1.0 + (tx.amount or 0.0)/100.0)"/>
                                                </t>
                                            </t>
                                            <t t-set="dp_line_incl" t-value="abs(l.price_unit) * tax_factor"/>
                                        </t>
                                        <t t-set="downpayments_incl" t-value="downpayments_incl + dp_line_incl"/>
                                    </t>
                                </t>

                                <t t-set="remaining_to_pay" t-value="max(base_total - downpayments_incl, 0.0)"/>

                                <tr class="o_subtotal">
                                    <td><span>Subtotal (before downpayments)</span></td>
                                    <td class="text-end">
                                        <span t-out="base_total" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><span>Downpayments</span></td>
                                    <td class="text-end">
                                        <span t-out="-downpayments_incl" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>

                                <tr class="border-black o_subtotal">
                                    <td><strong>Remaining to Pay</strong></td>
                                    <td class="text-end">
                                        <span t-out="remaining_to_pay" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <!-- /PRO-FORMA BREAKDOWN -->

                            <t t-call="sale.document_tax_totals">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </table>

                        <div class="row small">
                            <p>
                                <strong>Production lead time: </strong>8 - 10 weeks after deposit of 40% of the order value<br/>
                                Prices in Euros, ex-works Porto - Portugal, without taxes.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="oe_structure"/>

            <div t-if="not doc.signature" class="oe_structure"/>
            <div t-else="" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8"><strong>Signature</strong></div>
                <div class="offset-8"><img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/></div>
                <div class="offset-8 text-center"><span t-field="doc.signed_by">Oscar Morgan</span></div>
            </div>

            <div>
                <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                <p t-if="not is_html_empty(doc.payment_term_id.note)"><span t-field="doc.payment_term_id.note">The payment should also be transmitted with love</span></p>
                <div class="oe_structure"/>
                <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                    <strong>Fiscal Position Remark:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note">No further requirements for this payment</span>
                </p>
            </div>

            <t t-set="sum_volumes" t-value="sum(line.line_packing_volumes for line in doc.order_line)"/>
            <t t-set="sum_weight" t-value="sum(line.line_packing_weight for line in doc.order_line)"/>
            <t t-set="sum_cubicagem" t-value="sum(line.line_packing_cubicagem for line in doc.order_line)"/>

            <div style="page-break-inside: avoid;">
                <strong>Payment Conditions: </strong><span t-field="doc.payment_term_id"/>
                <table class="table table-sm table-bordered small rounded w-100 mt-2">
                    <thead class="table-light">
                        <tr><th colspan="3" class="text-center" style="font-weight:bold">Summary</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th style="font-weight:bold">Total Volumes</th>
                            <td class="text-start"><span t-out="sum_volumes"/></td>
                            <td class="align-top" rowspan="3">
                                <div class="d-flex gap-2 align-items-start">
                                    <div class="me-2" style="max-width: 150px;">
                                        <span t-field="doc.x_studio_imagem_paletes" t-options="{'widget':'image'}" class="d-block mt-1 w-100"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span style="font-weight:bold">Delivery Address:</span>
                                        <div t-field="doc.partner_shipping_id" t-options="{'widget':'contact','fields':['address','name','phone'],'no_marker': True,'phone_icons': True}"/>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <th style="font-weight:bold">Total Weight (Kg)</th>
                            <td class="text-start"><span t-out="sum_weight"/></td>
                        </tr>
                        <tr>
                            <th style="font-weight:bold">Total Cubic</th>
                            <td class="text-start"><span t-out="sum_cubicagem"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row small">
                    <div class="col-6">
                        <p>Swift code BCOMPTPL: IBAN PT50 0033 0000 00273554648 05</p>
                        <p>Swift code TOTAPTPL: IBAN PT50 0018 2168 02404506020 13</p><br/>
                    </div>
                    <div class="col-6 text-end">
                        <p>Advanced payment by bank transfer.</p>
                        <p>Please refer to our General Conditions of Sales.</p><br/>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </div>
    </t>
</t>
