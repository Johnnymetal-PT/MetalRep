<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_bom_form_ver_produto_button" model="ir.ui.view">
            <field name="name">mrp.bom.form.ver.produto.button</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_id']" position="before">
                    <button name="action_view_product_template"
                            type="object"
                            string="Ver Produto"
                            class="oe_link"
                            attrs="{'invisible': [('product_id', '=', False)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
