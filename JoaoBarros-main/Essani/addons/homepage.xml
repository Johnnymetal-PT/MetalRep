        <div class="container">
            <style>
                .pg-kelvin-slider-wrapper {
                    position: relative;
                    padding: 32px 80px 40px;
                    background: #000; /* black bar like screenshot 1 */
                    color: #fff;
                    font-family: inherit;
                    margin-top:30px;
                }
                .pg-kelvin-slider-wrapper * {
                    box-sizing: border-box;
                }

                /* Thin gradient line */
                .pg-kelvin-track {
                    position: absolute;
                    left: 80px;
                    right: 80px;
                    top: 40px;
                    height: 3px;
                    background: linear-gradient(
                        90deg,
                        #f8b23c 0%,
                        #f8b23c 30%,
                        #ffffff 50%,
                        #a0e0ff 100%
                    );
                    border-radius: 3px;
                }

                .pg-kelvin-bulbs {
                    position: relative;
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    z-index: 2;
                }

                .pg-kelvin-bulb {
                    flex: 1 1 auto;
                    text-align: center;
                    cursor: pointer;
                    background: transparent;
                    border: none;
                    padding: 0;
                    outline: none;
                }

                /* Outer white ring */
                .pg-kelvin-bulb-circle {
                    width: 52px;
                    height: 52px;
                    border-radius: 50%;
                    margin: 0 auto;
                    background: transparent;
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: all 0.2s ease;
                }

                /* Inner disc (dark when inactive, white when active) */
                .pg-kelvin-bulb-circle::before {
                    content: "";
                    position: absolute;
                    inset: 8px;
                    border-radius: 50%;
                    background: #000; /* matches bar */
                }

                .pg-kelvin-bulb-icon {
                    position: relative;
                    z-index: 1;
                    font-size: 20px;
                    color: #888;
                    transition: color 0.2s ease;
                }

                .pg-kelvin-label {
                    margin-top: 22px;
                    font-size: 16px;
                    font-weight: 400;
                    letter-spacing: 0.03em;
                    color: #ffffff;
                }

                /* Active bulb: inner circle white, icon dark */
                .pg-kelvin-bulb.pg-active .pg-kelvin-bulb-circle::before {
                    background: #ffffff;
                }
                .pg-kelvin-bulb.pg-active .pg-kelvin-bulb-icon {
                    color: #000;
                }
                .pg-kelvin-bulb.pg-active .pg-kelvin-label {
                    font-weight: 600;
                }

                .pg-kelvin-stage {
                    position: relative;
                    max-width: 1920px;
                    margin: 0 auto;
                }
                .pg-kelvin-stage .pg-kelvin-base {
                    display: block;
                    width: 100%;
                    height: auto;
                }
                .pg-kelvin-image {
                    position: absolute;
                    inset: 0;
                    opacity: 0;
                    pointer-events: none;
                    transition: opacity 0.35s ease;
                }
                .pg-kelvin-image.pg-active {
                    opacity: 1;
                    pointer-events: auto;
                }
                .pg-kelvin-image img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

                @media (max-width: 991.98px) {
                    .pg-kelvin-slider-wrapper {
                        padding: 24px 20px 32px;
                    }
                    .pg-kelvin-track {
