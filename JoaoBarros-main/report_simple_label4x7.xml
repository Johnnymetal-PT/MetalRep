<t t-name="product.report_simple_label4x7">
    <t t-set="table_style" t-value="'position:relative;width:47mm;height:37.1mm;padding:2mm;box-sizing:border-box;' + table_style"/>

    <td t-att-style="make_invisible and 'visibility:hidden;'">
        <div class="o_label_full" t-att-style="table_style">

            <!-- Top row: Name (left) + Logo (right) on the SAME line -->
            <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                <!-- Name takes remaining width -->
                <div style="min-width:0;word-break:break-word;text-align:left;">
                    <div style="font-weight:700;font-size:9.5pt;line-height:1.1;margin-bottom:0.6mm;margin-left:-2mm;">
                        <t t-out="product.name"/>
                    </div>
                </div>

                <!-- Logo has fixed width so it never wraps down -->
                <div style="flex:0 0 5mm;text-align:right;">
                    <img src="/web/image/4036491"
                         style="height:7mm;max-width:10mm;object-fit:contain;display:block;margin-left:auto;"/>
                </div>
            </div>

            <!-- Product code (bold, above description) -->
            <t t-if="product.default_code">
                <div style="font-weight:700;font-size:8.5pt;margin-top:0.6mm;">
                    <t t-out="product.default_code"/>
                </div>
            </t>

            <!-- Description (slightly smaller) -->
            <t t-if="product.description_sale">
                <div style="font-size:6.4pt;line-height:1.25;margin-top:0.8mm;white-space:normal;word-break:break-word;">
                    <t t-out="product.description_sale"/>
                </div>
            </t>

            <!-- Price: big, bottom-right -->
            <div style="position:absolute;right:2mm;bottom:1.5mm;font-weight:700;font-size:16pt;line-height:1;text-align:right;">
                <strong
                    t-out="pricelist._get_product_price(product, 1, pricelist.currency_id or product.currency_id)"
                    t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id, 'label_price': True}"/>
            </div>

        </div>
    </td>
</t>
