<?xml version="1.0" ?>
<t name="Products" t-name="website_sale.products">
  <t t-call="website.layout">
    <t t-set="additional_title">Shop</t>
    <t t-set="grid_block_name">Grid</t>
    <t t-set="product_block_name">Product</t>
    <t t-set="navClass" t-valuef="light"/>
    <t t-set="opt_wsale_categories" t-value="is_view_active('website_sale.products_categories')"/>
    <t t-set="opt_wsale_attributes" t-value="is_view_active('website_sale.products_attributes')"/>
    <t t-set="opt_wsale_filter_price" t-value="is_view_active('website_sale.filter_products_price')"/>
    <t t-set="opt_wsale_filter_tags" t-value="is_view_active('website_sale.filter_products_tags')"/>
    <t t-set="opt_wsale_categories_top" t-value="is_view_active('website_sale.products_categories_top')"/>
    <t t-set="opt_wsale_attributes_top" t-value="is_view_active('website_sale.products_attributes_top')"/>
    <t t-set="website_sale_pricelists" t-value="website.get_pricelist_available(show_visible=True)"/>
    <t t-set="website_sale_sortable" t-value="website._get_product_sort_mapping()"/>
    <t t-set="hasLeftColumn" t-value="opt_wsale_categories or opt_wsale_attributes"/>
    <t t-set="isFilteringByPrice" t-if="opt_wsale_filter_price" t-value="float_round(available_min_price, 2) != float_round(min_price, 2) or float_round(available_max_price, 2) != float_round(max_price, 2)"/>
    <t t-set="hasPricelistDropdown" t-value="website_sale_pricelists and len(website_sale_pricelists)&gt;1"/>
    <t t-set="isSortingBy" t-value="[sort for sort in website_sale_sortable if sort[0]==request.params.get('order', '')]"/>
    <style>
      .margens {
        padding-right: 100px;
        padding-left: 100px;
      }

      .custom-category-tabs {
        margin-bottom: 1.5rem;
      }

      .custom-category-tabs .nav-tabs {
        border-bottom: none;
        display: flex;
        gap: 2rem;
      }

      .custom-category-tabs .nav-link {
        background: transparent;
        border: none;
        border-bottom: 1px solid transparent;
        /* reserve space */
        border-radius: 0;
        font-size: 16px;
        text-transform: uppercase;
        color: #2d2a26;
        padding: 0 0 6px 0;
        line-height: 1.2;
        /* keeps the text centered */
      }

      .custom-category-tabs .nav-link.active {
        border-bottom-color: #514C44;
        /* show real underline */
        border-width: 5px;
      }

      .custom-category-tabs .nav-link:hover {
        text-decoration: underline;
      }

      .custom-category-tabs .category-underline {
        border: 0;
        height: 1px;
        background-color: #d8d5d1;
        margin-top: 0;
        margin-bottom: 0;
      }

      @media (max-width: 991.98px) {
        .margens {
          padding-left: 1.5rem;
          padding-right: 1.5rem;
        }

        .o_wsale_products_main_row {
          flex-wrap: wrap !important;
        }

        .products_header {
          flex-wrap: wrap;
          gap: 1rem !important;
        }
      }

      @media (max-width: 767.98px) {
        .margens {
          padding-left: 0;
          padding-right: 0;
        }

        .custom-category-tabs .nav-tabs {
          gap: 1rem;
          flex-wrap: nowrap;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          padding-bottom: 0.5rem;
          /* Oculta o scrollbar */
          scrollbar-width: none;
          /* Firefox */
        }

        .custom-category-tabs .nav-tabs::-webkit-scrollbar {
          display: none;
          /* Chrome, Safari, Edge */
        }

        .custom-category-tabs .nav-item {
          flex: 0 0 auto;
        }

        .custom-category-tabs .nav-link {
          font-size: 14px;
          text-align: center;
          white-space: nowrap;
        }

        .products_header {
          flex-direction: column;
          align-items: stretch !important;
        }

        .o_wsale_products_grid_table_wrapper colgroup,
        .o_wsale_products_grid_table_wrapper colgroup col {
          display: none !important;
        }

        .o_wsale_products_grid_table_wrapper table {
          display: none !important;
        }

        .o_wsale_products_grid_table_wrapper .o_mobile_product_grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          width: 100%;
          grid-auto-rows: 1fr;
        }

        .o_wsale_products_grid_table_wrapper .o_mobile_product_grid .oe_product {
          display: flex;
          flex-direction: column;
          width: 100%;
          height: 100%;
          max-width: none;
          min-width: 0;
          align-self: stretch;
          justify-self: stretch;
        }

        .o_wsale_products_grid_table_wrapper .o_mobile_product_grid .oe_product > .o_wsale_product_grid_wrapper {
          display: flex;
          flex-direction: column;
          flex: 1 1 auto;
        }

        .o_wsale_products_grid_table_wrapper .o_mobile_product_grid .oe_product:empty {
          display: none;
        }
      }

      @media (min-width: 768px) {
        .o_wsale_products_grid_table_wrapper .o_mobile_product_grid {
          display: none !important;
        }
      }
    </style>
    <div id="wrap" class="js_sale o_wsale_products_page margens" style="padding-bottom:75px;">
      <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_1"/>
      <div class="container oe_website_sale pt-2">
        <div class="row o_wsale_products_main_row align-items-start flex-nowrap">
          <aside t-if="hasLeftColumn" id="products_grid_before" class="d-none d-lg-block position-sticky col-3 px-3 clearfix">
            <div class="o_wsale_products_grid_before_rail vh-100 ms-n2 mt-n2 pt-2 pe-lg-2 pb-lg-5 ps-2 overflow-y-scroll">
              <div t-if="opt_wsale_categories" class="products_categories mb-3">
                <t t-call="website_sale.products_categories_list"/>
              </div>
              <div class="products_attributes_filters"/>
              <t t-if="opt_wsale_filter_price and opt_wsale_attributes" t-call="website_sale.filter_products_price"/>
            </div>
          </aside>
          <div id="products_grid" t-attf-class="#{'o_wsale_layout_list' if layout_mode == 'list' else ''} {{'col-lg-9' if hasLeftColumn else 'col-12'}}">
            <t t-call="website_sale.products_breadcrumb">
              <t t-set="_classes" t-valuef="d-none d-lg-flex w-100 p-0 small"/>
            </t>
            <!-- Custom Top Category Tabs -->
            <t t-if="opt_wsale_categories_top and categories">
              <div id="category_header_block" class="custom-category-tabs">
                <ul class="nav nav-tabs border-0">
                  <li class="nav-item">
                    <a t-attf-class="nav-link text-uppercase px-3 py-2 {{'active' if not category else ''}}" t-att-href="keep('/shop', category=0)"> ALL PRODUCTS </a>
                  </li>
                  <li t-foreach="categories" t-as="cat" class="nav-item">
                    <a t-attf-class="nav-link text-uppercase px-3 py-2 {{'active' if category and category.id == cat.id else ''}}" t-att-href="keep('/shop/category/' + slug(cat), category=cat.id)">
                      <t t-esc="cat.name"/>
                    </a>
                  </li>
                </ul>
                <hr class="category-underline"/>
              </div>
            </t>
            <div class="products_header btn-toolbar flex-nowrap align-items-center justify-content-between gap-3 mb-3" style="padding-top:65px;">
              <t t-if="is_view_active('website_sale.search')" t-call="website_sale.search">
                <t t-set="search" t-value="original_search or search"/>
                <t t-set="_form_classes" t-valuef="d-lg-inline {{'d-inline' if not category else 'd-none'}}"/>
              </t>
              <t t-call="website_sale.pricelist_list" t-cache="pricelist">
                <t t-set="_classes" t-valuef="d-none d-lg-inline"/>
              </t>
              <t t-if="is_view_active('website_sale.sort')" t-call="website_sale.sort">
                <t t-set="_classes" t-valuef="d-none d-lg-inline-block"/>
              </t>
              <div t-if="category" class="d-flex align-items-center d-lg-none me-auto">
                <t t-if="not category.parent_id" t-set="backUrl" t-valuef="/shop"/>
                <t t-else="" t-set="backUrl" t-value="keep('/shop/category/' + slug(category.parent_id), category=0)"/>
                <a t-attf-class="btn btn-{{navClass}} me-2" t-att-href="backUrl">
                  <i class="fa fa-angle-left"/>
                </a>
                <h4 t-out="category.name" class="mb-0 me-auto"/>
              </div>
              <t t-if="is_view_active('website_sale.add_grid_or_list_option')" t-call="website_sale.add_grid_or_list_option">
                <t t-set="_classes" t-valuef="d-flex"/>
              </t>
              <button t-if="is_view_active('website_sale.sort') or opt_wsale_categories or opt_wsale_attributes or opt_wsale_attributes_top" t-attf-class="btn btn-{{navClass}} position-relative {{not opt_wsale_attributes_top and 'd-lg-none'}}" data-bs-toggle="offcanvas" data-bs-target="#o_wsale_offcanvas">
                <i class="fa fa-sliders"/>
                <span t-if="isFilteringByPrice or attrib_set or tags" t-attf-class="position-absolute top-0 start-100 translate-middle border border-{{navClass}} rounded-circle bg-danger p-1">
                  <span class="visually-hidden">filters active</span>
                </span>
              </button>
            </div>
            <div t-if="original_search and products" class="alert alert-warning mt8">
               No results found for '
              <span t-esc="original_search"/>
              '. Showing results for '
              <span t-esc="search"/>
              '. 
            </div>
            <t t-if="category">
              <t t-set="editor_msg">
                Drag building blocks here to customize the header for &quot;
                <t t-esc="category.name"/>
                &quot; category.
              </t>
              <div class="mb16" id="category_header" sttyle="display:none;" t-att-data-editor-message="editor_msg" t-field="category.website_description"/>
            </t>
            <div t-if="products" class="o_wsale_products_grid_table_wrapper pt-3 pt-lg-0">
              <table class="table table-borderless h-100 m-0" t-att-data-ppg="ppg" t-att-data-ppr="ppr" t-att-data-default-sort="website.shop_default_sort" t-att-data-name="grid_block_name">
                <colgroup t-ignore="true">
                  <col t-foreach="ppr" t-as="p"/>
                </colgroup>
                <tbody>
                  <tr t-foreach="bins" t-as="tr_product">
                    <t t-foreach="tr_product" t-as="td_product">
                      <t t-if="td_product">
                        <td t-att-colspan="td_product['x'] != 1 and td_product['x']" t-att-rowspan="td_product['y'] != 1 and td_product['y']" t-attf-class="oe_product" t-att-data-ribbon-id="td_product['ribbon'].id" t-att-data-name="product_block_name" style="padding-bottom: 75px; padding-left: 10px; padding-right: 10px;">
                          <div t-attf-class="o_wsale_product_grid_wrapper position-relative h-100 o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}">
                            <t t-call="website_sale.products_item">
                              <t t-set="product" t-value="td_product['product']"/>
                            </t>
                          </div>
                        </td>
                      </t>
                      <td t-else=""/>
                    </t>
                  </tr>
                </tbody>
              </table>
              <script type="text/javascript">
                (function () {
                  const MOBILE_QUERY = window.matchMedia('(max-width: 767.98px)');

                  function collectProductCells(wrapper) {
                    const tableBody = wrapper.querySelector('tbody');
                    if (!tableBody) {
                      return [];
                    }
                    return Array.from(tableBody.querySelectorAll('td.oe_product')).filter((cell) => {
                      return cell && cell.innerHTML.trim().length > 0;
                    });
                  }

                  function ensureMobileGrid(wrapper) {
                    let grid = wrapper.querySelector('.o_mobile_product_grid');
                    if (!grid) {
                      grid = document.createElement('div');
                      grid.className = 'o_mobile_product_grid';
                      wrapper.appendChild(grid);
                    }
                    return grid;
                  }

                  function refreshMobileGrid(wrapper) {
                    const grid = ensureMobileGrid(wrapper);
                    grid.innerHTML = '';
                    collectProductCells(wrapper).forEach((cell) => {
                      const clone = cell.cloneNode(true);
                      clone.querySelectorAll('script').forEach((scriptEl) => scriptEl.remove());
                      grid.appendChild(clone);
                    });
                  }

                  function teardownMobileGrid(wrapper) {
                    const grid = wrapper.querySelector('.o_mobile_product_grid');
                    if (grid) {
                      grid.remove();
                    }
                  }

                  function isMobile() {
                    return MOBILE_QUERY.matches;
                  }

                  function handleMode(wrapper) {
                    if (isMobile()) {
                      refreshMobileGrid(wrapper);
                    } else {
                      teardownMobileGrid(wrapper);
                    }
                  }

                  function bindMutationObserver(wrapper) {
                    let observer = wrapper.__mobileGridObserver;
                    if (!observer) {
                      observer = new MutationObserver(() => {
                        if (isMobile()) {
                          refreshMobileGrid(wrapper);
                        }
                      });
                      wrapper.__mobileGridObserver = observer;
                    }

                    const tableBody = wrapper.querySelector('tbody');
                    if (tableBody) {
                      observer.observe(tableBody, { childList: true, subtree: true });
                    }
                  }

                  function disconnectObserver(wrapper) {
                    if (wrapper.__mobileGridObserver) {
                      wrapper.__mobileGridObserver.disconnect();
                    }
                  }

                  function initWrapper(wrapper) {
                    handleMode(wrapper);
                    if (isMobile()) {
                      bindMutationObserver(wrapper);
                    } else {
                      disconnectObserver(wrapper);
                    }
                  }

                  function initAllWrappers() {
                    document.querySelectorAll('.o_wsale_products_grid_table_wrapper').forEach(initWrapper);
                  }

                  document.addEventListener('DOMContentLoaded', initAllWrappers);
                  window.addEventListener('pageshow', initAllWrappers);
                  MOBILE_QUERY.addEventListener('change', initAllWrappers);
                  window.addEventListener('resize', () => {
                    if (!('requestAnimationFrame' in window)) {
                      initAllWrappers();
                      return;
                    }
                    window.requestAnimationFrame(initAllWrappers);
                  });
                })();
              </script>
            </div>
            <div t-nocache="get the actual search" t-else="" class="text-center text-muted mt128 mb256">
              <t t-if="not search">
                <h3 class="mt8">No product defined</h3>
                <p t-if="category">No product defined in this category.</p>
              </t>
              <t t-else="">
                <h3 class="mt8">No results</h3>
                <p>
                  No results for &quot;
                  <strong t-esc="search"/>
                  &quot;
                  <t t-if="category">
                     in category &quot;
                    <strong t-esc="category.display_name"/>
                    &quot;
                  </t>
                  .
                </p>
              </t>
              <p t-ignore="true" groups="sales_team.group_sale_manager">
                Click 
                <i>'New'</i>
                 in the top-right corner to create your first product.
              </p>
            </div>
            <div class="products_pager d-flex justify-content-center pt-5 pb-3">
              <t t-call="website.pager"/>
            </div>
          </div>
        </div>
        <t t-call="website_sale.o_wsale_offcanvas"/>
      </div>
      <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_products_2"/>
    </div>
  </t>
</t>
