    section.s_title h2 span {
        font-size: 2.5rem !important;
    }

    section.s_text_block h3 span {
        font-size: 2.25rem !important;
        display: inline-block;
        max-width: 100%;
        word-break: break-word;
    }

    section.s_text_block h4 span {
        font-size: 1.875rem !important;
        display: inline-block;
        max-width: 100%;
        word-break: break-word;
        white-space: normal;
    }

    .s_website_form .form-check {
        flex-wrap: wrap;
    }

    .s_website_form .form-check-label {
        margin-top: 0.25rem;
    }

    .s_website_form_field_description {
        display: block;
        margin-left: 0;
        margin-top: 0.25rem;
    }
}
</style>


