}

/* Optional: keep it grayscale even if Odoo adds inner wrappers */
.map_container iframe {
  -webkit-filter: grayscale(100%) contrast(108%) brightness(96%);
  filter: grayscale(100%) contrast(108%) brightness(96%);
}

/* If you use the color overlay block, ensure it stays transparent */
.s_map_color_filter {
  background: transparent !important;
}



/* Global font family and color */
.s_website_form input,
.s_website_form textarea,
.s_website_form select,
.s_website_form label,
.s_website_form .form-check-label,
.s_website_form .form-control,
.s_website_form .form-select {
    font-family: 'Cormorant Infant', serif;
    color: #302D27;
}

/* Flat border and consistent spacing for inputs */
.s_website_form .form-control,
.s_website_form .form-select,
.s_website_form textarea,
.s_website_form .form-check-input {
    border: 1px solid #302D27;
    border-radius: 0;
    box-shadow: none;
    font-size: 16px;
}
.s_website_form .form-check-input {
    margin-left: 0;
    margin-right: 4px;
    float: none;
}

/* Adjust radio button borders and spacing */
.s_website_form .form-check {
    border: 1px solid #302D27;
    border-radius: 0;
    padding: 8px 12px;
    margin-right: 10px;
    display: flex;
    align-items: center;
}

/* Proper alignment for the checkbox and privacy text */
.s_website_form_field_description {
    display: inline-block;
    margin-left: 8px;
    font-size: 13px;
    vertical-align: middle;
}

/* Position disclaimer next to checkbox */
.s_website_form input[type="checkbox"],
.s_website_form input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 20px;
    height: 20px;
    border: 1px solid #302D27;
    background: none;
    vertical-align: middle;
    margin-right: 4px;
    position: relative;
}

.s_website_form input[type="checkbox"]:checked::after,
.s_website_form input[type="radio"]:checked::after {
    content: "\2713";
    color: #000;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 18px;
    line-height: 1;
}

/* Full width for the SEND button */
.s_website_form .s_website_form_submit .btn {
    width: 100%;
    border-radius: 0;
    font-size: 16px;
    background-color: #302D27;
    color: white;
    border: none;
    padding: 12px 0;
}

/* Ensure labels and fields line up nicely */
.s_website_form_label {
    width: auto !important;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 500;
    color: #302D27;
    margin-bottom: 5px;
}
.margens {
    padding-left: 100px;
    padding-right: 100px;
}

@media (max-width: 991.98px) {
    .margens {
        padding-left: 2rem;
        padding-right: 2rem;
    }

    .s_map {
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    #contactus_form {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .s_website_form .container {
        padding-left: 0;
        padding-right: 0;
    }

    .s_website_form .s_website_form_field,
    .s_website_form .form-check,
    .s_website_form .s_website_form_multiple .radio {
        width: 100%;
        max-width: 100%;
    }

    .s_website_form .form-check {
        justify-content: flex-start;
        padding: 10px 12px;
        margin-right: 0;
    }

    .s_website_form .s_website_form_submit {
        text-align: center;
    }

    .s_website_form .s_website_form_submit .s_website_form_label {
        display: none;
    }
}

@media (max-width: 575.98px) {
    .margens {
        padding-left: 1rem;
        padding-right: 1rem;
