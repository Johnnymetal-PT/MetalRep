<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_mmconnect_employee" model="res.groups">
        <field name="name">MMConnect Employee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mmconnect_supervisor" model="res.groups">
        <field name="name">MMConnect Supervisor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mmconnect_manager" model="res.groups">
        <field name="name">MMConnect Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_mmconnect_device_manager" model="res.groups">
        <field name="name">MMConnect Device Manager</field>
        <field name="implied_ids" eval="[(4, ref('mmconnect.group_mmconnect_manager'))]"/>
