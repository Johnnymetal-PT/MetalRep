        <field name="implied_ids" eval="[(4, ref('mmconnect.group_mmconnect_manager'))]"/>
    </record>

    <record id="rule_mm_att_result_employee" model="ir.rule">
        <field name="name">MMConnect attendance results - employee own</field>
        <field name="model_id" ref="model_mm_att_result"/>
        <field name="groups" eval="[(4, ref('mmconnect.group_mmconnect_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_mm_att_result_supervisor" model="ir.rule">
        <field name="name">MMConnect attendance results - supervisor team</field>
        <field name="model_id" ref="model_mm_att_result"/>
        <field name="groups" eval="[(4, ref('mmconnect.group_mmconnect_supervisor'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>

