                    <group>
                        <field name="employee_id"/>
                        <field name="device_id"/>
                        <field name="template_type"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="template_data"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_biometric_template" model="ir.actions.act_window">
        <field name="name">Biometrias</field>
