<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mm_task_list" model="ir.ui.view">
        <field name="name">mm.task.list</field>
        <field name="model">mm.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="route_id"/>
                <field name="location_id"/>
                <field name="scheduled_start"/>
                <field name="scheduled_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mm_task_form" model="ir.ui.view">
        <field name="name">mm.task.form</field>
        <field name="model">mm.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'done' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="employee_id"/>
                        <field name="route_id"/>
                        <field name="location_id"/>
                    </group>
                    <group>
                        <field name="scheduled_start"/>
                        <field name="scheduled_end"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_task" model="ir.actions.act_window">
        <field name="name">Tarefas</field>
        <field name="res_model">mm.task</field>
        <field name="view_mode">list,form</field>
    </record>

