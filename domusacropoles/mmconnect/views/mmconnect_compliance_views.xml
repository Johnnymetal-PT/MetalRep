<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mm_rgpd_request_list" model="ir.ui.view">
        <field name="name">mm.rgpd.request.list</field>
        <field name="model">mm.rgpd.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <field name="request_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mm_rgpd_request_form" model="ir.ui.view">
        <field name="name">mm.rgpd.request.form</field>
        <field name="model">mm.rgpd.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'done' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="employee_id"/>
                        <field name="request_type"/>
                        <field name="request_date"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_rgpd_request" model="ir.actions.act_window">
        <field name="name">Pedidos RGPD</field>
        <field name="res_model">mm.rgpd.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mm_rgpd_consent_list" model="ir.ui.view">
        <field name="name">mm.rgpd.consent.list</field>
        <field name="model">mm.rgpd.consent</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mm_rgpd_consent_form" model="ir.ui.view">
        <field name="name">mm.rgpd.consent.form</field>
        <field name="model">mm.rgpd.consent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_rgpd_consent" model="ir.actions.act_window">
        <field name="name">Consentimentos RGPD</field>
        <field name="res_model">mm.rgpd.consent</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mm_import_profile_list" model="ir.ui.view">
        <field name="name">mm.import.profile.list</field>
        <field name="model">mm.import.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="source_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mm_import_profile_form" model="ir.ui.view">
        <field name="name">mm.import.profile.form</field>
        <field name="model">mm.import.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="source_type"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_import_profile" model="ir.actions.act_window">
        <field name="name">Perfis de Importação</field>
        <field name="res_model">mm.import.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mm_import_job_list" model="ir.ui.view">
        <field name="name">mm.import.job.list</field>
        <field name="model">mm.import.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="state"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>

    <record id="view_mm_import_job_form" model="ir.ui.view">
        <field name="name">mm.import.job.form</field>
        <field name="model">mm.import.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'running'"/>
                    <button name="action_fail" type="object" string="Fail" invisible="state in ('done', 'failed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="profile_id"/>
                        <field name="started_at" readonly="1"/>
                        <field name="finished_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="model_name"/>
                                    <field name="external_key"/>
                                    <field name="status"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Errors">
                            <field name="error_ids">
                                <list editable="bottom">
                                    <field name="model_name"/>
                                    <field name="external_key"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_import_job" model="ir.actions.act_window">
        <field name="name">Jobs de Importação</field>
        <field name="res_model">mm.import.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
