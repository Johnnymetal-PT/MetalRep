    </record>

    <record id="action_mm_att_bank_account" model="ir.actions.act_window">
        <field name="name">Banco de Horas</field>
        <field name="res_model">mm.att.bank.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
