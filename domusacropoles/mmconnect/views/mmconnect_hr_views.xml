<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mm_hr_employee" model="ir.actions.act_window">
        <field name="name">Colaboradores</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
    </record>

    <record id="view_mm_hr_entity_list" model="ir.ui.view">
        <field name="name">mm.hr.entity.list</field>
        <field name="model">mm.hr.entity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mm_hr_entity_form" model="ir.ui.view">
        <field name="name">mm.hr.entity.form</field>
        <field name="model">mm.hr.entity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="legacy_id"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_hr_entity" model="ir.actions.act_window">
        <field name="name">Entidades</field>
        <field name="res_model">mm.hr.entity</field>
