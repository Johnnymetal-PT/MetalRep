        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mm_visit_list" model="ir.ui.view">
        <field name="name">mm.visit.list</field>
        <field name="model">mm.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="visitor_id"/>
                <field name="scheduled_start"/>
                <field name="scheduled_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mm_visit_form" model="ir.ui.view">
        <field name="name">mm.visit.form</field>
        <field name="model">mm.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_check_in" type="object" string="Check In" invisible="state != 'approved'"/>
                    <button name="action_check_out" type="object" string="Check Out" invisible="state != 'checked_in'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'done' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,checked_in,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="visitor_id"/>
                            <field name="visit_type_id"/>
                        </group>
                        <group>
                            <field name="scheduled_start"/>
                            <field name="scheduled_end"/>
                            <field name="actual_checkin" readonly="1"/>
                            <field name="actual_checkout" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="location_id"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_visit" model="ir.actions.act_window">
        <field name="name">Visitas</field>
        <field name="res_model">mm.visit</field>
        <field name="view_mode">list,form</field>
    </record>

