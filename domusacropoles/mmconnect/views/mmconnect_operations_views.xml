    <record id="view_mm_room_booking_form" model="ir.ui.view">
        <field name="name">mm.room.booking.form</field>
        <field name="model">mm.room.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="room_id"/>
                        <field name="visit_id"/>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_room_booking" model="ir.actions.act_window">
        <field name="name">Reservas de Salas</field>
        <field name="res_model">mm.room.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_mm_vehicle_booking_list" model="ir.ui.view">
        <field name="name">mm.vehicle.booking.list</field>
        <field name="model">mm.vehicle.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="vehicle_id"/>
                <field name="destination"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mm_vehicle_booking_form" model="ir.ui.view">
        <field name="name">mm.vehicle.booking.form</field>
        <field name="model">mm.vehicle.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" type="object" string="Done" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled' or state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="vehicle_id"/>
                        <field name="destination"/>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mm_vehicle_booking" model="ir.actions.act_window">
        <field name="name">Reservas de Viaturas</field>
        <field name="res_model">mm.vehicle.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
