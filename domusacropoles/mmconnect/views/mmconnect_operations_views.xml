    <record id="view_mm_room_booking_list" model="ir.ui.view">
        <field name="name">mm.room.booking.list</field>
        <field name="model">mm.room.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="room_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
