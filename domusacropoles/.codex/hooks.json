{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .pg_framework/scripts/pg_ensure_framework_current.ps1",
            "command_windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .pg_framework/scripts/pg_ensure_framework_current.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .pg_framework/scripts/pg_hook_codex_log_token_consumption.ps1",
            "command_windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .pg_framework/scripts/pg_hook_codex_log_token_consumption.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .pg_framework/scripts/pg_hook_codex_log_token_consumption.ps1",
            "command_windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .pg_framework/scripts/pg_hook_codex_log_token_consumption.ps1"
          }
        ]
      }
    ]
  }
}
